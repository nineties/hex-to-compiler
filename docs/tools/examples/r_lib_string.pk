use("string")
use("pretty")
put(f"{string.char(65)} [{string.char_at("abc", 5)}] {string.ends_with("main.pk", ".pk")}\n")
put(f"{string.index_of_string("banana", "na", 3)} {string.string_repeat("ab", 3)}\n")
put(f"{string.string_cmp("a", "b")} {string.string_cmp("b", "b")} {string.string_less("b", "a")}\n")
put(f"{string.int_to_string(-42)} {string.string_to_int("x1")}\n")
put(f"{string.is_digit(ord("7", 0))} {string.is_alpha(ord("_", 0))} {string.is_ident_start(ord("_", 0))}\n")
b := strbuf.new()
strbuf.add(b, "plan")
strbuf.add(b, "ck")
put(strbuf.string(b)); put("\n")
