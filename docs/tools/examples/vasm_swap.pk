use("vasm/check")

report(m) := {
    es := vasm_check.errors(argv()[0], m)
    if (es == []) put("ok\n")
    each((VasmError{_, Loc{_, l, c}, msg}) -> put(f"line {l}: {msg}\n"), es)
}

m := vasm{|
    struct Image { header: own [u8], body: own [u8], entry: u64 }
    fun replace_body(img: Image, n: i64) -> Image {
        var b: own [u8]
        b = allocate(n, 0)
        img.body = b
        return img
    }
    fun take_header[r](parts: &mutable r [own [u8]]) -> own [u8] {
        var a: own [u8]
        a = allocate(1, 9)
        a = swap(parts[0], a)
        return a
    }
    fun read_header[r](parts: &r [own [u8]]) -> own [u8] {
        var a: own [u8]
        a = parts[0]
        return a
    }
|}
report(m)
