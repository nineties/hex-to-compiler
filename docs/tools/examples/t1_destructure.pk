# (a, b) := e defines several variables from the elements of a tuple

(a, b) := (1, 2)
println(a + b)

# swap
(a, b) = (b, a)
println(Tuple{a, b})

# a function that returns two values
divmod(x, y) := (x / y, x % y)
(q, r) := divmod(17, 5)
println(Tuple{q, r})

# in a function and in a loop
fib(n) := {
    (x, y) := (0, 1)
    i := 0
    while (i < n) {
        (x, y) = (y, x + y)
        i = i + 1
    }
    x
}
println(fib(10))
