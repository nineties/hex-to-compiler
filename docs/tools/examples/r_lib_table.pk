use("list")
use("table")
use("pretty")
t := table()
table_set(t, 'a, 1)
table_set(t, 'b, 2)
put(f"{table_len(t)} {table_has(t, 'a)} {table_has(t, 'z)}\n")
put(f"{sort((a, b) -> a < b, table_values(t))}\n")
s := set.from_list([1, 2, 2, 3])
put(f"{set.len(s)} {set.has(s, 2)} {sort((a, b) -> a < b, set.to_list(s))}\n")
