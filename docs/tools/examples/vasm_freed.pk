use("vasm")

report(m) := {
    es := vasm_errors(argv()[0], m)
    if (es == []) put("ok\n")
    each((VasmErr{_, Loc{_, l, c}, msg}) -> put(f"line {l}: {msg}\n"), es)
}

m := vasm{|
    fn use_after_free() -> i64 {
        var p: own i64
        var v: i64
        p = box(1)
        free(p)
        v = *p
        return v
    }
    fn free_twice() {
        var p: own i64
        p = box(1)
        free(p)
        free(p)
    }
    fn moved_then_used(q: own i64) -> own i64 {
        var p: own i64
        p = q
        free(q)
        return p
    }
|}
report(m)
