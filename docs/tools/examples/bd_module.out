> module counter {
...     n := 0
...     export start := n
...     export next() := {
...         n = n + 1
...         n
...     }
...     export current() := n
... }
> counter.next()
1
> counter.next()
2
> counter.start
0
> counter.current()
2
> module outer {
...     module hidden {
...         export f(x) := x + 1
...     }
...     export module inner {
...         export g(x) := hidden.f(x) * 2
...     }
... }
> outer.inner.g(3)
8
