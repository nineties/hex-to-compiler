Def{t, Apply{table_new, Tuple{}}}
Apply{table_set, Tuple{t, "a", 1}}
Apply{println, Tuple{Apply{table_get, Tuple{t, "a", 0}}}}
Apply{println, Tuple{Apply{table_get, Tuple{t, "c", 0}}}}
Def{a, Apply{array, Tuple{2}}}
Apply{println, Tuple{Apply{array_set, Tuple{a, 1, "x"}}}}
Apply{println, Tuple{Apply{array_get, Tuple{a, 1}}}}
