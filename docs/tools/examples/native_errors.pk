use("native/expand")

m := native{|
    fn f(n: i64) {
        let x = 5
    }
    fn g(n: i64) {
        for i in 0..10 {
            n += 1
        }
    }
    fn h(n: i64) -> i64 {
        n + k
    }
|}
file := argv()[0]
each((VasmErr{_, Loc{_, l, c}, msg}) -> put(f"line {l}: {msg}\n"), native_expand.errors(file, arg(native_expand.expand_all(m), 1)))
