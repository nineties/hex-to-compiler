use("native/compile")

m := native{|
    fun f(n: i64) {
        let x = 5
    }
    fun g(n: i64) {
        for i in 0..10 {
            n += 1
        }
    }
    fun h(n: i64) -> i64 {
        n + k
    }
|}
file := argv()[0]
each((VasmError{_, Loc{_, l, c}, msg}) -> put(f"line {l}: {msg}\n"), native_compile.errors(file, arg(native_compile.compile_all(m), 1)))
