use("list")
use("pretty")
xs := [3, 1, 4, 1, 5]
print(f"{length(xs)} {list.sum(xs)} {list.nth(xs, 2)} {list.last(xs)}")
print(f"{reverse(xs)} {append([0], xs)} {list.concat([[1], [2, 3]])}")
print(f"{list.take(xs, 2)} {list.drop(xs, 2)}")
print(f"{find(x -> x > 3, xs)} {list.any(x -> x > 4, xs)} {list.all(x -> x > 0, xs)}")
print(f"{member(4, xs)} {list.index_of(4, xs)} {list.index_of(9, xs)}")
print(f"{list.foldr((x, acc) -> x :: acc, [], xs)}")
print(f"{concat_map(x -> [x, x], [1, 2])}")
each(x -> print(f"<{x}>"), [1, 2, 3])
print("")
