Def{
  f,
  Lambda{
    Tuple{xs},
    Handle{
      Do{
        Apply{
          peg_for,
          Tuple{
            xs,
            Lambda{
              Tuple{x},
              If{
                Apply{gt, Tuple{x, 0}},
                Perform{Return{x}},
                none
              }
            }
          }
        },
        0
      },
      Lambda{Tuple{Return{v}, k}, v}
    }
  }
}
