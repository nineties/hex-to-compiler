Do{
  Declare{f},
  Set{
    f,
    Fusion{
      f,
      Lambda{
        (xs),
        Handle{
          Do{
            Apply{
              peg_for,
              (
                xs,
                Lambda{
                  (x),
                  If{
                    Apply{_gt, (x, 0)},
                    Perform{Return{x}},
                    none
                  }
                }
              )
            },
            0
          },
          Lambda{(Return{v}, k), v}
        }
      }
    }
  }
}
