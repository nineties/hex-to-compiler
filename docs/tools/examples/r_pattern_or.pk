size(0 or 1) := "small"
size(_) := "big"
println(size(1))
println(size(2))
kind(F{1 or 2, x}) := "small first"
kind(_) := "other"
println(kind(F{2, 0}))
sign(x) if x > 0 := "positive"
sign(0) := "zero"
sign(_) := "negative"
println(sign(5))
println(sign(0))
println(sign(-5))
same(a, a) := "same"
same(_, _) := "differ"
println(same([1], [1]))
println(same([1], [2]))
origin((x, 0) or (0, x)) := x
origin(_) := "none"
println(origin((0, 4)))
println(origin((1, 2)))
