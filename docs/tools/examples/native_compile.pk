use("native/compile")
use("vasm/text")

m := native{|
    fun gcd(a: i64, b: i64) -> i64 {
        while b != 0 {
            let t = a % b
            a = b
            b = t
        }
        a
    }

    fun bump[r](m: &mutable r [i32], n: i32) {
        for i in 0 as i32..n {
            m[i] += 1
        }
    }
|}
put(vasm_text.text(native_compile.compile(m)))
