use("vasm/check")

report(m) := {
    es := vasm_check.errors(argv()[0], m)
    if (es == []) put("ok\n")
    each((VasmError{_, Loc{_, l, c}, msg}) -> put(f"line {l}: {msg}\n"), es)
}

m := vasm{|
    fun bump[r](p: &mutable r i64) {
        var v: i64
        v = *p
        v = v + 1
        *p = v
    }
    fun main() -> i64 {
        var p: own i64
        var v: i64
        p = box(41)
        region r {
            var m: &mutable r i64
            m = &mutable r p
            bump(m)
        }
        v = *p
        free(p)
        return v
    }
|}
report(m)
