use("u64")
a := u64.hex("0xffffffffffffffff")
b := u64.add(a, u64.from_int(2))
println(u64.to_hex(b))
println(u64.to_hex(u64.shl(u64.hex("0x0123456789abcdef"), 36)))
println(u64.to_hex(u64.sar(u64.hex("0x8000000000000000"), 60)))
println(u64.ucmp(u64.from_int(-1), u64.from_int(1)))
println(u64.scmp(u64.from_int(-1), u64.from_int(1)))
buf := u8_array(8)
u64.write_le(buf, 0, u64.hex("0x0102030405060708"))
println(buf[0])
println(buf[7])
