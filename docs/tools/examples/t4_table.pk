use("list")
use("string")
use("table")
count := table.new()
for (w in string.split("the cat and the hat", " "))
    table.set(count, w, table.get(count, w, 0) + 1)
for (k in list.sort(string.string_less, table.keys(count)))
    print(f"{k} {table.get(count, k, 0)}")

use("vector")
v := vector.new()
vector.push(v, "a")
vector.push(v, "b")
print(vector.len(v))
print(vector.get(v, 1))
