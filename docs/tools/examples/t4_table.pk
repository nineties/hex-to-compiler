use("list")
use("string")
use("table")
count := table()
for (w in split("the cat and the hat", " "))
    table_set(count, w, table_get(count, w, 0) + 1)
for (k in sort(str_less, table_keys(count)))
    put(f"{k} {table_get(count, k, 0)}\n")

use("vector")
v := vec_new()
vec_push(v, "a")
vec_push(v, "b")
println(vec_len(v))
println(vec_get(v, 1))
