use("psys/expand")
use("vasm/text")

m := psys{|
    fn gcd(a: i64, b: i64) -> i64 {
        while b != 0 {
            let t = a % b
            a = b
            b = t
        }
        a
    }

    fn bump[r](m: &mut r [i32], n: i32) {
        for i in 0 as i32..n {
            m[i] += 1
        }
    }
|}
put(vasm_text(psys_expand(m)))
