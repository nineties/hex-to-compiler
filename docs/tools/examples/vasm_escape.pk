use("vasm/check")

report(m) := {
    es := vasm_check.errors(argv()[0], m)
    if (es == []) put("ok\n")
    each((VasmError{_, Loc{_, l, c}, msg}) -> put(f"line {l}: {msg}\n"), es)
}

m := vasm{|
    fun inner_in_outer() {
        var p: own i64
        p = box(1)
        region outer {
            var keep: &outer i64
            region inner {
                var a: &inner i64
                a = &inner p
                keep = a
            }
        }
    }
    fun outer_in_inner() {
        var p: own i64
        p = box(1)
        region outer {
            var a: &outer i64
            a = &outer p
            region inner {
                var b: &inner i64
                b = a
            }
        }
    }
|}
report(m)
