> '(x := 1)
Def{x, 1}
> '(f(x) := x + 1)
Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{x}, Apply{_add, Tuple{x, 1}}}}}}
> '(x = 2)
Set{x, 2}
> '(f | g)
Fusion{f, g}
> '(x -> x)
Lambda{Tuple{x}, x}
> '(a and b or c)
If{If{a, b, false}, true, c}
> '(not a)
Apply{_not, Tuple{a}}
> '(a :: b)
Cons{a, b}
> '(-a)
Apply{_sub, Tuple{0, a}}
> '(t.f)
Apply{_record_get, Tuple{t, Quote{f}}}
> '(a[i])
Apply{_index_get, Tuple{a, i}}
> '(a[i] = v)
Apply{_index_set, Tuple{a, i, v}}
> '(p @ Int)
_TypeOf{p, Int}
> '(if (c) a)
If{c, a, none}
> '(while (c) e)
While{c, e}
> '(for (x in xs) f(x))
Apply{peg_for, Tuple{xs, Lambda{Tuple{x}, Apply{f, Tuple{x}}}}}
> '(match e { 0 -> a | _ -> b })
Apply{Fusion{Lambda{Tuple{0}, a}, Lambda{Tuple{_}, b}}, Tuple{e}}
> '(handle e with h)
Handle{e, h}
> '(perform E{})
Perform{E{}}
> '(record T(a, b) = t)
Do{Def{%record, Apply{_record, Tuple{Quote{T}, Quote{Tuple{a, b}}}}}, Def{T, Apply{arg, Tuple{%record, 0}}}, Def{t, Apply{arg, Tuple{%record, 1}}}, Declare{_with}, Set{_with, Fusion{_with, Apply{_record_with, Tuple{T, t}}}}}
> '[1, 2]
Cons{1, Cons{2, Nil{}}}
