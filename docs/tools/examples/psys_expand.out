fn gcd(a: i64, b: i64) -> i64 {
    while (b != 0) {
        var t: i64
        t = a % b
        a = b
        b = t
    }
    return a
}

fn bump[r](m: &mut r [i32], n: i32) {
    var t0: i32
    t0 = n
    var i: i32
    i = 0
    while (i < t0) {
        var t1: i64
        t1 = i as i64
        var t2: i32
        t2 = m[t1]
        t2 = t2 + 1
        m[t1] = t2
        i = i + 1
    }
}
