use("table")
use("getopt")
spec := [Opt{"a", "all", false}, Opt{"o", "output", true}, Opt{"", "level", true}]
use("list")
args := list.list_to_array(["prog", "-ao", "out.txt", "x", "--level=3", "--", "-y"])
r := getopt.parse(spec, args, 1)
print(head(r))
options := arg(r, 0)
print(table.get(options, "all", false))
print(table.get(options, "output", none))
print(table.get(options, "level", none))
rest := arg(r, 1)
print(array_len(rest))
print(rest[0])
print(rest[1])
print(getopt.parse(spec, list.list_to_array(["prog", "-ax"]), 1))
print(getopt.parse(spec, list.list_to_array(["prog", "-o"]), 1))
