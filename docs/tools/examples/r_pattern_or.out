> size(0 or 1) := "small"
... size(_) := "big"
> size(1)
"small"
> size(2)
"big"
> kind(F{1 or 2, x}) := "small first"
... kind(_) := "other"
> kind(F{2, 0})
"small first"
> sign(x) if x > 0 := "positive"
... sign(0) := "zero"
... sign(_) := "negative"
> sign(5)
"positive"
> sign(0)
"zero"
> sign(-5)
"negative"
> same(a, a) := "same"
... same(_, _) := "differ"
> same([1], [1])
"same"
> same([1], [2])
"differ"
> origin((x, 0) or (0, x)) := x
... origin(_) := "none"
> origin((0, 4))
4
> origin((1, 2))
"none"
