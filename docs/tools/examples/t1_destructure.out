> (a, b) := (1, 2)
> a + b
3
> (a, b) = (b, a)
> Tuple{a, b}
Tuple{2, 1}
> divmod(x, y) := (x / y, x % y)
> (q, r) := divmod(17, 5)
> Tuple{q, r}
Tuple{3, 2}
> fib(n) := {
...     (x, y) := (0, 1)
...     i := 0
...     while (i < n) {
...         (x, y) = (y, x + y)
...         i = i + 1
...     }
...     x
... }
> fib(10)
55
