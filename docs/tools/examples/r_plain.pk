b := u8_array(4)
b[0] = 72
b[1] = 0
b[2] = 255
println(plain_len(b))
println(b[2])
println(plain_kind(b))
write_file("tmp-plain.bin", b)
c := read_bytes("tmp-plain.bin")
println(c[1])
println(plain_len(c))
println(bit_and(0xff0, 0x3c))
println(bit_xor(5, 3))
println(bit_shl(1, 20))
println(bit_shr(-1, 28))
println(bit_sar(-256, 4))
s := "ab"
println(s[1])
