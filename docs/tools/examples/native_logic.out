fun both(a: i64, b: i64) -> bool {
    var t0: bool
    t0 = a > 0
    var t1: bool
    t1 = t0
    if (t1) {
        var t2: bool
        t2 = b > 0
        t1 = t2
    }
    return t1
}

fun mask(x: i32) -> i32 {
    var t0: i32
    t0 = 2047
    t0 = t0 << 15
    t0 = t0 | 32767
    var t1: i32
    t1 = x & t0
    return t1
}
