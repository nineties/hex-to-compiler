use("vasm/check")

report(m) := {
    es := vasm_check.errors(argv()[0], m)
    if (es == []) put("ok\n")
    each((VasmError{_, Loc{_, l, c}, msg}) -> put(f"line {l}: {msg}\n"), es)
}

m := vasm{|
    fun two_shared() -> i64 {
        var p: own i64
        var v: i64
        p = box(1)
        region r {
            var a: &r i64
            var b: &r i64
            a = &r p
            b = &r p
            var w: i64
            v = *a
            w = *b
            v = v + w
        }
        free(p)
        return v
    }
    fun mut_and_shared() {
        var p: own i64
        p = box(1)
        region r {
            var a: &mutable r i64
            var b: &r i64
            a = &mutable r p
            b = &r p
        }
    }
    fun overwrite_while_borrowed() -> i64 {
        var p: own i64
        var v: i64
        p = box(1)
        region r {
            var a: &r i64
            a = &r p
            p = box(2)
            v = *a
        }
        return v
    }
|}
report(m)
