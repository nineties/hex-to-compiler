UI_JA := table.new()
table.set(UI_JA, "sub", "自分自身をブートストラップする処理系")
table.set(UI_JA, "overview", "概要")
table.set(UI_JA, "out", "出力")
table.set(UI_JA, "prev", "前のページ")
table.set(UI_JA, "next", "次のページ")
table.set(UI_JA, "toc", "の目次")
table.set(UI_JA, "switch", "English")
table.set(UI_JA, "lang", "ja")

UI_EN := table.new()
table.set(UI_EN, "sub", "A compiler that pulls itself up by its bootstraps.")
table.set(UI_EN, "overview", "Overview")
table.set(UI_EN, "out", "Output")
table.set(UI_EN, "prev", "Previous")
table.set(UI_EN, "next", "Next")
table.set(UI_EN, "toc", " contents")
table.set(UI_EN, "switch", "日本語")
