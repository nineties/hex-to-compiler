# build.pk: writes docs/ from the page sources in src/, the examples and the source files.
# Copyright (C) 2026 nineties
#
# usage (in the root of the repository): ./planck0 docs/tools/build.pk
#
# src/ has the pieces of the pages: src/ja for Japanese and src/en for English. The Japanese pages
# are written to docs/ja/ and the English pages to docs/en/. The first line of a piece is
# <!--title TITLE-->. These marks in a piece are replaced:
#   <!--ex NAME-->     examples/NAME.pk and examples/NAME.out, as the code and its output
#   <!--src NAME-->    only examples/NAME.pk
#   <!--repl NAME-->   examples/NAME.out as a session at the prompt of the REPL (a line "> expression", the
#                      lines of it that go on "... expression", and then the lines of the output and the value).
#                      examples/NAME.repl is the input, and run_examples.sh makes the .out with repl.pk
#   <!--out NAME-->    only examples/NAME.out
#   <!--text NAME-->   examples/NAME.txt, as code that is not planck
#   <!--bits ... -->   a diagram of 32-bit words as an HTML table. A line is one word,
#                      "label | field text/width | ...", and the widths of a line must add up to 32
#   <!--diagram-->     the diagram of the stages (inline SVG, a wide one and a narrow one)
#   <!--file F A-->    an excerpt of the source F. A is the start of a line, and the excerpt is the item
#                      that begins at the line (for a line at the left edge, up to the blank line before
#                      the next line at the left edge).
#                      <!--file F A .. B--> is from the line A to the line before B,
#                      <!--file F A ..--> is from the line A to the end, and <!--file F--> is the whole file
#   [[F A]]            a link to the item A of the source F ([[F A .. B]] is the same).
#                      A and B must each match exactly one line, or the build stops
#                      (write fun f, not (fun f, which starts with a parenthesis)
# The blocks of ex and repl in the pages of the tutorial get a button that runs the code in the browser (assets/planck-run.js), and src/LANG/playground.html is
# the page of an editor to run code.
# The code of planck is written as HTML with spans of the classes by highlight.html (planck/lib/highlight.pk).
# docs/index.html is the entrance that chooses a language, and the pages at the old URLs such as docs/tutorial/
# only move to docs/ja/.

use("base")
use("list")
use("string")
use("table")
use("vector")
use("highlight")

SRC := "docs/tools/src"
EX := "docs/tools/examples"
OUT := "docs"
REPO := "https://github.com/nineties/hex-to-compiler"
SITE := "hex-to-compiler project"

# === Text ===

# the character classes of the bytes
is_word(c) := string.is_alnum(c) or c == 95 or c >= 128
is_path(c) := is_word(c) or c == 46 or c == 47 or c == 45
is_blank(c) := c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12

starts_at(s, i, pat) := {
    m := strlen(pat)
    ok := i >= 0 and i + m <= strlen(s)
    k := 0
    while (ok and k < m) {
        if (ord(s, i + k) != ord(pat, k)) ok = false
        k = k + 1
    }
    ok
}

# str_find(s, pat, from) is the first position >= from where pat starts, or -1
str_find(s, pat, from) := {
    n := strlen(s)
    m := strlen(pat)
    c0 := ord(pat, 0)
    i := from
    r := -1
    while (r < 0 and i + m <= n) {
        if (ord(s, i) == c0 and starts_at(s, i, pat)) r = i
        i = i + 1
    }
    r
}

# the position after the bytes of s from i that are accepted by ok
run_end(s, i, ok) := {
    n := strlen(s)
    while (i < n and ok(ord(s, i))) i = i + 1
    i
}

# the first position of s that is not blank (strlen(s) for a blank string)
lead(s) := run_end(s, 0, is_blank)

strip(s) := {
    i := lead(s)
    j := strlen(s)
    while (j > i and is_blank(ord(s, j - 1))) j = j - 1
    substr(s, i, j)
}

# rstrip_nl("a\n\n") is "a"
rstrip_nl(s) := {
    j := strlen(s)
    while (j > 0 and ord(s, j - 1) == 10) j = j - 1
    substr(s, 0, j)
}

# the number of characters of the UTF-8 string s
char_count(s) := {
    n := 0
    i := 0
    while (i < strlen(s)) {
        c := ord(s, i)
        if (c < 128 or c >= 192) n = n + 1
        i = i + 1
    }
    n
}

replace_lit(s, pat, rep) := {
    b := strbuf.new()
    pos := 0
    i := str_find(s, pat, 0)
    while (i >= 0) {
        strbuf.add(b, substr(s, pos, i))
        strbuf.add(b, rep)
        pos = i + strlen(pat)
        i = str_find(s, pat, pos)
    }
    if (pos == 0) s else {
        strbuf.add(b, substr(s, pos, strlen(s)))
        strbuf.string(b)
    }
}

html_escape(s) := {
    n := strlen(s)
    b := strbuf.new()
    start := 0
    i := 0
    while (i < n) {
        c := ord(s, i)
        r := if (c == 38) "&amp;" else if (c == 60) "&lt;" else if (c == 62) "&gt;"
             else if (c == 34) "&quot;" else if (c == 39) "&#x27;" else none
        if (r != none) {
            strbuf.add(b, substr(s, start, i))
            strbuf.add(b, r)
            start = i + 1
        }
        i = i + 1
    }
    if (start == 0) s else {
        strbuf.add(b, substr(s, start, n))
        strbuf.string(b)
    }
}

# the lines of s without the newlines, as a vector
split_lines(s) := {
    v := vector.new()
    n := strlen(s)
    start := 0
    i := 0
    while (i < n) {
        if (ord(s, i) == 10) {
            vector.push(v, substr(s, start, i))
            start = i + 1
        }
        i = i + 1
    }
    if (start < n) vector.push(v, substr(s, start, n))
    v
}

# the lines from a to b - 1 of the vector ls, joined by newlines
join_lines(ls, a, b) := {
    bf := strbuf.new()
    i := a
    while (i < b) {
        if (i > a) strbuf.add(bf, "\n")
        strbuf.add(bf, ls[i])
        i = i + 1
    }
    strbuf.string(bf)
}

# scan(s, prefix, f) replaces the texts that start with prefix: f(s, i) is none, or (the end of the match, the new text)
scan(s, prefix, f) := {
    b := strbuf.new()
    pos := 0
    i := str_find(s, prefix, 0)
    while (i >= 0) {
        m := f(s, i)
        if (m == none) i = str_find(s, prefix, i + 1)
        else {
            strbuf.add(b, substr(s, pos, i))
            strbuf.add(b, arg(m, 1))
            pos = arg(m, 0)
            i = str_find(s, prefix, pos)
        }
    }
    strbuf.add(b, substr(s, pos, strlen(s)))
    strbuf.string(b)
}

# === Reading files ===

read_text(path) := {
    t := try_read_file(path)
    if (t == none) panic(f"missing {path}")
    t
}

used_examples := table.new()

ex_file(name, ext) := {
    table.set(used_examples, name, true)
    read_text(f"{EX}/{name}.{ext}")
}

source_lines := table.new()

# the lines of a source file of the repository
lines_of(f) := {
    ls := table.get(source_lines, f, none)
    if (ls == none) {
        ls = split_lines(read_text(f))
        table.set(source_lines, f, ls)
    }
    ls
}

