# Copyright (C) 2026 nineties

module playground {
    export run() := {
        mode := read_line()
        b := strbuf.new()
        entries := []
        line := read_line()
        while (line != none) {
            if (mode == "session" and strlen(line) == 1 and ord(line, 0) == 12) {
                entries = strbuf.string(b) :: entries
                b = strbuf.new()
            } else {
                strbuf.add(b, line)
                strbuf.add(b, "\n")
            }
            line = read_line()
        }
        if (mode == "session") {
            ok := true
            es := list.reverse(strbuf.string(b) :: entries)
            while (ok and es != []) {
                ok = eval_text.run(list.nth(es, 0), "<playground>", true, true, eval_text.strip_compiler)
                es = list.drop(es, 1)
            }
            if (ok) print("\f")
        } else eval_text.run(strbuf.string(b), "<playground>", mode == "repl", mode == "repl", eval_text.strip_compiler)
    }
}
