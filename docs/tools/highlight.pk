# highlight.pk IN OUT: IN/index.txt lists names, one on each line. For each name,
# write the highlighted HTML of IN/<name>.pk to OUT/<name>.html
use("highlight")
args := argv()
for (name in split(read_file(_strcat(args[1], "/index.txt")), "\n")) {
    if (strlen(name) > 0) {
        write_file(_strcat(_strcat(_strcat(args[2], "/"), name), ".html"), highlight.html(read_file(_strcat(_strcat(_strcat(args[1], "/"), name), ".pk"))))
    }
}
