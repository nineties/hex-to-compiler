# vasm/builtins: the functions of vasm that do what built-in functions of planck do
# Copyright (C) 2026 nineties
#
# vasm_planck.builtins is Module{[...]} of these functions. A program that is translated to vasm calls them where the planck program calls
# the built-in function of the same name, with a value that is known only when the program runs.
#   strlen(s) is the number of bytes of the array s
#   println_string(s) writes the bytes of s between two double quotes, and a new line, to the output (the form println gives a string,
#       without escapes)
#   println_int(n) writes the decimal digits of n and a new line to the output
#   read_file(path) is the array of the bytes of the file whose name is path; a file that cannot be opened ends the program with the status 1
# Strings are arrays of u8 (&r [u8] when borrowed, own [u8] when owned). The arguments of the program, which argv(i) of vasm gives,
# are strings too.

use("base")
use("list")
use("vasm/check")

module vasm_planck {
    export builtins := vasm{|
        fun strlen[r](s: &r [u8]) -> i32 {
            var n: i64
            var m: i32
            n = len(s)
            m = n as i32
            return m
        }
        fun println_string[r](s: &r [u8]) {
            var n: i64
            n = write(1, "\"")
            n = write(1, s)
            n = write(1, "\"\n")
        }
        fun println_int(v: i64) {
            var buf: own [u8]
            var out: own [u8]
            var i: i64
            var j: i64
            var k: i64
            var n: i64
            var x: i64
            var d: i64
            var c: u8
            var neg: bool
            buf = allocate(24, 0)
            i = 23
            buf[i] = 10
            x = v
            neg = x < 0
            if (neg) { x = 0 - x }
            if (x == 0) { i = i - 1; buf[i] = 48 }
            while (x > 0) {
                d = x % 10
                c = d as u8
                c = c + 48
                i = i - 1
                buf[i] = c
                x = x / 10
            }
            if (neg) { i = i - 1; buf[i] = 45 }
            n = 24 - i
            out = allocate(n, 0)
            j = 0
            while (j < n) {
                k = i + j
                c = buf[k]
                out[j] = c
                j = j + 1
            }
            region r {
                var b: &r [u8]
                b = &r out
                n = write(1, b)
            }
        }
        fun read_file[r](path: &r [u8]) -> own [u8] {
            var fd: i64
            var acc: own [u8]
            var chunk: own [u8]
            var next: own [u8]
            var n: i64
            var got: i64
            var total: i64
            var i: i64
            var k: i64
            var c: u8
            var more: bool
            fd = open(path)
            if (fd < 0) { exit(1) }
            acc = allocate(0, 0)
            chunk = allocate(4096, 0)
            n = 0
            more = true
            while (more) {
                region g {
                    var m: &mutable g [u8]
                    m = &mutable g chunk
                    got = read(fd, m)
                }
                if (got > 0) {
                    total = n + got
                    next = allocate(total, 0)
                    i = 0
                    while (i < n) {
                        c = acc[i]
                        next[i] = c
                        i = i + 1
                    }
                    i = 0
                    while (i < got) {
                        c = chunk[i]
                        k = n + i
                        next[k] = c
                        i = i + 1
                    }
                    acc = next
                    n = total
                } else {
                    more = false
                }
            }
            close(fd)
            return acc
        }
        fun v_write[r](fd: i64, s: &r [u8]) {
            var n: i64
            n = write(fd, s)
        }
        fun v_bytes_write(fd: i64, v: value) {
            var b: own [u8]
            b = v as own [u8]
            region g {
                var s: &g [u8]
                s = &g b
                v_write(fd, s)
            }
        }
        fun v_digits(v: i64) -> value {
            var buf: own [u8]
            var out: own [u8]
            var i: i64
            var j: i64
            var k: i64
            var n: i64
            var x: i64
            var d: i64
            var c: u8
            var neg: bool
            var r: value
            buf = allocate(24, 0)
            i = 24
            x = v
            neg = x < 0
            if (neg) { x = 0 - x }
            if (x == 0) { i = i - 1; buf[i] = 48 }
            while (x > 0) {
                d = x % 10
                c = d as u8
                c = c + 48
                i = i - 1
                buf[i] = c
                x = x / 10
            }
            if (neg) { i = i - 1; buf[i] = 45 }
            n = 24 - i
            out = allocate(n, 0)
            j = 0
            while (j < n) {
                k = i + j
                c = buf[k]
                out[j] = c
                j = j + 1
            }
            region g {
                var s: &g [u8]
                s = &g out
                r = s as value
            }
            return r
        }
        fun v_print(v: value) -> value {
            var t: value
            var b: bool
            var n: i64
            var i: i64
            var x: value
            t = typeof(v)
            b = t == 'int
            if (b) {
                n = v as i64
                x = v_digits(n)
                v_bytes_write(1, x)
                return 'none
            }
            b = t == 'string
            if (b) {
                v_write(1, "\"")
                v_bytes_write(1, v)
                v_write(1, "\"")
                return 'none
            }
            b = t == 'symbol
            if (b) {
                x = symname(v)
                v_bytes_write(1, x)
                return 'none
            }
            b = t == 'mexpr
            if (b) {
                x = head(v)
                x = symname(x)
                v_bytes_write(1, x)
                v_write(1, "{")
                n = arity(v)
                i = 0
                while (i < n) {
                    if (i > 0) { v_write(1, ", ") }
                    x = v[i]
                    x = v_print(x)
                    i = i + 1
                }
                v_write(1, "}")
                return 'none
            }
            b = t == 'array
            if (b) {
                v_write(1, "<array>")
                return 'none
            }
            v_write(1, "<function>")
            return 'none
        }
        fun v_println(v: value) -> value {
            var x: value
            x = v_print(v)
            v_write(1, "\n")
            return 'none
        }
        fun v_put(v: value) -> value {
            v_bytes_write(1, v)
            return 'none
        }
        fun v_stop[r](msg: &r [u8]) {
            v_write(2, msg)
            v_write(2, "\n")
            exit(1)
        }
        fun v_exit(v: value) -> value {
            var n: i64
            n = v as i64
            exit(n)
            return 'none
        }
        fun v_strlen(v: value) -> value {
            var n: i64
            var r: value
            n = arity(v)
            r = n as value
            return r
        }
        fun v_ord(v: value, iv: value) -> value {
            var b: own [u8]
            var i: i64
            var n: i64
            var c: u8
            var d: i64
            var r: value
            var ok: bool
            i = iv as i64
            b = v as own [u8]
            n = arity(v)
            d = 0 - 1
            ok = i >= 0
            if (ok) {
                ok = i < n
                if (ok) {
                    c = b[i]
                    d = c as i64
                }
            }
            r = d as value
            return r
        }
        fun v_substr(v: value, iv: value, jv: value) -> value {
            var b: own [u8]
            var out: own [u8]
            var i: i64
            var j: i64
            var n: i64
            var k: i64
            var at: i64
            var c: u8
            var r: value
            i = iv as i64
            j = jv as i64
            b = v as own [u8]
            n = j - i
            out = allocate(n, 0)
            k = 0
            while (k < n) {
                at = i + k
                c = b[at]
                out[k] = c
                k = k + 1
            }
            region g {
                var s: &g [u8]
                s = &g out
                r = s as value
            }
            return r
        }
        fun v_strcat(x: value, y: value) -> value {
            var a: own [u8]
            var b: own [u8]
            var out: own [u8]
            var n: i64
            var m: i64
            var k: i64
            var at: i64
            var c: u8
            var total: i64
            var r: value
            a = x as own [u8]
            b = y as own [u8]
            n = arity(x)
            m = arity(y)
            total = n + m
            out = allocate(total, 0)
            k = 0
            while (k < n) {
                c = a[k]
                out[k] = c
                k = k + 1
            }
            k = 0
            while (k < m) {
                c = b[k]
                at = n + k
                out[at] = c
                k = k + 1
            }
            region g {
                var s: &g [u8]
                s = &g out
                r = s as value
            }
            return r
        }
        fun v_to_text(v: value) -> value {
            var t: value
            var b: bool
            var n: i64
            var x: value
            t = typeof(v)
            b = t == 'string
            if (b) { return v }
            b = t == 'int
            if (b) {
                n = v as i64
                x = v_digits(n)
                return x
            }
            b = t == 'symbol
            if (b) {
                x = symname(v)
                return x
            }
            v_stop("_to_text of a value other than a string, an integer or a symbol is not left in vasm")
            return 'none
        }
        fun v_head(v: value) -> value {
            var r: value
            r = head(v)
            return r
        }
        fun v_arity(v: value) -> value {
            var n: i64
            var r: value
            n = arity(v)
            r = n as value
            return r
        }
        fun v_arg(v: value, iv: value) -> value {
            var i: i64
            var r: value
            i = iv as i64
            r = v[i]
            return r
        }
        fun v_typeof(v: value) -> value {
            var r: value
            r = typeof(v)
            return r
        }
        fun v_intern(v: value) -> value {
            var r: value
            r = intern(v)
            return r
        }
        fun v_symname(v: value) -> value {
            var r: value
            r = symname(v)
            return r
        }
        fun v_array(nv: value) -> value {
            var n: i64
            var r: value
            n = nv as i64
            r = array(n, 'none)
            return r
        }
        fun v_plain_array(nv: value) -> value {
            var n: i64
            var r: value
            var z: value
            n = nv as i64
            z = 0 as value
            r = array(n, z)
            return r
        }
        fun v_argv() -> value {
            var n: i64
            var i: i64
            var a: value
            var s: &static [u8]
            var e: value
            n = argc()
            a = array(n, 'none)
            i = 0
            while (i < n) {
                s = argv(i)
                e = s as value
                a[i] = e
                i = i + 1
            }
            return a
        }
        fun v_array_set(a: value, iv: value, x: value) -> value {
            var i: i64
            i = iv as i64
            a[i] = x
            return x
        }
        fun v_push(v: value, x: value) -> value {
            var n: i64
            var m: i64
            var i: i64
            var a: value
            var e: value
            var h: value
            var r: value
            n = arity(v)
            m = n + 1
            a = array(m, 'none)
            i = 0
            while (i < n) {
                e = v[i]
                a[i] = e
                i = i + 1
            }
            a[n] = x
            h = head(v)
            r = mexpr(h, a)
            return r
        }
        fun v_mexpr(h: value, t: value) -> value {
            var n: i64
            var i: i64
            var a: value
            var e: value
            var r: value
            n = arity(t)
            a = array(n, 'none)
            i = 0
            while (i < n) {
                e = t[i]
                a[i] = e
                i = i + 1
            }
            r = mexpr(h, a)
            return r
        }
        fun v_index_get(a: value, iv: value) -> value {
            var t: value
            var b: bool
            var i: i64
            var r: value
            var j: value
            t = typeof(a)
            b = t == 'string
            if (b) {
                i = iv as i64
                i = i + 1
                r = i as value
                j = v_substr(a, iv, r)
                return j
            }
            i = iv as i64
            b = is(a, 'Cons, 2)
            if (b) {
                r = a
                while (i > 0) {
                    r = r[1]
                    i = i - 1
                }
                r = r[0]
                return r
            }
            r = a[i]
            return r
        }
        fun v_index_set(a: value, iv: value, x: value) -> value {
            var i: i64
            i = iv as i64
            a[i] = x
            return x
        }
        fun v_hash(v: value) -> value {
            var t: value
            var b: bool
            var n: i64
            var h: i64
            var i: i64
            var c: u8
            var d: i64
            var e: value
            var r: value
            h = 7
            t = typeof(v)
            b = t == 'int
            if (b) {
                h = v as i64
                if (h < 0) { h = 0 - h }
                h = h % 32749
            }
            b = t == 'string
            if (b) {
                var s: own [u8]
                s = v as own [u8]
                n = arity(v)
                i = 0
                while (i < n) {
                    c = s[i]
                    d = c as i64
                    h = h * 31
                    h = h + d
                    h = h % 32749
                    i = i + 1
                }
            }
            b = t == 'symbol
            if (b) {
                e = symname(v)
                r = v_hash(e)
                return r
            }
            b = t == 'mexpr
            if (b) {
                n = arity(v)
                i = 0
                while (i < n) {
                    e = v[i]
                    r = v_hash(e)
                    d = r as i64
                    h = h * 31
                    h = h + d
                    h = h % 32749
                    i = i + 1
                }
            }
            r = h as value
            return r
        }
        fun v_read_file(path: value) -> value {
            var b: own [u8]
            var p: own [u8]
            var r: value
            p = path as own [u8]
            region g {
                var ps: &g [u8]
                ps = &g p
                b = read_file(ps)
            }
            region h {
                var s: &h [u8]
                s = &h b
                r = s as value
            }
            return r
        }
        fun v_try_read_file(path: value) -> value {
            var p: own [u8]
            var fd: i64
            var r: value
            var bad: bool
            p = path as own [u8]
            region g {
                var ps: &g [u8]
                ps = &g p
                fd = open(ps)
            }
            bad = fd < 0
            if (bad) { return 'none }
            close(fd)
            r = v_read_file(path)
            return r
        }
        fun v_read_bytes(path: value) -> value {
            var s: value
            var a: value
            var b: own [u8]
            var n: i64
            var i: i64
            var c: u8
            var d: i64
            var e: value
            var z: value
            s = v_read_file(path)
            b = s as own [u8]
            n = arity(s)
            z = 0 as value
            a = array(n, z)
            i = 0
            while (i < n) {
                c = b[i]
                d = c as i64
                e = d as value
                a[i] = e
                i = i + 1
            }
            return a
        }
        fun v_write_file(path: value, x: value) -> value {
            var p: own [u8]
            var b: own [u8]
            var t: value
            var isarr: bool
            var fd: i64
            var n: i64
            var i: i64
            var e: value
            var d: i64
            var c: u8
            var bad: bool
            t = typeof(x)
            isarr = t == 'array
            if (isarr) {
                n = arity(x)
                b = allocate(n, 0)
                i = 0
                while (i < n) {
                    e = x[i]
                    d = e as i64
                    c = d as u8
                    b[i] = c
                    i = i + 1
                }
            } else {
                b = x as own [u8]
            }
            p = path as own [u8]
            region g {
                var ps: &g [u8]
                ps = &g p
                fd = create(ps)
            }
            bad = fd < 0
            if (bad) { v_stop("write_file: the file cannot be written") }
            region h {
                var s: &h [u8]
                s = &h b
                n = write(fd, s)
            }
            close(fd)
            return x
        }
    |}
}
