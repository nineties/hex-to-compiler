# vasm/check: a language with types, ownership and named regions, written in .pk files
# Copyright (C) 2026 nineties
#
# vasm{| struct ... fn ... |} reads structs and functions of the language and is Module{[Struct{...}, Fn{...}, ...]}.
# vasm_check.check(m) is the list of VasmErr{kind, Pos{d}, msg}, one for each struct or function with an error,
# and vasm_check.errors(file, m) gives the positions as Loc{file, line, column} of the file.
# The declarations of the syntax are written outside the module, at the top level, and the functions of the checker are in the module vasm_check.

use("list")
use("table")
use("string")
use("error")

# === Syntax ===

# the elements of Tuple{a, ...} as a list
vasm_tlist(t) := {
    xs := []
    i := arity(t) - 1
    while (i >= 0) {
        xs = arg(t, i) :: xs
        i = i - 1
    }
    xs
}

# the list in the value Tuple{} or Tuple{xs} of e?
vasm_opt_list(t) := if (arity(t) == 0) [] else arg(t, 0)

# vasm_here reads nothing and is Pos{d}, where d is the number of characters from the next token to the end of the text.
# The text parsed is the rest of the file, so d also counts to the end of the file.
_define_rule('vasm_here, p -> {
    peg_pv = Pos{peg_srclen - peg_skip_ws(p)}
    p
})
_define_rule('vasm_same, 'Same{})
_define_rule('vasm_newline, 'Not{Same{}})

vasm_kw ::= ('fn | 'struct | 'var | 'region | 'own | 'mut | 'i8 | 'i16 | 'i32 | 'i64 | 'u8 | 'u16 | 'u32 | 'u64 | 'f32 | 'f64 | 'bool | 'val | 'true | 'false | 'if | 'else | 'while | 'return | 'as | 'static)
vasm_name ::= !vasm_kw x:ident { x }

# the value of the text s of an integer literal, or Big{s} if it is out of -32768 to 32767.
# The value is not computed past the range, so that it does not wrap around as an integer of planck.
vasm_lit_value(s) := {
    n := strlen(s)
    i := 0
    sign := 1
    if (ord(s, 0) == 45) {
        sign = -1
        i = 1
    }
    base := 10
    if (n > i + 1 and ord(s, i) == 48) {
        c := ord(s, i + 1)
        if (c == 120 or c == 88) base = 16 else if (c == 111 or c == 79) base = 8 else if (c == 98 or c == 66) base = 2
        if (base != 10) i = i + 2
    }
    v := 0
    big := false
    while (i < n) {
        if (not big) {
            v = v * base + peg_digit_value(ord(s, i))
            if (v > 32768) big = true
        }
        i = i + 1
    }
    v = sign * v
    if (big or v > 32767) Big{s} else v
}

# an integer literal as integer reads it, with the value of vasm_lit_value
_define_rule('vasm_int_lit, p -> {
    s := peg_skip_ws(p)
    q := peg_tok_int(p)
    if (q >= 0) peg_pv = vasm_lit_value(substr(peg_src, s, q))
    q
})

vasm_type ::= 'i8 { I8{} } | 'i16 { I16{} } | 'i32 { I32{} } | 'i64 { I64{} }
    | 'u8 { U8{} } | 'u16 { U16{} } | 'u32 { U32{} } | 'u64 { U64{} }
    | 'f32 { F32{} } | 'f64 { F64{} }
    | 'bool { Bool{} }
    | 'val { Val{} }
    | 'own t:vasm_type { Own{t} }
    | "&" 'static t:vasm_type { Ref{'shr, 'static, t} }
    | "&" 'mut r:vasm_name t:vasm_type { Ref{'mut, r, t} }
    | "&" r:vasm_name t:vasm_type { Ref{'shr, r, t} }
    | "[" t:vasm_type "]" { Arr{t} }
    | s:vasm_name { Named{s} }

# a floating point literal 1.5, -0.25 or 1.0e-3: FImm{at, its text}
vasm_operand ::= at:vasm_here x:float { FImm{at, x} }
    | at:vasm_here n:vasm_int_lit { Imm{at, n} }
    | at:vasm_here s:string { Str{at, s} }
    | at:vasm_here "'" s:ident { Sym{at, s} }
    | at:vasm_here 'true { Imm{at, true} }
    | at:vasm_here 'false { Imm{at, false} }
    | at:vasm_here x:vasm_name { Reg{at, x} }

vasm_binop ::= "+" { 'add } | "-" { 'sub } | "*" { 'mul } | "/" { 'div } | "%" { 'rem }
    | "<<" { 'shl } | ">>" { 'shr } | "&" { 'bit_and } | "|" { 'bit_or } | "^" { 'bit_xor }
    | "==" { 'eq } | "!=" { 'ne } | "<=" { 'le } | ">=" { 'ge } | "<" { 'lt } | ">" { 'gt }

# an argument is a value, or a place *p, p[i] or p.f, which only swap takes
vasm_arg ::= at:vasm_here "*" p:vasm_name { Load{at, p} }
    | at:vasm_here a:vasm_name "[" i:vasm_operand "]" { Index{at, a, i} }
    | at:vasm_here a:vasm_name "." f:vasm_name { Get{at, a, f} }
    | vasm_operand
vasm_more_arg ::= "," a:vasm_arg { a }
vasm_args ::= a:vasm_arg r:vasm_more_arg* { a :: vasm_tlist(r) }

# fields of a struct or of a struct value are separated by "," or a new line
vasm_fsep ::= "," | vasm_newline
vasm_init ::= at:vasm_here f:vasm_name ":" a:vasm_operand { Init{at, f, a} }
vasm_more_init ::= vasm_fsep i:vasm_init { i }
vasm_inits ::= i:vasm_init r:vasm_more_init* { i :: vasm_tlist(r) }

vasm_rhs ::= at:vasm_here "&" 'mut r:vasm_name y:vasm_name { Borrow{at, 'mut, r, y} }
    | at:vasm_here "&" r:vasm_name y:vasm_name { Borrow{at, 'shr, r, y} }
    | at:vasm_here "*" p:vasm_name { Load{at, p} }
    | at:vasm_here 'val h:ident "(" args:vasm_args? ")" { Con{at, h, vasm_opt_list(args)} }
    | at:vasm_here 'fn f:vasm_name "(" args:vasm_args? ")" { Clo{at, f, vasm_opt_list(args)} }
    | at:vasm_here f:vasm_name "(" args:vasm_args? ")" { Call{at, f, vasm_opt_list(args)} }
    | at:vasm_here s:vasm_name "{" is:vasm_inits? ","? "}" { Make{at, s, vasm_opt_list(is)} }
    | at:vasm_here a:vasm_name "[" i:vasm_operand "]" { Index{at, a, i} }
    | at:vasm_here a:vasm_name "." f:vasm_name { Get{at, a, f} }
    | at:vasm_here a:vasm_operand vasm_same 'as t:vasm_type { Conv{at, a, t} }
    | a:vasm_operand vasm_same op:vasm_binop b:vasm_operand { Bin{op, a, b} }
    | a:vasm_operand { Mov{a} }

vasm_cond ::= a:vasm_operand op:vasm_binop b:vasm_operand { Bin{op, a, b} } | a:vasm_operand { Mov{a} }

vasm_stmt ::= at:vasm_here 'var x:vasm_name ":" t:vasm_type { Decl{at, x, t} }
    | at:vasm_here 'if "(" c:vasm_cond ")" a:vasm_block 'else b:vasm_block { IfS{at, c, a, b} }
    | at:vasm_here 'if "(" c:vasm_cond ")" a:vasm_block { IfS{at, c, a, []} }
    | at:vasm_here 'while "(" c:vasm_cond ")" a:vasm_block { WhileS{at, c, a} }
    | at:vasm_here 'region r:vasm_name a:vasm_block { RegionS{at, r, a} }
    | at:vasm_here 'return vasm_same a:vasm_operand { Ret{at, a} }
    | at:vasm_here 'return { Ret{at, none} }
    | at:vasm_here "*" p:vasm_name "=" a:vasm_operand { Store{at, p, a} }
    | at:vasm_here p:vasm_name "[" i:vasm_operand "]" "=" a:vasm_operand { IStore{at, p, i, a} }
    | at:vasm_here p:vasm_name "." f:vasm_name "=" a:vasm_operand { FStore{at, p, f, a} }
    | at:vasm_here x:vasm_name "=" r:vasm_rhs { Assign{at, x, r} }
    | at:vasm_here f:vasm_name "(" args:vasm_args? ")" { CallS{at, f, vasm_opt_list(args)} }

vasm_sep ::= ";" | vasm_newline
vasm_more_stmt ::= vasm_sep s:vasm_stmt { s }
vasm_stmts ::= s:vasm_stmt r:vasm_more_stmt* { s :: vasm_tlist(r) }
vasm_block ::= "{" ss:vasm_stmts? ";"? "}" { vasm_opt_list(ss) }

vasm_param ::= at:vasm_here x:vasm_name ":" t:vasm_type { Param{at, x, t} }
vasm_more_param ::= "," p:vasm_param { p }
vasm_params ::= p:vasm_param r:vasm_more_param* { p :: vasm_tlist(r) }
vasm_more_name ::= "," x:vasm_name { x }
vasm_rparams ::= "[" x:vasm_name r:vasm_more_name* "]" { x :: vasm_tlist(r) }
vasm_ret ::= "->" t:vasm_type { t }
vasm_fn ::= at:vasm_here 'fn f:vasm_name rs:vasm_rparams? "(" ps:vasm_params? ")" rt:vasm_ret? body:vasm_block { Fn{at, f, vasm_opt_list(rs), vasm_opt_list(ps), if (arity(rt) == 0) Unit{} else arg(rt, 0), body} }

vasm_field ::= at:vasm_here x:vasm_name ":" t:vasm_type { Field{at, x, t} }
vasm_more_field ::= vasm_fsep f:vasm_field { f }
vasm_fields ::= f:vasm_field r:vasm_more_field* { f :: vasm_tlist(r) }
vasm_struct ::= at:vasm_here 'struct s:vasm_name "{" fs:vasm_fields? ","? "}" { Struct{at, s, vasm_opt_list(fs)} }

vasm_item ::= vasm_struct | vasm_fn
vasm ::= fs:vasm_item* { Module{vasm_tlist(fs)} }

module vasm_check {

# === Types ===

# the integer types: Tuple{type, name, bits, signed}
export ints := [
    Tuple{I8{}, "i8", 8, true}, Tuple{I16{}, "i16", 16, true},
    Tuple{I32{}, "i32", 32, true}, Tuple{I64{}, "i64", 64, true},
    Tuple{U8{}, "u8", 8, false}, Tuple{U16{}, "u16", 16, false},
    Tuple{U32{}, "u32", 32, false}, Tuple{U64{}, "u64", 64, false}]
export int_entry(t) := find(e -> arg(e, 0) == t, ints)
export int(t) := int_entry(t) != none

# the floating point types
export flt(t) := t == F32{} or t == F64{}

# A literal is from -32768 to 32767. A type of 16 bits or more holds all of them but the negative ones
# for an unsigned type, so these are the bounds of a literal of the type e of ints.
lit_lo(e) := if (not arg(e, 3)) 0 else if (arg(e, 2) == 8) -128 else -32768
lit_hi(e) := if (arg(e, 2) != 8) 32767 else if (arg(e, 3)) 127 else 255

export show_type(Bool{}) := "bool"
show_type(F32{}) := "f32"
show_type(F64{}) := "f64"
show_type(FLit{}) := "float"
show_type(Val{}) := "val"
show_type(Unit{}) := "()"
show_type(Lit{_}) := "integer"
show_type(Own{u}) := _strcat("own ", show_type(u))
show_type(Ref{k, r, u}) := _strcat(if (k == 'mut) f"&mut {symname(r)} " else f"&{symname(r)} ", show_type(u))
show_type(Arr{u}) := f"[{show_type(u)}]"
show_type(Named{s}) := symname(s)
show_type(TVar{n}) := symname(n)
show_type(Place{u}) := _strcat("a place of ", show_type(u))
show_type(t) := arg(int_entry(t), 1)

# === Checker state ===
# vasm_info: name -> Info{type, regions open at the declaration}, for the variables in scope
# a state: name -> Vs{status, loans}, and ".dead" -> true after return
#   status: 'init, 'uninit, Moved{at}, Freed{at}, Taken{at} (an own value whose contents are moved out by x = *p)
#   or Parts{fields} (a struct value whose fields that own are moved out by x = s.f); loans: [Loan{region, kind}, ...]
# regions: the regions in scope, the innermost first, ending with the regions of the function

sigs := table.new()
structs := table.new()
vasm_info := table.new()
regions := []
fn_regions := []
ret_type := Unit{}

# t owns a value: t is own or val, or a struct with a field that owns, or an array of them.
# A val in a register is copied (linear); a val in a struct, in a box or in an array of own is what own is there.
fun owning_in
owning(t) := owning_in(t, [])
owning_in(Own{_}, seen) := true
owning_in(Val{}, seen) := true
owning_in(Arr{u}, seen) := owning_in(u, seen)
owning_in(Named{s}, seen) := {
    sd := table.get(structs, s, none)
    if (sd == none or member(s, seen)) false
    else list.any((Field{_, _, u}) -> owning_in(u, s :: seen), arg(sd, 2))
}
owning_in(_, seen) := false

# the fields of the struct s that own, in the order of the struct
own_fields(s) := map((Field{_, x, _}) -> x, filter((Field{_, _, u}) -> owning(u), arg(table.get(structs, s, none), 2)))

# An integer literal is Lit{n} until it meets an integer type; Lit{none} is the result of an operation on literals.
# Integers, bool and structs without own are copied. own and a struct with own are linear: they are moved
# by a use and must be moved or freed once. &mut is moved by a use, except for an argument of a call
# (call). & is copied.
linear(t) := head(t) == 'Own or (head(t) == 'Named and owning(t))
moves(t) := linear(t) or (head(t) == 'Ref and arg(t, 0) == 'mut)

# the built-in functions, given as types with the type variable T.
# free also marks its argument as freed (call). The contents of own are checked by type_ok.
# swap(x, v) puts v in the place x (*p, p[i] or p.f) and gives the value that was there.
export builtins := table.new()
table.set(builtins, 'box, Sig{[], [TVar{'T}], Own{TVar{'T}}})
table.set(builtins, 'free, Sig{[], [Own{TVar{'T}}], Unit{}})
table.set(builtins, 'alloc, Sig{[], [I64{}, TVar{'T}], Own{Arr{TVar{'T}}}})
table.set(builtins, 'len, Sig{['r], [Ref{'shr, 'r, Arr{TVar{'T}}}], I64{}})
# mulhi(a, b) is the upper 64 bits of the product of the unsigned 64-bit integers a and b
table.set(builtins, 'mulhi, Sig{[], [U64{}, U64{}], U64{}})
# Reads and writes of a number at a byte position of a byte array. ld_u16, ld_s16, ld_u32 and ld_s32 read 2 or 4 bytes at the position off
# (little-endian) and extend them to i64 by zero or by sign; ld_64 reads 8 bytes. st_16, st_32 and st_64 write the lower 2, 4 or 8 bytes of v.
# The position need not be a multiple of the width. A position with off < 0 or off + width > len(a) stops the program.
table.set(builtins, 'ld_u16, Sig{['r], [Ref{'shr, 'r, Arr{U8{}}}, I64{}], I64{}})
table.set(builtins, 'ld_s16, Sig{['r], [Ref{'shr, 'r, Arr{U8{}}}, I64{}], I64{}})
table.set(builtins, 'ld_u32, Sig{['r], [Ref{'shr, 'r, Arr{U8{}}}, I64{}], I64{}})
table.set(builtins, 'ld_s32, Sig{['r], [Ref{'shr, 'r, Arr{U8{}}}, I64{}], I64{}})
table.set(builtins, 'ld_64, Sig{['r], [Ref{'shr, 'r, Arr{U8{}}}, I64{}], I64{}})
table.set(builtins, 'st_16, Sig{['r], [Ref{'mut, 'r, Arr{U8{}}}, I64{}, I64{}], Unit{}})
table.set(builtins, 'st_32, Sig{['r], [Ref{'mut, 'r, Arr{U8{}}}, I64{}, I64{}], Unit{}})
table.set(builtins, 'st_64, Sig{['r], [Ref{'mut, 'r, Arr{U8{}}}, I64{}, I64{}], Unit{}})
table.set(builtins, 'swap, Sig{[], [Place{TVar{'T}}, TVar{'T}], TVar{'T}})

# Floating point. f64_sqrt(x) and f32_sqrt(x) are the square roots. The bits of a number are read and made again by f64_bits, f64_from_bits,
# f32_bits and f32_from_bits, which give the number its bits as an unsigned integer of the same width and back.
table.set(builtins, 'f64_sqrt, Sig{[], [F64{}], F64{}})
table.set(builtins, 'f32_sqrt, Sig{[], [F32{}], F32{}})
table.set(builtins, 'f64_bits, Sig{[], [F64{}], U64{}})
table.set(builtins, 'f64_from_bits, Sig{[], [U64{}], F64{}})
table.set(builtins, 'f32_bits, Sig{[], [F32{}], U32{}})
table.set(builtins, 'f32_from_bits, Sig{[], [U32{}], F32{}})

fail(at, kind, msg) := perform VasmFail{at, kind, msg}

dead(st) := table.get(st, ".dead", false)
status(st, x) := arg(table.get(st, x, none), 0)
loans(st, x) := arg(table.get(st, x, none), 1)
set_status(st, x, s) := table.set(st, x, Vs{s, loans(st, x)})
set_loans(st, x, l) := table.set(st, x, Vs{status(st, x), l})

copy_state(st) := {
    s := table.new()
    each(kv -> table.set(s, arg(kv, 0), arg(kv, 1)), table.items(st))
    s
}

# the variables of a state, without the removed ones
vars(st) := filter(x -> type(x) == Symbol and table.get(st, x, none) != none, table.keys(st))

lookup(at, x) := {
    i := table.get(vasm_info, x, none)
    if (i == none) fail(at, 'undefined, f"{symname(x)} is not declared")
    i
}
type_of(at, x) := arg(lookup(at, x), 0)

need_init(at, st, x) := match status(st, x) {
    'init -> none
  | 'uninit -> fail(at, 'uninit, f"{symname(x)} is read before it is initialized")
  | Moved{_} -> fail(at, 'moved, f"{symname(x)} is used after it is moved")
  | Freed{_} -> fail(at, 'freed, f"{symname(x)} is used after it is freed")
  | Taken{_} -> fail(at, 'moved, f"the contents of {symname(x)} are moved out; write *{symname(x)} or free {symname(x)}")
  | Parts{fs} -> fail(at, 'moved, f"{symname(x)}.{symname(fs[0])} is moved out")
}

# the fields moved out of the struct value x
moved_fields(st, x) := match status(st, x) {
    Parts{fs} -> fs
  | _ -> []
}

# the field f of the struct value x is read or written: x is initialized and f is not moved out
need_field(at, st, x, f) := match status(st, x) {
    Parts{fs} -> if (member(f, fs)) fail(at, 'moved, f"{symname(x)}.{symname(f)} is used after it is moved")
  | _ -> need_init(at, st, x)
}

# x of type t still owns a value with the status s: something in it is not moved out or freed
owns(t, s) := if (not linear(t)) false else match s {
    'init -> true
  | Taken{_} -> true
  | Parts{fs} -> list.any(f -> not member(f, fs), own_fields(arg(t, 0)))
  | _ -> false
}

# the status s of x of type t as far as the checks of if and while see it: what x still owns, or initialized or not
key(t, s) := if (not linear(t)) s == 'init else if (not owns(t, s)) 'none else match s {
    Taken{_} -> 'taken
  | Parts{fs} -> Parts{fs}
  | _ -> 'init
}

no_loans(at, st, x, what) := if (loans(st, x) != []) fail(at, 'borrowed, f"{symname(x)} is borrowed and cannot be {what}")
no_mut_loan(at, st, x, what) := if (list.any(l -> arg(l, 1) == 'mut, loans(st, x))) fail(at, 'borrowed, f"{symname(x)} is borrowed as mut and cannot be {what}")

# the contents of own and of a borrow: an integer, bool, a struct or own, or an array of them
fun type_ok
contents_ok(at, t, u) := {
    e := if (head(u) == 'Arr) arg(u, 0) else u
    if (head(e) == 'Ref) fail(at, 'type, f"{show_type(t)}: the contents do not borrow")
    type_ok(at, e)
}

type_ok(at, t) := match t {
    Own{u} -> contents_ok(at, t, u)
  | Ref{_, r, u} -> {
        if (r != 'static and not member(r, regions)) fail(at, 'region, f"region {symname(r)} is not in scope")
        contents_ok(at, t, u)
    }
  | Arr{_} -> fail(at, 'type, f"{show_type(t)}: an array is held by own or a borrow")
  | Named{s} -> if (table.get(structs, s, none) == none) fail(at, 'undefined, f"struct {symname(s)} is not defined")
  | _ -> none
}

declare(at, st, x, t, init) := {
    if (table.get(vasm_info, x, none) != none) fail(at, 'type, f"{symname(x)} is already declared")
    type_ok(at, t)
    table.set(vasm_info, x, Info{t, regions})
    table.set(st, x, Vs{if (init) 'init else 'uninit, []})
}

# === Regions, integers and the types of values ===

# q outlives r: q is r, or q is static (the region of the string literals, which lasts to the end of the program),
# or r is a region opened in the function and q was opened before it. The regions of the function are not ordered.
outlives(q, r) := q == r or q == 'static or (r != 'static and not member(r, fn_regions) and list.index_of(q, regions) > list.index_of(r, regions))

lit_range(at, n, t) := if (n != none) {
    e := int_entry(t)
    if (n < lit_lo(e) or n > lit_hi(e)) fail(at, 'type, f"{n} is out of the range of {arg(e, 1)}")
}

# a value of type t can be put where e is expected: an integer literal in the range of e,
# or a borrow of a region that outlives the region of e
fits(at, e, t) := if (head(t) == 'Lit and int(e)) {
    lit_range(at, arg(t, 0), e)
    true
} else if (t == FLit{} and flt(e)) true
else if (head(e) == 'Own and head(t) == 'Own) fits(at, arg(e, 0), arg(t, 0))
else if (head(e) == 'Arr and head(t) == 'Arr) fits(at, arg(e, 0), arg(t, 0))
else if (head(e) == 'Ref and head(t) == 'Ref) arg(e, 0) == arg(t, 0) and outlives(arg(t, 1), arg(e, 1)) and fits(at, arg(e, 2), arg(t, 2))
else e == t

# a borrow that does not fit only because its region is opened inside the function and does not outlive the expected one
escapes(e, t) := head(e) == 'Ref and head(t) == 'Ref and arg(e, 0) == arg(t, 0) and arg(e, 2) == arg(t, 2) and not member(arg(t, 1), fn_regions)

export mentions(Ref{_, q, u}, r) := q == r or mentions(u, r)
mentions(Own{u}, r) := mentions(u, r)
mentions(Arr{u}, r) := mentions(u, r)
mentions(_, r) := false

export subst(t, rmap, tsub) := match t {
    Ref{k, r, u} -> Ref{k, table.get(rmap, r, r), subst(u, rmap, tsub)}
  | Own{u} -> Own{subst(u, rmap, tsub)}
  | Arr{u} -> Arr{subst(u, rmap, tsub)}
  | TVar{n} -> table.get(tsub, n, t)
  | _ -> t
}

# === Operands and values ===

export pos(Bin{_, a, _}) := arg(a, 0)
pos(Mov{a}) := arg(a, 0)
pos(o) := arg(o, 0)

# the type of the operand o, which is read. own and &mut are moved.
vasm_use(st, Imm{at, n}) := if (type(n) == Int) Lit{n} else if (n == true or n == false) Bool{}
    else fail(at, 'type, f"{arg(n, 0)} is out of the range of a literal, -32768 to 32767; make it with << and |")
vasm_use(st, FImm{_, _}) := FLit{}
vasm_use(st, Str{_, _}) := Ref{'shr, 'static, Arr{U8{}}}
vasm_use(st, Sym{_, _}) := Val{}
vasm_use(st, Reg{at, x}) := {
    t := type_of(at, x)
    need_init(at, st, x)
    if (moves(t)) {
        no_loans(at, st, x, "moved")
        set_status(st, x, Moved{at})
    }
    t
}

# the type of the contents of the pointer p, to read (write is false) or write
ptr(at, st, p, write) := {
    t := type_of(at, p)
    need_init(at, st, p)
    match t {
        Own{u} -> {
            if (write) no_loans(at, st, p, "written") else no_mut_loan(at, st, p, "read")
            u
        }
      | Ref{k, _, u} -> {
            if (write and k != 'mut) fail(at, 'borrowed, f"{symname(p)} is a shared borrow and cannot be written")
            u
        }
      | _ -> fail(at, 'type, f"{symname(p)} is {show_type(t)}, not a pointer")
    }
}

# the contents of p, which must not be an array (a whole array is not read or written at once)
cell(at, st, p, write) := {
    u := ptr(at, st, p, write)
    if (head(u) == 'Arr) fail(at, 'type, f"{symname(p)} points to an array; use an element {symname(p)}[i]")
    u
}

# the element type of the array p at the index operand i. The range of i is checked when the program runs.
# For a val p the kind of the value is checked when the program runs too.
elem(at, st, p, i, write) := {
    isval := type_of(at, p) == Val{}
    if (isval) need_init(at, st, p)
    u := if (isval) Arr{Val{}} else ptr(at, st, p, write)
    if (head(u) != 'Arr) fail(at, 'type, f"{symname(p)} points to {show_type(u)}, not an array")
    ti := vasm_use(st, i)
    if (not fits(arg(i, 0), I64{}, ti)) fail(arg(i, 0), 'type, f"the index is {show_type(ti)}, not i64")
    arg(u, 0)
}

# the type of the field f of the struct s
field_type(at, s, f) := {
    fd := find((Field{_, x, _}) -> x == f, arg(table.get(structs, s, none), 2))
    if (fd == none) fail(at, 'type, f"struct {symname(s)} has no field {symname(f)}")
    arg(fd, 2)
}

# the struct of a register p of a struct type, or of the contents of a pointer p
struct_of(at, st, p, write) := {
    t := type_of(at, p)
    u := if (head(t) == 'Named) {
        need_init(at, st, p)
        t
    } else if (head(t) == 'Own or head(t) == 'Ref) ptr(at, st, p, write) else t
    if (head(u) != 'Named) fail(at, 'type, f"{symname(p)} is {show_type(t)}, not a struct or a pointer to a struct")
    arg(u, 0)
}

# x = *p. Contents that own are moved out of an own p, which is then Taken until *p is written or p is freed.
# They are not moved out of a borrow.
vasm_load(at, st, p) := {
    u := cell(at, st, p, false)
    if (owning(u)) {
        if (head(type_of(at, p)) != 'Own) fail(at, 'owner, f"the contents of {symname(p)} own a value and are not moved out of a borrow; use swap(*{symname(p)}, v)")
        no_loans(at, st, p, "moved out of")
        set_status(st, p, Taken{at})
    }
    u
}

# x = p.f. A field that owns is moved out of a struct value p, and not copied out of a pointer p.
get(at, st, p, f) := {
    t := type_of(at, p)
    if (head(t) == 'Named) {
        u := field_type(at, arg(t, 0), f)
        need_field(at, st, p, f)
        if (owning(u)) {
            fs := f :: moved_fields(st, p)
            set_status(st, p, Parts{filter(x -> member(x, fs), own_fields(arg(t, 0)))})
        }
        u
    } else {
        u := field_type(at, struct_of(at, st, p, false), f)
        if (owning(u)) fail(at, 'owner, f"field {symname(f)} owns a value and is not copied out of {symname(p)}; use swap({symname(p)}.{symname(f)}, v)")
        u
    }
}

# the type of the place a (*p, p[i] or p.f) of swap, which is read and written
place(st, Load{at, p}) := cell(at, st, p, true)
place(st, Index{at, p, i}) := {
    if (type_of(at, p) == Val{}) fail(at, 'type, f"{symname(p)} is val; write {symname(p)}[i] = v")
    elem(at, st, p, i, true)
}
place(st, Get{at, p, f}) := {
    t := type_of(at, p)
    if (head(t) == 'Named) {
        need_field(at, st, p, f)
        field_type(at, arg(t, 0), f)
    } else field_type(at, struct_of(at, st, p, true), f)
}
place(st, a) := fail(arg(a, 0), 'type, "the first argument of swap is a place: *p, p[i] or p.f")
is_place(a) := member(head(a), ['Load, 'Index, 'Get])

# a parameter type pt of a function matches an argument type t.
# rs are the regions of the function; rsub gets the regions given to each, tsub the type of T.
# &mut is given to &.
vasm_match(at, pt, t, rs, rsub, tsub) := if (head(pt) == 'Place) vasm_match(at, arg(pt, 0), t, rs, rsub, tsub)
else if (head(pt) == 'TVar) {
    b := table.get(tsub, arg(pt, 0), none)
    if (b == none or (head(b) == 'Lit and int(t))) {
        table.set(tsub, arg(pt, 0), t)
        true
    } else fits(at, b, t)
} else if (head(pt) == 'Ref and head(t) == 'Ref) {
    r := arg(pt, 1)
    if (arg(pt, 0) != arg(t, 0) and not (arg(pt, 0) == 'shr and arg(t, 0) == 'mut)) false
    else if (not vasm_match(at, arg(pt, 2), arg(t, 2), rs, rsub, tsub)) false
    else if (member(r, rs)) {
        table.set(rsub, r, arg(t, 1) :: table.get(rsub, r, []))
        true
    } else outlives(arg(t, 1), r)
} else if (head(pt) == 'Own and head(t) == 'Own) vasm_match(at, arg(pt, 0), arg(t, 0), rs, rsub, tsub)
else if (head(pt) == 'Arr and head(t) == 'Arr) vasm_match(at, arg(pt, 0), arg(t, 0), rs, rsub, tsub)
else fits(at, pt, t)

# the region given to r: the innermost of the regions qs of the arguments, which all outlive it
pick_region(at, f, r, qs) := {
    inner := filter(q -> list.all(q2 -> outlives(q2, q), qs), qs)
    names := join(", ", map(q -> symname(q), reverse(qs)))
    if (inner == []) fail(at, 'type, f"{symname(f)} is given borrows of regions {names} for region {symname(r)}, and none of them is inside the others")
    arg(inner, 0)
}

# An &mut register given to a borrow parameter is borrowed again for the call and is not moved,
# unless the result has the region of the parameter. It is given once in the call.
mut_reg(a) := if (head(a) == 'Reg) {
    t := type_of(arg(a, 0), arg(a, 1))
    head(t) == 'Ref and arg(t, 0) == 'mut
} else false
reborrows(p, a, ret) := head(p) == 'Ref and not mentions(ret, arg(p, 1)) and mut_reg(a)

val_operand(st, a) := {
    if (is_place(a)) fail(arg(a, 0), 'type, "the value of a val is a register or a literal, not a place")
    t := vasm_use(st, a)
    if (t != Val{}) fail(arg(a, 0), 'type, f"the value is {show_type(t)}, not val")
}

# v(a, ...) for a register v of val: the arguments and the result are val. That v is a function that takes as many arguments is checked when the program runs.
is_val_reg(f) := {
    i := table.get(vasm_info, f, none)
    i != none and arg(i, 0) == Val{}
}

# x = fn f(a, ...): the arguments are the first arguments of f, and all that f takes and gives is val
closure(at, st, f, args) := {
    sig := table.get(sigs, f, none)
    if (sig == none) fail(at, 'undefined, f"function {symname(f)} is not defined")
    if (arg(sig, 0) != [] or arg(sig, 2) != Val{} or list.any(p -> p != Val{}, arg(sig, 1))) fail(at, 'type, f"{symname(f)} is made a value of val, so all that it takes and gives is val")
    if (length(args) > length(arg(sig, 1))) fail(at, 'type, f"{symname(f)} takes {length(arg(sig, 1))} arguments but {length(args)} are given")
    each(a -> val_operand(st, a), args)
    Val{}
}

fun call_named
call(at, st, f, args) := if (is_val_reg(f)) {
    need_init(at, st, f)
    each(a -> val_operand(st, a), args)
    Val{}
} else call_named(at, st, f, args)

call_named(at, st, f, args) = {
    user := table.get(sigs, f, none)
    sig := if (user == none) table.get(builtins, f, none) else user
    if (sig == none) fail(at, 'undefined, f"function {symname(f)} is not defined")
    rs := arg(sig, 0)
    ps := arg(sig, 1)
    ret := arg(sig, 2)
    if (length(ps) != length(args)) fail(at, 'type, f"{symname(f)} takes {length(ps)} arguments but {length(args)} are given")
    freeing := user == none and f == 'free
    if (freeing) each(a -> if (head(a) == 'Reg) {
        x := arg(a, 1)
        match status(st, x) {
            Freed{_} -> fail(at, 'freed, f"{symname(x)} is freed twice")
          | Taken{_} -> set_status(st, x, 'init)
          | _ -> none
        }
        no_loans(at, st, x, "freed")
    }, args)
    rsub := table.new()
    tsub := table.new()
    lent := []
    each(pa -> {
        p := arg(pa, 0)
        a := arg(pa, 1)
        if (head(a) == 'Reg and member(arg(a, 1), lent)) fail(arg(a, 0), 'borrowed, f"{symname(arg(a, 1))} is borrowed as mut by another argument of the call")
        t := if (head(p) == 'Place) place(st, a)
        else if (is_place(a)) fail(arg(a, 0), 'type, f"{symname(f)} takes a value, not a place; read it into a register")
        else if (reborrows(p, a, ret)) {
            need_init(arg(a, 0), st, arg(a, 1))
            lent = arg(a, 1) :: lent
            type_of(arg(a, 0), arg(a, 1))
        } else vasm_use(st, a)
        if (not vasm_match(arg(a, 0), p, t, rs, rsub, tsub)) fail(arg(a, 0), 'type, f"the argument is {show_type(t)} but {symname(f)} takes {show_type(p)}")
    }, list.zip(ps, args))
    if (freeing) {
        # what is left in the value is freed with it
        set_status(st, arg(args[0], 1), Freed{at})
    }
    if (user == none and f == 'alloc and owning(table.get(tsub, 'T, I64{}))) fail(at, 'owner, "alloc copies its value to every element, so the value does not own")
    rmap := table.new()
    each(r -> {
        qs := table.get(rsub, r, [])
        if (qs != []) table.set(rmap, r, pick_region(at, f, r, qs))
    }, rs)
    t := subst(ret, rmap, tsub)
    if (user == none) type_ok(at, t)
    t
}

int_operand(o, t) := if (not (int(t) or head(t) == 'Lit)) fail(arg(o, 0), 'type, f"the operand is {show_type(t)}, not an integer")

# the type of the right-hand side r
rhs(st, r) := match r {
    Mov{o} -> vasm_use(st, o)
  | Bin{op, a, b} -> {
        ta := vasm_use(st, a)
        tb := vasm_use(st, b)
        if (head(ta) == 'Lit and int(tb)) {
            lit_range(arg(a, 0), arg(ta, 0), tb)
            ta = tb
        }
        if (head(tb) == 'Lit and int(ta)) {
            lit_range(arg(b, 0), arg(tb, 0), ta)
            tb = ta
        }
        if (ta == FLit{} and flt(tb)) ta = tb
        if (tb == FLit{} and flt(ta)) tb = ta
        if ((op == 'eq or op == 'ne) and ((ta == Bool{} and tb == Bool{}) or (ta == Val{} and tb == Val{}))) Bool{}
        else if (flt(ta) or flt(tb) or ta == FLit{} or tb == FLit{}) {
            if (ta != tb) fail(arg(b, 0), 'type, f"the operands are {show_type(ta)} and {show_type(tb)}")
            if (not member(op, ['add, 'sub, 'mul, 'div, 'lt, 'le, 'gt, 'ge, 'eq, 'ne])) fail(arg(a, 0), 'type, f"the operator is not for {show_type(ta)}; a floating point number has + - * / and the comparisons")
            if (member(op, ['lt, 'le, 'gt, 'ge, 'eq, 'ne])) Bool{} else ta
        } else {
            int_operand(a, ta)
            int_operand(b, tb)
            lits := head(ta) == 'Lit and head(tb) == 'Lit
            if (not lits and ta != tb) fail(arg(b, 0), 'type, f"the operands are {show_type(ta)} and {show_type(tb)}")
            if (member(op, ['lt, 'le, 'gt, 'ge, 'eq, 'ne])) Bool{} else if (lits) Lit{none} else ta
        }
    }
  | Load{at, p} -> vasm_load(at, st, p)
  | Index{at, p, i} -> {
        u := elem(at, st, p, i, false)
        if (owning(u) and type_of(at, p) != Val{}) fail(at, 'owner, f"the elements of {symname(p)} own values and are not copied; use swap({symname(p)}[i], v)")
        u
    }
  | Get{at, p, f} -> get(at, st, p, f)
  | Conv{at, a, t} -> {
        ta := vasm_use(st, a)
        if (t == Val{}) {
            if (not (int(ta) or head(ta) == 'Lit or ta == Bool{} or ta == Val{} or (head(ta) == 'Ref and arg(ta, 2) == Arr{U8{}}))) fail(at, 'type, f"{show_type(ta)} is not made a val")
        } else if (ta == Val{}) {
            if (not (int(t) or t == Bool{} or t == Own{Arr{U8{}}})) fail(at, 'type, f"a val is not converted to {show_type(t)}")
        } else {
            if (not (int(t) or flt(t))) fail(at, 'type, f"the value is converted to {show_type(t)}, not a number type")
            if (head(ta) == 'Lit and int(t)) lit_range(at, arg(ta, 0), t)
            else if (flt(ta) or ta == FLit{}) none
            else if (int(t)) int_operand(a, ta)
            else if (not (int(ta) or head(ta) == 'Lit)) fail(arg(a, 0), 'type, f"the operand is {show_type(ta)}, not a number")
        }
        t
    }
  | Con{at, _, args} -> {
        each(a -> val_operand(st, a), args)
        Val{}
    }
  | Clo{at, f, args} -> closure(at, st, f, args)
  | Make{at, s, inits} -> {
        sd := table.get(structs, s, none)
        if (sd == none) fail(at, 'undefined, f"struct {symname(s)} is not defined")
        given := []
        each((Init{iat, f, a}) -> {
            ft := field_type(iat, s, f)
            if (member(f, given)) fail(iat, 'type, f"field {symname(f)} is given twice")
            given = f :: given
            t := vasm_use(st, a)
            if (not fits(iat, ft, t)) fail(iat, 'type, f"field {symname(f)} of {symname(s)} is {show_type(ft)} but the value is {show_type(t)}")
        }, inits)
        each((Field{_, x, _}) -> if (not member(x, given)) fail(at, 'type, f"field {symname(x)} of {symname(s)} is not given"), arg(sd, 2))
        Named{s}
    }
  | Call{at, f, args} -> {
        t := call(at, st, f, args)
        if (t == Unit{}) fail(at, 'type, f"{symname(f)} returns no value")
        t
    }
  | Borrow{at, k, r, y} -> {
        info := lookup(at, y)
        yt := arg(info, 0)
        if (head(yt) != 'Own) fail(at, 'type, f"{symname(y)} is {show_type(yt)}; only an own value is borrowed")
        if (not member(r, regions)) fail(at, 'region, f"region {symname(r)} is not in scope")
        if (member(r, arg(info, 1))) fail(at, 'region, f"{symname(y)} is declared in region {symname(r)} and does not live to its end")
        need_init(at, st, y)
        if (k == 'mut) no_loans(at, st, y, "borrowed as mut") else no_mut_loan(at, st, y, "borrowed")
        set_loans(st, y, Loan{r, k} :: loans(st, y))
        Ref{k, r, arg(yt, 0)}
    }
}

cond(st, c) := {
    t := rhs(st, c)
    if (t != Bool{}) fail(pos(c), 'type, f"the condition is {show_type(t)}, not bool")
}

assign(at, st, x, t) := {
    info := lookup(at, x)
    dt := arg(info, 0)
    if (not fits(at, dt, t)) {
        if (escapes(dt, t)) fail(at, 'escape, f"a borrow of region {symname(arg(t, 1))} is put in {symname(x)}, which lives outside the region")
        fail(at, 'type, f"{symname(x)} is {show_type(dt)} but the value is {show_type(t)}")
    }
    no_loans(at, st, x, "assigned")
    # what x owned before is released here
    set_status(st, x, 'init)
}

# What an own value still owns at the end of its block or of the function is released there:
# the contents of a box, the fields of a struct and the elements of an array that are not moved out.
# So nothing is checked; the function is kept to mark the places where the release happens.
leak_all(at, st) := none

# the state after if: both branches must agree on own values
merge(at, a, b) := if (dead(a)) b else if (dead(b)) a else {
    m := table.new()
    each(x -> {
        t := arg(table.get(vasm_info, x, none), 0)
        sa := status(a, x)
        sb := status(b, x)
        if (owns(t, sa) != owns(t, sb)) fail(at, 'branch, f"{symname(x)} is owned after one branch and not after the other")
        if (linear(t) and key(t, sa) != key(t, sb)) fail(at, 'branch, f"{symname(x)} has different parts moved out after the two branches")
        s := if (sb == 'init) sa else sb
        la := loans(a, x)
        table.set(m, x, Vs{s, append(la, filter(l -> not member(l, la), loans(b, x)))})
    }, vars(a))
    m
}

replace(st, m) := {
    each(x -> table.set(st, x, table.get(m, x, none)), vars(st))
    table.set(st, ".dead", dead(m))
}

# a loop must give back the own and &mut values it moves
loop_same(at, a, b) := each(x -> {
    t := arg(table.get(vasm_info, x, none), 0)
    if (moves(t) and key(t, status(a, x)) != key(t, status(b, x))) fail(at, 'loop, f"{symname(x)} is moved or freed in the loop and not given a value again")
}, vars(a))

add_loans(st, b) := each(x -> {
    la := loans(st, x)
    set_loans(st, x, append(la, filter(l -> not member(l, la), loans(b, x))))
}, vars(st))

end_region(st, r) := each(x -> set_loans(st, x, filter(l -> arg(l, 0) != r, loans(st, x))), vars(st))

# check the statements of a block with the state st, which is updated
block(ss, st) := {
    declared := []
    for (s in ss) if (not dead(st)) match s {
        Decl{at, x, t} -> {
            declare(at, st, x, t, false)
            declared = Tuple{x, at} :: declared
        }
      | Assign{at, x, r} -> assign(at, st, x, rhs(st, r))
      | Store{at, p, a} -> {
            refill := match status(st, p) {
                Taken{_} -> true
              | _ -> false
            }
            u := if (refill) {
                set_status(st, p, 'init)
                cell(at, st, p, true)
            } else cell(at, st, p, true)
            t := vasm_use(st, a)
            if (not fits(at, u, t)) fail(at, 'type, f"{symname(p)} points to {show_type(u)} but the value is {show_type(t)}")
        }
      | IStore{at, p, i, a} -> {
            u := elem(at, st, p, i, true)
            t := vasm_use(st, a)
            if (not fits(at, u, t)) fail(at, 'type, f"the elements of {symname(p)} are {show_type(u)} but the value is {show_type(t)}")
        }
      | FStore{at, p, f, a} -> {
            pt := type_of(at, p)
            s := if (head(pt) == 'Named) arg(pt, 0) else struct_of(at, st, p, true)
            u := field_type(at, s, f)
            if (head(pt) == 'Named) {
                fs := moved_fields(st, p)
                if (member(f, fs)) {
                    rest := filter(x -> x != f, fs)
                    set_status(st, p, if (rest == []) 'init else Parts{rest})
                } else {
                    need_field(at, st, p, f)
                }
            }
            t := vasm_use(st, a)
            if (not fits(at, u, t)) fail(at, 'type, f"field {symname(f)} of {symname(s)} is {show_type(u)} but the value is {show_type(t)}")
        }
      | CallS{at, f, args} -> {
            # a result that owns a value and is not kept is released here
            call(at, st, f, args)
        }
      | IfS{at, c, a, b} -> {
            cond(st, c)
            sa := copy_state(st)
            block(a, sa)
            sb := copy_state(st)
            block(b, sb)
            replace(st, merge(at, sa, sb))
        }
      | WhileS{at, c, body} -> {
            cond(st, c)
            s1 := copy_state(st)
            block(body, s1)
            if (not dead(s1)) {
                loop_same(at, st, s1)
                s2 := copy_state(st)
                add_loans(s2, s1)
                cond(s2, c)
                block(body, s2)
                add_loans(st, s2)
            }
        }
      | RegionS{at, r, body} -> {
            if (member(r, regions)) fail(at, 'region, f"region {symname(r)} is already open")
            outer := regions
            regions = r :: outer
            block(body, st)
            regions = outer
            end_region(st, r)
        }
      | Ret{at, a} -> {
            t := if (a == none) Unit{} else vasm_use(st, a)
            if (not fits(at, ret_type, t)) {
                if (escapes(ret_type, t)) fail(at, 'escape, f"a borrow of region {symname(arg(t, 1))} is returned out of the region")
                fail(at, 'type, f"the result is {show_type(ret_type)} but the value is {show_type(t)}")
            }
            leak_all(at, st)
            table.set(st, ".dead", true)
        }
    }
    each((Tuple{x, at}) -> {
        table.set(vasm_info, x, none)
        table.set(st, x, none)
    }, declared)
}

# The services of the system are built-in functions too: they take values of vasm and no address, and are checked like any other call.
# write(fd, a) writes the bytes of the array a, which is only borrowed, to the file fd, and gives the number of bytes written, or
# a negative number for an error. exit(status) ends the program with the status (the low 8 bits are seen by the system).
table.set(builtins, 'write, Sig{['r], [I64{}, Ref{'shr, 'r, Arr{U8{}}}], I64{}})
table.set(builtins, 'exit, Sig{[], [I64{}], Unit{}})

# The ports to the files and the arguments of the program take and give values of vasm too.
# argc() is the number of the arguments of the program, and argv(i) is the i-th of them, an array of bytes without a terminator that
# is not released while the program runs (hence static); an i out of range ends the program as failed. argv(0) is the name of the program.
# open(path) opens the file whose name is the bytes of the array path for reading and gives the file, or a negative number for an error.
# read(fd, a) reads the bytes of the file fd into the array a, as many as it holds at most, and gives the number read (0 at the end of the file),
# or a negative number for an error. close(fd) closes the file.
table.set(builtins, 'argc, Sig{[], [], I64{}})
table.set(builtins, 'argv, Sig{[], [I64{}], Ref{'shr, 'static, Arr{U8{}}}})
table.set(builtins, 'open, Sig{['r], [Ref{'shr, 'r, Arr{U8{}}}], I64{}})
table.set(builtins, 'read, Sig{['r], [I64{}, Ref{'mut, 'r, Arr{U8{}}}], I64{}})
table.set(builtins, 'close, Sig{[], [I64{}], Unit{}})

# create(path) opens the file whose name is the bytes of the array path for writing, emptied or made new, and gives the file or a negative number.
table.set(builtins, 'create, Sig{['r], [Ref{'shr, 'r, Arr{U8{}}}], I64{}})

# The functions on values of val. A value that is not of the kind a function takes ends the program as failed, as an index out of range does.
# is(v, h, n): v is a constructed value with the head h and n arguments. typeof(v): the same symbol as typeof of planck.
# head(v): the head of a constructed value. arity(v): the number of the arguments, the elements or the bytes (a constructed value, an array, a string or symbol).
# array(n, v): a new array of n elements v. mexpr(h, a): a constructed value with the head h, and the elements of the array a as its arguments.
# intern(s): the symbol named by the string s. symname(s): the name of the symbol s as a string.
table.set(builtins, 'is, Sig{[], [Val{}, Val{}, I64{}], Bool{}})
table.set(builtins, 'typeof, Sig{[], [Val{}], Val{}})
table.set(builtins, 'head, Sig{[], [Val{}], Val{}})
table.set(builtins, 'arity, Sig{[], [Val{}], I64{}})
table.set(builtins, 'array, Sig{[], [I64{}, Val{}], Val{}})
table.set(builtins, 'mexpr, Sig{[], [Val{}, Val{}], Val{}})
table.set(builtins, 'intern, Sig{[], [Val{}], Val{}})
table.set(builtins, 'symname, Sig{[], [Val{}], Val{}})

check_fn(Fn{at, f, rs, ps, ret, body}) := {
    if (table.get(builtins, f, none) != none) fail(at, 'type, f"{symname(f)} is a built-in function")
    vasm_info = table.new()
    regions = rs
    fn_regions = rs
    ret_type = ret
    each(r -> {
        given := list.any(p -> head(arg(p, 2)) == 'Ref and arg(arg(p, 2), 1) == r, ps)
        if (not given) fail(at, 'region, f"region {symname(r)} is not given by a parameter")
    }, rs)
    type_ok(at, ret)
    st := table.new()
    each((Param{pat, x, t}) -> declare(pat, st, x, t, true), ps)
    block(body, st)
    if (not dead(st)) {
        if (ret != Unit{}) fail(at, 'type, f"{symname(f)} can end without returning {show_type(ret)}")
        leak_all(at, st)
    }
}

# the struct s has a field of the struct target, directly or in a field of a field
reaches(target, s, seen) := list.any((Field{_, _, t}) -> if (head(t) == 'Named) {
    n := arg(t, 0)
    sd := table.get(structs, n, none)
    n == target or (sd != none and not member(n, seen) and reaches(target, n, n :: seen))
} else false, arg(table.get(structs, s, none), 2))

# a field is an integer, bool, a struct or own, and does not borrow
check_struct(Struct{at, s, fs}) := {
    if (arg(table.get(structs, s, none), 0) != at) fail(at, 'type, f"struct {symname(s)} is already defined")
    regions = []
    fn_regions = []
    names := []
    each((Field{fat, x, t}) -> {
        if (member(x, names)) fail(fat, 'type, f"field {symname(x)} is declared twice")
        names = x :: names
        if (head(t) == 'Ref) fail(fat, 'type, f"field {symname(x)} is {show_type(t)}; a field does not borrow")
        type_ok(fat, t)
    }, fs)
    if (reaches(s, s, [s])) fail(at, 'type, f"struct {symname(s)} contains itself")
}

# check_with(m, imports) checks m, whose functions may call the functions and use the structs of imports, a list of
# structs and functions (the bodies of the functions are not read). Only the items of m are checked.
export check_with(m, imports) := {
    items := arg(m, 0)
    sigs = table.new()
    structs = table.new()
    each(d -> match d {
        Fn{_, f, rs, ps, ret, _} -> table.set(sigs, f, Sig{rs, map(p -> arg(p, 2), ps), ret})
      | Struct{_, s, _} -> if (table.get(structs, s, none) == none) table.set(structs, s, d)
    }, append(imports, items))
    errs := []
    each(d -> {
        r := handle {
            if (head(d) == 'Struct) check_struct(d) else check_fn(d)
            none
        } with (VasmFail{at, kind, msg}, k) -> VasmErr{kind, at, msg}
        if (r != none) errs = r :: errs
    }, items)
    reverse(errs)
}

# the errors of the module m: [VasmErr{kind, Pos{d}, msg}, ...], the first error of each struct and function
export check(m) := check_with(m, [])

# check with the positions in the file: [VasmErr{kind, Loc{file, line, column}, msg}, ...]
export errors(file, m) := {
    src := read_file(file)
    n := strlen(src)
    map((VasmErr{kind, Pos{d}, msg}) -> VasmErr{kind, error.loc_at(file, src, n - d), msg}, check(m))
}

# errors_with(file, m, imports) is errors for a module that may use the items of imports (see check_with)
export errors_with(file, m, imports) := {
    src := read_file(file)
    n := strlen(src)
    map((VasmErr{kind, Pos{d}, msg}) -> VasmErr{kind, error.loc_at(file, src, n - d), msg}, check_with(m, imports))
}

# print the errors as file:line:column: message, or "ok"
export report(file, m) := {
    es := errors(file, m)
    if (es == []) put("ok\n")
    each((VasmErr{_, loc, msg}) -> put(f"{error.show_loc(loc)}: {msg}\n"), es)
}

}
