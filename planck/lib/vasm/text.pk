# vasm/text: the source text of a module of vasm
# Copyright (C) 2026 nineties
#
# vasm_text.text(m) is the text of the module m = Module{[...]} in the syntax that vasm{| ... |} reads: one item after another, separated by
# a blank line, with a statement on each line and four spaces for each level of a block.

use("base")
use("list")
use("string")
use("vasm/check")

module vasm_text {
    escape(s) := {
        out := ""
        i := 0
        n := strlen(s)
        while (i < n) {
            c := ord(s, i)
            out = _strcat(out, if (c == 0) "\\0" else if (c == 10) "\\n" else if (c == 9) "\\t" else if (c == 34) "\\\"" else if (c == 92) "\\\\" else string.chr(c))
            i = i + 1
        }
        out
    }

    ops := [Tuple{'add, "+"}, Tuple{'sub, "-"}, Tuple{'mul, "*"}, Tuple{'div, "/"}, Tuple{'rem, "%"},
        Tuple{'shl, "<<"}, Tuple{'shr, ">>"}, Tuple{'bit_and, "&"}, Tuple{'bit_or, "|"}, Tuple{'bit_xor, "^"},
        Tuple{'eq, "=="}, Tuple{'ne, "!="}, Tuple{'le, "<="}, Tuple{'ge, ">="}, Tuple{'lt, "<"}, Tuple{'gt, ">"}]

    operand(Imm{_, n}) := if (n == true) "true" else if (n == false) "false" else if (type(n) == Int) f"{n}" else arg(n, 0)
    operand(FImm{_, x}) := x
    operand(Str{_, s}) := f"\"{escape(s)}\""
    operand(Sym{_, s}) := f"'{symname(s)}"
    operand(Reg{_, x}) := symname(x)
    operand(Load{_, p}) := f"*{symname(p)}"
    operand(Index{_, a, i}) := f"{symname(a)}[{operand(i)}]"
    operand(Get{_, a, f}) := f"{symname(a)}.{symname(f)}"

    args(as) := join(", ", map(operand, as))

    rhs(Mov{a}) := operand(a)
    rhs(Bin{op, a, b}) := f"{operand(a)} {arg(find(p -> arg(p, 0) == op, ops), 1)} {operand(b)}"
    rhs(Load{_, p}) := f"*{symname(p)}"
    rhs(Index{_, a, i}) := f"{symname(a)}[{operand(i)}]"
    rhs(Get{_, a, f}) := f"{symname(a)}.{symname(f)}"
    rhs(Conv{_, a, t}) := f"{operand(a)} as {vasm_check.show_type(t)}"
    rhs(Make{_, s, inits}) := f"{symname(s)}{{{join(", ", map((Init{_, f, a}) -> f"{symname(f)}: {operand(a)}", inits))}}}"
    rhs(Call{_, f, as}) := f"{symname(f)}({args(as)})"
    rhs(Con{_, h, as}) := f"val {symname(h)}({args(as)})"
    rhs(Clo{_, f, as}) := f"fn {symname(f)}({args(as)})"
    rhs(Borrow{_, k, rg, y}) := if (k == 'mut) f"&mut {symname(rg)} {symname(y)}" else f"&{symname(rg)} {symname(y)}"

    indent(n) := string.str_repeat("    ", n)

    fun block

    # the lines of the statement s at the depth n
    stmt(s, n) := {
        pad := indent(n)
        match s {
            Decl{_, x, t} -> [f"{pad}var {symname(x)}: {vasm_check.show_type(t)}"]
          | Assign{_, x, r} -> [f"{pad}{symname(x)} = {rhs(r)}"]
          | Store{_, p, a} -> [f"{pad}*{symname(p)} = {operand(a)}"]
          | IStore{_, p, i, a} -> [f"{pad}{symname(p)}[{operand(i)}] = {operand(a)}"]
          | FStore{_, p, f, a} -> [f"{pad}{symname(p)}.{symname(f)} = {operand(a)}"]
          | CallS{_, f, as} -> [f"{pad}{symname(f)}({args(as)})"]
          | IfS{_, c, a, b} -> if (b == []) append(append([f"{pad}if ({rhs(c)}) {{"], block(a, n + 1)), [f"{pad}}}"])
                else append(append(append([f"{pad}if ({rhs(c)}) {{"], block(a, n + 1)), [f"{pad}}} else {{"]), append(block(b, n + 1), [f"{pad}}}"]))
          | WhileS{_, c, body} -> append(append([f"{pad}while ({rhs(c)}) {{"], block(body, n + 1)), [f"{pad}}}"])
          | RegionS{_, r, body} -> append(append([f"{pad}region {symname(r)} {{"], block(body, n + 1)), [f"{pad}}}"])
          | Ret{_, a} -> [if (a == none) f"{pad}return" else f"{pad}return {operand(a)}"]
        }
    }

    block(ss, n) = concat_map(s -> stmt(s, n), ss)

    param(Param{_, x, t}) := f"{symname(x)}: {vasm_check.show_type(t)}"

    item(Fn{_, f, rs, ps, ret, body}) := {
        regions := if (rs == []) "" else f"[{join(", ", map(symname, rs))}]"
        result := if (ret == Unit{}) "" else f" -> {vasm_check.show_type(ret)}"
        join("\n", append(append([f"fn {symname(f)}{regions}({join(", ", map(param, ps))}){result} {{"], block(body, 1)), ["}"]))
    }
    item(Struct{_, s, fs}) := join("\n", append(append([f"struct {symname(s)} {{"], map((Field{_, x, t}) -> f"    {symname(x)}: {vasm_check.show_type(t)}", fs)), ["}"]))

    export text(Module{items}) := _strcat(join("\n\n", map(item, items)), "\n")
}
