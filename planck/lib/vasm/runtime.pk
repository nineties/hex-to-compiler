# vasm/runtime: the runtime that programs of vasm/ir.pk need: the start of the program, the allocator, the ports to the arguments and the files,
# and 64-bit arithmetic that is a call
# Copyright (C) 2026 nineties
#
# The runtime is made for a word w: the number of bytes of an address, 4 or 8 (the word of a target, backend/target.pk). An address is a register
# of the width of the word and takes a word in memory; a count or a kind is 32 bits.
# _start calls main and ends the program with its result as the exit status.
# __alloc(n) is the address of a block of n bytes (8-aligned) and __free(p) gives a block back. Blocks come from the program break
# (brk), each with a header of 8 bytes that holds the size, and a freed block of up to 4080 bytes goes to the list of its size and is used again.
# A larger block is not used again.
# The 64-bit operations that 32-bit registers cannot do with a few instructions (a shift by a count in a register, division and remainder)
# are functions of vasm that the lower of a target (backend/target.pk) may call; runtime.helpers names them and runtime.runtime holds them.

use("base")
use("list")
use("table")
use("vector")
use("bytes")
use("backend/ir")
use("vasm/check")

module runtime {
    # the width of a load or a store of an address, and the shift that multiplies by the word
    runtime_pw(w) := if (w == 8) 'w64 else 'w32
    shift(w) := if (w == 8) 3 else 2

    # the number of words that the arguments of a function take for a 64-bit value
    w64words(w) := 8 / w

    heap_data(w) := IRData{"__heap", ".bss", w, {
        b := bytes.new()
        bytes.zeros(b, 2 * w)
        b
    }, true}
    freelists_data(w) := IRData{"__freelists", ".bss", w, {
        b := bytes.new()
        bytes.zeros(b, 256 * w)
        b
    }, true}

    args_data(w) := IRData{"__args", ".bss", w, {
        b := bytes.new()
        bytes.zeros(b, w)
        b
    }, true}

    # A value of value is the address of a block: the number of its holders (negative for a block that is never released), the kind, and then
    #   integer: the 64-bit value
    #   string, symbol: the number of bytes, 0 and the bytes, which is the layout of an array of u8
    #   constructed value: the head (a symbol), the number of arguments n and n values
    #   array: the number of elements n, 0 and n values
    #   function: the address of the code, the number of values kept in it n, the number of the other arguments and n values
    # The holders and the kind are 4 bytes each, a count is 4 bytes, and the head, the address of the code and the values are a word each. The offsets of the fields
    # are rc, kind, int_at, array_n, array_elems, con_head, con_n(w), con_elems(w), fun_code, fun_n(w), fun_rest(w) and fun_elems(w) of the module,
    # and the kinds are kind_int, kind_string, kind_symbol, kind_con, kind_array and kind_fun. The module shows the ones that vasm/ir.pk uses.
    kind_int := 2
    export kind_string := 3
    export kind_symbol := 4
    export kind_con := 5
    kind_array := 6
    export kind_fun := 7

    export rc := 0
    export kind := 4
    int_at := 8
    array_n := 8
    array_elems := 16
    export con_head := 8
    export con_n(w) := 8 + w
    export con_elems(w) := 8 + 2 * w
    export fun_code := 8
    export fun_n(w) := 8 + w
    export fun_rest(w) := 12 + w
    export fun_elems(w) := 16 + w

    # the bytes of the block of the symbol with the name s
    export symbol_bytes(s) := {
        b := bytes.new()
        bytes.u32(b, -1)
        bytes.u32(b, kind_symbol)
        bytes.u32(b, strlen(s))
        bytes.u32(b, 0)
        bytes.string(b, s)
        b
    }

    # the symbols that the functions on values give
    names := [Tuple{"__sym_true", "true"}, Tuple{"__sym_false", "false"}, Tuple{"__sym_int", "int"}, Tuple{"__sym_string", "string"},
        Tuple{"__sym_symbol", "symbol"}, Tuple{"__sym_mexpr", "mexpr"}, Tuple{"__sym_array", "array"}, Tuple{"__sym_function", "function"}]

    export data(w) := append([heap_data(w), freelists_data(w), args_data(w)], map((Tuple{n, s}) -> IRData{n, ".rodata", 4, symbol_bytes(s), false}, names))

    # fun(name, w, ptrs, wides, specs) is a function from a list of instructions whose registers and labels are named by symbols.
    # The registers named in ptrs have the width of an address, those in wides are 64-bit, and the others are 32-bit.
    fn(name, w, ptrs, wides, specs) := {
        f := ir.fn(name)
        regs := table.new()
        labels := table.new()
        reg := s -> {
            r := table.get(regs, s, -1)
            if (r < 0) {
                r = ir.vreg(f, if (member(s, wides)) 64 else if (member(s, ptrs)) w * 8 else 32)
                table.set(regs, s, r)
            }
            r
        }
        label := s -> {
            l := table.get(labels, s, -1)
            if (l < 0) {
                l = ir.label(f)
                table.set(labels, s, l)
            }
            l
        }
        each(i -> ir.emit(f, ir.map_regs(reg, I{ir.op(i), map(o -> match o {
            L{s} -> L{label(s)}
          | _ -> o
        }, ir.ops(i))})), specs)
        f
    }

    # zx(w, d, s) is Tuple{instructions, register}: the value of the 32-bit register s in a register of the width of an address, which is d
    # (for a word of 4 bytes it is s itself and there is no instruction); tr is the low 32 bits of the register s of the width of an address
    zx(w, d, s) := if (w == 4) Tuple{[], s} else Tuple{[I{'zext64, [D{d}, U{s}]}], d}
    tr(w, d, s) := if (w == 4) Tuple{[], s} else Tuple{[I{'trunc, [D{d}, U{s}]}], d}

    export allocate_fun(w) := {
        pw := runtime_pw(w)
        cz := zx(w, 'cp, 'c4)
        tz := zx(w, 'tp, 't)
        fn("__alloc", w, ['fl, 'slot, 'head, 'nxt, 'hp, 'cur, 'z, 'b, 'a, 'en, 'nc, 'want, 'r, 'result, 'cp, 'tp], [], list.concat([[
            I{'getarg, [D{'n}, K{0}]},
            I{'add, [D{'t}, U{'n}, K{23}]},
            I{'band, [D{'t}, U{'t}, K{-16}]},
            I{'shr, [D{'c}, U{'t}, K{4}]},
            I{'br, [Cc{'geu}, U{'c}, K{256}, L{'bump}, L{'list}]},
            I{'label, [L{'list}]},
            I{'la, [D{'fl}, S{"__freelists", 0}]},
            I{'shl, [D{'c4}, U{'c}, K{shift(w)}]}], cz[0], [
            I{'add, [D{'slot}, U{'fl}, U{cz[1]}]},
            I{'ld, [W{pw}, D{'head}, M{U{'slot}, 0}]},
            I{'br, [Cc{'eq}, U{'head}, K{0}, L{'bump}, L{'pop}]},
            I{'label, [L{'pop}]},
            I{'ld, [W{pw}, D{'nxt}, M{U{'head}, 0}]},
            I{'st, [W{pw}, M{U{'slot}, 0}, U{'nxt}]},
            I{'ret, [Us{['head]}]},
            I{'label, [L{'bump}]},
            I{'la, [D{'hp}, S{"__heap", 0}]},
            I{'ld, [W{pw}, D{'cur}, M{U{'hp}, 0}]},
            I{'br, [Cc{'ne}, U{'cur}, K{0}, L{'have}, L{'init}]},
            I{'label, [L{'init}]},
            I{'li, [D{'z}, K{0}]},
            I{'os, [N{'grow}, Us{['z]}, D{'b}]},
            I{'add, [D{'a}, U{'b}, K{15}]},
            I{'band, [D{'cur}, U{'a}, K{-16}]},
            I{'st, [W{pw}, M{U{'hp}, w}, U{'b}]},
            I{'jmp, [L{'have}]},
            I{'label, [L{'have}]},
            I{'ld, [W{pw}, D{'en}, M{U{'hp}, w}]}], tz[0], [
            I{'add, [D{'nc}, U{'cur}, U{tz[1]}]},
            I{'br, [Cc{'leu}, U{'nc}, U{'en}, L{'ok}, L{'grow}]},
            I{'label, [L{'grow}]},
            I{'add, [D{'want}, U{'nc}, K{65536}]},
            I{'os, [N{'grow}, Us{['want]}, D{'r}]},
            I{'br, [Cc{'ne}, U{'r}, U{'want}, L{'bad}, L{'set}]},
            I{'label, [L{'bad}]},
            I{'trap, []},
            I{'label, [L{'set}]},
            I{'st, [W{pw}, M{U{'hp}, w}, U{'want}]},
            I{'jmp, [L{'ok}]},
            I{'label, [L{'ok}]},
            I{'st, [W{pw}, M{U{'hp}, 0}, U{'nc}]},
            I{'st, [W{'w32}, M{U{'cur}, 0}, U{'t}]},
            I{'st, [W{'w32}, M{U{'cur}, 4}, K{0}]},
            I{'add, [D{'result}, U{'cur}, K{8}]},
            I{'ret, [Us{['result]}]}]]))
    }

    export free_fun(w) := {
        pw := runtime_pw(w)
        cz := zx(w, 'cp, 'c4)
        fn("__free", w, ['p, 'h, 'fl, 'slot, 'head, 'cp], [], list.concat([[
            I{'getarg, [D{'p}, K{0}]},
            I{'br, [Cc{'eq}, U{'p}, K{0}, L{'out}, L{'go}]},
            I{'label, [L{'go}]},
            I{'sub, [D{'h}, U{'p}, K{8}]},
            I{'ld, [W{'w32}, D{'t}, M{U{'h}, 0}]},
            I{'shr, [D{'c}, U{'t}, K{4}]},
            I{'br, [Cc{'geu}, U{'c}, K{256}, L{'out}, L{'put}]},
            I{'label, [L{'put}]},
            I{'la, [D{'fl}, S{"__freelists", 0}]},
            I{'shl, [D{'c4}, U{'c}, K{shift(w)}]}], cz[0], [
            I{'add, [D{'slot}, U{'fl}, U{cz[1]}]},
            I{'ld, [W{pw}, D{'head}, M{U{'slot}, 0}]},
            I{'st, [W{pw}, M{U{'p}, 0}, U{'head}]},
            I{'st, [W{pw}, M{U{'slot}, 0}, U{'p}]},
            I{'label, [L{'out}]},
            I{'ret, [Us{[]}]}]]))
    }

    # __argv(i) is the address of a new array (the layout of vasm/ir.pk) that holds the bytes of the i-th argument of the program; it is not freed.
    # An i that is not less than the number of arguments is trap.
    argv_fun(w) := {
        pw := runtime_pw(w)
        iz := zx(w, 'ip, 'i)
        i4z := zx(w, 'i4p, 'i4)
        nt := tr(w, 'n32, 'n)
        fn("__argv", w, ['ap, 'base, 'argc, 'ip, 'i4p, 't, 'p, 'n, 'q, 'a, 'k, 's, 'd], [], list.concat([[
            I{'getarg, [D{'i}, K{0}]},
            I{'la, [D{'ap}, S{"__args", 0}]},
            I{'ld, [W{pw}, D{'base}, M{U{'ap}, 0}]},
            I{'ld, [W{pw}, D{'argc}, M{U{'base}, 0}]}], iz[0], [
            I{'br, [Cc{'ltu}, U{iz[1]}, U{'argc}, L{'ok}, L{'bad}]},
            I{'label, [L{'bad}]},
            I{'trap, []},
            I{'label, [L{'ok}]},
            I{'shl, [D{'i4}, U{'i}, K{shift(w)}]}], i4z[0], [
            I{'add, [D{'t}, U{'base}, U{i4z[1]}]},
            I{'ld, [W{pw}, D{'p}, M{U{'t}, w}]},
            I{'li, [D{'n}, K{0}]},
            I{'label, [L{'scan}]},
            I{'add, [D{'q}, U{'p}, U{'n}]},
            I{'ld, [W{'u8}, D{'c}, M{U{'q}, 0}]},
            I{'br, [Cc{'eq}, U{'c}, K{0}, L{'made}, L{'step}]},
            I{'label, [L{'step}]},
            I{'add, [D{'n}, U{'n}, K{1}]},
            I{'jmp, [L{'scan}]},
            I{'label, [L{'made}]}], nt[0], [
            I{'add, [D{'sz}, U{nt[1]}, K{8}]},
            I{'call, [S{"__alloc", 0}, Us{['sz]}, Ds{['a]}]},
            I{'st, [W{'w32}, M{U{'a}, 0}, U{nt[1]}]},
            I{'st, [W{'w32}, M{U{'a}, 4}, K{0}]},
            I{'li, [D{'k}, K{0}]},
            I{'label, [L{'copy}]},
            I{'br, [Cc{'ltu}, U{'k}, U{'n}, L{'put}, L{'out}]},
            I{'label, [L{'put}]},
            I{'add, [D{'s}, U{'p}, U{'k}]},
            I{'ld, [W{'u8}, D{'b}, M{U{'s}, 0}]},
            I{'add, [D{'d}, U{'a}, U{'k}]},
            I{'st, [W{'w8}, M{U{'d}, 8}, U{'b}]},
            I{'add, [D{'k}, U{'k}, K{1}]},
            I{'jmp, [L{'copy}]},
            I{'label, [L{'out}]},
            I{'ret, [Us{['a]}]}]]))
    }

    # __open(a) opens for reading the file whose name is the bytes of the array a (the layout of vasm/ir.pk) and gives the file, or a negative number,
    # and __create(a) opens it for writing
    open_fun(w, name, service) := {
        nz := zx(w, 'np, 'n)
        fn(name, w, ['a, 'buf, 'np, 'k, 's, 'd, 'e], [], list.concat([[
            I{'getarg, [D{'a}, K{0}]},
            I{'ld, [W{'w32}, D{'n}, M{U{'a}, 0}]},
            I{'add, [D{'sz}, U{'n}, K{1}]},
            I{'call, [S{"__alloc", 0}, Us{['sz]}, Ds{['buf]}]}], nz[0], [
            I{'li, [D{'k}, K{0}]},
            I{'label, [L{'copy}]},
            I{'br, [Cc{'ltu}, U{'k}, U{nz[1]}, L{'put}, L{'out}]},
            I{'label, [L{'put}]},
            I{'add, [D{'s}, U{'a}, U{'k}]},
            I{'ld, [W{'u8}, D{'b}, M{U{'s}, 8}]},
            I{'add, [D{'d}, U{'buf}, U{'k}]},
            I{'st, [W{'w8}, M{U{'d}, 0}, U{'b}]},
            I{'add, [D{'k}, U{'k}, K{1}]},
            I{'jmp, [L{'copy}]},
            I{'label, [L{'out}]},
            I{'add, [D{'e}, U{'buf}, U{nz[1]}]},
            I{'st, [W{'w8}, M{U{'e}, 0}, K{0}]},
            I{'os, [N{service}, Us{['buf]}, D{'fd}]},
            I{'call, [S{"__free", 0}, Us{['buf]}, Ds{[]}]},
            I{'ret, [Us{['fd]}]}]]))
    }

    # the functions of the ports that the calls to the names called need
    export ports(w, called) := list.concat([if (member("__argv", called)) [argv_fun(w)] else [],
        if (member("__open", called)) [open_fun(w, "__open", 'open)] else [],
        if (member("__create", called)) [open_fun(w, "__create", 'create)] else []])

    # === Values of value ===

    # a jump to l unless the kind of the block p is the kind k
    need(p, k, t) := [I{'ld, [W{'w32}, D{'kind}, M{U{p}, kind}]}, I{'br, [Cc{'eq}, U{'kind}, K{k}, L{t}, L{'bad}]}, I{'label, [L{t}]}]
    runtime_bad := [I{'label, [L{'bad}]}, I{'trap, []}]

    value_inc_fun(w) := fn("__val_inc", w, ['p], [], [
        I{'getarg, [D{'p}, K{0}]},
        I{'br, [Cc{'eq}, U{'p}, K{0}, L{'out}, L{'go}]},
        I{'label, [L{'go}]},
        I{'ld, [W{'w32}, D{'c}, M{U{'p}, rc}]},
        I{'br, [Cc{'lt}, U{'c}, K{0}, L{'out}, L{'add}]},
        I{'label, [L{'add}]},
        I{'add, [D{'c}, U{'c}, K{1}]},
        I{'st, [W{'w32}, M{U{'p}, rc}, U{'c}]},
        I{'label, [L{'out}]},
        I{'ret, [Us{[]}]}])

    # The last of the values in a block is released without a new call, so a long list does not use the stack.
    value_drop_fun(w) := {
        pw := runtime_pw(w)
        i4z := zx(w, 'i4p, 'i4)
        n4z := zx(w, 'n4p, 'n4)
        fn("__val_drop", w, ['p, 'h, 'base, 'e, 'x, 'q, 'i4p, 'n4p], [], list.concat([[
            I{'getarg, [D{'p}, K{0}]},
            I{'label, [L{'top}]},
            I{'br, [Cc{'eq}, U{'p}, K{0}, L{'out}, L{'a}]},
            I{'label, [L{'a}]},
            I{'ld, [W{'w32}, D{'c}, M{U{'p}, rc}]},
            I{'br, [Cc{'lt}, U{'c}, K{0}, L{'out}, L{'b}]},
            I{'label, [L{'b}]},
            I{'sub, [D{'c}, U{'c}, K{1}]},
            I{'br, [Cc{'gt}, U{'c}, K{0}, L{'keep}, L{'dead}]},
            I{'label, [L{'keep}]},
            I{'st, [W{'w32}, M{U{'p}, rc}, U{'c}]},
            I{'ret, [Us{[]}]},
            I{'label, [L{'dead}]},
            I{'ld, [W{'w32}, D{'k}, M{U{'p}, kind}]},
            I{'br, [Cc{'eq}, U{'k}, K{kind_con}, L{'con}, L{'k2}]},
            I{'label, [L{'k2}]},
            I{'br, [Cc{'eq}, U{'k}, K{kind_array}, L{'array}, L{'k3}]},
            I{'label, [L{'k3}]},
            I{'br, [Cc{'eq}, U{'k}, K{kind_fun}, L{'func}, L{'leaf}]},
            I{'label, [L{'con}]},
            I{'ld, [W{pw}, D{'h}, M{U{'p}, con_head}]},
            I{'call, [S{"__val_drop", 0}, Us{['h]}, Ds{[]}]},
            I{'ld, [W{'w32}, D{'n}, M{U{'p}, con_n(w)}]},
            I{'add, [D{'base}, U{'p}, K{con_elems(w)}]},
            I{'jmp, [L{'kids}]},
            I{'label, [L{'array}]},
            I{'ld, [W{'w32}, D{'n}, M{U{'p}, array_n}]},
            I{'add, [D{'base}, U{'p}, K{array_elems}]},
            I{'jmp, [L{'kids}]},
            I{'label, [L{'func}]},
            I{'ld, [W{'w32}, D{'n}, M{U{'p}, fun_n(w)}]},
            I{'add, [D{'base}, U{'p}, K{fun_elems(w)}]},
            I{'jmp, [L{'kids}]},
            I{'label, [L{'kids}]},
            I{'br, [Cc{'eq}, U{'n}, K{0}, L{'leaf}, L{'some}]},
            I{'label, [L{'some}]},
            I{'sub, [D{'n}, U{'n}, K{1}]},
            I{'li, [D{'i}, K{0}]},
            I{'label, [L{'loop}]},
            I{'br, [Cc{'ltu}, U{'i}, U{'n}, L{'one}, L{'lastk}]},
            I{'label, [L{'one}]},
            I{'shl, [D{'i4}, U{'i}, K{shift(w)}]}], i4z[0], [
            I{'add, [D{'e}, U{'base}, U{i4z[1]}]},
            I{'ld, [W{pw}, D{'x}, M{U{'e}, 0}]},
            I{'call, [S{"__val_drop", 0}, Us{['x]}, Ds{[]}]},
            I{'add, [D{'i}, U{'i}, K{1}]},
            I{'jmp, [L{'loop}]},
            I{'label, [L{'lastk}]},
            I{'shl, [D{'n4}, U{'n}, K{shift(w)}]}], n4z[0], [
            I{'add, [D{'e}, U{'base}, U{n4z[1]}]},
            I{'ld, [W{pw}, D{'q}, M{U{'e}, 0}]},
            I{'call, [S{"__free", 0}, Us{['p]}, Ds{[]}]},
            I{'mov, [D{'p}, U{'q}]},
            I{'jmp, [L{'top}]},
            I{'label, [L{'leaf}]},
            I{'call, [S{"__free", 0}, Us{['p]}, Ds{[]}]},
            I{'label, [L{'out}]},
            I{'ret, [Us{[]}]}]]))
    }

    # __val_int(v) is a new integer
    value_int_fun(w) := fn("__val_int", w, ['p], ['v], [
        I{'getarg, [D{'v}, K{0}]},
        I{'li, [D{'sz}, K{int_at + 8}]},
        I{'call, [S{"__alloc", 0}, Us{['sz]}, Ds{['p]}]},
        I{'st, [W{'w32}, M{U{'p}, rc}, K{1}]},
        I{'st, [W{'w32}, M{U{'p}, kind}, K{kind_int}]},
        I{'st, [W{'w64}, M{U{'p}, int_at}, U{'v}]},
        I{'ret, [Us{['p]}]}])

    # __val_unint(v) gives the 64-bit value of the integer v
    value_unint_fun(w) := fn("__val_unint", w, ['p], ['v], append(append([I{'getarg, [D{'p}, K{0}]}], need('p, kind_int, 'ok)), append([
        I{'ld, [W{'w64}, D{'v}, M{U{'p}, int_at}]},
        I{'ret, [Us{['v]}]}], runtime_bad)))

    # __val_bool(b) is the symbol true or false
    value_bool_fun(w) := fn("__val_bool", w, ['r], [], [
        I{'getarg, [D{'b}, K{0}]},
        I{'br, [Cc{'ne}, U{'b}, K{0}, L{'t}, L{'f}]},
        I{'label, [L{'t}]},
        I{'la, [D{'r}, S{"__sym_true", 0}]},
        I{'ret, [Us{['r]}]},
        I{'label, [L{'f}]},
        I{'la, [D{'r}, S{"__sym_false", 0}]},
        I{'ret, [Us{['r]}]}])

    # __val_unbool(v) is 1 for the symbol true, 0 for the symbol false
    value_unbool_fun(w) := fn("__val_unbool", w, ['v, 't, 'f], [], append([
        I{'getarg, [D{'v}, K{0}]},
        I{'la, [D{'t}, S{"__sym_true", 0}]},
        I{'call, [S{"__val_eq", 0}, Us{['v, 't]}, Ds{['r]}]},
        I{'br, [Cc{'ne}, U{'r}, K{0}, L{'yes}, L{'no}]},
        I{'label, [L{'yes}]},
        I{'li, [D{'one}, K{1}]},
        I{'ret, [Us{['one]}]},
        I{'label, [L{'no}]},
        I{'la, [D{'f}, S{"__sym_false", 0}]},
        I{'call, [S{"__val_eq", 0}, Us{['v, 'f]}, Ds{['r]}]},
        I{'br, [Cc{'ne}, U{'r}, K{0}, L{'zero}, L{'bad}]},
        I{'label, [L{'zero}]},
        I{'li, [D{'z}, K{0}]},
        I{'ret, [Us{['z]}]}], runtime_bad))

    # copy n bytes from the address s to the address d; the registers d, s and n have the width of an address
    runtime_copy(d, s, n) := [
        I{'li, [D{'k}, K{0}]},
        I{'label, [L{'copy}]},
        I{'br, [Cc{'ltu}, U{'k}, U{n}, L{'put}, L{'copied}]},
        I{'label, [L{'put}]},
        I{'add, [D{'sa}, U{s}, U{'k}]},
        I{'ld, [W{'u8}, D{'byte}, M{U{'sa}, 0}]},
        I{'add, [D{'da}, U{d}, U{'k}]},
        I{'st, [W{'w8}, M{U{'da}, 0}, U{'byte}]},
        I{'add, [D{'k}, U{'k}, K{1}]},
        I{'jmp, [L{'copy}]},
        I{'label, [L{'copied}]}]

    # __val_str(a, kind) is a new string or symbol with the bytes of the array a
    value_string_fun(w) := {
        nz := zx(w, 'np, 'n)
        fn("__val_str", w, ['a, 'p, 'np, 'src, 'dst, 'k, 'sa, 'da], [], list.concat([[
            I{'getarg, [D{'a}, K{0}]},
            I{'getarg, [D{'kd}, K{1}]},
            I{'ld, [W{'w32}, D{'n}, M{U{'a}, 0}]},
            I{'add, [D{'sz}, U{'n}, K{16}]},
            I{'call, [S{"__alloc", 0}, Us{['sz]}, Ds{['p]}]},
            I{'st, [W{'w32}, M{U{'p}, rc}, K{1}]},
            I{'st, [W{'w32}, M{U{'p}, kind}, U{'kd}]},
            I{'st, [W{'w32}, M{U{'p}, 8}, U{'n}]},
            I{'st, [W{'w32}, M{U{'p}, 12}, K{0}]}], nz[0], [
            I{'add, [D{'src}, U{'a}, K{8}]},
            I{'add, [D{'dst}, U{'p}, K{16}]}], runtime_copy('dst, 'src, nz[1]), [
            I{'ret, [Us{['p]}]}]]))
    }

    # __val_bytes(v) is a new array of the bytes of the string v
    value_bytes_fun(w) := {
        nz := zx(w, 'np, 'n)
        fn("__val_bytes", w, ['v, 'a, 'np, 'src, 'dst, 'k, 'sa, 'da], [], list.concat([[I{'getarg, [D{'v}, K{0}]}], need('v, kind_string, 'ok), [
            I{'ld, [W{'w32}, D{'n}, M{U{'v}, 8}]},
            I{'add, [D{'sz}, U{'n}, K{8}]},
            I{'call, [S{"__alloc", 0}, Us{['sz]}, Ds{['a]}]},
            I{'st, [W{'w32}, M{U{'a}, 0}, U{'n}]},
            I{'st, [W{'w32}, M{U{'a}, 4}, K{0}]}], nz[0], [
            I{'add, [D{'src}, U{'v}, K{16}]},
            I{'add, [D{'dst}, U{'a}, K{8}]}], runtime_copy('dst, 'src, nz[1]), [
            I{'ret, [Us{['a]}]}], runtime_bad]))
    }

    # __val_retag(v, kind) is a new string or symbol with the bytes of the string or symbol v
    value_retag_fun(w) := fn("__val_retag", w, ['v, 'a, 'r], [], append([
        I{'getarg, [D{'v}, K{0}]},
        I{'getarg, [D{'kd}, K{1}]},
        I{'ld, [W{'w32}, D{'k}, M{U{'v}, kind}]},
        I{'br, [Cc{'eq}, U{'k}, K{kind_string}, L{'ok}, L{'k2}]},
        I{'label, [L{'k2}]},
        I{'br, [Cc{'eq}, U{'k}, K{kind_symbol}, L{'ok}, L{'bad}]},
        I{'label, [L{'ok}]},
        I{'add, [D{'a}, U{'v}, K{8}]},
        I{'call, [S{"__val_str", 0}, Us{['a, 'kd]}, Ds{['r]}]},
        I{'ret, [Us{['r]}]}], runtime_bad))

    # __val_eq(a, b) is 1 when a == b of planck holds: the same kind and the same contents, and the same block for an array or a function.
    # The last argument of a constructed value is compared without a new call.
    value_eq_fun(w) := {
        pw := runtime_pw(w)
        iz := zx(w, 'ip, 'i)
        i4z := zx(w, 'i4p, 'i4)
        n4z := zx(w, 'n4p, 'n4)
        fn("__val_eq", w, ['a, 'b, 'pa, 'pb, 'x, 'y, 'ip, 'i4p, 'n4p], [], list.concat([[
            I{'getarg, [D{'a}, K{0}]},
            I{'getarg, [D{'b}, K{1}]},
            I{'label, [L{'top}]},
            I{'br, [Cc{'eq}, U{'a}, U{'b}, L{'yes}, L{'diff}]},
            I{'label, [L{'diff}]},
            I{'ld, [W{'w32}, D{'ka}, M{U{'a}, kind}]},
            I{'ld, [W{'w32}, D{'kb}, M{U{'b}, kind}]},
            I{'br, [Cc{'eq}, U{'ka}, U{'kb}, L{'same}, L{'no}]},
            I{'label, [L{'same}]},
            I{'br, [Cc{'eq}, U{'ka}, K{kind_int}, L{'int}, L{'s1}]},
            I{'label, [L{'s1}]},
            I{'br, [Cc{'eq}, U{'ka}, K{kind_string}, L{'bytes}, L{'s2}]},
            I{'label, [L{'s2}]},
            I{'br, [Cc{'eq}, U{'ka}, K{kind_symbol}, L{'bytes}, L{'s3}]},
            I{'label, [L{'s3}]},
            I{'br, [Cc{'eq}, U{'ka}, K{kind_con}, L{'con}, L{'no}]},
            I{'label, [L{'int}]},
            I{'ld, [W{'w32}, D{'xi}, M{U{'a}, int_at}]},
            I{'ld, [W{'w32}, D{'yi}, M{U{'b}, int_at}]},
            I{'br, [Cc{'eq}, U{'xi}, U{'yi}, L{'int2}, L{'no}]},
            I{'label, [L{'int2}]},
            I{'ld, [W{'w32}, D{'xi}, M{U{'a}, int_at + 4}]},
            I{'ld, [W{'w32}, D{'yi}, M{U{'b}, int_at + 4}]},
            I{'br, [Cc{'eq}, U{'xi}, U{'yi}, L{'yes}, L{'no}]},
            I{'label, [L{'bytes}]},
            I{'ld, [W{'w32}, D{'n}, M{U{'a}, 8}]},
            I{'ld, [W{'w32}, D{'m}, M{U{'b}, 8}]},
            I{'br, [Cc{'eq}, U{'n}, U{'m}, L{'b0}, L{'no}]},
            I{'label, [L{'b0}]},
            I{'li, [D{'i}, K{0}]},
            I{'label, [L{'bloop}]},
            I{'br, [Cc{'ltu}, U{'i}, U{'n}, L{'b1}, L{'yes}]},
            I{'label, [L{'b1}]}], iz[0], [
            I{'add, [D{'pa}, U{'a}, U{iz[1]}]},
            I{'add, [D{'pb}, U{'b}, U{iz[1]}]},
            I{'ld, [W{'u8}, D{'xb}, M{U{'pa}, 16}]},
            I{'ld, [W{'u8}, D{'yb}, M{U{'pb}, 16}]},
            I{'add, [D{'i}, U{'i}, K{1}]},
            I{'br, [Cc{'eq}, U{'xb}, U{'yb}, L{'bloop}, L{'no}]},
            I{'label, [L{'con}]},
            I{'ld, [W{'w32}, D{'n}, M{U{'a}, con_n(w)}]},
            I{'ld, [W{'w32}, D{'m}, M{U{'b}, con_n(w)}]},
            I{'br, [Cc{'eq}, U{'n}, U{'m}, L{'c0}, L{'no}]},
            I{'label, [L{'c0}]},
            I{'ld, [W{pw}, D{'x}, M{U{'a}, con_head}]},
            I{'ld, [W{pw}, D{'y}, M{U{'b}, con_head}]},
            I{'call, [S{"__val_eq", 0}, Us{['x, 'y]}, Ds{['r]}]},
            I{'br, [Cc{'ne}, U{'r}, K{0}, L{'c1}, L{'no}]},
            I{'label, [L{'c1}]},
            I{'br, [Cc{'eq}, U{'n}, K{0}, L{'yes}, L{'c2}]},
            I{'label, [L{'c2}]},
            I{'sub, [D{'n}, U{'n}, K{1}]},
            I{'li, [D{'i}, K{0}]},
            I{'label, [L{'cloop}]},
            I{'br, [Cc{'ltu}, U{'i}, U{'n}, L{'c3}, L{'clast}]},
            I{'label, [L{'c3}]},
            I{'shl, [D{'i4}, U{'i}, K{shift(w)}]}], i4z[0], [
            I{'add, [D{'pa}, U{'a}, U{i4z[1]}]},
            I{'add, [D{'pb}, U{'b}, U{i4z[1]}]},
            I{'ld, [W{pw}, D{'x}, M{U{'pa}, con_elems(w)}]},
            I{'ld, [W{pw}, D{'y}, M{U{'pb}, con_elems(w)}]},
            I{'call, [S{"__val_eq", 0}, Us{['x, 'y]}, Ds{['r]}]},
            I{'add, [D{'i}, U{'i}, K{1}]},
            I{'br, [Cc{'ne}, U{'r}, K{0}, L{'cloop}, L{'no}]},
            I{'label, [L{'clast}]},
            I{'shl, [D{'n4}, U{'n}, K{shift(w)}]}], n4z[0], [
            I{'add, [D{'pa}, U{'a}, U{n4z[1]}]},
            I{'add, [D{'pb}, U{'b}, U{n4z[1]}]},
            I{'ld, [W{pw}, D{'a}, M{U{'pa}, con_elems(w)}]},
            I{'ld, [W{pw}, D{'b}, M{U{'pb}, con_elems(w)}]},
            I{'jmp, [L{'top}]},
            I{'label, [L{'yes}]},
            I{'li, [D{'one}, K{1}]},
            I{'ret, [Us{['one]}]},
            I{'label, [L{'no}]},
            I{'li, [D{'z}, K{0}]},
            I{'ret, [Us{['z]}]}]]))
    }

    # __val_is(v, h, n) is 1 when v is a constructed value with the head h and n arguments
    value_is_fun(w) := {
        pw := runtime_pw(w)
        fn("__val_is", w, ['v, 'h, 'x], [], [
            I{'getarg, [D{'v}, K{0}]},
            I{'getarg, [D{'h}, K{1}]},
            I{'getarg, [D{'n}, K{2}]},
            I{'ld, [W{'w32}, D{'k}, M{U{'v}, kind}]},
            I{'br, [Cc{'eq}, U{'k}, K{kind_con}, L{'a}, L{'no}]},
            I{'label, [L{'a}]},
            I{'ld, [W{'w32}, D{'m}, M{U{'v}, con_n(w)}]},
            I{'br, [Cc{'eq}, U{'m}, U{'n}, L{'b}, L{'no}]},
            I{'label, [L{'b}]},
            I{'ld, [W{pw}, D{'x}, M{U{'v}, con_head}]},
            I{'call, [S{"__val_eq", 0}, Us{['x, 'h]}, Ds{['r]}]},
            I{'ret, [Us{['r]}]},
            I{'label, [L{'no}]},
            I{'li, [D{'z}, K{0}]},
            I{'ret, [Us{['z]}]}])
    }

    # the number of elements n and the address of the first element of the constructed value or the array v, in the registers 'n and 'base
    elems(w, v) := [
        I{'ld, [W{'w32}, D{'k}, M{U{v}, kind}]},
        I{'br, [Cc{'eq}, U{'k}, K{kind_con}, L{'ec}, L{'e2}]},
        I{'label, [L{'e2}]},
        I{'br, [Cc{'eq}, U{'k}, K{kind_array}, L{'ea}, L{'bad}]},
        I{'label, [L{'ec}]},
        I{'ld, [W{'w32}, D{'n}, M{U{v}, con_n(w)}]},
        I{'add, [D{'base}, U{v}, K{con_elems(w)}]},
        I{'jmp, [L{'ed}]},
        I{'label, [L{'ea}]},
        I{'ld, [W{'w32}, D{'n}, M{U{v}, array_n}]},
        I{'add, [D{'base}, U{v}, K{array_elems}]},
        I{'jmp, [L{'ed}]},
        I{'label, [L{'ed}]}]

    # the check that the 64-bit index index is less than the 32-bit count n, and the 32-bit i4 that is the offset of the element in bytes
    index(w, v) := [
        I{'zext64, [D{'nw}, U{'n}]},
        I{'br, [Cc{'ltu}, U{'index}, U{'nw}, L{'inrange}, L{'bad}]},
        I{'label, [L{'inrange}]},
        I{'trunc, [D{'i32}, U{'index}]},
        I{'shl, [D{'i4}, U{'i32}, K{shift(w)}]}]

    # __val_get(v, index) is the element of the constructed value or the array v at the index, with a new holder
    value_get_fun(w) := {
        pw := runtime_pw(w)
        i4z := zx(w, 'i4p, 'i4)
        fn("__val_get", w, ['v, 'base, 'i4p, 'e, 'x], ['index, 'nw], list.concat([[
            I{'getarg, [D{'v}, K{0}]},
            I{'getarg, [D{'index}, K{1}]}], elems(w, 'v), index(w, 'v), i4z[0], [
            I{'add, [D{'e}, U{'base}, U{i4z[1]}]},
            I{'ld, [W{pw}, D{'x}, M{U{'e}, 0}]},
            I{'call, [S{"__val_inc", 0}, Us{['x]}, Ds{[]}]},
            I{'ret, [Us{['x]}]}], runtime_bad]))
    }

    # __val_set(v, index, x) puts x in the array v at the index; the place holds x and what it held before has one holder less
    value_set_fun(w) := {
        pw := runtime_pw(w)
        i4z := zx(w, 'i4p, 'i4)
        fn("__val_set", w, ['v, 'x, 'i4p, 'e, 'old], ['index, 'nw], list.concat([[
            I{'getarg, [D{'v}, K{0}]},
            I{'getarg, [D{'index}, K{1}]},
            I{'getarg, [D{'x}, K{1 + w64words(w)}]}], need('v, kind_array, 'isarr), [
            I{'ld, [W{'w32}, D{'n}, M{U{'v}, array_n}]}], index(w, 'v), i4z[0], [
            I{'add, [D{'e}, U{'v}, U{i4z[1]}]},
            I{'ld, [W{pw}, D{'old}, M{U{'e}, array_elems}]},
            I{'st, [W{pw}, M{U{'e}, array_elems}, U{'x}]},
            I{'call, [S{"__val_drop", 0}, Us{['old]}, Ds{[]}]},
            I{'ret, [Us{[]}]}], runtime_bad]))
    }

    value_arity_fun(w) := fn("__val_arity", w, ['v], [], append([
        I{'getarg, [D{'v}, K{0}]},
        I{'ld, [W{'w32}, D{'k}, M{U{'v}, kind}]},
        I{'br, [Cc{'eq}, U{'k}, K{kind_con}, L{'con}, L{'other}]},
        I{'label, [L{'con}]},
        I{'ld, [W{'w32}, D{'n}, M{U{'v}, con_n(w)}]},
        I{'ret, [Us{['n]}]},
        I{'label, [L{'other}]},
        I{'br, [Cc{'geu}, U{'k}, K{kind_string}, L{'o2}, L{'bad}]},
        I{'label, [L{'o2}]},
        I{'br, [Cc{'eq}, U{'k}, K{kind_fun}, L{'bad}, L{'o3}]},
        I{'label, [L{'o3}]},
        I{'ld, [W{'w32}, D{'n}, M{U{'v}, 8}]},
        I{'ret, [Us{['n]}]}], runtime_bad))

    value_head_fun(w) := fn("__val_head", w, ['v, 'h], [], append(append(append([I{'getarg, [D{'v}, K{0}]}], need('v, kind_con, 'ok)), [
        I{'ld, [W{runtime_pw(w)}, D{'h}, M{U{'v}, con_head}]},
        I{'call, [S{"__val_inc", 0}, Us{['h]}, Ds{[]}]},
        I{'ret, [Us{['h]}]}]), runtime_bad))

    # one case of __val_typeof
    typeof_case(k, name, next) := [
        I{'br, [Cc{'eq}, U{'k}, K{k}, L{intern(name)}, L{next}]},
        I{'label, [L{intern(name)}]},
        I{'la, [D{'r}, S{name, 0}]},
        I{'ret, [Us{['r]}]},
        I{'label, [L{next}]}]

    value_typeof_fun(w) := fn("__val_typeof", w, ['v, 'r], [], list.concat([
        [I{'getarg, [D{'v}, K{0}]},
         I{'ld, [W{'w32}, D{'k}, M{U{'v}, kind}]}],
        typeof_case(kind_int, "__sym_int", 'n1),
        typeof_case(kind_string, "__sym_string", 'n2),
        typeof_case(kind_symbol, "__sym_symbol", 'n3),
        typeof_case(kind_con, "__sym_mexpr", 'n4),
        typeof_case(kind_array, "__sym_array", 'n5),
        [I{'la, [D{'r}, S{"__sym_function", 0}]},
         I{'ret, [Us{['r]}]}]]))

    # __val_array(index, x) is a new array of that many elements x
    value_array_fun(w) := {
        pw := runtime_pw(w)
        i4z := zx(w, 'i4p, 'i4)
        fn("__val_array", w, ['x, 'p, 'e, 'i4p], ['index], list.concat([[
            I{'getarg, [D{'index}, K{0}]},
            I{'getarg, [D{'x}, K{w64words(w)}]},
            I{'br, [Cc{'ltu}, U{'index}, K{134217728}, L{'fits}, L{'bad}]},
            I{'label, [L{'fits}]},
            I{'trunc, [D{'lo}, U{'index}]},
            I{'shl, [D{'bytes}, U{'lo}, K{shift(w)}]},
            I{'add, [D{'sz}, U{'bytes}, K{array_elems}]},
            I{'call, [S{"__alloc", 0}, Us{['sz]}, Ds{['p]}]},
            I{'st, [W{'w32}, M{U{'p}, rc}, K{1}]},
            I{'st, [W{'w32}, M{U{'p}, kind}, K{kind_array}]},
            I{'st, [W{'w32}, M{U{'p}, array_n}, U{'lo}]},
            I{'st, [W{'w32}, M{U{'p}, 12}, K{0}]},
            I{'li, [D{'i}, K{0}]},
            I{'label, [L{'loop}]},
            I{'br, [Cc{'ltu}, U{'i}, U{'lo}, L{'one}, L{'done}]},
            I{'label, [L{'one}]},
            I{'shl, [D{'i4}, U{'i}, K{shift(w)}]}], i4z[0], [
            I{'add, [D{'e}, U{'p}, U{i4z[1]}]},
            I{'st, [W{pw}, M{U{'e}, array_elems}, U{'x}]},
            I{'call, [S{"__val_inc", 0}, Us{['x]}, Ds{[]}]},
            I{'add, [D{'i}, U{'i}, K{1}]},
            I{'jmp, [L{'loop}]},
            I{'label, [L{'done}]},
            I{'ret, [Us{['p]}]}], runtime_bad]))
    }

    # __val_mexpr(h, a) is a new constructed value with the head h and the elements of the array a
    value_mexpr_fun(w) := {
        pw := runtime_pw(w)
        i4z := zx(w, 'i4p, 'i4)
        fn("__val_mexpr", w, ['h, 'a, 'p, 'sa, 'da, 'x, 'i4p], [], list.concat([[
            I{'getarg, [D{'h}, K{0}]},
            I{'getarg, [D{'a}, K{1}]}], need('a, kind_array, 'isarr), [
            I{'ld, [W{'w32}, D{'n}, M{U{'a}, array_n}]},
            I{'shl, [D{'bytes}, U{'n}, K{shift(w)}]},
            I{'add, [D{'sz}, U{'bytes}, K{con_elems(w)}]},
            I{'call, [S{"__alloc", 0}, Us{['sz]}, Ds{['p]}]},
            I{'st, [W{'w32}, M{U{'p}, rc}, K{1}]},
            I{'st, [W{'w32}, M{U{'p}, kind}, K{kind_con}]},
            I{'st, [W{pw}, M{U{'p}, con_head}, U{'h}]},
            I{'st, [W{'w32}, M{U{'p}, con_n(w)}, U{'n}]},
            I{'call, [S{"__val_inc", 0}, Us{['h]}, Ds{[]}]},
            I{'li, [D{'i}, K{0}]},
            I{'label, [L{'loop}]},
            I{'br, [Cc{'ltu}, U{'i}, U{'n}, L{'one}, L{'done}]},
            I{'label, [L{'one}]},
            I{'shl, [D{'i4}, U{'i}, K{shift(w)}]}], i4z[0], [
            I{'add, [D{'sa}, U{'a}, U{i4z[1]}]},
            I{'ld, [W{pw}, D{'x}, M{U{'sa}, array_elems}]},
            I{'call, [S{"__val_inc", 0}, Us{['x]}, Ds{[]}]},
            I{'add, [D{'da}, U{'p}, U{i4z[1]}]},
            I{'st, [W{pw}, M{U{'da}, con_elems(w)}, U{'x}]},
            I{'add, [D{'i}, U{'i}, K{1}]},
            I{'jmp, [L{'loop}]},
            I{'label, [L{'done}]},
            I{'ret, [Us{['p]}]}], runtime_bad]))
    }

    # __val_code(f, n) is the address of the code of the function value f, which takes n arguments
    value_code_fun(w) := fn("__val_code", w, ['f, 'c], [], append(append(append([
        I{'getarg, [D{'f}, K{0}]},
        I{'getarg, [D{'n}, K{1}]}], need('f, kind_fun, 'isfun)), [
        I{'ld, [W{'w32}, D{'m}, M{U{'f}, fun_rest(w)}]},
        I{'br, [Cc{'eq}, U{'m}, U{'n}, L{'fine}, L{'bad}]},
        I{'label, [L{'fine}]},
        I{'ld, [W{runtime_pw(w)}, D{'c}, M{U{'f}, fun_code}]},
        I{'ret, [Us{['c]}]}]), runtime_bad))

    # the functions on values of value that the code calls, with the functions that these call; each is a function of the word
    value_makers := [Tuple{"__val_inc", value_inc_fun}, Tuple{"__val_drop", value_drop_fun}, Tuple{"__val_int", value_int_fun}, Tuple{"__val_unint", value_unint_fun},
        Tuple{"__val_bool", value_bool_fun}, Tuple{"__val_unbool", value_unbool_fun}, Tuple{"__val_str", value_string_fun}, Tuple{"__val_bytes", value_bytes_fun},
        Tuple{"__val_retag", value_retag_fun}, Tuple{"__val_eq", value_eq_fun}, Tuple{"__val_is", value_is_fun}, Tuple{"__val_get", value_get_fun}, Tuple{"__val_set", value_set_fun},
        Tuple{"__val_arity", value_arity_fun}, Tuple{"__val_head", value_head_fun}, Tuple{"__val_typeof", value_typeof_fun}, Tuple{"__val_array", value_array_fun},
        Tuple{"__val_mexpr", value_mexpr_fun}, Tuple{"__val_code", value_code_fun}]

    call_names(f) := concat_map(i -> match i {
        I{'call, [S{n, _}, _, _]} -> [n]
      | _ -> []
    }, ir.code(f))

    export value_funs(w, called) := {
        done := table.new()
        out := []
        work := called
        while (work != []) {
            n := work[0]
            work = list.drop(work, 1)
            e := find(p -> arg(p, 0) == n, value_makers)
            if (e != none and not table.has(done, n)) {
                table.set(done, n, true)
                f := arg(e, 1)(w)
                out = f :: out
                work = append(call_names(f), work)
            }
        }
        reverse(out)
    }

    # start_fun(w, ret) is _start for a main that returns the type ret: its value (0 for no value) is the exit status.
    # It keeps the arguments of the program (the service args) in __args first.
    export start_fun(w, ret) := {
        f := ir.fn("_start")
        e := i -> ir.emit(f, i)
        st := ir.vreg(f, 32)
        z := ir.vreg(f, 32)
        av := ir.vreg(f, w * 8)
        ap := ir.vreg(f, w * 8)
        e(I{'os, [N{'args}, Us{[]}, D{av}]})
        e(I{'la, [D{ap}, S{"__args", 0}]})
        e(I{'st, [W{runtime_pw(w)}, M{U{ap}, 0}, U{av}]})
        if (ret == Unit{}) e(I{'li, [D{st}, K{0}]})
        else if (ret == I64{} or ret == U64{}) {
            r := ir.vreg(f, 64)
            e(I{'call, [S{"main", 0}, Us{[]}, Ds{[r]}]})
            e(I{'trunc, [D{st}, U{r}]})
        } else e(I{'call, [S{"main", 0}, Us{[]}, Ds{[st]}]})
        e(I{'os, [N{'exit}, Us{[st]}, D{z}]})
        e(I{'trap, []})
        f
    }

    export helpers := {
        t := table.new()
        table.set(t, 'shl, "__shl64")
        table.set(t, 'shr, "__shr64")
        table.set(t, 'sar, "__sar64")
        table.set(t, 'divu, "__divu64")
        table.set(t, 'remu, "__remu64")
        table.set(t, 'divs, "__divs64")
        table.set(t, 'rems, "__rems64")
        t
    }

    # the functions of vasm that the 64-bit operations call
    export runtime := vasm{|
        fun __shl64(x: u64, c: u64) -> u64 {
            var n: u64
            n = c & 63
            while (n > 0) { x = x << 1; n = n - 1 }
            return x
        }
        fun __shr64(x: u64, c: u64) -> u64 {
            var n: u64
            n = c & 63
            while (n > 0) { x = x >> 1; n = n - 1 }
            return x
        }
        fun __sar64(x: i64, c: i64) -> i64 {
            var n: i64
            n = c & 63
            while (n > 0) { x = x >> 1; n = n - 1 }
            return x
        }
        fun __divmod64(a: u64, b: u64, want_rem: bool) -> u64 {
            var q: u64
            var r: u64
            var bit: u64
            var top: u64
            var t: u64
            var go: bool
            var z: u32
            var one: u32
            if (b == 0) { z = 0; one = 1; one = one / z }
            q = 0
            r = 0
            bit = 1
            bit = bit << 63
            while (bit != 0) {
                top = r >> 63
                r = r << 1
                t = a & bit
                if (t != 0) { r = r | 1 }
                go = r >= b
                if (top != 0) { go = true }
                if (go) { r = r - b; q = q | bit }
                bit = bit >> 1
            }
            if (want_rem) { return r }
            return q
        }
        fun __divu64(a: u64, b: u64) -> u64 {
            var q: u64
            q = __divmod64(a, b, false)
            return q
        }
        fun __remu64(a: u64, b: u64) -> u64 {
            var q: u64
            q = __divmod64(a, b, true)
            return q
        }
        fun __divs64(a: i64, b: i64) -> i64 {
            var x: u64
            var y: u64
            var q: u64
            var na: bool
            var nb: bool
            var nq: bool
            var r: i64
            na = a < 0
            nb = b < 0
            nq = na != nb
            x = a as u64
            y = b as u64
            if (na) { x = 0 - x }
            if (nb) { y = 0 - y }
            q = __divmod64(x, y, false)
            if (nq) { q = 0 - q }
            r = q as i64
            return r
        }
        fun __rems64(a: i64, b: i64) -> i64 {
            var x: u64
            var y: u64
            var q: u64
            var na: bool
            var nb: bool
            var r: i64
            na = a < 0
            nb = b < 0
            x = a as u64
            y = b as u64
            if (na) { x = 0 - x }
            if (nb) { y = 0 - y }
            q = __divmod64(x, y, true)
            if (na) { q = 0 - q }
            r = q as i64
            return r
        }
    |}
}
