# vasm_build: compiles vasm modules to an executable file
# Copyright (C) 2026 nineties
#
# vasm_build(m, path) checks the module m = Module{[...]} (vasm_check), translates it to the machine instructions of the default target
# (backend/target.pk) with the runtime of vasm/rt.pk and writes the executable file path. The function main takes no arguments, and its result is the exit status.
# The module is compiled as a unit (vasm/unit.pk) and the units are joined before the stages of the target. A program of several modules is
# vasm_build_units(units, path), where the units are made by vasm_unit and may have been saved and read again.
# The stages up to vasm_lower (vasm/ir.pk) know the machine only by the width of its word. What follows is the target's: the rewriting of the functions for its
# registers (wide_lower of backend/wide.pk for x86), x86_compile (backend/x86.pk, with backend/sched.pk and backend/regalloc.pk) and the joining of the objects into the
# file (backend/link.pk, backend/elf.pk).

use("base")
use("list")
use("table")
use("vector")
use("string")
use("bytes")
use("backend/ir")
use("backend/target")
use("vasm/check")
use("vasm/ir")
use("vasm/rt")
use("vasm/unit")

# the names of the functions that the code calls
vb_calls(code) := concat_map(i -> match i {
    I{'call, [S{n, _}, _, _]} -> [n]
  | _ -> []
}, code)

# the names of the functions of vasm_rt_module
vb_helper_names := map(d -> symname(arg(d, 1)), arg(vasm_rt_module, 0))

# the object for the target t of the merged units: the code of the functions, the runtime and the helpers they call
vasm_object_for(t, Merged{lowered, strs, syms, ret}) := {
    datas := append(map(vasm_string_data, strs), map(vasm_symbol_data, map(intern, syms)))
    called := concat_map(f -> vb_calls(ir_code(f)), lowered)
    fns := append(lowered, append([rt_alloc_fn(), rt_free_fn(), rt_start_fn(ret)], append(rt_ports(called), rt_val_fns(called))))
    done := table()
    out := []
    queue := fns
    while (queue != []) {
        f := queue[0]
        queue = drop(queue, 1)
        g := target_lower(t, f, vasm_rt_helpers)
        out = g :: out
        table_set(done, ir_name(f), true)
        # the helpers that the code calls and that are not made yet
        need := filter(n -> member(n, vb_helper_names) and not table_has(done, n), vb_calls(ir_code(g)))
        need = reverse(foldl((acc, n) -> if (member(n, acc)) acc else n :: acc, [], need))
        if (need != []) {
            each(n -> table_set(done, n, true), need)
            queue = append(queue, vasm_lower_only(vasm_rt_module, map(intern, need)))
        }
    }
    target_compile(t, "vasm", reverse(out), append(rt_data(), datas))
}

# vasm_units_executable(units) is the file for the default target as a buffer of bytes
vasm_units_executable(units) := {
    t := target_get(target_default)
    target_executable(t, [vasm_object_for(t, vasm_units_merge(units, target_word(t)))])
}

# vasm_executable(m) is the file of the module m
vasm_executable(m) := vasm_units_executable([vasm_unit("main", m, [], target_word(target_get(target_default)))])

write_executable(path, b) := {
    write_file(path, bb_to_u8(b))
    chmod(path, 493)
}

vasm_build(m, path) := write_executable(path, vasm_executable(m))
vasm_build_units(units, path) := write_executable(path, vasm_units_executable(units))
