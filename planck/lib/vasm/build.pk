use("base")
use("list")
use("table")
use("vector")
use("string")
use("bytes")
use("backend/ir")
use("backend/target")
use("vasm/check")
use("vasm/ir")
use("vasm/runtime")
use("vasm/unit")

module vasm_build {
    calls(code) := concat_map(i -> match i {
        I{'call, [S{n, _}, _, _]} -> [n]
      | _ -> []
    }, code)

    helper_names := map(d -> symname(arg(d, 1)), arg(runtime.runtime, 0))

    object_for(t, Merged{lowered, strings, symbols, ret}) := {
        w := target.word(t)
        datas := append(map(vasm_ir.string_data, strings), map(vasm_ir.symbol_data, map(intern, symbols)))
        called := concat_map(f -> calls(ir.code(f)), lowered)
        funs := append(lowered, append([runtime.allocate_fun(w), runtime.free_fun(w), runtime.start_fun(w, ret)], append(runtime.ports(w, called), runtime.value_funs(w, called))))
        done := table.new()
        out := []
        queue := funs
        while (queue != []) {
            f := queue[0]
            queue = list.drop(queue, 1)
            g := target.lower(t, f, runtime.helpers)
            out = g :: out
            table.set(done, ir.name(f), true)
            need := filter(n -> member(n, helper_names) and not table.has(done, n), calls(ir.code(g)))
            need = reverse(foldl((acc, n) -> if (member(n, acc)) acc else n :: acc, [], need))
            if (need != []) {
                each(n -> table.set(done, n, true), need)
                queue = append(queue, vasm_ir.lower_only(runtime.runtime, map(intern, need), w))
            }
        }
        target.compile(t, "vasm", reverse(out), append(runtime.data(w), datas))
    }

    export units_executable_for(t, units) := target.executable(t, [object_for(t, vasm_unit.units_merge(units, target.word(t)))])

    export executable_for(t, m) := units_executable_for(t, [vasm_unit.unit("main", m, [], target.word(t))])

    export units_executable(units) := units_executable_for(target.get(target.default), units)
    export executable(m) := executable_for(target.get(target.default), m)

    write_executable(path, b) := {
        write_file(path, bytes.to_u8(b))
        chmod(path, 493)
    }

    export build(m, path) := write_executable(path, executable(m))
    export build_units(units, path) := write_executable(path, units_executable(units))

    export build_units_for(name, units, path) := write_executable(path, units_executable_for(target.get(name), units))

    export build_for(name, m, path) := write_executable(path, executable_for(target.get(name), m))
}
