# vasm_build: compiles a vasm module to an executable file
# Copyright (C) 2026 nineties
#
# vasm_build(m, path) checks the module m = Module{[...]} (vasm_check), translates it to the 32-bit x86 instructions with the runtime of
# vasm/rt.pk and writes the executable file path. The function main takes no arguments, and its result is the exit status.
# The stages are vasm_lower (vasm/ir.pk), wide_lower (backend/wide.pk), x86_compile (backend/x86.pk, with backend/sched.pk and backend/regalloc.pk) and link (backend/link.pk, backend/elf.pk).

use("base")
use("list")
use("table")
use("vector")
use("string")
use("backend/ir")
use("vasm/check")
use("vasm/ir")
use("vasm/rt")
use("backend/wide")
use("backend/x86")
use("backend/link")
use("backend/elf")

vasm_base_address := 134512640

# the names of the functions that the code calls
vb_calls(code) := concat_map(i -> match i {
    I{'call, [S{n, _}, _, _]} -> [n]
  | _ -> []
}, code)

# the names of the functions of vasm_rt_module
vb_helper_names := map(d -> symname(arg(d, 1)), arg(vasm_rt_module, 0))

vb_main_type(m) := {
    d := find(d -> head(d) == 'Fn and arg(d, 1) == 'main, arg(m, 0))
    if (d == none) panic("vasm_build: the module has no function main")
    if (arg(d, 3) != []) panic("vasm_build: main takes no arguments")
    arg(d, 4)
}

# the object of the module: the code of the functions, the runtime and the helpers they call
vasm_object(m) := {
    ret := vb_main_type(m)
    lowered := vasm_lower(m)
    strs := append(vasm_strings(), vasm_symbols())
    called := concat_map(f -> vb_calls(ir_code(f)), lowered)
    fns := append(lowered, append([rt_alloc_fn(), rt_free_fn(), rt_start_fn(ret)], append(rt_ports(called), rt_val_fns(called))))
    done := table()
    out := []
    queue := fns
    while (queue != []) {
        f := queue[0]
        queue = drop(queue, 1)
        g := ir_set_code(f, wide_lower(f, vasm_rt_helpers))
        out = g :: out
        table_set(done, ir_name(f), true)
        # the helpers that the code calls and that are not made yet
        need := filter(n -> member(n, vb_helper_names) and not table_has(done, n), vb_calls(ir_code(g)))
        need = reverse(foldl((acc, n) -> if (member(n, acc)) acc else n :: acc, [], need))
        if (need != []) {
            each(n -> table_set(done, n, true), need)
            queue = append(queue, vasm_lower_only(vasm_rt_module, map(intern, need)))
        }
    }
    x86_compile("vasm", reverse(out), append(rt_data(), strs))
}

vasm_build(m, path) := {
    errs := vasm_check(m)
    if (errs != []) panic(f"vasm_build: the module has an error: {arg(errs[0], 2)}")
    o := vasm_object(m)
    img := link([o], "_start", vasm_base_address)
    elf32_write(path, 'x86, arg(img, 0), arg(img, 1))
}
