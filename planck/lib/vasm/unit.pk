# vasm/unit: compiles vasm modules one by one to the form of ir.pk, saves them, and joins them before the stages of a target
# Copyright (C) 2026 nineties
#
# vasm_unit.unit(name, m, imports, word) checks the module m, which may call the functions and use the structs of imports (a list of the
# interfaces of other units), and lowers it with vasm_ir.lower (vasm/ir.pk). The result is a unit:
#   Unit{name, word, iface, fns, gens, strs, syms}
# iface is the structs and the functions of m with the bodies left out (vasm_unit.iface), which other units take as imports.
# fns are the lowered functions of m and gens the functions made for dropping values and for functions as values. word is the
# number of bytes of an address that the code is laid out for. strs are the string literals and syms the names of the symbols that
# the code names. A unit does not depend on the machine except by its word, and it needs no function main.
# vasm_unit.units_merge(units, word) joins units in the order given: the functions of the units, then the functions of gens (each once, in the order
# they are first made), and the data of the strings and the symbols (each once, in the order they are first named). The result is the one that the whole of the units as a
# module gives. The merged form has main and its type, which the start of the program needs.
# A unit is saved as the text of one M-expression (vasm_unit.text), whose lists are written Lst{...} and whose symbols are written by their names.

use("base")
use("list")
use("table")
use("vector")
use("string")
use("backend/ir")
use("vasm/check")
use("vasm/ir")

module vasm_unit {
    vasm_unit_format := 1

    fun vu_copy

    # the structs and the functions of m, without the bodies
    export iface(Module{items}) := map(d -> match d {
        Fn{at, f, rs, ps, ret, _} -> Fn{at, f, rs, ps, ret, []}
      | _ -> d
    }, items)

    # the names of the functions and the structs of the items, with the kind
    vu_names(items) := map(d -> match d {
        Fn{_, f, _, _, _, _} -> Tuple{'fn, f}
      | Struct{_, s, _} -> Tuple{'struct, s}
    }, items)

    # unit(name, m, imports, word) is the unit of the module m, which the code of the width word is made of
    export unit(name, m, imports, word) := {
        errs := vasm_check.check_with(m, imports)
        if (errs != []) panic(f"vasm_unit: {name} has an error: {arg(errs[0], 2)}")
        own := vu_names(arg(m, 0))
        each(n -> if (member(n, own)) panic(f"vasm_unit: {symname(arg(n, 1))} of {name} is also in the imports"), vu_names(imports))
        all := vasm_ir.lower_part(imports, m, none, word)
        nfns := length(filter(d -> head(d) == 'Fn, arg(m, 0)))
        Unit{name, word, iface(m), list.take(all, nfns), list.drop(all, nfns), vasm_ir.strings(), map(symname, vasm_ir.symbols())}
    }

    export name(Unit{n, _, _, _, _, _, _}) := n
    export word(Unit{_, w, _, _, _, _, _}) := w
    export ifaces(Unit{_, _, i, _, _, _, _}) := i

    # === Joining ===
    # the type of main of the interfaces, which stops the program when it is not there once, or takes arguments
    vu_main_type(ifs) := {
        ds := filter(d -> head(d) == 'Fn and arg(d, 1) == 'main, ifs)
        if (ds == []) panic("vasm: the program has no function main")
        d := ds[0]
        if (arg(d, 3) != []) panic("vasm: main takes no arguments")
        arg(d, 4)
    }

    # the names that two units define stop the program
    vu_check_names(units) := {
        seen := table.new()
        each(u -> each(n -> {
            key := Tuple{arg(n, 0), arg(n, 1)}
            if (table.has(seen, key)) panic(f"vasm: {symname(arg(n, 1))} is defined in {table.get(seen, key, none)} and in {name(u)}")
            table.set(seen, key, name(u))
        }, vu_names(ifaces(u))), units)
    }

    # the functions of gens once each, in the order they are first made; a function of the same name in two units must be the same
    vu_gens(units) := {
        seen := table.new()
        out := []
        each(u -> each(f -> {
            old := table.get(seen, ir.name(f), none)
            if (old == none) {
                table.set(seen, ir.name(f), f)
                out = f :: out
            } else if (ir.code(old) != ir.code(f)) panic(f"vasm: {ir.name(f)} is made differently by two units")
        }, arg(u, 4)), units)
        reverse(out)
    }

    vu_unique(xs) := {
        seen := table.new()
        out := []
        each(x -> if (not table.has(seen, x)) {
            table.set(seen, x, true)
            out = x :: out
        }, xs)
        reverse(out)
    }

    # units_merge(units, w) is Merged{fns, strs, syms, main}: the functions, the string literals, the names of the symbols and the type of main
    export units_merge(units, w) := {
        each(u -> if (word(u) != w) panic(f"vasm: {name(u)} is made for the word of {word(u)} bytes, not {w}"), units)
        vu_check_names(units)
        ifs := concat_map(ifaces, units)
        ret := vu_main_type(ifs)
        fns := map(vu_copy, append(concat_map(u -> arg(u, 3), units), vu_gens(units)))
        Merged{fns, vu_unique(concat_map(u -> arg(u, 5), units)), vu_unique(concat_map(u -> arg(u, 6), units)), ret}
    }

    # === Saving ===
    # The text of a value: integers, strings, symbols and M-expressions of them. A list is Lst{...}.
    vu_string_text(s) := {
        out := strbuf.new()
        strbuf.add(out, "\"")
        n := strlen(s)
        i := 0
        while (i < n) {
            c := ord(s, i)
            if (c == 10) strbuf.add(out, "\\n")
            else if (c == 9) strbuf.add(out, "\\t")
            else if (c == 13) strbuf.add(out, "\\r")
            else if (c == 34) strbuf.add(out, "\\\"")
            else if (c == 92) strbuf.add(out, "\\\\")
            else if (c < 32) panic("vasm_unit.text: a string has a control character that is not saved")
            else strbuf.add(out, substr(s, i, i + 1))
            i = i + 1
        }
        strbuf.add(out, "\"")
        strbuf.str(out)
    }

    vu_text(out, v) := {
        t := typeof(v)
        if (t == 'int) strbuf.add(out, string.int_to_str(v))
        else if (t == 'string) strbuf.add(out, vu_string_text(v))
        else if (t == 'symbol) strbuf.add(out, symname(v))
        else if (t == 'mexpr) {
            if (head(v) == 'Cons or head(v) == 'Nil) {
                strbuf.add(out, "Lst{")
                first := true
                each(x -> {
                    if (not first) strbuf.add(out, ", ")
                    first = false
                    vu_text(out, x)
                }, v)
                strbuf.add(out, "}")
            } else {
                strbuf.add(out, symname(head(v)))
                strbuf.add(out, "{")
                i := 0
                while (i < arity(v)) {
                    if (i > 0) strbuf.add(out, ", ")
                    vu_text(out, arg(v, i))
                    i = i + 1
                }
                strbuf.add(out, "}")
            }
        } else panic("vasm_unit.text: a value that is not saved")
    }

    # the function f (ir.fn) as an M-expression: IRFn does not hold tables and vectors there
    vu_fn_value(IRFn{fname, code, meta}) := {
        items := t -> list.sort((a, b) -> arg(a, 0) < arg(b, 0), table.items(t))
        FnV{fname, vector.to_list(code), table.get(meta, 'nv, 0), table.get(meta, 'nl, 0), vector.to_list(table.get(meta, 'slots, none)),
            items(table.get(meta, 'width, none)), items(table.get(meta, 'class, none)), table.get(meta, 'exported, true)}
    }

    vu_fn_of(FnV{fname, code, nv, nl, slots, widths, classes, export_flag}) := {
        meta := table.new()
        table.set(meta, 'nv, nv)
        table.set(meta, 'nl, nl)
        table.set(meta, 'slots, vector.from_list(slots))
        w := table.new()
        each((Tuple{r, x}) -> table.set(w, r, x), widths)
        table.set(meta, 'width, w)
        c := table.new()
        each((Tuple{r, x}) -> table.set(c, r, x), classes)
        table.set(meta, 'class, c)
        table.set(meta, 'exported, export_flag)
        IRFn{fname, vector.from_list(code), meta}
    }

    # the stages of a target rewrite the functions in place, so the merged functions are copies and a unit can be joined again or saved after
    vu_copy(f) = vu_fn_of(vu_fn_value(f))

    # text(u) is the text of the unit u
    export text(Unit{uname, uword, uiface, fns, gens, strs, syms}) := {
        out := strbuf.new()
        vu_text(out, VasmUnit{vasm_unit_format, uname, uword, uiface, map(vu_fn_value, fns), map(vu_fn_value, gens), strs, syms})
        strbuf.add(out, "\n")
        strbuf.str(out)
    }

    # the value of the M-expression e read from a text: Lst{...} is a list
    vu_value(e) := {
        t := typeof(e)
        if (t == 'mexpr) {
            n := arity(e)
            xs := []
            i := n - 1
            while (i >= 0) {
                xs = vu_value(arg(e, i)) :: xs
                i = i - 1
            }
            if (head(e) == 'Lst) xs
            else foldl((acc, x) -> push(acc, x), mexpr(head(e), Tuple{}), xs)
        } else e
    }

    # parse(src) is the unit that text gave the text src; it stops the program for a text of another form
    export parse(src) := {
        r := parse_mexpr(src)
        e := arg(r, 0)
        if (typeof(e) != 'mexpr or head(e) != 'VasmUnit or arity(e) != 8 or string.trim(arg(r, 1)) != "")
            panic("vasm_unit.parse: not a unit")
        if (arg(e, 0) != vasm_unit_format) panic("vasm_unit.parse: the form of the unit is not known")
        v := vu_value(e)
        Unit{arg(v, 1), arg(v, 2), arg(v, 3), map(vu_fn_of, arg(v, 4)), map(vu_fn_of, arg(v, 5)), arg(v, 6), arg(v, 7)}
    }

    export write(path, u) := write_file(path, text(u))

    export read(path) := {
        s := try_read_file(path)
        if (s == none) panic(f"vasm_unit.read: cannot read {path}")
        parse(s)
    }
}
