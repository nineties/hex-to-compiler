# Copyright (C) 2026 nineties

use("base")
use("list")
use("table")
use("vector")
use("string")
use("backend/ir")
use("vasm/check")
use("vasm/ir")

module vasm_unit {
    format := 1

    fun copy
    fun list_text
    fun vu_text

    export iface(Module{items}) := map(d -> match d {
        Fun{at, f, rs, ps, ret, _} -> Fun{at, f, rs, ps, ret, []}
      | _ -> d
    }, items)

    names(items) := map(d -> match d {
        Fun{_, f, _, _, _, _} -> Tuple{'fn, f}
      | Struct{_, s, _} -> Tuple{'struct, s}
    }, items)

    export unit(name, m, imports, word) := {
        errors := vasm_check.check_with(m, imports)
        if (errors != []) panic(f"vasm_unit: {name} has an error: {arg(errors[0], 2)}")
        own := names(arg(m, 0))
        each(n -> if (member(n, own)) panic(f"vasm_unit: {symname(arg(n, 1))} of {name} is also in the imports"), names(imports))
        all := vasm_ir.lower_part(imports, m, none, word)
        nfns := length(filter(d -> head(d) == 'Fun, arg(m, 0)))
        Unit{name, word, iface(m), list.take(all, nfns), list.drop(all, nfns), vasm_ir.strings(), map(symname, vasm_ir.symbols())}
    }

    export name(Unit{n, _, _, _, _, _, _}) := n
    export word(Unit{_, w, _, _, _, _, _}) := w
    export ifaces(Unit{_, _, i, _, _, _, _}) := i

    main_type(ifs) := {
        ds := filter(d -> head(d) == 'Fun and arg(d, 1) == 'main, ifs)
        if (ds == []) panic("vasm: the program has no function main")
        d := ds[0]
        if (arg(d, 3) != []) panic("vasm: main takes no arguments")
        arg(d, 4)
    }

    check_names(units) := {
        seen := table.new()
        each(u -> each(n -> {
            key := Tuple{arg(n, 0), arg(n, 1)}
            if (table.has(seen, key)) panic(f"vasm: {symname(arg(n, 1))} is defined in {table.get(seen, key, none)} and in {name(u)}")
            table.set(seen, key, name(u))
        }, names(ifaces(u))), units)
    }

    vu_gens(units) := {
        seen := table.new()
        out := []
        each(u -> each(f -> {
            old := table.get(seen, ir.name(f), none)
            if (old == none) {
                table.set(seen, ir.name(f), f)
                out = f :: out
            } else if (ir.code(old) != ir.code(f)) panic(f"vasm: {ir.name(f)} is made differently by two units")
        }, arg(u, 4)), units)
        reverse(out)
    }

    unique(xs) := {
        seen := table.new()
        out := []
        each(x -> if (not table.has(seen, x)) {
            table.set(seen, x, true)
            out = x :: out
        }, xs)
        reverse(out)
    }

    export units_merge(units, w) := {
        each(u -> if (word(u) != w) panic(f"vasm: {name(u)} is made for the word of {word(u)} bytes, not {w}"), units)
        check_names(units)
        ifs := concat_map(ifaces, units)
        ret := main_type(ifs)
        funs := map(copy, append(concat_map(u -> arg(u, 3), units), vu_gens(units)))
        Merged{funs, unique(concat_map(u -> arg(u, 5), units)), unique(concat_map(u -> arg(u, 6), units)), ret}
    }

    string_text(s) := {
        out := strbuf.new()
        strbuf.add(out, "\"")
        n := strlen(s)
        i := 0
        while (i < n) {
            c := ord(s, i)
            if (c == 0) strbuf.add(out, "\\0")
            else if (c == 10) strbuf.add(out, "\\n")
            else if (c == 9) strbuf.add(out, "\\t")
            else if (c == 13) strbuf.add(out, "\\r")
            else if (c == 34) strbuf.add(out, "\\\"")
            else if (c == 92) strbuf.add(out, "\\\\")
            else if (c < 32) panic("vasm_unit.text: a string has a control character that is not saved")
            else strbuf.add(out, substr(s, i, i + 1))
            i = i + 1
        }
        strbuf.add(out, "\"")
        strbuf.string(out)
    }

    list_text(out, xs) = {
        n := length(xs)
        if (n <= 64) {
            strbuf.add(out, "List{")
            first := true
            each(x -> {
                if (not first) strbuf.add(out, ", ")
                first = false
                vu_text(out, x)
            }, xs)
            strbuf.add(out, "}")
        } else {
            size := 64
            while (size * 64 < n) size = size * 64
            strbuf.add(out, "Cat{")
            rest := xs
            first := true
            while (rest != []) {
                if (not first) strbuf.add(out, ", ")
                first = false
                list_text(out, list.take(rest, size))
                rest = list.drop(rest, size)
            }
            strbuf.add(out, "}")
        }
    }

    vu_text(out, v) = {
        t := type(v)
        if (t == Int) strbuf.add(out, string.int_to_string(v))
        else if (t == String) strbuf.add(out, string_text(v))
        else if (t == Symbol) strbuf.add(out, symname(v))
        else if (t == Expr) {
            if (head(v) == 'Cons or head(v) == 'Nil) {
                list_text(out, v)
            } else {
                strbuf.add(out, symname(head(v)))
                strbuf.add(out, "{")
                i := 0
                while (i < arity(v)) {
                    if (i > 0) strbuf.add(out, ", ")
                    vu_text(out, arg(v, i))
                    i = i + 1
                }
                strbuf.add(out, "}")
            }
        } else panic("vasm_unit.text: a value that is not saved")
    }

    fun_value(IRFun{file_name, code, meta}) := {
        items := t -> list.sort((a, b) -> arg(a, 0) < arg(b, 0), table.items(t))
        FunV{file_name, vector.to_list(code), table.get(meta, 'nv, 0), table.get(meta, 'nl, 0), vector.to_list(table.get(meta, 'slots, none)),
            items(table.get(meta, 'width, none)), items(table.get(meta, 'class, none)), table.get(meta, 'exported, true)}
    }

    fun_of(FunV{file_name, code, nv, nl, slots, widths, classes, export_flag}) := {
        meta := table.new()
        table.set(meta, 'nv, nv)
        table.set(meta, 'nl, nl)
        table.set(meta, 'slots, vector.from_list(slots))
        w := table.new()
        each((Tuple{r, x}) -> table.set(w, r, x), widths)
        table.set(meta, 'width, w)
        c := table.new()
        each((Tuple{r, x}) -> table.set(c, r, x), classes)
        table.set(meta, 'class, c)
        table.set(meta, 'exported, export_flag)
        IRFun{file_name, vector.from_list(code), meta}
    }

    copy(f) = fun_of(fun_value(f))

    export text(Unit{uname, uword, uiface, funs, gens, strings, symbols}) := {
        out := strbuf.new()
        vu_text(out, VasmUnit{format, uname, uword, uiface, map(fun_value, funs), map(fun_value, gens), strings, symbols})
        strbuf.add(out, "\n")
        strbuf.string(out)
    }

    value(e) := {
        t := type(e)
        if (t == Expr) {
            n := arity(e)
            xs := []
            i := n - 1
            while (i >= 0) {
                xs = value(arg(e, i)) :: xs
                i = i - 1
            }
            if (head(e) == 'List) xs
            else if (head(e) == 'Cat) list.concat(xs)
            else foldl((acc, x) -> push(acc, x), mexpr(head(e), Tuple{}), xs)
        } else e
    }

    export parse(src) := {
        r := parse_mexpr(src)
        e := arg(r, 0)
        if (type(e) != Expr or head(e) != 'VasmUnit or arity(e) != 8 or string.trim(arg(r, 1)) != "")
            panic("vasm_unit.parse: not a unit")
        if (arg(e, 0) != format) panic("vasm_unit.parse: the form of the unit is not known")
        v := value(e)
        Unit{arg(v, 1), arg(v, 2), arg(v, 3), map(fun_of, arg(v, 4)), map(fun_of, arg(v, 5)), arg(v, 6), arg(v, 7)}
    }

    export write(path, u) := write_file(path, text(u))

    export read(path) := {
        s := try_read_file(path)
        if (s == none) panic(f"vasm_unit.read: cannot read {path}")
        parse(s)
    }
}
