_io_copy(b, a, n) := {
    i := 0
    while (i < n) {
        plain_set(b, i, plain_get(a, i))
        i = i + 1
    }
}

_io_grow(a, n, m) := {
    b := plain_array('u8, m)
    _io_copy(b, a, n)
    b
}

_io_slurp(fd) := {
    cap := 4096
    buf := plain_array('u8, cap)
    chunk := plain_array('u8, 4096)
    n := 0
    go := true
    while (go) {
        k := _sys_read(fd, chunk, 4096)
        if (k < 1) go = false
        else {
            while (cap < n + k) {
                buf = _io_grow(buf, n, cap * 2)
                cap = cap * 2
            }
            i := 0
            while (i < k) {
                plain_set(buf, n + i, plain_get(chunk, i))
                i = i + 1
            }
            n = n + k
        }
    }
    _io_grow(buf, n, n)
}

try_read_bytes(path) := {
    fd := _sys_open(path)
    if (fd < 0) none
    else {
        b := _io_slurp(fd)
        _sys_close(fd)
        b
    }
}

read_bytes(path) := {
    b := try_read_bytes(path)
    if (b == none) perform Error{none, _strcat("cannot open ", path)}
    else b
}

try_read_file(path) := {
    b := try_read_bytes(path)
    if (b == none) none
    else bytes_to_string(b)
}

read_file(path) := bytes_to_string(read_bytes(path))

_io_buf := plain_array('u8, 4096)
_io_pos := 0
_io_end := 0
_io_eof := false

_io_fill() := {
    if (_io_eof) false
    else {
        k := _sys_read(0, _io_buf, 4096)
        if (k < 1) {
            _io_eof = true
            false
        } else {
            _io_pos = 0
            _io_end = k
            true
        }
    }
}

read_line() := {
    cap := 128
    line := plain_array('u8, cap)
    n := 0
    got := false
    done := false
    while (done == false) {
        if (_io_pos >= _io_end and _io_fill() == false) done = true
        else {
            got = true
            c := plain_get(_io_buf, _io_pos)
            _io_pos = _io_pos + 1
            if (c == 10) done = true
            else {
                if (n == cap) {
                    line = _io_grow(line, n, cap * 2)
                    cap = cap * 2
                }
                plain_set(line, n, c)
                n = n + 1
            }
        }
    }
    if (got == false) none
    else bytes_to_string(_io_grow(line, n, n))
}

argv() := {
    n := _sys_argc()
    a := array(n - 1)
    i := 1
    while (i < n) {
        array_set(a, i - 1, _sys_argv(i))
        i = i + 1
    }
    a
}
