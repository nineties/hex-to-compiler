# vasm_rt: the runtime that programs of vasm_ir.pk need: the start of the program, the allocator, and 64-bit arithmetic that is a call
# Copyright (C) 2026 nineties
#
# _start calls main and ends the program with its result as the exit status.
# __alloc(n) is the address of a block of n bytes (8-aligned) and __free(p) gives a block back. Blocks come from the program break
# (brk), each with a header of 8 bytes that holds the size, and a freed block of up to 4080 bytes goes to the list of its size and is used again.
# A larger block is not used again.
# The 64-bit operations that 32-bit registers cannot do with a few instructions (a shift by a count in a register, division and remainder)
# are functions of vasm that wide.pk calls; vasm_rt_helpers names them.

use("base")
use("list")
use("table")
use("vector")
use("bytes")
use("ir")
use("vasm")

rt_heap_data := IRData{"__heap", ".bss", 4, vec_from_list([0, 0, 0, 0, 0, 0, 0, 0]), true}
rt_freelists_data := IRData{"__freelists", ".bss", 4, {
    b := bb_new()
    bb_zeros(b, 1024)
    b
}, true}

rt_data() := [rt_heap_data, rt_freelists_data]

# a function from a list of instructions whose registers and labels are named by symbols
rt_fn(name, specs) := {
    f := ir_fn(name)
    regs := table()
    labs := table()
    reg := s -> {
        r := table_get(regs, s, -1)
        if (r < 0) {
            r = ir_vreg(f, 32)
            table_set(regs, s, r)
        }
        r
    }
    lab := s -> {
        l := table_get(labs, s, -1)
        if (l < 0) {
            l = ir_label(f)
            table_set(labs, s, l)
        }
        l
    }
    each(i -> ir_emit(f, ir_map_regs(reg, I{ir_op(i), map(o -> match o {
        L{s} -> L{lab(s)}
      | _ -> o
    }, ir_ops(i))})), specs)
    f
}

rt_alloc_fn() := rt_fn("__alloc", [
    I{'getarg, [D{'n}, K{0}]},
    I{'add, [D{'t}, U{'n}, K{23}]},
    I{'band, [D{'t}, U{'t}, K{-16}]},
    I{'shr, [D{'c}, U{'t}, K{4}]},
    I{'br, [Cc{'geu}, U{'c}, K{256}, L{'bump}, L{'list}]},
    I{'label, [L{'list}]},
    I{'la, [D{'fl}, S{"__freelists", 0}]},
    I{'shl, [D{'c4}, U{'c}, K{2}]},
    I{'add, [D{'slot}, U{'fl}, U{'c4}]},
    I{'ld, [W{'w32}, D{'head}, M{U{'slot}, 0}]},
    I{'br, [Cc{'eq}, U{'head}, K{0}, L{'bump}, L{'pop}]},
    I{'label, [L{'pop}]},
    I{'ld, [W{'w32}, D{'nxt}, M{U{'head}, 0}]},
    I{'st, [W{'w32}, M{U{'slot}, 0}, U{'nxt}]},
    I{'ret, [Us{['head]}]},
    I{'label, [L{'bump}]},
    I{'la, [D{'hp}, S{"__heap", 0}]},
    I{'ld, [W{'w32}, D{'cur}, M{U{'hp}, 0}]},
    I{'br, [Cc{'ne}, U{'cur}, K{0}, L{'have}, L{'init}]},
    I{'label, [L{'init}]},
    I{'li, [D{'z}, K{0}]},
    I{'sys, [K{45}, Us{['z]}, D{'b}]},
    I{'add, [D{'a}, U{'b}, K{15}]},
    I{'band, [D{'cur}, U{'a}, K{-16}]},
    I{'st, [W{'w32}, M{U{'hp}, 4}, U{'b}]},
    I{'jmp, [L{'have}]},
    I{'label, [L{'have}]},
    I{'ld, [W{'w32}, D{'en}, M{U{'hp}, 4}]},
    I{'add, [D{'nc}, U{'cur}, U{'t}]},
    I{'br, [Cc{'leu}, U{'nc}, U{'en}, L{'ok}, L{'grow}]},
    I{'label, [L{'grow}]},
    I{'add, [D{'want}, U{'nc}, K{65536}]},
    I{'sys, [K{45}, Us{['want]}, D{'r}]},
    I{'br, [Cc{'ne}, U{'r}, U{'want}, L{'bad}, L{'set}]},
    I{'label, [L{'bad}]},
    I{'trap, []},
    I{'label, [L{'set}]},
    I{'st, [W{'w32}, M{U{'hp}, 4}, U{'want}]},
    I{'jmp, [L{'ok}]},
    I{'label, [L{'ok}]},
    I{'st, [W{'w32}, M{U{'hp}, 0}, U{'nc}]},
    I{'st, [W{'w32}, M{U{'cur}, 0}, U{'t}]},
    I{'st, [W{'w32}, M{U{'cur}, 4}, K{0}]},
    I{'add, [D{'res}, U{'cur}, K{8}]},
    I{'ret, [Us{['res]}]}])

rt_free_fn() := rt_fn("__free", [
    I{'getarg, [D{'p}, K{0}]},
    I{'br, [Cc{'eq}, U{'p}, K{0}, L{'out}, L{'go}]},
    I{'label, [L{'go}]},
    I{'sub, [D{'h}, U{'p}, K{8}]},
    I{'ld, [W{'w32}, D{'t}, M{U{'h}, 0}]},
    I{'shr, [D{'c}, U{'t}, K{4}]},
    I{'br, [Cc{'geu}, U{'c}, K{256}, L{'out}, L{'put}]},
    I{'label, [L{'put}]},
    I{'la, [D{'fl}, S{"__freelists", 0}]},
    I{'shl, [D{'c4}, U{'c}, K{2}]},
    I{'add, [D{'slot}, U{'fl}, U{'c4}]},
    I{'ld, [W{'w32}, D{'head}, M{U{'slot}, 0}]},
    I{'st, [W{'w32}, M{U{'p}, 0}, U{'head}]},
    I{'st, [W{'w32}, M{U{'slot}, 0}, U{'p}]},
    I{'label, [L{'out}]},
    I{'ret, [Us{[]}]}])

# rt_start_fn(ret) is _start for a main that returns the type ret: its value (0 for no value) is the exit status
rt_start_fn(ret) := {
    f := ir_fn("_start")
    e := i -> ir_emit(f, i)
    st := ir_vreg(f, 32)
    z := ir_vreg(f, 32)
    if (ret == Unit{}) e(I{'li, [D{st}, K{0}]})
    else if (ret == I64{} or ret == U64{}) {
        r := ir_vreg(f, 64)
        e(I{'call, [S{"main", 0}, Us{[]}, Ds{[r]}]})
        e(I{'trunc, [D{st}, U{r}]})
    } else e(I{'call, [S{"main", 0}, Us{[]}, Ds{[st]}]})
    e(I{'sys, [K{1}, Us{[st]}, D{z}]})
    e(I{'trap, []})
    f
}

vasm_rt_helpers := {
    t := table()
    table_set(t, 'shl, "__shl64")
    table_set(t, 'shr, "__shr64")
    table_set(t, 'sar, "__sar64")
    table_set(t, 'divu, "__divu64")
    table_set(t, 'remu, "__remu64")
    table_set(t, 'divs, "__divs64")
    table_set(t, 'rems, "__rems64")
    t
}

# the functions of vasm that the 64-bit operations call
vasm_rt_module := vasm{|
    fn __shl64(x: u64, c: u64) -> u64 {
        var n: u64
        n = c & 63
        while (n > 0) { x = x << 1; n = n - 1 }
        return x
    }
    fn __shr64(x: u64, c: u64) -> u64 {
        var n: u64
        n = c & 63
        while (n > 0) { x = x >> 1; n = n - 1 }
        return x
    }
    fn __sar64(x: i64, c: i64) -> i64 {
        var n: i64
        n = c & 63
        while (n > 0) { x = x >> 1; n = n - 1 }
        return x
    }
    fn __divmod64(a: u64, b: u64, want_rem: bool) -> u64 {
        var q: u64
        var r: u64
        var bit: u64
        var top: u64
        var t: u64
        var go: bool
        var z: u32
        var one: u32
        if (b == 0) { z = 0; one = 1; one = one / z }
        q = 0
        r = 0
        bit = 1
        bit = bit << 63
        while (bit != 0) {
            top = r >> 63
            r = r << 1
            t = a & bit
            if (t != 0) { r = r | 1 }
            go = r >= b
            if (top != 0) { go = true }
            if (go) { r = r - b; q = q | bit }
            bit = bit >> 1
        }
        if (want_rem) { return r }
        return q
    }
    fn __divu64(a: u64, b: u64) -> u64 {
        var q: u64
        q = __divmod64(a, b, false)
        return q
    }
    fn __remu64(a: u64, b: u64) -> u64 {
        var q: u64
        q = __divmod64(a, b, true)
        return q
    }
    fn __divs64(a: i64, b: i64) -> i64 {
        var x: u64
        var y: u64
        var q: u64
        var na: bool
        var nb: bool
        var nq: bool
        var r: i64
        na = a < 0
        nb = b < 0
        nq = na != nb
        x = a as u64
        y = b as u64
        if (na) { x = 0 - x }
        if (nb) { y = 0 - y }
        q = __divmod64(x, y, false)
        if (nq) { q = 0 - q }
        r = q as i64
        return r
    }
    fn __rems64(a: i64, b: i64) -> i64 {
        var x: u64
        var y: u64
        var q: u64
        var na: bool
        var nb: bool
        var r: i64
        na = a < 0
        nb = b < 0
        x = a as u64
        y = b as u64
        if (na) { x = 0 - x }
        if (nb) { y = 0 - y }
        q = __divmod64(x, y, true)
        if (na) { q = 0 - q }
        r = q as i64
        return r
    }
|}
