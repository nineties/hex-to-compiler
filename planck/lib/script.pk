module script {
    export run_file(path) := if (not eval_text.run(read_file(path), path, false, false, msg -> f"error: {eval_text.strip_compiler(msg)}")) exit(1)

    export main() := {
        args := argv()
        if (array_len(args) > 0) run_file(args[0])
        else repl.run()
    }
}
