# symbol: fresh names
# Copyright (C) 2026 nineties

use("string")

module symbol {
    gensym_count := 0

    # gensym("t") is the symbol t1, then t2, t3, ...
    export gensym(prefix) := {
        gensym_count = gensym_count + 1
        intern(_strcat(prefix, string.int_to_str(gensym_count)))
    }

    export reset() := gensym_count = 0
}
