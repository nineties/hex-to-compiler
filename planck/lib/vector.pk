# vector: a growable array. A vector is an array | storage | number of elements |.
# Copyright (C) 2026 nineties

use("base")
use("list")

vec_new() := {
    v := array(2)
    array_set(v, 0, array(4))
    array_set(v, 1, 0)
    v
}

vec_len(v) := array_get(v, 1)

# vec_push(v, x) appends x and returns x. The storage doubles when it is full.
vec_push(v, x) := {
    n := array_get(v, 1)
    d := array_get(v, 0)
    if (n == array_len(d)) {
        nd := array(n * 2)
        i := 0
        while (i < n) {
            array_set(nd, i, array_get(d, i))
            i = i + 1
        }
        array_set(v, 0, nd)
        d = nd
    }
    array_set(d, n, x)
    array_set(v, 1, n + 1)
    x
}

vec_get(v, i) := {
    if (i < 0 or i >= array_get(v, 1)) panic("vec_get: index out of range")
    array_get(array_get(v, 0), i)
}

vec_set(v, i, x) := {
    if (i < 0 or i >= array_get(v, 1)) panic("vec_set: index out of range")
    array_set(array_get(v, 0), i, x)
}

# vec_pop(v) removes and returns the last element
vec_pop(v) := {
    n := array_get(v, 1)
    if (n == 0) panic("vec_pop: empty vector")
    d := array_get(v, 0)
    x := array_get(d, n - 1)
    array_set(d, n - 1, none)
    array_set(v, 1, n - 1)
    x
}

vec_to_list(v) := {
    r := []
    i := array_get(v, 1) - 1
    d := array_get(v, 0)
    while (i >= 0) {
        r = array_get(d, i) :: r
        i = i - 1
    }
    r
}

vec_from_list(xs) := {
    v := vec_new()
    each(x -> vec_push(v, x), xs)
    v
}
