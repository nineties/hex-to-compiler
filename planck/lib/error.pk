# error: errors with positions in a source text
# Copyright (C) 2026 nineties

use("base")
use("string")

module error {
    # line_col(src, pos) is Tuple{line, column} of the byte position pos. Both count from 1.
    export line_col(src, pos) := {
        line := 1
        col := 1
        i := 0
        while (i < pos and i < strlen(src)) {
            if (ord(src, i) == 10) {
                line = line + 1
                col = 1
            } else col = col + 1
            i = i + 1
        }
        Tuple{line, col}
    }

    # line_text(src, line) is the text of the line without the newline
    export line_text(src, line) := {
        i := 0
        l := 1
        while (l < line and i < strlen(src)) {
            if (ord(src, i) == 10) l = l + 1
            i = i + 1
        }
        j := i
        while (j < strlen(src) and ord(src, j) != 10) j = j + 1
        substr(src, i, j)
    }

    # loc_at(file, src, pos) is Loc{file, line, column}
    export loc_at(file, src, pos) := {
        lc := line_col(src, pos)
        Loc{file, arg(lc, 0), arg(lc, 1)}
    }

    # show_loc(Loc{"a.txt", 3, 5}) is "a.txt:3:5"
    export show_loc := (Loc{file, line, col}) -> f"{file}:{line}:{col}"

    # at(loc, msg) raises the effect Error{loc, msg}
    export at(loc, msg) := perform Error{loc, msg}

    # catch(f) is Ok{f()}, or Err{loc, msg} when f() raised Error{loc, msg}
    export catch(f) := handle Ok{f()} with (Error{loc, msg}, k) -> Err{loc, msg}

    # show(src, loc, msg) is "file:line:col: msg", the source line and a ^ under the column
    export show(src, loc, msg) := {
        b := strbuf.new()
        strbuf.add(b, show_loc(loc))
        strbuf.add(b, ": ")
        strbuf.add(b, msg)
        strbuf.add(b, "\n  ")
        strbuf.add(b, line_text(src, arg(loc, 1)))
        strbuf.add(b, "\n  ")
        strbuf.add(b, string.str_repeat(" ", arg(loc, 2) - 1))
        strbuf.add(b, "^")
        strbuf.str(b)
    }
}
