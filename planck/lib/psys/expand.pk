# psys/expand: turns a module of psys into the Module of vasm
# Copyright (C) 2026 nineties
#
# psys_expand(m) is the Module{[...]} of vasm for the module m = PModule{[...]} that psys{| ... |} reads.
# psys_expand_all(m) is Tuple{module, errors} with the errors [VasmErr{kind, Pos{d}, msg}, ...], the first of each function.
# The expansion makes the form that vasm_check.check checks; it does not check ownership, borrows or regions.
#
# - A nested expression becomes one statement for each operation, with a temporary variable of the type of the operation.
# - let x = e declares x with the type of e, or the type written after x.
# - for i in a..b, compound assignments and the short-circuit and / or become while and if.
# - An integer literal beyond -32768 to 32767 is made with << and | from parts of 15 bits, in the integer type that the context gives.
# - An index of an integer type other than i64 is converted with as i64.
# - The last expression of a function that gives a value is its result.

use("base")
use("list")
use("table")
use("string")
use("vasm/check")
use("psys/syntax")

px_fail(at, kind, msg) := perform PsysFail{at, kind, msg}

# === State of the function being expanded ===
# px_sigs: function -> Sig{regions, parameter types, result}; px_structs: struct -> Struct{...}
# px_env: the name in the source -> Tuple{name in vasm, type}; px_live: the names in vasm that are declared
# px_scope: Scope{source name or none, the binding it hides, name in vasm}, the innermost first
# px_out: the statements of the block being made, the last first

px_sigs := table()
px_structs := table()
px_env := table()
px_live := table()
px_used := table()
px_scope := []
px_out := []
px_next := 0
px_ret := Unit{}

fun px_stmt
fun px_rhs
fun px_short
fun px_has_tvar

px_emit(s) := {
    px_out = s :: px_out
}

# a name that the function does not use and is not declared
px_fresh(prefix) := {
    name := none
    while (name == none) {
        s := intern(f"{prefix}{px_next}")
        px_next = px_next + 1
        if (table_get(px_used, s, none) == none and table_get(px_live, s, none) == none) name = s
    }
    name
}

# the statements of a block are made in a scope that ends with the block
px_begin() := {
    tok := Tuple{px_out, length(px_scope)}
    px_out = []
    tok
}

px_end(tok) := {
    body := reverse(px_out)
    while (length(px_scope) > arg(tok, 1)) {
        e := px_scope[0]
        px_scope = drop(px_scope, 1)
        if (arg(e, 0) != none) table_set(px_env, arg(e, 0), arg(e, 1))
        table_set(px_live, arg(e, 2), none)
    }
    px_out = arg(tok, 0)
    body
}

px_block(ss) := {
    tok := px_begin()
    each(px_stmt, ss)
    px_end(tok)
}

# declares a variable of type t and gives its name in vasm. The name in the source is src, or none for a temporary.
# bind is false for a variable that the source name is bound to by the caller.
px_declare(at, src, t, bind) := {
    name := if (src != none and table_get(px_live, src, none) == none) src
        else px_fresh(if (src == none) "t" else f"{symname(src)}_")
    px_emit(Decl{at, name, t})
    table_set(px_live, name, true)
    old := if (src == none or not bind) none else table_get(px_env, src, none)
    if (src != none and bind) table_set(px_env, src, Tuple{name, t})
    px_scope = Scope{if (bind) src else none, old, name} :: px_scope
    name
}

# === Types ===

px_pos(e) := arg(e, 0)

px_known(t) := not (head(t) == 'Lit or head(t) == 'Unk)

# the type of a value that is kept in a variable. A literal has the type that the context gives.
px_keep(at, t, want) := match t {
    Lit{_} -> if (vasm_check.int(want)) want else px_fail(at, 'type, "the type of this value is not known; write the type, as in let x: i32 = ... or e as i32")
  | Unk{msg} -> px_fail(at, 'type, msg)
  | Unit{} -> px_fail(at, 'type, "this call gives no value")
  | _ -> t
}

# the type to give a literal beside a value of type t
px_hint(t, want) := if (vasm_check.int(t)) t else want

px_elem(at, t) := match t {
    Val{} -> Val{}
  | Own{Arr{u}} -> u
  | Ref{_, _, Arr{u}} -> u
  | _ -> px_fail(at, 'type, f"{vasm_check.show_type(t)} is not an array to index")
}

px_pointee(at, t) := match t {
    Own{u} -> u
  | Ref{_, _, u} -> u
  | _ -> px_fail(at, 'type, f"{vasm_check.show_type(t)} is not a pointer")
}

px_struct_of(at, t) := match t {
    Named{s} -> s
  | Own{Named{s}} -> s
  | Ref{_, _, Named{s}} -> s
  | _ -> px_fail(at, 'type, f"{vasm_check.show_type(t)} is not a struct or a pointer to a struct")
}

px_field(at, s, f) := {
    sd := table_get(px_structs, s, none)
    if (sd == none) px_fail(at, 'undefined, f"struct {symname(s)} is not defined")
    fd := find((Field{_, x, _}) -> x == f, arg(sd, 2))
    if (fd == none) px_fail(at, 'type, f"struct {symname(s)} has no field {symname(f)}")
    arg(fd, 2)
}

# === Integer literals beyond the range of vasm ===

# the digits of the text s of an integer literal: Tuple{negative, parts of 15 bits, the least first}
px_parts(s) := {
    n := strlen(s)
    i := 0
    neg := false
    if (ord(s, 0) == 45) {
        neg = true
        i = 1
    }
    base := 10
    if (n > i + 1 and ord(s, i) == 48) {
        c := ord(s, i + 1)
        if (c == 120 or c == 88) base = 16 else if (c == 111 or c == 79) base = 8 else if (c == 98 or c == 66) base = 2
        if (base != 10) i = i + 2
    }
    parts := []
    while (i < n) {
        carry := peg_digit_value(ord(s, i))
        out := []
        each(l -> {
            v := l * base + carry
            out = (v % 32768) :: out
            carry = v / 32768
        }, parts)
        while (carry > 0) {
            out = (carry % 32768) :: out
            carry = carry / 32768
        }
        parts = reverse(out)
        i = i + 1
    }
    Tuple{neg, parts}
}

px_bits_of(n) := {
    k := 0
    while (n > 0) {
        k = k + 1
        n = n / 2
    }
    k
}

# the number of bits of the value whose parts are ps, the least first
px_bits(ps) := if (ps == []) 0 else 15 * (length(ps) - 1) + px_bits_of(last(ps))

# a power of two: the value has one bit, at the position w - 1
px_is_pow(ps, w) := px_bits(ps) == w and (last(ps) == bit_shl(1, (w - 1) % 15)) and all(p -> p == 0, take(ps, length(ps) - 1))

# The literal s of the integer type t, made in a temporary: the parts of 15 bits from the greatest, each after a shift
px_big(at, s, t) := {
    pr := px_parts(s)
    neg := arg(pr, 0)
    ps := arg(pr, 1)
    e := vasm_check.int_entry(t)
    w := arg(e, 2)
    signed := arg(e, 3)
    nb := px_bits(ps)
    ok := if (not neg) (if (signed) nb <= w - 1 else nb <= w) else (signed and (nb <= w - 1 or px_is_pow(ps, w)))
    if (not ok) px_fail(at, 'type, f"{s} is out of the range of {arg(e, 1)}")
    x := px_declare(at, none, t, false)
    parts := reverse(ps)
    px_emit(Assign{at, x, Mov{Imm{at, parts[0]}}})
    each(c -> {
        px_emit(Assign{at, x, Bin{'shl, Reg{at, x}, Imm{at, 15}}})
        px_emit(Assign{at, x, Bin{'bit_or, Reg{at, x}, Imm{at, c}}})
    }, drop(parts, 1))
    if (neg) px_emit(Assign{at, x, Bin{'sub, Imm{at, 0}, Reg{at, x}}})
    Tuple{Reg{at, x}, t}
}

# === Expressions ===
# px_ex(e, want) gives Tuple{operand, type}: the statements that compute e are made before. want is the integer type that the
# context asks for, or none; it gives the type of a literal that is beyond the range of vasm.
# px_rhs(e, want) gives Tuple{right-hand side, type}, to put the value in a variable without a temporary.

px_litlike(e) := head(e) == 'ELit or (head(e) == 'ENeg and head(arg(e, 1)) == 'ELit)

px_simple(e) := member(head(e), ['ELit, 'EBool, 'EStr, 'ESym, 'EVar]) or (head(e) == 'ENeg and head(arg(e, 1)) == 'ELit)

px_var(at, x) := {
    b := table_get(px_env, x, none)
    if (b == none) px_fail(at, 'undefined, f"{symname(x)} is not declared")
    Tuple{Reg{at, arg(b, 0)}, arg(b, 1)}
}

px_lit(at, n, want) := if (typeof(n) == 'int) Tuple{Imm{at, n}, Lit{n}}
    else if (vasm_check.int(want)) px_big(at, arg(n, 0), want)
    else px_fail(at, 'type, f"the type of {arg(n, 0)} is not known; write it as {arg(n, 0)} as i32 or give the type of the variable")

px_simple_ex(e, want) := match e {
    ELit{at, n} -> px_lit(at, n, want)
  | EBool{at, b} -> Tuple{Imm{at, b}, Bool{}}
  | EStr{at, s} -> Tuple{Str{at, s}, Ref{'shr, 'static, Arr{U8{}}}}
  | ESym{at, s} -> Tuple{Sym{at, s}, Val{}}
  | EVar{at, x} -> px_var(at, x)
  | ENeg{at, ELit{_, n}} -> if (typeof(n) == 'int) Tuple{Imm{at, 0 - n}, Lit{0 - n}} else px_lit(at, Big{_strcat("-", arg(n, 0))}, want)
}

px_ex(e, want) := if (px_simple(e)) px_simple_ex(e, want) else {
    at := px_pos(e)
    r := px_rhs(e, want)
    rhs := arg(r, 0)
    if (head(rhs) == 'Mov) Tuple{arg(rhs, 0), arg(r, 1)} else {
        t := px_keep(at, arg(r, 1), want)
        x := px_declare(at, none, t, false)
        px_emit(Assign{at, x, rhs})
        Tuple{Reg{at, x}, t}
    }
}

px_exs(es, want) := map(e -> px_ex(e, want), es)

# the two operands of an operation. A literal is pure, so it is read after the other operand, which gives its type.
px_two(a, b, hint) := if (px_litlike(a) and not px_litlike(b)) {
    vb := px_ex(b, hint)
    va := px_ex(a, px_hint(arg(vb, 1), hint))
    Tuple{va, vb}
} else {
    va := px_ex(a, hint)
    vb := px_ex(b, px_hint(arg(va, 1), hint))
    Tuple{va, vb}
}

px_cmp(op) := member(op, ['lt, 'le, 'gt, 'ge, 'eq, 'ne])

# the index operand: i64
px_index(i) := {
    v := px_ex(i, I64{})
    t := arg(v, 1)
    if (vasm_check.int(t) and t != I64{}) {
        at := vasm_check.pos(arg(v, 0))
        x := px_declare(at, none, I64{}, false)
        px_emit(Assign{at, x, Conv{at, arg(v, 0), I64{}}})
        Reg{at, x}
    } else arg(v, 0)
}

# the array or struct that an index or a field is taken from is a variable
px_base(e) := if (head(e) == 'EVar) px_var(px_pos(e), arg(e, 1))
    else px_fail(px_pos(e), 'type, "an element or a field is taken from a variable; bind the value to a variable with let")

# a place of swap: *p, p[i] or p.f
px_place(e) := match e {
    EDeref{at, p} -> {
        b := px_var(at, p)
        Tuple{Load{at, arg(arg(b, 0), 1)}, px_pointee(at, arg(b, 1))}
    }
  | EIndex{at, a, i} -> {
        b := px_base(a)
        u := px_elem(at, arg(b, 1))
        Tuple{Index{at, arg(arg(b, 0), 1), px_index(i)}, u}
    }
  | EGet{at, a, f} -> {
        b := px_base(a)
        Tuple{Get{at, arg(arg(b, 0), 1), f}, px_field(at, px_struct_of(at, arg(b, 1)), f)}
    }
  | _ -> px_fail(px_pos(e), 'type, "this argument is a place: *p, p[i] or p.f")
}

# the result type of a call with the types ts of the arguments
px_result(at, f, sig, ts, tsub) := {
    rs := arg(sig, 0)
    ret := arg(sig, 2)
    rmap := table()
    each(r -> {
        qs := []
        each(pt -> {
            p := arg(pt, 0)
            t := arg(pt, 1)
            if (head(p) == 'Ref and head(t) == 'Ref and arg(p, 1) == r and not member(arg(t, 1), qs)) qs = arg(t, 1) :: qs
        }, zip(arg(sig, 1), ts))
        if (length(qs) == 1) table_set(rmap, r, qs[0])
    }, rs)
    bad := any(r -> vasm_check.mentions(ret, r) and table_get(rmap, r, none) == none, rs)
    t := vasm_check.subst(ret, rmap, tsub)
    if (bad) Unk{f"the region of the result of {symname(f)} is not known; write the type: let x: T = ..."}
    else if (px_has_tvar(t)) Unk{f"the type of the result of {symname(f)} is not known; write the type: let x: T = ..."}
    else t
}

px_has_tvar(t) := match t {
    TVar{_} -> true
  | Own{u} -> px_has_tvar(u)
  | Arr{u} -> px_has_tvar(u)
  | Ref{_, _, u} -> px_has_tvar(u)
  | _ -> false
}

px_call(at, f, args) := {
    b := table_get(px_env, f, none)
    if (b != none and arg(b, 1) == Val{}) {
        Tuple{Call{at, arg(b, 0), map(v -> arg(v, 0), px_exs(args, none))}, Val{}}
    } else {
        user := table_get(px_sigs, f, none)
        sig := if (user == none) table_get(vasm_check.builtins, f, none) else user
        if (sig == none) px_fail(at, 'undefined, f"function {symname(f)} is not defined")
        ps := arg(sig, 1)
        if (length(ps) != length(args)) px_fail(at, 'type, f"{symname(f)} takes {length(ps)} arguments but {length(args)} are given")
        tsub := table()
        ts := []
        ops := []
        each(pa -> {
            p := arg(pa, 0)
            a := arg(pa, 1)
            v := if (head(p) == 'Place) px_place(a) else {
                want := if (vasm_check.int(p)) p else if (head(p) == 'TVar) table_get(tsub, arg(p, 0), none) else none
                px_ex(a, want)
            }
            q := if (head(p) == 'Place) arg(p, 0) else p
            if (head(q) == 'TVar and px_known(arg(v, 1)) and table_get(tsub, arg(q, 0), none) == none) table_set(tsub, arg(q, 0), arg(v, 1))
            ts = append(ts, [arg(v, 1)])
            ops = append(ops, [arg(v, 0)])
        }, zip(ps, args))
        Tuple{Call{at, f, ops}, px_result(at, f, sig, ts, tsub)}
    }
}

px_rhs(e, want) := if (px_simple(e)) {
    v := px_simple_ex(e, want)
    Tuple{Mov{arg(v, 0)}, arg(v, 1)}
} else match e {
    EBin{at, op, a, b} -> {
        hint := if (px_cmp(op)) none else want
        two := px_two(a, b, hint)
        va := arg(two, 0)
        vb := arg(two, 1)
        ta := arg(va, 1)
        tb := arg(vb, 1)
        t := if (px_cmp(op)) Bool{} else if (head(ta) == 'Lit) (if (head(tb) == 'Lit) Lit{none} else tb) else ta
        Tuple{Bin{op, arg(va, 0), arg(vb, 0)}, t}
    }
  | ENeg{at, a} -> {
        v := px_ex(a, want)
        Tuple{Bin{'sub, Imm{at, 0}, arg(v, 0)}, if (head(arg(v, 1)) == 'Lit) Lit{none} else arg(v, 1)}
    }
  | ENot{at, a} -> {
        v := px_ex(a, Bool{})
        Tuple{Bin{'eq, arg(v, 0), Imm{at, false}}, Bool{}}
    }
  | EAnd{at, a, b} -> px_short(at, a, b, true)
  | EOr{at, a, b} -> px_short(at, a, b, false)
  | ECast{at, a, t} -> {
        v := px_ex(a, if (vasm_check.int(t)) t else none)
        # a literal has the type at once
        if (px_litlike(a) and vasm_check.int(t)) Tuple{Mov{arg(v, 0)}, t} else Tuple{Conv{at, arg(v, 0), t}, t}
    }
  | EDeref{at, p} -> {
        b := px_var(at, p)
        Tuple{Load{at, arg(arg(b, 0), 1)}, px_pointee(at, arg(b, 1))}
    }
  | EIndex{at, a, i} -> {
        b := px_base(a)
        u := px_elem(at, arg(b, 1))
        Tuple{Index{at, arg(arg(b, 0), 1), px_index(i)}, u}
    }
  | EGet{at, a, f} -> {
        b := px_base(a)
        Tuple{Get{at, arg(arg(b, 0), 1), f}, px_field(at, px_struct_of(at, arg(b, 1)), f)}
    }
  | ECall{at, f, args} -> px_call(at, f, args)
  | EMake{at, s, inits} -> {
        is := map((PInit{iat, f, a}) -> {
            ft := px_field(iat, s, f)
            v := px_ex(a, if (vasm_check.int(ft)) ft else none)
            Init{iat, f, arg(v, 0)}
        }, inits)
        Tuple{Make{at, s, is}, Named{s}}
    }
  | EBorrow{at, k, r, y} -> {
        b := px_var(at, y)
        t := arg(b, 1)
        Tuple{Borrow{at, k, r, arg(arg(b, 0), 1)}, if (head(t) == 'Own) Ref{k, r, arg(t, 0)} else Unk{f"{symname(y)} is not own, and only an own value is borrowed"}}
    }
  | ECon{at, h, args} -> Tuple{Con{at, h, map(v -> arg(v, 0), px_exs(args, none))}, Val{}}
  | EClo{at, f, args} -> Tuple{Clo{at, f, map(v -> arg(v, 0), px_exs(args, none))}, Val{}}
}

# a and b (and is true) or a or b: b is computed only when a does not decide the value
px_short(at, a, b, is_and) := {
    va := px_ex(a, Bool{})
    x := px_declare(at, none, Bool{}, false)
    px_emit(Assign{at, x, Mov{arg(va, 0)}})
    tok := px_begin()
    vb := px_ex(b, Bool{})
    px_emit(Assign{at, x, Mov{arg(vb, 0)}})
    body := px_end(tok)
    cond := if (is_and) Mov{Reg{at, x}} else Bin{'eq, Reg{at, x}, Imm{at, false}}
    px_emit(IfS{at, cond, body, []})
    Tuple{Mov{Reg{at, x}}, Bool{}}
}

# the condition of if and while
px_cond(e) := match e {
    EBin{at, op, a, b} -> if (px_cmp(op)) {
        two := px_two(a, b, none)
        Bin{op, arg(arg(two, 0), 0), arg(arg(two, 1), 0)}
    } else Mov{arg(px_ex(e, Bool{}), 0)}
  | _ -> Mov{arg(px_ex(e, Bool{}), 0)}
}

# === Statements ===

# the type of a place that is assigned
px_target_type(tg) := match tg {
    EVar{at, x} -> arg(px_var(at, x), 1)
  | EDeref{at, p} -> px_pointee(at, arg(px_var(at, p), 1))
  | EIndex{at, a, _} -> px_elem(at, arg(px_base(a), 1))
  | EGet{at, a, f} -> px_field(at, px_struct_of(at, arg(px_base(a), 1)), f)
  | _ -> px_fail(px_pos(tg), 'type, "the left of = is a variable, *p, p[i] or p.f")
}

px_set(at, tg, op, e) := {
    ty := px_target_type(tg)
    want := if (vasm_check.int(ty)) ty else none
    match tg {
        EVar{vat, x} -> {
            b := px_var(vat, x)
            vn := arg(arg(b, 0), 1)
            if (op == none) {
                r := px_rhs(e, want)
                px_emit(Assign{at, vn, arg(r, 0)})
            } else {
                v := px_ex(e, want)
                px_emit(Assign{at, vn, Bin{op, Reg{vat, vn}, arg(v, 0)}})
            }
        }
      | _ -> {
            v := px_ex(e, want)
            val := arg(v, 0)
            # the place and the value that is there now
            kind := head(tg)
            pn := arg(arg(px_var(px_pos(tg), if (kind == 'EDeref) arg(tg, 1) else arg(arg(tg, 1), 1)), 0), 1)
            idx := if (kind == 'EIndex) px_index(arg(tg, 2)) else none
            val2 := if (op == none) val else {
                cur := px_declare(at, none, ty, false)
                read := if (kind == 'EDeref) Load{at, pn} else if (kind == 'EIndex) Index{at, pn, idx} else Get{at, pn, arg(tg, 2)}
                px_emit(Assign{at, cur, read})
                px_emit(Assign{at, cur, Bin{op, Reg{at, cur}, val}})
                Reg{at, cur}
            }
            px_emit(if (kind == 'EDeref) Store{at, pn, val2} else if (kind == 'EIndex) IStore{at, pn, idx, val2} else FStore{at, pn, arg(tg, 2), val2})
        }
    }
}

px_while(at, c, body) := {
    saved := px_out
    px_out = []
    cond := px_cond(c)
    pre := px_out
    px_out = saved
    if (pre == []) {
        b := px_block(body)
        px_emit(WhileS{at, cond, b})
    } else {
        # the condition is computed before the loop and at the end of each round
        px_out = append(pre, px_out)
        flag := px_declare(at, none, Bool{}, false)
        px_emit(Assign{at, flag, cond})
        b := px_block(append(body, [SRecheck{at, flag, c}]))
        px_emit(WhileS{at, Mov{Reg{at, flag}}, b})
    }
}

px_for(at, i, lo, hi, body) := {
    vl := px_ex(lo, none)
    vh := px_ex(hi, px_hint(arg(vl, 1), none))
    tl := arg(vl, 1)
    th := arg(vh, 1)
    ty := if (px_known(tl) and head(tl) != 'Lit) tl else if (px_known(th) and head(th) != 'Lit) th
        else px_fail(at, 'type, "the type of the loop variable is not known; write one bound with its type, as in 0 as i64..n")
    # the end is read once, before the loop
    h := if (head(hi) == 'EVar) {
        x := px_declare(at, none, ty, false)
        px_emit(Assign{at, x, Mov{arg(vh, 0)}})
        Reg{at, x}
    } else arg(vh, 0)
    iv := px_declare(at, i, ty, false)
    old := table_get(px_env, i, none)
    table_set(px_env, i, Tuple{iv, ty})
    px_emit(Assign{at, iv, Mov{arg(vl, 0)}})
    b := px_block(append(body, [SRaw{Assign{at, iv, Bin{'add, Reg{at, iv}, Imm{at, 1}}}}]))
    px_emit(WhileS{at, Bin{'lt, Reg{at, iv}, h}, b})
    table_set(px_env, i, old)
}

px_stmt(s) := match s {
    SLet{at, x, t, e} -> {
        r := px_rhs(e, t)
        ty := if (t != none) t else px_keep(at, arg(r, 1), none)
        name := px_declare(at, x, ty, true)
        px_emit(Assign{at, name, arg(r, 0)})
    }
  | SVar{at, x, t} -> px_declare(at, x, t, true)
  | SIf{at, c, a, b} -> {
        cond := px_cond(c)
        ba := px_block(a)
        bb := px_block(b)
        px_emit(IfS{at, cond, ba, bb})
    }
  | SWhile{at, c, body} -> px_while(at, c, body)
  | SFor{at, i, lo, hi, body} -> px_for(at, i, lo, hi, body)
  | SRegion{at, r, body} -> {
        b := px_block(body)
        px_emit(RegionS{at, r, b})
    }
  | SRet{at, e} -> if (e == none) px_emit(Ret{at, none}) else {
        v := px_ex(e, if (vasm_check.int(px_ret)) px_ret else none)
        px_emit(Ret{at, arg(v, 0)})
    }
  | SSet{at, tg, op, e} -> px_set(at, tg, op, e)
  | SExpr{at, e} -> match e {
        ECall{cat, f, args} -> {
            r := px_call(cat, f, args)
            px_emit(CallS{cat, arg(arg(r, 0), 1), arg(arg(r, 0), 2)})
        }
      | _ -> px_fail(at, 'type, "a statement that is an expression is a call, or the result at the end of a function")
    }
  | SRecheck{at, flag, c} -> {
        cond := px_cond(c)
        px_emit(Assign{at, flag, cond})
    }
  | SRaw{st} -> px_emit(st)
}

# === Functions and modules ===

# the names that the statements declare
px_collect(ss) := each(s -> match s {
    SLet{_, x, _, _} -> table_set(px_used, x, true)
  | SVar{_, x, _} -> table_set(px_used, x, true)
  | SIf{_, _, a, b} -> {
        px_collect(a)
        px_collect(b)
    }
  | SWhile{_, _, a} -> px_collect(a)
  | SFor{_, i, _, _, a} -> {
        table_set(px_used, i, true)
        px_collect(a)
    }
  | SRegion{_, _, a} -> px_collect(a)
  | _ -> none
}, ss)

# the last expression of a function that gives a value is the result
px_tail(ret, body) := if (ret != Unit{} and body != [] and head(last(body)) == 'SExpr) {
    s := last(body)
    append(take(body, length(body) - 1), [SRet{arg(s, 0), arg(s, 1)}])
} else body

px_fn(d) := match d {
    PFn{at, f, rs, ps, ret, body} -> {
        px_env = table()
        px_live = table()
        px_used = table()
        px_scope = []
        px_out = []
        px_next = 0
        px_ret = ret
        each((Param{_, x, t}) -> {
            table_set(px_used, x, true)
            table_set(px_live, x, true)
            table_set(px_env, x, Tuple{x, t})
        }, ps)
        px_collect(body)
        Fn{at, f, rs, ps, ret, px_block(px_tail(ret, body))}
    }
}

psys_expand_all(m) := {
    items := arg(m, 0)
    px_sigs = table()
    px_structs = table()
    each(d -> match d {
        PFn{_, f, rs, ps, ret, _} -> table_set(px_sigs, f, Sig{rs, map(p -> arg(p, 2), ps), ret})
      | Struct{_, s, _} -> if (table_get(px_structs, s, none) == none) table_set(px_structs, s, d)
    }, items)
    errs := []
    out := []
    each(d -> match d {
        Struct{_, _, _} -> {
            out = d :: out
        }
      | PFn{_, _, _, _, _, _} -> {
            r := handle {
                px_fn(d)
            } with (PsysFail{at, kind, msg}, k) -> VasmErr{kind, at, msg}
            if (head(r) == 'VasmErr) errs = r :: errs else out = r :: out
        }
    }, items)
    Tuple{Module{reverse(out)}, reverse(errs)}
}

psys_expand(m) := {
    r := psys_expand_all(m)
    if (arg(r, 1) != []) panic(f"psys_expand: {arg(arg(r, 1)[0], 2)}")
    arg(r, 0)
}

# the errors of psys_expand_all with the positions in the file: [VasmErr{kind, Loc{file, line, column}, msg}, ...]
psys_errors(file, errs) := {
    src := read_file(file)
    n := strlen(src)
    map((VasmErr{kind, Pos{d}, msg}) -> VasmErr{kind, loc_at(file, src, n - d), msg}, errs)
}
