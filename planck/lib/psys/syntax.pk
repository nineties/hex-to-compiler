# psys/syntax: the syntax of psys, the systems language of planck
# Copyright (C) 2026 nineties
#
# psys{| struct ... fn ... |} reads structs and functions of the language and is PModule{[Struct{...}, PFn{...}, ...]}.
# The types, the structs and the parameters are those of vasm (vasm/check). The bodies are written with nested expressions,
# let, for, compound assignments, the short-circuit and / or and integer literals of any size.
# psys_expand.expand (psys/expand) turns the tree into the Module of vasm.

use("list")
use("vasm/check")

psys_kw ::= (vasm_kw | 'let | 'for | 'in | 'and | 'or | 'not)
psys_name ::= !psys_kw x:ident { x }

# === Expressions ===
# precedence, loosest first: or, and, == != < <= > >=, |, ^, &, << >>, + -, * / %, as, unary - not * &, postfix [] . ()
# A binary * is on the same line as its left operand, so that a statement *p = v on the next line is not a multiplication.

psys_expr ::= psys_or

psys_or ::= a:psys_or at:vasm_here 'or b:psys_and { EOr{at, a, b} } | psys_and
psys_and ::= a:psys_and at:vasm_here 'and b:psys_cmp { EAnd{at, a, b} } | psys_cmp

psys_cmpop ::= "==" { 'eq } | "!=" { 'ne } | "<=" { 'le } | ">=" { 'ge } | "<" { 'lt } | ">" { 'gt }
psys_cmp ::= a:psys_cmp at:vasm_here op:psys_cmpop b:psys_bor { EBin{at, op, a, b} } | psys_bor

psys_bor ::= a:psys_bor at:vasm_here "|" b:psys_bxor { EBin{at, 'bit_or, a, b} } | psys_bxor
psys_bxor ::= a:psys_bxor at:vasm_here "^" b:psys_band { EBin{at, 'bit_xor, a, b} } | psys_band
psys_band ::= a:psys_band at:vasm_here "&" b:psys_shift { EBin{at, 'bit_and, a, b} } | psys_shift

psys_shiftop ::= "<<" { 'shl } | ">>" { 'shr }
psys_shift ::= a:psys_shift at:vasm_here op:psys_shiftop b:psys_add { EBin{at, op, a, b} } | psys_add

psys_addop ::= "+" { 'add } | "-" { 'sub }
psys_add ::= a:psys_add at:vasm_here op:psys_addop b:psys_mul { EBin{at, op, a, b} } | psys_mul

psys_mulop ::= "*" { 'mul } | "/" { 'div } | "%" { 'rem }
psys_mul ::= a:psys_mul same at:vasm_here op:psys_mulop b:psys_cast { EBin{at, op, a, b} } | psys_cast

psys_cast ::= a:psys_cast at:vasm_here 'as t:vasm_type { ECast{at, a, t} } | psys_unary

psys_unary ::= at:vasm_here n:vasm_int_lit { ELit{at, n} }
    | at:vasm_here "-" e:psys_unary { ENeg{at, e} }
    | at:vasm_here 'not e:psys_unary { ENot{at, e} }
    | at:vasm_here "*" p:psys_name { EDeref{at, p} }
    | at:vasm_here "&" 'mut r:psys_name y:psys_name { EBorrow{at, 'mut, r, y} }
    | at:vasm_here "&" r:psys_name y:psys_name { EBorrow{at, 'shr, r, y} }
    | psys_post

psys_post ::= e:psys_post at:vasm_here "[" i:psys_expr "]" { EIndex{at, e, i} }
    | e:psys_post at:vasm_here "." f:psys_name { EGet{at, e, f} }
    | psys_primary

psys_more_arg ::= "," a:psys_expr { a }
psys_args ::= a:psys_expr r:psys_more_arg* { a :: vasm_tlist(r) }

# a struct value S{f: e, ...} has a field first, so that S { starts the block of if, while or for in the other cases
psys_init ::= at:vasm_here f:psys_name ":" e:psys_expr { PInit{at, f, e} }
psys_more_init ::= vasm_fsep i:psys_init { i }
psys_inits ::= i:psys_init r:psys_more_init* { i :: vasm_tlist(r) }

psys_primary ::= at:vasm_here 'true { EBool{at, true} }
    | at:vasm_here 'false { EBool{at, false} }
    | at:vasm_here s:string { EStr{at, s} }
    | at:vasm_here "'" s:ident { ESym{at, s} }
    | at:vasm_here 'val h:ident "(" args:psys_args? ")" { ECon{at, h, vasm_opt_list(args)} }
    | at:vasm_here 'fn f:psys_name "(" args:psys_args? ")" { EClo{at, f, vasm_opt_list(args)} }
    | at:vasm_here f:psys_name "(" args:psys_args? ")" { ECall{at, f, vasm_opt_list(args)} }
    | at:vasm_here s:psys_name "{" &(psys_name ":") is:psys_inits ","? "}" { EMake{at, s, is} }
    | at:vasm_here x:psys_name { EVar{at, x} }
    | "(" e:psys_expr ")" { e }

# === Statements ===

psys_asgop ::= "<<=" { 'shl } | ">>=" { 'shr } | "+=" { 'add } | "-=" { 'sub } | "*=" { 'mul } | "/=" { 'div } | "%=" { 'rem }
    | "&=" { 'bit_and } | "|=" { 'bit_or } | "^=" { 'bit_xor } | "=" !"=" { none }

psys_ann ::= ":" t:vasm_type { t }

psys_else ::= 'else s:psys_if { [s] } | 'else b:psys_block { b }
psys_if ::= at:vasm_here 'if c:psys_expr a:psys_block b:psys_else? { SIf{at, c, a, vasm_opt_list(b)} }

psys_stmt ::= at:vasm_here 'let x:psys_name t:psys_ann? "=" e:psys_expr { SLet{at, x, if (arity(t) == 0) none else arg(t, 0), e} }
    | at:vasm_here 'var x:psys_name ":" t:vasm_type { SVar{at, x, t} }
    | psys_if
    | at:vasm_here 'while c:psys_expr a:psys_block { SWhile{at, c, a} }
    | at:vasm_here 'for i:psys_name 'in lo:psys_or ".." hi:psys_or a:psys_block { SFor{at, i, lo, hi, a} }
    | at:vasm_here 'region r:psys_name a:psys_block { SRegion{at, r, a} }
    | at:vasm_here 'return same e:psys_expr { SRet{at, e} }
    | at:vasm_here 'return { SRet{at, none} }
    | at:vasm_here t:psys_expr op:psys_asgop e:psys_expr { SSet{at, t, op, e} }
    | at:vasm_here e:psys_expr { SExpr{at, e} }

psys_more_stmt ::= vasm_sep s:psys_stmt { s }
psys_stmts ::= s:psys_stmt r:psys_more_stmt* { s :: vasm_tlist(r) }
psys_block ::= "{" ss:psys_stmts? ";"? "}" { vasm_opt_list(ss) }

# === Items ===

psys_fn ::= at:vasm_here 'fn f:psys_name rs:vasm_rparams? "(" ps:vasm_params? ")" rt:vasm_ret? body:psys_block { PFn{at, f, vasm_opt_list(rs), vasm_opt_list(ps), if (arity(rt) == 0) Unit{} else arg(rt, 0), body} }

psys_item ::= vasm_struct | psys_fn
psys ::= fs:psys_item* { PModule{vasm_tlist(fs)} }
