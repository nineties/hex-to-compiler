# link: joins relocatable objects (object.pk) into the segments of an executable (elf.pk)
# Copyright (C) 2026 nineties
#
# Sections of the same name are joined in the order of the objects. The sections .text and .rodata make the first segment,
# which is read and executed and holds the headers of the file in front, and .data and .bss make the second, which is read and written.
# link(objects, entry, base, header) is Image{entry, segs, symbols}: the address of the symbol entry, the segments of elf.pk, and a table from
# the global symbols to their addresses. base is the address where the file is loaded and header the size of the headers of the file for
# two segments (elf.header_size(2)). A symbol that is used and not defined, or defined twice as global, stops the program.

use("base")
use("list")
use("table")
use("vector")
use("bytes")
use("backend/object")
use("backend/elf")

module linker {

align(n, a) := (n + a - 1) / a * a

first := [".text", ".rodata"]
second := [".data", ".bss"]

# the position of each piece: a table from Tuple{object index, section name} to its offset in the joined section,
# and the joined sections: a table from the name to Tuple{buffer, alignment}
link_join(objects, names, joined, pieces) := each(name -> {
    out := bytes.new()
    al := 1
    k := 0
    each(o -> {
        s := table.get(arg(o, 1), name, none)
        if (s != none) {
            a := arg(s, 2)
            if (a > al) al = a
            bytes.align(out, a)
            table.set(pieces, Tuple{k, name}, bytes.len(out))
            bytes.append(out, object.buf(s))
        }
        k = k + 1
    }, objects)
    table.set(joined, name, Tuple{out, al})
}, names)

export link(objects, entry, base, header) := {
    each(o -> each(s -> if (not member(arg(s, 0), append(first, second))) panic(f"link: the section {arg(s, 0)} of {object.name(o)} is not supported"), object.sections(o)), objects)
    joined := table.new()
    pieces := table.new()
    link_join(objects, append(first, second), joined, pieces)
    # addresses of the joined sections
    addr := table.new()
    cur := base + header
    each(n -> {
        j := table.get(joined, n, none)
        cur = align(cur, arg(j, 1))
        table.set(addr, n, cur)
        cur = cur + bytes.len(arg(j, 0))
    }, first)
    end0 := cur
    # the second segment starts in the file where the first ends, and in memory one page after that
    off1 := align(end0 - base, 16)
    cur = base + off1 + 4096
    each(n -> {
        j := table.get(joined, n, none)
        cur = align(cur, arg(j, 1))
        table.set(addr, n, cur)
        cur = cur + bytes.len(arg(j, 0))
    }, second)
    end1 := cur
    # symbols
    globals := table.new()
    locals := array(length(objects))
    k := 0
    each(o -> {
        loc := table.new()
        array_set(locals, k, loc)
        each((Symbol{name, section, off, global}) -> {
            a := table.get(addr, section, -1) + table.get(pieces, Tuple{k, section}, 0) + off
            if (table.get(addr, section, -1) < 0) panic(f"link: {name} is in the section {section}, which is not supported")
            if (global) {
                if (table.has(globals, name)) panic(f"link: {name} is defined twice")
                table.set(globals, name, a)
            } else table.set(loc, name, a)
        }, object.symbols(o))
        k = k + 1
    }, objects)
    # relocations
    k = 0
    each(o -> {
        each((Rel{section, off, kind, symbol, addend}) -> {
            s := table.get(array_get(locals, k), symbol, table.get(globals, symbol, none))
            if (s == none) panic(f"link: {symbol} is not defined (used in {object.name(o)})")
            at := table.get(pieces, Tuple{k, section}, 0) + off
            place := table.get(addr, section, 0) + at
            v := match kind {
                'Abs32 -> s + addend
              | 'Pc32 -> s + addend - place
              | _ -> panic(f"link: unknown kind of relocation {kind}")
            }
            bytes.set_u32(arg(table.get(joined, section, none), 0), at, v)
        }, object.relocs(o))
        k = k + 1
    }, objects)
    e := table.get(globals, entry, none)
    if (e == none) panic(f"link: the entry {entry} is not defined")
    # segments
    seg0 := bytes.new()
    bytes.zeros(seg0, header)
    each(n -> {
        j := table.get(joined, n, none)
        bytes.zeros(seg0, table.get(addr, n, 0) - base - bytes.len(seg0))
        bytes.append(seg0, arg(j, 0))
    }, first)
    seg1 := bytes.new()
    each(n -> {
        j := table.get(joined, n, none)
        if (n == ".data") {
            bytes.zeros(seg1, table.get(addr, n, 0) - (base + off1 + 4096) - bytes.len(seg1))
            bytes.append(seg1, arg(j, 0))
        }
    }, second)
    memsz1 := end1 - (base + off1 + 4096)
    segs := [Seg{base, 0, seg0, bytes.len(seg0), 5}]
    if (memsz1 > 0) segs = append(segs, [Seg{base + off1 + 4096, off1, seg1, memsz1, 6}])
    Image{e, segs, globals}
}

}
