# link: joins relocatable objects (obj.pk) into the segments of an executable (elf.pk)
# Copyright (C) 2026 nineties
#
# Sections of the same name are joined in the order of the objects. The sections .text and .rodata make the first segment,
# which is read and executed and holds the headers of the file in front, and .data and .bss make the second, which is read and written.
# link(objs, entry, base, hdr) is Image{entry, segs, syms}: the address of the symbol entry, the segments of elf.pk, and a table from
# the global symbols to their addresses. base is the address where the file is loaded and hdr the size of the headers of the file for
# two segments (elf32_hdr_size(2) or elf64_hdr_size(2)). A symbol that is used and not defined, or defined twice as global, stops the program.

use("base")
use("list")
use("table")
use("vector")
use("bytes")
use("backend/obj")
use("backend/elf")

link_align(n, a) := (n + a - 1) / a * a

link_first := [".text", ".rodata"]
link_second := [".data", ".bss"]

# the position of each piece: a table from Tuple{object index, section name} to its offset in the joined section,
# and the joined sections: a table from the name to Tuple{buffer, alignment}
link_join(objs, names, joined, pieces) := each(name -> {
    out := bb_new()
    al := 1
    k := 0
    each(o -> {
        s := table_get(arg(o, 1), name, none)
        if (s != none) {
            a := arg(s, 2)
            if (a > al) al = a
            bb_align(out, a)
            table_set(pieces, Tuple{k, name}, bb_len(out))
            bb_append(out, obj_buf(s))
        }
        k = k + 1
    }, objs)
    table_set(joined, name, Tuple{out, al})
}, names)

link(objs, entry, base, hdr) := {
    each(o -> each(s -> if (not member(arg(s, 0), append(link_first, link_second))) panic(f"link: the section {arg(s, 0)} of {obj_name(o)} is not supported"), obj_sections(o)), objs)
    joined := table()
    pieces := table()
    link_join(objs, append(link_first, link_second), joined, pieces)
    # addresses of the joined sections
    addr := table()
    cur := base + hdr
    each(n -> {
        j := table_get(joined, n, none)
        cur = link_align(cur, arg(j, 1))
        table_set(addr, n, cur)
        cur = cur + bb_len(arg(j, 0))
    }, link_first)
    end0 := cur
    # the second segment starts in the file where the first ends, and in memory one page after that
    off1 := link_align(end0 - base, 16)
    cur = base + off1 + 4096
    each(n -> {
        j := table_get(joined, n, none)
        cur = link_align(cur, arg(j, 1))
        table_set(addr, n, cur)
        cur = cur + bb_len(arg(j, 0))
    }, link_second)
    end1 := cur
    # symbols
    globals := table()
    locals := array(length(objs))
    k := 0
    each(o -> {
        loc := table()
        array_set(locals, k, loc)
        each((Sym{name, sec, off, global}) -> {
            a := table_get(addr, sec, -1) + table_get(pieces, Tuple{k, sec}, 0) + off
            if (table_get(addr, sec, -1) < 0) panic(f"link: {name} is in the section {sec}, which is not supported")
            if (global) {
                if (table_has(globals, name)) panic(f"link: {name} is defined twice")
                table_set(globals, name, a)
            } else table_set(loc, name, a)
        }, obj_symbols(o))
        k = k + 1
    }, objs)
    # relocations
    k = 0
    each(o -> {
        each((Rel{sec, off, kind, sym, addend}) -> {
            s := table_get(array_get(locals, k), sym, table_get(globals, sym, none))
            if (s == none) panic(f"link: {sym} is not defined (used in {obj_name(o)})")
            at := table_get(pieces, Tuple{k, sec}, 0) + off
            place := table_get(addr, sec, 0) + at
            v := match kind {
                'Abs32 -> s + addend
              | 'Pc32 -> s + addend - place
              | _ -> panic(f"link: unknown kind of relocation {kind}")
            }
            bb_set_u32(arg(table_get(joined, sec, none), 0), at, v)
        }, obj_relocs(o))
        k = k + 1
    }, objs)
    e := table_get(globals, entry, none)
    if (e == none) panic(f"link: the entry {entry} is not defined")
    # segments
    seg0 := bb_new()
    bb_zeros(seg0, hdr)
    each(n -> {
        j := table_get(joined, n, none)
        bb_zeros(seg0, table_get(addr, n, 0) - base - bb_len(seg0))
        bb_append(seg0, arg(j, 0))
    }, link_first)
    seg1 := bb_new()
    each(n -> {
        j := table_get(joined, n, none)
        if (n == ".data") {
            bb_zeros(seg1, table_get(addr, n, 0) - (base + off1 + 4096) - bb_len(seg1))
            bb_append(seg1, arg(j, 0))
        }
    }, link_second)
    memsz1 := end1 - (base + off1 + 4096)
    segs := [Seg{base, 0, seg0, bb_len(seg0), 5}]
    if (memsz1 > 0) segs = append(segs, [Seg{base + off1 + 4096, off1, seg1, memsz1, 6}])
    Image{e, segs, globals}
}
