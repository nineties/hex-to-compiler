# target: the machines that the code generator makes executables for
# Copyright (C) 2026 nineties
#
# A target is Target{name, word, lower, compile, executable}. The stages up to the form of ir.pk know the machine by its word only;
# everything else that depends on one is reached through a target:
#   word                      the number of bytes of an address and of a word of memory that the layout of the code of vasm/ir.pk and vasm/runtime.pk is made for
#   lower(f, helpers)         the function f (ir.fun) rewritten for the registers of the machine; helpers is a table of the functions that
#                             the rewriting calls (runtime.helpers of vasm/runtime.pk)
#   compile(name, funs, datas) the object of the functions of lower and the data (see x64.pk)
#   executable(objects)          the file as a buffer of bytes (see bytes.pk) that joins the objects: the format of the file, the address
#                             where it is loaded and the entry are the machine's
# target.get(name) is the target with the name name. A machine is added by writing its functions and one line of all.

use("base")
use("list")
use("backend/ir")
use("backend/x64")
use("backend/link")
use("backend/elf")

module target {

# === x86-64 (Linux) ===
x64_base := 4194304

# the registers are 64-bit: the functions need no rewriting
x64_lower(f, helpers) := f

x64_executable(objects) := {
    image := linker.link(objects, "_start", x64_base, elf.header_size(2))
    elf.image('x86_64, arg(image, 0), arg(image, 1))
}

# === All targets ===
all := [Target{'x86_64, 8, x64_lower, x64.compile, x64_executable}]

export default := 'x86_64

export get(name) := {
    t := find(t -> arg(t, 0) == name, all)
    if (t == none) panic(f"target.get: no target {symname(name)}")
    t
}

export word(Target{_, word, _, _, _}) := word
export lower(Target{_, _, lower, _, _}, f, helpers) := lower(f, helpers)
export compile(Target{_, _, _, compile, _}, name, funs, datas) := compile(name, funs, datas)
export executable(Target{_, _, _, _, executable}, objects) := executable(objects)

test {
    assert(map(t -> arg(t, 0), all) == ['x86_64], "the targets are x86_64 only")
}

}
