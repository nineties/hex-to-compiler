# elf: writes a 64-bit little-endian ELF executable (elf.image) from loadable segments
# Copyright (C) 2026 nineties
#
# A segment is Seg{vaddr, off, data, memsz, flags}: its bytes are at the file offset off and are loaded at vaddr, and memsz is
# the size in memory (the rest after the bytes is 0). flags is 4 for read, 2 for write and 1 for execute.
# The first segment starts at the file offset 0 and its first elf.hdr_size(n) bytes are the headers: the writer fills them in.
# The file offset of the other segments is congruent to vaddr modulo 4096.

use("base")
use("list")
use("bytes")

module elf {

machines := [Tuple{'x86_64, 62}]

# image(machine, entry, segs) is the file as a buffer of bytes; the first hdr_size(n) bytes of the first segment are the headers
export hdr_size(nsegs) := 64 + 56 * nsegs

export image(machine, entry, segs) := {
    n := length(segs)
    hdr := hdr_size(n)
    if (n == 0) panic("elf.image: no segments")
    s0 := segs[0]
    if (arg(s0, 1) != 0 or bytes.len(arg(s0, 2)) < hdr) panic("elf.image: the first segment must start at the file offset 0 and hold the headers")
    code := find(e -> arg(e, 0) == machine, machines)
    if (code == none) panic("elf.image: unknown machine")
    b := bytes.new()
    # e_ident
    bytes.u8(b, 127)
    bytes.u8(b, 69)
    bytes.u8(b, 76)
    bytes.u8(b, 70)
    bytes.u8(b, 2)
    bytes.u8(b, 1)
    bytes.u8(b, 1)
    bytes.zeros(b, 9)
    bytes.u16(b, 2)
    bytes.u16(b, code[1])
    bytes.u32(b, 1)
    bytes.u64(b, entry)
    bytes.u64(b, 64)
    bytes.u64(b, 0)
    bytes.u32(b, 0)
    bytes.u16(b, 64)
    bytes.u16(b, 56)
    bytes.u16(b, n)
    bytes.u16(b, 64)
    bytes.u16(b, 0)
    bytes.u16(b, 0)
    each((Seg{vaddr, off, data, memsz, flags}) -> {
        if ((vaddr - off) % 4096 != 0) panic("elf.image: vaddr and the file offset of a segment differ modulo the page size")
        bytes.u32(b, 1)
        bytes.u32(b, flags)
        bytes.u64(b, off)
        bytes.u64(b, vaddr)
        bytes.u64(b, vaddr)
        bytes.u64(b, bytes.len(data))
        bytes.u64(b, memsz)
        bytes.u64(b, 4096)
    }, segs)
    each((Seg{_, off, data, _, _}) -> {
        if (off > 0 and bytes.len(b) > off) panic("elf.image: segments overlap in the file")
        bytes.zeros(b, off - bytes.len(b))
        i := if (off == 0) hdr else 0
        while (i < bytes.len(data)) {
            bytes.u8(b, bytes.get(data, i))
            i = i + 1
        }
    }, segs)
    b
}

# write(path, machine, entry, segs) writes the executable file
export write(path, machine, entry, segs) := {
    write_file(path, bytes.to_u8(image(machine, entry, segs)))
    chmod(path, 493)
}

}
