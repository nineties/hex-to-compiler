# x86enc: what the encoders of the x86 family share: the emitter and the condition codes
# Copyright (C) 2026 nineties
#
# An emitter writes the code of functions to a section of an object (obj.pk): Em{obj, sec, buf, labels, fixups}.
# x64enc.pk encodes the instructions of ir.pk with it.

use("base")
use("list")
use("table")
use("vector")
use("bytes")
use("backend/obj")

module x86enc {

# new(o, secname) writes to the section secname of the object o, which is made if it is not there
export new(o, secname) := {
    s := obj.sec(o, secname, 'code, 16)
    Em{o, secname, obj.buf(s), table.new(), vector.new()}
}

export pos(Em{_, _, b, _, _}) := bytes.len(b)
export u8(Em{_, _, b, _, _}, n) := bytes.u8(b, n)
export u32(Em{_, _, b, _, _}, n) := bytes.u32(b, n)

export u8s(em, xs) := each(x -> u8(em, x), xs)

export label(Em{_, _, b, labels, _}, l) := table.set(labels, l, bytes.len(b))

# a 32-bit field that holds the displacement to the label l from the end of the field
export rel32(Em{_, _, b, _, fixups}, l) := {
    vector.push(fixups, Tuple{bytes.len(b), l})
    bytes.u32(b, 0)
}

# finish(em) fills in the displacements to the labels of the function that was written
export finish(Em{_, _, b, labels, fixups}) := {
    each((Tuple{at, l}) -> {
        t := table.get(labels, l, -1)
        if (t < 0) panic(f"x86enc.finish: label L{l} is not in the function")
        bytes.set_u32(b, at, t - (at + 4))
    }, vector.to_list(fixups))
}

# a 32-bit field that is the address of the symbol plus off (kind 'Abs32), or the displacement to it (kind 'Pc32)
export sym(Em{o, sec, b, _, _}, kind, name, off) := {
    obj.reloc(o, sec, bytes.len(b), kind, name, if (kind == 'Pc32) off - 4 else off)
    bytes.u32(b, 0)
}

export fits8(n) := n >= -128 and n <= 127

# the condition codes
cc := [Tuple{'eq, 4}, Tuple{'ne, 5}, Tuple{'lt, 12}, Tuple{'ge, 13}, Tuple{'le, 14}, Tuple{'gt, 15},
           Tuple{'ltu, 2}, Tuple{'geu, 3}, Tuple{'leu, 6}, Tuple{'gtu, 7}]

export cc_code(c) := {
    e := find(e -> arg(e, 0) == c, cc)
    if (e == none) panic(f"x86: unknown condition {c}")
    e[1]
}

}
