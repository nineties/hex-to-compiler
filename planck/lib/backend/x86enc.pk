# x86enc: what the encoders of the x86 family share: the emitter and the condition codes
# Copyright (C) 2026 nineties
#
# An emitter writes the code of functions to a section of an object (obj.pk): Em{obj, sec, buf, labels, fixups}.
# x64enc.pk encodes the instructions of ir.pk with it.

use("base")
use("list")
use("table")
use("vector")
use("bytes")
use("backend/obj")

# em_new(o, secname) writes to the section secname of the object o, which is made if it is not there
em_new(o, secname) := {
    s := obj_sec(o, secname, 'code, 16)
    Em{o, secname, obj_buf(s), table(), vec_new()}
}

em_pos(Em{_, _, b, _, _}) := bb_len(b)
em_u8(Em{_, _, b, _, _}, n) := bb_u8(b, n)
em_u32(Em{_, _, b, _, _}, n) := bb_u32(b, n)

em_bytes(em, xs) := each(x -> em_u8(em, x), xs)

em_label(Em{_, _, b, labels, _}, l) := table_set(labels, l, bb_len(b))

# a 32-bit field that holds the displacement to the label l from the end of the field
em_rel32(Em{_, _, b, _, fixups}, l) := {
    vec_push(fixups, Tuple{bb_len(b), l})
    bb_u32(b, 0)
}

# em_finish(em) fills in the displacements to the labels of the function that was written
em_finish(Em{_, _, b, labels, fixups}) := {
    each((Tuple{at, l}) -> {
        t := table_get(labels, l, -1)
        if (t < 0) panic(f"em_finish: label L{l} is not in the function")
        bb_set_u32(b, at, t - (at + 4))
    }, vec_to_list(fixups))
}

# a 32-bit field that is the address of the symbol plus off (kind 'Abs32), or the displacement to it (kind 'Pc32)
em_sym(Em{o, sec, b, _, _}, kind, name, off) := {
    obj_reloc(o, sec, bb_len(b), kind, name, if (kind == 'Pc32) off - 4 else off)
    bb_u32(b, 0)
}

x86_fits8(n) := n >= -128 and n <= 127

# the condition codes
x86_cc := [Tuple{'eq, 4}, Tuple{'ne, 5}, Tuple{'lt, 12}, Tuple{'ge, 13}, Tuple{'le, 14}, Tuple{'gt, 15},
           Tuple{'ltu, 2}, Tuple{'geu, 3}, Tuple{'leu, 6}, Tuple{'gtu, 7}]

x86_cc_code(c) := {
    e := find(e -> arg(e, 0) == c, x86_cc)
    if (e == none) panic(f"x86: unknown condition {c}")
    e[1]
}
