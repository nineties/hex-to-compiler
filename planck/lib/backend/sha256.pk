# Copyright (C) 2026 nineties

use("base")
use("list")
use("bytes")

module sha256 {

k_text := _strcat(_strcat("428a2f9871374491b5c0fbcfe9b5dba53956c25b59f111f1923f82a4ab1c5ed5d807aa9812835b01243185be550c7dc372be5d7480deb1fe9bdc06a7c19bf174e49b69c1efbe47860fc19dc6240ca1cc2de92c6f4a7484aa5cb0a9dc76f988da983e5152a831c66db00327c8bf597fc7c6e00bf3d5a7914706ca635114292967",
    "27b70a852e1b21384d2c6dfc53380d13650a7354766a0abb81c2c92e92722c85a2bfe8a1a81a664bc24b8b70c76c51a3d192e819d6990624f40e3585106aa07019a4c1161e376c082748774c34b0bcb5391c0cb34ed8aa4a5b9cca4f682e6ff3748f82ee78a5636f84c87814"),
    "8cc7020890befffaa4506cebbef9a3f7c67178f2")
h_text := "6a09e667bb67ae853c6ef372a54ff53a510e527f9b05688c1f83d9ab5be0cd19"

hex_digit(c) := if (c >= 97) c - 87 else c - 48
hex16(s, i) := hex_digit(ord(s, i)) * 4096 + hex_digit(ord(s, i + 1)) * 256 + hex_digit(ord(s, i + 2)) * 16 + hex_digit(ord(s, i + 3))

halves(s, n, half) := {
    a := array(n)
    i := 0
    while (i < n) {
        array_set(a, i, hex16(s, 8 * i + 4 * half))
        i = i + 1
    }
    a
}

kh := halves(k_text, 64, 0)
kl := halves(k_text, 64, 1)

rot_h(h, l, n) := if (n >= 16) rot_h(l, h, n - 16) else if (n == 0) h else bit_and(bit_or(bit_sar(h, n), bit_shl(bit_and(l, bit_shl(1, n) - 1), 16 - n)), 65535)
rot_l(h, l, n) := if (n >= 16) rot_l(l, h, n - 16) else if (n == 0) l else bit_and(bit_or(bit_sar(l, n), bit_shl(bit_and(h, bit_shl(1, n) - 1), 16 - n)), 65535)

shr_h(h, l, n) := if (n >= 16) 0 else bit_sar(h, n)
shr_l(h, l, n) := if (n >= 16) bit_sar(h, n - 16) else bit_or(bit_sar(l, n), bit_shl(bit_and(h, bit_shl(1, n) - 1), 16 - n))

xor3(a, b, c) := bit_xor(bit_xor(a, b), c)

add_to(hh, hl, i, h, l) := {
    lo := array_get(hl, i) + l
    hi := array_get(hh, i) + h + bit_sar(lo, 16)
    array_set(hl, i, bit_and(lo, 65535))
    array_set(hh, i, bit_and(hi, 65535))
}

block(blk, o, hh, hl) := {
    wh := array(64)
    wl := array(64)
    t := 0
    while (t < 16) {
        array_set(wh, t, array_get(blk, o + 4 * t) * 256 + array_get(blk, o + 4 * t + 1))
        array_set(wl, t, array_get(blk, o + 4 * t + 2) * 256 + array_get(blk, o + 4 * t + 3))
        t = t + 1
    }
    while (t < 64) {
        h2 := array_get(wh, t - 2)
        l2 := array_get(wl, t - 2)
        h15 := array_get(wh, t - 15)
        l15 := array_get(wl, t - 15)
        s1h := xor3(rot_h(h2, l2, 17), rot_h(h2, l2, 19), shr_h(h2, l2, 10))
        s1l := xor3(rot_l(h2, l2, 17), rot_l(h2, l2, 19), shr_l(h2, l2, 10))
        s0h := xor3(rot_h(h15, l15, 7), rot_h(h15, l15, 18), shr_h(h15, l15, 3))
        s0l := xor3(rot_l(h15, l15, 7), rot_l(h15, l15, 18), shr_l(h15, l15, 3))
        lo := s1l + array_get(wl, t - 7) + s0l + array_get(wl, t - 16)
        hi := s1h + array_get(wh, t - 7) + s0h + array_get(wh, t - 16) + bit_sar(lo, 16)
        array_set(wh, t, bit_and(hi, 65535))
        array_set(wl, t, bit_and(lo, 65535))
        t = t + 1
    }
    ah := array_get(hh, 0)
    al := array_get(hl, 0)
    bh := array_get(hh, 1)
    bl := array_get(hl, 1)
    ch := array_get(hh, 2)
    cl := array_get(hl, 2)
    dh := array_get(hh, 3)
    dl := array_get(hl, 3)
    eh := array_get(hh, 4)
    el := array_get(hl, 4)
    fh := array_get(hh, 5)
    fl := array_get(hl, 5)
    gh := array_get(hh, 6)
    gl := array_get(hl, 6)
    hh8 := array_get(hh, 7)
    hl8 := array_get(hl, 7)
    t = 0
    while (t < 64) {
        s1h := xor3(rot_h(eh, el, 6), rot_h(eh, el, 11), rot_h(eh, el, 25))
        s1l := xor3(rot_l(eh, el, 6), rot_l(eh, el, 11), rot_l(eh, el, 25))
        chh := bit_xor(bit_and(eh, fh), bit_and(bit_xor(eh, 65535), gh))
        chl := bit_xor(bit_and(el, fl), bit_and(bit_xor(el, 65535), gl))
        lo1 := hl8 + s1l + chl + array_get(kl, t) + array_get(wl, t)
        hi1 := hh8 + s1h + chh + array_get(kh, t) + array_get(wh, t) + bit_sar(lo1, 16)
        t1l := bit_and(lo1, 65535)
        t1h := bit_and(hi1, 65535)
        s0h := xor3(rot_h(ah, al, 2), rot_h(ah, al, 13), rot_h(ah, al, 22))
        s0l := xor3(rot_l(ah, al, 2), rot_l(ah, al, 13), rot_l(ah, al, 22))
        mjh := xor3(bit_and(ah, bh), bit_and(ah, ch), bit_and(bh, ch))
        mjl := xor3(bit_and(al, bl), bit_and(al, cl), bit_and(bl, cl))
        lo2 := s0l + mjl
        hi2 := s0h + mjh + bit_sar(lo2, 16)
        t2l := bit_and(lo2, 65535)
        t2h := bit_and(hi2, 65535)
        hh8 = gh
        hl8 = gl
        gh = fh
        gl = fl
        fh = eh
        fl = el
        lo3 := dl + t1l
        hi3 := dh + t1h + bit_sar(lo3, 16)
        eh = bit_and(hi3, 65535)
        el = bit_and(lo3, 65535)
        dh = ch
        dl = cl
        ch = bh
        cl = bl
        bh = ah
        bl = al
        lo4 := t1l + t2l
        hi4 := t1h + t2h + bit_sar(lo4, 16)
        ah = bit_and(hi4, 65535)
        al = bit_and(lo4, 65535)
        t = t + 1
    }
    add_to(hh, hl, 0, ah, al)
    add_to(hh, hl, 1, bh, bl)
    add_to(hh, hl, 2, ch, cl)
    add_to(hh, hl, 3, dh, dl)
    add_to(hh, hl, 4, eh, el)
    add_to(hh, hl, 5, fh, fl)
    add_to(hh, hl, 6, gh, gl)
    add_to(hh, hl, 7, hh8, hl8)
}

export digest(b, off, n) := {
    hh := halves(h_text, 8, 0)
    hl := halves(h_text, 8, 1)
    full := n / 64
    blk := array(64)
    k := 0
    while (k < full) {
        i := 0
        while (i < 64) {
            array_set(blk, i, bytes.get(b, off + 64 * k + i))
            i = i + 1
        }
        block(blk, 0, hh, hl)
        k = k + 1
    }
    rest := n - 64 * full
    tail_len := if (rest < 56) 64 else 128
    tail := array(tail_len)
    i := 0
    while (i < tail_len) {
        array_set(tail, i, 0)
        i = i + 1
    }
    i = 0
    while (i < rest) {
        array_set(tail, i, bytes.get(b, off + 64 * full + i))
        i = i + 1
    }
    array_set(tail, rest, 128)
    bits_lo := n * 8
    j := 0
    while (j < 4) {
        array_set(tail, tail_len - 1 - j, bit_and(bit_sar(bits_lo, 8 * j), 255))
        j = j + 1
    }
    array_set(tail, tail_len - 5, bit_and(bit_sar(n, 29), 255))
    block(tail, 0, hh, hl)
    if (tail_len == 128) block(tail, 64, hh, hl)
    out := bytes.new()
    w := 0
    while (w < 8) {
        bytes.u8(out, bit_sar(array_get(hh, w), 8))
        bytes.u8(out, array_get(hh, w))
        bytes.u8(out, bit_sar(array_get(hl, w), 8))
        bytes.u8(out, array_get(hl, w))
        w = w + 1
    }
    out
}

test {
    hex(b) := {
        s := ""
        i := 0
        while (i < bytes.len(b)) {
            d := "0123456789abcdef"
            x := bytes.get(b, i)
            s = _strcat(s, _strcat(substr(d, bit_sar(x, 4), bit_sar(x, 4) + 1), substr(d, bit_and(x, 15), bit_and(x, 15) + 1)))
            i = i + 1
        }
        s
    }
    abc := bytes.new()
    bytes.string(abc, "abc")
    assert(hex(digest(abc, 0, 3)) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256 of abc")
    empty := bytes.new()
    assert(hex(digest(empty, 0, 0)) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "sha256 of the empty text")
    two := bytes.new()
    bytes.string(two, "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    assert(hex(digest(two, 0, 56)) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1", "sha256 of 56 bytes")
}

}
