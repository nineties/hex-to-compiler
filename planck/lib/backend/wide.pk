# wide: rewrites 64-bit values of ir.pk as pairs of 32-bit values, for a target whose registers have 32 bits
# Copyright (C) 2026 nineties
#
# A register made by ir_vreg(f, 64) holds a 64-bit value. wide_lower(f, helpers) is the code of f in which every such register r
# is the pair of 32-bit registers r (the low half) and a new one (the high half), and every instruction works on 32-bit values.
# The instructions on 64-bit values are those of ir.pk's machine independent form (see x86.pk) with these additions:
#   zext64 sext64 [D wide, U narrow]   trunc [D narrow, U wide]
#   ld and st with the width w64, which take the memory operand of the low half
# A 64-bit integer operand K{n} is the sign extension of n. A call and ret take 64-bit values in Us and Ds as the low half and then the high half.
# A shift by a count in a register, a division and a remainder call a function: helpers is a table from 'shl 'shr 'sar 'divs 'divu 'rems 'remu
# to the name of a function that takes the two words of the first operand and the two words of the second and gives the two words of the result.
# The function must be defined by the program.

use("base")
use("list")
use("table")
use("backend/ir")

fun wide_one

wide_lower(f, helpers) := {
    out := []
    emit := i -> { out = i :: out }
    his := table()
    each(i -> wide_one(f, helpers, his, emit, i), ir_code(f))
    reverse(out)
}

# the memory operand m moved by n bytes
wide_mem_at(m, n) := match m {
    M{b, d} -> M{b, d + n}
  | MG{s, d} -> MG{s, d + n}
  | MF{k, i, d} -> MF{k, i, d + n}
  | MX{b, x, s, d} -> MX{b, x, s, d + n}
}

wide_one(f, helpers, his, emit, i) := {
    is_wide := r -> ir_width(f, r) == 64
    hi := r -> {
        h := table_get(his, r, -1)
        if (h < 0) {
            h = ir_vreg(f, 32)
            table_set(his, r, h)
        }
        h
    }
    nv := () -> ir_vreg(f, 32)
    # the halves of an operand
    lo_o := o -> o
    hi_o := o -> match o {
        U{r} -> U{hi(r)}
      | K{n} -> K{if (n < 0) -1 else 0}
    }
    lo_r := o -> match o {
        U{r} -> r
      | D{r} -> r
    }
    hi_r := o -> hi(lo_r(o))
    wide_op := o -> match o {
        U{r} -> is_wide(r)
      | D{r} -> is_wide(r)
      | _ -> false
    }
    # a value in a register: a K is made a register
    # a 64-bit operand in registers: a K is made a pair of registers
    widen := o -> match o {
        U{r} -> o
      | K{n} -> {
            t := nv()
            h := nv()
            table_set(his, t, h)
            emit(I{'li, [D{t}, K{n}]})
            emit(I{'li, [D{h}, K{if (n < 0) -1 else 0}]})
            U{t}
        }
    }
    bin := (op, d, a, b) -> emit(I{op, [D{d}, U{a}, b]})
    # d = x as two registers; the results are computed first and then moved, so that d may be an operand
    set2 := (d, l, h) -> {
        emit(I{'mov, [D{lo_r(d)}, U{l}]})
        emit(I{'mov, [D{hi_r(d)}, U{h}]})
    }
    # r = (a < b) as 0 or 1 for the 64-bit a and b; cc is lt or ltu
    less := (cc, a, b) -> {
        hl := nv()
        he := nv()
        ll := nv()
        r := nv()
        emit(I{'cmp, [Cc{cc}, D{hl}, hi_o(a), hi_o(b)]})
        emit(I{'cmp, [Cc{'eq}, D{he}, hi_o(a), hi_o(b)]})
        emit(I{'cmp, [Cc{'ltu}, D{ll}, lo_o(a), lo_o(b)]})
        bin('band, ll, he, U{ll})
        bin('bor, r, hl, U{ll})
        r
    }
    # the 0 or 1 of the comparison cc of the 64-bit a and b
    compare := (cc, a, b) -> {
        if (cc == 'eq or cc == 'ne) {
            x := nv()
            y := nv()
            z := nv()
            r := nv()
            bin('bxor, x, arg(a, 0), lo_o(b))
            bin('bxor, y, hi(arg(a, 0)), hi_o(b))
            bin('bor, z, x, U{y})
            emit(I{'cmp, [Cc{cc}, D{r}, U{z}, K{0}]})
            r
        } else {
            unsigned := member(cc, ['ltu, 'leu, 'gtu, 'geu])
            base := if (unsigned) 'ltu else 'lt
            lt := member(cc, ['lt, 'ltu, 'ge, 'geu])
            wb := widen(b)
            r := if (lt) less(base, a, wb) else less(base, wb, a)
            if (cc == 'le or cc == 'leu or cc == 'ge or cc == 'geu) {
                s := nv()
                bin('bxor, s, r, K{1})
                s
            } else r
        }
    }
    match i {
        I{'label, _} -> emit(i)
      | I{'jmp, _} -> emit(i)
      | I{'trap, _} -> emit(i)
      | I{'li, [D{d}, K{n}]} if is_wide(d) -> {
            emit(I{'li, [D{d}, K{n}]})
            emit(I{'li, [D{hi(d)}, K{if (n < 0) -1 else 0}]})
        }
      | I{'mov, [D{d}, U{s}]} if is_wide(d) -> {
            emit(I{'mov, [D{d}, U{s}]})
            emit(I{'mov, [D{hi(d)}, U{hi(s)}]})
        }
      | I{op, [D{d}, U{a}, b]} if is_wide(d) and member(op, ['band, 'bor, 'bxor]) -> {
            emit(I{op, [D{d}, U{a}, b]})
            emit(I{op, [D{hi(d)}, U{hi(a)}, hi_o(b)]})
        }
      | I{'add, [D{d}, U{a}, b]} if is_wide(d) -> {
            l := nv()
            c := nv()
            h := nv()
            bin('add, l, a, b)
            emit(I{'cmp, [Cc{'ltu}, D{c}, U{l}, U{a}]})
            bin('add, h, hi(a), hi_o(b))
            bin('add, h, h, U{c})
            set2(D{d}, l, h)
        }
      | I{'sub, [D{d}, U{a}, b]} if is_wide(d) -> {
            l := nv()
            c := nv()
            h := nv()
            bin('sub, l, a, b)
            emit(I{'cmp, [Cc{'ltu}, D{c}, U{a}, b]})
            bin('sub, h, hi(a), hi_o(b))
            bin('sub, h, h, U{c})
            set2(D{d}, l, h)
        }
      | I{'mul, [D{d}, U{a}, b]} if is_wide(d) -> {
            l := nv()
            h := nv()
            x := nv()
            y := nv()
            bin('mul, l, a, b)
            bin('mulhu, h, a, b)
            bin('mul, x, a, hi_o(b))
            bin('mul, y, hi(a), b)
            bin('add, h, h, U{x})
            bin('add, h, h, U{y})
            set2(D{d}, l, h)
        }
      | I{'neg, [D{d}, U{a}]} if is_wide(d) -> {
            l := nv()
            z := nv()
            h := nv()
            emit(I{'neg, [D{l}, U{a}]})
            emit(I{'cmp, [Cc{'eq}, D{z}, U{l}, K{0}]})
            emit(I{'not, [D{h}, U{hi(a)}]})
            bin('add, h, h, U{z})
            set2(D{d}, l, h)
        }
      | I{'not, [D{d}, U{a}]} if is_wide(d) -> {
            emit(I{'not, [D{d}, U{a}]})
            emit(I{'not, [D{hi(d)}, U{hi(a)}]})
        }
      | I{op, [D{d}, U{a}, K{n}]} if is_wide(d) and member(op, ['shl, 'shr, 'sar]) -> {
            c := bit_and(n, 63)
            l := nv()
            h := nv()
            if (c == 0) {
                emit(I{'mov, [D{l}, U{a}]})
                emit(I{'mov, [D{h}, U{hi(a)}]})
            } else if (op == 'shl) {
                if (c < 32) {
                    x := nv()
                    y := nv()
                    bin('shl, x, hi(a), K{c})
                    bin('shr, y, a, K{32 - c})
                    bin('bor, h, x, U{y})
                    bin('shl, l, a, K{c})
                } else {
                    bin('shl, h, a, K{c - 32})
                    emit(I{'li, [D{l}, K{0}]})
                }
            } else if (c < 32) {
                x := nv()
                y := nv()
                bin('shr, x, a, K{c})
                bin('shl, y, hi(a), K{32 - c})
                bin('bor, l, x, U{y})
                bin(op, h, hi(a), K{c})
            } else {
                bin(op, l, hi(a), K{c - 32})
                if (op == 'shr) emit(I{'li, [D{h}, K{0}]}) else bin('sar, h, hi(a), K{31})
            }
            set2(D{d}, l, h)
        }
      | I{op, [D{d}, U{a}, b]} if is_wide(d) and member(op, ['shl, 'shr, 'sar, 'divs, 'divu, 'rems, 'remu]) -> {
            l := nv()
            h := nv()
            name := table_get(helpers, op, none)
            if (name == none) panic(f"wide_lower: no function for {symname(op)}")
            wb := widen(b)
            ba := arg(wb, 0)
            emit(I{'call, [S{name, 0}, Us{[a, hi(a), ba, hi(ba)]}, Ds{[l, h]}]})
            set2(D{d}, l, h)
        }
      | I{'cmp, [Cc{c}, D{d}, U{a}, b]} if is_wide(a) -> {
            r := compare(c, U{a}, b)
            emit(I{'mov, [D{d}, U{r}]})
        }
      | I{'br, [Cc{c}, U{a}, b, t, e]} if is_wide(a) -> {
            r := compare(c, U{a}, b)
            emit(I{'br, [Cc{'ne}, U{r}, K{0}, t, e]})
        }
      | I{'ld, [W{'w64}, D{d}, m]} -> {
            l := nv()
            h := nv()
            emit(I{'ld, [W{'w32}, D{l}, m]})
            emit(I{'ld, [W{'w32}, D{h}, wide_mem_at(m, 4)]})
            set2(D{d}, l, h)
        }
      | I{'st, [W{'w64}, m, v]} -> {
            emit(I{'st, [W{'w32}, m, lo_o(v)]})
            emit(I{'st, [W{'w32}, wide_mem_at(m, 4), hi_o(v)]})
        }
      | I{'zext64, [D{d}, U{a}]} -> {
            emit(I{'mov, [D{d}, U{a}]})
            emit(I{'li, [D{hi(d)}, K{0}]})
        }
      | I{'sext64, [D{d}, U{a}]} -> {
            emit(I{'sar, [D{hi(d)}, U{a}, K{31}]})
            emit(I{'mov, [D{d}, U{a}]})
        }
      | I{'trunc, [D{d}, U{a}]} -> emit(I{'mov, [D{d}, U{a}]})
      | I{'getarg, [D{d}, K{n}]} if is_wide(d) -> {
            emit(I{'getarg, [D{d}, K{n}]})
            emit(I{'getarg, [D{hi(d)}, K{n + 1}]})
        }
      | I{'call, [callee, Us{args}, Ds{rets}]} -> emit(I{'call, [callee,
            Us{concat_map(r -> if (is_wide(r)) [r, hi(r)] else [r], args)},
            Ds{concat_map(r -> if (is_wide(r)) [r, hi(r)] else [r], rets)}]})
      | I{'ret, [Us{vals}]} -> emit(I{'ret, [Us{concat_map(r -> if (is_wide(r)) [r, hi(r)] else [r], vals)}]})
      | _ -> {
            if (any(r -> is_wide(r), append(ir_uses(i), ir_defs(i)))) panic(f"wide_lower: cannot lower {ir_show(i)}")
            emit(i)
        }
    }
}
