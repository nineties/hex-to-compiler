# ir: instructions of a register machine, shared by the stages of a code generator
# Copyright (C) 2026 nineties
#
# An instruction is I{op, ops}. op is a symbol and ops are operands:
#   D{r} defines the register r, U{r} uses it, DU{r} uses it and defines it again (a two-address instruction),
#   ID{r} and IU{r} define and use the physical register r without naming it in the instruction text,
#   Ds{[r, ...]} and Us{[r, ...]} define and use several registers,
#   K{n} an integer, S{name, off} the address of a symbol, L{l} a label, Cc{cc} a condition, W{w} a width, N{name} the name of a service of the system (os.pk),
#   M{base, disp}, MX{base, index, scale, disp}, MG{name, disp} and MF{kind, n, disp} memory operands.
#   base and index are U{r} or none. MF is a stack slot ('slot, n) or an incoming argument ('arg, n).
# Registers are integers. 0 to 31 are the physical registers of a target, and 32 and above are virtual registers.
# A function is IRFn{name, code, meta}: code is a vector of instructions and meta a table.

use("base")
use("list")
use("table")
use("vector")
use("string")

module ir {

vbase := 32

export is_vreg(r) := r >= vbase

# === Functions ===
export fn(name) := {
    meta := table.new()
    table.set(meta, 'nv, vbase)
    table.set(meta, 'nl, 0)
    table.set(meta, 'slots, vector.new())
    table.set(meta, 'width, table.new())
    table.set(meta, 'class, table.new())
    table.set(meta, 'exported, true)
    IRFn{name, vector.new(), meta}
}

export name(IRFn{n, _, _}) := n
export meta(IRFn{_, _, m}) := m
export emit(IRFn{_, c, _}, i) := vector.push(c, i)
export code(IRFn{_, c, _}) := vector.to_list(c)
export set_code(IRFn{n, _, m}, xs) := IRFn{n, vector.from_list(xs), m}

# vreg(f, w) is a new virtual register that holds a w-bit value
export vreg(f, w) := {
    m := meta(f)
    r := table.get(m, 'nv, 0)
    table.set(m, 'nv, r + 1)
    if (w != 32) table.set(table.get(m, 'width, none), r, w)
    r
}

export nregs(f) := table.get(meta(f), 'nv, 0)
export width(f, r) := table.get(table.get(meta(f), 'width, none), r, 32)

# the class of a register limits the physical registers it may take; a register without a class takes any
export set_class(f, r, c) := table.set(table.get(meta(f), 'class, none), r, c)
export class(f, r) := table.get(table.get(meta(f), 'class, none), r, 'any)

export label(f) := {
    m := meta(f)
    l := table.get(m, 'nl, 0)
    table.set(m, 'nl, l + 1)
    l
}

# slot(f, size, align) is the number of a new stack slot
export slot(f, size, align) := {
    v := table.get(meta(f), 'slots, none)
    vector.push(v, Tuple{size, align})
    vector.len(v) - 1
}

# === Instructions ===
op_regs(D{r}, role) := if (role == 'def) [r] else []
op_regs(ID{r}, role) := if (role == 'def) [r] else []
op_regs(U{r}, role) := if (role == 'use) [r] else []
op_regs(IU{r}, role) := if (role == 'use) [r] else []
op_regs(DU{r}, role) := [r]
op_regs(Ds{rs}, role) := if (role == 'def) rs else []
op_regs(Us{rs}, role) := if (role == 'use) rs else []
op_regs(M{b, _}, role) := op_regs(b, role)
op_regs(MX{b, x, _, _}, role) := append(op_regs(b, role), op_regs(x, role))
op_regs(_, role) := []

export defs(I{_, ops}) := concat_map(o -> op_regs(o, 'def), ops)
export uses(I{_, ops}) := concat_map(o -> op_regs(o, 'use), ops)

# map_op(f, o) renames every register of the operand o with f
map_op(f, D{r}) := D{f(r)}
map_op(f, U{r}) := U{f(r)}
map_op(f, DU{r}) := DU{f(r)}
map_op(f, ID{r}) := ID{f(r)}
map_op(f, IU{r}) := IU{f(r)}
map_op(f, Ds{rs}) := Ds{map(f, rs)}
map_op(f, Us{rs}) := Us{map(f, rs)}
map_op(f, M{b, d}) := M{map_op(f, b), d}
map_op(f, MX{b, x, s, d}) := MX{map_op(f, b), map_op(f, x), s, d}
map_op(f, o) := o

export map_regs(f, I{op, ops}) := I{op, map(o -> map_op(f, o), ops)}

# the operands the instruction names, without the implicit registers
export explicit(I{_, ops}) := filter(o -> head(o) != 'ID and head(o) != 'IU, ops)

export op(I{op, _}) := op
export ops(I{_, ops}) := ops

# the instructions that end a basic block
terminators := ['jmp, 'jcc, 'br, 'ret, 'trap, 'ud2]
export is_term(i) := member(op(i), terminators)

# the labels an instruction jumps to
export targets(I{op, ops}) := concat_map(o -> match o {
    L{l} -> [l]
  | _ -> []
}, if (op == 'label) [] else ops)

# a conditional jump falls through to the next instruction
export falls(i) := not member(op(i), ['jmp, 'br, 'ret, 'trap, 'ud2])

export move_pair(I{'mov, [D{a}, U{b}]}) := Tuple{a, b}
move_pair(I{'mov, [W{_}, D{a}, U{b}]}) := Tuple{a, b}
move_pair(_) := none

# === Text ===
show_regs(rs) := join(" ", map(r -> string.int_to_str(r), rs))

show_op(D{r}) := f"d{r}"
show_op(U{r}) := f"u{r}"
show_op(DU{r}) := f"du{r}"
show_op(ID{r}) := f"id{r}"
show_op(IU{r}) := f"iu{r}"
show_op(Ds{rs}) := f"d[{show_regs(rs)}]"
show_op(Us{rs}) := f"u[{show_regs(rs)}]"
show_op(K{n}) := string.int_to_str(n)
show_op(S{n, off}) := if (off == 0) n else f"{n}+{off}"
show_op(L{l}) := f"L{l}"
show_op(Cc{c}) := symname(c)
show_op(W{w}) := f"w{w}"
show_op(N{n}) := symname(n)
show_op(M{b, d}) := f"[{show_op(b)} {d}]"
show_op(MX{b, x, s, d}) := f"[{show_op(b)} {show_op(x)}*{s} {d}]"
show_op(MG{n, d}) := f"[{n} {d}]"
show_op(MF{k, n, d}) := f"[{symname(k)}{n} {d}]"
show_op('none) := "-"
show_op(_) := "?"

show_ops(ops) := join(", ", map(show_op, ops))

export show(I{op, ops}) := if (op == 'label) f"{show_op(ops[0])}:" else f"  {symname(op)} {show_ops(ops)}"

show_fn(f) := _strcat(_strcat(name(f), ":\n"), join("\n", map(show, code(f))))

# the number of the label that a label instruction defines
export label_id(I{'label, [L{l}]}) := l

}
