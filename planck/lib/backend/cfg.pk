# cfg: basic blocks and live registers of the instructions of ir.pk
# Copyright (C) 2026 nineties

use("base")
use("list")
use("table")
use("vector")
use("bitset")
use("backend/ir")

module cfg {

# A block is Blk{instrs, succs}: its instructions and the numbers of the blocks that may run next.
# A block starts at a label and at the instruction after a terminator, and ends at a terminator.
# blocks(code) is an array of blocks, numbered from 0 in the order of the code.
export blocks(code) := {
    groups := vector.new()
    cur := []
    labels := table()
    flush := () -> if (cur != []) {
        vector.push(groups, reverse(cur))
        cur = []
    }
    each(i -> {
        if (ir.op(i) == 'label) {
            flush()
            table_set(labels, ir.label_id(i), vector.len(groups))
        }
        cur = i :: cur
        if (ir.is_term(i)) flush()
    }, code)
    flush()
    n := vector.len(groups)
    bs := array(n)
    k := 0
    while (k < n) {
        xs := vector.get(groups, k)
        last := last(xs)
        ts := map(l -> table_get(labels, l, -1), ir.targets(last))
        if (member(-1, ts)) panic("cfg.blocks: a jump to a label that is not in the code")
        next := if (ir.falls(last) and k + 1 < n) [k + 1] else []
        array_set(bs, k, Blk{xs, append(ts, next)})
        k = k + 1
    }
    bs
}

cfg_flatten(bs) := {
    r := []
    i := array_len(bs) - 1
    while (i >= 0) {
        r = append(arg(array_get(bs, i), 0), r)
        i = i - 1
    }
    r
}

# live(bs, nregs) is Tuple{live_in, live_out}: arrays with the set of registers (0 to nregs - 1) live at the start and at the end of each block
export live(bs, nregs) := {
    n := array_len(bs)
    gen := array(n)
    kill := array(n)
    lin := array(n)
    lout := array(n)
    k := 0
    while (k < n) {
        g := bitset.new(nregs)
        d := bitset.new(nregs)
        each(i -> {
            each(u -> if (not bitset.has(d, u)) bitset.add(g, u), ir.uses(i))
            each(x -> bitset.add(d, x), ir.defs(i))
        }, arg(array_get(bs, k), 0))
        array_set(gen, k, g)
        array_set(kill, k, d)
        array_set(lin, k, bitset.copy(g))
        array_set(lout, k, bitset.new(nregs))
        k = k + 1
    }
    changed := true
    while (changed) {
        changed = false
        k = n - 1
        while (k >= 0) {
            o := array_get(lout, k)
            each(s -> if (bitset.union(o, array_get(lin, s))) changed = true, arg(array_get(bs, k), 1))
            # in = gen | (out - kill)
            t := bitset.copy(o)
            bitset.minus(t, array_get(kill, k))
            if (bitset.union(array_get(lin, k), t)) changed = true
            k = k - 1
        }
    }
    Tuple{lin, lout}
}

test {
    code := [
        I{'mov, [D{40}, K{0}]},
        I{'label, [L{0}]},
        I{'add, [DU{40}, K{1}, ID{8}]},
        I{'jcc, [Cc{'lt}, L{0}, IU{8}]},
        I{'mov, [D{0}, U{40}]},
        I{'ret, [IU{0}]}]
    assert(cfg_flatten(blocks(code)) == code, "cfg_flatten gives back the code that blocks divided")
}

}
