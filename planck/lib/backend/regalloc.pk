# regalloc: register allocation by graph coloring (optimistic, with spilling to stack slots)
# Copyright (C) 2026 nineties
#
# The code is instructions of ir.pk that name virtual registers and physical registers. The result names only physical registers.
# A target is RATarget{regs, classes, reload, spill}:
#   regs      the physical registers that may be given out, in the order to try them
#   classes   a table from the name of a class to the registers of the class; a virtual register may take the registers of its class (ir_set_class)
#   reload    reload(r, slot) is the instruction that loads the register r from the stack slot
#   spill     spill(r, slot) is the instruction that stores the register r into the stack slot
# Physical registers that are not in regs (the stack pointer, the flags) are not looked at.

use("base")
use("list")
use("table")
use("vector")
use("bitset")
use("backend/ir")
use("backend/cfg")

ra_allowed(f, ra, v) := {
    c := ir_class(f, v)
    if (c == 'any) arg(ra, 0) else table_get(arg(ra, 1), c, arg(ra, 0))
}

# the interference of the registers of code: an array of sets (rows for the registers 0 to nregs - 1),
# and the pairs of registers moved from one to the other
ra_graph(f, ra, code, nregs) := {
    bs := cfg_blocks(code)
    live := cfg_live(bs, nregs)
    rows := array(nregs)
    k := 0
    while (k < nregs) {
        array_set(rows, k, bits_new(nregs))
        k = k + 1
    }
    regs := arg(ra, 0)
    tracked := r -> ir_is_vreg(r) or member(r, regs)
    edge := (a, b) -> if (a != b and tracked(a) and tracked(b) and (ir_is_vreg(a) or ir_is_vreg(b))) {
        bits_add(array_get(rows, a), b)
        bits_add(array_get(rows, b), a)
    }
    moves := []
    k = 0
    while (k < array_len(bs)) {
        lv := bits_copy(array_get(live[1], k))
        each(i -> {
            ds := ir_defs(i)
            us := ir_uses(i)
            mv := ir_move_pair(i)
            if (mv != none) {
                bits_del(lv, mv[1])
                moves = mv :: moves
            }
            each(d -> {
                bits_each(lv, l -> edge(d, l))
                each(d2 -> edge(d, d2), ds)
            }, ds)
            each(d -> bits_del(lv, d), ds)
            each(u -> bits_add(lv, u), us)
        }, reverse(arg(array_get(bs, k), 0)))
        k = k + 1
    }
    Tuple{rows, moves}
}

ra_distinct(xs) := {
    seen := table()
    r := []
    each(x -> if (not table_has(seen, x)) {
        table_set(seen, x, true)
        r = x :: r
    }, xs)
    reverse(r)
}

# ra_spill(f, ra, code, spilled, unspillable) is code with each register of the list spilled: its value lives in a stack slot,
# is loaded into a new register before each instruction that uses it, and stored after each that defines it.
# The new registers are put in the table unspillable.
ra_spill(f, ra, code, spilled, unspillable) := {
    slots := table()
    each(v -> table_set(slots, v, ir_slot(f, 4, 4)), spilled)
    reload := arg(ra, 2)
    spill := arg(ra, 3)
    r := []
    each(i -> {
        us := filter(v -> table_has(slots, v), ra_distinct(ir_uses(i)))
        ds := filter(v -> table_has(slots, v), ra_distinct(ir_defs(i)))
        if (us == [] and ds == []) r = i :: r else {
            temps := table()
            each(v -> if (not table_has(temps, v)) {
                t := ir_vreg(f, 32)
                ir_set_class(f, t, ir_class(f, v))
                table_set(unspillable, t, true)
                table_set(temps, v, t)
            }, append(us, ds))
            each(v -> { r = reload(table_get(temps, v, 0), table_get(slots, v, 0)) :: r }, us)
            r = ir_map_regs(v -> table_get(temps, v, v), i) :: r
            each(v -> { r = spill(table_get(temps, v, 0), table_get(slots, v, 0)) :: r }, ds)
        }
    }, code)
    reverse(r)
}

# ra_color(f, ra, code, nregs, unspillable) is Tuple{colors, spilled}: a table from each virtual register to its physical register,
# and the registers that got none
ra_color(f, ra, code, nregs, unspillable) := {
    g := ra_graph(f, ra, code, nregs)
    rows := g[0]
    regs := arg(ra, 0)
    cost := table()
    each(i -> each(r -> if (ir_is_vreg(r)) table_set(cost, r, table_get(cost, r, 0) + 1), append(ir_uses(i), ir_defs(i))), code)
    nodes := table_keys(cost)
    adj := table()
    deg := table()
    each(v -> {
        ns := bits_to_list(array_get(rows, v))
        table_set(adj, v, ns)
        table_set(deg, v, length(ns))
    }, nodes)
    kof := v -> length(ra_allowed(f, ra, v))
    state := table()
    low := []
    each(v -> {
        table_set(state, v, 'rem)
    }, nodes)
    each(v -> if (table_get(deg, v, 0) < kof(v)) {
        table_set(state, v, 'low)
        low = v :: low
    }, sort((a, b) -> a < b, nodes))
    stack := []
    left := length(nodes)
    while (left > 0) {
        v := -1
        if (low != []) {
            v = low[0]
            low = drop(low, 1)
        } else {
            # no register is sure to be free: push the one that is cheapest to spill for its number of neighbors
            best := -1
            bestc := 0
            each(w -> if (table_get(state, w, 'out) == 'rem) {
                c := if (table_has(unspillable, w)) 1000000 else table_get(cost, w, 0) * 100 / (table_get(deg, w, 0) + 1)
                if (best < 0 or c < bestc) {
                    best = w
                    bestc = c
                }
            }, sort((a, b) -> a < b, nodes))
            v = best
        }
        table_set(state, v, 'out)
        stack = v :: stack
        left = left - 1
        each(w -> if (ir_is_vreg(w) and table_get(state, w, 'out) != 'out) {
            d := table_get(deg, w, 0) - 1
            table_set(deg, w, d)
            if (table_get(state, w, 'out) == 'rem and d < kof(w)) {
                table_set(state, w, 'low)
                low = append(low, [w])
            }
        }, table_get(adj, v, []))
    }
    partners := table()
    each((Tuple{a, b}) -> {
        if (ir_is_vreg(a)) table_set(partners, a, b :: table_get(partners, a, []))
        if (ir_is_vreg(b)) table_set(partners, b, a :: table_get(partners, b, []))
    }, g[1])
    colors := table()
    spilled := []
    colour_of := w -> if (ir_is_vreg(w)) table_get(colors, w, -1) else w
    each(v -> {
        taken := map(colour_of, table_get(adj, v, []))
        ok := filter(c -> not member(c, taken), ra_allowed(f, ra, v))
        if (ok == []) spilled = v :: spilled else {
            prefer := filter(c -> member(c, ok), map(colour_of, table_get(partners, v, [])))
            table_set(colors, v, if (prefer != []) prefer[0] else ok[0])
        }
    }, stack)
    Tuple{colors, reverse(spilled)}
}

# ra_allocate(f, ra) is the code of the function f with its virtual registers replaced by physical registers.
# Stack slots and virtual registers that the spilling needs are added to f.
ra_allocate(f, ra) := {
    unspillable := table()
    code := ir_code(f)
    result := none
    rounds := 0
    while (result == none) {
        rounds = rounds + 1
        if (rounds > 12) panic(f"ra_allocate: {ir_name(f)} still spills after 12 rounds")
        r := ra_color(f, ra, code, ir_nregs(f), unspillable)
        if (r[1] == []) {
            colors := r[0]
            result = filter(i -> match ir_move_pair(i) {
                Tuple{a, b} -> a != b
              | _ -> true
            }, map(i -> ir_map_regs(x -> if (ir_is_vreg(x)) table_get(colors, x, x) else x, i), code))
        } else code = ra_spill(f, ra, code, r[1], unspillable)
    }
    result
}
