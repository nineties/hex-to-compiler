# regalloc: register allocation by graph coloring (optimistic, with spilling to stack slots)
# Copyright (C) 2026 nineties
#
# The code is instructions of ir.pk that name virtual registers and physical registers. The result names only physical registers.
# A target is RATarget{regs, classes, reload, spill, slot}:
#   regs      the physical registers that may be given out, in the order to try them
#   classes   a table from the name of a class to the registers of the class; a virtual register may take the registers of its class (ir.set_class)
#   reload    reload(r, slot) is the instruction that loads the register r from the stack slot
#   spill     spill(r, slot) is the instruction that stores the register r into the stack slot
#   slot      the size in bytes of a stack slot, which also holds a register whole
# Physical registers that are not in regs (the stack pointer, the flags) are not looked at.

use("base")
use("list")
use("table")
use("vector")
use("bitset")
use("backend/ir")
use("backend/cfg")

module regalloc {

allowed(f, ra, v) := {
    c := ir.class(f, v)
    if (c == 'any) arg(ra, 0) else table.get(arg(ra, 1), c, arg(ra, 0))
}

# the interference of the registers of code: an array of sets (rows for the registers 0 to nregs - 1),
# and the pairs of registers moved from one to the other
graph(f, ra, code, nregs) := {
    bs := cfg.blocks(code)
    live := cfg.live(bs, nregs)
    rows := array(nregs)
    k := 0
    while (k < nregs) {
        array_set(rows, k, bitset.new(nregs))
        k = k + 1
    }
    regs := arg(ra, 0)
    tracked := r -> ir.is_vreg(r) or member(r, regs)
    edge := (a, b) -> if (a != b and tracked(a) and tracked(b) and (ir.is_vreg(a) or ir.is_vreg(b))) {
        bitset.add(array_get(rows, a), b)
        bitset.add(array_get(rows, b), a)
    }
    moves := []
    k = 0
    while (k < array_len(bs)) {
        lv := bitset.copy(array_get(live[1], k))
        each(i -> {
            ds := ir.defs(i)
            us := ir.uses(i)
            mv := ir.move_pair(i)
            if (mv != none) {
                bitset.del(lv, mv[1])
                moves = mv :: moves
            }
            each(d -> {
                bitset.each(lv, l -> edge(d, l))
                each(d2 -> edge(d, d2), ds)
            }, ds)
            each(d -> bitset.del(lv, d), ds)
            each(u -> bitset.add(lv, u), us)
        }, reverse(arg(array_get(bs, k), 0)))
        k = k + 1
    }
    Tuple{rows, moves}
}

distinct(xs) := {
    seen := table.new()
    r := []
    each(x -> if (not table.has(seen, x)) {
        table.set(seen, x, true)
        r = x :: r
    }, xs)
    reverse(r)
}

# ra_spill(f, ra, code, spilled, unspillable) is code with each register of the list spilled: its value lives in a stack slot,
# is loaded into a new register before each instruction that uses it, and stored after each that defines it.
# The new registers are put in the table unspillable.
ra_spill(f, ra, code, spilled, unspillable) := {
    slots := table.new()
    size := arg(ra, 4)
    each(v -> table.set(slots, v, ir.slot(f, size, size)), spilled)
    reload := arg(ra, 2)
    spill := arg(ra, 3)
    r := []
    each(i -> {
        us := filter(v -> table.has(slots, v), distinct(ir.uses(i)))
        ds := filter(v -> table.has(slots, v), distinct(ir.defs(i)))
        if (us == [] and ds == []) r = i :: r else {
            temps := table.new()
            each(v -> if (not table.has(temps, v)) {
                t := ir.vreg(f, ir.width(f, v))
                ir.set_class(f, t, ir.class(f, v))
                table.set(unspillable, t, true)
                table.set(temps, v, t)
            }, append(us, ds))
            each(v -> { r = reload(table.get(temps, v, 0), table.get(slots, v, 0)) :: r }, us)
            r = ir.map_regs(v -> table.get(temps, v, v), i) :: r
            each(v -> { r = spill(table.get(temps, v, 0), table.get(slots, v, 0)) :: r }, ds)
        }
    }, code)
    reverse(r)
}

# color(f, ra, code, nregs, unspillable) is Tuple{colors, spilled}: a table from each virtual register to its physical register,
# and the registers that got none
color(f, ra, code, nregs, unspillable) := {
    g := graph(f, ra, code, nregs)
    rows := g[0]
    regs := arg(ra, 0)
    cost := table.new()
    each(i -> each(r -> if (ir.is_vreg(r)) table.set(cost, r, table.get(cost, r, 0) + 1), append(ir.uses(i), ir.defs(i))), code)
    nodes := table.keys(cost)
    adj := table.new()
    deg := table.new()
    each(v -> {
        ns := bitset.to_list(array_get(rows, v))
        table.set(adj, v, ns)
        table.set(deg, v, length(ns))
    }, nodes)
    kof := v -> length(allowed(f, ra, v))
    state := table.new()
    low := []
    each(v -> {
        table.set(state, v, 'rem)
    }, nodes)
    each(v -> if (table.get(deg, v, 0) < kof(v)) {
        table.set(state, v, 'low)
        low = v :: low
    }, list.sort((a, b) -> a < b, nodes))
    stack := []
    left := length(nodes)
    while (left > 0) {
        v := -1
        if (low != []) {
            v = low[0]
            low = list.drop(low, 1)
        } else {
            # no register is sure to be free: push the one that is cheapest to spill for its number of neighbors
            best := -1
            bestc := 0
            each(w -> if (table.get(state, w, 'out) == 'rem) {
                c := if (table.has(unspillable, w)) 1000000 else table.get(cost, w, 0) * 100 / (table.get(deg, w, 0) + 1)
                if (best < 0 or c < bestc) {
                    best = w
                    bestc = c
                }
            }, list.sort((a, b) -> a < b, nodes))
            v = best
        }
        table.set(state, v, 'out)
        stack = v :: stack
        left = left - 1
        each(w -> if (ir.is_vreg(w) and table.get(state, w, 'out) != 'out) {
            d := table.get(deg, w, 0) - 1
            table.set(deg, w, d)
            if (table.get(state, w, 'out) == 'rem and d < kof(w)) {
                table.set(state, w, 'low)
                low = append(low, [w])
            }
        }, table.get(adj, v, []))
    }
    partners := table.new()
    each((Tuple{a, b}) -> {
        if (ir.is_vreg(a)) table.set(partners, a, b :: table.get(partners, a, []))
        if (ir.is_vreg(b)) table.set(partners, b, a :: table.get(partners, b, []))
    }, g[1])
    colors := table.new()
    spilled := []
    colour_of := w -> if (ir.is_vreg(w)) table.get(colors, w, -1) else w
    each(v -> {
        taken := map(colour_of, table.get(adj, v, []))
        ok := filter(c -> not member(c, taken), allowed(f, ra, v))
        if (ok == []) spilled = v :: spilled else {
            prefer := filter(c -> member(c, ok), map(colour_of, table.get(partners, v, [])))
            table.set(colors, v, if (prefer != []) prefer[0] else ok[0])
        }
    }, stack)
    Tuple{colors, reverse(spilled)}
}

# allocate(f, ra) is the code of the function f with its virtual registers replaced by physical registers.
# Stack slots and virtual registers that the spilling needs are added to f.
export allocate(f, ra) := {
    unspillable := table.new()
    code := ir.code(f)
    result := none
    rounds := 0
    while (result == none) {
        rounds = rounds + 1
        if (rounds > 12) panic(f"regalloc.allocate: {ir.name(f)} still spills after 12 rounds")
        r := color(f, ra, code, ir.nregs(f), unspillable)
        if (r[1] == []) {
            colors := r[0]
            result = filter(i -> match ir.move_pair(i) {
                Tuple{a, b} -> a != b
              | _ -> true
            }, map(i -> ir.map_regs(x -> if (ir.is_vreg(x)) table.get(colors, x, x) else x, i), code))
        } else code = ra_spill(f, ra, code, r[1], unspillable)
    }
    result
}

}
