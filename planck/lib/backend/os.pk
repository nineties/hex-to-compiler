use("base")
use("list")
use("backend/ir")

module os {

services := ['write, 'read, 'open, 'create, 'close, 'exit, 'grow, 'args, 'abort]

abort_status := 134

linux_o_rdonly := 0
linux_o_create := 577
linux_mode := 420

os_arg(a) := if (type(a) == Int) U{a} else a

x64_read := 0
x64_write := 1
x64_open := 2
x64_close := 3
x64_brk := 12
x64_exit := 60
x64_exit_group := 231

x64_reg_number := 0
x64_reg_args := [7, 6, 2, 10, 8, 9]
x64_reg_rcx := 1
x64_reg_r11 := 11

x64_reg_frame := 5
x64_frame_to_args := 8

x64_reg_flags := 16

x64_load(emit, number, args) := {
    emit(I{'mov, [D{x64_reg_number}, K{number}]})
    k := 0
    each(a -> {
        emit(I{'mov, [D{x64_reg_args[k]}, os_arg(a)]})
        k = k + 1
    }, args)
}

x64_call(emit, number, args, d) := {
    x64_load(emit, number, args)
    emit(I{'syscall, append([IU{x64_reg_number}, ID{x64_reg_number}, ID{x64_reg_rcx}, ID{x64_reg_r11}], map(r -> IU{r}, list.take(x64_reg_args, length(args))))})
    if (d != none) emit(I{'mov, [D{d}, U{x64_reg_number}]})
}

export select_linux_x64(emit, label, 'write, args, d) := x64_call(emit, x64_write, args, d)
select_linux_x64(emit, label, 'read, args, d) := x64_call(emit, x64_read, args, d)
select_linux_x64(emit, label, 'open, args, d) := x64_call(emit, x64_open, append(args, [K{linux_o_rdonly}]), d)
select_linux_x64(emit, label, 'create, args, d) := x64_call(emit, x64_open, append(args, [K{linux_o_create}, K{linux_mode}]), d)
select_linux_x64(emit, label, 'close, args, d) := x64_call(emit, x64_close, args, d)
select_linux_x64(emit, label, 'exit, args, d) := x64_call(emit, x64_exit, args, d)
select_linux_x64(emit, label, 'grow, args, d) := x64_call(emit, x64_brk, args, d)
select_linux_x64(emit, label, 'args, args, d) := {
    emit(I{'mov, [D{d}, U{x64_reg_frame}]})
    emit(I{'add, [DU{d}, K{x64_frame_to_args}, ID{x64_reg_flags}]})
}
select_linux_x64(emit, label, 'abort, args, d) := {
    emit(I{'mov, [D{x64_reg_number}, K{x64_exit_group}]})
    emit(I{'mov, [D{x64_reg_args[0]}, K{abort_status}]})
    emit(I{'syscall, [IU{x64_reg_number}, IU{x64_reg_args[0]}, ID{x64_reg_number}, ID{x64_reg_rcx}, ID{x64_reg_r11}]})
    emit(I{'ud2, []})
}
select_linux_x64(emit, label, name, args, d) := panic(f"os.select_linux_x64: the service {symname(name)} is not known")

macos_class := 33554432
macos_exit := 1
macos_read := 3
macos_write := 4
macos_open := 5
macos_close := 6
macos_mmap := 197

macos_o_create := 1537

macos_heap_shift := 35
macos_mmap_prot := 3
macos_mmap_flags := 4162

x64_reg_argv := 6

macos_x64_call(emit, number, args, d) := {
    x64_load(emit, macos_class + number, args)
    emit(I{'syscall, append([IU{x64_reg_number}, ID{x64_reg_number}, ID{x64_reg_rcx}, ID{x64_reg_r11}, ID{x64_reg_flags}], map(r -> IU{r}, list.take(x64_reg_args, length(args))))})
    emit(I{'sbb, [W{'w64}, DU{x64_reg_rcx}, U{x64_reg_rcx}, IU{x64_reg_flags}, ID{x64_reg_flags}]})
    emit(I{'bxor, [W{'w64}, DU{x64_reg_number}, U{x64_reg_rcx}, ID{x64_reg_flags}]})
    emit(I{'sub, [W{'w64}, DU{x64_reg_number}, U{x64_reg_rcx}, ID{x64_reg_flags}]})
    if (d != none) emit(I{'mov, [D{d}, U{x64_reg_number}]})
}

export select_macos_x64(emit, label, 'write, args, d) := macos_x64_call(emit, macos_write, args, d)
select_macos_x64(emit, label, 'read, args, d) := macos_x64_call(emit, macos_read, args, d)
select_macos_x64(emit, label, 'open, args, d) := macos_x64_call(emit, macos_open, append(args, [K{linux_o_rdonly}]), d)
select_macos_x64(emit, label, 'create, args, d) := macos_x64_call(emit, macos_open, append(args, [K{macos_o_create}, K{linux_mode}]), d)
select_macos_x64(emit, label, 'close, args, d) := macos_x64_call(emit, macos_close, args, d)
select_macos_x64(emit, label, 'exit, args, d) := macos_x64_call(emit, macos_exit, args, d)
select_macos_x64(emit, label, 'grow, args, d) := {
    emit(I{'mov, [D{d}, os_arg(args[0])]})
    map_it := label()
    done := label()
    emit(I{'cmp, [W{'w64}, U{d}, K{0}, ID{x64_reg_flags}]})
    emit(I{'jcc, [Cc{'ne}, L{done}, IU{x64_reg_flags}]})
    emit(I{'jmp, [L{map_it}]})
    emit(I{'label, [L{map_it}]})
    emit(I{'mov, [D{x64_reg_args[1]}, K{1}]})
    emit(I{'shl, [W{'w64}, DU{x64_reg_args[1]}, K{macos_heap_shift}, ID{x64_reg_flags}]})
    macos_x64_call(emit, macos_mmap, [K{0}, x64_reg_args[1], K{macos_mmap_prot}, K{macos_mmap_flags}, K{-1}, K{0}], d)
    emit(I{'jmp, [L{done}]})
    emit(I{'label, [L{done}]})
}
select_macos_x64(emit, label, 'args, args, d) := {
    emit(I{'mov, [D{d}, U{x64_reg_argv}]})
    emit(I{'add, [DU{d}, K{-8}, ID{x64_reg_flags}]})
}
select_macos_x64(emit, label, 'abort, args, d) := {
    emit(I{'mov, [D{x64_reg_number}, K{macos_class + macos_exit}]})
    emit(I{'mov, [D{x64_reg_args[0]}, K{abort_status}]})
    emit(I{'syscall, [IU{x64_reg_number}, IU{x64_reg_args[0]}, ID{x64_reg_number}, ID{x64_reg_rcx}, ID{x64_reg_r11}]})
    emit(I{'ud2, []})
}
select_macos_x64(emit, label, name, args, d) := panic(f"os.select_macos_x64: the service {symname(name)} is not known")

a64_reg_number_linux := 8
a64_reg_args := [0, 1, 2, 3, 4, 5]
a64_reg_result := 0
linux_a64_read := 63
linux_a64_write := 64
linux_a64_openat := 56
linux_a64_close := 57
linux_a64_exit := 93
linux_a64_exit_group := 94
linux_a64_brk := 214
linux_at_fdcwd := -100

a64_load(emit, numreg, number, args) := {
    emit(I{'mov, [D{numreg}, K{number}]})
    k := 0
    each(a -> {
        emit(I{'mov, [D{a64_reg_args[k]}, os_arg(a)]})
        k = k + 1
    }, args)
}

a64_svc(emit, imm, numreg, args) := emit(I{'svc, append([K{imm}, IU{numreg}, ID{a64_reg_result}], map(r -> IU{r}, list.take(a64_reg_args, length(args))))})

linux_a64_call(emit, number, args, d) := {
    a64_load(emit, a64_reg_number_linux, number, args)
    a64_svc(emit, 0, a64_reg_number_linux, args)
    if (d != none) emit(I{'mov, [D{d}, U{a64_reg_result}]})
}

export select_linux_arm64(emit, label, 'write, args, d) := linux_a64_call(emit, linux_a64_write, args, d)
select_linux_arm64(emit, label, 'read, args, d) := linux_a64_call(emit, linux_a64_read, args, d)
select_linux_arm64(emit, label, 'open, args, d) := linux_a64_call(emit, linux_a64_openat, append([K{linux_at_fdcwd}], append(args, [K{linux_o_rdonly}])), d)
select_linux_arm64(emit, label, 'create, args, d) := linux_a64_call(emit, linux_a64_openat, append([K{linux_at_fdcwd}], append(args, [K{linux_o_create}, K{linux_mode}])), d)
select_linux_arm64(emit, label, 'close, args, d) := linux_a64_call(emit, linux_a64_close, args, d)
select_linux_arm64(emit, label, 'exit, args, d) := linux_a64_call(emit, linux_a64_exit, args, d)
select_linux_arm64(emit, label, 'grow, args, d) := linux_a64_call(emit, linux_a64_brk, args, d)
select_linux_arm64(emit, label, 'args, args, d) := emit(I{'lea, [W{'w64}, D{d}, MF{'arg, 0, 0}]})
select_linux_arm64(emit, label, 'abort, args, d) := {
    a64_load(emit, a64_reg_number_linux, linux_a64_exit_group, [K{abort_status}])
    a64_svc(emit, 0, a64_reg_number_linux, [K{abort_status}])
    emit(I{'ud2, []})
}
select_linux_arm64(emit, label, name, args, d) := panic(f"os.select_linux_arm64: the service {symname(name)} is not known")

a64_reg_number_macos := 16

macos_a64_call(emit, number, args, d) := {
    a64_load(emit, a64_reg_number_macos, number, args)
    a64_svc(emit, 128, a64_reg_number_macos, args)
    emit(I{'cnegcs, [DU{a64_reg_result}]})
    if (d != none) emit(I{'mov, [D{d}, U{a64_reg_result}]})
}

export select_macos_arm64(emit, label, 'write, args, d) := macos_a64_call(emit, macos_write, args, d)
select_macos_arm64(emit, label, 'read, args, d) := macos_a64_call(emit, macos_read, args, d)
select_macos_arm64(emit, label, 'open, args, d) := macos_a64_call(emit, macos_open, append(args, [K{linux_o_rdonly}]), d)
select_macos_arm64(emit, label, 'create, args, d) := macos_a64_call(emit, macos_open, append(args, [K{macos_o_create}, K{linux_mode}]), d)
select_macos_arm64(emit, label, 'close, args, d) := macos_a64_call(emit, macos_close, args, d)
select_macos_arm64(emit, label, 'exit, args, d) := macos_a64_call(emit, macos_exit, args, d)
select_macos_arm64(emit, label, 'grow, args, d) := {
    emit(I{'mov, [D{d}, os_arg(args[0])]})
    map_it := label()
    done := label()
    emit(I{'jcc, [Cc{'ne}, L{done}, W{'w64}, U{d}, K{0}]})
    emit(I{'jmp, [L{map_it}]})
    emit(I{'label, [L{map_it}]})
    emit(I{'movabs, [D{a64_reg_args[1]}, K{0}, K{8}, K{0}, K{0}]})
    macos_a64_call(emit, macos_mmap, [K{0}, a64_reg_args[1], K{macos_mmap_prot}, K{macos_mmap_flags}, K{-1}, K{0}], d)
    emit(I{'jmp, [L{done}]})
    emit(I{'label, [L{done}]})
}
select_macos_arm64(emit, label, 'args, args, d) := emit(I{'sub, [W{'w64}, D{d}, U{1}, K{8}]})
select_macos_arm64(emit, label, 'abort, args, d) := {
    a64_load(emit, a64_reg_number_macos, macos_exit, [K{abort_status}])
    a64_svc(emit, 128, a64_reg_number_macos, [K{abort_status}])
    emit(I{'ud2, []})
}
select_macos_arm64(emit, label, name, args, d) := panic(f"os.select_macos_arm64: the service {symname(name)} is not known")

export windows_imports := ["ExitProcess", "GetStdHandle", "WriteFile", "ReadFile", "CreateFileA", "CloseHandle", "VirtualAlloc", "GetCommandLineA"]
export windows_vars := [Tuple{"__os_heap", 8}, Tuple{"__os_commit", 8}, Tuple{"__os_argv", 8 + 8 * 512}, Tuple{"__os_cmd", 33000}]

win_arg_regs := [1, 2, 8, 9]
win_rsp := 4
win_space := 80
win_saved := 64
win_local := 72

win_fl := ID{x64_reg_flags}
win_load(emit, r, spec) := match spec {
    K{n} -> emit(I{'mov, [D{r}, K{n}]})
  | Big{p3, p2, p1, p0} -> emit(I{'movabs, [D{r}, K{p3}, K{p2}, K{p1}, K{p0}]})
  | 'out -> emit(I{'lea, [W{'w64}, D{r}, M{U{win_rsp}, win_local}]})
  | Mem{name} -> emit(I{'mov, [W{'w64}, D{r}, MG{name, 0}]})
  | Sub{v, name} -> {
        emit(I{'mov, [W{'w64}, D{r}, MG{name, 0}]})
        emit(I{'neg, [W{'w64}, DU{r}, win_fl]})
        emit(I{'add, [W{'w64}, DU{r}, U{v}, win_fl]})
    }
  | v -> emit(I{'mov, [D{r}, U{v}]})
}

win_store(emit, at, spec) := match spec {
    K{n} -> emit(I{'mov, [W{'w64}, M{U{win_rsp}, at}, K{n}]})
  | Big{p3, p2, p1, p0} -> {
        emit(I{'movabs, [D{0}, K{p3}, K{p2}, K{p1}, K{p0}]})
        emit(I{'mov, [W{'w64}, M{U{win_rsp}, at}, U{0}]})
    }
  | v -> emit(I{'mov, [W{'w64}, M{U{win_rsp}, at}, U{v}]})
}

win_call(emit, name, args) := {
    emit(I{'mov, [D{0}, U{win_rsp}]})
    emit(I{'band, [W{'w64}, DU{win_rsp}, K{-16}, win_fl]})
    emit(I{'sub, [W{'w64}, DU{win_rsp}, K{win_space}, win_fl]})
    emit(I{'mov, [W{'w64}, M{U{win_rsp}, win_saved}, U{0}]})
    k := 0
    each(a -> {
        if (k >= 4) win_store(emit, 32 + 8 * (k - 4), a)
        k = k + 1
    }, args)
    k = 0
    each(a -> {
        if (k < 4) win_load(emit, win_arg_regs[k], a)
        k = k + 1
    }, args)
    emit(I{'call, append([MG{f"__imp_{name}", 0}, ID{0}, ID{1}, ID{2}, ID{8}, ID{9}, ID{10}, ID{11}, win_fl, ID{17}, ID{18}], map(r -> IU{r}, list.take(win_arg_regs, if (length(args) < 4) length(args) else 4)))})
}

win_end(emit) := emit(I{'mov, [W{'w64}, D{win_rsp}, M{U{win_rsp}, win_saved}]})

win_cmp(emit, z, a, b) := emit(I{'cmp, [W{z}, U{a}, b, win_fl]})
win_jcc(emit, c, l) := emit(I{'jcc, [Cc{c}, L{l}, IU{x64_reg_flags}]})
win_jmp(emit, l) := emit(I{'jmp, [L{l}]})
win_label(emit, l) := emit(I{'label, [L{l}]})

win_if(emit, label, c, l) := {
    next := label()
    win_jcc(emit, c, l)
    win_jmp(emit, next)
    win_label(emit, next)
}

win_io(emit, label, api, args, d) := {
    lstd := label()
    lgo := label()
    emit(I{'mov, [D{d}, os_arg(args[0])]})
    win_cmp(emit, 'w64, d, K{2})
    win_jcc(emit, 'leu, lstd)
    win_jmp(emit, lgo)
    win_label(emit, lstd)
    emit(I{'mov, [D{d}, K{-10}]})
    emit(I{'sub, [W{'w32}, DU{d}, os_arg(args[0]), win_fl]})
    win_call(emit, "GetStdHandle", [d])
    win_end(emit)
    emit(I{'mov, [D{d}, U{0}]})
    win_jmp(emit, lgo)
    win_label(emit, lgo)
    win_call(emit, api, [d, args[1], args[2], 'out, K{0}])
    emit(I{'mov, [D{d}, K{-1}]})
    ldone := label()
    win_cmp(emit, 'w32, 0, K{0})
    win_if(emit, label, 'eq, ldone)
    emit(I{'mov, [W{'w32}, D{d}, M{U{win_rsp}, win_local}]})
    win_jmp(emit, ldone)
    win_label(emit, ldone)
    win_end(emit)
}

windows_x64_open(emit, access, share, disposition, args, d) := {
    win_call(emit, "CreateFileA", [args[0], access, K{share}, K{0}, K{disposition}, K{128}, K{0}])
    win_end(emit)
    emit(I{'mov, [D{d}, U{0}]})
}

win_args_start(emit, ls) := {
    win_call(emit, "GetCommandLineA", [])
    win_end(emit)
    emit(I{'mov, [W{'w64}, D{6}, U{0}]})
    emit(I{'lea, [W{'w64}, D{7}, MG{"__os_cmd", 0}]})
    emit(I{'lea, [W{'w64}, D{8}, MG{"__os_argv", 8}]})
    emit(I{'mov, [W{'w32}, D{9}, K{0}]})
    emit(I{'mov, [W{'w32}, D{10}, K{0}]})
    win_jmp(emit, ls[0])
}

win_args_skip(emit, label, ls) := {
    win_label(emit, ls[0])
    emit(I{'movzxb, [W{'w32}, D{1}, M{U{6}, 0}]})
    win_cmp(emit, 'w32, 1, K{0})
    win_if(emit, label, 'eq, ls[8])
    win_cmp(emit, 'w32, 1, K{32})
    win_if(emit, label, 'eq, ls[1])
    win_cmp(emit, 'w32, 1, K{9})
    win_if(emit, label, 'eq, ls[1])
    win_jmp(emit, ls[2])
    win_label(emit, ls[1])
    emit(I{'add, [W{'w64}, DU{6}, K{1}, win_fl]})
    win_jmp(emit, ls[0])
    win_label(emit, ls[2])
    emit(I{'mov, [W{'w64}, M{U{8}, 0}, U{7}]})
    emit(I{'add, [W{'w64}, DU{8}, K{8}, win_fl]})
    emit(I{'add, [W{'w32}, DU{9}, K{1}, win_fl]})
    emit(I{'mov, [W{'w32}, D{10}, K{0}]})
    win_jmp(emit, ls[3])
}

win_args_chars(emit, label, ls) := {
    win_label(emit, ls[3])
    emit(I{'movzxb, [W{'w32}, D{1}, M{U{6}, 0}]})
    win_cmp(emit, 'w32, 1, K{0})
    win_if(emit, label, 'eq, ls[7])
    win_cmp(emit, 'w32, 1, K{34})
    win_if(emit, label, 'eq, ls[5])
    win_cmp(emit, 'w32, 10, K{0})
    win_if(emit, label, 'ne, ls[4])
    win_cmp(emit, 'w32, 1, K{32})
    win_if(emit, label, 'eq, ls[6])
    win_cmp(emit, 'w32, 1, K{9})
    win_if(emit, label, 'eq, ls[6])
    win_jmp(emit, ls[4])
    win_label(emit, ls[4])
    emit(I{'movb, [M{U{7}, 0}, U{1}]})
    emit(I{'add, [W{'w64}, DU{7}, K{1}, win_fl]})
    emit(I{'add, [W{'w64}, DU{6}, K{1}, win_fl]})
    win_jmp(emit, ls[3])
    win_label(emit, ls[5])
    emit(I{'bxor, [W{'w32}, DU{10}, K{1}, win_fl]})
    emit(I{'add, [W{'w64}, DU{6}, K{1}, win_fl]})
    win_jmp(emit, ls[3])
}

win_args_end(emit, ls, d) := {
    win_label(emit, ls[6])
    emit(I{'movb, [M{U{7}, 0}, K{0}]})
    emit(I{'add, [W{'w64}, DU{7}, K{1}, win_fl]})
    emit(I{'add, [W{'w64}, DU{6}, K{1}, win_fl]})
    win_jmp(emit, ls[0])
    win_label(emit, ls[7])
    emit(I{'movb, [M{U{7}, 0}, K{0}]})
    win_jmp(emit, ls[8])
    win_label(emit, ls[8])
    emit(I{'lea, [W{'w64}, D{d}, MG{"__os_argv", 0}]})
    emit(I{'mov, [W{'w64}, M{U{d}, 0}, U{9}]})
}

win_grow_reserve(emit, ls, d) := {
    win_label(emit, ls[1])
    emit(I{'mov, [W{'w64}, D{0}, MG{"__os_heap", 0}]})
    win_cmp(emit, 'w64, 0, K{0})
    win_jcc(emit, 'ne, ls[2])
    win_jmp(emit, ls[3])
    win_label(emit, ls[3])
    win_call(emit, "VirtualAlloc", [K{0}, Big{0, 8, 0, 0}, K{8192}, K{4}])
    win_end(emit)
    emit(I{'mov, [W{'w64}, MG{"__os_heap", 0}, U{0}]})
    emit(I{'mov, [W{'w64}, MG{"__os_commit", 0}, U{0}]})
    win_jmp(emit, ls[2])
    win_label(emit, ls[2])
    emit(I{'mov, [D{d}, U{0}]})
    win_jmp(emit, ls[5])
}

win_grow_commit(emit, ls, d) := {
    win_label(emit, ls[0])
    emit(I{'mov, [W{'w64}, D{0}, MG{"__os_commit", 0}]})
    emit(I{'cmp, [W{'w64}, U{d}, U{0}, win_fl]})
    win_jcc(emit, 'leu, ls[5])
    win_call(emit, "VirtualAlloc", [Mem{"__os_commit"}, Sub{d, "__os_commit"}, K{4096}, K{4}])
    win_end(emit)
    win_cmp(emit, 'w64, 0, K{0})
    win_jcc(emit, 'ne, ls[4])
    emit(I{'mov, [D{d}, K{0}]})
    win_jmp(emit, ls[5])
    win_label(emit, ls[4])
    emit(I{'mov, [W{'w64}, MG{"__os_commit", 0}, U{d}]})
    win_jmp(emit, ls[5])
}

windows_x64_args(emit, label, d) := {
    ls := map(i -> label(), range(0, 9))
    win_args_start(emit, ls)
    win_args_skip(emit, label, ls)
    win_args_chars(emit, label, ls)
    win_args_end(emit, ls, d)
}

windows_x64_grow(emit, label, args, d) := {
    ls := map(i -> label(), range(0, 6))
    emit(I{'mov, [D{d}, os_arg(args[0])]})
    win_cmp(emit, 'w64, d, K{0})
    win_jcc(emit, 'ne, ls[0])
    win_jmp(emit, ls[1])
    win_grow_reserve(emit, ls, d)
    win_grow_commit(emit, ls, d)
    win_label(emit, ls[5])
}

export select_windows_x64(emit, label, 'write, args, d) := win_io(emit, label, "WriteFile", args, d)
select_windows_x64(emit, label, 'read, args, d) := win_io(emit, label, "ReadFile", args, d)
select_windows_x64(emit, label, 'open, args, d) := windows_x64_open(emit, Big{0, 0, 32768, 0}, 1, 3, args, d)
select_windows_x64(emit, label, 'create, args, d) := windows_x64_open(emit, Big{0, 0, 16384, 0}, 0, 2, args, d)
select_windows_x64(emit, label, 'close, args, d) := {
    ldone := label()
    win_call(emit, "CloseHandle", [args[0]])
    emit(I{'mov, [D{d}, K{0}]})
    win_cmp(emit, 'w32, 0, K{0})
    win_if(emit, label, 'ne, ldone)
    emit(I{'mov, [D{d}, K{-1}]})
    win_jmp(emit, ldone)
    win_label(emit, ldone)
    win_end(emit)
}
select_windows_x64(emit, label, 'exit, args, d) := {
    win_call(emit, "ExitProcess", [args[0]])
    emit(I{'ud2, []})
}
select_windows_x64(emit, label, 'grow, args, d) := windows_x64_grow(emit, label, args, d)
select_windows_x64(emit, label, 'args, args, d) := windows_x64_args(emit, label, d)
select_windows_x64(emit, label, 'abort, args, d) := {
    win_call(emit, "ExitProcess", [K{abort_status}])
    emit(I{'ud2, []})
}
select_windows_x64(emit, label, name, args, d) := panic(f"os.select_windows_x64: the service {symname(name)} is not known")

}
