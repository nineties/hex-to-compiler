# os: the operating system layer of the code generator
# Copyright (C) 2026 nineties
#
# Programs ask the system for a few services through the instruction I{'os, [N{name}, Us{args}, D{result}]} of ir.pk:
#   write [fd, buf, n]   writes n bytes at the address buf to the file fd; the result is the number written, or negative for an error
#   read [fd, buf, n]    reads up to n bytes from the file fd to the address buf; the result is the number read (0 at the end of the file), or negative for an error
#   open [path]          opens the file whose name is the bytes from the address path to the first byte 0, for reading; the result is the file or negative for an error
#   create [path]        the same, for writing: the file is emptied or made new
#   close [fd]           closes the file fd
#   exit [status]        ends the program with the status; it does not return
#   grow [addr]          moves the end of the data area of the program to addr and gives the new end; 0 gives the end as it is,
#                        and a result other than addr means that the memory is not given
#   args []              gives the address of the arguments of the program: a word that holds their number n, then n words that hold the
#                        address of each, which is the bytes of the argument followed by a byte 0. It is used by the start of the program only.
#   abort []             ends the program as failed (the status abort_status); it does not return
# The names do not depend on the system. os.select_linux_x64(emit, label, name, args, d) turns one of them into the instructions of
# x86-64 on Linux (syscall), and os.select_macos_x64 into those of x86-64 on macOS; label() is a new label for the code that has a branch.
# This file is the only place that knows the numbers and the registers; another system or machine adds its own.

use("base")
use("list")
use("backend/ir")

module os {

services := ['write, 'read, 'open, 'create, 'close, 'exit, 'grow, 'args, 'abort]

# the status of a program that ends by abort
abort_status := 134

# open for reading
linux_o_rdonly := 0
# open for writing, made new when it is not there, and emptied (O_WRONLY | O_CREAT | O_TRUNC), with the mode rw-r--r--
linux_o_create := 577
linux_mode := 420

# an argument of a system call is a register, or K{n} for an integer
os_arg(a) := if (type(a) == Int) U{a} else a

# === Linux on x86-64 ===
# A system call is syscall with the number in rax and the arguments in rdi, rsi, rdx, r10, r8 and r9; it keeps every register but rax, rcx and r11.
# An argument is a register or K{n}; the instructions are those of ir.pk, and the target that selects them gives the widths.
x64_read := 0
x64_write := 1
x64_open := 2
x64_close := 3
x64_brk := 12
x64_exit := 60
x64_exit_group := 231

x64_reg_number := 0
x64_reg_args := [7, 6, 2, 10, 8, 9]
x64_reg_rcx := 1
x64_reg_r11 := 11

# the frame pointer, which the start of the program has set just under the arguments of the program: the word that holds the number of them is 8 bytes above it
x64_reg_frame := 5
x64_frame_to_args := 8

# the register of the flags that an addition defines (the same as flags_def of x64.pk)
x64_reg_flags := 16

# the registers of a system call: the number and the arguments
x64_load(emit, number, args) := {
    emit(I{'mov, [D{x64_reg_number}, K{number}]})
    k := 0
    each(a -> {
        emit(I{'mov, [D{x64_reg_args[k]}, os_arg(a)]})
        k = k + 1
    }, args)
}

x64_call(emit, number, args, d) := {
    x64_load(emit, number, args)
    emit(I{'syscall, append([IU{x64_reg_number}, ID{x64_reg_number}, ID{x64_reg_rcx}, ID{x64_reg_r11}], map(r -> IU{r}, list.take(x64_reg_args, length(args))))})
    if (d != none) emit(I{'mov, [D{d}, U{x64_reg_number}]})
}

export select_linux_x64(emit, label, 'write, args, d) := x64_call(emit, x64_write, args, d)
select_linux_x64(emit, label, 'read, args, d) := x64_call(emit, x64_read, args, d)
select_linux_x64(emit, label, 'open, args, d) := x64_call(emit, x64_open, append(args, [K{linux_o_rdonly}]), d)
select_linux_x64(emit, label, 'create, args, d) := x64_call(emit, x64_open, append(args, [K{linux_o_create}, K{linux_mode}]), d)
select_linux_x64(emit, label, 'close, args, d) := x64_call(emit, x64_close, args, d)
select_linux_x64(emit, label, 'exit, args, d) := x64_call(emit, x64_exit, args, d)
select_linux_x64(emit, label, 'grow, args, d) := x64_call(emit, x64_brk, args, d)
select_linux_x64(emit, label, 'args, args, d) := {
    emit(I{'mov, [D{d}, U{x64_reg_frame}]})
    emit(I{'add, [DU{d}, K{x64_frame_to_args}, ID{x64_reg_flags}]})
}
select_linux_x64(emit, label, 'abort, args, d) := {
    emit(I{'mov, [D{x64_reg_number}, K{x64_exit_group}]})
    emit(I{'mov, [D{x64_reg_args[0]}, K{abort_status}]})
    emit(I{'syscall, [IU{x64_reg_number}, IU{x64_reg_args[0]}, ID{x64_reg_number}, ID{x64_reg_rcx}, ID{x64_reg_r11}]})
    emit(I{'ud2, []})
}
select_linux_x64(emit, label, name, args, d) := panic(f"os.select_linux_x64: the service {symname(name)} is not known")

# === macOS on x86-64 ===
# The system calls are those of BSD, called by syscall with the number of the call added to the class 0x2000000 in rax; the arguments are in the registers of Linux, and rcx and r11
# are changed. An error is the flag of carry and the number of the error in rax, as a positive number. It is made the negative number that Linux gives: sbb rcx, rcx makes -1 for the
# flag and 0 otherwise, and (rax xor rcx) - rcx is -rax or rax.
macos_class := 33554432
macos_exit := 1
macos_read := 3
macos_write := 4
macos_open := 5
macos_close := 6
macos_mmap := 197

# open for writing, made new when it is not there, and emptied (O_WRONLY | O_CREAT | O_TRUNC)
macos_o_create := 1537

# the memory of the program: there is no brk, so grow 0 maps an area of 2^35 bytes, and the grow of an address gives that address (the pages are given on use)
# (protection read and write, private and anonymous and without reserve)
macos_heap_shift := 35
macos_mmap_prot := 3
macos_mmap_flags := 4162

# the register that holds the address of the arguments of the program, which follow the number of them in the memory
x64_reg_argv := 6

macos_x64_call(emit, number, args, d) := {
    x64_load(emit, macos_class + number, args)
    emit(I{'syscall, append([IU{x64_reg_number}, ID{x64_reg_number}, ID{x64_reg_rcx}, ID{x64_reg_r11}, ID{x64_reg_flags}], map(r -> IU{r}, list.take(x64_reg_args, length(args))))})
    emit(I{'sbb, [W{'w64}, DU{x64_reg_rcx}, U{x64_reg_rcx}, IU{x64_reg_flags}, ID{x64_reg_flags}]})
    emit(I{'bxor, [W{'w64}, DU{x64_reg_number}, U{x64_reg_rcx}, ID{x64_reg_flags}]})
    emit(I{'sub, [W{'w64}, DU{x64_reg_number}, U{x64_reg_rcx}, ID{x64_reg_flags}]})
    if (d != none) emit(I{'mov, [D{d}, U{x64_reg_number}]})
}

export select_macos_x64(emit, label, 'write, args, d) := macos_x64_call(emit, macos_write, args, d)
select_macos_x64(emit, label, 'read, args, d) := macos_x64_call(emit, macos_read, args, d)
select_macos_x64(emit, label, 'open, args, d) := macos_x64_call(emit, macos_open, append(args, [K{linux_o_rdonly}]), d)
select_macos_x64(emit, label, 'create, args, d) := macos_x64_call(emit, macos_open, append(args, [K{macos_o_create}, K{linux_mode}]), d)
select_macos_x64(emit, label, 'close, args, d) := macos_x64_call(emit, macos_close, args, d)
select_macos_x64(emit, label, 'exit, args, d) := macos_x64_call(emit, macos_exit, args, d)
select_macos_x64(emit, label, 'grow, args, d) := {
    # the result is the address asked, and for 0 the start of the area that mmap gives
    emit(I{'mov, [D{d}, os_arg(args[0])]})
    map_it := label()
    done := label()
    emit(I{'cmp, [W{'w64}, U{d}, K{0}, ID{x64_reg_flags}]})
    emit(I{'jcc, [Cc{'ne}, L{done}, IU{x64_reg_flags}]})
    emit(I{'jmp, [L{map_it}]})
    emit(I{'label, [L{map_it}]})
    emit(I{'mov, [D{x64_reg_args[1]}, K{1}]})
    emit(I{'shl, [W{'w64}, DU{x64_reg_args[1]}, K{macos_heap_shift}, ID{x64_reg_flags}]})
    macos_x64_call(emit, macos_mmap, [K{0}, x64_reg_args[1], K{macos_mmap_prot}, K{macos_mmap_flags}, K{-1}, K{0}], d)
    emit(I{'jmp, [L{done}]})
    emit(I{'label, [L{done}]})
}
select_macos_x64(emit, label, 'args, args, d) := {
    emit(I{'mov, [D{d}, U{x64_reg_argv}]})
    emit(I{'add, [DU{d}, K{-8}, ID{x64_reg_flags}]})
}
select_macos_x64(emit, label, 'abort, args, d) := {
    emit(I{'mov, [D{x64_reg_number}, K{macos_class + macos_exit}]})
    emit(I{'mov, [D{x64_reg_args[0]}, K{abort_status}]})
    emit(I{'syscall, [IU{x64_reg_number}, IU{x64_reg_args[0]}, ID{x64_reg_number}, ID{x64_reg_rcx}, ID{x64_reg_r11}]})
    emit(I{'ud2, []})
}
select_macos_x64(emit, label, name, args, d) := panic(f"os.select_macos_x64: the service {symname(name)} is not known")

# === Linux on arm64 ===
# A system call is svc #0 with the number in x8 and the arguments in x0 to x5; the result is in x0, a negative number for an error, and no other register changes.
# open is openat with the directory AT_FDCWD (-100).
a64_reg_number_linux := 8
a64_reg_args := [0, 1, 2, 3, 4, 5]
a64_reg_result := 0
linux_a64_read := 63
linux_a64_write := 64
linux_a64_openat := 56
linux_a64_close := 57
linux_a64_exit := 93
linux_a64_exit_group := 94
linux_a64_brk := 214
linux_at_fdcwd := -100

# the registers of a system call: the number in the register numreg and the arguments
a64_load(emit, numreg, number, args) := {
    emit(I{'mov, [D{numreg}, K{number}]})
    k := 0
    each(a -> {
        emit(I{'mov, [D{a64_reg_args[k]}, os_arg(a)]})
        k = k + 1
    }, args)
}

# the instruction of the system call: svc with the immediate imm, which reads the number and the arguments and gives the result in x0
a64_svc(emit, imm, numreg, args) := emit(I{'svc, append([K{imm}, IU{numreg}, ID{a64_reg_result}], map(r -> IU{r}, list.take(a64_reg_args, length(args))))})

linux_a64_call(emit, number, args, d) := {
    a64_load(emit, a64_reg_number_linux, number, args)
    a64_svc(emit, 0, a64_reg_number_linux, args)
    if (d != none) emit(I{'mov, [D{d}, U{a64_reg_result}]})
}

export select_linux_arm64(emit, label, 'write, args, d) := linux_a64_call(emit, linux_a64_write, args, d)
select_linux_arm64(emit, label, 'read, args, d) := linux_a64_call(emit, linux_a64_read, args, d)
select_linux_arm64(emit, label, 'open, args, d) := linux_a64_call(emit, linux_a64_openat, append([K{linux_at_fdcwd}], append(args, [K{linux_o_rdonly}])), d)
select_linux_arm64(emit, label, 'create, args, d) := linux_a64_call(emit, linux_a64_openat, append([K{linux_at_fdcwd}], append(args, [K{linux_o_create}, K{linux_mode}])), d)
select_linux_arm64(emit, label, 'close, args, d) := linux_a64_call(emit, linux_a64_close, args, d)
select_linux_arm64(emit, label, 'exit, args, d) := linux_a64_call(emit, linux_a64_exit, args, d)
select_linux_arm64(emit, label, 'grow, args, d) := linux_a64_call(emit, linux_a64_brk, args, d)
# the program starts with the stack pointer at the word that holds the number of the arguments, which is the first of the arguments of the function _start
select_linux_arm64(emit, label, 'args, args, d) := emit(I{'lea, [W{'w64}, D{d}, MF{'arg, 0, 0}]})
select_linux_arm64(emit, label, 'abort, args, d) := {
    a64_load(emit, a64_reg_number_linux, linux_a64_exit_group, [K{abort_status}])
    a64_svc(emit, 0, a64_reg_number_linux, [K{abort_status}])
    emit(I{'ud2, []})
}
select_linux_arm64(emit, label, name, args, d) := panic(f"os.select_linux_arm64: the service {symname(name)} is not known")

# === macOS on arm64 ===
# The system calls are those of BSD, called by svc #0x80 with the number in x16 and the arguments in x0 to x5. An error is the flag of carry and the number of the error in x0 as a positive number;
# cneg makes it the negative number that Linux gives.
a64_reg_number_macos := 16

macos_a64_call(emit, number, args, d) := {
    a64_load(emit, a64_reg_number_macos, number, args)
    a64_svc(emit, 128, a64_reg_number_macos, args)
    emit(I{'cnegcs, [DU{a64_reg_result}]})
    if (d != none) emit(I{'mov, [D{d}, U{a64_reg_result}]})
}

export select_macos_arm64(emit, label, 'write, args, d) := macos_a64_call(emit, macos_write, args, d)
select_macos_arm64(emit, label, 'read, args, d) := macos_a64_call(emit, macos_read, args, d)
select_macos_arm64(emit, label, 'open, args, d) := macos_a64_call(emit, macos_open, append(args, [K{linux_o_rdonly}]), d)
select_macos_arm64(emit, label, 'create, args, d) := macos_a64_call(emit, macos_open, append(args, [K{macos_o_create}, K{linux_mode}]), d)
select_macos_arm64(emit, label, 'close, args, d) := macos_a64_call(emit, macos_close, args, d)
select_macos_arm64(emit, label, 'exit, args, d) := macos_a64_call(emit, macos_exit, args, d)
select_macos_arm64(emit, label, 'grow, args, d) := {
    # the result is the address asked, and for 0 the start of the area that mmap gives (see macOS on x86-64)
    emit(I{'mov, [D{d}, os_arg(args[0])]})
    map_it := label()
    done := label()
    emit(I{'jcc, [Cc{'ne}, L{done}, W{'w64}, U{d}, K{0}]})
    emit(I{'jmp, [L{map_it}]})
    emit(I{'label, [L{map_it}]})
    emit(I{'movabs, [D{a64_reg_args[1]}, K{0}, K{8}, K{0}, K{0}]})
    macos_a64_call(emit, macos_mmap, [K{0}, a64_reg_args[1], K{macos_mmap_prot}, K{macos_mmap_flags}, K{-1}, K{0}], d)
    emit(I{'jmp, [L{done}]})
    emit(I{'label, [L{done}]})
}
# dyld calls the program as main(argc, argv): the address of the arguments is the address of argv, which follows the word that holds their number
select_macos_arm64(emit, label, 'args, args, d) := emit(I{'sub, [W{'w64}, D{d}, U{1}, K{8}]})
select_macos_arm64(emit, label, 'abort, args, d) := {
    a64_load(emit, a64_reg_number_macos, macos_exit, [K{abort_status}])
    a64_svc(emit, 128, a64_reg_number_macos, [K{abort_status}])
    emit(I{'ud2, []})
}
select_macos_arm64(emit, label, name, args, d) := panic(f"os.select_macos_arm64: the service {symname(name)} is not known")

}
