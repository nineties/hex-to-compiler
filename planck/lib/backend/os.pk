use("base")
use("list")
use("backend/ir")

module os {

services := ['write, 'read, 'open, 'create, 'close, 'exit, 'grow, 'args, 'abort]

abort_status := 134

linux_o_rdonly := 0
linux_o_create := 577
linux_mode := 420

os_arg(a) := if (type(a) == Int) U{a} else a

x64_read := 0
x64_write := 1
x64_open := 2
x64_close := 3
x64_brk := 12
x64_exit := 60
x64_exit_group := 231

x64_reg_number := 0
x64_reg_args := [7, 6, 2, 10, 8, 9]
x64_reg_rcx := 1
x64_reg_r11 := 11

x64_reg_frame := 5
x64_frame_to_args := 8

x64_reg_flags := 16

x64_load(emit, number, args) := {
    emit(I{'mov, [D{x64_reg_number}, K{number}]})
    k := 0
    each(a -> {
        emit(I{'mov, [D{x64_reg_args[k]}, os_arg(a)]})
        k = k + 1
    }, args)
}

x64_call(emit, number, args, d) := {
    x64_load(emit, number, args)
    emit(I{'syscall, append([IU{x64_reg_number}, ID{x64_reg_number}, ID{x64_reg_rcx}, ID{x64_reg_r11}], map(r -> IU{r}, list.take(x64_reg_args, length(args))))})
    if (d != none) emit(I{'mov, [D{d}, U{x64_reg_number}]})
}

export select_linux_x64(emit, label, 'write, args, d) := x64_call(emit, x64_write, args, d)
select_linux_x64(emit, label, 'read, args, d) := x64_call(emit, x64_read, args, d)
select_linux_x64(emit, label, 'open, args, d) := x64_call(emit, x64_open, append(args, [K{linux_o_rdonly}]), d)
select_linux_x64(emit, label, 'create, args, d) := x64_call(emit, x64_open, append(args, [K{linux_o_create}, K{linux_mode}]), d)
select_linux_x64(emit, label, 'close, args, d) := x64_call(emit, x64_close, args, d)
select_linux_x64(emit, label, 'exit, args, d) := x64_call(emit, x64_exit, args, d)
select_linux_x64(emit, label, 'grow, args, d) := x64_call(emit, x64_brk, args, d)
select_linux_x64(emit, label, 'args, args, d) := {
    emit(I{'mov, [D{d}, U{x64_reg_frame}]})
    emit(I{'add, [DU{d}, K{x64_frame_to_args}, ID{x64_reg_flags}]})
}
select_linux_x64(emit, label, 'abort, args, d) := {
    emit(I{'mov, [D{x64_reg_number}, K{x64_exit_group}]})
    emit(I{'mov, [D{x64_reg_args[0]}, K{abort_status}]})
    emit(I{'syscall, [IU{x64_reg_number}, IU{x64_reg_args[0]}, ID{x64_reg_number}, ID{x64_reg_rcx}, ID{x64_reg_r11}]})
    emit(I{'ud2, []})
}
select_linux_x64(emit, label, name, args, d) := panic(f"os.select_linux_x64: the service {symname(name)} is not known")

}
