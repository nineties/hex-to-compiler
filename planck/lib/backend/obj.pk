# obj: relocatable objects, which hold named sections, symbols and relocations
# Copyright (C) 2026 nineties
#
# An object is Obj{name, secs, order, syms, rels}: secs is a table from the name of a section to Sec{name, kind, align, buf},
# order the names in the order they were made, syms a vector of Sym{name, sec, off, global}, and rels a vector of Rel{sec, off, kind, sym, addend}.
# kind of a section is 'code, 'data or 'bss. buf is a buffer of bytes.pk; a 'bss section holds zeros that the linker does not copy.
# A relocation writes a 32-bit value at off of the section: for 'Abs32 the address of sym plus addend,
# and for 'Pc32 the address of sym plus addend minus the address of the place that is written.
# A symbol that has a relocation and no definition in any object is left to the linker.

use("base")
use("list")
use("table")
use("vector")
use("bytes")

module obj {

export new(name) := Obj{name, table.new(), vector.new(), vector.new(), vector.new()}

export name(Obj{n, _, _, _, _}) := n

# sec(o, name, kind, align) is the section name of o, which is made when o has none
export sec(Obj{_, secs, order, _, _}, name, kind, align) := {
    s := table.get(secs, name, none)
    if (s == none) {
        s = Sec{name, kind, align, bytes.new()}
        table.set(secs, name, s)
        vector.push(order, name)
    }
    s
}

export buf(Sec{_, _, _, b}) := b

export sections(Obj{_, secs, order, _, _}) := map(n -> table.get(secs, n, none), vector.to_list(order))

export define(Obj{_, _, _, syms, _}, name, sec, off, global) := vector.push(syms, Sym{name, sec, off, global})

export reloc(Obj{_, _, _, _, rels}, sec, off, kind, sym, addend) := vector.push(rels, Rel{sec, off, kind, sym, addend})

export symbols(Obj{_, _, _, syms, _}) := vector.to_list(syms)
export relocs(Obj{_, _, _, _, rels}) := vector.to_list(rels)

# add_data(o, datas) adds the data IRData{name, sec, align, content, global} to the object o, where sec is ".data", ".rodata" or ".bss"
# and content a buffer (the size of a .bss object is the length of its buffer of zeros)
export add_data(o, datas) := each((IRData{n, secname, al, content, global}) -> {
    s := sec(o, secname, if (secname == ".bss") 'bss else 'data, 16)
    b := buf(s)
    bytes.align(b, al)
    define(o, n, secname, bytes.len(b), global)
    bytes.append(b, content)
}, datas)

}
