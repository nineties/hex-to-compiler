# x64: the x86-64 target of the code generator: instruction selection, the model of the scheduler,
# the register file, the frame of a function, and compile of a whole module to an object
# Copyright (C) 2026 nineties
#
# The input is a function of the machine independent form (ir_*, see ir.pk), with registers of 32 and 64 bits:
#   mov li la slota          [D, U] [D, K] [D, S] [D, K slot]
#   add sub mul band bor bxor shl shr sar divs divu rems remu mulhu   [D d, U a, U or K b]
#   neg not sx8 sx16 zx8 zx16                                         [D, U]
#   cmp                      [Cc, D, U a, U or K b]: d is 1 when a cc b, otherwise 0
#   ld                       [W{u8 s8 u16 s16 w32 w64}, D, memory]
#   st                       [W{w8 w16 w32 w64}, memory, U or K]
#   call                     [S name or U, Us args, Ds results]     (up to two results: rax and rdx)
#   os                       [N service, Us args, D result]: a service of the system (os.pk)
#   getarg                   [D, K i]: the i-th word of the arguments
#   ret [Us values], jmp [L], br [Cc, U a, U or K b, L yes, L no], trap, label [L]
#   zext64 sext64            [D 64-bit, U 32-bit]
#   trunc                    [D 32-bit, U 64-bit]
# ld and st with the width w64 take the memory operand of the register that holds the value.
# Memory operands are M{U base, disp}, MG{name, disp} and MF{'slot, n, disp}.
# A 32-bit value lives in a 64-bit register with its upper half 0, which every instruction that gives a 32-bit value keeps: a move of the 32-bit value from a physical
# register is movl, which is never taken out as a move between equal registers. An address is a 64-bit value.
# The calling convention: 8 bytes for each argument, the arguments are pushed from the last to the first and removed by the caller,
# the results are in rax and rdx, rbx and r12 to r15 are kept by the callee (and rbp, the frame pointer).
# The services of the system and trap are selected by os_select_x64 of os.pk.

use("base")
use("list")
use("table")
use("vector")
use("bytes")
use("backend/ir")
use("backend/cfg")
use("backend/sched")
use("backend/regalloc")
use("backend/obj")
use("backend/x64enc")
use("backend/os")

x64_commutative := ['add, 'mul, 'band, 'bor, 'bxor]

fun x64_select_one

# x64_select(f, code) is the instructions for x86-64 of the machine independent instructions code
x64_select(f, code) := {
    out := []
    emit := i -> { out = i :: out }
    each(i -> x64_select_one(f, emit, i), code)
    reverse(out)
}

x64_flags_def := ID{16}

# the width of a register: 'w64 for a physical register and a virtual register of 64 bits
x64_wd(f, r) := if (ir_is_vreg(r) and ir_width(f, r) == 32) 'w32 else 'w64

x64_select_one(f, emit, i) := {
    nv := w -> ir_vreg(f, if (w == 'w64) 64 else 32)
    wd := r -> x64_wd(f, r)
    # d = s for registers: a 32-bit value that comes from a physical register is made whole by a 32-bit move
    mov := (d, s) -> {
        if (ir_is_vreg(d)) {
            if (wd(d) == 'w32 and not ir_is_vreg(s)) emit(I{'movl, [D{d}, U{s}]})
            else emit(I{'mov, [W{wd(d)}, D{d}, U{s}]})
        } else emit(I{'mov, [W{wd(s)}, D{d}, U{s}]})
    }
    # d = a op b in the two-address form
    two := (op, d, a, b) -> {
        z := wd(d)
        if (a != d) mov(d, a)
        if (op == 'mul) {
            if (head(b) == 'K) {
                t := nv(z)
                emit(I{'mov, [W{z}, D{t}, b]})
                emit(I{'imul, [W{z}, DU{d}, U{t}, x64_flags_def]})
            } else emit(I{'imul, [W{z}, DU{d}, b, x64_flags_def]})
        } else if (op == 'shl or op == 'shr or op == 'sar) {
            if (head(b) == 'K) emit(I{op, [W{z}, DU{d}, K{bit_and(arg(b, 0), if (z == 'w64) 63 else 31)}, x64_flags_def]})
            else {
                mov(1, arg(b, 0))
                emit(I{op, [W{z}, DU{d}, IU{1}, x64_flags_def]})
            }
        } else emit(I{op, [W{z}, DU{d}, b, x64_flags_def]})
    }
    bin := (op, d, a, b) -> if (head(b) == 'U and arg(b, 0) == d and a != d) {
        if (member(op, x64_commutative)) two(op, d, d, U{a}) else {
            t := nv(wd(d))
            two(op, t, a, b)
            mov(d, t)
        }
    } else two(op, d, a, b)
    reg_of := (z, b) -> match b {
        U{r} -> r
      | K{n} -> {
            t := nv(z)
            emit(I{'mov, [W{z}, D{t}, b]})
            t
        }
    }
    # the instructions that os.pk gives, with the widths
    os_emit := j -> match j {
        I{'mov, [D{d}, U{s}]} -> mov(d, s)
      | I{'mov, [D{d}, K{n}]} -> emit(I{'mov, [W{if (ir_is_vreg(d)) wd(d) else if (n >= 0) 'w32 else 'w64}, D{d}, K{n}]})
      | I{'add, [DU{d}, K{n}, fl]} -> emit(I{'add, [W{wd(d)}, DU{d}, K{n}, fl]})
      | _ -> emit(j)
    }
    match i {
        I{'label, _} -> emit(i)
      | I{'mov, [D{d}, U{s}]} -> mov(d, s)
      | I{'li, [D{d}, K{n}]} -> emit(I{'mov, [W{wd(d)}, D{d}, K{n}]})
      | I{'la, [D{d}, S{name, off}]} -> emit(I{'lea, [W{'w64}, D{d}, MG{name, off}]})
      | I{'slota, [D{d}, K{n}]} -> emit(I{'lea, [W{'w64}, D{d}, MF{'slot, n, 0}]})
      | I{op, [D{d}, U{a}, b]} if member(op, ['add, 'sub, 'mul, 'band, 'bor, 'bxor, 'shl, 'shr, 'sar]) -> bin(op, d, a, b)
      | I{op, [D{d}, U{a}, b]} if member(op, ['divs, 'divu, 'rems, 'remu]) -> {
            z := wd(d)
            signed := op == 'divs or op == 'rems
            r := reg_of(z, b)
            mov(0, a)
            if (signed) emit(I{if (z == 'w64) 'cqo else 'cdq, [IU{0}, ID{2}]})
            else emit(I{'mov, [W{'w32}, D{2}, K{0}]})
            emit(I{if (signed) 'idiv else 'div, [W{z}, U{r}, IU{0}, IU{2}, ID{0}, ID{2}, x64_flags_def]})
            mov(d, if (op == 'divs or op == 'divu) 0 else 2)
        }
      | I{'neg, [D{d}, U{a}]} -> {
            if (a != d) mov(d, a)
            emit(I{'neg, [W{wd(d)}, DU{d}, x64_flags_def]})
        }
      | I{'not, [D{d}, U{a}]} -> {
            if (a != d) mov(d, a)
            emit(I{'not, [W{wd(d)}, DU{d}]})
        }
      | I{'zx8, [D{d}, U{a}]} -> bin('band, d, a, K{255})
      | I{'zx16, [D{d}, U{a}]} -> bin('band, d, a, K{65535})
      | I{'sx16, [D{d}, U{a}]} -> emit(I{'movsxw, [W{'w32}, D{d}, U{a}]})
      | I{'sx8, [D{d}, U{a}]} -> emit(I{'movsxb, [W{'w32}, D{d}, U{a}]})
      | I{'zext64, [D{d}, U{a}]} -> emit(I{'movl, [D{d}, U{a}]})
      | I{'sext64, [D{d}, U{a}]} -> emit(I{'movsxd, [D{d}, U{a}]})
      | I{'trunc, [D{d}, U{a}]} -> emit(I{'movl, [D{d}, U{a}]})
      | I{'cmp, [Cc{c}, D{d}, U{a}, b]} -> {
            t := nv('w32)
            emit(I{'cmp, [W{wd(a)}, U{a}, b, x64_flags_def]})
            emit(I{'setcc, [Cc{c}, D{t}, IU{16}]})
            emit(I{'movzxb, [W{'w32}, D{d}, U{t}]})
        }
      | I{'ld, [W{w}, D{d}, m]} -> match w {
            'u8 -> emit(I{'movzxb, [W{'w32}, D{d}, m]})
          | 's8 -> emit(I{'movsxb, [W{wd(d)}, D{d}, m]})
          | 'u16 -> emit(I{'movzxw, [W{'w32}, D{d}, m]})
          | 's16 -> emit(I{'movsxw, [W{wd(d)}, D{d}, m]})
          | 'w32 -> emit(I{'mov, [W{'w32}, D{d}, m]})
          | _ -> emit(I{'mov, [W{'w64}, D{d}, m]})
        }
      | I{'st, [W{w}, m, v]} -> match w {
            'w64 -> emit(I{'mov, [W{'w64}, m, v]})
          | 'w32 -> emit(I{'mov, [W{'w32}, m, v]})
          | 'w16 -> emit(I{'movw, [m, v]})
          | _ -> emit(I{'movb, [m, v]})
        }
      | I{'getarg, [D{d}, K{n}]} -> emit(I{'mov, [W{wd(d)}, D{d}, MF{'arg, n, 0}]})
      | I{'call, [callee, Us{args}, Ds{rets}]} -> {
            each(a -> emit(I{'push, [U{a}, ID{4}, IU{4}]}), reverse(args))
            emit(I{'call, [callee, ID{0}, ID{1}, ID{2}, ID{6}, ID{7}, ID{8}, ID{9}, ID{10}, ID{11}, x64_flags_def, ID{4}, IU{4}]})
            if (args != []) emit(I{'add, [W{'w64}, DU{4}, K{8 * length(args)}, x64_flags_def]})
            if (rets != []) mov(rets[0], 0)
            if (length(rets) > 1) mov(rets[1], 2)
        }
      | I{'os, [N{name}, Us{args}, D{d}]} -> os_select_x64(os_emit, name, args, d)
      | I{'ret, [Us{vals}]} -> {
            if (vals != []) mov(0, vals[0])
            if (length(vals) > 1) mov(2, vals[1])
            emit(I{'ret, map(r -> IU{r}, take([0, 2], length(vals)))})
        }
      | I{'jmp, _} -> emit(i)
      | I{'br, [Cc{c}, U{a}, b, L{t}, L{e}]} -> {
            emit(I{'cmp, [W{wd(a)}, U{a}, b, x64_flags_def]})
            emit(I{'jcc, [Cc{c}, L{t}, IU{16}]})
            emit(I{'jmp, [L{e}]})
        }
      | I{'trap, []} -> os_select_x64(os_emit, 'abort, [], none)
      | _ -> panic(f"x64_select: cannot select {ir_show(i)}")
    }
}

# === Scheduling ===
x64_is_memf(o) := member(head(o), ['M, 'MX, 'MG, 'MF])

# the memory the instruction touches: 'load, 'store, 'barrier or 'none
x64_effect(i) := match i {
    I{'mov, [W{_}, D{_}, m]} -> if (x64_is_memf(m)) 'load else 'none
  | I{'mov, [W{_}, m, _]} -> if (x64_is_memf(m)) 'store else 'none
  | I{op, [W{_}, D{_}, m]} if member(op, ['movzxb, 'movsxb, 'movzxw, 'movsxw]) -> if (x64_is_memf(m)) 'load else 'none
  | I{op, [m, _]} if member(op, ['movb, 'movw]) -> 'store
  | I{'push, _} -> 'store
  | I{'pop, _} -> 'load
  | I{'call, _} -> 'barrier
  | I{'syscall, _} -> 'barrier
  | _ -> 'none
}

x64_latency(i) := match ir_op(i) {
    'imul -> 3
  | 'mul -> 4
  | 'div -> 25
  | 'idiv -> 25
  | _ -> if (x64_effect(i) == 'load) 3 else 1
}

x64_sched_model := SchedModel{x64_latency, x64_effect}

# === Registers ===
# the registers that a call may change are given first; rbx and r12 to r15 are kept by the callee
x64_callee_saved := [3, 12, 13, 14, 15]
x64_ra := RATarget{[0, 1, 2, 6, 7, 8, 9, 10, 11, 3, 12, 13, 14, 15], table(),
    (r, slot) -> I{'mov, [W{'w64}, D{r}, MF{'slot, slot, 0}]}, (r, slot) -> I{'mov, [W{'w64}, MF{'slot, slot, 0}, U{r}]}, 8}

# === Frames ===
x64_align(n, a) := (n + a - 1) / a * a

x64_resolve(offs, o) := match o {
    MF{'arg, n, d} -> M{U{5}, 16 + 8 * n + d}
  | MF{'slot, n, d} -> M{U{5}, d - table_get(offs, n, 0)}
  | _ -> o
}

# x64_frame(f, code) adds the prologue and the epilogue to the allocated code and gives an address to each stack slot
x64_frame(f, code) := {
    defined := table()
    each(i -> each(r -> table_set(defined, r, true), ir_defs(i)), code)
    used := filter(r -> table_has(defined, r), x64_callee_saved)
    offs := table()
    off := 8 * length(used)
    n := 0
    each((Tuple{size, al}) -> {
        off = x64_align(off + size, al)
        table_set(offs, n, off)
        n = n + 1
    }, vec_to_list(table_get(ir_meta(f), 'slots, none)))
    total := x64_align(off, 16)
    save_at := r -> -8 * (index_of(r, used) + 1)
    prologue := append([I{'push, [U{5}, ID{4}, IU{4}]}, I{'mov, [W{'w64}, D{5}, U{4}]}],
        append(if (total > 0) [I{'sub, [W{'w64}, DU{4}, K{total}, x64_flags_def]}] else [],
            map(r -> I{'mov, [W{'w64}, M{U{5}, save_at(r)}, U{r}]}, used)))
    epilogue := append(map(r -> I{'mov, [W{'w64}, D{r}, M{U{5}, save_at(r)}]}, used),
        [I{'mov, [W{'w64}, D{4}, U{5}]}, I{'pop, [D{5}, ID{4}, IU{4}]}, I{'ret, []}])
    body := concat_map(i -> if (ir_op(i) == 'ret) epilogue else [I{ir_op(i), map(o -> x64_resolve(offs, o), ir_ops(i))}], code)
    append(prologue, body)
}

# === Functions and modules ===
x64_compile_fn(f, em) := {
    code := x64_select(f, ir_code(f))
    code = sched_code(code, x64_sched_model)
    g := ir_set_code(f, code)
    code = ra_allocate(g, x64_ra)
    code = x64_frame(g, code)
    obj_define(arg(em, 0), ir_name(f), ".text", em_pos(em), true)
    x64_emit_code(em, code)
}

# x64_compile(name, fns, datas) is an object of the functions (ir_fn) and the data (see obj_add_data of obj.pk)
x64_compile(name, fns, datas) := {
    o := obj_new(name)
    each(f -> x64_compile_fn(f, em_new(o, ".text")), fns)
    obj_add_data(o, datas)
    o
}
