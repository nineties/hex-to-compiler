# x64: the x86-64 target of the code generator: instruction selection, the model of the scheduler,
# the register file, the frame of a function, and compile of a whole module to an object
# Copyright (C) 2026 nineties
#
# The input is a function of the machine independent form (see ir.pk), with registers of 32 and 64 bits:
#   mov li la slota          [D, U] [D, K] [D, S] [D, K slot]
#   add sub mul band bor bxor shl shr sar divs divu rems remu mulhu   [D d, U a, U or K b]
#   neg not sx8 sx16 zx8 zx16                                         [D, U]
#   cmp                      [Cc, D, U a, U or K b]: d is 1 when a cc b, otherwise 0
#   ld                       [W{u8 s8 u16 s16 w32 w64}, D, memory]
#   st                       [W{w8 w16 w32 w64}, memory, U or K]
#   call                     [S name or U, Us args, Ds results]     (up to two results: rax and rdx)
#   os                       [N service, Us args, D result]: a service of the system (os.pk)
#   getarg                   [D, K i]: the i-th word of the arguments
#   ret [Us values], jmp [L], br [Cc, U a, U or K b, L yes, L no], trap, label [L]
#   zext64 sext64            [D 64-bit, U 32-bit]
#   trunc                    [D 32-bit, U 64-bit]
#   fadd fsub fmul fdiv      [W, D d, U a, U b]: a floating point number is kept in a register as its bits, 64 bits for the width w64 (a double)
#                            and 32 bits for w32 (a single); the operation works on xmm0 and xmm1, which no register of the code names
#   fsqrt                    [W, D, U]
#   fcmp                     [Cc{eq ne lt le gt ge}, W, D, U a, U b]: d is 1 when a cc b, otherwise 0; a comparison with a NaN is 0 except for ne
#   cvti2f                   [W of the result, D, U 64-bit signed integer]
#   cvtf2i                   [W of the operand, D 64-bit, U]: toward zero; the value that x86 gives (the least 64-bit integer) for a NaN or out of range
#   cvtf2f                   [W of the operand, D, U]: a double to a single, or a single to a double
#   li64                     [D 64-bit, K p3, K p2, K p1, K p0]: the integer p3 * 2^48 + p2 * 2^32 + p1 * 2^16 + p0, each part from 0 to 65535 (an integer of planck0 has 31 bits)
# ld and st with the width w64 take the memory operand of the register that holds the value.
# Memory operands are M{U base, disp}, MG{name, disp} and MF{'slot, n, disp}.
# A 32-bit value lives in a 64-bit register with its upper half 0, which every instruction that gives a 32-bit value keeps: a move of the 32-bit value from a physical
# register is movl, which is never taken out as a move between equal registers. An address is a 64-bit value.
# The calling convention: 8 bytes for each argument, the arguments are pushed from the last to the first and removed by the caller,
# the results are in rax and rdx, rbx and r12 to r15 are kept by the callee (and rbp, the frame pointer).
# The services of the system and trap are selected by os.select_x64 of os.pk.

use("base")
use("list")
use("table")
use("vector")
use("bytes")
use("backend/ir")
use("backend/cfg")
use("backend/sched")
use("backend/regalloc")
use("backend/obj")
use("backend/x86enc")
use("backend/x64enc")
use("backend/os")

module x64 {

commutative := ['add, 'mul, 'band, 'bor, 'bxor]

fun select_one

# select(f, code) is the instructions for x86-64 of the machine independent instructions code
select(f, code) := {
    out := []
    emit := i -> { out = i :: out }
    each(i -> select_one(f, emit, i), code)
    reverse(out)
}

flags_def := ID{16}

# xmm0 and xmm1 are the registers 17 and 18 of the code; they are not given out, and only the sequences of one operation use them
xmm_def(n) := ID{17 + n}
xmm_use(n) := IU{17 + n}

# the opcodes of the scalar operations of SSE2
sse_ops := [Tuple{'fadd, 88}, Tuple{'fmul, 89}, Tuple{'fsub, 92}, Tuple{'fdiv, 94}]

# the width of a register: 'w64 for a physical register and a virtual register of 64 bits
x64_wd(f, r) := if (ir.is_vreg(r) and ir.width(f, r) == 32) 'w32 else 'w64

select_one(f, emit, i) = {
    nv := w -> ir.vreg(f, if (w == 'w64) 64 else 32)
    wd := r -> x64_wd(f, r)
    # d = s for registers: a 32-bit value that comes from a physical register is made whole by a 32-bit move
    mov := (d, s) -> {
        if (ir.is_vreg(d)) {
            if (wd(d) == 'w32 and not ir.is_vreg(s)) emit(I{'movl, [D{d}, U{s}]})
            else emit(I{'mov, [W{wd(d)}, D{d}, U{s}]})
        } else emit(I{'mov, [W{wd(s)}, D{d}, U{s}]})
    }
    # d = a op b in the two-address form
    two := (op, d, a, b) -> {
        z := wd(d)
        if (a != d) mov(d, a)
        if (op == 'mul) {
            if (head(b) == 'K) {
                t := nv(z)
                emit(I{'mov, [W{z}, D{t}, b]})
                emit(I{'imul, [W{z}, DU{d}, U{t}, flags_def]})
            } else emit(I{'imul, [W{z}, DU{d}, b, flags_def]})
        } else if (op == 'shl or op == 'shr or op == 'sar) {
            if (head(b) == 'K) emit(I{op, [W{z}, DU{d}, K{bit_and(arg(b, 0), if (z == 'w64) 63 else 31)}, flags_def]})
            else {
                mov(1, arg(b, 0))
                emit(I{op, [W{z}, DU{d}, IU{1}, flags_def]})
            }
        } else emit(I{op, [W{z}, DU{d}, b, flags_def]})
    }
    bin := (op, d, a, b) -> if (head(b) == 'U and arg(b, 0) == d and a != d) {
        if (member(op, commutative)) two(op, d, d, U{a}) else {
            t := nv(wd(d))
            two(op, t, a, b)
            mov(d, t)
        }
    } else two(op, d, a, b)
    reg_of := (z, b) -> match b {
        U{r} -> r
      | K{n} -> {
            t := nv(z)
            emit(I{'mov, [W{z}, D{t}, b]})
            t
        }
    }
    # the instructions that os.pk gives, with the widths
    os_emit := j -> match j {
        I{'mov, [D{d}, U{s}]} -> mov(d, s)
      | I{'mov, [D{d}, K{n}]} -> emit(I{'mov, [W{if (ir.is_vreg(d)) wd(d) else if (n >= 0) 'w32 else 'w64}, D{d}, K{n}]})
      | I{'add, [DU{d}, K{n}, fl]} -> emit(I{'add, [W{wd(d)}, DU{d}, K{n}, fl]})
      | _ -> emit(j)
    }
    match i {
        I{'label, _} -> emit(i)
      | I{'mov, [D{d}, U{s}]} -> mov(d, s)
      | I{'li, [D{d}, K{n}]} -> emit(I{'mov, [W{wd(d)}, D{d}, K{n}]})
      | I{'li64, [D{d}, K{p3}, K{p2}, K{p1}, K{p0}]} -> {
            # up to 30 bits it is a 32-bit move, which clears the upper half
            if (p3 == 0 and p2 == 0 and p1 < 16384) emit(I{'mov, [W{'w32}, D{d}, K{p1 * 65536 + p0}]})
            else emit(I{'movabs, [D{d}, K{p3}, K{p2}, K{p1}, K{p0}]})
        }
      | I{'la, [D{d}, S{name, off}]} -> emit(I{'lea, [W{'w64}, D{d}, MG{name, off}]})
      | I{'slota, [D{d}, K{n}]} -> emit(I{'lea, [W{'w64}, D{d}, MF{'slot, n, 0}]})
      | I{op, [D{d}, U{a}, b]} if member(op, ['add, 'sub, 'mul, 'band, 'bor, 'bxor, 'shl, 'shr, 'sar]) -> bin(op, d, a, b)
      | I{op, [D{d}, U{a}, b]} if member(op, ['divs, 'divu, 'rems, 'remu]) -> {
            z := wd(d)
            signed := op == 'divs or op == 'rems
            r := reg_of(z, b)
            mov(0, a)
            if (signed) emit(I{if (z == 'w64) 'cqo else 'cdq, [IU{0}, ID{2}]})
            else emit(I{'mov, [W{'w32}, D{2}, K{0}]})
            emit(I{if (signed) 'idiv else 'div, [W{z}, U{r}, IU{0}, IU{2}, ID{0}, ID{2}, flags_def]})
            mov(d, if (op == 'divs or op == 'divu) 0 else 2)
        }
      | I{'neg, [D{d}, U{a}]} -> {
            if (a != d) mov(d, a)
            emit(I{'neg, [W{wd(d)}, DU{d}, flags_def]})
        }
      | I{'not, [D{d}, U{a}]} -> {
            if (a != d) mov(d, a)
            emit(I{'not, [W{wd(d)}, DU{d}]})
        }
      | I{'zx8, [D{d}, U{a}]} -> bin('band, d, a, K{255})
      | I{'zx16, [D{d}, U{a}]} -> bin('band, d, a, K{65535})
      | I{'sx16, [D{d}, U{a}]} -> emit(I{'movsxw, [W{'w32}, D{d}, U{a}]})
      | I{'sx8, [D{d}, U{a}]} -> emit(I{'movsxb, [W{'w32}, D{d}, U{a}]})
      | I{'zext64, [D{d}, U{a}]} -> emit(I{'movl, [D{d}, U{a}]})
      | I{'sext64, [D{d}, U{a}]} -> emit(I{'movsxd, [D{d}, U{a}]})
      | I{'trunc, [D{d}, U{a}]} -> emit(I{'movl, [D{d}, U{a}]})
      | I{'cmp, [Cc{c}, D{d}, U{a}, b]} -> {
            t := nv('w32)
            emit(I{'cmp, [W{wd(a)}, U{a}, b, flags_def]})
            emit(I{'setcc, [Cc{c}, D{t}, IU{16}]})
            emit(I{'movzxb, [W{'w32}, D{d}, U{t}]})
        }
      | I{'ld, [W{w}, D{d}, m]} -> match w {
            'u8 -> emit(I{'movzxb, [W{'w32}, D{d}, m]})
          | 's8 -> emit(I{'movsxb, [W{wd(d)}, D{d}, m]})
          | 'u16 -> emit(I{'movzxw, [W{'w32}, D{d}, m]})
          | 's16 -> emit(I{'movsxw, [W{wd(d)}, D{d}, m]})
          | 'w32 -> emit(I{'mov, [W{'w32}, D{d}, m]})
          | _ -> emit(I{'mov, [W{'w64}, D{d}, m]})
        }
      | I{'st, [W{w}, m, v]} -> match w {
            'w64 -> emit(I{'mov, [W{'w64}, m, v]})
          | 'w32 -> emit(I{'mov, [W{'w32}, m, v]})
          | 'w16 -> emit(I{'movw, [m, v]})
          | _ -> emit(I{'movb, [m, v]})
        }
      | I{op, [W{z}, D{d}, U{a}, U{b}]} if member(op, ['fadd, 'fsub, 'fmul, 'fdiv]) -> {
            emit(I{'xin, [W{z}, K{0}, U{a}, xmm_def(0)]})
            emit(I{'xin, [W{z}, K{1}, U{b}, xmm_def(1)]})
            emit(I{'sse, [W{z}, K{arg(find(e -> arg(e, 0) == op, sse_ops), 1)}, xmm_def(0), xmm_use(0), xmm_use(1)]})
            emit(I{'xout, [W{z}, D{d}, K{0}, xmm_use(0)]})
        }
      | I{'fsqrt, [W{z}, D{d}, U{a}]} -> {
            emit(I{'xin, [W{z}, K{1}, U{a}, xmm_def(1)]})
            emit(I{'sse, [W{z}, K{81}, xmm_def(0), xmm_use(1)]})
            emit(I{'xout, [W{z}, D{d}, K{0}, xmm_use(0)]})
        }
      | I{'fcmp, [Cc{c}, W{z}, D{d}, U{a}, U{b}]} -> {
            # ucomis sets the flags of an unsigned comparison; with a NaN it sets zero, parity and carry. The above and above-or-equal
            # conditions are false with a NaN, so a < b is b > a with the operands exchanged.
            swap := c == 'lt or c == 'le
            emit(I{'xin, [W{z}, K{0}, U{if (swap) b else a}, xmm_def(0)]})
            emit(I{'xin, [W{z}, K{1}, U{if (swap) a else b}, xmm_def(1)]})
            emit(I{'ucomi, [W{z}, xmm_use(0), xmm_use(1), flags_def]})
            t := nv('w32)
            emit(I{'setcc, [Cc{if (c == 'gt or c == 'lt) 'gtu else if (c == 'ge or c == 'le) 'geu else c}, D{t}, IU{16}]})
            if (c == 'eq or c == 'ne) {
                # equal and ordered, or unequal or unordered
                p := nv('w32)
                emit(I{'setcc, [Cc{if (c == 'eq) 'np else 'p}, D{p}, IU{16}]})
                t1 := nv('w32)
                p1 := nv('w32)
                emit(I{'movzxb, [W{'w32}, D{t1}, U{t}]})
                emit(I{'movzxb, [W{'w32}, D{p1}, U{p}]})
                bin(if (c == 'eq) 'band else 'bor, d, t1, U{p1})
            } else emit(I{'movzxb, [W{'w32}, D{d}, U{t}]})
        }
      | I{'cvti2f, [W{z}, D{d}, U{a}]} -> {
            emit(I{'cvtsi2f, [W{z}, U{a}, xmm_def(0)]})
            emit(I{'xout, [W{z}, D{d}, K{0}, xmm_use(0)]})
        }
      | I{'cvtf2i, [W{z}, D{d}, U{a}]} -> {
            emit(I{'xin, [W{z}, K{0}, U{a}, xmm_def(0)]})
            emit(I{'cvttf2si, [W{z}, D{d}, xmm_use(0)]})
        }
      | I{'cvtf2f, [W{z}, D{d}, U{a}]} -> {
            emit(I{'xin, [W{z}, K{0}, U{a}, xmm_def(0)]})
            emit(I{'cvtf2f, [W{z}, xmm_def(0), xmm_use(0)]})
            emit(I{'xout, [W{if (z == 'w64) 'w32 else 'w64}, D{d}, K{0}, xmm_use(0)]})
        }
      | I{'getarg, [D{d}, K{n}]} -> emit(I{'mov, [W{wd(d)}, D{d}, MF{'arg, n, 0}]})
      | I{'call, [callee, Us{args}, Ds{rets}]} -> {
            each(a -> emit(I{'push, [U{a}, ID{4}, IU{4}]}), reverse(args))
            emit(I{'call, [callee, ID{0}, ID{1}, ID{2}, ID{6}, ID{7}, ID{8}, ID{9}, ID{10}, ID{11}, flags_def, ID{4}, IU{4}]})
            if (args != []) emit(I{'add, [W{'w64}, DU{4}, K{8 * length(args)}, flags_def]})
            if (rets != []) mov(rets[0], 0)
            if (length(rets) > 1) mov(rets[1], 2)
        }
      | I{'os, [N{name}, Us{args}, D{d}]} -> os.select_x64(os_emit, name, args, d)
      | I{'ret, [Us{vals}]} -> {
            if (vals != []) mov(0, vals[0])
            if (length(vals) > 1) mov(2, vals[1])
            emit(I{'ret, map(r -> IU{r}, list.take([0, 2], length(vals)))})
        }
      | I{'jmp, _} -> emit(i)
      | I{'br, [Cc{c}, U{a}, b, L{t}, L{e}]} -> {
            emit(I{'cmp, [W{wd(a)}, U{a}, b, flags_def]})
            emit(I{'jcc, [Cc{c}, L{t}, IU{16}]})
            emit(I{'jmp, [L{e}]})
        }
      | I{'trap, []} -> os.select_x64(os_emit, 'abort, [], none)
      | _ -> panic(f"x64.select: cannot select {ir.show(i)}")
    }
}

# === Scheduling ===
is_memf(o) := member(head(o), ['M, 'MX, 'MG, 'MF])

# the memory the instruction touches: 'load, 'store, 'barrier or 'none
effect(I{'mov, [W{_}, D{_}, m]}) := if (is_memf(m)) 'load else 'none
effect(I{'mov, [W{_}, m, _]}) := if (is_memf(m)) 'store else 'none
effect(I{op, [W{_}, D{_}, m]}) if member(op, ['movzxb, 'movsxb, 'movzxw, 'movsxw]) := if (is_memf(m)) 'load else 'none
effect(I{op, [m, _]}) if member(op, ['movb, 'movw]) := 'store
effect(I{'push, _}) := 'store
effect(I{'pop, _}) := 'load
effect(I{'call, _}) := 'barrier
effect(I{'syscall, _}) := 'barrier
effect(_) := 'none

latency(i) := match ir.op(i) {
    'imul -> 3
  | 'mul -> 4
  | 'div -> 25
  | 'idiv -> 25
  | _ -> if (effect(i) == 'load) 3 else 1
}

sched_model := SchedModel{latency, effect}

# === Registers ===
# the registers that a call may change are given first; rbx and r12 to r15 are kept by the callee
callee_saved := [3, 12, 13, 14, 15]
ra := RATarget{[0, 1, 2, 6, 7, 8, 9, 10, 11, 3, 12, 13, 14, 15], table.new(),
    (r, slot) -> I{'mov, [W{'w64}, D{r}, MF{'slot, slot, 0}]}, (r, slot) -> I{'mov, [W{'w64}, MF{'slot, slot, 0}, U{r}]}, 8}

# === Frames ===
align(n, a) := (n + a - 1) / a * a

resolve(offs, MF{'arg, n, d}) := M{U{5}, 16 + 8 * n + d}
resolve(offs, MF{'slot, n, d}) := M{U{5}, d - table.get(offs, n, 0)}
resolve(offs, o) := o

# frame(f, code) adds the prologue and the epilogue to the allocated code and gives an address to each stack slot
frame(f, code) := {
    defined := table.new()
    each(i -> each(r -> table.set(defined, r, true), ir.defs(i)), code)
    used := filter(r -> table.has(defined, r), callee_saved)
    offs := table.new()
    off := 8 * length(used)
    n := 0
    each((Tuple{size, al}) -> {
        off = align(off + size, al)
        table.set(offs, n, off)
        n = n + 1
    }, vector.to_list(table.get(ir.meta(f), 'slots, none)))
    total := align(off, 16)
    save_at := r -> -8 * (list.index_of(r, used) + 1)
    prologue := append([I{'push, [U{5}, ID{4}, IU{4}]}, I{'mov, [W{'w64}, D{5}, U{4}]}],
        append(if (total > 0) [I{'sub, [W{'w64}, DU{4}, K{total}, flags_def]}] else [],
            map(r -> I{'mov, [W{'w64}, M{U{5}, save_at(r)}, U{r}]}, used)))
    epilogue := append(map(r -> I{'mov, [W{'w64}, D{r}, M{U{5}, save_at(r)}]}, used),
        [I{'mov, [W{'w64}, D{4}, U{5}]}, I{'pop, [D{5}, ID{4}, IU{4}]}, I{'ret, []}])
    body := concat_map(i -> if (ir.op(i) == 'ret) epilogue else [I{ir.op(i), map(o -> resolve(offs, o), ir.ops(i))}], code)
    append(prologue, body)
}

# === Functions and modules ===
compile_fn(f, em) := {
    code := select(f, ir.code(f))
    code = sched.code(code, sched_model)
    g := ir.set_code(f, code)
    code = regalloc.allocate(g, ra)
    code = frame(g, code)
    obj.define(arg(em, 0), ir.name(f), ".text", x86enc.pos(em), true)
    x64enc.emit_code(em, code)
}

# compile(name, fns, datas) is an object of the functions (ir.fn) and the data (see obj.add_data of obj.pk)
export compile(name, fns, datas) := {
    o := obj.new(name)
    each(f -> compile_fn(f, x86enc.new(o, ".text")), fns)
    obj.add_data(o, datas)
    o
}

# the selection of instructions
test {
    w32 := W{'w32}
    w64 := W{'w64}
    f := ir.fn("t")
    a := ir.vreg(f, 32)
    b := ir.vreg(f, 64)
    sel(is) := select(f, is)
    # a 32-bit move and a 64-bit one; the extensions are moves that stay
    assert(sel([I{'mov, [D{a}, U{a + 0}]}]) == [I{'mov, [w32, D{a}, U{a}]}], "a 32-bit move")
    assert(sel([I{'zext64, [D{b}, U{a}]}]) == [I{'movl, [D{b}, U{a}]}], "zext64")
    assert(sel([I{'sext64, [D{b}, U{a}]}]) == [I{'movsxd, [D{b}, U{a}]}], "sext64")
    assert(sel([I{'trunc, [D{a}, U{b}]}]) == [I{'movl, [D{a}, U{b}]}], "trunc")
    # a 32-bit value that comes from a physical register is made whole
    assert(sel([I{'mov, [D{a}, U{0}]}]) == [I{'movl, [D{a}, U{0}]}], "a 32-bit value from a physical register")
    assert(sel([I{'li, [D{b}, K{5}]}]) == [I{'mov, [w64, D{b}, K{5}]}], "li")
    assert(sel([I{'ld, [W{'w32}, D{a}, M{U{b}, 4}]}]) == [I{'mov, [w32, D{a}, M{U{b}, 4}]}], "a 32-bit load")
    assert(sel([I{'ld, [W{'w64}, D{b}, M{U{b}, 8}]}]) == [I{'mov, [w64, D{b}, M{U{b}, 8}]}], "a 64-bit load")
    assert(sel([I{'getarg, [D{b}, K{2}]}]) == [I{'mov, [w64, D{b}, MF{'arg, 2, 0}]}], "getarg")
    # an integer of 64 bits in four parts: a move of 32 bits when it is small, and movabs otherwise
    assert(sel([I{'li64, [D{b}, K{16368}, K{0}, K{0}, K{0}]}]) == [I{'movabs, [D{b}, K{16368}, K{0}, K{0}, K{0}]}], "li64")
    assert(sel([I{'li64, [D{b}, K{0}, K{0}, K{5}, K{7}]}]) == [I{'mov, [w32, D{b}, K{327687}]}], "li64 of a small integer")
    # a floating point operation moves the operands to xmm0 and xmm1, which the instructions do not name, and the result back
    c := ir.vreg(f, 64)
    assert(sel([I{'fadd, [w64, D{c}, U{b}, U{b + 0}]}]) == [I{'xin, [w64, K{0}, U{b}, ID{17}]}, I{'xin, [w64, K{1}, U{b}, ID{18}]},
        I{'sse, [w64, K{88}, ID{17}, IU{17}, IU{18}]}, I{'xout, [w64, D{c}, K{0}, IU{17}]}], "fadd")
    assert(ir.explicit(sel([I{'fsqrt, [w32, D{a}, U{a + 0}]}])[1]) == [w32, K{81}], "fsqrt")
    assert(list.any(i -> ir.op(i) == 'ucomi, sel([I{'fcmp, [Cc{'eq}, w64, D{a}, U{b}, U{b + 0}]}])), "fcmp")
}

# the loads start first so that the additions do not wait
test {
    ld1 := I{'mov, [W{'w64}, D{40}, M{U{33}, 0}]}
    ad1 := I{'add, [W{'w64}, DU{40}, K{1}, flags_def]}
    ld2 := I{'mov, [W{'w64}, D{41}, M{U{34}, 0}]}
    ad2 := I{'add, [W{'w64}, DU{41}, K{1}, flags_def]}
    assert(sched.code([ld1, ad1, ld2, ad2], sched_model) == [ld1, ld2, ad1, ad2], "the loads come first")
    # a store stays between the loads that it separates
    st1 := I{'mov, [W{'w64}, M{U{35}, 0}, U{40}]}
    ld3 := I{'mov, [W{'w64}, D{42}, M{U{36}, 0}]}
    assert(sched.code([ld1, st1, ld3], sched_model) == [ld1, st1, ld3], "a store stays between loads")
    # the label and the terminator stay at the ends of a block
    blk := [I{'label, [L{3}]}, ld1, ad1, ld2, ad2, I{'ret, [IU{0}]}]
    assert(sched.code(blk, sched_model) == [I{'label, [L{3}]}, ld1, ld2, ad1, ad2, I{'ret, [IU{0}]}], "the label and the terminator stay")
}

# a straight line code is run to see that the allocation keeps the result: values on the stack are in mem
test {
    run(code) := {
        regs := table.new()
        mem := table.new()
        val := o -> match o {
            K{n} -> n
          | U{r} -> table.get(regs, r, 0)
          | MF{k, n, d} -> table.get(mem, Tuple{k, n, d}, 0)
        }
        each(i -> match i {
            I{'mov, [D{d}, s]} -> table.set(regs, d, val(s))
          | I{'mov, [MF{k, n, d}, s]} -> table.set(mem, Tuple{k, n, d}, val(s))
          | I{'mov, [W{_}, D{d}, s]} -> table.set(regs, d, val(s))
          | I{'mov, [W{_}, MF{k, n, d}, s]} -> table.set(mem, Tuple{k, n, d}, val(s))
          | I{'add, [DU{d}, s, _]} -> table.set(regs, d, table.get(regs, d, 0) + val(s))
          | I{'ret, _} -> none
        }, code)
        table.get(regs, 0, 0)
    }
    f := ir.fn("t")
    vs := map(i -> ir.vreg(f, 64), range(0, 16))
    acc := ir.vreg(f, 64)
    each((Tuple{v, n}) -> ir.emit(f, I{'mov, [D{v}, K{n}]}), list.zip(vs, range(1, 17)))
    ir.emit(f, I{'mov, [D{acc}, K{0}]})
    each(v -> ir.emit(f, I{'add, [DU{acc}, U{v}, flags_def]}), vs)
    ir.emit(f, I{'mov, [D{0}, U{acc}]})
    ir.emit(f, I{'ret, [IU{0}]})
    allocated := regalloc.allocate(f, ra)
    assert(not list.any(i -> list.any(r -> ir.is_vreg(r), append(ir.uses(i), ir.defs(i))), allocated), "no virtual register is left")
    assert(run(allocated) == 136, "the allocation keeps the result")
    # seventeen values do not fit in fourteen registers, so some are kept in stack slots
    assert(list.any(i -> list.any(o -> head(o) == 'MF, ir.explicit(i)), allocated), "some values are in stack slots")
    assert(length(vector.to_list(table.get(ir.meta(f), 'slots, none))) > 0, "the function has stack slots")
}

}
