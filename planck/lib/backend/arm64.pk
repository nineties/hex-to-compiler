# arm64: the arm64 target of the code generator: instruction selection, the model of the scheduler,
# the register file, the frame of a function, and compile of a whole module to an object
# Copyright (C) 2026 nineties
#
# The input is a function of the machine independent form (see x64.pk for the list of the instructions), with registers of 32 and 64 bits. The instructions that come out
# are those of a64enc.pk: three operands, an integer wherever the machine takes it and otherwise a register that the encoder loads.
# The registers 0 to 30 are x0 to x30. A 32-bit value lives in a 64-bit register with its upper half 0, which every instruction that gives a 32-bit value keeps.
# The calling convention: 8 bytes for each argument, the arguments are stored from the last to the first on the stack that the caller makes room for (a multiple of 16 bytes),
# the results are in x0 and x1, x0 to x15 are changed by a call and x19 to x28 are kept by the callee (and x29, the frame pointer, and x30, the link register).
# x16 and x17 are the registers of the encoder, x18 is the register of the platform and x29 and x30 hold the frame; none of them is given out.
# The frame of a function: the stack pointer is moved down by the size of the frame, x29 and x30 are stored at the bottom, x29 is set to the stack pointer, and then come the registers
# that the function keeps and its stack slots; the arguments of the function are above the frame.
# The services of the system and trap are selected by sys(emit, label, name, args, d), which is a function of os.pk for the system of the target.

use("base")
use("list")
use("table")
use("vector")
use("bytes")
use("backend/ir")
use("backend/cfg")
use("backend/sched")
use("backend/regalloc")
use("backend/object")
use("backend/a64enc")
use("backend/os")

module arm64 {

fun select_one

# select(sys, f, code) is the instructions for arm64 of the machine independent instructions code, with the system sys
select(sys, f, code) := {
    out := []
    emit := i -> { out = i :: out }
    each(i -> select_one(sys, f, emit, i), code)
    reverse(out)
}

# the width of a register: 'w64 for a physical register and a virtual register of 64 bits
a64_wd(f, r) := if (ir.is_vreg(r) and ir.width(f, r) == 32) 'w32 else 'w64

# the stack pointer, which the arguments of a call are stored at
sp := 31

select_one(sys, f, emit, i) = {
    nv := w -> ir.vreg(f, if (w == 'w64) 64 else 32)
    wd := r -> a64_wd(f, r)
    # d = s for registers: a 32-bit value that comes from a physical register is made whole by a 32-bit move
    mov := (d, s) -> {
        if (ir.is_vreg(d)) {
            if (wd(d) == 'w32 and not ir.is_vreg(s)) emit(I{'movl, [D{d}, U{s}]})
            else emit(I{'mov, [W{wd(d)}, D{d}, U{s}]})
        } else emit(I{'mov, [W{wd(s)}, D{d}, U{s}]})
    }
    # the instructions that os.pk gives, with the widths
    os_emit := j -> match j {
        I{'mov, [D{d}, U{s}]} -> mov(d, s)
      | I{'mov, [D{d}, K{n}]} -> emit(I{'mov, [W{if (ir.is_vreg(d)) wd(d) else if (n >= 0) 'w32 else 'w64}, D{d}, K{n}]})
      | _ -> emit(j)
    }
    match i {
        I{'label, _} -> emit(i)
      | I{'mov, [D{d}, U{s}]} -> mov(d, s)
      | I{'li, [D{d}, K{n}]} -> emit(I{'mov, [W{wd(d)}, D{d}, K{n}]})
      | I{'li64, [D{d}, K{p3}, K{p2}, K{p1}, K{p0}]} -> {
            # up to 30 bits it is a 32-bit move, which clears the upper half
            if (p3 == 0 and p2 == 0 and p1 < 16384) emit(I{'mov, [W{'w32}, D{d}, K{p1 * 65536 + p0}]})
            else emit(I{'movabs, [D{d}, K{p3}, K{p2}, K{p1}, K{p0}]})
        }
      | I{'la, [D{d}, S{name, off}]} -> emit(I{'lea, [W{'w64}, D{d}, MG{name, off}]})
      | I{'slota, [D{d}, K{n}]} -> emit(I{'lea, [W{'w64}, D{d}, MF{'slot, n, 0}]})
      | I{op, [D{d}, U{a}, b]} if member(op, ['add, 'sub, 'mul, 'band, 'bor, 'bxor, 'divs, 'divu, 'rems, 'remu]) -> emit(I{op, [W{wd(d)}, D{d}, U{a}, b]})
      | I{op, [D{d}, U{a}, b]} if member(op, ['shl, 'shr, 'sar]) -> {
            z := wd(d)
            emit(I{op, [W{z}, D{d}, U{a}, if (head(b) == 'K) K{bit_and(arg(b, 0), if (z == 'w64) 63 else 31)} else b]})
        }
      | I{'mulhu, [D{d}, U{a}, b]} -> emit(I{'mulhu, [W{'w64}, D{d}, U{a}, b]})
      | I{op, [D{d}, U{a}]} if member(op, ['neg, 'not]) -> emit(I{op, [W{wd(d)}, D{d}, U{a}]})
      | I{op, [D{d}, U{a}]} if member(op, ['sx8, 'sx16, 'zx8, 'zx16, 'sext64]) -> emit(i)
      | I{'zext64, [D{d}, U{a}]} -> emit(I{'movl, [D{d}, U{a}]})
      | I{'trunc, [D{d}, U{a}]} -> emit(I{'movl, [D{d}, U{a}]})
      | I{'cmp, [Cc{c}, D{d}, U{a}, b]} -> emit(I{'cset, [Cc{c}, W{wd(a)}, D{d}, U{a}, b]})
      | I{'ld, [W{w}, D{d}, m]} -> match w {
            's8 -> emit(I{'ldr, [W{if (wd(d) == 'w64) 'sb64 else 'sb32}, D{d}, m]})
          | 's16 -> emit(I{'ldr, [W{if (wd(d) == 'w64) 'sh64 else 'sh32}, D{d}, m]})
          | _ -> emit(I{'ldr, [W{w}, D{d}, m]})
        }
      | I{'st, [W{w}, m, v]} -> emit(I{'str, [W{w}, m, v]})
      | I{op, [W{z}, D{d}, U{a}, U{b}]} if member(op, ['fadd, 'fsub, 'fmul, 'fdiv]) -> emit(i)
      | I{op, [W{z}, D{d}, U{a}]} if member(op, ['fsqrt, 'cvti2f, 'cvtf2i, 'cvtf2f]) -> emit(i)
      | I{'fcmp, [Cc{c}, W{z}, D{d}, U{a}, U{b}]} -> emit(i)
      | I{'getarg, [D{d}, K{n}]} -> emit(I{'ldr, [W{wd(d)}, D{d}, MF{'arg, n, 0}]})
      | I{'call, [callee, Us{args}, Ds{rets}]} -> {
            n := length(args)
            size := (8 * n + 15) / 16 * 16
            if (size > 0) emit(I{'spadj, [K{0 - size}, ID{sp}, IU{sp}]})
            k := 0
            each(a -> {
                emit(I{'str, [W{'w64}, M{U{sp}, 8 * k}, U{a}]})
                k = k + 1
            }, args)
            clobbers := map(r -> ID{r}, range(0, 16))
            match callee {
                S{name, _} -> emit(I{'bl, append([callee, IU{sp}], clobbers)})
              | U{r} -> emit(I{'blr, append([callee, IU{sp}], clobbers)})
            }
            if (size > 0) emit(I{'spadj, [K{size}, ID{sp}, IU{sp}]})
            if (rets != []) mov(rets[0], 0)
            if (length(rets) > 1) mov(rets[1], 1)
        }
      | I{'os, [N{name}, Us{args}, D{d}]} -> sys(os_emit, () -> ir.label(f), name, args, d)
      | I{'ret, [Us{values}]} -> {
            if (values != []) mov(0, values[0])
            if (length(values) > 1) mov(1, values[1])
            emit(I{'ret, map(r -> IU{r}, list.take([0, 1], length(values)))})
        }
      | I{'jmp, _} -> emit(i)
      | I{'br, [Cc{c}, U{a}, b, L{t}, L{e}]} -> {
            emit(I{'jcc, [Cc{c}, L{t}, W{wd(a)}, U{a}, b]})
            emit(I{'jmp, [L{e}]})
        }
      | I{'trap, []} -> sys(os_emit, () -> ir.label(f), 'abort, [], none)
      | _ -> panic(f"arm64.select: cannot select {ir.show(i)}")
    }
}

# === Scheduling ===
is_memf(o) := member(head(o), ['M, 'MX, 'MG, 'MF])

# the memory the instruction touches: 'load, 'store, 'barrier or 'none
effect(I{'ldr, _}) := 'load
effect(I{'str, _}) := 'store
effect(I{'bl, _}) := 'barrier
effect(I{'blr, _}) := 'barrier
effect(I{'svc, _}) := 'barrier
effect(_) := 'none

latency(i) := match ir.op(i) {
    'mul -> 3
  | 'mulhu -> 4
  | 'divs -> 20
  | 'divu -> 20
  | 'rems -> 22
  | 'remu -> 22
  | 'ldr -> 4
  | _ -> 1
}

sched_model := SchedModel{latency, effect}

# === Registers ===
# the registers that a call may change are given first; x19 to x28 are kept by the callee
callee_saved := range(19, 29)
ra := RATarget{append(range(0, 16), callee_saved), table.new(),
    (r, slot) -> I{'ldr, [W{'w64}, D{r}, MF{'slot, slot, 0}]}, (r, slot) -> I{'str, [W{'w64}, MF{'slot, slot, 0}, U{r}]}, 8}

# === Frames ===
align(n, a) := (n + a - 1) / a * a

resolve(total, offs, MF{'arg, n, d}) := M{U{29}, total + 8 * n + d}
resolve(total, offs, MF{'slot, n, d}) := M{U{29}, table.get(offs, n, 0) + d}
resolve(total, offs, o) := o

# frame(f, code) adds the prologue and the epilogue to the allocated code and gives an address to each stack slot
frame(f, code) := {
    defined := table.new()
    each(i -> each(r -> table.set(defined, r, true), ir.defs(i)), code)
    used := filter(r -> table.has(defined, r), callee_saved)
    offs := table.new()
    off := 16 + 8 * length(used)
    n := 0
    each((Tuple{size, al}) -> {
        start := align(off, al)
        table.set(offs, n, start)
        off = start + size
        n = n + 1
    }, vector.to_list(table.get(ir.meta(f), 'slots, none)))
    total := align(off, 16)
    save_at := r -> 16 + 8 * list.index_of(r, used)
    prologue := append([I{'spadj, [K{0 - total}]}, I{'stpfp, []}, I{'setfp, []}],
        map(r -> I{'str, [W{'w64}, M{U{29}, save_at(r)}, U{r}]}, used))
    epilogue := append(map(r -> I{'ldr, [W{'w64}, D{r}, M{U{29}, save_at(r)}]}, used),
        [I{'ldpfp, []}, I{'spadj, [K{total}]}, I{'ret, []}])
    body := concat_map(i -> if (ir.op(i) == 'ret) epilogue else [I{ir.op(i), map(o -> resolve(total, offs, o), ir.ops(i))}], code)
    append(prologue, body)
}

# === Functions and modules ===
compile_fun(sys, f, em) := {
    code := select(sys, f, ir.code(f))
    code = sched.code(code, sched_model)
    g := ir.set_code(f, code)
    code = regalloc.allocate(g, ra)
    code = frame(g, code)
    object.define(arg(em, 0), ir.name(f), ".text", a64enc.pos(em), true)
    a64enc.emit_code(em, code)
}

# compile(sys, name, funs, datas) is an object of the functions (ir.fun) and the data (see object.add_data of object.pk), for the system sys
export compile(sys, name, funs, datas) := {
    o := object.new(name)
    each(f -> compile_fun(sys, f, a64enc.new(o, ".text")), funs)
    object.add_data(o, datas)
    o
}

# the selection of instructions
test {
    f := ir.fn("t")
    a := ir.vreg(f, 32)
    b := ir.vreg(f, 64)
    sel(is) := select(os.select_linux_arm64, f, is)
    w32 := W{'w32}
    w64 := W{'w64}
    assert(sel([I{'mov, [D{a}, U{a + 0}]}]) == [I{'mov, [w32, D{a}, U{a}]}], "a 32-bit move")
    assert(sel([I{'zext64, [D{b}, U{a}]}]) == [I{'movl, [D{b}, U{a}]}], "zext64")
    assert(sel([I{'mov, [D{a}, U{0}]}]) == [I{'movl, [D{a}, U{0}]}], "a 32-bit value from a physical register")
    assert(sel([I{'li, [D{b}, K{5}]}]) == [I{'mov, [w64, D{b}, K{5}]}], "li")
    assert(sel([I{'add, [D{b}, U{b + 0}, K{1}]}]) == [I{'add, [w64, D{b}, U{b}, K{1}]}], "add keeps three operands")
    assert(sel([I{'shl, [D{a}, U{a + 0}, K{33}]}]) == [I{'shl, [w32, D{a}, U{a}, K{1}]}], "the count of a shift is cut to the width")
    assert(sel([I{'ld, [W{'s8}, D{a}, M{U{b}, 4}]}]) == [I{'ldr, [W{'sb32}, D{a}, M{U{b}, 4}]}], "a load with the sign")
    assert(sel([I{'li64, [D{b}, K{0}, K{0}, K{5}, K{7}]}]) == [I{'mov, [w32, D{b}, K{327687}]}], "li64 of a small integer")
    assert(sel([I{'getarg, [D{b}, K{2}]}]) == [I{'ldr, [W{'w64}, D{b}, MF{'arg, 2, 0}]}], "getarg")
}

}
