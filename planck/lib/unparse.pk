# Copyright (C) 2026 nineties

use("base")
use("list")
use("string")
use("table")
use("pretty")

module unparse {

bad := Bad{}
is_mx(x) := type(x) == Expr

no_at(t, nest) := {
    if (not is_mx(t)) t
    else if (head(t) == 'At and arity(t) == 2 and nest == 0) no_at(arg(t, 1), 0)
    else if (head(t) == 'Quote) t
    else {
        n2 := if (head(t) == 'QuasiQuote) nest + 1 else if (head(t) == 'UnQuote) nest - 1 else nest
        m := mexpr(head(t), Tuple{})
        i := 0
        while (i < arity(t)) {
            m = push(m, no_at(arg(t, i), n2))
            i = i + 1
        }
        m
    }
}

is_bad(x) := is_mx(x) and head(x) == 'Bad
is_hole(p) := is_mx(p) and head(p) == 'Hole
is_unwrap(p) := is_mx(p) and (head(p) == 'UnwrapReturn or head(p) == 'UnwrapBreak or head(p) == 'UnwrapContinue)
hole(x) := mexpr('Hole, Tuple{x})

un_spec(p) :=
    if (not is_mx(p)) 2
    else if (is_hole(p)) 0
    else if (head(p) == 'Generic) 1
    else if (is_unwrap(p)) un_spec(arg(p, 0))
    else foldl((n, a) -> n + un_spec(a), 2, pretty.args_of(p))

holes_of(p) :=
    if (not is_mx(p)) []
    else if (is_hole(p)) [arg(p, 0)]
    else concat_map(holes_of, pretty.args_of(p))

args_tuple(t) := {
    r := Tuple{}
    i := 0
    while (i < arity(t)) {
        r = push(r, arg(t, i))
        i = i + 1
    }
    r
}

strip(h, t) := {
    tag := if (h == 'UnwrapReturn) 'Return else if (h == 'UnwrapBreak) 'Break else 'Continue
    hd := if (h == 'UnwrapReturn) peg_ret_handler else if (h == 'UnwrapBreak) peg_break_handler else peg_continue_handler
    if (is_mx(t) and head(t) == 'Handle and arity(t) == 2 and arg(t, 1) == hd and peg_scan(arg(t, 0), tag)) arg(t, 0) else t
}

fun un_match

match_unwrap(p, t, env) := {
    t2 := strip(head(p), t)
    tag := if (head(p) == 'UnwrapReturn) 'Return else if (head(p) == 'UnwrapBreak) 'Break else 'Continue
    if (t2 == t and peg_scan(t, tag)) false else un_match(arg(p, 0), t2, env)
}

match_args(p, t, i, env) := {
    ok := true
    while (ok and i < arity(p)) {
        ok = un_match(arg(p, i), arg(t, i), env)
        i = i + 1
    }
    ok
}

un_match(p, t, env) =
    if (is_hole(p)) {
        old := table.get(env, arg(p, 0), bad)
        if (is_bad(old)) {
            table.set(env, arg(p, 0), t)
            true
        } else old == t
    } else if (is_unwrap(p)) match_unwrap(p, t, env)
    else if (is_mx(p) and head(p) == 'Generic) {
        if (is_mx(t)) {
            table.set(env, arg(arg(p, 0), 0), head(t))
            table.set(env, arg(arg(p, 1), 0), args_tuple(t))
            true
        } else false
    } else if (is_mx(p)) {
        is_mx(t) and head(t) == head(p) and arity(t) == arity(p) and match_args(p, t, 0, env)
    } else p == t

label_ok(x, labels) := type(x) == Symbol and x != '_ and member(x, labels)

vars_tmpl(h, tup, labels) := {
    r := mexpr(h, Tuple{})
    i := 0
    while (not is_bad(r) and i < arity(tup)) {
        v0 := arg(tup, i)
        v := if (is_mx(v0) and head(v0) == 'Apply and arg(v0, 0) == 'peg_unat and is_mx(arg(v0, 1)) and arity(arg(v0, 1)) == 1) arg(arg(v0, 1), 0) else v0
        r = if (label_ok(v, labels)) push(r, hole(v)) else bad
        i = i + 1
    }
    r
}

call_tmpl(c, labels) :=
    if (not (is_mx(c) and head(c) == 'Apply and arity(c) == 2 and is_mx(arg(c, 1)) and head(arg(c, 1)) == 'Tuple)) bad
    else if (not list.all(x -> label_ok(x, labels), pretty.args_of(arg(c, 1)))) bad
    else {
        f := arg(c, 0)
        n := arity(arg(c, 1))
        a := hole(if (n > 0) arg(arg(c, 1), 0) else '_)
        b := hole(if (n > 1) arg(arg(c, 1), 1) else '_)
        d := hole(if (n > 2) arg(arg(c, 1), 2) else '_)
        if ((f == 'peg_lambda or f == 'peg_lambda_defaults) and n == 2) `Lambda{!a, UnwrapReturn{!b}}
        else if (f == 'peg_fuse and n == 2) `Fusion{!a, !b}
        else if (f == 'peg_while and n == 2) `UnwrapBreak{While{!a, UnwrapContinue{!b}}}
        else if (f == 'peg_for_tree and n == 3) `UnwrapBreak{Apply{peg_for, Tuple{!b, Lambda{Tuple{!a}, UnwrapContinue{!d}}}}}
        else if (f == 'peg_break and n == 0) `Perform{Break{}}
        else if (f == 'peg_continue and n == 0) `Perform{Continue{}}
        else if (f == 'peg_return and n == 1) `Perform{Return{!a}}
        else if (f == 'peg_record and n == 3) {
            r := intern("%record")
            `Do{
                Def{!r, Apply{_record, Tuple{Quote{!a}, Quote{!b}}}},
                Def{!a, Apply{arg, Tuple{!r, 0}}},
                Def{!d, Apply{arg, Tuple{!r, 1}}},
                Declare{_with},
                Set{_with, Fusion{_with, Apply{_record_with, Tuple{!a, !d}}}}
            }
        }
        else bad
    }

quasi(p, labels) :=
    if (not is_mx(p)) p
    else if (head(p) == 'UnQuote) (if (label_ok(arg(p, 0), labels)) hole(arg(p, 0)) else call_tmpl(arg(p, 0), labels))
    else {
        r := mexpr(head(p), Tuple{})
        i := 0
        while (not is_bad(r) and i < arity(p)) {
            c := quasi(arg(p, i), labels)
            r = if (is_bad(c)) bad else push(r, c)
            i = i + 1
        }
        r
    }

mexpr_tmpl(h, args, labels) :=
    if (is_mx(h) and head(h) == 'Quote and is_mx(args) and head(args) == 'Tuple) vars_tmpl(arg(h, 0), args, labels)
    else if (label_ok(h, labels) and label_ok(args, labels)) Generic{hole(h), hole(args)}
    else bad

is_at_builder(b) := is_mx(b) and head(b) == 'Apply and arg(b, 0) == 'peg_at and is_mx(arg(b, 1)) and head(arg(b, 1)) == 'Tuple and arity(arg(b, 1)) == 2

normal_body(b0) := {
    b1 := no_at(b0, 0)
    b := if (is_mx(b1) and head(b1) == 'Do and arity(b1) == 1) arg(b1, 0) else b1
    if (is_at_builder(b)) arg(arg(b, 1), 1) else b
}

body_tmpl(b, labels) :=
    if (type(b) == Symbol) (if (label_ok(b, labels)) hole(b) else bad)
    else if (not is_mx(b)) bad
    else if (head(b) == 'QuasiQuote) quasi(arg(b, 0), labels)
    else if (head(b) == 'Quote) arg(b, 0)
    else if (head(b) == 'Do and arity(b) == 1) body_tmpl(arg(b, 0), labels)
    else if (head(b) == 'Tuple) vars_tmpl('Tuple, b, labels)
    else if (head(b) == 'Apply and arg(b, 0) == 'mexpr) mexpr_tmpl(arg(arg(b, 1), 0), arg(arg(b, 1), 1), labels)
    else if (head(b) == 'Apply) call_tmpl(b, labels)
    else bad

mentions(x, s) := if (is_mx(x)) list.any(c -> mentions(c, s), pretty.args_of(x)) else x == s

unopt(e) :=
    if (is_mx(e) and head(e) == 'Option and is_mx(arg(e, 0)) and head(arg(e, 0)) == 'Seq and arity(arg(e, 0)) == 2 and arg(arg(e, 0), 0) == 'same) arg(arg(e, 0), 1)
    else e

action_of(f, elems, is_seq) := {
    n := length(elems)
    if (is_mx(f) and head(f) == 'Lambda) {
        pat := arg(arg(f, 0), 0)
        labels := if (is_mx(pat) and head(pat) == 'Tuple and is_seq) pretty.args_of(pat)
                  else if (type(pat) == Symbol and not is_seq) [pat]
                  else bad
        if (is_bad(labels) or length(labels) != n) bad else {
            tm := body_tmpl(normal_body(arg(f, 1)), labels)
            if (is_bad(tm)) bad else Tuple{labels, tm}
        }
    } else bad
}

const_text(e, depth) :=
    if (type(e) == String) e
    else if (type(e) == Symbol) {
        src := table.get(peg_sources, e, none)
        if (depth > 3 or not is_mx(src)) bad else const_text(src, depth + 1)
    } else if (not is_mx(e)) bad
    else if (head(e) == 'Tight or head(e) == 'Key) arg(e, 0)
    else if (head(e) == 'Same or head(e) == 'Not or head(e) == 'And or head(e) == 'Option or head(e) == 'Many) ""
    else if (head(e) == 'Seq) {
        r := ""
        i := 0
        while (not is_bad(r) and i < arity(e)) {
            c := const_text(arg(e, i), depth)
            r = if (is_bad(c)) bad else _strcat(r, c)
            i = i + 1
        }
        r
    } else bad

const_kind(e, i, n, text, prev) :=
    if (is_mx(e) and head(e) == 'Tight) 'tight
    else if (text == "(" and prev == 'ident) 'tight
    else if (i == 0 and n > 1 and strlen(text) > 0 and not string.is_ident_char(ord(text, 0))) 'prefix
    else 'plain

make_items(elems, labels, holes) := {
    n := length(elems)
    fun go
    go = (Nil{}, _, _, _) -> []
        | (e :: es, l :: ls, i, prev) -> {
            it := if (l == '_) {
                    c := const_text(e, 0)
                    if (is_bad(c)) bad else ConstItem{c, const_kind(e, i, n, c, prev)}
                } else if (e == 'here) ConstItem{"", 'tight}
                else if (member(l, holes)) ValueItem{l, e}
                else bad
            rest := go(es, ls, i + 1, e)
            if (is_bad(it) or is_bad(rest)) bad else it :: rest
        }
    items := go(elems, labels, 0, none)
    if (is_bad(items)) bad
    else if (list.all(h -> list.any(it -> head(it) == 'ValueItem and arg(it, 0) == h, items), holes)) items
    else bad
}

token_rule(r) := type(table.get(peg_sources, r, none)) == Function

tail_of(items) :=
    if (items == []) none
    else if (head(list.last(items)) == 'ValueItem and type(arg(list.last(items), 1)) == Symbol and not token_rule(arg(list.last(items), 1))) arg(list.last(items), 1)
    else none

extract_act(owner, order, e, f) := {
    is_seq := is_mx(e) and head(e) == 'Seq
    elems0 := if (is_seq) pretty.args_of(e) else [e]
    elems := if (mentions(f, 'peg_return)) map(unopt, elems0) else elems0
    a := action_of(f, elems, is_seq)
    if (is_bad(a)) bad else {
        tm := arg(a, 1)
        items := make_items(elems, arg(a, 0), holes_of(tm))
        if (is_bad(items)) bad else Alt{owner, order, tm, items, tail_of(items)}
    }
}

find_paren(owner, a) := {
    if (is_mx(a) and head(a) == 'Act and is_mx(arg(a, 0)) and head(arg(a, 0)) == 'Seq and arity(arg(a, 0)) == 3) {
        s := arg(a, 0)
        x := arg(s, 1)
        inner := if (type(x) == Symbol) x
                 else if (is_mx(x) and head(x) == 'Delimited1 and type(arg(x, 0)) == Symbol) arg(x, 0)
                 else none
        if (type(arg(s, 0)) == String and type(arg(s, 2)) == String and inner != none)
            Paren{owner, inner, arg(s, 0), arg(s, 2)}
        else none
    } else none
}

flat(src) := if (is_mx(src) and head(src) == 'Choice) concat_map(flat, pretty.args_of(src)) else [src]

token_types := {
    t := table.new()
    table.set(t, 'ident, Symbol)
    table.set(t, 'integer, Int)
    table.set(t, 'float, String)
    table.set(t, 'string, String)
    t
}

ug_version := -1
ug_extra := []
ug_stack := []
ug_alts := []
ug_links := table.new()
ug_parens := []
ug_reach := table.new()
ug_cands := table.new()

un_build() := {
    alts := []
    links := table.new()
    parens := []
    names := map(kv -> arg(kv, 0), list.sort((a, b) -> arg(a, 1) < arg(b, 1), table.items(peg_ids)))
    each(r -> {
        src := table.get(peg_sources, r, none)
        if (is_mx(src) or type(src) == Symbol) {
            id := table.get(peg_ids, r, 0)
            i := 0
            each(a -> {
                order := id * 100 + i
                i = i + 1
                p := find_paren(r, a)
                if (p != none and not list.any(x -> arg(x, 0) == r, parens)) parens = p :: parens
                if (type(a) == Symbol) {
                    target := table.get(peg_sources, a, none)
                    if (type(target) == Function) {
                        ty := table.get(token_types, a, none)
                        if (ty != none) alts = Alt{r, order, Token{a, ty}, [], none} :: alts
                    } else if (target != none) table.set(links, r, a :: table.get(links, r, []))
                } else if (is_mx(a) and head(a) == 'Act) {
                    x := extract_act(r, order, arg(a, 0), arg(a, 1))
                    if (not is_bad(x)) alts = x :: alts
                }
            }, flat(src))
        }
    }, names)
    i := 0
    each(x -> {
        alts = Alt{arg(x, 0), 90000 + i, Custom{arg(x, 1), arg(x, 3)}, [], arg(x, 2)} :: alts
        i = i + 1
    }, ug_extra)
    ug_alts = reverse(alts)
    ug_links = links
    ug_parens = reverse(parens)
    ug_reach = table.new()
    ug_cands = table.new()
    ug_version = peg_version
}

ensure() := if (ug_version != peg_version) un_build()

alt_owner(a) := arg(a, 0)
alt_order(a) := arg(a, 1)
alt_tmpl(a) := arg(a, 2)
alt_items(a) := arg(a, 3)
alt_tail(a) := arg(a, 4)
is_token(tm) := is_mx(tm) and head(tm) == 'Token

is_custom(tm) := is_mx(tm) and head(tm) == 'Custom

alt_spec(a) := if (is_token(alt_tmpl(a))) 1 else if (is_custom(alt_tmpl(a))) arg(alt_tmpl(a), 0) else un_spec(alt_tmpl(a))

reach_add(seen, r) := if (not set.has(seen, r)) {
    set.add(seen, r)
    each(x -> reach_add(seen, x), table.get(ug_links, r, []))
}

reach(r) := {
    c := table.get(ug_reach, r, none)
    if (c != none) c else {
        seen := set.new()
        reach_add(seen, r)
        table.set(ug_reach, r, seen)
        seen
    }
}

is_open(a) := alt_tail(a) != none and set.has(reach(alt_tail(a)), alt_owner(a)) and not set.has(reach(alt_owner(a)), alt_tail(a))

first_of := (x :: _) -> x

rest_of := (_ :: xs) -> xs

cands(r) := {
    c := table.get(ug_cands, r, none)
    if (c != none) c else {
        rr := reach(r)
        ps := filter(x -> set.has(rr, arg(x, 0)), ug_parens)
        paren := if (ps == []) none else first_of(ps)
        wrap_ok := paren != none
        uni := if (paren == none) set.new() else reach(arg(paren, 1))
        out := []
        each(a -> {
            o := alt_owner(a)
            sp := alt_spec(a)
            if (set.has(rr, o) and (not is_open(a) or set.has(rr, alt_tail(a)))) out = Cand{(sp * 2 + 1) * 100000 - alt_order(a), a, false} :: out
            else if (wrap_ok and sp > 0 and set.has(uni, o)) out = Cand{sp * 2 * 100000 - alt_order(a), a, paren} :: out
        }, ug_alts)
        result := list.sort((x, y) -> arg(x, 0) > arg(y, 0), out)
        table.set(ug_cands, r, result)
        result
    }
}

ident_ok(name) := {
    ok := strlen(name) > 0 and string.is_ident_start(ord(name, 0)) and not table.get(peg_reserved, name, false)
    i := 1
    while (ok and i < strlen(name)) {
        ok = string.is_ident_char(ord(name, i))
        i = i + 1
    }
    ok
}

print_token(rule, t) :=
    if (rule == 'ident) (if (ident_ok(symname(t))) symname(t) else none)
    else if (rule == 'integer) string.int_to_string(t)
    else if (rule == 'float) t
    else pretty.quote_string(t)

piece_text := (T{s}) -> s
            | (P{s}) -> s
            | (s) -> s

is_bracket(s) := s == "(" or s == "[" or s == "{" or s == "."
no_space_before(s) := s == ")" or s == "]" or s == "}" or s == "," or s == ";"

render(ps) := {
    out := ""
    glue := true
    pfx := ""
    each(p -> {
        s := piece_text(p)
        if (strlen(s) > 0) {
            sp := not (glue or (is_mx(p) and head(p) == 'T) or no_space_before(s))
            if (glue and pfx == "-" and string.is_digit(ord(s, 0))) sp = true
            if (sp) out = _strcat(out, " ")
            out = _strcat(out, s)
            pfx = if (is_mx(p) and head(p) == 'P) s else ""
            glue = pfx != "" or is_bracket(s)
        }
    }, ps)
    out
}

fun pp

list_pieces(inner, sep, v) := {
    acc := []
    ok := true
    i := 0
    while (ok and i < arity(v)) {
        s := pp(inner, arg(v, i))
        if (s == none) ok = false
        else {
            if (i > 0 and strlen(sep) > 0) acc = sep :: acc
            acc = s :: acc
        }
        i = i + 1
    }
    if (ok) reverse(acc) else none
}

is_list_rule(r) := {
    src := table.get(peg_sources, r, none)
    is_mx(src) and (head(src) == 'Delimited or head(src) == 'Delimited1 or head(src) == 'Many)
}

value_pieces(elem, v) :=
    if (type(elem) == Symbol and is_list_rule(elem)) value_pieces(table.get(peg_sources, elem, none), v)
    else if (type(elem) == Symbol) {
        s := pp(elem, v)
        if (s == none) none else [s]
    } else if (not is_mx(elem)) none
    else if (head(elem) == 'Delimited or head(elem) == 'Delimited1 or head(elem) == 'Many) {
        inner := arg(elem, 0)
        sep := if (head(elem) == 'Many) "" else const_text(arg(elem, 1), 0)
        if (type(inner) != Symbol or is_bad(sep) or not (is_mx(v) and head(v) == 'Tuple)) none
        else if (head(elem) == 'Delimited1 and arity(v) == 0) none
        else list_pieces(inner, sep, v)
    } else if (head(elem) == 'Option and type(arg(elem, 0)) == Symbol and is_mx(v) and head(v) == 'Tuple) {
        if (arity(v) == 0) []
        else if (arity(v) == 1) value_pieces(arg(elem, 0), arg(v, 0))
        else none
    } else none

item_pieces := (ConstItem{text, kind}, env) -> {
                   if (text == "") [] else if (kind == 'tight) [T{text}] else if (kind == 'prefix) [P{text}] else [text]
               }
             | (ValueItem{label, elem}, env) -> value_pieces(elem, table.get(env, label, none))

fun items_pieces
items_pieces = (Nil{}, env) -> []
              | (it :: rest, env) -> {
                    ps := item_pieces(it, env)
                    qs := if (ps == none) none else items_pieces(rest, env)
                    if (ps == none or qs == none) none else append(ps, qs)
                }

fits(p, t) := {
    ok := true
    if (not is_mx(p)) ok = p == t
    else if (head(p) == 'Hole) ok = true
    else if (head(p) == 'Generic) ok = is_mx(t)
    else if (is_unwrap(p)) ok = true
    else {
        ok = is_mx(t) and head(t) == head(p) and arity(t) == arity(p)
        i := 0
        while (ok and i < arity(p)) {
            q := arg(p, i)
            if (not is_mx(q)) ok = q == arg(t, i)
            else if (head(q) != 'Hole and not is_unwrap(q)) ok = is_mx(arg(t, i)) and head(arg(t, i)) == head(q)
            i = i + 1
        }
    }
    ok
}

try_fit(a, wrapped, t) := {
    env := table.new()
    tm := alt_tmpl(a)
    if (is_token(tm)) {
        if (type(t) == arg(tm, 1)) print_token(arg(tm, 0), t) else none
    } else if (is_custom(tm)) {
        txt := arg(tm, 1)(t)
        if (txt == none) none
        else if (wrapped != false) _strcat(arg(wrapped, 2), _strcat(txt, arg(wrapped, 3)))
        else txt
    } else if (un_match(tm, t, env)) {
        ps := items_pieces(alt_items(a), env)
        if (ps == none) none
        else if (wrapped != false) _strcat(arg(wrapped, 2), _strcat(render(ps), arg(wrapped, 3)))
        else render(ps)
    } else none
}

try_alt(a, wrapped, t) :=
    if (is_token(alt_tmpl(a)) or is_custom(alt_tmpl(a)) or fits(alt_tmpl(a), t)) try_fit(a, wrapped, t) else none

fun try_cands
try_cands = (Nil{}, t) -> none
           | (c :: cs, t) -> {
                s := try_alt(arg(c, 1), arg(c, 2), t)
                if (s == none) try_cands(cs, t) else s
             }

pp(r, t) =
    if (type(table.get(peg_sources, r, none)) == Function) {
        ty := table.get(token_types, r, none)
        if (ty != none and type(t) == ty) print_token(r, t) else none
    } else if (list.any(e -> arg(e, 0) == r and arg(e, 1) == t, ug_stack)) none
    else {
        ug_stack = Tuple{r, t} :: ug_stack
        result := try_cands(cands(r), t)
        ug_stack = list.drop(ug_stack, 1)
        result
    }

export try_as(r, t) := {
    ensure()
    pp(r, no_at(t, 0))
}

export text_as(r, t) := {
    s := try_as(r, t)
    if (s == none) panic(_strcat("unparse: cannot print ", show(t))) else s
}

export text(t) := text_as('expr, t)

export custom(owner, spec, tail, f) := {
    ug_extra = append(ug_extra, [Tuple{owner, spec, tail, f}])
    ug_version = -1
}

indent(s) := _strcat("    ", join("\n    ", string.split(s, "\n")))

arg_texts(t) := {
    acc := []
    ok := true
    i := 0
    while (ok and i < arity(t)) {
        s := pp('expr, arg(t, i))
        if (s == none) ok = false else acc = s :: acc
        i = i + 1
    }
    if (ok) reverse(acc) else none
}

block_texts(items) := {
    acc := []
    ok := true
    each(x -> if (ok) {
        s := pp('expr, x)
        if (s == none) ok = false else acc = s :: acc
    }, items)
    if (ok) reverse(acc) else none
}

print_do(t) :=
    if (not (is_mx(t) and head(t) == 'Do)) none
    else {
        ss := block_texts(pretty.args_of(t))
        if (ss == none) none
        else if (arity(t) == 0) "{}"
        else _strcat("{\n", _strcat(join("\n", map(indent, ss)), "\n}"))
    }

has_open_if(t) :=
    if (not is_mx(t) or head(t) == 'Do) false
    else if (head(t) == 'If and arity(t) == 3 and arg(t, 2) == none) true
    else list.any(has_open_if, pretty.args_of(t))

print_if(t) :=
    if (not (is_mx(t) and head(t) == 'If and arity(t) == 3)) none
    else {
        c := pp('expr, arg(t, 0))
        a := pp('branch, arg(t, 1))
        b := if (arg(t, 2) == none) "" else pp('branch, arg(t, 2))
        if (c == none or a == none or b == none) none
        else {
            a2 := if (b != "" and has_open_if(arg(t, 1))) _strcat("(", _strcat(a, ")")) else a
            _strcat("if (", _strcat(c, _strcat(") ", _strcat(a2, if (b == "") "" else _strcat(" else ", b)))))
        }
    }

custom('primary, 3, none, print_do)
custom('primary, 3, 'arrow, print_if)

is_call2(t, f) := is_mx(t) and head(t) == 'Apply and arity(t) == 2 and arg(t, 0) == f and is_mx(arg(t, 1)) and head(arg(t, 1)) == 'Tuple
is_text_hole(x) := is_call2(x, '_to_text) and arity(arg(x, 1)) == 1
is_text_literal(x) := type(x) == String and strlen(x) > 0

fstr_segs(t) :=
    if (is_call2(t, '_strcat) and arity(arg(t, 1)) == 2) {
        l := fstr_segs(arg(arg(t, 1), 0))
        x := arg(arg(t, 1), 1)
        if (l == none) none
        else if (is_text_literal(x) and head(list.last(l)) != 'S) append(l, [S{x}])
        else if (is_text_hole(x)) append(l, [E{arg(arg(x, 1), 0)}])
        else none
    } else if (is_text_hole(t)) [E{arg(arg(t, 1), 0)}]
    else if (is_text_literal(t)) [S{t}]
    else none

fstr_escape(s) := {
    q := pretty.quote_string(s)
    b := strbuf.new()
    i := 1
    while (i < strlen(q) - 1) {
        c := ord(q, i)
        strbuf.add(b, if (c == 123) "{{" else if (c == 125) "}}" else string.char(c))
        i = i + 1
    }
    strbuf.string(b)
}

print_fstr(t) := {
    segs := if (is_call2(t, '_strcat) or is_text_hole(t)) fstr_segs(t) else none
    if (segs == none) none
    else {
        acc := []
        ok := true
        each(sg -> if (ok) {
            if (head(sg) == 'S) acc = fstr_escape(arg(sg, 0)) :: acc
            else {
                e := pp('expr, arg(sg, 0))
                if (e == none) ok = false
                else acc = _strcat("{", _strcat(if (string.starts_with(e, "{")) " " else "", _strcat(e, "}"))) :: acc
            }
        }, segs)
        if (ok) _strcat("f\"", _strcat(join("", reverse(acc)), "\"")) else none
    }
}

print_return0(t) := if (t == 'Perform{Return{none}}) "return" else none

guard_parts := (Apply{Lambda{Tuple{k}, Fusion{Lambda{vs, Apply{Fusion{Lambda{ps, b}, k2}, vs2}}, k3}}, Tuple{g}}) -> {
                   b2 := strip('UnwrapReturn, b)
                   ok := type(k) == Symbol and symname(k) == "%g" and k2 == k and k3 == k and vs2 == vs
                         and is_mx(b2) and head(b2) == 'If and arity(b2) == 3 and arg(b2, 2) == mexpr('Apply, Tuple{k, vs})
                   if (ok) Guard{ps, arg(b2, 0), arg(b2, 1), g} else none
               }
             | (_) -> none

params_text(ps) := {
    xs := list_pieces('pattern, ",", ps)
    s := if (xs == none) none else render(xs)
    if (s == none) none
    else if (arity(ps) == 1 and not (is_mx(arg(ps, 0)) and head(arg(ps, 0)) == 'Tuple and string.starts_with(s, "("))) s
    else _strcat("(", _strcat(s, ")"))
}

arm_text(ps, c, e) := {
    p := params_text(ps)
    g := if (c == NoGuard{}) "" else pp('or_expr, c)
    b := pp('arrow, e)
    if (p == none or g == none or b == none) none
    else _strcat(p, _strcat(if (g == "") "" else _strcat(" if ", g), _strcat(" -> ", b)))
}

plain_arm := (Lambda{ps @ Expr, e}) -> if (head(ps) == 'Tuple and strip('UnwrapReturn, e) == e) arm_text(ps, NoGuard{}, e) else none
           | (_) -> none

match_arms(f) := {
    gp := guard_parts(f)
    if (gp != none) {
        a := arm_text(arg(gp, 0), arg(gp, 1), arg(gp, 2))
        r := if (arg(gp, 3) == '_nomatch) [] else match_arms(arg(gp, 3))
        if (a == none or r == none) none else a :: r
    } else if (is_mx(f) and head(f) == 'Fusion and arity(f) == 2) {
        a := plain_arm(arg(f, 0))
        r := match_arms(arg(f, 1))
        if (a == none or r == none) none else a :: r
    } else {
        a := plain_arm(f)
        if (a == none) none else [a]
    }
}

is_applied(t) := is_mx(t) and head(t) == 'Apply and arity(t) == 2 and is_mx(arg(t, 1)) and head(arg(t, 1)) == 'Tuple and arity(arg(t, 1)) == 1

print_match(t) := {
    f := if (is_applied(t)) arg(t, 0) else none
    arms := if (f != none and (guard_parts(f) != none or (is_mx(f) and head(f) == 'Fusion))) match_arms(f) else none
    s := if (arms == none) none else pp('or_expr, arg(arg(t, 1), 0))
    if (arms == none or s == none) none
    else {
        lines := indent(first_of(arms)) :: map(a -> _strcat("  | ", join("\n    ", string.split(a, "\n"))), rest_of(arms))
        _strcat("match ", _strcat(s, _strcat(" {\n", _strcat(join("\n", lines), "\n}"))))
    }
}

print_guard(t) := {
    gp := guard_parts(t)
    if (gp == none) none
    else {
        a := arm_text(arg(gp, 0), arg(gp, 1), strip('UnwrapReturn, arg(gp, 2)))
        r := if (arg(gp, 3) == '_nomatch) "" else pp('union, arg(gp, 3))
        if (a == none or r == none) none
        else if (r == "") a
        else _strcat(a, _strcat(" | ", r))
    }
}

skip_fun := mexpr('Lambda, Tuple{'Tuple{_}, mexpr('Quote, Tuple{peg_skip})})

unskip(f) :=
    if (guard_parts(f) != none) {
        g := arg(arg(f, 1), 0)
        r := if (g == skip_fun) '_nomatch else unskip(g)
        if (r == none) none else mexpr('Apply, Tuple{arg(f, 0), Tuple{r}})
    } else if (is_mx(f) and head(f) == 'Fusion and arity(f) == 2) {
        if (arg(f, 1) == skip_fun) arg(f, 0)
        else {
            r := unskip(arg(f, 1))
            if (r == none) none else mexpr('Fusion, Tuple{arg(f, 0), r})
        }
    } else none

print_index(f) :=
    if (not peg_guarded(f)) pp('expr, f)
    else {
        g := unskip(f)
        if (g == none) none else pp('expr, g)
    }

print_bigint(t) :=
    if (is_mx(t) and head(t) == 'Apply and arity(t) == 2 and arg(t, 0) == '_bigint and type(arg(t, 1)) == Expr and arity(arg(t, 1)) == 1 and type(arg(arg(t, 1), 0)) == String) arg(arg(t, 1), 0)
    else none

print_call_set(t) :=
    if (is_mx(t) and head(t) == 'Set and arity(t) == 2 and type(arg(t, 0)) == Symbol) {
        r := pp('expr, t)
        if (r == none) none else _strcat(_strcat("(", r), ")")
    } else none

custom('call_arg, 11, none, print_call_set)
custom('primary, 8, none, print_bigint)
custom('index, 10, none, print_index)
custom('primary, 8, none, print_fstr)
custom('sugar_primary, 6, 'arrow, print_return0)
custom('sugar_primary, 10, none, print_match)
custom('union, 12, 'union, print_guard)

}
