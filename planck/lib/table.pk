# table: keys, values and sets on the tables of planck/init.pk
# Copyright (C) 2026 nineties

use("list")

table_len(Table{t}) := array_get(t, 1)

table_has(Table{t}, k) := table_find(t, k, hash(k)) != none

# table_items(t) is [Tuple{key, value}, ...] in an unspecified order
table_items(Table{t}) := {
    r := []
    b := array_get(t, 0)
    i := 0
    while (i < array_len(b)) {
        e := array_get(b, i)
        while (e != none) {
            r = Tuple{array_get(e, 0), array_get(e, 1)} :: r
            e = array_get(e, 2)
        }
        i = i + 1
    }
    r
}

table_keys(t) := map((kv) -> arg(kv, 0), table_items(t))
table_values(t) := map((kv) -> arg(kv, 1), table_items(t))

# === Sets ===
# A set is a table whose values are true.
module set {
    export new() := table()
    export add(s, x) := table_set(s, x, true)
    export has(s, x) := table_has(s, x)
    export len(s) := table_len(s)
    export to_list(s) := table_keys(s)
    export from_list(xs) := {
        s := new()
        each(x -> add(s, x), xs)
        s
    }
}
