# lowlevel: a low-level language with types, ownership and named regions, written in .pk files
# Copyright (C) 2026 nineties
#
# lowlevel{| fn ... |} reads functions of the language and is Module{[Fn{...}, ...]}.
# ll_check(m) is the list of LLErr{kind, Pos{d}, msg}, one for each function with an error,
# and ll_errors(file, m) gives the positions as Loc{file, line, column} of the file.

use("list")
use("table")
use("string")
use("error")

# === Syntax ===

# the elements of Tuple{a, ...} as a list
ll_tlist(t) := {
    xs := []
    i := arity(t) - 1
    while (i >= 0) {
        xs = arg(t, i) :: xs
        i = i - 1
    }
    xs
}

# the list in the value Tuple{} or Tuple{xs} of e?
ll_opt_list(t) := if (arity(t) == 0) [] else arg(t, 0)

# ll_here reads nothing and is Pos{d}, where d is the number of characters from the next token to the end of the text.
# The text parsed is the rest of the file, so d also counts to the end of the file.
_define_rule('ll_here, p -> {
    peg_pv = Pos{peg_srclen - peg_skip_ws(p)}
    p
})
_define_rule('ll_same, 'Same{})
_define_rule('ll_newline, 'Not{Same{}})

ll_kw ::= ('fn | 'var | 'region | 'own | 'mut | 'box | 'free | 'i64 | 'bool | 'true | 'false | 'if | 'else | 'while | 'return)
ll_name ::= !ll_kw x:ident { x }

ll_type ::= 'i64 { I64{} }
    | 'bool { Bool{} }
    | 'own t:ll_type { Own{t} }
    | "&" 'mut r:ll_name t:ll_type { Ref{'mut, r, t} }
    | "&" r:ll_name t:ll_type { Ref{'shr, r, t} }

ll_operand ::= at:ll_here n:integer { Imm{at, n} }
    | at:ll_here 'true { Imm{at, true} }
    | at:ll_here 'false { Imm{at, false} }
    | at:ll_here x:ll_name { Reg{at, x} }

ll_binop ::= "+" { 'add } | "-" { 'sub } | "*" { 'mul } | "/" { 'div } | "%" { 'rem }
    | "<<" { 'shl } | ">>" { 'shr } | "&" { 'bit_and } | "|" { 'bit_or } | "^" { 'bit_xor }
    | "==" { 'eq } | "!=" { 'ne } | "<=" { 'le } | ">=" { 'ge } | "<" { 'lt } | ">" { 'gt }

ll_more_arg ::= "," a:ll_operand { a }
ll_args ::= a:ll_operand r:ll_more_arg* { a :: ll_tlist(r) }

ll_rhs ::= at:ll_here "&" 'mut r:ll_name y:ll_name { Borrow{at, 'mut, r, y} }
    | at:ll_here "&" r:ll_name y:ll_name { Borrow{at, 'shr, r, y} }
    | at:ll_here "*" p:ll_name { Load{at, p} }
    | at:ll_here 'box "(" a:ll_operand ")" { Box{at, a} }
    | at:ll_here f:ll_name "(" args:ll_args? ")" { Call{at, f, ll_opt_list(args)} }
    | a:ll_operand ll_same op:ll_binop b:ll_operand { Bin{op, a, b} }
    | a:ll_operand { Mov{a} }

ll_cond ::= a:ll_operand op:ll_binop b:ll_operand { Bin{op, a, b} } | a:ll_operand { Mov{a} }

ll_stmt ::= at:ll_here 'var x:ll_name ":" t:ll_type { Decl{at, x, t} }
    | at:ll_here 'if "(" c:ll_cond ")" a:ll_block 'else b:ll_block { IfS{at, c, a, b} }
    | at:ll_here 'if "(" c:ll_cond ")" a:ll_block { IfS{at, c, a, []} }
    | at:ll_here 'while "(" c:ll_cond ")" a:ll_block { WhileS{at, c, a} }
    | at:ll_here 'region r:ll_name a:ll_block { RegionS{at, r, a} }
    | at:ll_here 'return ll_same a:ll_operand { Ret{at, a} }
    | at:ll_here 'return { Ret{at, none} }
    | at:ll_here 'free "(" p:ll_name ")" { Free{at, p} }
    | at:ll_here "*" p:ll_name "=" a:ll_operand { Store{at, p, a} }
    | at:ll_here x:ll_name "=" r:ll_rhs { Assign{at, x, r} }
    | at:ll_here f:ll_name "(" args:ll_args? ")" { CallS{at, f, ll_opt_list(args)} }

ll_sep ::= ";" | ll_newline
ll_more_stmt ::= ll_sep s:ll_stmt { s }
ll_stmts ::= s:ll_stmt r:ll_more_stmt* { s :: ll_tlist(r) }
ll_block ::= "{" ss:ll_stmts? ";"? "}" { ll_opt_list(ss) }

ll_param ::= at:ll_here x:ll_name ":" t:ll_type { Param{at, x, t} }
ll_more_param ::= "," p:ll_param { p }
ll_params ::= p:ll_param r:ll_more_param* { p :: ll_tlist(r) }
ll_more_name ::= "," x:ll_name { x }
ll_rparams ::= "[" x:ll_name r:ll_more_name* "]" { x :: ll_tlist(r) }
ll_ret ::= "->" t:ll_type { t }
ll_fn ::= at:ll_here 'fn f:ll_name rs:ll_rparams? "(" ps:ll_params? ")" rt:ll_ret? body:ll_block { Fn{at, f, ll_opt_list(rs), ll_opt_list(ps), if (arity(rt) == 0) Unit{} else arg(rt, 0), body} }

lowlevel ::= fs:ll_fn* { Module{ll_tlist(fs)} }

# === Types ===

ll_show_type(t) := match t {
    I64{} -> "i64"
  | Bool{} -> "bool"
  | Unit{} -> "()"
  | Own{u} -> _strcat("own ", ll_show_type(u))
  | Ref{k, r, u} -> _strcat(if (k == 'mut) f"&mut {symname(r)} " else f"&{symname(r)} ", ll_show_type(u))
}

# i64 and bool are copied. own is linear: it is moved by a use and must be moved or freed once.
# &mut is moved by a use. & is copied.
ll_plain(t) := t == I64{} or t == Bool{}
ll_linear(t) := head(t) == 'Own
ll_moves(t) := head(t) == 'Own or (head(t) == 'Ref and arg(t, 0) == 'mut)

# === Checker state ===
# ll_info: name -> Info{type, regions open at the declaration}, for the variables in scope
# a state: name -> Vs{status, loans}, and ".dead" -> true after return
#   status: 'init, 'uninit, Moved{at} or Freed{at}; loans: [Loan{region, kind}, ...]

ll_sigs := table()
ll_info := table()
ll_regions := []
ll_fn_regions := []
ll_ret_type := Unit{}

ll_fail(at, kind, msg) := perform LLFail{at, kind, msg}

ll_dead(st) := table_get(st, ".dead", false)
ll_status(st, x) := arg(table_get(st, x, none), 0)
ll_loans(st, x) := arg(table_get(st, x, none), 1)
ll_set_status(st, x, s) := table_set(st, x, Vs{s, ll_loans(st, x)})
ll_set_loans(st, x, l) := table_set(st, x, Vs{ll_status(st, x), l})

ll_copy_state(st) := {
    s := table()
    each(kv -> table_set(s, arg(kv, 0), arg(kv, 1)), table_items(st))
    s
}

# the variables of a state, without the removed ones
ll_vars(st) := filter(x -> typeof(x) == 'symbol and table_get(st, x, none) != none, table_keys(st))

ll_lookup(at, x) := {
    i := table_get(ll_info, x, none)
    if (i == none) ll_fail(at, 'undefined, f"{symname(x)} is not declared")
    i
}
ll_type_of(at, x) := arg(ll_lookup(at, x), 0)

ll_need_init(at, st, x) := match ll_status(st, x) {
    'init -> none
  | 'uninit -> ll_fail(at, 'uninit, f"{symname(x)} is read before it is initialized")
  | Moved{_} -> ll_fail(at, 'moved, f"{symname(x)} is used after it is moved")
  | Freed{_} -> ll_fail(at, 'freed, f"{symname(x)} is used after it is freed")
}

ll_no_loans(at, st, x, what) := if (ll_loans(st, x) != []) ll_fail(at, 'borrowed, f"{symname(x)} is borrowed and cannot be {what}")
ll_no_mut_loan(at, st, x, what) := if (any(l -> arg(l, 1) == 'mut, ll_loans(st, x))) ll_fail(at, 'borrowed, f"{symname(x)} is borrowed as mut and cannot be {what}")

ll_type_ok(at, t) := match t {
    Own{u} -> if (not ll_plain(u)) ll_fail(at, 'type, f"{ll_show_type(t)}: the contents must be i64 or bool")
  | Ref{_, r, u} -> {
        if (not member(r, ll_regions)) ll_fail(at, 'region, f"region {symname(r)} is not in scope")
        if (not ll_plain(u)) ll_fail(at, 'type, f"{ll_show_type(t)}: the contents must be i64 or bool")
    }
  | _ -> none
}

ll_declare(at, st, x, t, init) := {
    if (table_get(ll_info, x, none) != none) ll_fail(at, 'type, f"{symname(x)} is already declared")
    ll_type_ok(at, t)
    table_set(ll_info, x, Info{t, ll_regions})
    table_set(st, x, Vs{if (init) 'init else 'uninit, []})
}

# === Operands and values ===

ll_pos(o) := match o {
    Bin{_, a, _} -> arg(a, 0)
  | Mov{a} -> arg(a, 0)
  | _ -> arg(o, 0)
}

# the type of the operand o, which is read. own and &mut are moved.
ll_use(st, o) := match o {
    Imm{_, n} -> if (typeof(n) == 'int) I64{} else Bool{}
  | Reg{at, x} -> {
        t := ll_type_of(at, x)
        ll_need_init(at, st, x)
        if (ll_moves(t)) {
            ll_no_loans(at, st, x, "moved")
            ll_set_status(st, x, Moved{at})
        }
        t
    }
}

# the type of the contents of the pointer p, to read (write is false) or write
ll_ptr(at, st, p, write) := {
    t := ll_type_of(at, p)
    ll_need_init(at, st, p)
    match t {
        Own{u} -> {
            if (write) ll_no_loans(at, st, p, "written") else ll_no_mut_loan(at, st, p, "read")
            u
        }
      | Ref{k, _, u} -> {
            if (write and k != 'mut) ll_fail(at, 'borrowed, f"{symname(p)} is a shared borrow and cannot be written")
            u
        }
      | _ -> ll_fail(at, 'type, f"{symname(p)} is {ll_show_type(t)}, not a pointer")
    }
}

# a parameter type with regions of the function matches an argument type; sub binds the regions
ll_match_type(pt, t, sub) := if (head(pt) == 'Ref and head(t) == 'Ref) {
    r := table_get(sub, arg(pt, 1), none)
    if (arg(pt, 0) != arg(t, 0) or arg(pt, 2) != arg(t, 2)) false
    else if (r == none) {
        table_set(sub, arg(pt, 1), arg(t, 1))
        true
    } else r == arg(t, 1)
} else pt == t

ll_subst_type(t, sub) := match t {
    Ref{k, r, u} -> Ref{k, table_get(sub, r, r), u}
  | _ -> t
}

ll_call(at, st, f, args) := {
    sig := table_get(ll_sigs, f, none)
    if (sig == none) ll_fail(at, 'undefined, f"function {symname(f)} is not defined")
    ps := arg(sig, 1)
    if (length(ps) != length(args)) ll_fail(at, 'type, f"{symname(f)} takes {length(ps)} arguments but {length(args)} are given")
    sub := table()
    each(pa -> {
        p := arg(pa, 0)
        a := arg(pa, 1)
        t := ll_use(st, a)
        if (not ll_match_type(p, t, sub)) ll_fail(arg(a, 0), 'type, f"the argument is {ll_show_type(t)} but {symname(f)} takes {ll_show_type(p)}")
    }, zip(ps, args))
    ll_subst_type(arg(sig, 2), sub)
}

ll_int_operand(o, t) := if (t != I64{}) ll_fail(arg(o, 0), 'type, f"the operand is {ll_show_type(t)}, not i64")

# the type of the right-hand side r
ll_rhs(st, r) := match r {
    Mov{o} -> ll_use(st, o)
  | Bin{op, a, b} -> {
        ta := ll_use(st, a)
        tb := ll_use(st, b)
        if ((op == 'eq or op == 'ne) and ta == tb and ll_plain(ta)) Bool{} else {
            ll_int_operand(a, ta)
            ll_int_operand(b, tb)
            if (member(op, ['lt, 'le, 'gt, 'ge, 'eq, 'ne])) Bool{} else I64{}
        }
    }
  | Load{at, p} -> ll_ptr(at, st, p, false)
  | Box{at, a} -> {
        t := ll_use(st, a)
        if (not ll_plain(t)) ll_fail(at, 'type, f"box of {ll_show_type(t)}: the contents must be i64 or bool")
        Own{t}
    }
  | Call{at, f, args} -> {
        t := ll_call(at, st, f, args)
        if (t == Unit{}) ll_fail(at, 'type, f"{symname(f)} returns no value")
        t
    }
  | Borrow{at, k, r, y} -> {
        info := ll_lookup(at, y)
        yt := arg(info, 0)
        if (head(yt) != 'Own) ll_fail(at, 'type, f"{symname(y)} is {ll_show_type(yt)}; only an own value is borrowed")
        if (not member(r, ll_regions)) ll_fail(at, 'region, f"region {symname(r)} is not in scope")
        if (member(r, arg(info, 1))) ll_fail(at, 'region, f"{symname(y)} is declared in region {symname(r)} and does not live to its end")
        ll_need_init(at, st, y)
        if (k == 'mut) ll_no_loans(at, st, y, "borrowed as mut") else ll_no_mut_loan(at, st, y, "borrowed")
        ll_set_loans(st, y, Loan{r, k} :: ll_loans(st, y))
        Ref{k, r, arg(yt, 0)}
    }
}

ll_cond(st, c) := {
    t := ll_rhs(st, c)
    if (t != Bool{}) ll_fail(ll_pos(c), 'type, f"the condition is {ll_show_type(t)}, not bool")
}

# a borrow of a region opened after the declaration of a variable is out of the scope of the variable
ll_escapes(dt, t, regions) := head(dt) == 'Ref and head(t) == 'Ref and arg(dt, 0) == arg(t, 0) and arg(dt, 2) == arg(t, 2) and not member(arg(t, 1), regions)

ll_assign(at, st, x, t) := {
    info := ll_lookup(at, x)
    dt := arg(info, 0)
    if (dt != t) {
        if (ll_escapes(dt, t, arg(info, 1))) ll_fail(at, 'escape, f"a borrow of region {symname(arg(t, 1))} is put in {symname(x)}, which lives outside the region")
        ll_fail(at, 'type, f"{symname(x)} is {ll_show_type(dt)} but the value is {ll_show_type(t)}")
    }
    ll_no_loans(at, st, x, "assigned")
    if (ll_linear(dt) and ll_status(st, x) == 'init) ll_fail(at, 'leak, f"{symname(x)} owns a value and is assigned again")
    ll_set_status(st, x, 'init)
}

ll_leak_all(at, st) := each(x -> {
    if (ll_linear(arg(table_get(ll_info, x, none), 0)) and ll_status(st, x) == 'init) ll_fail(at, 'leak, f"{symname(x)} still owns a value at the end of the function")
}, ll_vars(st))

# the state after if: both branches must agree on own values
ll_merge(at, a, b) := if (ll_dead(a)) b else if (ll_dead(b)) a else {
    m := table()
    each(x -> {
        t := arg(table_get(ll_info, x, none), 0)
        sa := ll_status(a, x)
        sb := ll_status(b, x)
        if ((sa == 'init) != (sb == 'init) and ll_linear(t)) ll_fail(at, 'branch, f"{symname(x)} is owned after one branch and not after the other")
        s := if (sb == 'init) sa else sb
        la := ll_loans(a, x)
        table_set(m, x, Vs{s, append(la, filter(l -> not member(l, la), ll_loans(b, x)))})
    }, ll_vars(a))
    m
}

ll_replace(st, m) := {
    each(x -> table_set(st, x, table_get(m, x, none)), ll_vars(st))
    table_set(st, ".dead", ll_dead(m))
}

# a loop must give back the own and &mut values it moves
ll_loop_same(at, a, b) := each(x -> {
    changed := (ll_status(a, x) == 'init) != (ll_status(b, x) == 'init)
    if (ll_moves(arg(table_get(ll_info, x, none), 0)) and changed) ll_fail(at, 'loop, f"{symname(x)} is moved or freed in the loop and not given a value again")
}, ll_vars(a))

ll_add_loans(st, b) := each(x -> {
    la := ll_loans(st, x)
    ll_set_loans(st, x, append(la, filter(l -> not member(l, la), ll_loans(b, x))))
}, ll_vars(st))

ll_end_region(st, r) := each(x -> ll_set_loans(st, x, filter(l -> arg(l, 0) != r, ll_loans(st, x))), ll_vars(st))

# check the statements of a block with the state st, which is updated
ll_block(ss, st) := {
    declared := []
    for (s in ss) if (not ll_dead(st)) match s {
        Decl{at, x, t} -> {
            ll_declare(at, st, x, t, false)
            declared = Tuple{x, at} :: declared
        }
      | Assign{at, x, r} -> ll_assign(at, st, x, ll_rhs(st, r))
      | Store{at, p, a} -> {
            u := ll_ptr(at, st, p, true)
            t := ll_use(st, a)
            if (t != u) ll_fail(at, 'type, f"{symname(p)} points to {ll_show_type(u)} but the value is {ll_show_type(t)}")
        }
      | Free{at, p} -> {
            t := ll_type_of(at, p)
            if (head(t) != 'Own) ll_fail(at, 'type, f"{symname(p)} is {ll_show_type(t)}; only an own value is freed")
            match ll_status(st, p) {
                Freed{_} -> ll_fail(at, 'freed, f"{symname(p)} is freed twice")
              | _ -> none
            }
            ll_need_init(at, st, p)
            ll_no_loans(at, st, p, "freed")
            ll_set_status(st, p, Freed{at})
        }
      | CallS{at, f, args} -> ll_call(at, st, f, args)
      | IfS{at, c, a, b} -> {
            ll_cond(st, c)
            sa := ll_copy_state(st)
            ll_block(a, sa)
            sb := ll_copy_state(st)
            ll_block(b, sb)
            ll_replace(st, ll_merge(at, sa, sb))
        }
      | WhileS{at, c, body} -> {
            ll_cond(st, c)
            s1 := ll_copy_state(st)
            ll_block(body, s1)
            if (not ll_dead(s1)) {
                ll_loop_same(at, st, s1)
                s2 := ll_copy_state(st)
                ll_add_loans(s2, s1)
                ll_cond(s2, c)
                ll_block(body, s2)
                ll_add_loans(st, s2)
            }
        }
      | RegionS{at, r, body} -> {
            if (member(r, ll_regions)) ll_fail(at, 'region, f"region {symname(r)} is already open")
            outer := ll_regions
            ll_regions = r :: outer
            ll_block(body, st)
            ll_regions = outer
            ll_end_region(st, r)
        }
      | Ret{at, a} -> {
            t := if (a == none) Unit{} else ll_use(st, a)
            if (t != ll_ret_type) {
                if (ll_escapes(ll_ret_type, t, ll_fn_regions)) ll_fail(at, 'escape, f"a borrow of region {symname(arg(t, 1))} is returned out of the region")
                ll_fail(at, 'type, f"the result is {ll_show_type(ll_ret_type)} but the value is {ll_show_type(t)}")
            }
            ll_leak_all(at, st)
            table_set(st, ".dead", true)
        }
    }
    each((Tuple{x, at}) -> {
        owned := not ll_dead(st) and ll_linear(arg(table_get(ll_info, x, none), 0)) and ll_status(st, x) == 'init
        if (owned) ll_fail(at, 'leak, f"{symname(x)} still owns a value at the end of its block")
        table_set(ll_info, x, none)
        table_set(st, x, none)
    }, declared)
}

ll_check_fn(d) := match d {
    Fn{at, f, rs, ps, ret, body} -> {
        ll_info = table()
        ll_regions = rs
        ll_fn_regions = rs
        ll_ret_type = ret
        each(r -> {
            given := any(p -> head(arg(p, 2)) == 'Ref and arg(arg(p, 2), 1) == r, ps)
            if (not given) ll_fail(at, 'region, f"region {symname(r)} is not given by a parameter")
        }, rs)
        ll_type_ok(at, ret)
        st := table()
        each((Param{pat, x, t}) -> ll_declare(pat, st, x, t, true), ps)
        ll_block(body, st)
        if (not ll_dead(st)) {
            if (ret != Unit{}) ll_fail(at, 'type, f"{symname(f)} can end without returning {ll_show_type(ret)}")
            ll_leak_all(at, st)
        }
    }
}

# the errors of the module m: [LLErr{kind, Pos{d}, msg}, ...], the first error of each function
ll_check(m) := {
    fns := arg(m, 0)
    ll_sigs = table()
    each((Fn{at, f, rs, ps, ret, _}) -> table_set(ll_sigs, f, Sig{rs, map(p -> arg(p, 2), ps), ret}), fns)
    errs := []
    each(d -> {
        r := handle { ll_check_fn(d); none } with (LLFail{at, kind, msg}, k) -> LLErr{kind, at, msg}
        if (r != none) errs = r :: errs
    }, fns)
    reverse(errs)
}

# ll_check with the positions in the file: [LLErr{kind, Loc{file, line, column}, msg}, ...]
ll_errors(file, m) := {
    src := read_file(file)
    n := strlen(src)
    map((LLErr{kind, Pos{d}, msg}) -> LLErr{kind, loc_at(file, src, n - d), msg}, ll_check(m))
}

# print the errors as file:line:column: message, or "ok"
ll_report(file, m) := {
    es := ll_errors(file, m)
    if (es == []) put("ok\n")
    each((LLErr{_, loc, msg}) -> put(f"{show_loc(loc)}: {msg}\n"), es)
}
