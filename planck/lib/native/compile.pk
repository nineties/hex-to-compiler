# native/compile: turns a module of native into the Module of vasm
# Copyright (C) 2026 nineties
#
# native_compile.compile(m) is the Module{[...]} of vasm for the module m = PModule{[...]} that native{| ... |} reads.
# native_compile.compile_all(m) is Tuple{module, errors} with the errors [VasmErr{kind, Pos{d}, msg}, ...], the first of each function.
# native_compile.compile_with(m, imports) and native_compile.compile_all_with(m, imports) compile a module whose functions may call the functions
# and use the structs of imports, the interfaces of other units (vasm_unit.ifaces of vasm/unit.pk): a list of Fn and Struct items, whose bodies
# are not read. An import item (PImport{at, u}) of m names a unit; the caller picks the interfaces of the units named (native_compile.import_items(m))
# and the expansion does not use the item.
# The expansion makes the form that vasm_check.check checks; it does not check ownership, borrows or regions.
#
# - A nested expression becomes one statement for each operation, with a temporary variable of the type of the operation.
# - let x = e declares x with the type of e, or the type written after x.
# - for i in a..b, compound assignments and the short-circuit and / or become while and if.
# - An integer literal beyond -32768 to 32767 is made with << and | from parts of 15 bits, in the integer type that the context gives.
# - A floating point literal has the type f64 when nothing else gives it a type. -e of a floating point number is e * -1.0.
# - An index of an integer type other than i64 is converted with as i64.
# - The last expression of a function that gives a value is its result.

use("base")
use("list")
use("table")
use("string")
use("vasm/check")
use("native/syntax")

module native_compile {
fail(at, kind, msg) := perform NativeFail{at, kind, msg}

# === State of the function being expanded ===
# sigs: function -> Sig{regions, parameter types, result}; structs: struct -> Struct{...}
# env: the name in the source -> Tuple{name in vasm, type}; live: the names in vasm that are declared
# scope: Scope{source name or none, the binding it hides, name in vasm}, the innermost first
# px_out: the statements of the block being made, the last first

sigs := table.new()
structs := table.new()
env := table.new()
live := table.new()
used := table.new()
scope := []
px_out := []
next := 0
px_ret := Unit{}

fun stmt
fun px_rhs
fun short
fun has_tvar

emit(s) := {
    px_out = s :: px_out
}

# a name that the function does not use and is not declared
fresh(prefix) := {
    name := none
    while (name == none) {
        s := intern(f"{prefix}{next}")
        next = next + 1
        if (table.get(used, s, none) == none and table.get(live, s, none) == none) name = s
    }
    name
}

# the statements of a block are made in a scope that ends with the block
begin() := {
    tok := Tuple{px_out, length(scope)}
    px_out = []
    tok
}

end(tok) := {
    body := reverse(px_out)
    while (length(scope) > arg(tok, 1)) {
        e := scope[0]
        scope = list.drop(scope, 1)
        if (arg(e, 0) != none) table.set(env, arg(e, 0), arg(e, 1))
        table.set(live, arg(e, 2), none)
    }
    px_out = arg(tok, 0)
    body
}

block(ss) := {
    tok := begin()
    each(stmt, ss)
    end(tok)
}

# declares a variable of type t and gives its name in vasm. The name in the source is src, or none for a temporary.
# bind is false for a variable that the source name is bound to by the caller.
declare(at, src, t, bind) := {
    name := if (src != none and table.get(live, src, none) == none) src
        else fresh(if (src == none) "t" else f"{symname(src)}_")
    emit(Decl{at, name, t})
    table.set(live, name, true)
    old := if (src == none or not bind) none else table.get(env, src, none)
    if (src != none and bind) table.set(env, src, Tuple{name, t})
    scope = Scope{if (bind) src else none, old, name} :: scope
    name
}

# === Types ===

pos(e) := arg(e, 0)

known(t) := not (head(t) == 'Lit or head(t) == 'FLit or head(t) == 'Unk)

# the types that give a literal its type: the integer types and the floating point types
numt(t) := vasm_check.int(t) or vasm_check.flt(t)

# the type of a value that is kept in a variable. A literal has the type that the context gives.
keep(at, Lit{_}, want) := if (vasm_check.int(want)) want else fail(at, 'type, "the type of this value is not known; write the type, as in let x: i32 = ... or e as i32")
keep(at, FLit{}, want) := if (vasm_check.flt(want)) want else F64{}
keep(at, Unk{msg}, want) := fail(at, 'type, msg)
keep(at, Unit{}, want) := fail(at, 'type, "this call gives no value")
keep(at, t, want) := t

# the type to give a literal beside a value of type t
px_hint(t, want) := if (vasm_check.int(t)) t else want

elem(at, Val{}) := Val{}
elem(at, Own{Arr{u}}) := u
elem(at, Ref{_, _, Arr{u}}) := u
elem(at, t) := fail(at, 'type, f"{vasm_check.show_type(t)} is not an array to index")

pointee(at, Own{u}) := u
pointee(at, Ref{_, _, u}) := u
pointee(at, t) := fail(at, 'type, f"{vasm_check.show_type(t)} is not a pointer")

struct_of(at, Named{s}) := s
struct_of(at, Own{Named{s}}) := s
struct_of(at, Ref{_, _, Named{s}}) := s
struct_of(at, t) := fail(at, 'type, f"{vasm_check.show_type(t)} is not a struct or a pointer to a struct")

field(at, s, f) := {
    sd := table.get(structs, s, none)
    if (sd == none) fail(at, 'undefined, f"struct {symname(s)} is not defined")
    fd := find((Field{_, x, _}) -> x == f, arg(sd, 2))
    if (fd == none) fail(at, 'type, f"struct {symname(s)} has no field {symname(f)}")
    arg(fd, 2)
}

# === Integer literals beyond the range of vasm ===

# the digits of the text s of an integer literal: Tuple{negative, parts of 15 bits, the least first}
px_parts(s) := {
    n := strlen(s)
    i := 0
    neg := false
    if (ord(s, 0) == 45) {
        neg = true
        i = 1
    }
    base := 10
    if (n > i + 1 and ord(s, i) == 48) {
        c := ord(s, i + 1)
        if (c == 120 or c == 88) base = 16 else if (c == 111 or c == 79) base = 8 else if (c == 98 or c == 66) base = 2
        if (base != 10) i = i + 2
    }
    parts := []
    while (i < n) {
        carry := peg_digit_value(ord(s, i))
        out := []
        each(l -> {
            v := l * base + carry
            out = (v % 32768) :: out
            carry = v / 32768
        }, parts)
        while (carry > 0) {
            out = (carry % 32768) :: out
            carry = carry / 32768
        }
        parts = reverse(out)
        i = i + 1
    }
    Tuple{neg, parts}
}

bits_of(n) := {
    k := 0
    while (n > 0) {
        k = k + 1
        n = n / 2
    }
    k
}

# the number of bits of the value whose parts are ps, the least first
bits(ps) := if (ps == []) 0 else 15 * (length(ps) - 1) + bits_of(list.last(ps))

# a power of two: the value has one bit, at the position w - 1
is_pow(ps, w) := bits(ps) == w and (list.last(ps) == bit_shl(1, (w - 1) % 15)) and list.all(p -> p == 0, list.take(ps, length(ps) - 1))

# The literal s of the integer type t, made in a temporary: the parts of 15 bits from the greatest, each after a shift
big(at, s, t) := {
    pr := px_parts(s)
    neg := arg(pr, 0)
    ps := arg(pr, 1)
    e := vasm_check.int_entry(t)
    w := arg(e, 2)
    signed := arg(e, 3)
    nb := bits(ps)
    ok := if (not neg) (if (signed) nb <= w - 1 else nb <= w) else (signed and (nb <= w - 1 or is_pow(ps, w)))
    if (not ok) fail(at, 'type, f"{s} is out of the range of {arg(e, 1)}")
    x := declare(at, none, t, false)
    parts := reverse(ps)
    emit(Assign{at, x, Mov{Imm{at, parts[0]}}})
    each(c -> {
        emit(Assign{at, x, Bin{'shl, Reg{at, x}, Imm{at, 15}}})
        emit(Assign{at, x, Bin{'bit_or, Reg{at, x}, Imm{at, c}}})
    }, list.drop(parts, 1))
    if (neg) emit(Assign{at, x, Bin{'sub, Imm{at, 0}, Reg{at, x}}})
    Tuple{Reg{at, x}, t}
}

# === Expressions ===
# ex(e, want) gives Tuple{operand, type}: the statements that compute e are made before. want is the integer type that the
# context asks for, or none; it gives the type of a literal that is beyond the range of vasm.
# px_rhs(e, want) gives Tuple{right-hand side, type}, to put the value in a variable without a temporary.

litlike(e) := head(e) == 'ELit or (head(e) == 'ENeg and head(arg(e, 1)) == 'ELit)

simple(e) := member(head(e), ['ELit, 'EFlt, 'EBool, 'EStr, 'ESym, 'EVar]) or (head(e) == 'ENeg and head(arg(e, 1)) == 'ELit)

var(at, x) := {
    b := table.get(env, x, none)
    if (b == none) fail(at, 'undefined, f"{symname(x)} is not declared")
    Tuple{Reg{at, arg(b, 0)}, arg(b, 1)}
}

lit(at, n, want) := if (typeof(n) == 'int) Tuple{Imm{at, n}, Lit{n}}
    else if (vasm_check.int(want)) big(at, arg(n, 0), want)
    else fail(at, 'type, f"the type of {arg(n, 0)} is not known; write it as {arg(n, 0)} as i32 or give the type of the variable")

simple_ex(ELit{at, n}, want) := lit(at, n, want)
simple_ex(EFlt{at, x}, want) := Tuple{FImm{at, x}, FLit{}}
simple_ex(EBool{at, b}, want) := Tuple{Imm{at, b}, Bool{}}
simple_ex(EStr{at, s}, want) := Tuple{Str{at, s}, Ref{'shr, 'static, Arr{U8{}}}}
simple_ex(ESym{at, s}, want) := Tuple{Sym{at, s}, Val{}}
simple_ex(EVar{at, x}, want) := var(at, x)
simple_ex(ENeg{at, ELit{_, n}}, want) := if (typeof(n) == 'int) Tuple{Imm{at, 0 - n}, Lit{0 - n}} else lit(at, Big{_strcat("-", arg(n, 0))}, want)

ex(e, want) := if (simple(e)) simple_ex(e, want) else {
    at := pos(e)
    r := px_rhs(e, want)
    rhs := arg(r, 0)
    if (head(rhs) == 'Mov) Tuple{arg(rhs, 0), arg(r, 1)} else {
        t := keep(at, arg(r, 1), want)
        x := declare(at, none, t, false)
        emit(Assign{at, x, rhs})
        Tuple{Reg{at, x}, t}
    }
}

exs(es, want) := map(e -> ex(e, want), es)

# the two operands of an operation. A literal is pure, so it is read after the other operand, which gives its type.
px_two(a, b, hint) := if (litlike(a) and not litlike(b)) {
    vb := ex(b, hint)
    va := ex(a, px_hint(arg(vb, 1), hint))
    Tuple{va, vb}
} else {
    va := ex(a, hint)
    vb := ex(b, px_hint(arg(va, 1), hint))
    Tuple{va, vb}
}

cmp(op) := member(op, ['lt, 'le, 'gt, 'ge, 'eq, 'ne])

# the index operand: i64
index(i) := {
    v := ex(i, I64{})
    t := arg(v, 1)
    if (vasm_check.int(t) and t != I64{}) {
        at := vasm_check.pos(arg(v, 0))
        x := declare(at, none, I64{}, false)
        emit(Assign{at, x, Conv{at, arg(v, 0), I64{}}})
        Reg{at, x}
    } else arg(v, 0)
}

# the array or struct that an index or a field is taken from is a variable
px_base(e) := if (head(e) == 'EVar) var(pos(e), arg(e, 1))
    else fail(pos(e), 'type, "an element or a field is taken from a variable; bind the value to a variable with let")

# a place of swap: *p, p[i] or p.f
place(EDeref{at, p}) := {
    b := var(at, p)
    Tuple{Load{at, arg(arg(b, 0), 1)}, pointee(at, arg(b, 1))}
}
place(EIndex{at, a, i}) := {
    b := px_base(a)
    u := elem(at, arg(b, 1))
    Tuple{Index{at, arg(arg(b, 0), 1), index(i)}, u}
}
place(EGet{at, a, f}) := {
    b := px_base(a)
    Tuple{Get{at, arg(arg(b, 0), 1), f}, field(at, struct_of(at, arg(b, 1)), f)}
}
place(e) := fail(pos(e), 'type, "this argument is a place: *p, p[i] or p.f")

# the result type of a call with the types ts of the arguments
result(at, f, sig, ts, tsub) := {
    rs := arg(sig, 0)
    ret := arg(sig, 2)
    rmap := table.new()
    each(r -> {
        qs := []
        each(pt -> {
            p := arg(pt, 0)
            t := arg(pt, 1)
            if (head(p) == 'Ref and head(t) == 'Ref and arg(p, 1) == r and not member(arg(t, 1), qs)) qs = arg(t, 1) :: qs
        }, list.zip(arg(sig, 1), ts))
        if (length(qs) == 1) table.set(rmap, r, qs[0])
    }, rs)
    bad := list.any(r -> vasm_check.mentions(ret, r) and table.get(rmap, r, none) == none, rs)
    t := vasm_check.subst(ret, rmap, tsub)
    if (bad) Unk{f"the region of the result of {symname(f)} is not known; write the type: let x: T = ..."}
    else if (has_tvar(t)) Unk{f"the type of the result of {symname(f)} is not known; write the type: let x: T = ..."}
    else t
}

has_tvar(TVar{_}) = true
has_tvar(Own{u}) = has_tvar(u)
has_tvar(Arr{u}) = has_tvar(u)
has_tvar(Ref{_, _, u}) = has_tvar(u)
has_tvar(_) = false

call(at, f, args) := {
    b := table.get(env, f, none)
    if (b != none and arg(b, 1) == Val{}) {
        Tuple{Call{at, arg(b, 0), map(v -> arg(v, 0), exs(args, none))}, Val{}}
    } else {
        user := table.get(sigs, f, none)
        sig := if (user == none) table.get(vasm_check.builtins, f, none) else user
        if (sig == none) fail(at, 'undefined, f"function {symname(f)} is not defined")
        ps := arg(sig, 1)
        if (length(ps) != length(args)) fail(at, 'type, f"{symname(f)} takes {length(ps)} arguments but {length(args)} are given")
        tsub := table.new()
        ts := []
        ops := []
        each(pa -> {
            p := arg(pa, 0)
            a := arg(pa, 1)
            v := if (head(p) == 'Place) place(a) else {
                want := if (numt(p)) p else if (head(p) == 'TVar) table.get(tsub, arg(p, 0), none) else none
                ex(a, want)
            }
            q := if (head(p) == 'Place) arg(p, 0) else p
            if (head(q) == 'TVar and known(arg(v, 1)) and table.get(tsub, arg(q, 0), none) == none) table.set(tsub, arg(q, 0), arg(v, 1))
            ts = append(ts, [arg(v, 1)])
            ops = append(ops, [arg(v, 0)])
        }, list.zip(ps, args))
        Tuple{Call{at, f, ops}, result(at, f, sig, ts, tsub)}
    }
}

px_rhs(e, want) = if (simple(e)) {
    v := simple_ex(e, want)
    Tuple{Mov{arg(v, 0)}, arg(v, 1)}
} else match e {
    EBin{at, op, a, b} -> {
        hint := if (cmp(op)) none else want
        two := px_two(a, b, hint)
        va := arg(two, 0)
        vb := arg(two, 1)
        ta := arg(va, 1)
        tb := arg(vb, 1)
        islit := t -> head(t) == 'Lit or head(t) == 'FLit
        t := if (cmp(op)) Bool{} else if (islit(ta)) (if (islit(tb)) (if (ta == FLit{} or tb == FLit{}) FLit{} else Lit{none}) else tb) else ta
        Tuple{Bin{op, arg(va, 0), arg(vb, 0)}, t}
    }
  | ENeg{at, a} -> {
        v := ex(a, want)
        t := arg(v, 1)
        # -e of a floating point number is e * -1.0, which also gives the sign of a zero
        if (vasm_check.flt(t) or t == FLit{}) Tuple{Bin{'mul, arg(v, 0), FImm{at, "-1.0"}}, t}
        else Tuple{Bin{'sub, Imm{at, 0}, arg(v, 0)}, if (head(t) == 'Lit) Lit{none} else t}
    }
  | ENot{at, a} -> {
        v := ex(a, Bool{})
        Tuple{Bin{'eq, arg(v, 0), Imm{at, false}}, Bool{}}
    }
  | EAnd{at, a, b} -> short(at, a, b, true)
  | EOr{at, a, b} -> short(at, a, b, false)
  | ECast{at, a, t} -> {
        v := ex(a, if (vasm_check.int(t)) t else none)
        # a literal has the type at once
        if (litlike(a) and vasm_check.int(t)) Tuple{Mov{arg(v, 0)}, t} else Tuple{Conv{at, arg(v, 0), t}, t}
    }
  | EDeref{at, p} -> {
        b := var(at, p)
        Tuple{Load{at, arg(arg(b, 0), 1)}, pointee(at, arg(b, 1))}
    }
  | EIndex{at, a, i} -> {
        b := px_base(a)
        u := elem(at, arg(b, 1))
        Tuple{Index{at, arg(arg(b, 0), 1), index(i)}, u}
    }
  | EGet{at, a, f} -> {
        b := px_base(a)
        Tuple{Get{at, arg(arg(b, 0), 1), f}, field(at, struct_of(at, arg(b, 1)), f)}
    }
  | ECall{at, f, args} -> call(at, f, args)
  | EMake{at, s, inits} -> {
        is := map((PInit{iat, f, a}) -> {
            ft := field(iat, s, f)
            v := ex(a, if (numt(ft)) ft else none)
            Init{iat, f, arg(v, 0)}
        }, inits)
        Tuple{Make{at, s, is}, Named{s}}
    }
  | EBorrow{at, k, r, y} -> {
        b := var(at, y)
        t := arg(b, 1)
        Tuple{Borrow{at, k, r, arg(arg(b, 0), 1)}, if (head(t) == 'Own) Ref{k, r, arg(t, 0)} else Unk{f"{symname(y)} is not own, and only an own value is borrowed"}}
    }
  | ECon{at, h, args} -> Tuple{Con{at, h, map(v -> arg(v, 0), exs(args, none))}, Val{}}
  | EClo{at, f, args} -> Tuple{Clo{at, f, map(v -> arg(v, 0), exs(args, none))}, Val{}}
}

# a and b (and is true) or a or b: b is computed only when a does not decide the value
short(at, a, b, is_and) = {
    va := ex(a, Bool{})
    x := declare(at, none, Bool{}, false)
    emit(Assign{at, x, Mov{arg(va, 0)}})
    tok := begin()
    vb := ex(b, Bool{})
    emit(Assign{at, x, Mov{arg(vb, 0)}})
    body := end(tok)
    cond := if (is_and) Mov{Reg{at, x}} else Bin{'eq, Reg{at, x}, Imm{at, false}}
    emit(IfS{at, cond, body, []})
    Tuple{Mov{Reg{at, x}}, Bool{}}
}

# the condition of if and while
px_cond(e) := match e {
    EBin{at, op, a, b} -> if (cmp(op)) {
        two := px_two(a, b, none)
        Bin{op, arg(arg(two, 0), 0), arg(arg(two, 1), 0)}
    } else Mov{arg(ex(e, Bool{}), 0)}
  | _ -> Mov{arg(ex(e, Bool{}), 0)}
}

# === Statements ===

# the type of a place that is assigned
target_type(EVar{at, x}) := arg(var(at, x), 1)
target_type(EDeref{at, p}) := pointee(at, arg(var(at, p), 1))
target_type(EIndex{at, a, _}) := elem(at, arg(px_base(a), 1))
target_type(EGet{at, a, f}) := field(at, struct_of(at, arg(px_base(a), 1)), f)
target_type(tg) := fail(pos(tg), 'type, "the left of = is a variable, *p, p[i] or p.f")

px_set(at, tg, op, e) := {
    ty := target_type(tg)
    want := if (numt(ty)) ty else none
    match tg {
        EVar{vat, x} -> {
            b := var(vat, x)
            vn := arg(arg(b, 0), 1)
            if (op == none) {
                r := px_rhs(e, want)
                emit(Assign{at, vn, arg(r, 0)})
            } else {
                v := ex(e, want)
                emit(Assign{at, vn, Bin{op, Reg{vat, vn}, arg(v, 0)}})
            }
        }
      | _ -> {
            v := ex(e, want)
            val := arg(v, 0)
            # the place and the value that is there now
            kind := head(tg)
            pn := arg(arg(var(pos(tg), if (kind == 'EDeref) arg(tg, 1) else arg(arg(tg, 1), 1)), 0), 1)
            idx := if (kind == 'EIndex) index(arg(tg, 2)) else none
            val2 := if (op == none) val else {
                cur := declare(at, none, ty, false)
                read := if (kind == 'EDeref) Load{at, pn} else if (kind == 'EIndex) Index{at, pn, idx} else Get{at, pn, arg(tg, 2)}
                emit(Assign{at, cur, read})
                emit(Assign{at, cur, Bin{op, Reg{at, cur}, val}})
                Reg{at, cur}
            }
            emit(if (kind == 'EDeref) Store{at, pn, val2} else if (kind == 'EIndex) IStore{at, pn, idx, val2} else FStore{at, pn, arg(tg, 2), val2})
        }
    }
}

px_while(at, c, body) := {
    saved := px_out
    px_out = []
    cond := px_cond(c)
    pre := px_out
    px_out = saved
    if (pre == []) {
        b := block(body)
        emit(WhileS{at, cond, b})
    } else {
        # the condition is computed before the loop and at the end of each round
        px_out = append(pre, px_out)
        flag := declare(at, none, Bool{}, false)
        emit(Assign{at, flag, cond})
        b := block(append(body, [SRecheck{at, flag, c}]))
        emit(WhileS{at, Mov{Reg{at, flag}}, b})
    }
}

px_for(at, i, lo, hi, body) := {
    vl := ex(lo, none)
    vh := ex(hi, px_hint(arg(vl, 1), none))
    tl := arg(vl, 1)
    th := arg(vh, 1)
    ty := if (known(tl) and head(tl) != 'Lit) tl else if (known(th) and head(th) != 'Lit) th
        else fail(at, 'type, "the type of the loop variable is not known; write one bound with its type, as in 0 as i64..n")
    # the end is read once, before the loop
    h := if (head(hi) == 'EVar) {
        x := declare(at, none, ty, false)
        emit(Assign{at, x, Mov{arg(vh, 0)}})
        Reg{at, x}
    } else arg(vh, 0)
    iv := declare(at, i, ty, false)
    old := table.get(env, i, none)
    table.set(env, i, Tuple{iv, ty})
    emit(Assign{at, iv, Mov{arg(vl, 0)}})
    b := block(append(body, [SRaw{Assign{at, iv, Bin{'add, Reg{at, iv}, Imm{at, 1}}}}]))
    emit(WhileS{at, Bin{'lt, Reg{at, iv}, h}, b})
    table.set(env, i, old)
}

stmt(SLet{at, x, t, e}) = {
    r := px_rhs(e, t)
    ty := if (t != none) t else keep(at, arg(r, 1), none)
    name := declare(at, x, ty, true)
    emit(Assign{at, name, arg(r, 0)})
}
stmt(SVar{at, x, t}) = declare(at, x, t, true)
stmt(SIf{at, c, a, b}) = {
    cond := px_cond(c)
    ba := block(a)
    bb := block(b)
    emit(IfS{at, cond, ba, bb})
}
stmt(SWhile{at, c, body}) = px_while(at, c, body)
stmt(SFor{at, i, lo, hi, body}) = px_for(at, i, lo, hi, body)
stmt(SRegion{at, r, body}) = {
    b := block(body)
    emit(RegionS{at, r, b})
}
stmt(SRet{at, e}) = if (e == none) emit(Ret{at, none}) else {
    v := ex(e, if (numt(px_ret)) px_ret else none)
    emit(Ret{at, arg(v, 0)})
}
stmt(SSet{at, tg, op, e}) = px_set(at, tg, op, e)
stmt(SExpr{at, e}) = match e {
    ECall{cat, f, args} -> {
        r := call(cat, f, args)
        emit(CallS{cat, arg(arg(r, 0), 1), arg(arg(r, 0), 2)})
    }
  | _ -> fail(at, 'type, "a statement that is an expression is a call, or the result at the end of a function")
}
stmt(SRecheck{at, flag, c}) = {
    cond := px_cond(c)
    emit(Assign{at, flag, cond})
}
stmt(SRaw{st}) = emit(st)

# === Functions and modules ===

# the names that the statements declare
collect(ss) := each(s -> match s {
    SLet{_, x, _, _} -> table.set(used, x, true)
  | SVar{_, x, _} -> table.set(used, x, true)
  | SIf{_, _, a, b} -> {
        collect(a)
        collect(b)
    }
  | SWhile{_, _, a} -> collect(a)
  | SFor{_, i, _, _, a} -> {
        table.set(used, i, true)
        collect(a)
    }
  | SRegion{_, _, a} -> collect(a)
  | _ -> none
}, ss)

# the last expression of a function that gives a value is the result
tail(ret, body) := if (ret != Unit{} and body != [] and head(list.last(body)) == 'SExpr) {
    s := list.last(body)
    append(list.take(body, length(body) - 1), [SRet{arg(s, 0), arg(s, 1)}])
} else body

fn(PFn{at, f, rs, ps, ret, body}) := {
    env = table.new()
    live = table.new()
    used = table.new()
    scope = []
    px_out = []
    next = 0
    px_ret = ret
    each((Param{_, x, t}) -> {
        table.set(used, x, true)
        table.set(live, x, true)
        table.set(env, x, Tuple{x, t})
    }, ps)
    collect(body)
    Fn{at, f, rs, ps, ret, block(tail(ret, body))}
}

export compile_all_with(m, imports) := {
    items := arg(m, 0)
    sigs = table.new()
    structs = table.new()
    each(d -> match d {
        PImport{_, _} -> none
      | PFn{_, f, rs, ps, ret, _} -> table.set(sigs, f, Sig{rs, map(p -> arg(p, 2), ps), ret})
      | Fn{_, f, rs, ps, ret, _} -> table.set(sigs, f, Sig{rs, map(p -> arg(p, 2), ps), ret})
      | Struct{_, s, _} -> if (table.get(structs, s, none) == none) table.set(structs, s, d)
    }, append(imports, items))
    errs := []
    out := []
    each(d -> match d {
        PImport{_, _} -> none
      | Struct{_, _, _} -> {
            out = d :: out
        }
      | PFn{_, _, _, _, _, _} -> {
            r := handle {
                fn(d)
            } with (NativeFail{at, kind, msg}, k) -> VasmErr{kind, at, msg}
            if (head(r) == 'VasmErr) errs = r :: errs else out = r :: out
        }
    }, items)
    Tuple{Module{reverse(out)}, reverse(errs)}
}

export compile_all(m) := compile_all_with(m, [])

# the import items of m: [PImport{at, u}, ...]
export import_items(m) := filter(d -> head(d) == 'PImport, arg(m, 0))

export compile_with(m, imports) := {
    r := compile_all_with(m, imports)
    if (arg(r, 1) != []) panic(f"native_compile.compile: {arg(arg(r, 1)[0], 2)}")
    arg(r, 0)
}

export compile(m) := compile_with(m, [])

# the errors of compile_all with the positions in the file: [VasmErr{kind, Loc{file, line, column}, msg}, ...]
export errors(file, errs) := {
    src := read_file(file)
    n := strlen(src)
    map((VasmErr{kind, Pos{d}, msg}) -> VasmErr{kind, error.loc_at(file, src, n - d), msg}, errs)
}
}
