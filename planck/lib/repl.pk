module repl {
    export prompt := "> "

    is_def(e) := type(e) == Expr and (head(e) == 'Def or head(e) == 'Set or (head(e) == 'Do and arity(e) > 0 and is_def(arg(e, arity(e) - 1))))

    eval_line(s) := {
        line := 1
        col := 1
        go := true
        while (go) {
            r := parse_at(s, Loc{"<repl>", line, col})
            e := arg(r, 0)
            if (type(e) == Expr and head(e) == 'Eof) go = false
            else if (type(e) == Expr and head(e) == 'SyntaxError) {
                print(peg_error_text(e))
                go = false
            } else {
                rest := arg(r, 1)
                n := strlen(s) - strlen(rest)
                k := 0
                while (k < n) {
                    if (ord(s, k) == 10) {
                        line = line + 1
                        col = 1
                    } else col = col + 1
                    k = k + 1
                }
                s = rest
                v := handle eval(e) with (Error{loc, msg}, k) -> {
                    print(f"error: {msg}")
                    none
                }
                if (v != none and not is_def(e)) _print_repr(v)
            }
        }
    }

    export run() := {
        put(prompt)
        line := read_line()
        while (line != none) {
            eval_line(line)
            put(prompt)
            line = read_line()
        }
        print("")
    }
}
