module repl {
    export prompt := "> "

    eval_line(s) := eval_text.run(s, "<repl>", false, true, msg -> f"error: {msg}")

    export run() := {
        put(prompt)
        line := read_line()
        while (line != none) {
            eval_line(line)
            put(prompt)
            line = read_line()
        }
        print("")
    }
}
