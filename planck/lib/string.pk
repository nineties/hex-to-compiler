# string: characters are the integers that ord returns (bytes)
# Copyright (C) 2026 nineties

use("base")
use("list")
use("vector")

# === Character classes ===
is_digit(c) := c >= 48 and c <= 57
is_upper(c) := c >= 65 and c <= 90
is_lower(c) := c >= 97 and c <= 122
is_alpha(c) := is_upper(c) or is_lower(c)
is_alnum(c) := is_alpha(c) or is_digit(c)
is_space(c) := c == 32 or c == 9 or c == 10 or c == 13
is_ident_start(c) := is_alpha(c) or c == 95
is_ident_char(c) := is_alnum(c) or c == 95

# === Characters and substrings ===
ascii_printable := " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

# chr(c) is the one-character string of the code c: 32 to 126, tab, newline and return
chr(c) := if (c == 10) "\n"
          else if (c == 9) "\t"
          else if (c == 13) "\r"
          else if (c >= 32 and c <= 126) substr(ascii_printable, c - 32, c - 31)
          else panic("chr: unsupported code")

# char_at(s, i) is the one-character string at i, or "" when i is out of range
char_at(s, i) := if (i < 0 or i >= strlen(s)) "" else substr(s, i, i + 1)

starts_with(s, p) := strlen(p) <= strlen(s) and substr(s, 0, strlen(p)) == p
ends_with(s, p) := strlen(p) <= strlen(s) and substr(s, strlen(s) - strlen(p), strlen(s)) == p

# index_of_str(s, sub, from) is the first position >= from where sub occurs in s, or -1
index_of_str(s, sub, from) := {
    n := strlen(s)
    m := strlen(sub)
    i := from
    r := -1
    while (r < 0 and i + m <= n) {
        if (substr(s, i, i + m) == sub) r = i
        i = i + 1
    }
    r
}

str_repeat(s, n) := {
    r := ""
    while (n > 0) {
        r = strcat(r, s)
        n = n - 1
    }
    r
}

# str_cmp(a, b) is -1, 0 or 1 by the byte order
str_cmp(a, b) := {
    i := 0
    r := 0
    n := if (strlen(a) < strlen(b)) strlen(a) else strlen(b)
    while (r == 0 and i < n) {
        r = if (ord(a, i) < ord(b, i)) -1 else if (ord(a, i) > ord(b, i)) 1 else 0
        i = i + 1
    }
    if (r != 0) r else if (strlen(a) < strlen(b)) -1 else if (strlen(a) > strlen(b)) 1 else 0
}

str_less(a, b) := str_cmp(a, b) < 0

# trim(s) removes spaces, tabs and newlines at both ends
trim(s) := {
    i := 0
    j := strlen(s)
    while (i < j and is_space(ord(s, i))) i = i + 1
    while (j > i and is_space(ord(s, j - 1))) j = j - 1
    substr(s, i, j)
}

# === Numbers ===
int_to_str(n) := if (n < 0) strcat("-", int_to_str(0 - n))
                 else if (n < 10) substr("0123456789", n, n + 1)
                 else strcat(int_to_str(n / 10), int_to_str(n % 10))

# str_to_int("-12") is -12. It is none unless s is an optional - and decimal digits.
str_to_int(s) := {
    n := strlen(s)
    neg := n > 0 and ord(s, 0) == 45
    i := if (neg) 1 else 0
    v := 0
    ok := i < n
    while (ok and i < n) {
        if (is_digit(ord(s, i))) v = v * 10 + ord(s, i) - 48 else ok = false
        i = i + 1
    }
    if (not ok) none else if (neg) 0 - v else v
}

# === Splitting and joining ===
# split("a,b,,c", ",") is ["a", "b", "", "c"]. sep must not be empty.
split(s, sep) := {
    if (strlen(sep) == 0) panic("split: empty separator")
    r := []
    start := 0
    i := index_of_str(s, sep, 0)
    while (i >= 0) {
        r = substr(s, start, i) :: r
        start = i + strlen(sep)
        i = index_of_str(s, sep, start)
    }
    reverse(substr(s, start, strlen(s)) :: r)
}

# join(", ", ["a", "b"]) is "a, b"
join(sep, xs) := {
    b := strbuf_new()
    first := true
    each(x -> {
        if (not first) strbuf_add(b, sep)
        first = false
        strbuf_add(b, x)
    }, xs)
    strbuf_str(b)
}

# === String buffer ===
# A buffer collects pieces in a vector. strbuf_str joins them pairwise, so building
# a long string does not copy the same bytes again and again.
strbuf_new() := vec_new()
strbuf_add(b, s) := vec_push(b, s)
strbuf_str(b) := {
    n := vec_len(b)
    if (n == 0) "" else {
        a := array(n)
        i := 0
        while (i < n) {
            array_set(a, i, vec_get(b, i))
            i = i + 1
        }
        m := n
        while (m > 1) {
            i = 0
            j := 0
            while (i + 1 < m) {
                array_set(a, j, strcat(array_get(a, i), array_get(a, i + 1)))
                i = i + 2
                j = j + 1
            }
            if (i < m) {
                array_set(a, j, array_get(a, i))
                j = j + 1
            }
            m = j
        }
        array_get(a, 0)
    }
}
