_float(s) := {
    x := stof(s)
    if (x == none) perform Error{none, _strcat("cannot read the float ", s)}
    else x
}

_bigint(s) := {
    negative := strlen(s) > 0 and ord(s, 0) == 45
    i := if (negative) 1 else 0
    n := 0
    while (i < strlen(s)) {
        n = n * 10 + (ord(s, i) - 48)
        i = i + 1
    }
    if (negative) 0 - n else n
}
