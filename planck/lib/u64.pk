# u64: 64-bit integers. A value is a u16 array of 4 limbs, the lowest limb first. It is not changed after it is made.
# Integers of planck have 31 bits, so a 64-bit value is kept in limbs of 16 bits, which also give the bytes of the value.
# Copyright (C) 2026 nineties

use("base")
use("string")

# u64(n) is the 64-bit value of the integer n; a negative n is sign-extended
u64(n) := {
    r := u16_array(4)
    r[0] = bit_and(n, 65535)
    r[1] = bit_and(bit_sar(n, 16), 65535)
    r[2] = if (n < 0) 65535 else 0
    r[3] = r[2]
    r
}

# u64_limbs(l3, l2, l1, l0) is the value l3 * 2^48 + l2 * 2^32 + l1 * 2^16 + l0; each limb is 0 to 65535
u64_limbs(l3, l2, l1, l0) := {
    r := u16_array(4)
    r[0] = l0
    r[1] = l1
    r[2] = l2
    r[3] = l3
    r
}

# u64_hex("0x1122334455667788") reads at most 16 hexadecimal digits after an optional 0x; "_" is ignored
u64_hex(s) := {
    i := if (starts_with(s, "0x")) 2 else 0
    r := u64(0)
    n := 0
    while (i < strlen(s)) {
        c := ord(s, i)
        d := if (c >= 48 and c <= 57) c - 48
             else if (c >= 97 and c <= 102) c - 87
             else if (c >= 65 and c <= 70) c - 55
             else if (c == 95) -1
             else panic("u64_hex: bad digit")
        if (d >= 0) {
            n = n + 1
            if (n > 16) panic("u64_hex: more than 16 digits")
            r = u64_or(u64_shl(r, 4), u64(d))
        }
        i = i + 1
    }
    r
}

# u64_to_hex(a) is "0x" and 16 hexadecimal digits
u64_to_hex(a) := {
    digits := "0123456789abcdef"
    b := strbuf_new()
    strbuf_add(b, "0x")
    i := 3
    while (i >= 0) {
        strbuf_add(b, digits[bit_shr(a[i], 12)])
        strbuf_add(b, digits[bit_and(bit_shr(a[i], 8), 15)])
        strbuf_add(b, digits[bit_and(bit_shr(a[i], 4), 15)])
        strbuf_add(b, digits[bit_and(a[i], 15)])
        i = i - 1
    }
    strbuf_str(b)
}

# u64_to_int(a) is the integer when the signed value fits in 31 bits, otherwise the program stops
u64_to_int(a) := {
    neg := a[1] >= 32768
    ok := if (neg) (a[2] == 65535 and a[3] == 65535 and a[1] >= 49152) else (a[2] == 0 and a[3] == 0 and a[1] < 16384)
    if (not ok) panic("u64_to_int: the value does not fit in 31 bits")
    hi := if (neg) a[1] - 65536 else a[1]
    hi * 65536 + a[0]
}

u64_add(a, b) := {
    r := u16_array(4)
    carry := 0
    i := 0
    while (i < 4) {
        t := a[i] + b[i] + carry
        r[i] = bit_and(t, 65535)
        carry = bit_shr(t, 16)
        i = i + 1
    }
    r
}

u64_sub(a, b) := {
    r := u16_array(4)
    borrow := 0
    i := 0
    while (i < 4) {
        t := a[i] - b[i] - borrow
        r[i] = bit_and(t, 65535)
        borrow = if (t < 0) 1 else 0
        i = i + 1
    }
    r
}

u64_neg(a) := u64_sub(u64(0), a)

u64_and(a, b) := u64_limbs(bit_and(a[3], b[3]), bit_and(a[2], b[2]), bit_and(a[1], b[1]), bit_and(a[0], b[0]))
u64_or(a, b) := u64_limbs(bit_or(a[3], b[3]), bit_or(a[2], b[2]), bit_or(a[1], b[1]), bit_or(a[0], b[0]))
u64_xor(a, b) := u64_limbs(bit_xor(a[3], b[3]), bit_xor(a[2], b[2]), bit_xor(a[1], b[1]), bit_xor(a[0], b[0]))
u64_not(a) := u64_xor(a, u64_limbs(65535, 65535, 65535, 65535))

# u64_shl(a, k) shifts left by k (0 to 63). u64_shr is the logical and u64_sar the arithmetic shift to the right.
u64_shl(a, k) := {
    if (k < 0 or k > 63) panic("u64_shl: shift count must be 0 to 63")
    q := k / 16
    s := k % 16
    r := u16_array(4)
    i := q
    while (i < 4) {
        lo := if (s > 0 and i - q - 1 >= 0) bit_shr(a[i - q - 1], 16 - s) else 0
        r[i] = bit_and(bit_or(bit_shl(a[i - q], s), lo), 65535)
        i = i + 1
    }
    r
}

u64_shift_right(a, k, fill) := {
    q := k / 16
    s := k % 16
    r := u16_array(4)
    i := 0
    while (i < 4) {
        hi := if (i + q + 1 < 4) a[i + q + 1] else fill
        cur := if (i + q < 4) a[i + q] else fill
        r[i] = bit_and(bit_or(bit_shr(cur, s), if (s > 0) bit_shl(hi, 16 - s) else 0), 65535)
        i = i + 1
    }
    r
}

u64_shr(a, k) := {
    if (k < 0 or k > 63) panic("u64_shr: shift count must be 0 to 63")
    u64_shift_right(a, k, 0)
}

u64_sar(a, k) := {
    if (k < 0 or k > 63) panic("u64_sar: shift count must be 0 to 63")
    u64_shift_right(a, k, if (a[3] >= 32768) 65535 else 0)
}

u64_eq(a, b) := a[0] == b[0] and a[1] == b[1] and a[2] == b[2] and a[3] == b[3]

# u64_ucmp(a, b) is -1, 0 or 1 comparing the values as unsigned. u64_scmp compares them as signed.
u64_ucmp(a, b) := {
    r := 0
    i := 3
    while (r == 0 and i >= 0) {
        r = if (a[i] < b[i]) -1 else if (a[i] > b[i]) 1 else 0
        i = i - 1
    }
    r
}

u64_scmp(a, b) := u64_ucmp(u64_xor(a, u64_limbs(32768, 0, 0, 0)), u64_xor(b, u64_limbs(32768, 0, 0, 0)))

u64_ult(a, b) := u64_ucmp(a, b) < 0
u64_slt(a, b) := u64_scmp(a, b) < 0

# u64_write_le(buf, off, a) stores the 8 bytes of a into the u8 array buf from off, the lowest byte first. u64_write_be stores the highest first.
u64_write_le(buf, off, a) := {
    i := 0
    while (i < 4) {
        buf[off + 2 * i] = bit_and(a[i], 255)
        buf[off + 2 * i + 1] = bit_shr(a[i], 8)
        i = i + 1
    }
}

u64_write_be(buf, off, a) := {
    i := 0
    while (i < 4) {
        buf[off + 7 - 2 * i] = bit_and(a[i], 255)
        buf[off + 6 - 2 * i] = bit_shr(a[i], 8)
        i = i + 1
    }
}

# u64_read_le(buf, off) is the value of the 8 bytes of the u8 array buf from off, the lowest byte first
u64_read_le(buf, off) := {
    r := u16_array(4)
    i := 0
    while (i < 4) {
        r[i] = buf[off + 2 * i] + bit_shl(buf[off + 2 * i + 1], 8)
        i = i + 1
    }
    r
}

# u64_bytes_le(a) is the u8 array of the 8 bytes of a, the lowest byte first
u64_bytes_le(a) := {
    r := u8_array(8)
    u64_write_le(r, 0, a)
    r
}
