# x86: the 32-bit x86 target of the code generator: instruction selection, the model of the scheduler,
# the register file, the frame of a function, and compile of a whole module to an object
# Copyright (C) 2026 nineties
#
# The input is a function of the machine independent form (ir_*, 32-bit values only, see ir.pk):
#   mov li la slota          [D, U] [D, K] [D, S] [D, K slot]
#   add sub mul band bor bxor shl shr sar divs divu rems remu mulhu   [D d, U a, U or K b]
#   neg not sx8 sx16 zx8 zx16                                         [D, U]
#   cmp                      [Cc, D, U a, U or K b]: d is 1 when a cc b, otherwise 0
#   ld                       [W{u8 s8 u16 s16 w32}, D, memory]
#   st                       [W{w8 w16 w32}, memory, U or K]
#   call                     [S name or U, Us args, Ds results]     (up to two results: eax and edx)
#   sys                      [K number, Us args (up to 5), D result]
#   getarg                   [D, K i]: the i-th word of the arguments
#   ret [Us values], jmp [L], br [Cc, U a, U or K b, L yes, L no], trap, label [L]
# Memory operands are M{U base, disp}, MG{name, disp} and MF{'slot, n, disp}.
# The calling convention is that of the System V i386 ABI: the arguments are pushed from the last to the first and removed by the caller,
# the results are in eax and edx, ebx, esi, edi and ebp are kept by the callee.
# A system call is int 0x80 with the number in eax and the arguments in ebx, ecx, edx, esi and edi.

use("base")
use("list")
use("table")
use("vector")
use("bytes")
use("ir")
use("cfg")
use("sched")
use("regalloc")
use("obj")
use("x86enc")

x86_commutative := ['add, 'mul, 'band, 'bor, 'bxor]
x86_alu_ops := ['add, 'sub, 'band, 'bor, 'bxor]
x86_sys_regs := [3, 1, 2, 6, 7]
x86_trap_status := 134

fun x86_select_one

# x86_select(f, code) is the instructions for x86 of the machine independent instructions code
x86_select(f, code) := {
    out := []
    emit := i -> { out = i :: out }
    each(i -> x86_select_one(f, emit, i), code)
    reverse(out)
}

x86_flags_def := ID{8}

x86_select_one(f, emit, i) := {
    nv := () -> ir_vreg(f, 32)
    bv := () -> {
        t := ir_vreg(f, 32)
        ir_set_class(f, t, 'byte)
        t
    }
    # d = a op b in the two-address form
    two := (op, d, a, b) -> {
        if (a != d) emit(I{'mov, [D{d}, U{a}]})
        if (op == 'mul) {
            if (head(b) == 'K) {
                t := nv()
                emit(I{'mov, [D{t}, b]})
                emit(I{'imul, [DU{d}, U{t}, x86_flags_def]})
            } else emit(I{'imul, [DU{d}, b, x86_flags_def]})
        } else if (op == 'shl or op == 'shr or op == 'sar) {
            if (head(b) == 'K) emit(I{op, [DU{d}, K{bit_and(arg(b, 0), 31)}, x86_flags_def]})
            else {
                emit(I{'mov, [D{1}, b]})
                emit(I{op, [DU{d}, IU{1}, x86_flags_def]})
            }
        } else emit(I{op, [DU{d}, b, x86_flags_def]})
    }
    bin := (op, d, a, b) -> if (head(b) == 'U and arg(b, 0) == d and a != d) {
        if (member(op, x86_commutative)) two(op, d, d, U{a}) else {
            t := nv()
            two(op, t, a, b)
            emit(I{'mov, [D{d}, U{t}]})
        }
    } else two(op, d, a, b)
    reg_of := b -> match b {
        U{r} -> r
      | K{n} -> {
            t := nv()
            emit(I{'mov, [D{t}, b]})
            t
        }
    }
    match i {
        I{'label, _} -> emit(i)
      | I{'mov, [D{d}, U{s}]} -> emit(i)
      | I{'li, [D{d}, k]} -> emit(I{'mov, [D{d}, k]})
      | I{'la, [D{d}, s]} -> emit(I{'mov, [D{d}, s]})
      | I{'slota, [D{d}, K{n}]} -> emit(I{'lea, [D{d}, MF{'slot, n, 0}]})
      | I{op, [D{d}, U{a}, b]} if member(op, ['add, 'sub, 'mul, 'band, 'bor, 'bxor, 'shl, 'shr, 'sar]) -> bin(op, d, a, b)
      | I{op, [D{d}, U{a}, b]} if member(op, ['divs, 'divu, 'rems, 'remu]) -> {
            r := reg_of(b)
            emit(I{'mov, [D{0}, U{a}]})
            if (op == 'divs or op == 'rems) emit(I{'cdq, [IU{0}, ID{2}]})
            else emit(I{'mov, [D{2}, K{0}]})
            emit(I{if (op == 'divs or op == 'rems) 'idiv else 'div, [U{r}, IU{0}, IU{2}, ID{0}, ID{2}, x86_flags_def]})
            emit(I{'mov, [D{d}, U{if (op == 'divs or op == 'divu) 0 else 2}]})
        }
      | I{'mulhu, [D{d}, U{a}, b]} -> {
            r := reg_of(b)
            emit(I{'mov, [D{0}, U{a}]})
            emit(I{'mul, [U{r}, IU{0}, ID{0}, ID{2}, x86_flags_def]})
            emit(I{'mov, [D{d}, U{2}]})
        }
      | I{'neg, [D{d}, U{a}]} -> {
            if (a != d) emit(I{'mov, [D{d}, U{a}]})
            emit(I{'neg, [DU{d}, x86_flags_def]})
        }
      | I{'not, [D{d}, U{a}]} -> {
            if (a != d) emit(I{'mov, [D{d}, U{a}]})
            emit(I{'not, [DU{d}]})
        }
      | I{'zx8, [D{d}, U{a}]} -> bin('band, d, a, K{255})
      | I{'zx16, [D{d}, U{a}]} -> bin('band, d, a, K{65535})
      | I{'sx16, [D{d}, U{a}]} -> emit(I{'movsxw, [D{d}, U{a}]})
      | I{'sx8, [D{d}, U{a}]} -> {
            t := bv()
            emit(I{'mov, [D{t}, U{a}]})
            emit(I{'movsxb, [D{d}, U{t}]})
        }
      | I{'cmp, [Cc{c}, D{d}, U{a}, b]} -> {
            t := bv()
            emit(I{'cmp, [U{a}, b, x86_flags_def]})
            emit(I{'setcc, [Cc{c}, D{t}, IU{8}]})
            emit(I{'movzxb, [D{d}, U{t}]})
        }
      | I{'ld, [W{w}, D{d}, m]} -> emit(I{match w {
            'u8 -> 'movzxb
          | 's8 -> 'movsxb
          | 'u16 -> 'movzxw
          | 's16 -> 'movsxw
          | _ -> 'mov
        }, [D{d}, m]})
      | I{'st, [W{w}, m, v]} -> {
            match w {
                'w32 -> emit(I{'mov, [m, v]})
              | 'w16 -> emit(I{'movw, [m, v]})
              | _ -> if (head(v) == 'K) emit(I{'movb, [m, v]}) else {
                    t := bv()
                    emit(I{'mov, [D{t}, v]})
                    emit(I{'movb, [m, U{t}]})
                }
            }
        }
      | I{'getarg, [D{d}, K{n}]} -> emit(I{'mov, [D{d}, MF{'arg, n, 0}]})
      | I{'call, [callee, Us{args}, Ds{rets}]} -> {
            each(a -> emit(I{'push, [U{a}, ID{4}, IU{4}]}), reverse(args))
            emit(I{'call, [callee, ID{0}, ID{1}, ID{2}, x86_flags_def, ID{4}, IU{4}]})
            if (args != []) emit(I{'add, [DU{4}, K{4 * length(args)}, x86_flags_def]})
            if (rets != []) emit(I{'mov, [D{rets[0]}, U{0}]})
            if (length(rets) > 1) emit(I{'mov, [D{rets[1]}, U{2}]})
        }
      | I{'sys, [K{n}, Us{args}, D{d}]} -> {
            emit(I{'mov, [D{0}, K{n}]})
            k := 0
            each(a -> {
                emit(I{'mov, [D{x86_sys_regs[k]}, U{a}]})
                k = k + 1
            }, args)
            emit(I{'int, append([K{128}, IU{0}, ID{0}], map(r -> IU{r}, take(x86_sys_regs, length(args))))})
            emit(I{'mov, [D{d}, U{0}]})
        }
      | I{'ret, [Us{vals}]} -> {
            if (vals != []) emit(I{'mov, [D{0}, U{vals[0]}]})
            if (length(vals) > 1) emit(I{'mov, [D{2}, U{vals[1]}]})
            emit(I{'ret, map(r -> IU{r}, take([0, 2], length(vals)))})
        }
      | I{'jmp, _} -> emit(i)
      | I{'br, [Cc{c}, U{a}, b, L{t}, L{e}]} -> {
            emit(I{'cmp, [U{a}, b, x86_flags_def]})
            emit(I{'jcc, [Cc{c}, L{t}, IU{8}]})
            emit(I{'jmp, [L{e}]})
        }
      | I{'trap, []} -> {
            emit(I{'mov, [D{0}, K{252}]})
            emit(I{'mov, [D{3}, K{x86_trap_status}]})
            emit(I{'int, [K{128}, IU{0}, IU{3}]})
            emit(I{'ud2, []})
        }
      | _ -> panic(f"x86_select: cannot select {ir_show(i)}")
    }
}

# === Scheduling ===
x86_is_mem(o) := member(head(o), ['M, 'MX, 'MG, 'MF])

# the memory the instruction touches: 'load, 'store, 'barrier or 'none
x86_effect(i) := match i {
    I{'mov, [D{_}, m]} -> if (x86_is_mem(m)) 'load else 'none
  | I{'mov, [m, _]} -> if (x86_is_mem(m)) 'store else 'none
  | I{op, [D{_}, m]} if member(op, ['movzxb, 'movsxb, 'movzxw, 'movsxw]) -> if (x86_is_mem(m)) 'load else 'none
  | I{op, [m, _]} if member(op, ['movb, 'movw]) -> 'store
  | I{'push, _} -> 'store
  | I{'pop, _} -> 'load
  | I{'call, _} -> 'barrier
  | I{'int, _} -> 'barrier
  | _ -> 'none
}

x86_latency(i) := match ir_op(i) {
    'imul -> 3
  | 'mul -> 4
  | 'div -> 25
  | 'idiv -> 25
  | _ -> if (x86_effect(i) == 'load) 3 else 1
}

x86_sched_model := SchedModel{x86_latency, x86_effect}

# === Registers ===
# eax ecx edx are given first; ebx esi edi are kept by the callee
x86_callee_saved := [3, 6, 7]
x86_ra := RATarget{[0, 1, 2, 3, 6, 7], {
    t := table()
    table_set(t, 'byte, [0, 1, 2, 3])
    t
}, (r, slot) -> I{'mov, [D{r}, MF{'slot, slot, 0}]}, (r, slot) -> I{'mov, [MF{'slot, slot, 0}, U{r}]}}

# === Frames ===
x86_align(n, a) := (n + a - 1) / a * a

x86_resolve(offs, o) := match o {
    MF{'arg, n, d} -> M{U{5}, 8 + 4 * n + d}
  | MF{'slot, n, d} -> M{U{5}, d - table_get(offs, n, 0)}
  | _ -> o
}

# x86_frame(f, code) adds the prologue and the epilogue to the allocated code and gives an address to each stack slot
x86_frame(f, code) := {
    defined := table()
    each(i -> each(r -> table_set(defined, r, true), ir_defs(i)), code)
    used := filter(r -> table_has(defined, r), x86_callee_saved)
    offs := table()
    off := 4 * length(used)
    n := 0
    each((Tuple{size, al}) -> {
        off = x86_align(off + size, al)
        table_set(offs, n, off)
        n = n + 1
    }, vec_to_list(table_get(ir_meta(f), 'slots, none)))
    total := x86_align(off, 16)
    save_at := r -> -4 * (index_of(r, used) + 1)
    prologue := append([I{'push, [U{5}, ID{4}, IU{4}]}, I{'mov, [D{5}, U{4}]}],
        append(if (total > 0) [I{'sub, [DU{4}, K{total}, x86_flags_def]}] else [],
            map(r -> I{'mov, [M{U{5}, save_at(r)}, U{r}]}, used)))
    epilogue := append(map(r -> I{'mov, [D{r}, M{U{5}, save_at(r)}]}, used),
        [I{'mov, [D{4}, U{5}]}, I{'pop, [D{5}, ID{4}, IU{4}]}, I{'ret, []}])
    body := concat_map(i -> if (ir_op(i) == 'ret) epilogue else [I{ir_op(i), map(o -> x86_resolve(offs, o), ir_ops(i))}], code)
    append(prologue, body)
}

# === Functions and modules ===
x86_compile_fn(f, em) := {
    code := x86_select(f, ir_code(f))
    code = sched_code(code, x86_sched_model)
    g := ir_set_code(f, code)
    code = ra_allocate(g, x86_ra)
    code = x86_frame(g, code)
    obj_define(arg(em, 0), ir_name(f), ".text", em_pos(em), true)
    x86_emit_code(em, code)
}

# x86_compile(name, fns, datas) is an object of the functions (ir_fn) and the data: IRData{name, sec, align, bytes, global},
# where sec is ".data", ".rodata" or ".bss" and bytes a buffer (the size of a .bss object is the length of its buffer of zeros)
x86_compile(name, fns, datas) := {
    o := obj_new(name)
    each(f -> x86_compile_fn(f, em_new(o, ".text")), fns)
    each((IRData{n, sec, al, bytes, global}) -> {
        s := obj_sec(o, sec, if (sec == ".bss") 'bss else 'data, 16)
        b := obj_buf(s)
        bb_align(b, al)
        obj_define(o, n, sec, bb_len(b), global)
        bb_append(b, bytes)
    }, datas)
    o
}
