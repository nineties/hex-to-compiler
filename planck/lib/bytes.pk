# bytes: a growable buffer of bytes. A buffer is a vector of the integers 0 to 255.
# Integers of planck have 31 bits, so a 32-bit value is given as the integer that has the same low 32 bits as a signed value.
# Copyright (C) 2026 nineties

use("base")
use("list")
use("vector")

bb_new() := vec_new()
bb_len(b) := vec_len(b)

bb_u8(b, n) := vec_push(b, bit_and(n, 255))

# little-endian 16-bit and 32-bit values
bb_u16(b, n) := {
    bb_u8(b, n)
    bb_u8(b, bit_sar(n, 8))
}

bb_u32(b, n) := {
    bb_u8(b, n)
    bb_u8(b, bit_sar(n, 8))
    bb_u8(b, bit_sar(n, 16))
    bb_u8(b, bit_sar(n, 24))
}

# little-endian 64-bit value: the integer n sign extended
bb_u64(b, n) := {
    bb_u32(b, n)
    bb_u32(b, if (n < 0) -1 else 0)
}

# bb_str(b, s) appends the bytes of the string s
bb_str(b, s) := {
    i := 0
    while (i < strlen(s)) {
        bb_u8(b, ord(s, i))
        i = i + 1
    }
}

# bb_zeros(b, n) appends n bytes of 0
bb_zeros(b, n) := {
    while (n > 0) {
        bb_u8(b, 0)
        n = n - 1
    }
}

# bb_align(b, a) appends 0 until the length is a multiple of a
bb_align(b, a) := {
    while (bb_len(b) % a != 0) bb_u8(b, 0)
}

# bb_append(b, c) appends the bytes of c
bb_append(b, c) := {
    i := 0
    while (i < bb_len(c)) {
        bb_u8(b, vec_get(c, i))
        i = i + 1
    }
}

bb_get(b, i) := vec_get(b, i)
bb_set(b, i, n) := vec_set(b, i, bit_and(n, 255))

# bb_set_u32(b, at, n) overwrites the 4 bytes at at
bb_set_u32(b, at, n) := {
    bb_set(b, at, n)
    bb_set(b, at + 1, bit_sar(n, 8))
    bb_set(b, at + 2, bit_sar(n, 16))
    bb_set(b, at + 3, bit_sar(n, 24))
}

bb_to_u8(b) := {
    n := bb_len(b)
    a := u8_array(n)
    i := 0
    while (i < n) {
        a[i] = vec_get(b, i)
        i = i + 1
    }
    a
}
