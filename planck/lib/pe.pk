# pe: a partial evaluator from a function of planck to functions of vasm
# Copyright (C) 2026 nineties
#
# specialize(tree, args, rty) is the Module{[...]} of vasm for the function of the tree called with the arguments args; its result has the
# type rty. The module can be given to vasm_build; pe_vasm_text(m) is its text and pe_with_main(m, values) adds the function main that
# calls the first function with the values.
#
# The tree of a function is what a quasi-quote gives, such as `(pow(x, 0) := 1) or `({ even(n) := ...; odd(n) := ... }). The function that the
# last definition of the tree defines is the one that is specialized, and the others are the functions it calls. A tree of the form
# `(x -> e) is a function without a name. A function that is not in the tree, such as nth of list, is called when specialize runs.
#
# An argument Dyn{t} is an input that is known only when the result runs; it is a parameter of type t (a type of vasm) of the first function.
# Any other argument is a static value: everything that depends on static values only is computed when specialize runs, so what is left
# in the functions is the operations on the parameters. A static value may be a function: its tree is given as the value, and it can be
# called with dynamic arguments (twice(f, x) := f(f(x)) with `(x -> x + 1) for f). A value that Dyn marks is not given as a static value.
#
# The operations left are + - * / % and the comparisons on a dynamic value and an integer or another dynamic value, and the built-in
# functions below. The functions of vasm that stand for built-in functions of planck are those of vasm/builtins.pk, and are in the module
# when they are called:
#   strlen(s)        with a dynamic s, a call of strlen
#   println(v)       is always left, whatever v is: a string or an integer, static or dynamic (println_str, println_int)
#   read_file(path)  is always left; its result is a dynamic string (own [u8])
#   argv()[i]        is always left (argv of vasm: the program name is argv()[0]), and array_len(argv()) is argc of vasm
# Printing and reading happen when the result runs, in the order a planck program does them. The other built-in functions that read or
# write outside (put, print, write_file, try_read_file, read_bytes, the write to an array, exit) stop with a message. Any built-in function
# that is not named here is called when specialize runs, and takes static values only.
#
# A call is unfolded where it is written. A call to a function that is being unfolded, from inside a branch of an if whose condition is dynamic,
# is not unfolded: a function is made for the static arguments of the call (and made once for the same static arguments), and the call
# is a call of it. So pow with n = 3 is one function, and f(x, k) := if (x == k) x else f(x + 1, k) with k = 3 is a function that calls itself.
# The functions are named name_spec for the first and name_spec_1, name_spec_2, ... for the others, in the order they are made.
# More than pe_max_fns of them stop with a message (the static arguments change at each call, as in f(n + 1, x - 1)).
# The result of every function that is made has the type rty. A condition that is not a comparison of dynamic values or a dynamic bool,
# a pattern that needs a dynamic value, an assignment under a dynamic condition, and a loop stop with a message.

use("base")
use("list")
use("table")
use("string")
use("vasm/check")
use("vasm/builtins")
use("vasm/text")

fun pe_eval
fun pe_values
fun pe_call_named
fun pe_call_value
fun pe_unfold
fun pe_make_fn
fun pe_residual_call
fun pe_primitive

# === State ===
# the functions of the tree: name -> the list of the clauses Lambda{Tuple{p, ...}, body}
pe_defs := table()
# the variables, the statements (the last first) and the registers of the function that is being made
pe_decls := []
pe_stmts := []
pe_count := 0
# the borrows of the strings that are owned need a region in the function
pe_region := false
# the number of the branches of dynamic conditions around the code, and the functions being unfolded: Tuple{name, depth}, the last first
pe_depth := 0
pe_stack := []
# the type of the results, the name of the first function, the functions made (the last first), what they were made for, and the built-in functions called
pe_rty := Unit{}
pe_entry := ""
pe_fns := []
pe_memo := []
pe_impls := []
pe_nres := 0
pe_max_fns := 32
pe_at := Pos{0}

# === Values ===
# A static value is a value of planck, or a function: Clo{lambda, env} for a function without a name and Fv{name} for one in the tree.
# A dynamic value is Dy{name, type}, a variable of the function that is made.

pe_dyn(v) := typeof(v) == 'mexpr and head(v) == 'Dy
pe_marker(v) := typeof(v) == 'mexpr and head(v) == 'Dyn
pe_fun(v) := typeof(v) == 'mexpr and (head(v) == 'Clo or head(v) == 'Fv)
pe_has_dy(v) := typeof(v) == 'mexpr and (head(v) == 'Dy or any(pe_has_dy, vasm_tlist(v)))
pe_scalar(v) := pe_dyn(v) or typeof(v) == 'int or v == true or v == false
pe_bytes_type(t) := (head(t) == 'Ref and arg(t, 2) == Arr{U8{}}) or (head(t) == 'Own and arg(t, 0) == Arr{U8{}})

pe_copy_env(env) := {
    e := table()
    each(kv -> table_set(e, arg(kv, 0), arg(kv, 1)), table_items(env))
    e
}

# === The trees of functions ===
# a clause is Do{Declare{f}, Set{f, Fusion{f, Lambda{...}}}}
pe_is_clause(t) := typeof(t) == 'mexpr and head(t) == 'Do and arity(t) == 2 and typeof(arg(t, 0)) == 'mexpr and head(arg(t, 0)) == 'Declare
pe_is_def_tree(t) := pe_is_clause(t) or (typeof(t) == 'mexpr and head(t) == 'Do and arity(t) > 0 and all(pe_is_def_tree, vasm_tlist(t)))
pe_is_fun_tree(t) := typeof(t) == 'mexpr and (head(t) == 'Lambda or pe_is_def_tree(t))

# add the clauses of the tree t to pe_defs and give the name of the function of the last clause
pe_load_tree(t) := if (pe_is_clause(t)) match t {
    Do{Declare{f}, Set{_, Fusion{_, l}}} -> {
        table_set(pe_defs, f, append(table_get(pe_defs, f, []), [l]))
        f
    }
} else {
    last := none
    for (x in vasm_tlist(t)) last = pe_load_tree(x)
    last
}

# the function the tree t stands for
pe_fun_value(t) := if (head(t) == 'Lambda) Clo{t, table()} else Fv{pe_load_tree(t)}

# === Statements ===
pe_fresh(t) := {
    pe_count = pe_count + 1
    x := intern(f"t{pe_count}")
    pe_decls = Decl{pe_at, x, t} :: pe_decls
    x
}

pe_emit(s) := {
    pe_stmts = s :: pe_stmts
}

pe_in_range(v) := v >= -32768 and v <= 32767

pe_operand(v) := if (pe_dyn(v)) Reg{pe_at, arg(v, 0)}
    else if (typeof(v) == 'int) {
        if (not pe_in_range(v)) panic(f"pe: {v} cannot be an operand of vasm (out of -32768 to 32767)")
        Imm{pe_at, v}
    } else if (v == true or v == false) Imm{pe_at, v}
    else if (typeof(v) == 'string) Str{pe_at, v}
    else panic(f"pe: {v} cannot be an operand of vasm")

# the dynamic value v with the type t, converted if it has another integer type
pe_to(v, t) := if (pe_dyn(v) and arg(v, 1) != t and vasm_int(arg(v, 1)) and vasm_int(t)) {
    x := pe_fresh(t)
    pe_emit(Assign{pe_at, x, Conv{pe_at, Reg{pe_at, arg(v, 0)}, t}})
    Dy{x, t}
} else v

# the operand for a parameter &r [u8]: a string literal, a dynamic string, or a borrow of one that is owned
pe_bytes_operand(v) := if (typeof(v) == 'string) Str{pe_at, v}
    else if (pe_dyn(v) and pe_bytes_type(arg(v, 1))) {
        t := arg(v, 1)
        if (head(t) == 'Own) {
            pe_region = true
            b := pe_fresh(Ref{'shr, 'pe_r, arg(t, 0)})
            pe_emit(Assign{pe_at, b, Borrow{pe_at, 'shr, 'pe_r, arg(v, 0)}})
            Reg{pe_at, b}
        } else Reg{pe_at, arg(v, 0)}
    } else panic(f"pe: {v} is not a string")

# a call of the function f of vasm/builtins.pk with the operands; its result has the type t (Unit{} for none)
pe_impl_call(f, args, t) := {
    if (not member(f, pe_impls)) pe_impls = f :: pe_impls
    if (t == Unit{}) {
        pe_emit(CallS{pe_at, f, args})
        none
    } else {
        x := pe_fresh(t)
        pe_emit(Assign{pe_at, x, Call{pe_at, f, args}})
        Dy{x, t}
    }
}

# === Operations on dynamic values ===
pe_ops := [Tuple{'_add, 'add}, Tuple{'_sub, 'sub}, Tuple{'_mul, 'mul}, Tuple{'_div, 'div}, Tuple{'_mod, 'rem},
    Tuple{'_eq, 'eq}, Tuple{'_ne, 'ne}, Tuple{'_lt, 'lt}, Tuple{'_le, 'le}, Tuple{'_gt, 'gt}, Tuple{'_ge, 'ge}]
pe_cmps := ['_eq, '_ne, '_lt, '_le, '_gt, '_ge]

# the operation f on the values a and b, one of which is dynamic
pe_dyn_op(f, a, b) := {
    o := find(p -> arg(p, 0) == f, pe_ops)
    t := if (pe_dyn(a)) arg(a, 1) else arg(b, 1)
    b2 := if (pe_dyn(a) and pe_dyn(b)) pe_to(b, arg(a, 1)) else b
    rt := if (member(f, pe_cmps)) Bool{} else t
    x := pe_fresh(rt)
    pe_emit(Assign{pe_at, x, Bin{arg(o, 1), pe_operand(a), pe_operand(b2)}})
    Dy{x, rt}
}

# not v of a dynamic bool v
pe_dyn_not(v) := {
    x := pe_fresh(Bool{})
    pe_emit(Assign{pe_at, x, Bin{'eq, pe_operand(v), Imm{pe_at, false}}})
    Dy{x, Bool{}}
}

# === The built-in functions ===
# the functions that read or write something outside, which are not made yet
pe_unsupported := ['put, 'print, 'write_file, 'try_read_file, 'read_bytes, '_index_set, 'exit]

pe_println(vs) := {
    if (length(vs) != 1) panic("pe: println takes one value")
    v := vs[0]
    if (typeof(v) == 'string or (pe_dyn(v) and pe_bytes_type(arg(v, 1)))) pe_impl_call('println_str, [pe_bytes_operand(v)], Unit{})
    else if (typeof(v) == 'int or (pe_dyn(v) and vasm_int(arg(v, 1)))) pe_impl_call('println_int, [pe_operand(pe_to(v, I64{}))], Unit{})
    else panic(f"pe: println of {v} is not supported")
}

pe_read_file(vs) := {
    if (length(vs) != 1) panic("pe: read_file takes one value")
    pe_impl_call('read_file, [pe_bytes_operand(vs[0])], Own{Arr{U8{}}})
}

# argv()[i] and array_len(argv())
pe_argv_get(i) := {
    if (not (pe_scalar(i) and (typeof(i) == 'int or vasm_int(arg(i, 1))))) panic("pe: the index of argv() is not an integer")
    t := Ref{'shr, 'static, Arr{U8{}}}
    x := pe_fresh(t)
    pe_emit(Assign{pe_at, x, Call{pe_at, 'argv, [pe_operand(pe_to(i, I64{}))]}})
    Dy{x, t}
}

pe_argc() := {
    x := pe_fresh(I64{})
    pe_emit(Assign{pe_at, x, Call{pe_at, 'argc, []}})
    Dy{x, I64{}}
}

pe_argv_call(e) := typeof(e) == 'mexpr and head(e) == 'Apply and arg(e, 0) == 'argv and arity(arg(e, 1)) == 0

# the function f of the host called with the values vs
pe_host(f, vs) := {
    for (v in vs) {
        if (pe_dyn(v)) panic(f"pe: a dynamic value is an argument of {symname(f)}")
        if (pe_fun(v)) panic(f"pe: a function is an argument of {symname(f)}")
    }
    q := map(v -> mexpr('Quote, Tuple{v}), vs)
    eval(mexpr('Apply, Tuple{f, foldl((t, x) -> push(t, x), Tuple{}, q)}))
}

pe_primitive(f, vs) := {
    if (f == 'println) pe_println(vs)
    else if (f == 'read_file) pe_read_file(vs)
    else if (f == 'strlen and length(vs) == 1 and pe_dyn(vs[0])) pe_impl_call('strlen, [pe_bytes_operand(vs[0])], I32{})
    else if (f == 'argv) panic("pe: argv() is used as argv()[i] or array_len(argv())")
    else if (member(f, pe_unsupported)) panic(f"pe: {symname(f)} is not supported")
    else if (f == '_not and length(vs) == 1 and pe_dyn(vs[0])) pe_dyn_not(vs[0])
    else if (find(p -> arg(p, 0) == f, pe_ops) != none and length(vs) == 2 and (pe_dyn(vs[0]) or pe_dyn(vs[1]))) pe_dyn_op(f, vs[0], vs[1])
    else pe_host(f, vs)
}

# === Evaluation ===

# match the pattern p with the value v and bind the variables in env
pe_match(env, p, v) := {
    t := typeof(p)
    if (t == 'symbol) {
        if (p == true or p == false or p == none) {
            if (pe_dyn(v)) panic("pe: a dynamic value is matched with a constant")
            p == v
        } else {
            if (p != '_) table_set(env, p, v)
            true
        }
    } else if (t == 'int or t == 'string) {
        if (pe_dyn(v)) panic("pe: a dynamic value is matched with a constant")
        p == v
    } else if (head(p) == 'Quote) {
        if (pe_dyn(v)) panic("pe: a dynamic value is matched with a constant")
        arg(p, 0) == v
    } else if (typeof(v) != 'mexpr or head(p) != head(v) or arity(p) != arity(v)) {
        if (pe_dyn(v)) panic("pe: a dynamic value is matched with a pattern of a constructor")
        false
    } else {
        i := 0
        ok := true
        while (ok and i < arity(p)) {
            ok = pe_match(env, arg(p, i), arg(v, i))
            i = i + 1
        }
        ok
    }
}

# the values of the expressions es, evaluated from the first, as the program does
pe_values(env, es) := {
    n := arity(es)
    out := []
    i := 0
    while (i < n) {
        out = pe_eval(env, arg(es, i)) :: out
        i = i + 1
    }
    reverse(out)
}

# the clauses cs of the function f (none for a function without a name) called with the values vs: unfold the first that matches
pe_unfold(f, cs, base, vs) := {
    pe_stack = Tuple{f, pe_depth} :: pe_stack
    r := none
    found := false
    for (c in cs) {
        if (not found and arity(arg(c, 0)) == length(vs)) {
            env := pe_copy_env(base)
            ok := true
            i := 0
            for (v in vs) {
                if (ok) ok = pe_match(env, arg(arg(c, 0), i), v)
                i = i + 1
            }
            if (ok) {
                found = true
                r = pe_eval(env, arg(c, 1))
            }
        }
    }
    pe_stack = drop(pe_stack, 1)
    if (not found) panic(f"pe: no clause of {if (f == none) "the function" else symname(f)} matches")
    r
}

# the function f of the tree called with the values vs: a call is made if f is being unfolded outside the branch of a dynamic condition around it
pe_call_named(f, vs) := {
    if (find(fr -> arg(fr, 0) == f and arg(fr, 1) < pe_depth, pe_stack) != none) pe_residual_call(f, vs)
    else pe_unfold(f, table_get(pe_defs, f, []), table(), vs)
}

pe_call_value(fv, vs) := match fv {
    Fv{f} -> pe_call_named(f, vs)
  | Clo{l, cenv} -> pe_unfold(none, [l], cenv, vs)
  | _ -> panic(f"pe: {fv} is not a function")
}

pe_apply(env, f, vs) := if (typeof(f) == 'symbol) {
    local := table_get(env, f, Unbound{})
    if (local != Unbound{}) pe_call_value(local, vs)
    else if (table_get(pe_defs, f, none) != none) pe_call_named(f, vs)
    else pe_primitive(f, vs)
} else pe_call_value(pe_eval(env, f), vs)

# the statements of the evaluation of e, and its value
pe_branch(env, e) := {
    saved := pe_stmts
    pe_stmts = []
    v := pe_eval(env, e)
    s := reverse(pe_stmts)
    pe_stmts = saved
    Tuple{s, v}
}

# the statements s and then x = v with the type t of x
pe_finish(s, v, x, t) := {
    saved := pe_stmts
    pe_stmts = reverse(s)
    w := pe_to(v, t)
    pe_emit(Assign{pe_at, x, Mov{pe_operand(w)}})
    r := reverse(pe_stmts)
    pe_stmts = saved
    r
}

# if with a dynamic condition: both branches are evaluated, and the value is a variable that each branch sets
pe_dyn_if(env, cv, a, b) := {
    if (arg(cv, 1) != Bool{}) panic("pe: the condition of if is not a bool")
    pe_depth = pe_depth + 1
    ra := pe_branch(env, a)
    rb := pe_branch(env, b)
    pe_depth = pe_depth - 1
    va := arg(ra, 1)
    vb := arg(rb, 1)
    if (not pe_dyn(va) and not pe_dyn(vb) and va == vb) {
        pe_emit(IfS{pe_at, Mov{pe_operand(cv)}, arg(ra, 0), arg(rb, 0)})
        va
    } else {
        if (not pe_scalar(va) or not pe_scalar(vb)) panic("pe: the branches of a dynamic condition give values that are not integers or bool")
        t := if (pe_dyn(va)) arg(va, 1) else if (pe_dyn(vb)) arg(vb, 1) else pe_rty
        x := pe_fresh(t)
        sa := pe_finish(arg(ra, 0), va, x, t)
        sb := pe_finish(arg(rb, 0), vb, x, t)
        pe_emit(IfS{pe_at, Mov{pe_operand(cv)}, sa, sb})
        Dy{x, t}
    }
}

pe_if(env, c, a, b) := {
    cv := pe_eval(env, c)
    if (pe_dyn(cv)) pe_dyn_if(env, cv, a, b)
    else if (cv) pe_eval(env, a)
    else pe_eval(env, b)
}

pe_unbound(x) := panic(f"pe: {symname(x)} is not a variable of the function")

pe_eval(env, e) := {
    t := typeof(e)
    if (t == 'int or t == 'string) e
    else if (t == 'symbol) {
        val := table_get(env, e, Unbound{})
        if (val != Unbound{}) val
        else if (e == true or e == false or e == none) e
        else if (table_get(pe_defs, e, none) != none) Fv{e}
        else pe_unbound(e)
    } else if (head(e) == 'Quote) arg(e, 0)
    else if (head(e) == 'Apply) {
        f := arg(e, 0)
        args := arg(e, 1)
        if (f == '_index_get and pe_argv_call(arg(args, 0))) pe_argv_get(pe_eval(env, arg(args, 1)))
        else if (f == 'array_len and arity(args) == 1 and pe_argv_call(arg(args, 0))) pe_argc()
        else pe_apply(env, f, pe_values(env, args))
    } else if (head(e) == 'If) pe_if(env, arg(e, 0), arg(e, 1), arg(e, 2))
    else if (head(e) == 'Lambda) Clo{e, pe_copy_env(env)}
    else if (head(e) == 'Do) {
        r := none
        for (x in vasm_tlist(e)) r = pe_eval(env, x)
        r
    } else if (head(e) == 'Def) {
        v := pe_eval(env, arg(e, 1))
        table_set(env, arg(e, 0), v)
        v
    } else if (head(e) == 'Set) {
        if (pe_depth > 0) panic(f"pe: {symname(arg(e, 0))} is assigned under a dynamic condition")
        v := pe_eval(env, arg(e, 1))
        table_set(env, arg(e, 0), v)
        v
    } else {
        if (member(head(e), ['While, 'Handle, 'Perform, 'Declare, 'Fusion])) panic(f"pe: {symname(head(e))} is not supported")
        foldl((t, x) -> push(t, x), mexpr(head(e), Tuple{}), pe_values(env, e))
    }
}

# === The functions that are made ===

# the key of a call: the function and its arguments, each a static value or Dyn{type}
pe_template(vs) := map(v -> if (pe_dyn(v)) Dyn{arg(v, 1)} else {
    if (pe_has_dy(v)) panic("pe: a value with a dynamic part is an argument of a function that is called, not unfolded")
    v
}, vs)

# the call of the function f made for the static values of vs; the dynamic values of vs are its arguments
pe_residual_call(f, vs) := {
    tmpl := pe_template(vs)
    key := Tuple{Fv{f}, tmpl}
    hit := find(m -> arg(m, 0) == key, pe_memo)
    name := if (hit != none) arg(hit, 1) else {
        if (pe_nres >= pe_max_fns) panic(f"pe: more than {pe_max_fns} functions are made: the static arguments of {symname(f)} change at each call under a dynamic condition")
        pe_nres = pe_nres + 1
        pe_make_fn(intern(f"{pe_entry}_spec_{pe_nres}"), Fv{f}, tmpl)
    }
    args := map(pe_operand, filter(pe_dyn, vs))
    if (pe_rty == Unit{}) {
        pe_emit(CallS{pe_at, name, args})
        none
    } else {
        x := pe_fresh(pe_rty)
        pe_emit(Assign{pe_at, x, Call{pe_at, name, args}})
        Dy{x, pe_rty}
    }
}

# the statements of the function: the variables first, and the borrows of the strings in the region that they need
pe_body(r) := {
    rv := if (pe_rty == Unit{}) none else pe_to(r, pe_rty)
    ret := Ret{pe_at, if (rv == none) none else pe_operand(rv)}
    ds := reverse(pe_decls)
    refs := filter((Decl{_, _, t}) -> head(t) == 'Ref and arg(t, 1) == 'pe_r, ds)
    plain := filter((Decl{_, _, t}) -> not (head(t) == 'Ref and arg(t, 1) == 'pe_r), ds)
    ss := append(reverse(pe_stmts), [ret])
    if (pe_region) append(plain, [RegionS{pe_at, 'pe_r, append(refs, ss)}]) else append(plain, ss)
}

# the function name of vasm for the function fv called with tmpl, whose elements are static values or Dyn{type}
pe_make_fn(name, fv, tmpl) := {
    pe_memo = Tuple{Tuple{fv, tmpl}, name} :: pe_memo
    sd := pe_decls
    ss := pe_stmts
    sc := pe_count
    sr := pe_region
    sdp := pe_depth
    sst := pe_stack
    pe_decls = []
    pe_stmts = []
    pe_count = 0
    pe_region = false
    pe_depth = 0
    pe_stack = []
    ps := []
    vs := []
    i := 0
    for (a in tmpl) {
        if (pe_marker(a)) {
            x := intern(f"a{i}")
            ps = Param{pe_at, x, arg(a, 0)} :: ps
            vs = Dy{x, arg(a, 0)} :: vs
        } else vs = a :: vs
        i = i + 1
    }
    vs = reverse(vs)
    r := match fv {
        Fv{f} -> pe_unfold(f, table_get(pe_defs, f, []), table(), vs)
      | Clo{l, cenv} -> pe_unfold(none, [l], cenv, vs)
    }
    d := Fn{pe_at, name, [], reverse(ps), pe_rty, pe_body(r)}
    pe_decls = sd
    pe_stmts = ss
    pe_count = sc
    pe_region = sr
    pe_depth = sdp
    pe_stack = sst
    pe_fns = d :: pe_fns
    name
}

# the module of vasm for the function of the tree called with args (static values and Dyn{type}), whose result has the type rty
specialize(tree, args, rty) := {
    pe_defs = table()
    pe_decls = []
    pe_stmts = []
    pe_count = 0
    pe_region = false
    pe_depth = 0
    pe_stack = []
    pe_rty = rty
    pe_fns = []
    pe_memo = []
    pe_impls = []
    pe_nres = 0
    if (not pe_is_fun_tree(tree)) panic("pe: the first argument of specialize is the tree of a function")
    fv := pe_fun_value(tree)
    pe_entry = match fv {
        Fv{f} -> symname(f)
      | _ -> "lambda"
    }
    tmpl := map(a -> if (pe_marker(a)) a else if (pe_is_fun_tree(a)) pe_fun_value(a) else a, args)
    pe_make_fn(intern(f"{pe_entry}_spec"), fv, tmpl)
    made := map(m -> find(d -> arg(d, 1) == arg(m, 1), pe_fns), reverse(pe_memo))
    impls := filter(d -> member(arg(d, 1), pe_impls), arg(vasm_planck_builtins, 0))
    Module{append(made, impls)}
}

# the module m of specialize with the function main that calls its first function with the values vs (integers and strings)
pe_with_main(m, vs) := {
    f := arg(arg(m, 0)[0], 1)
    ps := arg(arg(m, 0)[0], 3)
    rty := arg(arg(m, 0)[0], 4)
    decls := []
    sets := []
    regs := []
    i := 0
    for (p in ps) {
        x := intern(f"v{i}")
        decls = Decl{pe_at, x, arg(p, 2)} :: decls
        sets = Assign{pe_at, x, Mov{if (typeof(vs[i]) == 'string) Str{pe_at, vs[i]} else Imm{pe_at, vs[i]}}} :: sets
        regs = Reg{pe_at, x} :: regs
        i = i + 1
    }
    body := append(append(reverse(decls), reverse(sets)), [Decl{pe_at, 'r, rty}, Assign{pe_at, 'r, Call{pe_at, f, reverse(regs)}}, Ret{pe_at, Reg{pe_at, 'r}}])
    Module{append(arg(m, 0), [Fn{pe_at, 'main, [], [], rty, body}])}
}

# the module m as the text of vasm; the function main of pe_with_main is not in it
pe_vasm_text(m) := vasm_text(Module{filter(d -> arg(d, 1) != 'main, arg(m, 0))})
