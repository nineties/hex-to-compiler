# base: stopping the program
# Copyright (C) 2026 nineties

module base {
    # panic(msg) prints msg and stops the program with status 1
    export panic(msg) := {
        put(msg)
        put("\n")
        exit(1)
    }

    # assert(c, msg) stops the program with msg unless c is true
    export assert(c, msg) := if (not c) panic(msg)
}

panic := base.panic
assert := base.assert
