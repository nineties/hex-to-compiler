# Copyright (C) 2026 nineties

use("base")
use("list")
use("string")
use("table")
use("vector")

module highlight {

classes := table.new()
table.set(classes, 'ident, "name")
table.set(classes, 'integer, "num")
table.set(classes, 'float, "num")
table.set(classes, 'string, "str")
table.set(classes, 'keyword, "kw")
table.set(classes, 'istr_open, "str")
table.set(classes, 'istr_text, "str")
table.set(classes, 'istr_close, "str")
table.set(classes, 'istr_hole, "op")

hl_text := ""
ends := none
classes_at := none
hl_base := 0

note(p, q, cls) := {
    i := hl_base + p
    e := hl_base + q
    if (q > p and i < strlen(hl_text)) {
        old := array_get(ends, i)
        if (old == none or old < e or (old == e and array_get(classes_at, i) == "name")) {
            array_set(ends, i, e)
            array_set(classes_at, i, cls)
        }
    }
}

orig_literal := peg_literal
orig_key := peg_px_key
orig_call := peg_call_rule

literal(s, p) := {
    q := orig_literal(s, p)
    if (q >= 0 and strlen(s) > 0) {
        note(q - strlen(s), q, if (string.is_alpha(ord(s, 0))) "kw" else "op")
    }
    q
}

key(s, p) := {
    q := orig_key(s, p)
    if (q >= 0) note(q - strlen(s), q, "kw")
    q
}

call(r, p) := {
    q := orig_call(r, p)
    if (q >= 0) {
        cls := table.get(classes, r, none)
        if (cls != none) note(peg_skip_ws(p), q, cls)
    }
    q
}

escape(s) := {
    b := strbuf.new()
    n := strlen(s)
    start := 0
    i := 0
    while (i < n) {
        c := ord(s, i)
        r := if (c == 38) "&amp;" else if (c == 60) "&lt;" else if (c == 62) "&gt;" else none
        if (r != none) {
            strbuf.add(b, substr(s, start, i))
            strbuf.add(b, r)
            start = i + 1
        }
        i = i + 1
    }
    strbuf.add(b, substr(s, start, n))
    strbuf.string(b)
}

span(cls, s) := _strcat(_strcat(_strcat("<span class=\"tok-", cls), "\">"), _strcat(escape(s), "</span>"))

gap(b, s, a, z) := {
    i := a
    start := a
    while (i < z) {
        if (ord(s, i) == 35) {
            j := i
            while (j < z and ord(s, j) != 10) j = j + 1
            strbuf.add(b, escape(substr(s, start, i)))
            strbuf.add(b, span("com", substr(s, i, j)))
            start = j
            i = j
        } else {
            i = i + 1
        }
    }
    strbuf.add(b, escape(substr(s, start, z)))
}

render(s) := {
    b := strbuf.new()
    n := strlen(s)
    cur := 0
    i := 0
    while (i < n) {
        e := array_get(ends, i)
        if (e != none and i >= cur) {
            gap(b, s, cur, i)
            strbuf.add(b, span(array_get(classes_at, i), substr(s, i, e)))
            cur = e
            i = e
        } else {
            i = i + 1
        }
    }
    gap(b, s, cur, n)
    strbuf.string(b)
}

is_syntax_error(t) := type(t) == Expr and head(t) == 'SyntaxError

rule_name(t) :=
    if (type(t) == Expr and head(t) == 'Apply and arity(t) == 2 and arg(t, 0) == '_define_rule)
        arg(arg(arg(t, 1), 0), 0)
    else none

strip(e) :=
    if (type(e) != Expr) e
    else if (head(e) == 'Act and arg(e, 0) == "...") Prev{}
    else if (head(e) == 'Act) strip(arg(e, 0))
    else peg_map_args(strip, e)

next_line(s, p) := {
    n := strlen(s)
    q := p
    while (q < n and ord(s, q) != 10) q = q + 1
    if (q < n) q + 1 else n
}

export html(src) := {
    n := strlen(src)
    hl_text = src
    ends = array(n + 1)
    classes_at = array(n + 1)
    saved := Tuple{}
    version := peg_version
    peg_literal = literal
    peg_px_key = key
    peg_call_rule = call
    pos := 0
    go := true
    while (go) {
        hl_base = pos
        r := peg_parse('toplevel, substr(src, pos, n))
        t := arg(r, 0)
        if (t == Eof{}) {
            go = false
        } else if (is_syntax_error(t)) {
            pos = next_line(src, pos + peg_far)
            if (pos >= n) go = false
        } else {
            name := rule_name(t)
            if (name != none) {
                saved = push(saved, Tuple{name, table.get(peg_rules, name, none), table.get(peg_sources, name, none)})
                _define_rule(name, strip(arg(arg(arg(t, 1), 1), 0)))
            }
            pos = n - strlen(arg(r, 1))
        }
    }
    peg_literal = orig_literal
    peg_px_key = orig_key
    peg_call_rule = orig_call
    i := arity(saved) - 1
    while (i >= 0) {
        s := arg(saved, i)
        table.set(peg_rules, arg(s, 0), if (arg(s, 1) == none) Fail{} else arg(s, 1))
        table.set(peg_sources, arg(s, 0), if (arg(s, 2) == none) Fail{} else arg(s, 2))
        i = i - 1
    }
    peg_version = version
    render(src)
}

}
