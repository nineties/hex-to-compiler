# trans of planckvm: exp, log, sin, cos, pow and atan2 are not supported
# The functions have the signatures of the unit of planckvm, which the other units call. planckvm stops when one of them is called.
import mem

fn get_ln2[r](h: &mut r [i64], st: &mut r [i64]) -> i64 {
    die("float is not supported")
    0
}

fn get_pi[r](h: &mut r [i64], st: &mut r [i64]) -> i64 {
    die("float is not supported")
    0
}

fn f_exp_fn[r](h: &mut r [i64], st: &mut r [i64], hi: i64, lo: i64) -> i64 {
    die("float is not supported")
    0
}

fn f_log_fn[r](h: &mut r [i64], st: &mut r [i64], hi: i64, lo: i64) -> i64 {
    die("float is not supported")
    0
}

fn f_pow_fn[r](h: &mut r [i64], st: &mut r [i64], hx: i64, lx: i64, hy: i64, ly: i64) -> i64 {
    die("float is not supported")
    0
}

fn f_trig[r](h: &mut r [i64], st: &mut r [i64], hx: i64, lx: i64, want: i64) -> i64 {
    die("float is not supported")
    0
}

fn f_atan2[r](h: &mut r [i64], st: &mut r [i64], hy: i64, ly: i64, hx: i64, lx: i64) -> i64 {
    die("float is not supported")
    0
}
