# flt of planckvm: planckvm has no float instruction, so no value is a float or a complex number and the other functions of the unit stop
# The functions have the signatures of the unit of planckvm, which the other units call. planckvm stops when one of them is called.
import mem

fn lo_of(w: i64) -> i64 {
    w & 4294967295
}

fn hi_of(w: i64) -> i64 {
    (w >> 32) & 4294967295
}

fn fl_lo[r](h: &r [u8], v: i64) -> i64 {
    die("float is not supported")
    0
}

fn fl_hi[r](h: &r [u8], v: i64) -> i64 {
    die("float is not supported")
    0
}

fn is_float[r](h: &r [u8], v: i64) -> bool {
    false
}

fn is_complex[r](h: &r [u8], v: i64) -> bool {
    false
}

fn mk_float[r](h: &mut r [u8], st: &mut r [i64], hi: i64, lo: i64) -> i64 {
    die("float is not supported")
    0
}

fn mk_complex[r](h: &mut r [u8], st: &mut r [i64], rh: i64, rl: i64, ih: i64, il: i64) -> i64 {
    die("float is not supported")
    0
}

