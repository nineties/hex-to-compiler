# dec of planckvm: the conversions of floats to decimal text are not supported
# The functions have the signatures of the unit of planckvm, which the other units call. planckvm stops when one of them is called.
import mem

fun lb_zero[r](w: &mutable r [i64], o: i64) {
    die("float is not supported")
}

fun lb_set[r](w: &mutable r [i64], o: i64, v: i64) {
    die("float is not supported")
}

fun lb_mul_small[r](w: &mutable r [i64], o: i64, m: i64) {
    die("float is not supported")
}

fun lb_add_small[r](w: &mutable r [i64], o: i64, v: i64) {
    die("float is not supported")
}

fun lb_shl[r](w: &mutable r [i64], o: i64, k: i64) {
    die("float is not supported")
}

fun lb_shr1[r](w: &mutable r [i64], o: i64) {
    die("float is not supported")
}

fun lb_cmp[r](w: &r [i64], a: i64, b: i64) -> i64 {
    die("float is not supported")
    0
}

fun lb_sub[r](w: &mutable r [i64], a: i64, b: i64) {
    die("float is not supported")
}

fun lb_is_zero[r](w: &r [i64], o: i64) -> bool {
    die("float is not supported")
    false
}

fun lb_bits[r](w: &r [i64], o: i64) -> i64 {
    die("float is not supported")
    0
}

fun lb_mul_pow10[r](w: &mutable r [i64], o: i64, k: i64) {
    die("float is not supported")
}

fun fmt_float[r](hi: i64, lo: i64, buf: &mutable r [u8]) -> i64 {
    die("float is not supported")
    0
}
