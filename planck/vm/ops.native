# ops: the instructions that do not change the control of planckvm
#
# exec_op runs one instruction word w that is not a jump, a call or a return. base is the first register of the window and kb the index of the constant table.
# The result tells the loop what to do with the word after the instruction:
#   -1 nothing   0 or 1 a condition (the loop compares it with k)   2 skip the next word (a match succeeded)   3 run the next word (a match failed)
#   -2 a runtime error: the message is in st[22] (see fail in builtin.native) and the loop performs the effect Error
import mem
import obj
import big
import flt
import num
import hsh
import arr
import eq
import builtin

fun bool_val[r](h: &r [u8], c: bool) -> i64 {
    if c { return hg(h, 2) }
    hg(h, 1)
}

fun flag(c: bool) -> i64 {
    if c { return 1 }
    0
}

# TEQ TNE TEQK TNEK
fun exec_cond[r](h: &mutable r [u8], st: &mutable r [i64], rs: &r [i64], op: i64, w: i64, base: i64, kb: i64) -> i64 {
    let x = g(rs, base + ((w >> 8) & 255))
    let b = (w >> 16) & 255
    if op == 11 { return flag(equal(h, st, x, g(rs, base + b))) }
    if op == 12 { return flag(not equal(h, st, x, g(rs, base + b))) }
    let k = hg(h, kb + b)
    if op == 15 { return flag(equal(h, st, x, k)) }
    flag(not equal(h, st, x, k))
}

# MATCHEQ MATCHHEAD MATCHTYPE
fun exec_match[r](h: &mutable r [u8], st: &mutable r [i64], rs: &r [i64], op: i64, w: i64, base: i64, kb: i64) -> i64 {
    let v = g(rs, base + ((w >> 8) & 255))
    let b = (w >> 16) & 255
    var ok: bool
    ok = false
    if op == 31 {
        let k = hg(h, kb + ((w >> 16) & 65535))
        ok = equal(h, st, v, k)
    } else if op == 32 {
        if is_mexpr(h, v) {
            if mexpr_head(h, v) == hg(h, kb + b) {
                ok = mexpr_arity(h, v) == (w >> 24)
            }
        }
    } else {
        ok = type_of(h, v) == g(rs, base + b)
    }
    if ok { return 2 }
    3
}

# whether x op y can be computed (op is 37 to 41 or 43 and 44); when it cannot, the error is recorded and the result is false
fun arith_ok[r](h: &mutable r [u8], st: &mutable r [i64], op: i64, x: i64, y: i64) -> bool {
    if is_int(x) and is_int(y) {
        if (op == 40 or op == 41) and y == 1 {
            fail(h, st, "division by zero")
            return false
        }
        return true
    }
    let cx = num_class(h, x)
    let cy = num_class(h, y)
    if op == 43 or op == 44 {
        if cx == 0 or cy == 0 {
            fail(h, st, "comparison: not a number")
            return false
        }
        if cx == 3 or cy == 3 {
            fail(h, st, "comparison: a complex number has no order")
            return false
        }
        return true
    }
    if cx == 0 or cy == 0 {
        fail(h, st, "arithmetic: not a number")
        return false
    }
    if cx == 1 and cy == 1 and (op == 40 or op == 41) and y == 1 {
        fail(h, st, "division by zero")
        return false
    }
    true
}

# ADD SUB MUL DIV MOD ADDI LT GE EQ NE
fun exec_arith[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], op: i64, w: i64, base: i64) -> i64 {
    let a = (w >> 8) & 255
    let b = (w >> 16) & 255
    let c = w >> 24
    let x = g(rs, base + b)
    if op == 42 {
        var sc: i64
        sc = c
        if sc > 127 { sc = sc - 256 }
        if is_int(x) {
            p(rs, base + a, int_from_i64(h, st, int_of(x) + sc))
        } else {
            if num_class(h, x) == 0 {
                fail(h, st, "arithmetic: not a number")
                return -2
            }
            p(rs, base + a, num_arith(h, st, 37, x, small(sc)))
        }
        return -1
    }
    let y = g(rs, base + c)
    if op == 45 {
        p(rs, base + a, bool_val(h, equal(h, st, x, y)))
        return -1
    }
    if op == 46 {
        p(rs, base + a, bool_val(h, not equal(h, st, x, y)))
        return -1
    }
    if not arith_ok(h, st, op, x, y) { return -2 }
    if op == 43 {
        p(rs, base + a, bool_val(h, num_lt(h, x, y)))
        return -1
    }
    if op == 44 {
        p(rs, base + a, bool_val(h, num_ge(h, x, y)))
        return -1
    }
    p(rs, base + a, num_arith(h, st, op, x, y))
    return -1
}

# TUPLE CONS BUILD FIELD HEAD ARITY ARG ARGI PUSH TYPEOF STRLEN ORD HASH
fun exec_obj[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], op: i64, w: i64, base: i64) -> i64 {
    let a = (w >> 8) & 255
    let b = (w >> 16) & 255
    let c = w >> 24
    if op == 27 {
        let m = new_mexpr(h, st, hg(h, 4), c)
        for i in 0 as i64..c {
            set_arg(h, m, i, g(rs, base + b + i))
        }
        p(rs, base + a, fin_mexpr(h, st, m))
    } else if op == 28 {
        let m = new_mexpr(h, st, hg(h, 5), 2)
        set_arg(h, m, 0, g(rs, base + b))
        set_arg(h, m, 1, g(rs, base + c))
        p(rs, base + a, fin_mexpr(h, st, m))
    } else if op == 29 {
        let hd = g(rs, base + b)
        if not is_symbol(h, hd) {
            fail(h, st, "BUILD: the head is not a symbol")
            return -2
        }
        let m = new_mexpr(h, st, hd, c)
        for i in 0 as i64..c {
            set_arg(h, m, i, g(rs, base + b + 1 + i))
        }
        p(rs, base + a, fin_mexpr(h, st, m))
    } else if op == 30 {
        let m = g(rs, base + b)
        if not is_mexpr(h, m) { die("invalid bytecode: FIELD: not a m-expr") }
        if c >= mexpr_arity(h, m) { die("invalid bytecode: FIELD: the index is out of range") }
        p(rs, base + a, mexpr_arg(h, m, c))
    } else if op == 59 {
        p(rs, base + a, small(hash_value(h, st, g(rs, base + b))))
    } else if op == 51 {
        let m = g(rs, base + b)
        if not is_mexpr(h, m) {
            fail(h, st, "PUSH: not a m-expr")
            return -2
        }
        let n = mexpr_arity(h, m)
        let t = new_mexpr(h, st, mexpr_head(h, m), n + 1)
        for i in 0 as i64..n {
            set_arg(h, t, i, mexpr_arg(h, m, i))
        }
        set_arg(h, t, n, g(rs, base + c))
        p(rs, base + a, fin_mexpr(h, st, t))
    } else {
        return exec_read(h, st, rs, op, w, base)
    }
    return -1
}

# HEAD ARITY ARG ARGI TYPEOF STRLEN ORD
fun exec_read[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], op: i64, w: i64, base: i64) -> i64 {
    let a = (w >> 8) & 255
    let b = (w >> 16) & 255
    let c = w >> 24
    let v = g(rs, base + b)
    if op == 52 {
        p(rs, base + a, type_of(h, v))
    } else if op == 53 {
        if not is_string(h, v) {
            fail(h, st, "STRLEN: not a string")
            return -2
        }
        p(rs, base + a, mk_int(str_chars(h, v)))
    } else if op == 54 {
        if not is_string(h, v) {
            fail(h, st, "ORD: not a string")
            return -2
        }
        let i = g(rs, base + c)
        if not is_int(i) {
            fail(h, st, "ORD: not an integer")
            return -2
        }
        let k = int_of(i)
        var b: i64
        b = -1
        if k >= 0 { b = char_pos(h, v, k) }
        if b < 0 or b >= str_len(h, v) {
            p(rs, base + a, mk_int(-1))
        } else {
            p(rs, base + a, mk_int(char_at(h, v, b)))
        }
    } else if is_data(h, v) {
        if (op == 49 or op == 50) and type_of(h, v) == hg(h, 16) {
            fail(h, st, "ARG: a code has no field that a program can read")
            return -2
        }
        if op == 48 {
            p(rs, base + a, mk_int(data_arity(h, v)))
        } else if op == 49 {
            let i = g(rs, base + c)
            if not is_int(i) {
                fail(h, st, "ARG: not an integer")
                return -2
            }
            return exec_data_arg(h, st, rs, base + a, v, int_of(i))
        } else if op == 50 {
            return exec_data_arg(h, st, rs, base + a, v, c)
        } else {
            die("not a m-expr")
        }
    } else {
        if not is_mexpr(h, v) {
            fail(h, st, "not a m-expr")
            return -2
        }
        if op == 47 {
            p(rs, base + a, mexpr_head(h, v))
        } else if op == 48 {
            p(rs, base + a, mk_int(mexpr_arity(h, v)))
        } else if op == 49 {
            let i = g(rs, base + c)
            if not is_int(i) {
                fail(h, st, "ARG: not an integer")
                return -2
            }
            return exec_arg(h, st, rs, base + a, v, int_of(i))
        } else if op == 50 {
            return exec_arg(h, st, rs, base + a, v, c)
        } else {
            die("unknown instruction")
        }
    }
    return -1
}

fun exec_data_arg[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], dst: i64, d: i64, i: i64) -> i64 {
    if i < 0 or i >= data_arity(h, d) {
        fail(h, st, "ARG: out of range")
        return -2
    }
    p(rs, dst, data_arg(h, d, i))
    return -1
}

fun exec_arg[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], dst: i64, m: i64, i: i64) -> i64 {
    if i < 0 or i >= mexpr_arity(h, m) {
        fail(h, st, "ARG: out of range")
        return -2
    }
    p(rs, dst, mexpr_arg(h, m, i))
    return -1
}

fun exec_op[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], op: i64, w: i64, base: i64, kb: i64) -> i64 {
    if op == 11 or op == 12 or op == 15 or op == 16 { return exec_cond(h, st, rs, op, w, base, kb) }
    if op >= 31 and op <= 33 { return exec_match(h, st, rs, op, w, base, kb) }
    if op >= 37 and op <= 46 { return exec_arith(h, st, rs, op, w, base) }
    if (op >= 27 and op <= 30) or (op >= 47 and op <= 54) or op == 59 { return exec_obj(h, st, rs, op, w, base) }
    if (op >= 55 and op <= 58) or op == 60 or op == 61 {
        exec_arr(h, st, rs, op, w, base)
        return -1
    }
    die("unknown instruction")
    return -1
}
