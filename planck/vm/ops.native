# ops: the instructions that do not change the control of planckvm
#
# exec_op runs one instruction word w that is not a jump, a call or a return. base is the first register of the window and kb the index of the constant table.
# The result tells the loop what to do with the word after the instruction:
#   -1 nothing   0 or 1 a condition (the loop compares it with k)   2 skip the next word (a match succeeded)   3 run the next word (a match failed)
import mem
import obj
import big
import flt
import num
import hsh
import arr
import eq

fn bool_val[r](h: &r [u32], c: bool) -> i64 {
    if c { return g(h, 2) }
    g(h, 1)
}

fn flag(c: bool) -> i64 {
    if c { return 1 }
    0
}

# TEQ TNE TEQK TNEK
fn exec_cond[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], op: i64, w: i64, base: i64, kb: i64) -> i64 {
    let x = g(rs, base + ((w >> 8) & 255))
    let b = (w >> 16) & 255
    if op == 11 { return flag(equal(h, st, x, g(rs, base + b))) }
    if op == 12 { return flag(not equal(h, st, x, g(rs, base + b))) }
    let k = g(h, kb + b)
    if op == 15 { return flag(equal(h, st, x, k)) }
    flag(not equal(h, st, x, k))
}

# MATCHEQ MATCHHEAD MATCHTYPE
fn exec_match[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], op: i64, w: i64, base: i64, kb: i64) -> i64 {
    let v = g(rs, base + ((w >> 8) & 255))
    let b = (w >> 16) & 255
    var ok: bool
    ok = false
    if op == 31 {
        let k = g(h, kb + ((w >> 16) & 65535))
        ok = equal(h, st, v, k)
    } else if op == 32 {
        if is_mexpr(h, v) {
            if mexpr_head(h, v) == g(h, kb + b) {
                ok = mexpr_arity(h, v) == (w >> 24)
            }
        }
    } else {
        ok = type_of(h, v) == g(rs, base + b)
    }
    if ok { return 2 }
    3
}

# ADD SUB MUL DIV MOD ADDI LT GE EQ NE
fn exec_arith[r](h: &mut r [u32], st: &mut r [u32], rs: &mut r [u32], op: i64, w: i64, base: i64) {
    let a = (w >> 8) & 255
    let b = (w >> 16) & 255
    let c = w >> 24
    let x = g(rs, base + b)
    if op == 42 {
        var sc: i64
        sc = c
        if sc > 127 { sc = sc - 256 }
        if is_int(x) {
            p(rs, base + a, int_from_i64(h, st, int_of(x) + sc))
        } else {
            p(rs, base + a, num_arith(h, st, 37, x, small(sc)))
        }
        return
    }
    let y = g(rs, base + c)
    if op == 45 {
        p(rs, base + a, bool_val(h, equal(h, st, x, y)))
        return
    }
    if op == 46 {
        p(rs, base + a, bool_val(h, not equal(h, st, x, y)))
        return
    }
    if op == 43 {
        p(rs, base + a, bool_val(h, num_lt(h, x, y)))
        return
    }
    if op == 44 {
        p(rs, base + a, bool_val(h, num_ge(h, x, y)))
        return
    }
    p(rs, base + a, num_arith(h, st, op, x, y))
}

# TUPLE CONS BUILD FIELD HEAD ARITY ARG ARGI PUSH TYPEOF STRLEN ORD HASH
fn exec_obj[r](h: &mut r [u32], st: &mut r [u32], rs: &mut r [u32], op: i64, w: i64, base: i64) {
    let a = (w >> 8) & 255
    let b = (w >> 16) & 255
    let c = w >> 24
    if op == 27 {
        let m = new_mexpr(h, st, g(h, 4), c)
        for i in 0 as i64..c {
            set_arg(h, m, i, g(rs, base + b + i))
        }
        p(rs, base + a, m)
    } else if op == 28 {
        let m = new_mexpr(h, st, g(h, 5), 2)
        set_arg(h, m, 0, g(rs, base + b))
        set_arg(h, m, 1, g(rs, base + c))
        p(rs, base + a, m)
    } else if op == 29 {
        let hd = g(rs, base + b)
        if not is_symbol(h, hd) { die("BUILD: the head is not a symbol") }
        let m = new_mexpr(h, st, hd, c)
        for i in 0 as i64..c {
            set_arg(h, m, i, g(rs, base + b + 1 + i))
        }
        p(rs, base + a, m)
    } else if op == 30 {
        p(rs, base + a, mexpr_arg(h, g(rs, base + b), c))
    } else if op == 59 {
        p(rs, base + a, small(hash_value(h, st, g(rs, base + b))))
    } else if op == 51 {
        let m = g(rs, base + b)
        if not is_mexpr(h, m) { die("PUSH: not a m-expr") }
        let n = mexpr_arity(h, m)
        let t = new_mexpr(h, st, mexpr_head(h, m), n + 1)
        for i in 0 as i64..n {
            set_arg(h, t, i, mexpr_arg(h, m, i))
        }
        set_arg(h, t, n, g(rs, base + c))
        p(rs, base + a, t)
    } else {
        exec_read(h, rs, op, w, base)
    }
}

# HEAD ARITY ARG ARGI TYPEOF STRLEN ORD
fn exec_read[r](h: &r [u32], rs: &mut r [u32], op: i64, w: i64, base: i64) {
    let a = (w >> 8) & 255
    let b = (w >> 16) & 255
    let c = w >> 24
    let v = g(rs, base + b)
    if op == 52 {
        p(rs, base + a, type_of(h, v))
    } else if op == 53 {
        if not is_string(h, v) { die("STRLEN: not a string") }
        p(rs, base + a, mk_int(str_chars(h, v)))
    } else if op == 54 {
        if not is_string(h, v) { die("ORD: not a string") }
        let i = g(rs, base + c)
        if not is_int(i) { die("ORD: not an integer") }
        let k = int_of(i)
        var b: i64
        b = -1
        if k >= 0 { b = char_pos(h, v, k) }
        if b < 0 or b >= str_len(h, v) {
            p(rs, base + a, mk_int(-1))
        } else {
            p(rs, base + a, mk_int(char_at(h, v, b)))
        }
    } else if is_data(h, v) {
        if op == 48 {
            p(rs, base + a, mk_int(data_arity(h, v)))
        } else if op == 49 {
            let i = g(rs, base + c)
            if not is_int(i) { die("ARG: not an integer") }
            exec_data_arg(h, rs, base + a, v, int_of(i))
        } else if op == 50 {
            exec_data_arg(h, rs, base + a, v, c)
        } else {
            die("not a m-expr")
        }
    } else {
        if not is_mexpr(h, v) { die("not a m-expr") }
        if op == 47 {
            p(rs, base + a, mexpr_head(h, v))
        } else if op == 48 {
            p(rs, base + a, mk_int(mexpr_arity(h, v)))
        } else if op == 49 {
            let i = g(rs, base + c)
            if not is_int(i) { die("ARG: not an integer") }
            exec_arg(h, rs, base + a, v, int_of(i))
        } else if op == 50 {
            exec_arg(h, rs, base + a, v, c)
        } else {
            die("unknown instruction")
        }
    }
}

fn exec_data_arg[r](h: &r [u32], rs: &mut r [u32], dst: i64, d: i64, i: i64) {
    if i < 0 or i >= data_arity(h, d) { die("ARG: out of range") }
    p(rs, dst, data_arg(h, d, i))
}

fn exec_arg[r](h: &r [u32], rs: &mut r [u32], dst: i64, m: i64, i: i64) {
    if i < 0 or i >= mexpr_arity(h, m) { die("ARG: out of range") }
    p(rs, dst, mexpr_arg(h, m, i))
}

fn exec_op[r](h: &mut r [u32], st: &mut r [u32], rs: &mut r [u32], op: i64, w: i64, base: i64, kb: i64) -> i64 {
    if op == 11 or op == 12 or op == 15 or op == 16 { return exec_cond(h, st, rs, op, w, base, kb) }
    if op >= 31 and op <= 33 { return exec_match(h, st, rs, op, w, base, kb) }
    if op >= 37 and op <= 46 {
        exec_arith(h, st, rs, op, w, base)
        return -1
    }
    if (op >= 27 and op <= 30) or (op >= 47 and op <= 54) or op == 59 {
        exec_obj(h, st, rs, op, w, base)
        return -1
    }
    if (op >= 55 and op <= 58) or op == 60 or op == 61 {
        exec_arr(h, st, rs, op, w, base)
        return -1
    }
    die("unknown instruction")
    return -1
}
