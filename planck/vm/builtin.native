# builtin: the builtin functions that planckvm calls without a frame, and the output
#
# A builtin is an object of the kind 10 (the number, the id, the number of arguments, the name symbol). The id is the index of the table of
# pvm/image.pk: 0 put, 1 print, 2 println, 3 mexpr, 4 substr, 5 _strcat, 6 intern, 7 symname, 8 exit.
# A builtin that cannot go on gives 0, which is no value, after it records the message of the error in st[22] (see fail); the loop then performs
# the effect Error{none, message}, or stops with the message when no handler is there.
import mem
import obj
import big
import num
import nb
import arr

fn out_lit(m: &static [u8]) {
    write(1, m)
}

fn out_byte(b: i64) {
    let buf = alloc(1, 0 as u8)
    buf[0] = b as u8
    region q {
        var x: &q [u8]
        x = &q buf
        write(1, x)
    }
    free(buf)
}

# out_bytes writes the bytes of the string s from lo to hi-1
fn out_bytes[r](h: &r [u32], s: i64, lo: i64, hi: i64) {
    let n = hi - lo
    if n <= 0 { return }
    let buf = alloc(n, 0 as u8)
    for i in 0 as i64..n {
        buf[i] = str_byte(h, s, lo + i) as u8
    }
    region q {
        var x: &q [u8]
        x = &q buf
        write(1, x)
    }
    free(buf)
}

fn digits(n: i64) -> i64 {
    var k: i64
    var x: i64
    k = 1
    x = n
    while x >= 10 {
        x = x / 10
        k += 1
    }
    k
}

# out_int writes the decimal digits of n
fn out_int(n: i64) {
    var neg: i64
    var x: i64
    neg = 0
    x = n
    if x < 0 {
        neg = 1
        x = 0 - x
    }
    let len2 = digits(x) + neg
    let buf = alloc(len2, 0 as u8)
    if neg == 1 { buf[0] = 45 as u8 }
    var i: i64
    i = len2 - 1
    while i >= neg {
        buf[i] = ((x % 10) + 48) as u8
        x = x / 10
        i -= 1
    }
    region q {
        var b: &q [u8]
        b = &q buf
        write(1, b)
    }
    free(buf)
}

# the letter after the backslash for a byte that print escapes, or -1
fn escape_code(c: i64) -> i64 {
    if c == 0 { return 48 }
    if c == 7 { return 97 }
    if c == 8 { return 98 }
    if c == 9 { return 116 }
    if c == 10 { return 110 }
    if c == 11 { return 118 }
    if c == 12 { return 102 }
    if c == 13 { return 114 }
    if c == 34 { return 34 }
    if c == 92 { return 92 }
    return -1
}

fn out_quoted[r](h: &r [u32], s: i64) {
    let n = str_len(h, s)
    out_lit("\"")
    var start: i64
    var i: i64
    start = 0
    i = 0
    while i < n {
        let e = escape_code(str_byte(h, s, i))
        if e >= 0 {
            out_bytes(h, s, start, i)
            out_byte(92)
            out_byte(e)
            start = i + 1
        }
        i += 1
    }
    out_bytes(h, s, start, n)
    out_lit("\"")
}

fn out_symbol[r](h: &r [u32], sym: i64) {
    let name = g(h, (sym >> 1) + 1)
    out_bytes(h, name, 0, str_len(h, name))
}

# out_big writes the decimal digits of a big integer: the digits are divided by 10000 again and again
fn out_big[r](h: &r [u32], v: i64) {
    let nd = g(h, (v >> 1) + 2)
    let t = alloc(nd, 0 as i64)
    let chunks = alloc(2 * nd + 2, 0 as i64)
    for i in 0 as i64..nd {
        t[i] = g(h, (v >> 1) + 3 + i)
    }
    var n: i64
    var nc: i64
    n = nd
    nc = 0
    while n > 0 {
        var rem: i64
        rem = 0
        var i: i64
        i = n - 1
        while i >= 0 {
            let cur = rem * 65536 + t[i]
            t[i] = cur / 10000
            rem = cur - t[i] * 10000
            i -= 1
        }
        chunks[nc] = rem
        nc += 1
        while n > 0 and t[n - 1] == 0 {
            n -= 1
        }
    }
    if g(h, (v >> 1) + 1) == 1 { out_lit("-") }
    var k: i64
    k = nc - 1
    out_int(chunks[k])
    k -= 1
    while k >= 0 {
        let c = chunks[k]
        out_int(c / 1000)
        out_int((c / 100) % 10)
        out_int((c / 10) % 10)
        out_int(c % 10)
        k -= 1
    }
    free(t)
    free(chunks)
}

# print_value writes the text of a value like print does
fn print_value[r](h: &r [u32], v: i64) {
    if is_int(v) {
        out_int(int_of(v))
        return
    }
    let k = kind_of(h, v)
    if k == 0 {
        out_big(h, v)
    } else if k == 1 or k == 2 {
        die("float is not supported")
    } else if k == 3 {
        out_quoted(h, v)
    } else if k == 4 {
        out_symbol(h, v)
    } else if k == 5 {
        let n = mexpr_arity(h, v)
        out_symbol(h, mexpr_head(h, v))
        out_lit("{")
        for i in 0 as i64..n {
            if i > 0 { out_lit(", ") }
            print_value(h, mexpr_arg(h, v, i))
        }
        out_lit("}")
    } else if k == 10 {
        out_lit("<prim:")
        if (g(h, (v >> 1) + 2) >> 1) == 44 {
            out_symbol(h, g(h, (g(h, (v >> 1) + 4) >> 1) + 2))
        } else {
            out_symbol(h, g(h, (v >> 1) + 4))
        }
        out_lit(">")
    } else if k == 13 {
        out_symbol(h, g(h, (v >> 1) + 2))
    } else if k == 15 {
        let n = data_arity(h, v)
        out_symbol(h, g(h, (g(h, (v >> 1) + 2) >> 1) + 2))
        out_lit("{")
        for i in 0 as i64..n {
            if i > 0 { out_lit(", ") }
            print_value(h, data_arg(h, v, i))
        }
        out_lit("}")
    } else if k == 9 {
        let n = size_of(h, v) - 1
        for i in 0 as i64..n {
            if i > 0 { out_lit("|") }
            print_value(h, g(h, (v >> 1) + 2 + i))
        }
    } else if k == 8 {
        out_lit("<lambda>")
    } else if k == 11 {
        out_lit("<cont>")
    } else if k == 6 {
        out_lit("<array>")
    } else if k == 7 {
        out_lit("<plain>")
    } else {
        out_lit("<?>")
    }
}

# the string with the bytes of the literal m
fn lit_string[r](h: &mut r [u32], st: &mut r [u32], m: &static [u8]) -> i64 {
    let n = len(m)
    let s = new_string(h, st, n)
    for i in 0 as i64..n {
        set_byte(h, s, i, m[i] as i64)
    }
    s
}

# fail records the message m of a runtime error in st[22] and gives 0
fn fail[r](h: &mut r [u32], st: &mut r [u32], m: &static [u8]) -> i64 {
    p(st, 22, lit_string(h, st, m))
    0
}

fn arg_string[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], a: i64, k: i64, m: &static [u8]) -> i64 {
    let v = g(rs, a + k)
    if not is_string(h, v) { return fail(h, st, m) }
    v
}

# the integer of the argument k; with a wrong argument the error is recorded and the result is 0
fn arg_int[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], a: i64, k: i64, m: &static [u8]) -> i64 {
    let v = g(rs, a + k)
    if not is_int(v) {
        fail(h, st, m)
        return 0
    }
    int_of(v)
}

fn do_substr[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], a: i64) -> i64 {
    let s = arg_string(h, st, rs, a, 0, "substr: not a string")
    let i = arg_int(h, st, rs, a, 1, "substr: not an integer")
    let j = arg_int(h, st, rs, a, 2, "substr: not an integer")
    if g(st, 22) != 0 { return 0 }
    if i < 0 { return fail(h, st, "substr: out of range") }
    if j < i { return fail(h, st, "substr: out of range") }
    let lo = char_pos(h, s, i)
    let hi = char_pos(h, s, j)
    if hi < 0 { return fail(h, st, "substr: out of range") }
    let t = new_string(h, st, hi - lo)
    for k in 0 as i64..hi - lo {
        set_byte(h, t, k, str_byte(h, s, lo + k))
    }
    t
}

fn do_strcat[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], a: i64) -> i64 {
    let x = arg_string(h, st, rs, a, 0, "_strcat: not a string")
    let y = arg_string(h, st, rs, a, 1, "_strcat: not a string")
    if g(st, 22) != 0 { return 0 }
    let nx = str_len(h, x)
    let ny = str_len(h, y)
    let t = new_string(h, st, nx + ny)
    for k in 0 as i64..nx {
        set_byte(h, t, k, str_byte(h, x, k))
    }
    for k in 0 as i64..ny {
        set_byte(h, t, nx + k, str_byte(h, y, k))
    }
    t
}

fn do_mexpr[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], a: i64) -> i64 {
    let hd = g(rs, a)
    let t = g(rs, a + 1)
    if not is_symbol(h, hd) { return fail(h, st, "mexpr: the head is not a symbol") }
    if not is_mexpr(h, t) { return fail(h, st, "mexpr: not a m-expr") }
    let n = mexpr_arity(h, t)
    let m = new_mexpr(h, st, hd, n)
    for k in 0 as i64..n {
        set_arg(h, m, k, mexpr_arg(h, t, k))
    }
    m
}

# _record_new(name, Tuple{field, ...}) is Tuple{type, make}. make is the builtin of the id 44: it takes the fields and gives a data of the type.
fn do_record_new[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], a: i64) -> i64 {
    let name = g(rs, a)
    let fields = g(rs, a + 1)
    if not is_symbol(h, name) { die("_record_new: the name is not a symbol") }
    if not is_mexpr(h, fields) { die("_record_new: the fields are not a Tuple") }
    if mexpr_head(h, fields) != g(h, 4) { die("_record_new: the fields are not a Tuple") }
    let n = mexpr_arity(h, fields)
    for i in 0 as i64..n {
        if not is_symbol(h, mexpr_arg(h, fields, i)) { die("_record_new: a field is not a symbol") }
    }
    let t = alloc_obj(h, st, 13, 4)
    p(h, (t >> 1) + 2, name)
    p(h, (t >> 1) + 3, fields)
    p(h, (t >> 1) + 4, type_type(h))
    let mk = alloc_obj(h, st, 10, 4)
    p(h, (mk >> 1) + 2, 44 * 2 + 1)
    p(h, (mk >> 1) + 3, n * 2 + 1)
    p(h, (mk >> 1) + 4, t)
    let r = new_mexpr(h, st, g(h, 4), 2)
    set_arg(h, r, 0, t)
    set_arg(h, r, 1, mk)
    r
}

# new_data makes a data of the type of the builtin mk from the c fields in the registers from a
fn new_data[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], mk: i64, a: i64, c: i64) -> i64 {
    let t = g(h, (mk >> 1) + 4)
    let d = alloc_obj(h, st, 15, 2 + c)
    p(h, (d >> 1) + 2, t)
    for i in 0 as i64..c {
        p(h, (d >> 1) + 3 + i, g(rs, a + i))
    }
    d
}


# ---- the system: files, the standard input and output, the arguments of the program
# A buffer is a plain array of u8: the object of the kind 7 (the number, the type 5, the count n, then the bytes packed from the low end of the words).

# the count of the u8 plain array v, or -1
fn u8_count[r](h: &r [u32], v: i64) -> i64 {
    if is_int(v) { return -1 }
    if kind_of(h, v) != 7 { return -1 }
    if g(h, (v >> 1) + 2) != 5 { return -1 }
    g(h, (v >> 1) + 3)
}

fn u8_get[r](h: &r [u32], v: i64, i: i64) -> i64 {
    (g(h, (v >> 1) + 4 + i / 4) >> ((i % 4) * 8)) & 255
}

fn u8_put[r](h: &mut r [u32], v: i64, i: i64, b: i64) {
    let at = (v >> 1) + 4 + i / 4
    let sh = (i % 4) * 8
    p(h, at, (g(h, at) & (4294967295 - (255 << sh))) | (b << sh))
}

# _sys_open(path): the file descriptor of the file opened for reading, or a negative number
fn do_open[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], a: i64) -> i64 {
    let s = arg_string(h, st, rs, a, 0, "_sys_open: not a string")
    if g(st, 22) != 0 { return 0 }
    let n = str_len(h, s)
    if n == 0 { return small(-1) }
    let buf = alloc(n, 0 as u8)
    for i in 0 as i64..n {
        buf[i] = str_byte(h, s, i) as u8
    }
    var fd: i64
    region q {
        var x: &q [u8]
        x = &q buf
        fd = open(x)
    }
    free(buf)
    small(fd)
}

# _sys_read(fd, buf, n): reads at most n bytes into the start of buf and gives the number of the bytes, 0 at the end of the file, or a negative number
fn do_read[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], a: i64) -> i64 {
    let fd = arg_int(h, st, rs, a, 0, "_sys_read: not an integer")
    let want = arg_int(h, st, rs, a, 2, "_sys_read: not an integer")
    if g(st, 22) != 0 { return 0 }
    let buf = g(rs, a + 1)
    let cap = u8_count(h, buf)
    if cap < 0 { return fail(h, st, "_sys_read: not a u8 plain array") }
    var n: i64
    n = want
    if n > cap { n = cap }
    if n <= 0 { return small(0) }
    let tmp = alloc(n, 0 as u8)
    var got: i64
    region q {
        var x: &mut q [u8]
        x = &mut q tmp
        got = read(fd, x)
    }
    if got > 0 {
        for i in 0 as i64..got {
            u8_put(h, buf, i, tmp[i] as i64)
        }
    }
    free(tmp)
    small(got)
}

# _sys_write(fd, buf, n): writes the first n bytes of buf and gives the number of the bytes written, or a negative number
fn do_write[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], a: i64) -> i64 {
    let fd = arg_int(h, st, rs, a, 0, "_sys_write: not an integer")
    let want = arg_int(h, st, rs, a, 2, "_sys_write: not an integer")
    if g(st, 22) != 0 { return 0 }
    let buf = g(rs, a + 1)
    let cap = u8_count(h, buf)
    if cap < 0 { return fail(h, st, "_sys_write: not a u8 plain array") }
    if want < 0 or want > cap { return fail(h, st, "_sys_write: out of range") }
    if want == 0 { return small(0) }
    let tmp = alloc(want, 0 as u8)
    for i in 0 as i64..want {
        tmp[i] = u8_get(h, buf, i) as u8
    }
    var w: i64
    region q {
        var x: &q [u8]
        x = &q tmp
        w = write(fd, x)
    }
    free(tmp)
    small(w)
}

# ---- the global cells and the code: what the loader of pvm/load.pk uses
# A cell is an object of the kind 13 (the value, the name symbol, the generation as an integer value).

# walk_cells counts the cells of the heap, and when out is an array it puts them in it
fn walk_cells[r](h: &mut r [u32], st: &r [u32], out: i64) -> i64 {
    var cnt: i64
    var at: i64
    var top: i64
    cnt = 0
    at = 16
    top = g(st, 8)
    while at < top {
        let hd = g(h, at)
        if ((hd >> 2) & 15) == 13 {
            if out != 0 { p(h, (out >> 1) + 2 + cnt, at * 2) }
            cnt += 1
        }
        at += 1 + (hd >> 6)
    }
    at = g(st, 6)
    top = g(st, 0)
    while at < top {
        let hd = g(h, at)
        if ((hd >> 2) & 15) == 13 {
            if out != 0 { p(h, (out >> 1) + 2 + cnt, at * 2) }
            cnt += 1
        }
        at += 1 + (hd >> 6)
    }
    cnt
}

fn is_cell[r](h: &r [u32], v: i64) -> bool {
    if is_int(v) { return false }
    kind_of(h, v) == 13
}

# _cells(): an array of all the cells of the global variables
fn do_cells[r](h: &mut r [u32], st: &mut r [u32]) -> i64 {
    let n = walk_cells(h, st, 0)
    let out = new_array(h, st, n)
    walk_cells(h, st, out)
    out
}

fn do_cell_new[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], a: i64) -> i64 {
    let sym = g(rs, a)
    let gn = arg_int(h, st, rs, a, 1, "_cell_new: not an integer")
    if g(st, 22) != 0 { return 0 }
    if not is_symbol(h, sym) { return fail(h, st, "_cell_new: not a symbol") }
    let c = alloc_obj(h, st, 13, 3)
    p(h, (c >> 1) + 1, g(h, 3))
    p(h, (c >> 1) + 2, sym)
    p(h, (c >> 1) + 3, small(gn))
    c
}

# _cell_field(c, i): 0 the value, 1 the name symbol, 2 the generation
fn do_cell_field[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], a: i64) -> i64 {
    let c = g(rs, a)
    let i = arg_int(h, st, rs, a, 1, "_cell_field: not an integer")
    if g(st, 22) != 0 { return 0 }
    if not is_cell(h, c) { return fail(h, st, "_cell_field: not a cell") }
    if i < 0 or i > 2 { return fail(h, st, "_cell_field: out of range") }
    g(h, (c >> 1) + 1 + i)
}

fn do_cell_set[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], a: i64) -> i64 {
    let c = g(rs, a)
    let v = g(rs, a + 1)
    if not is_cell(h, c) { return fail(h, st, "_cell_set: not a cell") }
    wb(h, st, c, v)
    p(h, (c >> 1) + 1, v)
    v
}

# _code_new(arity, nregs, instrs, consts): a code. instrs is a u32 plain array of the instruction words and consts an array of values.
fn do_code_new[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], a: i64) -> i64 {
    let ar = arg_int(h, st, rs, a, 0, "_code_new: not an integer")
    let nr = arg_int(h, st, rs, a, 1, "_code_new: not an integer")
    if g(st, 22) != 0 { return 0 }
    let ins = g(rs, a + 2)
    let ks = g(rs, a + 3)
    if ar < 0 or ar > 255 or nr < 0 or nr > 65535 { return fail(h, st, "_code_new: out of range") }
    if is_int(ins) { return fail(h, st, "_code_new: the instructions are not a u32 plain array") }
    if kind_of(h, ins) != 7 { return fail(h, st, "_code_new: the instructions are not a u32 plain array") }
    if g(h, (ins >> 1) + 2) != 7 { return fail(h, st, "_code_new: the instructions are not a u32 plain array") }
    if is_int(ks) { return fail(h, st, "_code_new: the constants are not an array") }
    if kind_of(h, ks) != 6 { return fail(h, st, "_code_new: the constants are not an array") }
    let n = g(h, (ins >> 1) + 3)
    let m = size_of(h, ks) - 1
    let c = alloc_obj(h, st, 14, 4 + n + m)
    let cb = c >> 1
    p(h, cb + 1, nr * 65536 + ar * 256)
    p(h, cb + 2, n)
    p(h, cb + 3, m)
    p(h, cb + 4, 4294967295)
    for i in 0 as i64..n {
        p(h, cb + 5 + i, g(h, (ins >> 1) + 4 + i))
    }
    for j in 0 as i64..m {
        p(h, cb + 5 + n + j, g(h, (ks >> 1) + 2 + j))
    }
    c
}

# _lambda(code): the Lambda of a code with no environment
fn do_lambda[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], a: i64) -> i64 {
    let c = g(rs, a)
    if is_int(c) { return fail(h, st, "_lambda: not a code") }
    if kind_of(h, c) != 14 { return fail(h, st, "_lambda: not a code") }
    let lam = alloc_obj(h, st, 8, 3)
    p(h, (lam >> 1) + 2, c)
    p(h, (lam >> 1) + 3, g(h, 3))
    lam
}

# _quo(x, y): the quotient of two integers cut toward the negative infinity
fn do_quo[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], a: i64) -> i64 {
    let x = g(rs, a)
    let y = g(rs, a + 1)
    if not is_integer(h, x) or not is_integer(h, y) { return fail(h, st, "_quo: not an integer") }
    if y == 1 { return fail(h, st, "division by zero") }
    let q = num_arith(h, st, 40, x, y)
    let r = num_arith(h, st, 38, x, num_arith(h, st, 39, q, y))
    if r != 1 and ((num_cmp(h, r, 1) < 0) != (num_cmp(h, y, 1) < 0)) { return num_arith(h, st, 38, q, small(1)) }
    q
}

fn call_sys[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], id: i64, a: i64) -> i64 {
    if id == 45 { return do_open(h, st, rs, a) }
    if id == 46 { return do_read(h, st, rs, a) }
    if id == 47 { return do_write(h, st, rs, a) }
    if id == 48 {
        let fd = arg_int(h, st, rs, a, 0, "_sys_close: not an integer")
        if g(st, 22) != 0 { return 0 }
        close(fd)
        return small(0)
    }
    if id == 49 { return small(argc()) }
    if id == 50 {
        let i = arg_int(h, st, rs, a, 0, "_sys_argv: not an integer")
        if g(st, 22) != 0 { return 0 }
        if i < 0 or i >= argc() { return fail(h, st, "_sys_argv: out of range") }
        return lit_string(h, st, argv(i))
    }
    if id == 51 { return do_cells(h, st) }
    if id == 52 { return do_cell_new(h, st, rs, a) }
    if id == 53 { return do_cell_field(h, st, rs, a) }
    if id == 54 { return do_cell_set(h, st, rs, a) }
    if id == 55 { return do_code_new(h, st, rs, a) }
    if id == 56 { return do_lambda(h, st, rs, a) }
    if id == 57 { return do_quo(h, st, rs, a) }
    die("unknown builtin")
    g(h, 3)
}

# call_builtin runs the builtin id with the arguments in the registers from a; the result is a value, or 0 for a runtime error (see fail)
fn call_builtin[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], id: i64, a: i64) -> i64 {
    let nv = g(h, 3)
    if id == 0 {
        let s = arg_string(h, st, rs, a, 0, "put: not a string")
        if g(st, 22) != 0 { return 0 }
        out_bytes(h, s, 0, str_len(h, s))
        return nv
    }
    if id == 1 {
        print_value(h, g(rs, a))
        return nv
    }
    if id == 2 {
        print_value(h, g(rs, a))
        out_lit("\n")
        return nv
    }
    if id == 3 { return do_mexpr(h, st, rs, a) }
    if id == 4 { return do_substr(h, st, rs, a) }
    if id == 5 { return do_strcat(h, st, rs, a) }
    if id == 6 {
        let s = arg_string(h, st, rs, a, 0, "intern: not a string")
        if g(st, 22) != 0 { return 0 }
        return intern_sym(h, st, s)
    }
    if id == 7 {
        let sym = g(rs, a)
        if not is_symbol(h, sym) { return fail(h, st, "symname: not a symbol") }
        return g(h, (sym >> 1) + 1)
    }
    if id == 8 {
        let code = arg_int(h, st, rs, a, 0, "exit: not an integer")
        if g(st, 22) != 0 { return 0 }
        exit(code)
    }
    if id == 43 { return do_record_new(h, st, rs, a) }
    if id >= 45 { return call_sys(h, st, rs, id, a) }
    if id >= 30 { return call_abuiltin(h, st, rs, id, a) }
    if id >= 9 { return call_nbuiltin(h, st, rs, id, a) }
    die("unknown builtin")
    nv
}
