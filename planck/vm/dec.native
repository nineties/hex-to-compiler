# dec: the decimal text of a float, and the bignums on a local array that it and the reading of a decimal text use
#
# A local bignum is a slot of 256 limbs of 16 bits in one array w, from the low end; the slot o is w[o * 256 ..]. The slots are not allocated on the
# heap of planckvm, so the printer works on a read-only heap.
import mem
import flt

fn lb_zero[r](w: &mut r [u32], o: i64) {
    for i in 0 as i64..256 {
        p(w, o * 256 + i, 0)
    }
}

# the slot o is v (0 <= v < 2^62)
fn lb_set[r](w: &mut r [u32], o: i64, v: i64) {
    lb_zero(w, o)
    for i in 0 as i64..4 {
        p(w, o * 256 + i, (v >> (16 * i)) & 65535)
    }
}

fn lb_copy[r](w: &mut r [u32], dst: i64, src: i64) {
    for i in 0 as i64..256 {
        p(w, dst * 256 + i, g(w, src * 256 + i))
    }
}

fn lb_mul_small[r](w: &mut r [u32], o: i64, m: i64) {
    var carry: i64
    carry = 0
    for i in 0 as i64..256 {
        let t = g(w, o * 256 + i) * m + carry
        p(w, o * 256 + i, t & 65535)
        carry = t >> 16
    }
    if carry != 0 { die("a decimal number is too long") }
}

fn lb_add_small[r](w: &mut r [u32], o: i64, v: i64) {
    var carry: i64
    carry = v
    var i: i64
    i = 0
    while carry != 0 and i < 256 {
        let t = g(w, o * 256 + i) + carry
        p(w, o * 256 + i, t & 65535)
        carry = t >> 16
        i += 1
    }
}

fn lb_shl[r](w: &mut r [u32], o: i64, k: i64) {
    let ws = k / 16
    let bs = k % 16
    var i: i64
    i = 255
    while i >= 0 {
        let src = i - ws
        var v: i64
        v = 0
        if src >= 0 {
            v = g(w, o * 256 + src) << bs
            if src >= 1 { v = v | (g(w, o * 256 + src - 1) >> (16 - bs)) }
        }
        p(w, o * 256 + i, v & 65535)
        i -= 1
    }
}

fn lb_shr1[r](w: &mut r [u32], o: i64) {
    for i in 0 as i64..256 {
        var v: i64
        v = g(w, o * 256 + i) >> 1
        if i < 255 { v = v | ((g(w, o * 256 + i + 1) & 1) << 15) }
        p(w, o * 256 + i, v)
    }
}

fn lb_cmp[r](w: &r [u32], a: i64, b: i64) -> i64 {
    var i: i64
    i = 255
    while i >= 0 {
        let x = g(w, a * 256 + i)
        let y = g(w, b * 256 + i)
        if x > y { return 1 }
        if x < y { return -1 }
        i -= 1
    }
    0
}

# the slot a gets a + b
fn lb_add[r](w: &mut r [u32], a: i64, b: i64) {
    var carry: i64
    carry = 0
    for i in 0 as i64..256 {
        let t = g(w, a * 256 + i) + g(w, b * 256 + i) + carry
        p(w, a * 256 + i, t & 65535)
        carry = t >> 16
    }
}

# the slot a gets a - b, where a >= b
fn lb_sub[r](w: &mut r [u32], a: i64, b: i64) {
    var borrow: i64
    borrow = 0
    for i in 0 as i64..256 {
        var t: i64
        t = g(w, a * 256 + i) - g(w, b * 256 + i) - borrow
        borrow = 0
        if t < 0 {
            t = t + 65536
            borrow = 1
        }
        p(w, a * 256 + i, t)
    }
}

fn lb_is_zero[r](w: &r [u32], o: i64) -> bool {
    for i in 0 as i64..256 {
        if g(w, o * 256 + i) != 0 { return false }
    }
    true
}

fn lb_bits[r](w: &r [u32], o: i64) -> i64 {
    var i: i64
    i = 255
    while i >= 0 {
        let x = g(w, o * 256 + i)
        if x != 0 { return i * 16 + nbits(x) }
        i -= 1
    }
    0
}

# the slot o gets o * 10^k
fn lb_mul_pow10[r](w: &mut r [u32], o: i64, k: i64) {
    var n: i64
    n = k
    while n >= 4 {
        lb_mul_small(w, o, 10000)
        n -= 4
    }
    while n > 0 {
        lb_mul_small(w, o, 10)
        n -= 1
    }
}

# the shortest digits that read back as the float (finite, not 0, the magnitude of the words): they go to dg as the characters, and the result is
# n * 65536 + k + 1024 for the n digits, where the value is 0.d1d2...dn * 10^k. The slots 0 to 5 of w are used.
fn shortest[r](hi: i64, lo: i64, w: &mut r [u32], dg: &mut r [u8]) -> i64 {
    let ex = f_ex(hi)
    var f: i64
    var e: i64
    f = f_frac(hi, lo)
    e = -1074
    if ex != 0 {
        f = f | 4503599627370496
        e = ex - 1075
    }
    # the slots: 0 r, 1 s, 2 m+, 3 m-, 4 temporary
    if e >= 0 {
        if f != 4503599627370496 {
            lb_set(w, 0, f)
            lb_shl(w, 0, e + 1)
            lb_set(w, 1, 2)
            lb_set(w, 2, 1)
            lb_shl(w, 2, e)
            lb_copy(w, 3, 2)
        } else {
            lb_set(w, 0, f)
            lb_shl(w, 0, e + 2)
            lb_set(w, 1, 4)
            lb_set(w, 2, 1)
            lb_shl(w, 2, e + 1)
            lb_set(w, 3, 1)
            lb_shl(w, 3, e)
        }
    } else {
        if e == -1074 or f != 4503599627370496 {
            lb_set(w, 0, f)
            lb_shl(w, 0, 1)
            lb_set(w, 1, 1)
            lb_shl(w, 1, 1 - e)
            lb_set(w, 2, 1)
            lb_set(w, 3, 1)
        } else {
            lb_set(w, 0, f)
            lb_shl(w, 0, 2)
            lb_set(w, 1, 1)
            lb_shl(w, 1, 2 - e)
            lb_set(w, 2, 2)
            lb_set(w, 3, 1)
        }
    }
    let even = (f & 1) == 0
    # the estimate of k from the binary exponent, never above the true one
    let t = (e + nbits(f) - 1) * 30102
    var k: i64
    if t <= 0 {
        k = t / 100000
    } else {
        k = (t + 99999) / 100000
    }
    if k >= 0 {
        lb_mul_pow10(w, 1, k)
    } else {
        lb_mul_pow10(w, 0, 0 - k)
        lb_mul_pow10(w, 2, 0 - k)
        lb_mul_pow10(w, 3, 0 - k)
    }
    var go: i64
    go = 1
    while go == 1 {
        lb_copy(w, 4, 0)
        lb_add(w, 4, 2)
        let c = lb_cmp(w, 4, 1)
        if c > 0 or (c == 0 and even) {
            lb_mul_small(w, 1, 10)
            k += 1
        } else {
            go = 0
        }
    }
    var n: i64
    n = 0
    go = 1
    while go == 1 {
        lb_mul_small(w, 0, 10)
        lb_mul_small(w, 2, 10)
        lb_mul_small(w, 3, 10)
        var d: i64
        d = 0
        while lb_cmp(w, 0, 1) >= 0 {
            lb_sub(w, 0, 1)
            d += 1
        }
        let c1 = lb_cmp(w, 0, 3)
        var tc1: bool
        tc1 = c1 < 0
        if even and c1 == 0 { tc1 = true }
        lb_copy(w, 4, 0)
        lb_add(w, 4, 2)
        let c2 = lb_cmp(w, 4, 1)
        var tc2: bool
        tc2 = c2 > 0
        if even and c2 == 0 { tc2 = true }
        if not tc1 and not tc2 {
            dg[n] = (48 + d) as u8
            n += 1
        } else {
            var dd: i64
            dd = d
            if tc2 and not tc1 {
                dd = d + 1
            } else if tc1 and tc2 {
                lb_shl(w, 0, 1)
                let c3 = lb_cmp(w, 0, 1)
                if c3 > 0 or (c3 == 0 and (d & 1) == 1) { dd = d + 1 }
            }
            dg[n] = (48 + dd) as u8
            n += 1
            go = 0
        }
    }
    n * 65536 + k + 1024
}

# fmt_float writes the text of the float (hi, lo) into buf (at least 40 bytes) and gives its length: the shortest digits as 1.5, 100.0, 1.5e-7 or 1.0e16, and inf, -inf, nan
fn fmt_float[r](hi: i64, lo: i64, buf: &mut r [u8]) -> i64 {
    var n: i64
    n = 0
    if f_is_nan(hi, lo) {
        buf[0] = 110 as u8
        buf[1] = 97 as u8
        buf[2] = 110 as u8
        return 3
    }
    if (hi >> 31) == 1 {
        buf[n] = 45 as u8
        n += 1
    }
    if f_is_inf(hi, lo) {
        buf[n] = 105 as u8
        buf[n + 1] = 110 as u8
        buf[n + 2] = 102 as u8
        return n + 3
    }
    if f_is_zero(hi, lo) {
        buf[n] = 48 as u8
        buf[n + 1] = 46 as u8
        buf[n + 2] = 48 as u8
        return n + 3
    }
    let w = alloc(1536, 0 as u32)
    let dg = alloc(32, 0 as u8)
    var res: i64
    region q {
        var wb: &mut q [u32]
        var db: &mut q [u8]
        wb = &mut q w
        db = &mut q dg
        res = shortest(hi, lo, wb, db)
    }
    let nd = res >> 16
    let k = (res & 65535) - 1024
    let x = k - 1
    if x >= -5 and x < 16 {
        if k <= 0 {
            buf[n] = 48 as u8
            buf[n + 1] = 46 as u8
            n += 2
            let nz = 0 - k
            for i in 0 as i64..nz {
                buf[n] = 48 as u8
                n += 1
            }
            for i in 0 as i64..nd {
                buf[n] = dg[i]
                n += 1
            }
        } else if k >= nd {
            for i in 0 as i64..nd {
                buf[n] = dg[i]
                n += 1
            }
            for i in 0 as i64..k - nd {
                buf[n] = 48 as u8
                n += 1
            }
            buf[n] = 46 as u8
            buf[n + 1] = 48 as u8
            n += 2
        } else {
            for i in 0 as i64..k {
                buf[n] = dg[i]
                n += 1
            }
            buf[n] = 46 as u8
            n += 1
            for i in k..nd {
                buf[n] = dg[i]
                n += 1
            }
        }
    } else {
        buf[n] = dg[0]
        buf[n + 1] = 46 as u8
        n += 2
        if nd == 1 {
            buf[n] = 48 as u8
            n += 1
        } else {
            for i in 1 as i64..nd {
                buf[n] = dg[i]
                n += 1
            }
        }
        buf[n] = 101 as u8
        n += 1
        var ax: i64
        ax = x
        if x < 0 {
            buf[n] = 45 as u8
            n += 1
            ax = 0 - x
        }
        if ax >= 100 {
            buf[n] = (48 + ax / 100) as u8
            n += 1
        }
        if ax >= 10 {
            buf[n] = (48 + (ax / 10) % 10) as u8
            n += 1
        }
        buf[n] = (48 + ax % 10) as u8
        n += 1
    }
    free(w)
    free(dg)
    n
}
