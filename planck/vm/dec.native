# dec of planckvm: the conversions of floats to decimal text are not supported
# The functions have the signatures of the unit of planckvm, which the other units call. planckvm stops when one of them is called.
import mem

fn lb_zero[r](w: &mut r [u32], o: i64) {
    die("float is not supported")
}

fn lb_set[r](w: &mut r [u32], o: i64, v: i64) {
    die("float is not supported")
}

fn lb_mul_small[r](w: &mut r [u32], o: i64, m: i64) {
    die("float is not supported")
}

fn lb_add_small[r](w: &mut r [u32], o: i64, v: i64) {
    die("float is not supported")
}

fn lb_shl[r](w: &mut r [u32], o: i64, k: i64) {
    die("float is not supported")
}

fn lb_shr1[r](w: &mut r [u32], o: i64) {
    die("float is not supported")
}

fn lb_cmp[r](w: &r [u32], a: i64, b: i64) -> i64 {
    die("float is not supported")
    0
}

fn lb_sub[r](w: &mut r [u32], a: i64, b: i64) {
    die("float is not supported")
}

fn lb_is_zero[r](w: &r [u32], o: i64) -> bool {
    die("float is not supported")
    false
}

fn lb_bits[r](w: &r [u32], o: i64) -> i64 {
    die("float is not supported")
    0
}

fn lb_mul_pow10[r](w: &mut r [u32], o: i64, k: i64) {
    die("float is not supported")
}

fn fmt_float[r](hi: i64, lo: i64, buf: &mut r [u8]) -> i64 {
    die("float is not supported")
    0
}
