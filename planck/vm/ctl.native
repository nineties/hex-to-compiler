# ctl: the instructions that change the control of planckvm, the environments, the Fusions and the continuations
#
# A frame is 7 words of the frame stack fs: 0 fun, 1 env, 2 alts, 3 next, 4 base, 5 pc, 6 ret. The pc is the index of the instruction from the
# first instruction of the code (the code is the Code data, see code_arity). ret is the register (the low 16 bits), the mode (bits 16 and 17: 0 put the value in the register, 1 and 2 the
# call was made by a condition instruction with k = mode - 1, 3 drop the value) and the kind (the bits from 18: 0 normal, 1 boundary, 2 transfer).
# The control state of the loop is the top frame fp only: after an instruction of this unit the loop reads the code, the pc and the base again.
#
# A continuation keeps a ret word in place of the register: the register of PERFORM, or the ret word of the call that did not match (see match_failed).
#
# Objects: Fusion (kind 9: the number, then the alternatives), environment (kind 12: the parent, then the slots),
# continuation (kind 11: the number, the register of PERFORM, the number of frames, the frames, the registers).
# The result of enter and next_alt: 0 a frame was made at the index st[3]; 1 a builtin gave the value st[2] (st[3] is the frame it was called for);
# 2 no alternative takes the arguments, 3 the call is a runtime error (the message is in st[22], see fail in builtin.native).
# A runtime error is the effect Error{loc, message} performed by the frame that made it (raise_pending); with no boundary the message is written
# to the standard error and the program stops.
import mem
import obj
import builtin

fun code_of[r](h: &r [u8], lam: i64) -> i64 {
    hg(h, (lam >> 3) + 2) >> 3
}

# A code is a data of the type Code (the word 16 of the heap): the word index code is the header, and the words after the identity and the type are the fields,
# all values: 3 nregs and 4 arity (integers), 5 the u32 plain array of the instructions, 6 the array of the constants, 7 params (an integer, -1 if none),
# 8 the u32 plain array of the position table, 9 the index in the constants of the string of the file name (an integer, -1 if none).
fun code_arity[r](h: &r [u8], code: i64) -> i64 {
    hg(h, code + 4) >> 1
}

fun code_nregs[r](h: &r [u8], code: i64) -> i64 {
    hg(h, code + 3) >> 1
}

# the byte position of the first instruction of the code, and the index of the first constant
fun code_ib[r](h: &r [u8], code: i64) -> i64 {
    hg(h, code + 5) + 32
}

fun code_kb[r](h: &r [u8], code: i64) -> i64 {
    (hg(h, code + 6) >> 3) + 2
}

fun ret_word(a: i64, mode: i64, kind: i64) -> i64 {
    a + mode * 65536 + kind * 262144
}

fun is_func[r](h: &r [u8], f: i64) -> bool {
    if is_int(f) { return false }
    let k = kind_of(h, f)
    k == 8 or k == 9 or k == 10 or k == 11
}

# the alternatives of a function: the elements of a Fusion, or the function itself
fun alt_count[r](h: &r [u8], f: i64) -> i64 {
    if kind_of(h, f) == 9 { return size_of(h, f) - 1 }
    1
}

fun alt_at[r](h: &r [u8], f: i64, i: i64) -> i64 {
    if kind_of(h, f) == 9 { return hg(h, (f >> 3) + 2 + i) }
    f
}

# whether the alternative (a Lambda, a builtin or a continuation) takes c arguments
fun alt_takes[r](h: &r [u8], f: i64, c: i64) -> bool {
    let k = kind_of(h, f)
    if k == 8 { return code_arity(h, code_of(h, f)) == c }
    if k == 10 { return (hg(h, (f >> 3) + 3) >> 1) == c }
    if k == 11 { return c == 1 }
    false
}

# deliver gives the value v to the frame q as the ret word rt says: into a register, or as the truth of the condition instruction
fun deliver[r](h: &r [u8], rs: &mutable r [i64], fs: &mutable r [i64], q: i64, rt: i64, v: i64) {
    let mode = (rt >> 16) & 3
    if mode == 0 {
        p(rs, g(fs, q + 4) + (rt & 65535), v)
    } else if mode != 3 {
        # the word after the condition instruction is JMP: it is run when the truth equals k, else skipped
        var cond: i64
        cond = 0
        if v != hg(h, 1) { cond = 1 }
        if cond != mode - 1 { p(fs, q + 5, g(fs, q + 5) + 1) }
    }
}

# do_return drops the frame fp and gives the value v to the frame below as the ret of the dropped frame says; the result is the frame below
fun do_return[r](h: &r [u8], st: &r [i64], rs: &mutable r [i64], fs: &mutable r [i64], fp: i64, v: i64) -> i64 {
    let q = fp - 7
    deliver(h, rs, fs, q, g(fs, fp + 6), v)
    q
}

# resume copies the frames and the registers of the continuation k to fs from fp and to rs from sl, with the argument at rs[nb]
fun resume[r](h: &r [u8], st: &mutable r [i64], rs: &mutable r [i64], fs: &mutable r [i64], fp: i64, k: i64, nb: i64, rt: i64, sl: i64) -> i64 {
    let v = g(rs, nb)
    let kb = k >> 3
    let nf = hg(h, kb + 3)
    let nr = size_of(h, k) - 3 - 7 * nf
    if sl + nr > len(rs) { die("stack overflow") }
    if fp + 7 * nf > len(fs) { die("stack overflow") }
    for i in 0 as i64..nr {
        p(rs, sl + i, hg(h, kb + 4 + 7 * nf + i))
    }
    for j in 0 as i64..nf {
        for t in 0 as i64..7 {
            p(fs, fp + 7 * j + t, hg(h, kb + 4 + 7 * j + t))
        }
        p(fs, fp + 7 * j + 4, g(fs, fp + 7 * j + 4) + sl)
    }
    p(fs, fp + 6, (rt & 262143) + 262144)
    let last = fp + 7 * (nf - 1)
    deliver(h, rs, fs, last, hg(h, kb + 2), v)
    p(st, 3, last)
    0
}

# enter calls f with c arguments that are at rs[nb]. The new frame is at fp and its ret is rt. sl is the place where a continuation is copied.
# The alternatives are tried from start.
fun enter[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], fs: &mutable r [i64], fp: i64, f: i64, c: i64, nb: i64, rt: i64, sl: i64, start: i64) -> i64 {
    if not is_func(h, f) {
        fail(h, st, "not a function")
        return 3
    }
    let fk = kind_of(h, f)
    if fk == 10 {
        if (hg(h, (f >> 3) + 3) >> 1) != c {
            fail(h, st, "not a function")
            return 3
        }
    }
    var keep: i64
    keep = 0
    if fk == 9 { keep = 1 }
    if (rt >> 18) == 2 { keep = 1 }
    let n = alt_count(h, f)
    var i: i64
    var sel: i64
    i = start
    sel = -1
    while sel < 0 and i < n {
        if alt_takes(h, alt_at(h, f, i), c) {
            sel = i
        } else {
            i += 1
        }
    }
    p(st, 3, fp)
    if sel < 0 { return 2 }
    let alt = alt_at(h, f, sel)
    let kd = kind_of(h, alt)
    if kd == 10 {
        var res: i64
        if (hg(h, (alt >> 3) + 2) >> 1) == 44 {
            res = new_data(h, st, rs, alt, nb, c)
        } else {
            res = call_builtin(h, st, rs, hg(h, (alt >> 3) + 2) >> 1, nb)
        }
        if res == 0 { return 3 }
        p(st, 2, res)
        return 1
    }
    if kd == 11 { return resume(h, st, rs, fs, fp, alt, nb, rt, sl) }
    let code = code_of(h, alt)
    if nb + code_nregs(h, code) > len(rs) { die("stack overflow") }
    if fp + 7 > len(fs) { die("stack overflow") }
    p(fs, fp, alt)
    p(fs, fp + 1, hg(h, (alt >> 3) + 3))
    if keep == 1 {
        p(fs, fp + 2, f)
    } else {
        p(fs, fp + 2, hg(h, 3))
    }
    p(fs, fp + 3, sel + 1)
    p(fs, fp + 4, nb)
    p(fs, fp + 5, 0)
    p(fs, fp + 6, rt)
    0
}

# capture makes a continuation of the frames q to last, the registers s0 to rend-1, and the continuation prior (0 if none) after them
fun capture[r](h: &mutable r [u8], st: &mutable r [i64], rs: &r [i64], fs: &r [i64], q: i64, last: i64, s0: i64, rend: i64, reg: i64, prior: i64) -> i64 {
    let nfa = (last - q) / 7 + 1
    let nra = rend - s0
    var nfp: i64
    var nrp: i64
    var pb: i64
    nfp = 0
    nrp = 0
    pb = 0
    if prior != 0 {
        pb = prior >> 3
        nfp = hg(h, pb + 3)
        nrp = size_of(h, prior) - 3 - 7 * nfp
    }
    let k = alloc_obj(h, st, 11, 3 + 7 * (nfa + nfp) + nra + nrp)
    let kb = k >> 3
    hp(h, kb + 1, 0)
    hp(h, kb + 2, reg)
    hp(h, kb + 3, nfa + nfp)
    for j in 0 as i64..nfa {
        for t in 0 as i64..7 {
            hp(h, kb + 4 + 7 * j + t, g(fs, q + 7 * j + t))
        }
        hp(h, kb + 4 + 7 * j + 4, g(fs, q + 7 * j + 4) - s0)
    }
    for j in 0 as i64..nfp {
        for t in 0 as i64..7 {
            hp(h, kb + 4 + 7 * (nfa + j) + t, hg(h, pb + 4 + 7 * j + t))
        }
        hp(h, kb + 4 + 7 * (nfa + j) + 4, hg(h, pb + 4 + 7 * j + 4) + (rend - s0))
    }
    let rb = kb + 4 + 7 * (nfa + nfp)
    for i in 0 as i64..nra {
        hp(h, rb + i, g(rs, s0 + i))
    }
    for i in 0 as i64..nrp {
        hp(h, rb + nra + i, hg(h, pb + 4 + 7 * nfp + i))
    }
    k
}

# the index of the nearest boundary frame at or below q, or -1
fun find_boundary[r](fs: &r [i64], q0: i64) -> i64 {
    var q: i64
    var go: i64
    q = q0
    go = 1
    while go == 1 {
        if q < 0 {
            go = 0
        } else if (g(fs, q + 6) >> 18) == 1 {
            go = 0
        } else {
            q -= 7
        }
    }
    q
}

# prepare turns the boundary frame q into the transfer frame that calls its handler with the value v and the continuation k
fun prepare[r](rs: &mutable r [i64], fs: &mutable r [i64], q: i64, v: i64, k: i64) {
    let fb = g(fs, q + 4)
    p(fs, q + 2, g(rs, fb - 1))
    p(fs, q + 3, 0)
    p(fs, q + 5, 0)
    p(fs, q + 6, (g(fs, q + 6) & 262143) + 524288)
    p(rs, fb, v)
    p(rs, fb + 1, k)
}

# whether the string s is "MatchingFailed" (14 bytes, packed from the low end of the words)
fun is_mf_name[r](h: &r [u8], s: i64) -> bool {
    if str_len(h, s) != 14 { return false }
    let b = (s >> 3) + 2
    hg(h, b) == 7453010330410836301 and hg(h, b + 1) == 110386773320006
}

fun is_mf[r](h: &r [u8], v: i64) -> bool {
    if not is_mexpr(h, v) { return false }
    is_mf_name(h, hg(h, (mexpr_head(h, v) >> 3) + 1))
}

# no boundary takes the effect v: a MatchingFailed stops with matching failed, any other effect with unhandled effect
fun no_handler[r](h: &r [u8], v: i64) {
    if is_mf(h, v) { die("matching failed") }
    die("unhandled effect")
}

fun mf_symbol[r](h: &mutable r [u8], st: &mutable r [i64]) -> i64 {
    let s = new_string(h, st, 14)
    let b = (s >> 3) + 2
    hp(h, b, 7453010330410836301)
    hp(h, b + 1, 110386773320006)
    intern_sym(h, st, s)
}

# the symbol Loc ("Loc" is 3 bytes: 76, 111 and 99 from the low end of the word)
fun loc_symbol[r](h: &mutable r [u8], st: &mutable r [i64]) -> i64 {
    let s = new_string(h, st, 3)
    hp(h, (s >> 3) + 2, 6516556)
    intern_sym(h, st, s)
}

# the Loc{file, line, column} of the call that the frame q is making, or none: the entry of the position table of the code of q for the word before the saved pc,
# found by a binary search (the entries are in ascending order of pc). It is none when q < 0 or the code has no such entry.
fun frame_loc[r](h: &mutable r [u8], st: &mutable r [i64], fs: &r [i64], q: i64) -> i64 {
    if q < 0 { return hg(h, 3) }
    let code = code_of(h, g(fs, q))
    let ls = hg(h, code + 8)
    let nl = hg(h, (ls >> 3) + 3) / 3
    let fi = hg(h, code + 9) >> 1
    if nl == 0 or fi == -1 { return hg(h, 3) }
    let pc = g(fs, q + 5) - 1
    let lb = ls + 32
    var lo: i64
    var hi: i64
    var at: i64
    lo = 0
    hi = nl - 1
    at = -1
    while lo <= hi and at < 0 {
        let mid = (lo + hi) / 2
        let e = ld_u32(h, lb + 12 * mid)
        if e == pc {
            at = mid
        } else if e < pc {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    if at < 0 { return hg(h, 3) }
    let sym = loc_symbol(h, st)
    let m = new_mexpr(h, st, sym, 3)
    set_arg(h, m, 0, hg(h, code_kb(h, code) + fi))
    set_arg(h, m, 1, ld_u32(h, lb + 12 * at + 4) * 2 + 1)
    set_arg(h, m, 2, ld_u32(h, lb + 12 * at + 8) * 2 + 1)
    fin_mexpr(h, st, m)
}

# MatchingFailed{f, Tuple{the c arguments at rs[nb]}, loc}: loc is the position of the call, Loc{file, line, column}, or none
fun mf_value[r](h: &mutable r [u8], st: &mutable r [i64], rs: &r [i64], f: i64, nb: i64, c: i64, loc: i64) -> i64 {
    let t = new_mexpr(h, st, hg(h, 4), c)
    for i in 0 as i64..c {
        set_arg(h, t, i, g(rs, nb + i))
    }
    let tt = fin_mexpr(h, st, t)
    let sym = mf_symbol(h, st)
    let m = new_mexpr(h, st, sym, 3)
    set_arg(h, m, 0, f)
    set_arg(h, m, 1, tt)
    set_arg(h, m, 2, loc)
    fin_mexpr(h, st, m)
}

# the end of the registers of the frame q
fun frame_end[r](h: &r [u8], fs: &r [i64], q: i64) -> i64 {
    g(fs, q + 4) + code_nregs(h, code_of(h, g(fs, q)))
}

# fail_boundary performs the effect v for a call that did not match, made by the frame last; the value that the continuation gets is given to
# last as the ret word rw says. The result is the boundary frame, made into the transfer frame; with no boundary the program stops.
fun fail_boundary[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], fs: &mutable r [i64], last: i64, rw: i64, v: i64) -> i64 {
    let q = find_boundary(fs, last)
    if q < 0 { die("matching failed") }
    let fb = g(fs, q + 4)
    let k = capture(h, st, rs, fs, q, last, fb - 2, frame_end(h, fs, last), rw, 0)
    prepare(rs, fs, q, v, k)
    q
}

# match_failed: the frame cur ran out of alternatives. f is the function that was called. The call returns to the frame below cur with the value of the resumption.
fun match_failed[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], fs: &mutable r [i64], cur: i64, f: i64) -> i64 {
    let rt = g(fs, cur + 6)
    if cur < 7 { die("matching failed") }
    if (rt >> 18) != 0 { die("matching failed") }
    let c = code_arity(h, code_of(h, g(fs, cur)))
    let v = mf_value(h, st, rs, f, g(fs, cur + 4), c, frame_loc(h, st, fs, cur - 7))
    fail_boundary(h, st, rs, fs, cur - 7, rt & 262143, v)
}

# transfer: no alternative of the handler in the transfer frame t took the effect; the next boundary below gets it with a longer continuation
fun transfer[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], fs: &mutable r [i64], t: i64) -> i64 {
    let tb = g(fs, t + 4)
    let v = g(rs, tb)
    let k0 = g(rs, tb + 1)
    let q = find_boundary(fs, t - 7)
    if q < 0 { no_handler(h, v) }
    let gb = g(fs, q + 4)
    let k = capture(h, st, rs, fs, q, t - 7, gb - 2, tb - 2, hg(h, (k0 >> 3) + 2), k0)
    prepare(rs, fs, q, v, k)
    q
}

# next_alt tries the next alternatives of the function that was called for the frame fp; the transfer frame goes on to the outer boundary
fun next_alt[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], fs: &mutable r [i64], fp: i64) -> i64 {
    var cur: i64
    var status: i64
    cur = fp
    status = 2
    while status == 2 {
        let alts = g(fs, cur + 2)
        let rt = g(fs, cur + 6)
        if alts == hg(h, 3) {
            cur = match_failed(h, st, rs, fs, cur, g(fs, cur))
        } else {
            var c: i64
            c = 2
            if (rt >> 18) != 2 { c = code_arity(h, code_of(h, g(fs, cur))) }
            let nb = g(fs, cur + 4)
            status = enter(h, st, rs, fs, cur, alts, c, nb, rt, nb - 1, g(fs, cur + 3))
            if status == 2 {
                if (rt >> 18) != 2 {
                    cur = match_failed(h, st, rs, fs, cur, alts)
                } else {
                    cur = transfer(h, st, rs, fs, cur)
                }
            }
        }
    }
    status
}

# die_pending writes the pending message to the standard error and stops the program
fun die_pending[r](h: &r [u8], st: &r [i64]) {
    let s = g(st, 22)
    let n = str_len(h, s)
    let buf = allocate(n + 1, 0 as u8)
    for i in 0 as i64..n {
        buf[i] = str_byte(h, s, i) as u8
    }
    buf[n] = 10 as u8
    region q {
        var x: &q [u8]
        x = &q buf
        write(2, x)
    }
    free(buf)
    exit(1)
}

# raise_pending performs the effect Error{loc, message} for the pending runtime error, in the frame fp that is the top frame. The result of the
# resumption is given to the frame as the ret word rw says. The result is the top frame after the effect.
fun raise_pending[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], fs: &mutable r [i64], fp: i64, rw: i64) -> i64 {
    if find_boundary(fs, fp) < 0 { die_pending(h, st) }
    let msg = g(st, 22)
    p(st, 22, 0)
    let sym = intern_sym(h, st, lit_string(h, st, "Error"))
    let m = new_mexpr(h, st, sym, 2)
    set_arg(h, m, 0, frame_loc(h, st, fs, fp))
    set_arg(h, m, 1, msg)
    let q = fail_boundary(h, st, rs, fs, fp, rw, fin_mexpr(h, st, m))
    let status = next_alt(h, st, rs, fs, q)
    if status == 1 { return do_return(h, st, rs, fs, g(st, 3), g(st, 2)) }
    if status == 3 { return raise_pending(h, st, rs, fs, g(st, 3) - 7, ret_word(0, 3, 0)) }
    g(st, 3)
}

fun do_perform[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], fs: &mutable r [i64], fp: i64, a: i64, b: i64) -> i64 {
    let base = g(fs, fp + 4)
    let v = g(rs, base + b)
    let q = find_boundary(fs, fp)
    if q < 0 { no_handler(h, v) }
    let fb = g(fs, q + 4)
    let nregs = code_nregs(h, code_of(h, g(fs, fp)))
    let k = capture(h, st, rs, fs, q, fp, fb - 2, base + nregs, a, 0)
    prepare(rs, fs, q, v, k)
    next_alt(h, st, rs, fs, q)
}

# call_failed: the call f of c arguments at rs[nb], made by the frame fp, was taken by no alternative; the call gets the value of the resumption as the ret word rw says
fun call_failed[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], fs: &mutable r [i64], fp: i64, f: i64, nb: i64, c: i64, rw: i64) -> i64 {
    let v = mf_value(h, st, rs, f, nb, c, frame_loc(h, st, fs, fp))
    let q = fail_boundary(h, st, rs, fs, fp, rw, v)
    let status = next_alt(h, st, rs, fs, q)
    if status == 1 { return do_return(h, st, rs, fs, g(st, 3), g(st, 2)) }
    if status == 3 { return raise_pending(h, st, rs, fs, g(st, 3) - 7, ret_word(0, 3, 0)) }
    g(st, 3)
}

# the instructions CALL TCALL RET NEXT HANDLE PERFORM; pc is the saved pc of the top frame fp. The result is the top frame after the instruction.
fun exec_ctl[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], fs: &mutable r [i64], fp: i64, op: i64, w: i64, pc: i64) -> i64 {
    let base = g(fs, fp + 4)
    let a = (w >> 8) & 255
    let b = (w >> 16) & 255
    let c = w >> 24
    p(fs, fp + 5, pc)
    var status: i64
    if op == 20 {
        status = enter(h, st, rs, fs, fp + 7, g(rs, base + b), c, base + b + 1, ret_word(a, 0, 0), base + b + 1, 0)
        if status == 0 { return g(st, 3) }
        if status == 1 {
            p(rs, base + a, g(st, 2))
            return fp
        }
        if status == 3 { return raise_pending(h, st, rs, fs, fp, ret_word(a, 0, 0)) }
        return call_failed(h, st, rs, fs, fp, g(rs, base + b), base + b + 1, c, ret_word(a, 0, 0))
    } else if op == 21 {
        let f = g(rs, base + b)
        for i in 0 as i64..c + 1 {
            p(rs, base - 1 + i, g(rs, base + b + i))
        }
        status = enter(h, st, rs, fs, fp, f, c, base, g(fs, fp + 6) & 262143, base - 1, 0)
        if status == 0 { return g(st, 3) }
        if status == 1 { return do_return(h, st, rs, fs, fp, g(st, 2)) }
        if status == 3 { return raise_pending(h, st, rs, fs, fp, ret_word(0, 3, 0)) }
        # the frame is dropped by the tail call: the call returns to its caller
        let rt = g(fs, fp + 6)
        if fp < 7 or (rt >> 18) != 0 { die("matching failed") }
        return call_failed(h, st, rs, fs, fp - 7, f, base, c, rt & 262143)
    } else if op == 22 {
        return do_return(h, st, rs, fs, fp, g(rs, base + a))
    } else if op == 23 {
        status = next_alt(h, st, rs, fs, fp)
        if status == 1 { return do_return(h, st, rs, fs, g(st, 3), g(st, 2)) }
        if status == 3 { return raise_pending(h, st, rs, fs, g(st, 3) - 7, ret_word(0, 3, 0)) }
        return g(st, 3)
    } else if op == 34 {
        let hd = g(rs, base + b + 1)
        if not is_func(h, hd) {
            fail(h, st, "not a function")
            return raise_pending(h, st, rs, fs, fp, ret_word(a, 0, 0))
        }
        status = enter(h, st, rs, fs, fp + 7, g(rs, base + b), 0, base + b + 2, ret_word(a, 0, 1), base + b + 1, 0)
        if status == 0 { return g(st, 3) }
        if status == 1 {
            p(rs, base + a, g(st, 2))
            return fp
        }
        if status == 3 { return raise_pending(h, st, rs, fs, fp, ret_word(a, 0, 0)) }
        return call_failed(h, st, rs, fs, fp, g(rs, base + b), base + b + 2, 0, ret_word(a, 0, 0))
    } else if op == 35 {
        status = do_perform(h, st, rs, fs, fp, a, b)
        if status == 1 { return do_return(h, st, rs, fs, g(st, 3), g(st, 2)) }
        if status == 3 { return raise_pending(h, st, rs, fs, g(st, 3) - 7, ret_word(0, 3, 0)) }
        return g(st, 3)
    }
    die("unknown instruction")
    fp
}

# NEWENV ENVGET ENVSET
fun exec_env[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], fs: &mutable r [i64], fp: i64, op: i64, w: i64, base: i64) {
    let a = (w >> 8) & 255
    let b = (w >> 16) & 255
    let c = w >> 24
    if op == 6 {
        let n = w >> 16
        let e = alloc_obj(h, st, 12, 1 + n)
        hp(h, (e >> 3) + 1, g(fs, fp + 1))
        for i in 0 as i64..n {
            hp(h, (e >> 3) + 2 + i, hg(h, 3))
        }
        p(fs, fp + 1, e)
        return
    }
    var e: i64
    e = g(fs, fp + 1)
    for i in 0 as i64..b {
        e = hg(h, (e >> 3) + 1)
    }
    if op == 7 {
        p(rs, base + a, hg(h, (e >> 3) + 2 + c))
    } else {
        wb(h, st, e, g(rs, base + a))
        hp(h, (e >> 3) + 2 + c, g(rs, base + a))
    }
}

# FUSION: R[A] := R[B] | R[C]
# the result is -1, or -2 for a runtime error (the message is in st[22])
fun exec_fusion[r](h: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], w: i64, base: i64) -> i64 {
    let a = (w >> 8) & 255
    let x = g(rs, base + ((w >> 16) & 255))
    let y = g(rs, base + (w >> 24))
    if x == hg(h, 3) {
        p(rs, base + a, y)
        return -1
    }
    if not is_func(h, x) {
        fail(h, st, "FUSION: not a function")
        return -2
    }
    if not is_func(h, y) {
        fail(h, st, "FUSION: not a function")
        return -2
    }
    let nx = alt_count(h, x)
    let ny = alt_count(h, y)
    let f = alloc_obj(h, st, 9, 1 + nx + ny)
    for i in 0 as i64..nx {
        hp(h, (f >> 3) + 2 + i, alt_at(h, x, i))
    }
    for i in 0 as i64..ny {
        hp(h, (f >> 3) + 2 + nx + i, alt_at(h, y, i))
    }
    p(rs, base + a, f)
    return -1
}
