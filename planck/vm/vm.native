# planckvm: the bytecode machine of planck, written in native
#
# Usage: vm <image>. The image is written by pvm/image.pk. The words, the objects and the instructions that do not change the control are in the
# units mem, obj, builtin and ops; this unit has the loop, the calls and the returns.
# The heap is an array of bytes and the registers and the frames are arrays of i64. The machine state st: st[0] is the first free word of the heap.
import mem
import obj
import builtin
import big
import num
import ctl
import ops
import gc

# the file is read into the heap from the byte 0; the number of words is the result
fn load[r](h: &mut r [u8], path: &static [u8]) -> i64 {
    let fd = open(path)
    if fd < 0 { die("cannot open the image") }
    let chunk = alloc(4096, 0 as u8)
    var pos: i64
    var more: i64
    pos = 0
    more = 1
    region q {
    var cb: &mut q [u8]
    cb = &mut q chunk
    while more != 0 {
        let n = read(fd, cb)
        if n <= 0 {
            more = 0
        } else {
            if pos + n > len(h) { die("the image is too big") }
            for i in 0 as i64..n {
                h[pos + i] = cb[i]
            }
            pos += n
        }
    }
    }
    close(fd)
    free(chunk)
    pos / 8
}


# register_image puts the strings, the symbols and the m-exprs of the image (the words 17 to n) in the table of the interned objects; the image has
# no two of them that are equal
fn register_image[r](h: &mut r [u8], st: &mut r [i64], n: i64) {
    var at: i64
    at = 17
    while at < n {
        let hd = hg(h, at)
        let k = (hd >> 2) & 15
        if k == 3 or k == 4 or k == 5 { it_find(h, st, at * 8) }
        at += 1 + (hd >> 6)
    }
    p(st, 25, 0)
    p(st, 26, 0)
}

# run runs the code of the Lambda entry in a stub frame whose code is the Lambda stub, and gives the value that HALT has
fn run[r](h: &mut r [u8], t: &mut r [u8], st: &mut r [i64], rs: &mut r [i64], fs: &mut r [i64], stub: i64, entry: i64) -> i64 {
    var vfalse: i64
    vfalse = hg(h, 1)
    var fp: i64
    var base: i64
    var code: i64
    var ip: i64
    var kb: i64
    var ib: i64
    var running: i64
    var result: i64
    var w: i64
    var op: i64
    var a: i64
    var b: i64
    var c: i64
    var cond: i64
    result = 0
    running = 1
    # the stub frame: CALL R0 R0 0 and HALT R0
    p(rs, 0, entry)
    fp = 0
    base = 0
    p(fs, 0, stub)
    p(fs, 1, hg(h, 3))
    p(fs, 2, hg(h, 3))
    p(fs, 3, 0)
    p(fs, 4, 0)
    p(fs, 5, 0)
    p(fs, 6, 0)
    code = hg(h, (stub >> 3) + 2) >> 3
    ib = code_ib(h, code)
    ip = ib
    kb = code_kb(h, code)
    while running == 1 {
        if g(st, 12) != 0 {
            # a collection is wanted: it is done between two instructions, and the code, the pc and the base are read again from the top frame
            p(fs, fp + 5, (ip - ib) >> 2)
            collect(h, t, st, rs, fs, fp)
            vfalse = hg(h, 1)
            base = g(fs, fp + 4)
            code = hg(h, (g(fs, fp) >> 3) + 2) >> 3
            ib = code_ib(h, code)
            ip = ib + g(fs, fp + 5) * 4
            kb = code_kb(h, code)
        }
        w = ld_u32(h, ip)
        ip += 4
        op = w & 255
        a = (w >> 8) & 255
        b = (w >> 16) & 255
        c = (w >> 24) & 255
        cond = -1
        if op == 0 {
            p(rs, base + a, g(rs, base + b))
        } else if op == 1 {
            p(rs, base + a, s16(w >> 16) * 2 + 1)
        } else if op == 2 {
            p(rs, base + a, hg(h, kb + ((w >> 16) & 65535)))
        } else if op == 3 {
            for i in 0 as i64..b {
                p(rs, base + a + i, hg(h, 3))
            }
        } else if op == 4 {
            p(rs, base + a, hg(h, (hg(h, kb + ((w >> 16) & 65535)) >> 3) + 1))
        } else if op == 5 {
            wb(h, st, hg(h, kb + ((w >> 16) & 65535)), g(rs, base + a))
            hp(h, (hg(h, kb + ((w >> 16) & 65535)) >> 3) + 1, g(rs, base + a))
        } else if op == 9 {
            ip += s24(w >> 8) * 4
        } else if op == 10 {
            cond = 0
            if g(rs, base + a) != vfalse { cond = 1 }
        } else if op == 13 {
            cond = 0
            if arith_ok(h, st, 43, g(rs, base + a), g(rs, base + b)) {
                if num_lt(h, g(rs, base + a), g(rs, base + b)) { cond = 1 }
            } else {
                cond = -2
            }
        } else if op == 14 {
            cond = 0
            if arith_ok(h, st, 44, g(rs, base + a), g(rs, base + b)) {
                if num_ge(h, g(rs, base + a), g(rs, base + b)) { cond = 1 }
            } else {
                cond = -2
            }
        } else if op == 17 {
            # TEQI: the immediate b is signed 8 bits
            var sb: i64
            sb = b
            if sb > 127 { sb = sb - 256 }
            cond = 0
            if g(rs, base + a) == sb * 2 + 1 { cond = 1 }
        } else if op == 18 {
            var sb: i64
            sb = b
            if sb > 127 { sb = sb - 256 }
            cond = 0
            if arith_ok(h, st, 43, g(rs, base + a), small(sb)) {
                if num_lt(h, g(rs, base + a), small(sb)) { cond = 1 }
            } else {
                cond = -2
            }
        } else if op == 19 {
            var sb: i64
            sb = b
            if sb > 127 { sb = sb - 256 }
            cond = 0
            if arith_ok(h, st, 44, g(rs, base + a), small(sb)) {
                if num_ge(h, g(rs, base + a), small(sb)) { cond = 1 }
            } else {
                cond = -2
            }
        } else if op == 6 or op == 7 or op == 8 {
            exec_env(h, st, rs, fs, fp, op, w, base)
        } else if op == 26 {
            cond = exec_fusion(h, st, rs, w, base)
        } else if op == 20 or op == 21 or op == 22 or op == 23 or op == 34 or op == 35 {
            # the control: the frames change, so the code, the pc and the base are read again from the top frame
            fp = exec_ctl(h, st, rs, fs, fp, op, w, (ip - ib) >> 2)
            base = g(fs, fp + 4)
            code = hg(h, (g(fs, fp) >> 3) + 2) >> 3
            ib = code_ib(h, code)
            ip = ib + g(fs, fp + 5) * 4
            kb = code_kb(h, code)
            if base > g(st, 10) { p(st, 10, base) }
        } else if op == 24 {
            result = g(rs, base + a)
            running = 0
        } else if op == 25 {
            # CLOSURE A D: a Lambda of the code K[D] and the current environment
            let lam = alloc_obj(h, st, 8, 3)
            hp(h, (lam >> 3) + 2, hg(h, kb + ((w >> 16) & 65535)))
            hp(h, (lam >> 3) + 3, g(fs, fp + 1))
            p(rs, base + a, lam)
        } else {
            cond = exec_op(h, st, rs, op, w, base, kb)
        }
        if cond == -2 {
            # a runtime error: the top frame performs the effect Error{loc, message}; with no handler the program stops with the message
            p(fs, fp + 5, (ip - ib) >> 2)
            var rw: i64
            rw = ret_word(a, 0, 0)
            if op >= 13 and op <= 19 { rw = ret_word(0, 3, 0) }
            fp = raise_pending(h, st, rs, fs, fp, rw)
            base = g(fs, fp + 4)
            code = hg(h, (g(fs, fp) >> 3) + 2) >> 3
            ib = code_ib(h, code)
            ip = ib + g(fs, fp + 5) * 4
            kb = code_kb(h, code)
            if base > g(st, 10) { p(st, 10, base) }
            cond = -1
        }
        if cond >= 0 {
            if cond >= 2 {
                # a match instruction: skip the next word when it matched
                if cond == 2 { ip += 4 }
            } else if cond != c {
                # a condition instruction: the next word is JMP; run it when the condition equals k (the field c), else skip it
                ip += 4
            }
        }
    }
    result
}

# the number of the decimal digits s
fn parse_num(s: &static [u8]) -> i64 {
    var n: i64
    n = 0
    for i in 0 as i64..len(s) {
        n = n * 10 + (s[i] as i64) - 48
    }
    n
}

fn err_num(n: i64) {
    if n >= 10 { err_num(n / 10) }
    let d = n % 10
    if d == 0 { write(2, "0") }
    if d == 1 { write(2, "1") }
    if d == 2 { write(2, "2") }
    if d == 3 { write(2, "3") }
    if d == 4 { write(2, "4") }
    if d == 5 { write(2, "5") }
    if d == 6 { write(2, "6") }
    if d == 7 { write(2, "7") }
    if d == 8 { write(2, "8") }
    if d == 9 { write(2, "9") }
}

# usage: vm <image> [nursery words [slack of the old generation words]]; the arguments after the image are for testing the collector, and the numbers of the collections are written to stderr
fn main() -> i64 {
    if argc() < 2 { die("usage: vm <image>") }
    var heap: own [u8]
    var machine: own [i64]
    var regs: own [i64]
    var frames: own [i64]
    heap = alloc(268435456, 0 as u8)
    machine = alloc(st_words(), 0 as i64)
    var scratch: own [u8]
    scratch = alloc(266338432, 0 as u8)
    regs = alloc(1048576, 0 as i64)
    frames = alloc(458752, 0 as i64)
    var result: i64
    region r {
        var h: &mut r [u8]
        var st: &mut r [i64]
        var rs: &mut r [i64]
        var fs: &mut r [i64]
        var sc: &mut r [u8]
        sc = &mut r scratch
        h = &mut r heap
        st = &mut r machine
        rs = &mut r regs
        fs = &mut r frames
        var n: i64
        n = load(h, argv(1))
        # the entry stub: a code of 2 instructions CALL R0 R0 0 and HALT R0 (the two u32 words in one word of the plain array), an empty array of the constants,
        # an empty u32 plain array of the positions, and its Lambda
        hp(h, n, 9 * 64 + 15 * 4 + 1)
        hp(h, n + 1, 0)
        hp(h, n + 2, hg(h, 16))
        hp(h, n + 3, 1 * 2 + 1)
        hp(h, n + 4, 0 * 2 + 1)
        hp(h, n + 5, (n + 10) * 8)
        hp(h, n + 6, (n + 15) * 8)
        hp(h, n + 7, -1)
        hp(h, n + 8, (n + 17) * 8)
        hp(h, n + 9, -1)
        hp(h, n + 10, 4 * 64 + 7 * 4 + 1)
        hp(h, n + 11, 0)
        hp(h, n + 12, 7)
        hp(h, n + 13, 2)
        hp(h, n + 14, 20 + 24 * 4294967296)
        hp(h, n + 15, 1 * 64 + 6 * 4 + 1)
        hp(h, n + 16, 0)
        hp(h, n + 17, 3 * 64 + 7 * 4 + 1)
        hp(h, n + 18, 0)
        hp(h, n + 19, 7)
        hp(h, n + 20, 0)
        hp(h, n + 21, 3 * 64 + 8 * 4 + 1)
        hp(h, n + 22, 0)
        hp(h, n + 23, n * 8)
        hp(h, n + 24, hg(h, 3))
        # the old generation is the image and the stub; the nursery is the end of the heap before the remembered set
        var nsize: i64
        nsize = 4194304
        if argc() >= 3 { nsize = parse_num(argv(2)) }
        let ns = len(h) / 8 - 262144 - nsize
        if n + 25 > ns { die("the image is too big") }
        p(st, 0, ns)
        p(st, 6, ns)
        p(st, 7, ns + nsize)
        p(st, 8, n + 25)
        p(st, 13, ns + nsize / 4 * 3)
        p(st, 15, nsize / 8)
        p(st, 17, nsize)
        if argc() >= 4 { p(st, 18, parse_num(argv(3))) }
        var slack: i64
        slack = g(st, 18)
        if slack == 0 { slack = (ns - n - 25) / 2 }
        var thr: i64
        thr = n + 25 + slack
        if thr > ns - nsize { thr = ns - nsize }
        p(st, 14, thr)
        for i in 0 as i64..len(rs) {
            p(rs, i, hg(h, 3))
        }
        register_image(h, st, n)
        result = run(h, sc, st, rs, fs, (n + 21) * 8, hg(h, 0))
        if argc() >= 3 {
            write(2, "minor ")
            err_num(g(st, 20))
            write(2, " major ")
            err_num(g(st, 21))
            write(2, "\n")
        }
    }
    free(heap)
    free(scratch)
    free(machine)
    free(regs)
    free(frames)
    if (result & 1) == 1 {
        out_int(int_of(result))
        out_lit("\n")
    }
    0
}
