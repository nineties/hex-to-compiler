# nb: the builtin functions of the numbers: the bit operations
#
# The ids: 9 fsqrt, 10 ffloor, 11 ftoi, 12 ftobits, 13 bitstof, 14 ftos, 15 stof, 16 fexp, 17 flog, 18 fsin, 19 fcos, 20 fpow, 21 fatan2,
# 22 complex, 23 real, 24 imag stop with "float is not supported", 25 bit_and, 26 bit_or, 27 bit_xor, 28 bit_shl, 29 bit_sar.
import mem
import obj
import big
import num
import bit

fn call_nbuiltin[r](h: &mut r [u32], st: &mut r [u32], rs: &r [u32], id: i64, a: i64) -> i64 {
    if id >= 9 and id <= 24 { die("float is not supported") }
    if id >= 25 and id <= 29 {
        let x = g(rs, a)
        let y = g(rs, a + 1)
        if not is_integer(h, x) { die("bit operation: not an integer") }
        if not is_integer(h, y) { die("bit operation: not an integer") }
        if id <= 27 { return int_bitop(h, st, id - 25, x, y) }
        if not is_int(y) { die("bit shift: the shift is too large") }
        if int_of(y) < 0 { die("bit shift: negative shift") }
        if id == 28 { return int_shl(h, st, x, int_of(y)) }
        return int_sar(h, st, x, int_of(y))
    }
    die("unknown builtin")
    1
}
