# num: the numbers of planckvm: integers
#
# planckvm does not support floats and complex numbers yet: an operation on one stops with "float is not supported".
# The class of a number is 1 for an integer and 0 for a value that is not a number.
import mem
import big

fn num_class[r](h: &r [u32], v: i64) -> i64 {
    if is_int(v) { return 1 }
    let k = kind_of(h, v)
    if k == 0 { return 1 }
    if k == 1 or k == 2 { die("float is not supported") }
    0
}

# x op y for the operators ADD SUB MUL DIV MOD (37 to 41) on integers
fn num_arith[r](h: &mut r [u32], st: &mut r [u32], op: i64, x: i64, y: i64) -> i64 {
    let cx = num_class(h, x)
    let cy = num_class(h, y)
    if cx == 0 or cy == 0 { die("arithmetic: not a number") }
    if (op == 40 or op == 41) and y == 1 { die("division by zero") }
    if is_int(x) and is_int(y) {
        let m = int_of(x)
        let n = int_of(y)
        if op == 37 { return int_from_i64(h, st, m + n) }
        if op == 38 { return int_from_i64(h, st, m - n) }
        if op == 39 { return int_from_i64(h, st, m * n) }
        if op == 40 { return int_from_i64(h, st, m / n) }
        # the remainder has the sign of the divisor
        var r: i64
        r = m - n * (m / n)
        if r != 0 and ((r < 0) != (n < 0)) { r += n }
        return int_from_i64(h, st, r)
    }
    if op == 37 { return int_add(h, st, x, y, 0) }
    if op == 38 { return int_add(h, st, x, y, 1) }
    if op == 39 { return int_mul(h, st, x, y) }
    if op == 40 { return int_divmod(h, st, x, y, 0) }
    let r = int_divmod(h, st, x, y, 1)
    # the remainder has the sign of the divisor
    if r != 1 and i_sign(h, r) != i_sign(h, y) { return int_add(h, st, r, y, 0) }
    r
}

# the order of two numbers: -1, 0, 1
fn num_ord[r](h: &r [u32], x: i64, y: i64) -> i64 {
    if is_int(x) and is_int(y) {
        let a = int_of(x)
        let b = int_of(y)
        if a < b { return -1 }
        if a > b { return 1 }
        return 0
    }
    let cx = num_class(h, x)
    let cy = num_class(h, y)
    if cx == 0 or cy == 0 { die("comparison: not a number") }
    cmp_int(h, x, y)
}

# LT: x < y
fn num_lt[r](h: &r [u32], x: i64, y: i64) -> bool {
    num_ord(h, x, y) == -1
}

# GE: x >= y
fn num_ge[r](h: &r [u32], x: i64, y: i64) -> bool {
    let c = num_ord(h, x, y)
    c == 0 or c == 1
}

# whether two numbers are equal in value
fn num_equal[r](h: &r [u32], x: i64, y: i64) -> bool {
    num_ord(h, x, y) == 0
}
