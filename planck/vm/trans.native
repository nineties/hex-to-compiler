# trans: exp, log, sin, cos, pow and atan2 of planckvm
#
# The functions are those of fm, which work on f64 as the libm does: a reduction of the argument, a polynomial and a table of small constants.
# The result is within 1 ulp of the exact one, and not always the nearest float.
import fm
import mem
import flt

fn f_exp_fn[r](h: &mut r [i64], st: &mut r [i64], hi: i64, lo: i64) -> i64 {
    mk_f64(h, st, fm_exp(w2f(hi, lo)))
}

fn f_log_fn[r](h: &mut r [i64], st: &mut r [i64], hi: i64, lo: i64) -> i64 {
    mk_f64(h, st, fm_log(w2f(hi, lo)))
}

# x^y for floats
fn f_pow_fn[r](h: &mut r [i64], st: &mut r [i64], hx: i64, lx: i64, hy: i64, ly: i64) -> i64 {
    mk_f64(h, st, fm_pow(w2f(hx, lx), w2f(hy, ly)))
}

# sin (want 0) or cos (want 1) of a float
fn f_trig[r](h: &mut r [i64], st: &mut r [i64], hx: i64, lx: i64, want: i64) -> i64 {
    if want == 0 { return mk_f64(h, st, fm_sin(w2f(hx, lx))) }
    mk_f64(h, st, fm_cos(w2f(hx, lx)))
}

# atan2(y, x)
fn f_atan2[r](h: &mut r [i64], st: &mut r [i64], hy: i64, ly: i64, hx: i64, lx: i64) -> i64 {
    mk_f64(h, st, fm_atan2(w2f(hy, ly), w2f(hx, lx)))
}
