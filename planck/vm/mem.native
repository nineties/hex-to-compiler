# mem: the words of planckvm and the allocation of heap objects
#
# The registers and the frames are arrays of i64: a word is a value or a number. The heap is a byte array: the word i is the 8 bytes at 8 * i, little endian.
# A value is an integer 2n+1 (n has 63 bits) or a reference, twice the index of the heap.
# Heap object: the header (size << 6 | kind << 2 | r << 1 | 1) and the words after it. size is the number of the words after the header.
# The machine state st: st[0] is the index of the first free word of the heap.

# g reads a word and p writes it
fn g[r](a: &r [i64], i: i64) -> i64 {
    a[i]
}

fn p[r](a: &mut r [i64], i: i64, v: i64) {
    a[i] = v
}

# hg reads the word i of a byte array (the heap or the scratch array) and hp writes it
fn hg[r](a: &r [u8], i: i64) -> i64 {
    ld_64(a, i * 8)
}

fn hp[r](a: &mut r [u8], i: i64, v: i64) {
    st_64(a, i * 8, v)
}

fn s16(v: i64) -> i64 {
    if v >= 32768 { return v - 65536 }
    v
}

fn s24(v: i64) -> i64 {
    if v >= 8388608 { return v - 16777216 }
    v
}

fn die(m: &static [u8]) {
    write(2, m)
    write(2, "\n")
    exit(1)
}

# the value of the integer n; it stops when n is out of 63 bits
fn mk_int(n: i64) -> i64 {
    if n < -4611686018427387904 { die("integer overflow") }
    if n > 4611686018427387903 { die("integer overflow") }
    n * 2 + 1
}

# the integer of the value v (a value that is known to be an integer)
fn int_of(v: i64) -> i64 {
    v >> 1
}

fn is_int(v: i64) -> bool {
    (v & 1) == 1
}

# the kind of the object that the reference v points to
fn kind_of[r](h: &r [u8], v: i64) -> i64 {
    (hg(h, v >> 1) >> 2) & 15
}

fn size_of[r](h: &r [u8], v: i64) -> i64 {
    hg(h, v >> 1) >> 6
}

# The heap array h has three parts. The old generation is the words from 0 to ns (the image and the promoted objects, up to st[8]); the nursery is
# the words from ns to ne, where the new objects are made up to st[0]; the remembered set is the last 262144 words: the objects of the old
# generation that may have a reference to the nursery. Big objects and the objects that do not fit in the nursery are made in the old generation.
# The machine state st: 0 the first free word of the nursery, 4 and 5 ln2 and pi (roots), 6 ns, 7 ne, 8 the first free word of the old generation,
# 9 the number of the remembered objects, 10 the highest base of the frames (the registers above it are none), 11 the remembered set overflowed,
# 12 a collection is wanted, 13 the nursery top where it is wanted, 14 the old generation top where a major collection is wanted, 15 the size of
# the big objects, 16 to 19 the state of the collector (gc.native), 17 the size of the nursery, 18 the slack of the old generation (0: automatic).

# The table of the interned objects (strings, symbols and m-exprs) is in the machine state st after the first 1024 words, with the list of the slots that
# were made after the last collection (see obj.native): st[24] is the number of the slots that are not empty, st[25] the number of the listed slots,
# st[26] is 1 when the list was too short.
fn it_base() -> i64 {
    1024
}

fn it_cap() -> i64 {
    4194304
}

fn it_rbase() -> i64 {
    4195328
}

fn it_rcap() -> i64 {
    1048576
}

# the number of the words of st
fn st_words() -> i64 {
    5243904
}

# remember puts the object at the index idx of the old generation in the remembered set
fn remember[r](h: &mut r [u8], st: &mut r [i64], idx: i64) {
    let c = g(st, 9)
    if c >= 262144 {
        p(st, 11, 1)
        return
    }
    hp(h, len(h) / 8 - 262144 + c, idx)
    p(st, 9, c + 1)
}

# wb is called when the value v is put in the object obj that already exists: the object of the old generation that has a reference to the nursery is remembered
fn wb[r](h: &mut r [u8], st: &mut r [i64], obj: i64, v: i64) {
    if (v & 1) == 1 { return }
    if (v >> 1) < g(st, 6) { return }
    if (obj >> 1) >= g(st, 6) { return }
    remember(h, st, obj >> 1)
}

# alloc_obj makes an object of the kind and the size (words after the header), and returns its reference; the words are 0
fn alloc_obj[r](h: &mut r [u8], st: &mut r [i64], kind: i64, size: i64) -> i64 {
    let at = g(st, 0)
    if size < g(st, 15) and at + 1 + size <= g(st, 7) {
        hp(h, at, size * 64 + kind * 4 + 1)
        for i in 0 as i64..size {
            hp(h, at + 1 + i, 0)
        }
        p(st, 0, at + 1 + size)
        if at + 1 + size >= g(st, 13) { p(st, 12, 1) }
        return at * 2
    }
    let ot = g(st, 8)
    if ot + 1 + size > g(st, 6) { die("out of memory") }
    hp(h, ot, size * 64 + kind * 4 + 1)
    for i in 0 as i64..size {
        hp(h, ot + 1 + i, 0)
    }
    p(st, 8, ot + 1 + size)
    if ot + 1 + size > g(st, 14) { p(st, 12, 1) }
    if size < g(st, 15) { p(st, 12, 1) }
    remember(h, st, ot)
    ot * 2
}
