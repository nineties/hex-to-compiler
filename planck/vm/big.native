# big: the integers of planckvm
#
# An integer is a small value (63 bits, 2n+1) or a big integer, an object of the kind 0: the sign (0 or 1), the number of digits and the digits,
# 64 bits in a digit from the low end. A digit is a word of the heap. A big integer is always normal: no digit of zero at
# the top and the value does not fit in 63 bits.
# So two integers are equal if and only if the values are equal or the sign and the digits of the big integers are equal.
# The functions work on a small or a big integer through i_sign, i_nd and i_dig; they allocate only the result (and the temporaries of the division).
# The multiplication uses mulhi, and the division uses the reciprocal of the divisor (udiv.native).
import mem
import udiv

fun small(n: i64) -> i64 {
    n * 2 + 1
}

fun is_big[r](h: &r [u8], v: i64) -> bool {
    if is_int(v) { return false }
    kind_of(h, v) == 0
}

# whether v is an integer, small or big
fun is_integer[r](h: &r [u8], v: i64) -> bool {
    if is_int(v) { return true }
    kind_of(h, v) == 0
}

fun i_sign[r](h: &r [u8], v: i64) -> i64 {
    if is_int(v) {
        if int_of(v) < 0 { return 1 }
        return 0
    }
    hg(h, (v >> 3) + 1)
}

fun small_abs(v: i64) -> i64 {
    let n = int_of(v)
    if n < 0 { return 0 - n }
    n
}

fun i_nd[r](h: &r [u8], v: i64) -> i64 {
    if is_int(v) {
        if small_abs(v) == 0 { return 0 }
        return 1
    }
    hg(h, (v >> 3) + 2)
}

# the digit of 64 bits at the word index at
fun rd[r](h: &r [u8], at: i64) -> u64 {
    hg(h, at) as u64
}

fun wr[r](h: &mutable r [u8], at: i64, d: u64) {
    hp(h, at, d as i64)
}

# the digit i of the magnitude of v
fun i_dig[r](h: &r [u8], v: i64, i: i64) -> u64 {
    if i >= i_nd(h, v) { return 0 }
    if is_int(v) { return small_abs(v) as u64 }
    rd(h, (v >> 3) + 3 + i)
}

# the number of the zero bits above the top bit of d (d is not zero)
fun lz(d: u64) -> u64 {
    var x: u64
    var n: u64
    x = d
    n = 0
    while (x >> 63) == 0 {
        x = x << 1
        n += 1
    }
    n
}

# alloc_big makes a big integer object of the sign and room for cap digits; it is not normal yet
fun alloc_big[r](h: &mutable r [u8], st: &mutable r [i64], sign: i64, cap: i64) -> i64 {
    let v = alloc_obj(h, st, 0, 2 + cap)
    hp(h, (v >> 3) + 1, sign)
    hp(h, (v >> 3) + 2, cap)
    v
}

# fin trims the digits of the object v and gives a small value if the value fits in 63 bits
fun fin[r](h: &mutable r [u8], v: i64) -> i64 {
    let b = v >> 3
    var nd: i64
    nd = hg(h, b + 2)
    while nd > 0 and rd(h, b + 3 + (nd - 1)) == 0 {
        nd -= 1
    }
    hp(h, b + 2, nd)
    if nd == 0 { return 1 }
    if nd == 1 {
        let m = rd(h, b + 3)
        let sg = hg(h, b + 1)
        if sg == 0 and m <= 4611686018427387903 { return small(m as i64) }
        if sg == 1 and m <= 4611686018427387904 { return small(0 - (m as i64)) }
    }
    v
}

# int_from_i64 makes the integer of n
fun int_from_i64[r](h: &mutable r [u8], st: &mutable r [i64], n: i64) -> i64 {
    if n >= -4611686018427387904 and n <= 4611686018427387903 { return small(n) }
    var a: u64
    var sg: i64
    a = n as u64
    sg = 0
    if n < 0 {
        a = 0 - a
        sg = 1
    }
    let v = alloc_big(h, st, sg, 1)
    wr(h, (v >> 3) + 3, a)
    fin(h, v)
}

fun cmp_mag[r](h: &r [u8], x: i64, y: i64) -> i64 {
    let nx = i_nd(h, x)
    let ny = i_nd(h, y)
    if nx > ny { return 1 }
    if nx < ny { return -1 }
    var i: i64
    i = nx - 1
    while i >= 0 {
        let a = i_dig(h, x, i)
        let b = i_dig(h, y, i)
        if a > b { return 1 }
        if a < b { return -1 }
        i -= 1
    }
    0
}

# the order of two integers: -1, 0 or 1
fun cmp_int[r](h: &r [u8], x: i64, y: i64) -> i64 {
    let sx = i_sign(h, x)
    let sy = i_sign(h, y)
    if sx != sy {
        if sx == 1 { return -1 }
        return 1
    }
    let m = cmp_mag(h, x, y)
    if sx == 1 { return 0 - m }
    m
}

# the order of two values that must be integers
fun num_cmp[r](h: &r [u8], x: i64, y: i64) -> i64 {
    if is_int(x) and is_int(y) {
        let a = int_of(x)
        let b = int_of(y)
        if a < b { return -1 }
        if a > b { return 1 }
        return 0
    }
    if not is_integer(h, x) { die("comparison: not an integer") }
    if not is_integer(h, y) { die("comparison: not an integer") }
    cmp_int(h, x, y)
}

fun big_eq[r](h: &r [u8], x: i64, y: i64) -> bool {
    if hg(h, (x >> 3) + 1) != hg(h, (y >> 3) + 1) { return false }
    let n = hg(h, (x >> 3) + 2)
    if n != hg(h, (y >> 3) + 2) { return false }
    for i in 0 as i64..n {
        if hg(h, (x >> 3) + 3 + i) != hg(h, (y >> 3) + 3 + i) { return false }
    }
    true
}

fun add_mag[r](h: &mutable r [u8], st: &mutable r [i64], x: i64, y: i64, sign: i64) -> i64 {
    let nx = i_nd(h, x)
    let ny = i_nd(h, y)
    var n: i64
    n = nx
    if ny > n { n = ny }
    let v = alloc_big(h, st, sign, n + 1)
    let rb = (v >> 3) + 3
    var carry: u64
    carry = 0
    for i in 0 as i64..n {
        let a = i_dig(h, x, i)
        let s1 = a + i_dig(h, y, i)
        var c: u64
        c = 0
        if s1 < a { c = 1 }
        let s2 = s1 + carry
        if s2 < s1 { c = 1 }
        wr(h, rb + i, s2)
        carry = c
    }
    wr(h, rb + n, carry)
    fin(h, v)
}

# |x| - |y| where |x| >= |y|
fun sub_mag[r](h: &mutable r [u8], st: &mutable r [i64], x: i64, y: i64, sign: i64) -> i64 {
    let nx = i_nd(h, x)
    let v = alloc_big(h, st, sign, nx)
    let rb = (v >> 3) + 3
    var borrow: u64
    borrow = 0
    for i in 0 as i64..nx {
        let a = i_dig(h, x, i)
        let b = i_dig(h, y, i)
        let t = a - b
        var c: u64
        c = 0
        if a < b { c = 1 }
        let t2 = t - borrow
        if t < borrow { c = 1 }
        wr(h, rb + i, t2)
        borrow = c
    }
    fin(h, v)
}

# x + y, or x - y if neg is 1
fun int_add[r](h: &mutable r [u8], st: &mutable r [i64], x: i64, y: i64, neg: i64) -> i64 {
    let sx = i_sign(h, x)
    var sy: i64
    sy = i_sign(h, y)
    if neg == 1 { sy = 1 - sy }
    if sx == sy { return add_mag(h, st, x, y, sx) }
    let c = cmp_mag(h, x, y)
    if c == 0 { return 1 }
    if c > 0 { return sub_mag(h, st, x, y, sx) }
    sub_mag(h, st, y, x, sy)
}

fun int_mul[r](h: &mutable r [u8], st: &mutable r [i64], x: i64, y: i64) -> i64 {
    let nx = i_nd(h, x)
    let ny = i_nd(h, y)
    let v = alloc_big(h, st, i_sign(h, x) ^ i_sign(h, y), nx + ny)
    let rb = (v >> 3) + 3
    for i in 0 as i64..nx {
        let a = i_dig(h, x, i)
        var carry: u64
        carry = 0
        for j in 0 as i64..ny {
            let b = i_dig(h, y, j)
            let lo = a * b
            var hi: u64
            hi = mulhi(a, b)
            let t = rd(h, rb + (i + j))
            let s1 = lo + t
            if s1 < lo { hi = hi + 1 }
            let s2 = s1 + carry
            if s2 < s1 { hi = hi + 1 }
            wr(h, rb + (i + j), s2)
            carry = hi
        }
        wr(h, rb + (i + ny), carry)
    }
    fin(h, v)
}

# the digit i of the magnitude of x shifted left by s bits (0 <= s < 64), in the digits of x
fun shl_dig[r](h: &r [u8], x: i64, i: i64, s: u64) -> u64 {
    var d: u64
    d = i_dig(h, x, i) << s
    if s > 0 and i > 0 { d = d | (i_dig(h, x, i - 1) >> (64 - s)) }
    d
}

# Knuth's algorithm D: the digits of x / y into the object q and of x % y into the object rem; |x| >= |y| and y has 2 digits or more.
# The estimate of a digit of the quotient is the division of three digits by the top two digits of the divisor, with the reciprocal of them (udiv.native).
fun knuth[r](h: &mutable r [u8], st: &mutable r [i64], x: i64, y: i64, q: i64, rem: i64) {
    let nx = i_nd(h, x)
    let ny = i_nd(h, y)
    let un = alloc_big(h, st, 0, nx + 1)
    let vn = alloc_big(h, st, 0, ny)
    let ub = (un >> 3) + 3
    let vb = (vn >> 3) + 3
    let qb = (q >> 3) + 3
    let s = lz(i_dig(h, y, ny - 1))
    for i in 0 as i64..ny {
        wr(h, vb + i, shl_dig(h, y, i, s))
    }
    for i in 0 as i64..nx {
        wr(h, ub + i, shl_dig(h, x, i, s))
    }
    var top: u64
    top = 0
    if s > 0 { top = i_dig(h, x, nx - 1) >> (64 - s) }
    wr(h, ub + nx, top)
    let d1 = rd(h, vb + (ny - 1))
    let d0 = rd(h, vb + (ny - 2))
    let v = recip3by2(d1, d0)
    var j: i64
    j = nx - ny
    while j >= 0 {
        let n2 = rd(h, ub + (j + ny))
        let n1 = rd(h, ub + (j + ny - 1))
        let n0 = rd(h, ub + (j + ny - 2))
        var qh: u64
        if n2 == d1 and n1 == d0 {
            qh = 18446744073709551615
        } else {
            let a = div3by2(n2, n1, n0, d1, d0, v)
            qh = a.q
        }
        # un[j .. j + ny] -= qh * vn
        var carry: u64
        var borrow: u64
        carry = 0
        borrow = 0
        for i in 0 as i64..ny {
            let w = rd(h, vb + i)
            let lo = qh * w
            var hi: u64
            hi = mulhi(qh, w)
            let lo2 = lo + carry
            if lo2 < lo { hi = hi + 1 }
            carry = hi
            let t = rd(h, ub + (i + j))
            let t1 = t - lo2
            var bb: u64
            bb = 0
            if t < lo2 { bb = 1 }
            let t2 = t1 - borrow
            if t1 < borrow { bb = 1 }
            wr(h, ub + (i + j), t2)
            borrow = bb
        }
        let tt = rd(h, ub + (j + ny))
        let tt1 = tt - carry
        var b: u64
        b = 0
        if tt < carry { b = 1 }
        let tt2 = tt1 - borrow
        if tt1 < borrow { b = 1 }
        wr(h, ub + (j + ny), tt2)
        # the estimate was too large: add the divisor back
        while b == 1 {
            qh = qh - 1
            var c: u64
            c = 0
            for i in 0 as i64..ny {
                let u = rd(h, ub + (i + j))
                let w = rd(h, vb + i)
                let s1 = u + w
                var c1: u64
                c1 = 0
                if s1 < u { c1 = 1 }
                let s2 = s1 + c
                if s2 < s1 { c1 = 1 }
                wr(h, ub + (i + j), s2)
                c = c1
            }
            wr(h, ub + (j + ny), rd(h, ub + (j + ny)) + c)
            if c == 1 { b = 0 }
        }
        wr(h, qb + j, qh)
        j -= 1
    }
    for i in 0 as i64..ny {
        var r: u64
        r = rd(h, ub + i) >> s
        if s > 0 { r = r | (rd(h, ub + (i + 1)) << (64 - s)) }
        wr(h, (rem >> 3) + 3 + i, r)
    }
}

# x / y (want 0) or x % y (want 1), truncated toward zero; the remainder has the sign of x. y is not zero.
fun int_divmod[r](h: &mutable r [u8], st: &mutable r [i64], x: i64, y: i64, want: i64) -> i64 {
    let sx = i_sign(h, x)
    let sq = sx ^ i_sign(h, y)
    if cmp_mag(h, x, y) < 0 {
        if want == 0 { return 1 }
        return x
    }
    let nx = i_nd(h, x)
    let ny = i_nd(h, y)
    if ny == 1 {
        # a divisor of one digit: the dividend is shifted so that the top bit of the divisor is set
        let s = lz(i_dig(h, y, 0))
        let d = i_dig(h, y, 0) << s
        let rv = recip(d)
        let q = alloc_big(h, st, sq, nx)
        let qb = (q >> 3) + 3
        var rr: u64
        rr = 0
        if s > 0 { rr = i_dig(h, x, nx - 1) >> (64 - s) }
        var i: i64
        i = nx - 1
        while i >= 0 {
            let a = div2by1(rr, shl_dig(h, x, i, s), d, rv)
            wr(h, qb + i, a.q)
            rr = a.r
            i -= 1
        }
        if want == 0 { return fin(h, q) }
        let r = alloc_big(h, st, sx, 1)
        wr(h, (r >> 3) + 3, rr >> s)
        return fin(h, r)
    }
    let q = alloc_big(h, st, sq, nx - ny + 1)
    let rem = alloc_big(h, st, sx, ny)
    knuth(h, st, x, y, q, rem)
    if want == 0 { return fin(h, q) }
    fin(h, rem)
}
