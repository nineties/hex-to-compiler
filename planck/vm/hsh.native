# hsh: HASH, the number that equal values share
#
# Numbers have the hash of their value: an integer by its sign and digits. Strings, symbols and m-exprs are by their contents, and arrays and plain arrays by their elements. Functions are by a number that is given to
# the object by its first HASH (the word after the header; st[1] is the last number given). The hash is a non-negative integer of 30 bits.
import mem
import obj
import big
import num
import arr

fn mix(acc: i64, x: i64) -> i64 {
    (acc * 31 + x + 7) & 1073741823
}

fn hash_int[r](h: &r [u32], v: i64) -> i64 {
    var acc: i64
    acc = i_sign(h, v)
    let nd = i_nd(h, v)
    # the digits of 16 bits from the low end, without the zeros at the top
    for i in 0 as i64..nd {
        let d = i_dig(h, v, i)
        var k: i64
        k = 4
        if i == nd - 1 {
            while k > 1 and ((d >> ((16 * (k - 1)) as u64)) & 65535) == 0 {
                k -= 1
            }
        }
        for c in 0 as i64..k {
            acc = mix(acc, ((d >> ((16 * c) as u64)) & 65535) as i64)
        }
    }
    acc
}

# the hash of the integer 0
fn hash_zero() -> i64 {
    0
}

fn hash_string[r](h: &r [u32], s: i64) -> i64 {
    var acc: i64
    acc = 5381
    let n = str_len(h, s)
    for i in 0 as i64..n {
        acc = mix(acc, str_byte(h, s, i))
    }
    acc
}

fn hash_value[r](h: &mut r [u32], st: &mut r [u32], v: i64) -> i64 {
    if is_int(v) { return hash_int(h, v) }
    let k = kind_of(h, v)
    if k == 0 { return hash_int(h, v) }
    if k == 1 or k == 2 { die("float is not supported") }
    if k == 3 { return hash_string(h, v) }
    if k == 4 { return mix(hash_string(h, g(h, (v >> 1) + 1)), 4) }
    if k == 5 {
        var acc: i64
        acc = hash_value(h, st, mexpr_head(h, v))
        let n = mexpr_arity(h, v)
        for i in 0 as i64..n {
            acc = mix(acc, hash_value(h, st, mexpr_arg(h, v, i)))
        }
        return acc
    }
    # arrays and plain arrays are equal by the elements, so they have the hash of the elements
    if k == 6 {
        var acc: i64
        acc = 6
        let n = array_len(h, v)
        for i in 0 as i64..n {
            acc = mix(acc, hash_value(h, st, a_get(h, v, small(i))))
        }
        return acc
    }
    if k == 7 {
        var acc: i64
        acc = 7
        let n = pl_count(h, v)
        let mark = g(st, 0)
        for i in 0 as i64..n {
            acc = mix(acc, hash_value(h, st, pl_get(h, st, v, small(i))))
            p(st, 0, mark)
        }
        return acc
    }
    # identity: the word after the header holds the number
    let at = (v >> 1) + 1
    var id: i64
    id = g(h, at)
    if id == 0 {
        id = g(st, 1) + 1
        p(st, 1, id)
        p(h, at, id)
    }
    id & 1073741823
}
