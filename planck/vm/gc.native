# gc: the generational copying collector of planckvm
#
# The nursery is collected by a minor collection: the live objects of the nursery are copied to the end of the old generation. The roots are the
# registers, the frames, ln2 and pi in the machine state, and the objects of the remembered set (the old objects that were written with a
# reference to the nursery). A major collection copies the live objects of both generations to the scratch array t and then back to the heap array h,
# so that the old generation is compact again. A collection is done only between two instructions: no reference is held by the code of the
# instructions then, and the loop of vm.native reads the code, the pc and the base again from the top frame.
# A forwarded object has the header (new index << 2) | 3 (the bit 1 of a header is never set otherwise).
# The state of the collector in st: 16 the first free word of t, 19 the index in h of the word 0 of t, 20 and 21 the numbers of the minor and the major collections.
import mem
import big
import obj

# whether the word j (1 to size) after the header of the object at the index at of the array a holds a value
fun is_slot[r](a: &r [u8], at: i64, kind: i64, size: i64, j: i64) -> bool {
    if kind == 5 or kind == 12 { return true }
    if kind == 6 or kind == 8 or kind == 9 or kind == 15 { return j >= 2 }
    if kind == 13 { return true }
    if kind == 4 { return j == 1 }
    if kind == 10 { return j == 4 }
    if kind == 11 {
        if j <= 3 { return false }
        let k = j - 4
        if k < 7 * hg(a, at + 3) { return (k % 7) < 3 }
        return true
    }
    false
}

fun has_slots(kind: i64) -> bool {
    kind != 0 and kind != 1 and kind != 2 and kind != 3 and kind != 7
}

# fwd gives the new value of the value v: the object is copied to t when it was not yet
fun fwd[r](h: &mutable r [u8], t: &mutable r [u8], st: &mutable r [i64], v: i64, major: i64) -> i64 {
    if (v & 1) == 1 { return v }
    let idx = v >> 3
    if idx < 17 { return v }
    if major == 0 and idx < g(st, 6) { return v }
    let hd = hg(h, idx)
    if (hd & 2) != 0 { return (hd >> 2) * 8 }
    let n = 1 + (hd >> 6)
    let tc = g(st, 16)
    for i in 0 as i64..n {
        hp(t, tc + i, hg(h, idx + i))
    }
    let ni = g(st, 19) + tc
    p(st, 16, tc + n)
    hp(h, idx, ni * 4 + 3)
    ni * 8
}

# scan_t makes the values of the object at the index at of t new; the result is the number of its words
fun scan_t[r](h: &mutable r [u8], t: &mutable r [u8], st: &mutable r [i64], at: i64, major: i64) -> i64 {
    let hd = hg(t, at)
    let kind = (hd >> 2) & 15
    let size = hd >> 6
    if has_slots(kind) {
        for j in 1 as i64..size + 1 {
            if is_slot(t, at, kind, size, j) {
                hp(t, at + j, fwd(h, t, st, hg(t, at + j), major))
            }
        }
    }
    1 + size
}

# scan_h is scan_t for the object at the index at of h
fun scan_h[r](h: &mutable r [u8], t: &mutable r [u8], st: &mutable r [i64], at: i64, major: i64) -> i64 {
    let hd = hg(h, at)
    let kind = (hd >> 2) & 15
    let size = hd >> 6
    if has_slots(kind) {
        for j in 1 as i64..size + 1 {
            if is_slot(h, at, kind, size, j) {
                hp(h, at + j, fwd(h, t, st, hg(h, at + j), major))
            }
        }
    }
    1 + size
}

# the end of the registers that the frame stack may use: the registers above are none
fun regs_end[r](rs: &r [i64], fs: &r [i64], fp: i64) -> i64 {
    let e = g(fs, fp + 4) + 512
    if e > len(rs) { return len(rs) }
    e
}

fun scan_roots[r](h: &mutable r [u8], t: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], fs: &mutable r [i64], fp: i64, major: i64) {
    if major == 1 {
        for i in 0 as i64..17 {
            hp(t, i, fwd(h, t, st, hg(h, i), 1))
        }
    }
    if g(st, 4) != 0 { p(st, 4, fwd(h, t, st, g(st, 4), major)) }
    if g(st, 5) != 0 { p(st, 5, fwd(h, t, st, g(st, 5), major)) }
    let e = regs_end(rs, fs, fp)
    for i in 0 as i64..e {
        p(rs, i, fwd(h, t, st, g(rs, i), major))
    }
    var q: i64
    q = 0
    while q <= fp {
        p(fs, q, fwd(h, t, st, g(fs, q), major))
        p(fs, q + 1, fwd(h, t, st, g(fs, q + 1), major))
        p(fs, q + 2, fwd(h, t, st, g(fs, q + 2), major))
        q += 7
    }
}

# ---- the table of the interned objects (obj.native): it does not keep the objects alive. After a collection the entries of the objects that died are
# deleted, the entries of the objects that moved get the new references, and the entries are put at the slots of the new hashes.

# the new reference of the object that the entry e refers to, or 0 when the object died
fun it_map[r](h: &r [u8], st: &r [i64], e: i64, major: i64) -> i64 {
    let idx = e >> 3
    if major == 0 and idx < g(st, 6) { return e }
    let hd = hg(h, idx)
    if (hd & 2) != 0 { return (hd >> 2) * 8 }
    0
}

# it_remove deletes the entry of the slot sl; the deleted slots before a slot that is empty are made empty
fun it_remove[r](st: &mutable r [i64], sl: i64) {
    let mask = it_cap() - 1
    p(st, it_base() + sl, 1)
    if g(st, it_base() + ((sl + 1) & mask)) == 0 {
        var i: i64
        i = sl
        while g(st, it_base() + i) == 1 {
            p(st, it_base() + i, 0)
            p(st, 24, g(st, 24) - 1)
            i = (i + mask) & mask
        }
    }
}

# after a minor collection: only the entries made since the last collection can have new hashes
fun it_after_minor[r](h: &mutable r [u8], st: &mutable r [i64]) {
    let n = g(st, 25)
    for i in 0 as i64..n {
        let sl = g(st, it_rbase() + i)
        let ne = it_map(h, st, g(st, it_base() + sl), 0)
        it_remove(st, sl)
        p(st, it_rbase() + i, ne)
    }
    for i in 0 as i64..n {
        let ne = g(st, it_rbase() + i)
        if ne != 0 { it_put(h, st, ne) }
    }
}

# it_map_all gives every entry its new reference (a major collection: before the objects are copied back), and deletes the entries of the objects that died
fun it_map_all[r](h: &mutable r [u8], st: &mutable r [i64], major: i64) {
    for i in 0 as i64..it_cap() {
        let e = g(st, it_base() + i)
        if e > 1 {
            let ne = it_map(h, st, e, major)
            if ne == 0 {
                p(st, it_base() + i, 1)
            } else {
                p(st, it_base() + i, ne)
            }
        }
    }
}

# it_rebuild puts every entry at the slot of its hash again; t is an array that is free
fun it_rebuild[r](h: &mutable r [u8], t: &mutable r [u8], st: &mutable r [i64]) {
    var k: i64
    k = 0
    for i in 0 as i64..it_cap() {
        let e = g(st, it_base() + i)
        if e > 1 {
            hp(t, k, e)
            k += 1
        }
        p(st, it_base() + i, 0)
    }
    p(st, 24, 0)
    for j in 0 as i64..k {
        it_put(h, st, hg(t, j))
    }
}

fun gc_minor[r](h: &mutable r [u8], t: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], fs: &mutable r [i64], fp: i64) {
    let ot = g(st, 8)
    p(st, 16, 0)
    p(st, 19, ot)
    scan_roots(h, t, st, rs, fs, fp, 0)
    if g(st, 11) != 0 {
        var at: i64
        at = 17
        while at < ot {
            at += scan_h(h, t, st, at, 0)
        }
    } else {
        let n = g(st, 9)
        for i in 0 as i64..n {
            scan_h(h, t, st, hg(h, len(h) / 8 - 262144 + i), 0)
        }
    }
    var sp: i64
    sp = 0
    while sp < g(st, 16) {
        sp += scan_t(h, t, st, sp, 0)
    }
    let tc = g(st, 16)
    for i in 0 as i64..tc {
        hp(h, ot + i, hg(t, i))
    }
    p(st, 8, ot + tc)
    if g(st, 26) != 0 {
        it_map_all(h, st, 0)
        it_rebuild(h, t, st)
    } else {
        it_after_minor(h, st)
    }
    p(st, 25, 0)
    p(st, 26, 0)
    p(st, 20, g(st, 20) + 1)
}

fun gc_major[r](h: &mutable r [u8], t: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], fs: &mutable r [i64], fp: i64) {
    p(st, 16, 17)
    p(st, 19, 0)
    scan_roots(h, t, st, rs, fs, fp, 1)
    var sp: i64
    sp = 17
    while sp < g(st, 16) {
        sp += scan_t(h, t, st, sp, 1)
    }
    let tc = g(st, 16)
    it_map_all(h, st, 1)
    for i in 0 as i64..tc {
        hp(h, i, hg(t, i))
    }
    p(st, 8, tc)
    it_rebuild(h, t, st)
    p(st, 25, 0)
    p(st, 26, 0)
    p(st, 21, g(st, 21) + 1)
}

# collect is called between two instructions, with the top frame fp
fun collect[r](h: &mutable r [u8], t: &mutable r [u8], st: &mutable r [i64], rs: &mutable r [i64], fs: &mutable r [i64], fp: i64) {
    let used = g(st, 0) - g(st, 6)
    var big: i64
    big = 0
    if g(st, 8) + used >= g(st, 6) { big = 1 }
    if g(st, 8) > g(st, 14) { big = 1 }
    let ext = regs_end(rs, fs, fp)
    if big == 1 {
        gc_major(h, t, st, rs, fs, fp)
    } else {
        gc_minor(h, t, st, rs, fs, fp)
    }
    # the registers above the end that were used are none
    let nv = hg(h, 3)
    var e2: i64
    e2 = g(st, 10) + 1100
    if e2 > len(rs) { e2 = len(rs) }
    for i in ext..e2 {
        p(rs, i, nv)
    }
    p(st, 10, g(fs, fp + 4))
    p(st, 0, g(st, 6))
    p(st, 9, 0)
    p(st, 11, 0)
    p(st, 12, 0)
    if big == 1 {
        let top = g(st, 8)
        var slack: i64
        slack = g(st, 18)
        if slack == 0 { slack = (g(st, 6) - top) / 2 }
        var thr: i64
        thr = top + slack
        let cap = g(st, 6) - g(st, 17)
        if thr > cap { thr = cap }
        if thr < top { thr = top }
        p(st, 14, thr)
    } else if g(st, 8) > g(st, 14) {
        p(st, 12, 1)
    }
}
