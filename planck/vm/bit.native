# bit: the bit operations of planckvm on integers, with the negative numbers as infinite-width two's complement
import mem
import big

# the digit i of 64 bits of the two's complement of v; carry is the carry of the negation of the lower digits (1 at the start)
fn tc_digit[r](h: &r [u8], v: i64, i: i64, carry: u64) -> u64 {
    let d = i_dig(h, v, i)
    if i_sign(h, v) == 0 { return d }
    (d ^ 18446744073709551615) + carry
}

# the carry out of the digit i in the negation of v
fn tc_carry[r](h: &r [u8], v: i64, i: i64, carry: u64) -> u64 {
    if i_sign(h, v) == 0 { return 0 }
    let t = (i_dig(h, v, i) ^ 18446744073709551615) + carry
    if t < carry { return 1 }
    0
}

# x and y (op 0), x or y (op 1), x xor y (op 2)
fn int_bitop[r](h: &mut r [u8], st: &mut r [i64], op: i64, x: i64, y: i64) -> i64 {
    if is_int(x) and is_int(y) {
        let m = int_of(x)
        let n = int_of(y)
        if op == 0 { return int_from_i64(h, st, m & n) }
        if op == 1 { return int_from_i64(h, st, m | n) }
        return int_from_i64(h, st, m ^ n)
    }
    var n: i64
    n = i_nd(h, x)
    if i_nd(h, y) > n { n = i_nd(h, y) }
    n += 1
    let v = alloc_big(h, st, 0, n)
    let rb = (v >> 3) + 3
    var cx: u64
    var cy: u64
    cx = 1
    cy = 1
    for i in 0 as i64..n {
        let a = tc_digit(h, x, i, cx)
        let b = tc_digit(h, y, i, cy)
        cx = tc_carry(h, x, i, cx)
        cy = tc_carry(h, y, i, cy)
        var r: u64
        if op == 0 {
            r = a & b
        } else if op == 1 {
            r = a | b
        } else {
            r = a ^ b
        }
        wr(h, rb + i, r)
    }
    if (rd(h, rb + (n - 1)) >> 63) == 1 {
        hp(h, (v >> 3) + 1, 1)
        var carry: u64
        carry = 1
        for i in 0 as i64..n {
            let t = (rd(h, rb + i) ^ 18446744073709551615) + carry
            var c: u64
            c = 0
            if t < carry { c = 1 }
            wr(h, rb + i, t)
            carry = c
        }
    }
    fin(h, v)
}

# the magnitude of v shifted left by k bits, with the sign of v
fn int_shl[r](h: &mut r [u8], st: &mut r [i64], v: i64, k: i64) -> i64 {
    if k > 16777216 { die("bit_shl: the shift is too large") }
    let nd = i_nd(h, v)
    if nd == 0 { return 1 }
    let ws = k / 64
    let bs = (k % 64) as u64
    let w = alloc_big(h, st, i_sign(h, v), nd + ws + 2)
    let rb = (w >> 3) + 3
    for i in 0 as i64..nd {
        let d = i_dig(h, v, i)
        let at = rb + (i + ws)
        wr(h, at, rd(h, at) | (d << bs))
        if bs > 0 { wr(h, at + 1, rd(h, at + 1) | (d >> (64 - bs))) }
    }
    fin(h, w)
}

# the magnitude of v shifted right by k bits (v >= 0)
fn shr_mag[r](h: &mut r [u8], st: &mut r [i64], v: i64, k: i64) -> i64 {
    let nd = i_nd(h, v)
    let ws = k / 64
    let bs = (k % 64) as u64
    if ws >= nd { return 1 }
    let w = alloc_big(h, st, 0, nd - ws)
    let rb = (w >> 3) + 3
    for i in 0 as i64..nd - ws {
        var d: u64
        d = i_dig(h, v, i + ws) >> bs
        if bs > 0 { d = d | (i_dig(h, v, i + ws + 1) << (64 - bs)) }
        wr(h, rb + i, d)
    }
    fin(h, w)
}

# v shifted right by k bits keeping the sign: the floor of v / 2^k
fn int_sar[r](h: &mut r [u8], st: &mut r [i64], v: i64, k: i64) -> i64 {
    if i_sign(h, v) == 0 { return shr_mag(h, st, v, k) }
    # for a negative v the result is -1 - ((-1 - v) >> k)
    let t = int_add(h, st, small(-1), v, 1)
    let s = shr_mag(h, st, t, k)
    int_add(h, st, small(-1), s, 1)
}
