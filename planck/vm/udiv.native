# udiv: division of unsigned 64-bit words by multiplying with the reciprocal of the divisor
#
# The algorithms are from Moller and Granlund, "Improved division by invariant integers" (IEEE Transactions on Computers, 2011):
# recip is their Algorithm 2, div2by1 is Algorithm 4, recip3by2 is Algorithm 6 and div3by2 is Algorithm 5. B is 2^64.
# The divisor must be normalized: its top bit is set. The reciprocal of d is floor((B^2 - 1) / d) - B.

struct QR { q: u64, r: u64 }

struct QR3 { q: u64, r1: u64, r0: u64 }

# the reciprocal floor((B^2 - 1) / d) - B of d, with 2^63 <= d
fun recip(d: u64) -> u64 {
    let d0 = d & 1
    let d9 = d >> 55
    let d40 = (d >> 24) + 1
    let d63 = (d >> 1) + d0
    let b60: u64 = 1152921504606846976
    let v0 = 523520 / d9
    let v1 = (v0 << 11) - ((v0 * v0 * d40) >> 40) - 1
    let v2 = (v1 << 13) + ((v1 * (b60 - v1 * d40)) >> 47)
    let e = (0 - v2 * d63) + (v2 >> 1) * d0
    let v3 = (v2 << 31) + (mulhi(v2, e) >> 1)
    var c: u64
    c = 0
    if v3 * d + d < d { c = 1 }
    v3 - (d + mulhi(v3, d) + c)
}

# (u1 * B + u0) / d and the remainder, with u1 < d and v = recip(d)
fun div2by1(u1: u64, u0: u64, d: u64, v: u64) -> QR {
    var q0: u64
    var q1: u64
    q0 = v * u1
    q1 = mulhi(v, u1)
    let s = q0 + u0
    var c: u64
    c = 0
    if s < q0 { c = 1 }
    q0 = s
    q1 = q1 + u1 + c + 1
    var r: u64
    r = u0 - q1 * d
    if r > q0 {
        q1 = q1 - 1
        r = r + d
    }
    if r >= d {
        q1 = q1 + 1
        r = r - d
    }
    QR{q: q1, r: r}
}

# the reciprocal floor((B^3 - 1) / (d1 * B + d0)) - B of a normalized two-word divisor
fun recip3by2(d1: u64, d0: u64) -> u64 {
    var v: u64
    var p: u64
    v = recip(d1)
    p = d1 * v + d0
    if p < d0 {
        v = v - 1
        if p >= d1 {
            v = v - 1
            p = p - d1
        }
        p = p - d1
    }
    let t1 = mulhi(v, d0)
    let t0 = v * d0
    p = p + t1
    if p < t1 {
        v = v - 1
        if p > d1 or (p == d1 and t0 >= d0) { v = v - 1 }
    }
    v
}

# (u2 * B^2 + u1 * B + u0) / (d1 * B + d0) and the remainder (r1, r0), with (u2, u1) < (d1, d0) and v = recip3by2(d1, d0)
fun div3by2(u2: u64, u1: u64, u0: u64, d1: u64, d0: u64, v: u64) -> QR3 {
    var q0: u64
    var q1: u64
    q0 = v * u2
    q1 = mulhi(v, u2)
    let s = q0 + u1
    var c: u64
    c = 0
    if s < q0 { c = 1 }
    q0 = s
    q1 = q1 + u2 + c
    var r1: u64
    var r0: u64
    r1 = u1 - q1 * d1
    let t1 = mulhi(d0, q1)
    let t0 = d0 * q1
    # (r1, r0) = (r1, u0) - (t1, t0) - (d1, d0)
    var b: u64
    r0 = u0 - t0
    b = 0
    if u0 < t0 { b = 1 }
    r1 = r1 - t1 - b
    b = 0
    if r0 < d0 { b = 1 }
    r0 = r0 - d0
    r1 = r1 - d1 - b
    q1 = q1 + 1
    if r1 >= q0 {
        q1 = q1 - 1
        let s0 = r0 + d0
        var c0: u64
        c0 = 0
        if s0 < r0 { c0 = 1 }
        r0 = s0
        r1 = r1 + d1 + c0
    }
    if r1 > d1 or (r1 == d1 and r0 >= d0) {
        q1 = q1 + 1
        var b2: u64
        b2 = 0
        if r0 < d0 { b2 = 1 }
        r0 = r0 - d0
        r1 = r1 - d1 - b2
    }
    QR3{q: q1, r1: r1, r0: r0}
}
