# flt: IEEE 754 binary64 in software, and the conversions between integers and floats
#
# A float is an object of the kind 1: the low word and the high word of the binary64. A complex number is an object of the kind 2: the low and the
# high word of the real part, then of the imaginary part. native has no float type, so the arithmetic is done on the integers:
# a finite number is a mantissa m (53 bits, bit 52 set) and an exponent e, and the value is m * 2^e.
# pack_round makes the float of a value m * 2^e that has more bits than 53 (and a sticky bit for what was cut), by round to nearest even.
import mem
import big

fn fl_lo[r](h: &r [u32], v: i64) -> i64 {
    g(h, (v >> 1) + 1)
}

fn fl_hi[r](h: &r [u32], v: i64) -> i64 {
    g(h, (v >> 1) + 2)
}

fn is_float[r](h: &r [u32], v: i64) -> bool {
    if is_int(v) { return false }
    kind_of(h, v) == 1
}

fn is_complex[r](h: &r [u32], v: i64) -> bool {
    if is_int(v) { return false }
    kind_of(h, v) == 2
}

fn mk_float[r](h: &mut r [u32], st: &mut r [u32], hi: i64, lo: i64) -> i64 {
    let v = alloc_obj(h, st, 1, 2)
    p(h, (v >> 1) + 1, lo)
    p(h, (v >> 1) + 2, hi)
    v
}

# the complex number of the four words
fn mk_complex[r](h: &mut r [u32], st: &mut r [u32], rh: i64, rl: i64, ih: i64, il: i64) -> i64 {
    let v = alloc_obj(h, st, 2, 4)
    p(h, (v >> 1) + 1, rl)
    p(h, (v >> 1) + 2, rh)
    p(h, (v >> 1) + 3, il)
    p(h, (v >> 1) + 4, ih)
    v
}

fn f_ex(hi: i64) -> i64 {
    (hi >> 20) & 2047
}

fn f_frac(hi: i64, lo: i64) -> i64 {
    ((hi & 1048575) << 32) | lo
}

fn f_is_nan(hi: i64, lo: i64) -> bool {
    if f_ex(hi) != 2047 { return false }
    f_frac(hi, lo) != 0
}

fn f_is_inf(hi: i64, lo: i64) -> bool {
    if f_ex(hi) != 2047 { return false }
    f_frac(hi, lo) == 0
}

fn f_is_zero(hi: i64, lo: i64) -> bool {
    if f_ex(hi) != 0 { return false }
    f_frac(hi, lo) == 0
}

# the mantissa of a finite number that is not 0, with bit 52 set
fn f_man(hi: i64, lo: i64) -> i64 {
    var m: i64
    m = f_frac(hi, lo)
    if f_ex(hi) != 0 { return m | 4503599627370496 }
    while m < 4503599627370496 {
        m = m << 1
    }
    m
}

# the exponent that goes with f_man
fn f_exp(hi: i64, lo: i64) -> i64 {
    let ex = f_ex(hi)
    if ex != 0 { return ex - 1075 }
    var m: i64
    var e: i64
    m = f_frac(hi, lo)
    e = -1074
    while m < 4503599627370496 {
        m = m << 1
        e -= 1
    }
    e
}

fn nbits(m: i64) -> i64 {
    var n: i64
    var x: i64
    n = 0
    x = m
    while x > 0 {
        x = x >> 1
        n += 1
    }
    n
}

fn f_nan[r](h: &mut r [u32], st: &mut r [u32]) -> i64 {
    mk_float(h, st, 2146959360, 0)
}

fn f_inf[r](h: &mut r [u32], st: &mut r [u32], sign: i64) -> i64 {
    mk_float(h, st, (sign << 31) | 2146435072, 0)
}

# the float of (m + something below 1) * 2^e for m > 0 (m < 2^62), where sticky is 1 if there is something below. m has at least 56 bits unless it is exact.
fn pack_round[r](h: &mut r [u32], st: &mut r [u32], sign: i64, m: i64, e: i64, sticky: i64) -> i64 {
    if m == 0 { return mk_float(h, st, sign << 31, 0) }
    let nb = nbits(m)
    let be = e + nb + 1022
    if be > 2046 { return f_inf(h, st, sign) }
    var sh: i64
    sh = nb - 53
    if be < 1 { sh = sh + 1 - be }
    var q: i64
    q = 0
    if sh <= 0 {
        q = m << (0 - sh)
    } else if sh <= 62 {
        q = m >> sh
        let rem = m & (((1 as i64) << sh) - 1)
        let half = (1 as i64) << (sh - 1)
        var up: i64
        up = 0
        if rem > half {
            up = 1
        } else if rem == half {
            if sticky == 1 or (q & 1) == 1 { up = 1 }
        }
        q = q + up
    }
    var bits: i64
    bits = q
    if be >= 1 { bits = ((be - 1) << 52) + q }
    if (bits >> 52) >= 2047 { return f_inf(h, st, sign) }
    mk_float(h, st, (sign << 31) | (bits >> 32), bits & 4294967295)
}

# the order of two floats: -1, 0, 1, or 2 when one of them is NaN
fn f_cmp(hx: i64, lx: i64, hy: i64, ly: i64) -> i64 {
    if f_is_nan(hx, lx) or f_is_nan(hy, ly) { return 2 }
    let ax = ((hx & 2147483647) << 32) | lx
    let ay = ((hy & 2147483647) << 32) | ly
    if ax == 0 and ay == 0 { return 0 }
    let sx = hx >> 31
    let sy = hy >> 31
    if sx != sy {
        if sx == 1 { return -1 }
        return 1
    }
    var c: i64
    c = 0
    if ax < ay { c = -1 }
    if ax > ay { c = 1 }
    if sx == 1 { return 0 - c }
    c
}

# x + y, or x - y if sub is 1
fn f_add[r](h: &mut r [u32], st: &mut r [u32], hx: i64, lx: i64, hy0: i64, ly: i64, sub: i64) -> i64 {
    let hy = hy0 ^ (sub << 31)
    if f_is_nan(hx, lx) or f_is_nan(hy, ly) { return f_nan(h, st) }
    let sx = hx >> 31
    let sy = hy >> 31
    if f_is_inf(hx, lx) {
        if f_is_inf(hy, ly) and sx != sy { return f_nan(h, st) }
        return mk_float(h, st, hx, lx)
    }
    if f_is_inf(hy, ly) { return mk_float(h, st, hy, ly) }
    if f_is_zero(hx, lx) {
        if f_is_zero(hy, ly) {
            var z: i64
            z = 0
            if sx == 1 and sy == 1 { z = 1 }
            return mk_float(h, st, z << 31, 0)
        }
        return mk_float(h, st, hy, ly)
    }
    if f_is_zero(hy, ly) { return mk_float(h, st, hx, lx) }
    var a: i64
    var b: i64
    var ea: i64
    var eb: i64
    var sa: i64
    var sb: i64
    a = f_man(hx, lx) << 8
    b = f_man(hy, ly) << 8
    ea = f_exp(hx, lx) - 8
    eb = f_exp(hy, ly) - 8
    sa = sx
    sb = sy
    if ea < eb {
        let t = a
        a = b
        b = t
        let te = ea
        ea = eb
        eb = te
        let ts = sa
        sa = sb
        sb = ts
    }
    let d = ea - eb
    if d > 0 {
        if d >= 62 {
            b = 1
        } else {
            let lost = b & (((1 as i64) << d) - 1)
            b = b >> d
            if lost != 0 { b = b | 1 }
        }
    }
    var rm: i64
    var rs: i64
    if sa == sb {
        rm = a + b
        rs = sa
    } else if a >= b {
        rm = a - b
        rs = sa
    } else {
        rm = b - a
        rs = sb
    }
    if rm == 0 { return mk_float(h, st, 0, 0) }
    pack_round(h, st, rs, rm, ea, 0)
}

fn f_mul[r](h: &mut r [u32], st: &mut r [u32], hx: i64, lx: i64, hy: i64, ly: i64) -> i64 {
    if f_is_nan(hx, lx) or f_is_nan(hy, ly) { return f_nan(h, st) }
    let sign = (hx >> 31) ^ (hy >> 31)
    if f_is_inf(hx, lx) or f_is_inf(hy, ly) {
        if f_is_zero(hx, lx) or f_is_zero(hy, ly) { return f_nan(h, st) }
        return f_inf(h, st, sign)
    }
    if f_is_zero(hx, lx) or f_is_zero(hy, ly) { return mk_float(h, st, sign << 31, 0) }
    let mx = f_man(hx, lx)
    let my = f_man(hy, ly)
    let x1 = mx >> 27
    let x0 = mx & 134217727
    let y1 = my >> 27
    let y0 = my & 134217727
    let p00 = x0 * y0
    let p01 = x0 * y1 + x1 * y0
    let p11 = x1 * y1
    let low = p00 + ((p01 & 134217727) << 27)
    let high = p11 + (p01 >> 27) + (low >> 54)
    let lowb = low & 18014398509481983
    var m: i64
    m = (high << 8) | (lowb >> 46)
    if (lowb & 70368744177663) != 0 { m = m | 1 }
    pack_round(h, st, sign, m, f_exp(hx, lx) + f_exp(hy, ly) + 46, 0)
}

fn f_div[r](h: &mut r [u32], st: &mut r [u32], hx: i64, lx: i64, hy: i64, ly: i64) -> i64 {
    if f_is_nan(hx, lx) or f_is_nan(hy, ly) { return f_nan(h, st) }
    let sign = (hx >> 31) ^ (hy >> 31)
    if f_is_inf(hx, lx) {
        if f_is_inf(hy, ly) { return f_nan(h, st) }
        return f_inf(h, st, sign)
    }
    if f_is_inf(hy, ly) { return mk_float(h, st, sign << 31, 0) }
    if f_is_zero(hy, ly) {
        if f_is_zero(hx, lx) { return f_nan(h, st) }
        return f_inf(h, st, sign)
    }
    if f_is_zero(hx, lx) { return mk_float(h, st, sign << 31, 0) }
    let mx = f_man(hx, lx)
    let my = f_man(hy, ly)
    var r: i64
    var q: i64
    r = mx
    q = 0
    for i in 0 as i64..60 {
        q = q << 1
        if r >= my {
            r = r - my
            q = q | 1
        }
        r = r << 1
    }
    if r != 0 { q = q | 1 }
    pack_round(h, st, sign, q, f_exp(hx, lx) - f_exp(hy, ly) - 59, 0)
}

fn f_sqrt[r](h: &mut r [u32], st: &mut r [u32], hx: i64, lx: i64) -> i64 {
    if f_is_nan(hx, lx) { return f_nan(h, st) }
    if f_is_zero(hx, lx) { return mk_float(h, st, hx, lx) }
    if (hx >> 31) == 1 { return f_nan(h, st) }
    if f_is_inf(hx, lx) { return mk_float(h, st, hx, lx) }
    var m: i64
    var e: i64
    m = f_man(hx, lx)
    e = f_exp(hx, lx)
    if (e & 1) == 1 {
        m = m << 1
        e -= 1
    }
    # the root of m * 4^31, from the pairs of bits of the top
    var rem: i64
    var root: i64
    rem = 0
    root = 0
    var j: i64
    j = 57
    while j >= 0 {
        var pair: i64
        pair = 0
        if j >= 31 { pair = (m >> (2 * (j - 31))) & 3 }
        rem = rem * 4 + pair
        let trial = root * 4 + 1
        if rem >= trial {
            rem = rem - trial
            root = root * 2 + 1
        } else {
            root = root * 2
        }
        j -= 1
    }
    if rem != 0 { root = root | 1 }
    pack_round(h, st, 0, root, (e >> 1) - 31, 0)
}

# the floor of a float, as a float
fn f_floor[r](h: &mut r [u32], st: &mut r [u32], hx: i64, lx: i64) -> i64 {
    let ex = f_ex(hx)
    if ex == 2047 or f_is_zero(hx, lx) { return mk_float(h, st, hx, lx) }
    let sign = hx >> 31
    let u = ex - 1023
    if u >= 52 { return mk_float(h, st, hx, lx) }
    if u < 0 {
        if sign == 0 { return mk_float(h, st, 0, 0) }
        return mk_float(h, st, 3220176896, 0)
    }
    let mag = ((hx & 2147483647) << 32) | lx
    let unit = (1 as i64) << (52 - u)
    let mask = unit - 1
    if (mag & mask) == 0 { return mk_float(h, st, hx, lx) }
    var b: i64
    b = mag - (mag & mask)
    if sign == 1 { b = b + unit }
    mk_float(h, st, (sign << 31) | (b >> 32), b & 4294967295)
}

# the integer with the sign, and the digits of m * 2^e (e >= 0, m < 2^62)
fn int_shifted[r](h: &mut r [u32], st: &mut r [u32], sign: i64, m: i64, e: i64) -> i64 {
    let w = e / 16
    let s = e % 16
    let v = alloc_big(h, st, sign, w + 6)
    let rb = (v >> 1) + 3
    for c in 0 as i64..4 {
        let part = ((m >> (16 * c)) & 65535) << s
        p(h, rb + w + c, g(h, rb + w + c) | (part & 65535))
        p(h, rb + w + c + 1, g(h, rb + w + c + 1) | (part >> 16))
    }
    fin(h, v)
}

# the integer truncated toward 0 of a finite float
fn f_to_int[r](h: &mut r [u32], st: &mut r [u32], hx: i64, lx: i64) -> i64 {
    if f_ex(hx) == 2047 { die("ftoi: not a finite number") }
    if f_is_zero(hx, lx) or f_ex(hx) == 0 { return 1 }
    let m = f_man(hx, lx)
    let e = f_exp(hx, lx)
    let sign = hx >> 31
    if e <= -53 { return 1 }
    if e < 0 {
        let q = m >> (0 - e)
        if sign == 1 { return int_from_i64(h, st, 0 - q) }
        return int_from_i64(h, st, q)
    }
    int_shifted(h, st, sign, m, e)
}

# the bit k of the magnitude of the integer v
fn i_bit[r](h: &r [u32], v: i64, k: i64) -> i64 {
    (i_dig(h, v, k / 16) >> (k % 16)) & 1
}

fn i_nbits[r](h: &r [u32], v: i64) -> i64 {
    let nd = i_nd(h, v)
    if nd == 0 { return 0 }
    (nd - 1) * 16 + nbits(i_dig(h, v, nd - 1))
}

# the float nearest to v * 2^e2 for an integer v; with strict it stops when the result is beyond the range of floats
fn big_to_float[r](h: &mut r [u32], st: &mut r [u32], v: i64, e2: i64, strict: i64) -> i64 {
    let sign = i_sign(h, v)
    let nb = i_nbits(h, v)
    if nb == 0 { return mk_float(h, st, 0, 0) }
    if strict == 1 and nb > 1024 { die("integer too large for a float") }
    var acc: i64
    var sticky: i64
    var e: i64
    acc = 0
    sticky = 0
    e = 0
    if nb <= 62 {
        for j in 0 as i64..nb {
            acc = (acc << 1) | i_bit(h, v, nb - 1 - j)
        }
    } else {
        for j in 0 as i64..62 {
            acc = (acc << 1) | i_bit(h, v, nb - 1 - j)
        }
        e = nb - 62
        var k: i64
        k = 0
        while k < e and sticky == 0 {
            if i_bit(h, v, k) == 1 { sticky = 1 }
            k += 1
        }
        if sticky == 1 { acc = acc | 1 }
    }
    let f = pack_round(h, st, sign, acc, e + e2, 0)
    if strict == 1 and f_ex(fl_hi(h, f)) == 2047 { die("integer too large for a float") }
    f
}

# the float nearest to the integer v; it stops when the integer is beyond the range of floats
fn int_to_float[r](h: &mut r [u32], st: &mut r [u32], v: i64) -> i64 {
    big_to_float(h, st, v, 0, 1)
}

# the order of the float x and the integer v: -1, 0, 1, or 2 when x is NaN
fn f_cmp_int[r](h: &r [u32], hx: i64, lx: i64, v: i64) -> i64 {
    if f_is_nan(hx, lx) { return 2 }
    let sx = hx >> 31
    let sv = i_sign(h, v)
    let nbv = i_nbits(h, v)
    if f_is_inf(hx, lx) {
        if sx == 1 { return -1 }
        return 1
    }
    if f_is_zero(hx, lx) {
        if nbv == 0 { return 0 }
        if sv == 1 { return 1 }
        return -1
    }
    if nbv == 0 {
        if sx == 1 { return -1 }
        return 1
    }
    if sx != sv {
        if sx == 1 { return -1 }
        return 1
    }
    let m = f_man(hx, lx)
    let e = f_exp(hx, lx)
    let nbf = 53 + e
    var c: i64
    c = 0
    if nbf < nbv { c = -1 }
    if nbf > nbv { c = 1 }
    if c == 0 {
        var k: i64
        k = nbv - 1
        while k >= 0 and c == 0 {
            var bf: i64
            bf = 0
            if k >= e and k - e <= 52 { bf = (m >> (k - e)) & 1 }
            let bi = i_bit(h, v, k)
            if bf > bi { c = 1 }
            if bf < bi { c = -1 }
            k -= 1
        }
        # the float has a fraction below the bit 0, so it is greater in magnitude
        if c == 0 and e < 0 and e >= -52 {
            let sh = 0 - e
            if m - ((m >> sh) << sh) != 0 { c = 1 }
        }
    }
    if sx == 1 { return 0 - c }
    c
}

# the 64 bits of a float as a non-negative integer
fn bits_to_int[r](h: &mut r [u32], st: &mut r [u32], hi: i64, lo: i64) -> i64 {
    let v = alloc_big(h, st, 0, 4)
    let rb = (v >> 1) + 3
    p(h, rb, lo & 65535)
    p(h, rb + 1, lo >> 16)
    p(h, rb + 2, hi & 65535)
    p(h, rb + 3, hi >> 16)
    fin(h, v)
}

# the digit i of 16 bits of the magnitude of the float that has an integer value, m * 2^e with e >= 0 or an integer m * 2^e
fn f_int_digit(m: i64, e: i64, i: i64) -> i64 {
    var d: i64
    d = 0
    for k in 0 as i64..16 {
        let pos = i * 16 + k
        if pos >= e and pos - e <= 52 {
            d = d | (((m >> (pos - e)) & 1) << k)
        }
    }
    d
}
