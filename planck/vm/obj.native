# obj: strings, symbols and m-exprs on the heap of planckvm
#
# Object kinds: 0 big integer (big.native), 3 string, 4 symbol, 5 m-expr, 8 Lambda, 9 Fusion, 10 builtin, 11 continuation, 13 type, 15 data.
# A type is the number (the identity), its name (a symbol), the Tuple of its field names and its type, which is the type Type. A data is the number, its type and the fields.
# A string is its number of bytes and the bytes packed from the low end of the words.
# A symbol is its name (a string) and a number. A m-expr is its head (a symbol) and the arguments.
# The roots of the image are the words 0 to 15 of the heap: 0 the Lambda that is run first, 1 false, 2 true, 3 none,
# 4 Tuple, 5 Cons, 6 Nil, and 7 to 15 the types of the values that are not data: Int String Symbol Expr Function Array Plain Float Complex.
# The type Type is the type of every type, so it is the word 4 of the type Int.
import mem
import big
import num

fn str_len[r](h: &r [u32], s: i64) -> i64 {
    g(h, (s >> 1) + 1)
}

fn str_byte[r](h: &r [u32], s: i64, i: i64) -> i64 {
    let w = g(h, (s >> 1) + 2 + i / 4)
    (w >> ((i % 4) * 8)) & 255
}

# A string is UTF-8: a byte of the form 10xxxxxx continues the character before it. strlen, ord and substr count the characters.
fn str_chars[r](h: &r [u32], s: i64) -> i64 {
    let n = str_len(h, s)
    var c: i64
    var i: i64
    c = 0
    i = 0
    while i < n {
        if (str_byte(h, s, i) & 192) != 128 { c += 1 }
        i += 1
    }
    c
}

# the position in bytes of the character i (the number of bytes when i is the number of characters), or -1 when i is beyond
fn char_pos[r](h: &r [u32], s: i64, i: i64) -> i64 {
    let n = str_len(h, s)
    var c: i64
    var b: i64
    c = 0
    b = 0
    while b < n {
        if (str_byte(h, s, b) & 192) != 128 {
            if c == i { return b }
            c += 1
        }
        b += 1
    }
    if c == i { return n }
    -1
}

# the code point of the character that starts at the byte b
fn char_at[r](h: &r [u32], s: i64, b: i64) -> i64 {
    let c0 = str_byte(h, s, b)
    if c0 < 128 { return c0 }
    let c1 = str_byte(h, s, b + 1) & 63
    if c0 < 224 { return ((c0 & 31) << 6) | c1 }
    let c2 = str_byte(h, s, b + 2) & 63
    if c0 < 240 { return ((c0 & 15) << 12) | (c1 << 6) | c2 }
    ((c0 & 7) << 18) | (c1 << 12) | (c2 << 6) | (str_byte(h, s, b + 3) & 63)
}

fn new_string[r](h: &mut r [u32], st: &mut r [u32], n: i64) -> i64 {
    let s = alloc_obj(h, st, 3, 1 + (n + 3) / 4)
    p(h, (s >> 1) + 1, n)
    s
}

# set_byte puts the byte b at i of a string that was made by new_string and has 0 there
fn set_byte[r](h: &mut r [u32], s: i64, i: i64, b: i64) {
    let at = (s >> 1) + 2 + i / 4
    p(h, at, g(h, at) | (b << ((i % 4) * 8)))
}

fn str_eq[r](h: &r [u32], x: i64, y: i64) -> bool {
    let n = str_len(h, x)
    if n != str_len(h, y) { return false }
    var i: i64
    i = 0
    while i < n {
        if str_byte(h, x, i) != str_byte(h, y, i) { return false }
        i += 1
    }
    true
}

fn mexpr_arity[r](h: &r [u32], m: i64) -> i64 {
    size_of(h, m) - 1
}

fn mexpr_head[r](h: &r [u32], m: i64) -> i64 {
    g(h, (m >> 1) + 1)
}

fn mexpr_arg[r](h: &r [u32], m: i64, i: i64) -> i64 {
    g(h, (m >> 1) + 2 + i)
}

# ---- the table of the interned objects
#
# A string, a symbol or a m-expr is interned: the equal ones are one object, so the equality of them is the identity of the references. A m-expr is
# equal to another when the heads are the same and each pair of the arguments is the same object (an integer, a reference, or a big integer of the same value).
# The table is in st (see mem.native). A slot is 0 (empty), 1 (deleted) or the reference to the object. The table does not keep the objects alive.
# The hash of an object has the addresses of the objects that it refers to, so it changes when the collector moves them; the collector (gc.native)
# puts the entries in order again.

fn mixh(acc: i64, x: i64) -> i64 {
    (acc * 1000003 + x + 12345) & 4294967295
}

# the part of the hash for the argument a of a m-expr: a big integer by the value, the others by the word
fn arg_key[r](h: &r [u32], a: i64) -> i64 {
    if (a & 1) == 1 { return a }
    if kind_of(h, a) == 0 {
        var acc: i64
        acc = 17
        let n = 2 + 2 * g(h, (a >> 1) + 2)
        for i in 0 as i64..n {
            acc = mixh(acc, g(h, (a >> 1) + 1 + i))
        }
        return acc
    }
    a
}

# the hash of the string, the symbol or the m-expr v
fn key_hash[r](h: &r [u32], v: i64) -> i64 {
    let k = kind_of(h, v)
    var acc: i64
    if k == 3 {
        let n = str_len(h, v)
        acc = n
        for i in 0 as i64..(n + 3) / 4 {
            acc = mixh(acc, g(h, (v >> 1) + 2 + i))
        }
        return acc
    }
    if k == 4 { return mixh(4, g(h, (v >> 1) + 1)) }
    acc = mixh(5, mexpr_head(h, v))
    let n = mexpr_arity(h, v)
    for i in 0 as i64..n {
        acc = mixh(acc, arg_key(h, mexpr_arg(h, v, i)))
    }
    acc
}

fn arg_same[r](h: &r [u32], a: i64, b: i64) -> bool {
    if a == b { return true }
    if (a & 1) == 1 or (b & 1) == 1 { return false }
    if kind_of(h, a) == 0 and kind_of(h, b) == 0 { return big_eq(h, a, b) }
    false
}

# whether the objects a and b are equal as the keys of the table
fn key_eq[r](h: &r [u32], a: i64, b: i64) -> bool {
    let k = kind_of(h, a)
    if k != kind_of(h, b) { return false }
    if k == 3 { return str_eq(h, a, b) }
    if k == 4 { return g(h, (a >> 1) + 1) == g(h, (b >> 1) + 1) }
    if mexpr_head(h, a) != mexpr_head(h, b) { return false }
    let n = mexpr_arity(h, a)
    if n != mexpr_arity(h, b) { return false }
    for i in 0 as i64..n {
        if not arg_same(h, mexpr_arg(h, a, i), mexpr_arg(h, b, i)) { return false }
    }
    true
}

fn it_slot[r](h: &r [u32], v: i64) -> i64 {
    let hh = key_hash(h, v)
    (hh ^ (hh >> 13)) & (it_cap() - 1)
}

# it_put puts the object v in the first slot that is not used from its slot, and gives the slot
fn it_put[r](h: &r [u32], st: &mut r [u32], v: i64) -> i64 {
    let mask = it_cap() - 1
    var i: i64
    i = it_slot(h, v)
    while g(st, it_base() + i) > 1 {
        i = (i + 1) & mask
    }
    if g(st, it_base() + i) == 0 { p(st, 24, g(st, 24) + 1) }
    p(st, it_base() + i, v)
    i
}

# it_find gives the object that is equal to the new object v in the table; when there is none, v is put in the table and is the result
fn it_find[r](h: &mut r [u32], st: &mut r [u32], v: i64) -> i64 {
    let mask = it_cap() - 1
    var i: i64
    var go: i64
    i = it_slot(h, v)
    go = 1
    while go == 1 {
        let e = g(st, it_base() + i)
        if e == 0 {
            go = 0
        } else {
            if e != 1 {
                if key_eq(h, e, v) {
                    # v is the last object of the nursery: its words are given back
                    if (v >> 1) >= g(st, 6) and g(st, 0) == (v >> 1) + 1 + size_of(h, v) { p(st, 0, v >> 1) }
                    return e
                }
            }
            i = (i + 1) & mask
        }
    }
    let sl = it_put(h, st, v)
    let n = g(st, 25)
    if n < it_rcap() {
        p(st, it_rbase() + n, sl)
        p(st, 25, n + 1)
    } else {
        p(st, 26, 1)
    }
    if g(st, 24) > it_cap() / 2 {
        # the deleted slots are given back by a major collection
        p(st, 12, 1)
        p(st, 14, 0)
    }
    if g(st, 24) >= it_cap() / 8 * 7 { die("the table of the interned objects is full") }
    v
}

# fin_string gives the string with the bytes of the new string s that are put; fin_mexpr is the same for a m-expr whose arguments are put
fn fin_string[r](h: &mut r [u32], st: &mut r [u32], s: i64) -> i64 {
    it_find(h, st, s)
}

fn fin_mexpr[r](h: &mut r [u32], st: &mut r [u32], m: i64) -> i64 {
    it_find(h, st, m)
}

# the symbol of the name s (a string)
fn intern_sym[r](h: &mut r [u32], st: &mut r [u32], s: i64) -> i64 {
    let name = it_find(h, st, s)
    let sym = alloc_obj(h, st, 4, 2)
    p(h, (sym >> 1) + 1, name)
    p(h, (sym >> 1) + 2, 1)
    it_find(h, st, sym)
}

# new_mexpr makes a m-expr of the head and n arguments that are 0; the arguments are put with set_arg and then fin_mexpr gives the m-expr
fn new_mexpr[r](h: &mut r [u32], st: &mut r [u32], head: i64, n: i64) -> i64 {
    let m = alloc_obj(h, st, 5, 1 + n)
    p(h, (m >> 1) + 1, head)
    m
}

fn set_arg[r](h: &mut r [u32], m: i64, i: i64, v: i64) {
    p(h, (m >> 1) + 2 + i, v)
}

# the type Type
fn type_type[r](h: &r [u32]) -> i64 {
    g(h, (g(h, 7) >> 1) + 4)
}

# the value of type: the type of the value
fn type_of[r](h: &r [u32], v: i64) -> i64 {
    if (v & 1) == 1 { return g(h, 7) }
    let k = kind_of(h, v)
    if k == 15 { return g(h, (v >> 1) + 2) }
    if k == 13 { return g(h, (v >> 1) + 4) }
    if k == 3 { return g(h, 8) }
    if k == 4 { return g(h, 9) }
    if k == 5 { return g(h, 10) }
    if k == 6 { return g(h, 12) }
    if k == 7 { return g(h, 13) }
    if k == 1 { return g(h, 14) }
    if k == 2 { return g(h, 15) }
    if k == 0 { return g(h, 7) }
    g(h, 11)
}

fn is_mexpr[r](h: &r [u32], v: i64) -> bool {
    if (v & 1) == 1 { return false }
    kind_of(h, v) == 5
}

fn is_data[r](h: &r [u32], v: i64) -> bool {
    if (v & 1) == 1 { return false }
    kind_of(h, v) == 15
}

fn data_arity[r](h: &r [u32], d: i64) -> i64 {
    size_of(h, d) - 2
}

fn data_arg[r](h: &r [u32], d: i64, i: i64) -> i64 {
    g(h, (d >> 1) + 3 + i)
}

fn is_string[r](h: &r [u32], v: i64) -> bool {
    if (v & 1) == 1 { return false }
    kind_of(h, v) == 3
}

fn is_symbol[r](h: &r [u32], v: i64) -> bool {
    if (v & 1) == 1 { return false }
    kind_of(h, v) == 4
}
