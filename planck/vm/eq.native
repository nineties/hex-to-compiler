# eq: the equality of values (_eq)
#
# Numbers are equal by the value, strings by the bytes, m-exprs by the identity (they are interned, so m-exprs of the same head and the same arguments are one object), arrays by the
# elements, plain arrays by the elements that are read as values (a plain array of another type with equal elements is equal), and a value is equal to itself.
# The other values (symbols, functions) are equal when they are the same object. An array and a plain array are never equal.
# Reading an element of a plain array makes a value on the heap; the heap is given back after the comparison.
import mem
import obj
import big
import flt
import num
import arr

fun equal[r](h: &mutable r [u8], st: &mutable r [i64], x: i64, y: i64) -> bool {
    let cx = num_class(h, x)
    let cy = num_class(h, y)
    if cx != 0 and cy != 0 { return num_equal(h, x, y) }
    if cx != 0 or cy != 0 { return false }
    if x == y { return true }
    if (x & 1) == 1 { return false }
    if (y & 1) == 1 { return false }
    let kx = kind_of(h, x)
    if kx != kind_of(h, y) { return false }
    if kx == 3 { return str_eq(h, x, y) }
    # m-exprs are interned: two of them are equal only when they are the same object
    if kx == 5 { return false }
    if kx == 6 {
        let n = array_len(h, x)
        if n != array_len(h, y) { return false }
        var i: i64
        i = 0
        while i < n {
            if not equal(h, st, a_get(h, x, small(i)), a_get(h, y, small(i))) { return false }
            i += 1
        }
        return true
    }
    if kx == 7 {
        let n = pl_count(h, x)
        if n != pl_count(h, y) { return false }
        let mark = g(st, 0)
        var i: i64
        i = 0
        while i < n {
            let a = pl_get(h, st, x, small(i))
            let b = pl_get(h, st, y, small(i))
            let same = equal(h, st, a, b)
            p(st, 0, mark)
            if not same { return false }
            i += 1
        }
        return true
    }
    false
}
