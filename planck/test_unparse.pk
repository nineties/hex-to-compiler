rt("f((x = 1))")
rt("(a | b) + 1")
rt("f(x) := { y := x; (y -> y)(1) }")
rt("handle { 1 + perform Ask{} } with (Ask{}, k) -> k(41)")
rt("a < (b < c)")
rt("a :: (b == c)")
rt("not (a and b)")
rt("not not a")
rt("- - a")
rt("-(-3)")
rt("1 - -(2)")

# === Round trips of files ===
file_trips(path) := {
    src := read_file(path)
    t := tree(src)
    while (t != Eof{} and head(t) != 'SyntaxError) {
        trip(t)
        src = rest(src)
        t = tree(src)
    }
}
file_trips("planck/lib/base.pk")
file_trips("planck/lib/symbol.pk")

# === A grammar written with ::= is run backwards too ===
arith ::= a:arith "+" b:term { `Apply{add, Tuple{!a, !b}} } | a:arith "-" b:term { `Apply{sub, Tuple{!a, !b}} } | term
term ::= a:term "*" b:factor { `Apply{mul, Tuple{!a, !b}} } | factor
factor ::= n:integer { n } | x:ident { x } | "(" e:arith ")" { e }
check(unparse_as('arith, arg(peg_parse('arith, "1+2*3"), 0)), "1 + 2 * 3")
check(unparse_as('arith, arg(peg_parse('arith, "(1+2)*3"), 0)), "(1 + 2) * 3")
check(unparse_as('arith, arg(peg_parse('arith, "1-(2-x)"), 0)), "1 - (2 - x)")
check(unparse_as('arith, 'Apply{mul, Tuple{Apply{add, Tuple{a, b}}, Apply{sub, Tuple{c, d}}}}), "(a + b) * (c - d)")
check(unparse_try('arith, 'Apply{div, Tuple{1, 2}}), none)

put("Tests passed "); print(passed); put("/"); println(passed + failed)
put("Round trips "); println(trips)
if (failed > 0) exit(1)
