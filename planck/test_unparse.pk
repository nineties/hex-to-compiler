# the tail of if, while and handle goes on to the right, so they need parentheses before an operator
rt("(if (a) b else c) + 1")
rt("(while (a) b) + 1")
rt("(handle a with b) + 1")
rt("1 + (if (a) b else c)")
rt("-(if (a) b else c)")
rt("f(if (a) b else c, 2)")
rt("(x -> x) + 1")
rt("x -> if (a) b")
rt("if (a) (if (b) c) else d")
rt("if (a) (x -> if (b) c) else d")
rt("if (a) b else if (c) d else e")
rt("if (a) { if (b) c } else d")
rt("(a ? b : c) ? d : e")
rt("a ? (b ? c : d) : e")
rt("perform E{x} + 1")
rt("(x := 1) + 2")
rt("f((x = 1))")
rt("(a | b) + 1")
rt("f(x) := { y := x; (y -> y)(1) }")
rt("handle { 1 + perform Ask{} } with (Ask{}, k) -> k(41)")
rt("a < (b < c)")
rt("a :: (b == c)")
rt("not (a and b)")
rt("not not a")
rt("- - a")
rt("-(-3)")
rt("1 - -(2)")

# the new syntax
rt("x -> y -> x + y")
rt("f(n) := { if (n < 0) return 0; n + 1 }")
rt("f(n) := { return }")
rt("g(x) := { return -x }")
rt("return - 1")
rt("(return) - 1")
rt("f(return, 1)")
rt("x = (return)")
rt("(x, y) -> return x")
rt("while (a) { if (b) break; if (c) continue; d }")
rt("while (a) { while (b) { break }; if (c) break }")
rt("while (a) { f(x -> { if (x) continue; 1 }) }")
rt("for (x in xs) { if (x) continue; f(x) }")
rt("for (h :: t in xs) f(h)")
rt("f(xs) := { for (x in xs) { if (x > 1) return x }; 0 }")
rt("f(a) := { g := y -> { return y }; return g(a) }")
rt("match x { 1 -> a | 2 -> b | _ -> c }")
rt("match x { h :: t -> h | _ -> 0 }")
rt("match x { n if n > 0 -> match n { 1 -> 2 | k if k > 5 -> 3 | _ -> 4 } | _ -> 4 }")
rt("match x { n if (a -> b) == c -> 1 | _ -> 2 }")
rt("match (x -> x) { f -> f(1) | _ -> 0 }")
rt("match x { 1 -> y -> y | _ -> z -> z }")
rt("f(x) := match x { n if n < 0 -> return 0 | _ -> x }")
rt("(a -> 1 | b -> 2)(x)")
rt("f\"a{x}b\"")
rt("f\"{x}\"")
rt("f\"{{x}} {a + 1} }}\"")
rt("f\"\\n\\t\\\"q\\\" {f(1, \"s\")}\"")
rt("f\"a{f\"b{x}\"}c\"")
rt("f\"{ {a; b} }\"")
rt("f\"{\"{\"}\"")
rt("strcat(strcat(\"a\", to_text(x)), to_text(y))")
rt("strcat(\"a\", \"b\")")
rt("record E()")
rt("record R(a, b, c)")
rt("r.a.b")
rt("f(r).x(1)")
rt("{ f(x) := x; g(y) := y; f = 1 }")
rt("{ x := none; f(a) := a; f(1) }")
rt("{ f(a) := { for (i in a) { if (i) break }; 1 } }")
rt("{ g := x -> x; y := g(1); f(x) := x; f(1) }")
rt("f(a) := { b := a; g := y -> y + b; h(z) := g(z); h(1) }")
rt("fun f")
rt("{ fun od; ev(n) := od(n); od(n) = ev(n); ev(1) }")
rt("f(x, y) = x + y")
rt("{ fun f; f() = { return 1 } }")
rt("if (c) f(x) = 1 else f(x) = 2")
rt("perform Return{1}")
rt("a[i]")
rt("a[i][j] = b[k]")
rt("f(x)[i].g(y)")
rt("a[i + 1] = a[i] * 2")
rt("{ a[i] = 1; a[i] }")
rt("t[x @ int -> x + 1]")
rt("t[F{a} -> a | G{a, b} -> b]")
rt("t[P{a, b} if a == b -> a | P{a, b} -> b]")
rt("t[P{a, b} if a == b -> (x -> x)]")
check(unparse(tree("_index_get(a, i)")), "a[i]")
check(unparse(tree("_index_set(a, i, v)")), "a[i] = v")
check(unparse(tree("t[P{a, b} if a == b -> a | x -> x]")), "t[P{a, b} if a == b -> a | x -> x]")

put("Tests passed "); print(passed); put("/"); println(passed + failed)
put("Round trips "); println(trips)
if (failed > 0) exit(1)
