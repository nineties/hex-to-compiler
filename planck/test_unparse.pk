# tests for planck/lib/unparse.pk
# Copyright (C) 2026 nineties

use("unparse")

passed := 0
failed := 0
trips := 0

check(actual, expected) := if (actual == expected) {
    passed = passed + 1
} else {
    failed = failed + 1
    put("Test failed: expected "); print(expected)
    put(" but got "); println(actual)
}

tree(s) := arg(peg_parse('toplevel, s), 0)
rest(s) := arg(peg_parse('toplevel, s), 1)

# round trip: the text of a tree parses to the tree, and printing again gives the same text
trip(t) := {
    out := unparse(t)
    t2 := tree(out)
    trips = trips + 1
    check(t2, t)
    check(unparse(t2), out)
}
rt(s) := trip(tree(s))

# === Printed text ===
check(unparse(tree("1+2*3")), "1 + 2 * 3")
check(unparse(tree("(1 + 2) * 3")), "(1 + 2) * 3")
check(unparse(tree("((1 + 2)) * 3")), "(1 + 2) * 3")
check(unparse(tree("1 - (2 - 3)")), "1 - (2 - 3)")
check(unparse(tree("1 - 2 - 3")), "1 - 2 - 3")
check(unparse(tree("8 / (4 % 3)")), "8 / (4 % 3)")
check(unparse(tree("-x")), "-x")
check(unparse(tree("- 5")), "- 5")
check(unparse(tree("-5")), "-5")
check(unparse(tree("a - -1")), "a - -1")
check(unparse(tree("-(a + b)")), "-(a + b)")
check(unparse(tree("not a == b")), "not a == b")
check(unparse(tree("(a or b) and c")), "(a or b) and c")
check(unparse(tree("f(a, g(b), 1 + 2)")), "f(a, g(b), 1 + 2)")
check(unparse(tree("(f + g)(x)")), "(f + g)(x)")
check(unparse(tree("(x -> x)(1)")), "(x -> x)(1)")
check(unparse(tree("x -> y -> x + y")), "x -> y -> x + y")
check(unparse(tree("(x, y) -> x")), "(x, y) -> x")
check(unparse(tree("() -> 1")), "() -> 1")
check(unparse(tree("c ? a : b")), "if (c) a else b")
check(unparse(tree("a :: b :: []")), "a :: b :: Nil{}")
check(unparse(tree("(a :: b) :: c")), "(a :: b) :: c")
check(unparse(tree("'(a + 1)")), "'(a + 1)")
check(unparse(tree("`F{!x}")), "`F{!x}")
check(unparse(tree("F{1, x}")), "F{1, x}")
check(unparse(tree("\"a\\tb\\n\"")), "\"a\\tb\\n\"")
check(unparse(tree("f(x) := x + 1")), "f(x) := x + 1")
check(unparse(tree("x = y")), "x = y")
check(unparse(tree("while (a) { b }")), "while (a) {\n    b\n}")
check(unparse(tree("{ a; { b; c } }")), "{\n    a\n    {\n        b\n        c\n    }\n}")
check(unparse(tree("if (a) { b } else if (c) { d }")), "if (a) {\n    b\n} else if (c) {\n    d\n}")
check(unparse(tree("if (a) (if (b) c) else d")), "if (a) (if (b) c) else d")
check(unparse(tree("(if (a) b else c) + 1")), "(if (a) b else c) + 1")

# the syntax that is made by functions: return, break and continue wrap the body in a handler
check(unparse(tree("f(n) := { if (n < 0) return 0; n + 1 }")), "f(n) := {\n    if (n < 0) return 0\n    n + 1\n}")
check(unparse(tree("f(n) := { return }")), "f(n) := {\n    return\n}")
check(unparse(tree("g := (x, y) -> { return x + y }")), "g := (x, y) -> {\n    return x + y\n}")
check(unparse(tree("while (a) { if (b) break; if (c) continue; d }")), "while (a) {\n    if (b) break\n    if (c) continue\n    d\n}")
check(unparse(tree("for (x in xs) { if (x) continue; f(x) }")), "for (x in xs) {\n    if (x) continue\n    f(x)\n}")
check(unparse(tree("for (h :: t in xs) f(h)")), "for (h :: t in xs) f(h)")
check(unparse(tree("f(xs) := { for (x in xs) { if (x > 1) return x }; 0 }")), "f(xs) := {\n    for (x in xs) {\n        if (x > 1) return x\n    }\n    0\n}")
check(unparse(tree("match x { 1 -> a | 2 -> b | _ -> c }")), "match x {\n    1 -> a\n  | 2 -> b\n  | _ -> c\n}")
check(unparse(tree("match x { h :: t -> h | _ -> 0 }")), "match x {\n    h :: t -> h\n  | _ -> 0\n}")
check(unparse(tree("match n { n if n < 0 -> \"neg\" | 0 -> \"zero\" | n if n < 10 -> \"small\" | _ -> \"big\" }")),
      "match n {\n    n if n < 0 -> \"neg\"\n  | 0 -> \"zero\"\n  | n if n < 10 -> \"small\"\n  | _ -> \"big\"\n}")
check(unparse(tree("(a -> 1 | b -> 2)(x)")), "match x {\n    a -> 1\n  | b -> 2\n}")
check(unparse(tree("f\"a{x}b\"")), "f\"a{x}b\"")
check(unparse(tree("f\"{x}\"")), "f\"{x}\"")
check(unparse(tree("f\"{{x}} {a + 1} }}\"")), "f\"{{x}} {a + 1} }}\"")
check(unparse(tree("f\"{{\"")), "\"{\"")
check(unparse(tree("strcat(a, \"x\")")), "strcat(a, \"x\")")
check(unparse(tree("strcat(\"a\", \"b\")")), "strcat(\"a\", \"b\")")
check(unparse(tree("record Point(x, y)")), "record Point(x, y)")
check(unparse(tree("p.x + p.y")), "p.x + p.y")
check(unparse(tree("{ a := 1; f(x) := x + a; f(2) }")), "{\n    a := 1\n    f(x) := x + a\n    f(2)\n}")
check(unparse(tree("return")), "return")
check(unparse(tree("return -x")), "return -x")
check(unparse(tree("(return) - 1")), "(return) - 1")

# a tree that was not made by the parser
check(unparse('Apply{_mul, Tuple{Apply{_add, Tuple{1, 2}}, 3}}), "(1 + 2) * 3")
check(unparse('Apply{_sub, Tuple{0, 5}}), "- 5")
check(unparse('Apply{_add, Tuple{Apply{_add, Tuple{1, 2}}, Apply{_add, Tuple{3, 4}}}}), "1 + 2 + (3 + 4)")
check(unparse('Def{Foo{}, 1}), "Def{Foo{}, 1}")
check(unparse_try('expr, array(1)), none)

# === Round trips of the examples of test_syntax.pk ===
