# the tail of if, while and handle goes on to the right, so they need parentheses before an operator
rt("(if (a) b else c) + 1")
rt("(while (a) b) + 1")
rt("(handle a with b) + 1")
rt("1 + (if (a) b else c)")
rt("-(if (a) b else c)")
rt("f(if (a) b else c, 2)")
rt("(x -> x) + 1")
