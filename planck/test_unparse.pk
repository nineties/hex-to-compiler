# tests for planck/lib/unparse.pk
# Copyright (C) 2026 nineties

use("unparse")

passed := 0
failed := 0
trips := 0

check(actual, expected) := if (actual == expected) {
    passed = passed + 1
} else {
    failed = failed + 1
    put("Test failed: expected "); print(expected)
    put(" but got "); println(actual)
}

tree(s) := arg(peg_parse('toplevel, s), 0)
rest(s) := arg(peg_parse('toplevel, s), 1)

# round trip: the text of a tree parses to the tree, and printing again gives the same text
trip(t) := {
    out := unparse(t)
    t2 := tree(out)
    trips = trips + 1
    check(t2, t)
    check(unparse(t2), out)
}
rt(s) := trip(tree(s))

# === Printed text ===
check(unparse(tree("1+2*3")), "1 + 2 * 3")
check(unparse(tree("(1 + 2) * 3")), "(1 + 2) * 3")
check(unparse(tree("((1 + 2)) * 3")), "(1 + 2) * 3")
check(unparse(tree("1 - (2 - 3)")), "1 - (2 - 3)")
check(unparse(tree("1 - 2 - 3")), "1 - 2 - 3")
check(unparse(tree("8 / (4 % 3)")), "8 / (4 % 3)")
check(unparse(tree("-x")), "-x")
check(unparse(tree("- 5")), "- 5")
check(unparse(tree("-5")), "-5")
check(unparse(tree("a - -1")), "a - -1")
check(unparse(tree("-(a + b)")), "-(a + b)")
check(unparse(tree("not a == b")), "not a == b")
check(unparse(tree("(a or b) and c")), "(a or b) and c")
check(unparse(tree("f(a, g(b), 1 + 2)")), "f(a, g(b), 1 + 2)")
check(unparse(tree("(f + g)(x)")), "(f + g)(x)")
check(unparse(tree("(x -> x)(1)")), "(x -> x)(1)")
check(unparse(tree("x -> y -> x + y")), "x -> y -> x + y")
check(unparse(tree("(x, y) -> x")), "(x, y) -> x")
check(unparse(tree("() -> 1")), "() -> 1")
check(unparse(tree("c ? a : b")), "if (c) a else b")
check(unparse(tree("a :: b :: []")), "a :: b :: Nil{}")
check(unparse(tree("(a :: b) :: c")), "(a :: b) :: c")
check(unparse(tree("'(a + 1)")), "'(a + 1)")
check(unparse(tree("`F{!x}")), "`F{!x}")
check(unparse(tree("F{1, x}")), "F{1, x}")
check(unparse(tree("\"a\\tb\\n\"")), "\"a\\tb\\n\"")
check(unparse(tree("f(x) := x + 1")), "f(x) := x + 1")
check(unparse(tree("x = y")), "x = y")
check(unparse(tree("while (a) { b }")), "while (a) {\n    b\n}")
check(unparse(tree("{ a; { b; c } }")), "{\n    a\n    {\n        b\n        c\n    }\n}")
check(unparse(tree("if (a) { b } else if (c) { d }")), "if (a) {\n    b\n} else if (c) {\n    d\n}")
check(unparse(tree("if (a) (if (b) c) else d")), "if (a) (if (b) c) else d")
check(unparse(tree("(if (a) b else c) + 1")), "(if (a) b else c) + 1")

# a tree that was not made by the parser
check(unparse('Apply{mul, Tuple{Apply{add, Tuple{1, 2}}, 3}}), "(1 + 2) * 3")
check(unparse('Apply{sub, Tuple{0, 5}}), "- 5")
check(unparse('Apply{add, Tuple{Apply{add, Tuple{1, 2}}, Apply{add, Tuple{3, 4}}}}), "1 + 2 + (3 + 4)")
check(unparse('Def{Foo{}, 1}), "Def{Foo{}, 1}")
check(unparse_try('expr, array(1)), none)

