# mx: loads libraries from the files planck/lib/<name>.mx, which hold the expressions of planck/lib/<name>.pk as M-expressions
# Copyright (C) 2026 nineties
#
# Reading a library in the syntax of planck/syntax.pk takes memory in proportion to its text, and the heap of planck0 is not collected.
# An .mx file is read by parse_mexpr, which takes almost none. After this file is loaded, use(name) reads planck/lib/<name>.mx.
# make mx writes the .mx files with planck/mkmx.pk. parse_mexpr reads at most 15 arguments for a head, so
# a head with more arguments is written as Wide_{head, Tuple{15 arguments}, Tuple{15 arguments}, ...}.

fun mx_enc
fun mx_dec

mx_chunk(e, from) := {
    t := Tuple{}
    i := from
    while (i < arity(e) and i < from + 15) {
        t = push(t, mx_enc(arg(e, i)))
        i = i + 1
    }
    t
}

# a symbol that parse_mexpr cannot read (a name with a character other than a letter, a digit and _) is written as Sym_{"name"}
mx_plain(s) := {
    ok := true
    i := 0
    while (i < strlen(s)) {
        c := ord(s, i)
        if (not ((c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95)) ok = false
        i = i + 1
    }
    ok
}

# mx_enc(e) is the expression e with the heads that have more than 15 arguments written as Wide_
mx_enc(e) := if (typeof(e) == 'symbol) (if (mx_plain(symname(e))) e else Sym_{symname(e)})
else if (typeof(e) != 'mexpr) e
else if (arity(e) <= 15) {
    r := mexpr(head(e), Tuple{})
    i := 0
    while (i < arity(e)) {
        r = push(r, mx_enc(arg(e, i)))
        i = i + 1
    }
    r
} else {
    r := push(mexpr('Wide_, Tuple{}), head(e))
    i := 0
    while (i < arity(e)) {
        r = push(r, mx_chunk(e, i))
        i = i + 15
    }
    r
}

mx_dec(e) := if (typeof(e) != 'mexpr) e
else if (head(e) == 'Sym_) intern(arg(e, 0))
else if (head(e) == 'Wide_) {
    r := mexpr(arg(e, 0), Tuple{})
    i := 1
    while (i < arity(e)) {
        c := arg(e, i)
        j := 0
        while (j < arity(c)) {
            r = push(r, mx_dec(arg(c, j)))
            j = j + 1
        }
        i = i + 1
    }
    r
} else {
    r := mexpr(head(e), Tuple{})
    i := 0
    while (i < arity(e)) {
        r = push(r, mx_dec(arg(e, i)))
        i = i + 1
    }
    r
}

load_mx(name) := {
    path := _strcat(_strcat("planck/lib/", name), ".pk")
    prev := _set_file(path)
    s := read_file(_strcat(_strcat("planck/lib/", name), ".mx"))
    go := true
    while (go) {
        r := parse_mexpr(s)
        e := arg(r, 0)
        if (e == Eof{}) go = false else {
            eval(mx_dec(e))
            s = arg(r, 1)
        }
    }
    _set_file(prev)
    none
}

use = (name) -> if (table_get(used_libs, name, false)) none else {
    table_set(used_libs, name, true)
    load_mx(name)
}
