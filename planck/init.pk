" init script for planck"
" Copyright (C) 2026 nineties "

" This script bootstraps Planck from its minimal core into a full-featured "
" programming language by leveraging its langugage extension capabilities. "

" === Builtin Symbols === "
Def{true, Quote{true}}
Def{false, Quote{false}}
Def{none, Quote{none}}

" === Types === "
" planck0 has no type values. type(x) gives the symbol that typeof(x) gives, and the type names Int, String, Symbol, "
" Expr, Function, Array, Plain and Type are bound to those symbols. The programs are written with the type names of "
" the specification: _TypeOf{p, Int}. eval makes the names in the patterns of the expressions the symbols that typeof gives. "
Def{Int, Quote{int}}
Def{String, Quote{string}}
Def{Symbol, Quote{symbol}}
Def{Expr, Quote{mexpr}}
Def{Function, Quote{function}}
Def{Array, Quote{array}}
Def{Plain, Quote{plain}}
Def{Type, Quote{type}}
Def{type, Lambda{Tuple{x}, Apply{typeof, Tuple{x}}}}

Def{_type_name, Fusion{Lambda{Tuple{Quote{Int}}, Quote{int}},
    Fusion{Lambda{Tuple{Quote{String}}, Quote{string}},
    Fusion{Lambda{Tuple{Quote{Symbol}}, Quote{symbol}},
    Fusion{Lambda{Tuple{Quote{Expr}}, Quote{mexpr}},
    Fusion{Lambda{Tuple{Quote{Function}}, Quote{function}},
    Fusion{Lambda{Tuple{Quote{Array}}, Quote{array}},
    Fusion{Lambda{Tuple{Quote{Plain}}, Quote{plain}},
    Lambda{Tuple{n}, n}}}}}}}}}

" _lower_types(e) is e with the type names of _TypeOf{p, T} replaced. Quote{...} is left as it is. "
Def{_lower_types, none}
Set{_lower_types, Lambda{Tuple{e}, Do{
    Def{n, 0},
    Def{r, none},
    Def{i, 0},
    Def{j, 0},
    Def{a, none},
    Def{c, none},
    If{Apply{_ne, Tuple{Apply{typeof, Tuple{e}}, Quote{mexpr}}}, e,
    If{Apply{_eq, Tuple{Apply{head, Tuple{e}}, Quote{Quote}}}, e,
    If{If{Apply{_eq, Tuple{Apply{head, Tuple{e}}, Quote{_TypeOf}}}, Apply{_eq, Tuple{Apply{arity, Tuple{e}}, 2}}, false},
        Apply{mexpr, Tuple{Quote{_TypeOf}, Tuple{Apply{_lower_types, Tuple{Apply{arg, Tuple{e, 0}}}}, Apply{_type_name, Tuple{Apply{arg, Tuple{e, 1}}}}}}},
        Do{
            Set{n, Apply{arity, Tuple{e}}},
            While{Apply{_lt, Tuple{i, n}}, Do{
                Set{a, Apply{arg, Tuple{e, i}}},
                Set{c, Apply{_lower_types, Tuple{a}}},
                If{Apply{_eq, Tuple{r, none}},
                    If{Apply{_ne, Tuple{c, a}}, Do{
                        Set{r, Apply{mexpr, Tuple{Apply{head, Tuple{e}}, Tuple{}}}},
                        Set{j, 0},
                        While{Apply{_lt, Tuple{j, i}}, Do{
                            Set{r, Apply{push, Tuple{r, Apply{arg, Tuple{e, j}}}}},
                            Set{j, Apply{_add, Tuple{j, 1}}}}},
                        Set{r, Apply{push, Tuple{r, c}}}}, none},
                    Set{r, Apply{push, Tuple{r, c}}}},
                Set{i, Apply{_add, Tuple{i, 1}}}}},
            If{Apply{_eq, Tuple{r, none}}, e, r}}}}}}}}

Def{_eval0, eval}
Set{eval, Lambda{Tuple{e}, Apply{_eval0, Tuple{Apply{_lower_types, Tuple{e}}}}}}

" === Basic Functions === "
Def{_not, Fusion{
    Lambda{Tuple{Quote{false}}, true},
    Lambda{Tuple{_}, false}}}

" === Tables === "
" A table is Table{a}, where a is an array | buckets | number of entries |. Each bucket is a chain of entries "
" | key | value | next entry or none | hash of the key |. Keys are compared by eq. "
" The number of buckets doubles when there are more entries than buckets. "
Def{table_new, Lambda{Tuple{}, Do{
    Def{t, Apply{array, Tuple{2}}},
    Apply{array_set, Tuple{t, 0, Apply{array, Tuple{16}}}},
    Apply{array_set, Tuple{t, 1, 0}},
    Table{t}}}}

Def{table_find, Lambda{Tuple{t, k, h}, Do{
    Def{b, Apply{array_get, Tuple{t, 0}}},
    Def{e, Apply{array_get, Tuple{b, Apply{_mod, Tuple{h, Apply{array_len, Tuple{b}}}}}}},
    While{If{Apply{_ne, Tuple{e, none}},
            If{Apply{_eq, Tuple{Apply{array_get, Tuple{e, 3}}, h}},
                Apply{_ne, Tuple{Apply{array_get, Tuple{e, 0}}, k}},
                true},
            false},
        Set{e, Apply{array_get, Tuple{e, 2}}}},
    e}}}

Def{table_get, Lambda{Tuple{Table{t}, k, default}, Do{
    Def{e, Apply{table_find, Tuple{t, k, Apply{hash, Tuple{k}}}}},
    If{Apply{_eq, Tuple{e, none}}, default, Apply{array_get, Tuple{e, 1}}}}}}

Def{table_grow, Lambda{Tuple{t}, Do{
    Def{old, Apply{array_get, Tuple{t, 0}}},
    Def{m, Apply{_mul, Tuple{Apply{array_len, Tuple{old}}, 2}}},
    Def{nb, Apply{array, Tuple{m}}},
    Def{i, 0},
    Def{e, none},
    Def{next, none},
    Def{j, 0},
    While{Apply{_lt, Tuple{i, Apply{array_len, Tuple{old}}}}, Do{
        Set{e, Apply{array_get, Tuple{old, i}}},
        While{Apply{_ne, Tuple{e, none}}, Do{
            Set{next, Apply{array_get, Tuple{e, 2}}},
            Set{j, Apply{_mod, Tuple{Apply{array_get, Tuple{e, 3}}, m}}},
            Apply{array_set, Tuple{e, 2, Apply{array_get, Tuple{nb, j}}}},
            Apply{array_set, Tuple{nb, j, e}},
            Set{e, next}}},
        Set{i, Apply{_add, Tuple{i, 1}}}}},
    Apply{array_set, Tuple{t, 0, nb}}}}}

Def{table_set, Lambda{Tuple{Table{t}, k, v}, Do{
    Def{h, Apply{hash, Tuple{k}}},
    Def{e, Apply{table_find, Tuple{t, k, h}}},
    If{Apply{_eq, Tuple{e, none}}, Do{
        Def{b, Apply{array_get, Tuple{t, 0}}},
        Def{i, Apply{_mod, Tuple{h, Apply{array_len, Tuple{b}}}}},
        Def{n, Apply{array, Tuple{4}}},
        Apply{array_set, Tuple{n, 0, k}},
        Apply{array_set, Tuple{n, 1, v}},
        Apply{array_set, Tuple{n, 2, Apply{array_get, Tuple{b, i}}}},
        Apply{array_set, Tuple{n, 3, h}},
        Apply{array_set, Tuple{b, i, n}},
        Def{c, Apply{_add, Tuple{Apply{array_get, Tuple{t, 1}}, 1}}},
        Apply{array_set, Tuple{t, 1, c}},
        If{Apply{_gt, Tuple{c, Apply{array_len, Tuple{b}}}}, Apply{table_grow, Tuple{t}}, none}},
        Apply{array_set, Tuple{e, 1, v}}},
    v}}}

" === Loading files === "
" load(path) parses and evaluates the file by the current parse and eval. "
" The top-level definitions of the file are made while path is the file being loaded. "
Def{load, Lambda{Tuple{path}, Do{
    Def{s, Apply{read_file, Tuple{path}}},
    Def{prev, Apply{_set_file, Tuple{path}}},
    Def{r, none},
    Def{e, none},
    Def{go, true},
    While{go, Do{
        Set{r, Apply{parse, Tuple{s}}},
        Set{e, Apply{arg, Tuple{r, 0}}},
        If{Apply{_eq, Tuple{e, Eof{}}}, Set{go, false},
        If{If{Apply{_eq, Tuple{Apply{type, Tuple{e}}, Expr}}, Apply{_eq, Tuple{Apply{head, Tuple{e}}, Quote{SyntaxError}}}, false},
            Do{
                Apply{put, Tuple{path}},
                Apply{put, Tuple{": syntax error: "}},
                Apply{println, Tuple{e}},
                Apply{exit, Tuple{1}}},
            Do{
                Apply{eval, Tuple{e}},
                Set{s, Apply{arg, Tuple{r, 1}}}}}}}},
    Apply{_set_file, Tuple{prev}},
    none}}}

" === Syntax === "
" planck/syntax.pk replaces parse. The files after it are read by the new syntax. "
Apply{load, Tuple{"planck/peg.pk"}}
Apply{load, Tuple{"planck/syntax.pk"}}

" planck/lib/use.pk defines use(name), which loads planck/lib/<name>.pk once. It is written in the syntax above. "
Apply{load, Tuple{"planck/lib/use.pk"}}
