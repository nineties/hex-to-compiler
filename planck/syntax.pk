" Syntax of planck "
" Copyright (C) 2026 nineties "

" The grammar is defined with the packrat parser of planck/peg.pk, "
" and then parse is replaced. The trees are the m-exprs that eval takes, "
" e.g. a + b is Apply{add, Tuple{a, b}}. M-expressions are a part of the syntax. "

" === Tokens === "

Def{peg_reserved, Apply{table, Tuple{}}}
Apply{table_set, Tuple{peg_reserved, "if", true}}
Apply{table_set, Tuple{peg_reserved, "else", true}}
Apply{table_set, Tuple{peg_reserved, "while", true}}
Apply{table_set, Tuple{peg_reserved, "and", true}}
Apply{table_set, Tuple{peg_reserved, "or", true}}
Apply{table_set, Tuple{peg_reserved, "handle", true}}
Apply{table_set, Tuple{peg_reserved, "with", true}}
Apply{table_set, Tuple{peg_reserved, "perform", true}}
Apply{table_set, Tuple{peg_reserved, "match", true}}
Apply{table_set, Tuple{peg_reserved, "record", true}}
Apply{table_set, Tuple{peg_reserved, "for", true}}
Apply{table_set, Tuple{peg_reserved, "in", true}}
Apply{table_set, Tuple{peg_reserved, "return", true}}
Apply{table_set, Tuple{peg_reserved, "break", true}}

" identifier: [A-Za-z_][A-Za-z0-9_]* except the peg_reserved words "
Def{peg_tok_ident, Lambda{Tuple{p}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, Apply{peg_inc, Tuple{p}}},
    Def{name, ""},
    If{Apply{peg_is_alpha, Tuple{Apply{peg_char_at, Tuple{p}}}}, Do{
        While{Apply{peg_is_alnum, Tuple{Apply{peg_char_at, Tuple{q}}}}, Set{q, Apply{peg_inc, Tuple{q}}}},
        Set{name, Apply{substr, Tuple{peg_src, p, q}}},
        If{Apply{table_get, Tuple{peg_reserved, name, false}},
            Apply{peg_fail, Tuple{p}},
            Do{Set{peg_pv, Apply{intern, Tuple{name}}}, q}}},
        Apply{peg_fail, Tuple{p}}}}}}

Def{peg_digit_value, Lambda{Tuple{c},
    If{Apply{peg_is_digit, Tuple{c}}, Apply{sub, Tuple{c, 48}},
    If{If{Apply{le, Tuple{97, c}}, Apply{le, Tuple{c, 102}}, false}, Apply{sub, Tuple{c, 87}},
    If{If{Apply{le, Tuple{65, c}}, Apply{le, Tuple{c, 70}}, false}, Apply{sub, Tuple{c, 55}},
        99}}}}}

" integer: -?[0-9]+, 0x.., 0o.., 0b.. "
Def{peg_tok_int, Lambda{Tuple{p}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, p},
    Def{sign, 1},
    Def{base, 10},
    Def{v, 0},
    Def{d, 0},
    If{If{Apply{eq, Tuple{Apply{peg_char_at, Tuple{q}}, 45}}, Apply{peg_is_digit, Tuple{Apply{peg_char_at, Tuple{Apply{peg_inc, Tuple{q}}}}}}, false},
        Do{Set{sign, -1}, Set{q, Apply{peg_inc, Tuple{q}}}}, none},
    If{Apply{peg_is_digit, Tuple{Apply{peg_char_at, Tuple{q}}}}, Do{
        If{Apply{eq, Tuple{Apply{peg_char_at, Tuple{q}}, 48}}, Do{
            Set{d, Apply{peg_char_at, Tuple{Apply{peg_inc, Tuple{q}}}}},
            If{If{Apply{eq, Tuple{d, 120}}, true, Apply{eq, Tuple{d, 88}}}, Set{base, 16},
            If{If{Apply{eq, Tuple{d, 111}}, true, Apply{eq, Tuple{d, 79}}}, Set{base, 8},
            If{If{Apply{eq, Tuple{d, 98}}, true, Apply{eq, Tuple{d, 66}}}, Set{base, 2}, none}}},
            If{Apply{ne, Tuple{base, 10}}, Set{q, Apply{add, Tuple{q, 2}}}, none}}, none},
        Set{d, Apply{peg_digit_value, Tuple{Apply{peg_char_at, Tuple{q}}}}},
        While{Apply{lt, Tuple{d, base}}, Do{
            Set{v, Apply{add, Tuple{Apply{mul, Tuple{v, base}}, d}}},
            Set{q, Apply{peg_inc, Tuple{q}}},
            Set{d, Apply{peg_digit_value, Tuple{Apply{peg_char_at, Tuple{q}}}}}}},
        Set{peg_pv, Apply{mul, Tuple{sign, v}}},
        q},
        Apply{peg_fail, Tuple{p}}}}}}

Def{peg_escapes, Apply{table, Tuple{}}}
Apply{table_set, Tuple{peg_escapes, 97, "\a"}}
Apply{table_set, Tuple{peg_escapes, 98, "\b"}}
Apply{table_set, Tuple{peg_escapes, 116, "\t"}}
Apply{table_set, Tuple{peg_escapes, 110, "\n"}}
Apply{table_set, Tuple{peg_escapes, 118, "\v"}}
Apply{table_set, Tuple{peg_escapes, 102, "\f"}}
Apply{table_set, Tuple{peg_escapes, 114, "\r"}}
Apply{table_set, Tuple{peg_escapes, 34, "\""}}
Apply{table_set, Tuple{peg_escapes, 39, "'"}}
Apply{table_set, Tuple{peg_escapes, 92, "\\"}}

" string: \"...\" with the peg_escapes above, in one line "
Def{peg_tok_str, Lambda{Tuple{p}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, Apply{peg_inc, Tuple{p}}},
    Def{start, q},
    Def{acc, ""},
    Def{c, Apply{peg_char_at, Tuple{q}}},
    Def{e, none},
    If{Apply{ne, Tuple{Apply{peg_char_at, Tuple{p}}, 34}}, Apply{peg_fail, Tuple{p}}, Do{
        While{If{Apply{ne, Tuple{c, 34}}, If{Apply{ne, Tuple{c, 10}}, Apply{ge, Tuple{c, 0}}, false}, false}, Do{
            If{Apply{eq, Tuple{c, 92}}, Do{
                Set{e, Apply{table_get, Tuple{peg_escapes, Apply{peg_char_at, Tuple{Apply{peg_inc, Tuple{q}}}}, none}}},
                If{Apply{eq, Tuple{e, none}}, Do{Set{c, -1}, Set{q, Apply{peg_fail, Tuple{q}}}}, Do{
                    Set{acc, Apply{strcat, Tuple{acc, Apply{substr, Tuple{peg_src, start, q}}}}},
                    Set{acc, Apply{strcat, Tuple{acc, e}}},
                    Set{q, Apply{add, Tuple{q, 2}}},
                    Set{start, q}}}},
                Set{q, Apply{peg_inc, Tuple{q}}}},
            If{Apply{ge, Tuple{c, 0}}, Set{c, Apply{peg_char_at, Tuple{q}}}, none}}},
        If{Apply{eq, Tuple{c, 34}},
            Do{
                Set{peg_pv, Apply{strcat, Tuple{acc, Apply{substr, Tuple{peg_src, start, q}}}}},
                Apply{peg_inc, Tuple{q}}},
            Apply{peg_fail, Tuple{q}}}}}}}}

" 'word in a grammar: Key{\"word\"} "
Def{peg_tok_keyword, Lambda{Tuple{p}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, Apply{peg_inc, Tuple{p}}},
    If{If{Apply{eq, Tuple{Apply{peg_char_at, Tuple{p}}, 39}}, Apply{peg_is_alpha, Tuple{Apply{peg_char_at, Tuple{q}}}}, false}, Do{
        While{Apply{peg_is_alnum, Tuple{Apply{peg_char_at, Tuple{q}}}}, Set{q, Apply{peg_inc, Tuple{q}}}},
        Set{peg_pv, Key{Apply{substr, Tuple{peg_src, Apply{peg_inc, Tuple{p}}, q}}}},
        q},
        Apply{peg_fail, Tuple{p}}}}}}

Apply{define_rule, Tuple{Quote{ident}, peg_tok_ident}}
Apply{define_rule, Tuple{Quote{integer}, peg_tok_int}}
Apply{define_rule, Tuple{Quote{string}, peg_tok_str}}
Apply{define_rule, Tuple{Quote{keyword}, peg_tok_keyword}}

" === Actions === "

" (a, op, b) -> op(a, b) "
Def{peg_binop, Lambda{Tuple{f},
    Lambda{Tuple{Tuple{a, _, b}}, QuasiQuote{Apply{UnQuote{f}, Tuple{UnQuote{a}, UnQuote{b}}}}}}}

Def{peg_first, Lambda{Tuple{t}, Apply{arg, Tuple{t, 0}}}}

" Tuple{a, b, c} -> Cons{a, Cons{b, Cons{c, Nil{}}}} "
Def{peg_to_list, Lambda{Tuple{t}, Do{
    Def{i, Apply{arity, Tuple{t}}},
    Def{r, Quote{Nil{}}},
    While{Apply{gt, Tuple{i, 0}}, Do{
        Set{i, Apply{sub, Tuple{i, 1}}},
        Set{r, QuasiQuote{Cons{UnQuote{Apply{arg, Tuple{t, i}}}, UnQuote{r}}}}}},
    r}}}

" === Expressions === "
" from the loosest: definition and assignment, | , ->, ?:, or, and, not, "
" comparison, ::, + -, * / %, unary - ' ` !, call and @, primary "

" a top-level expression ends with ; or a newline, or another expression follows "
Apply{define_rule, Tuple{Quote{toplevel}, Quote{
    Act{Seq{expr, Choice{";", Not{Same{}}, And{expr}}}, peg_first}}}}

Apply{define_rule, Tuple{Quote{expr}, Quote{Choice{
    syntax_decl,
    Act{Seq{ident, Tight{"("}, Delimited{pattern, ","}, ")", ":=", expr},
        Lambda{Tuple{Tuple{f, _, ps, _, _, e}}, QuasiQuote{Def{UnQuote{f}, UnQuote{Apply{peg_lambda, Tuple{ps, e}}}}}}},
    Act{Seq{ident, ":=", expr},
        Lambda{Tuple{Tuple{x, _, e}}, QuasiQuote{Def{UnQuote{x}, UnQuote{e}}}}},
    Act{Seq{ident, "=", Not{Tight{"="}}, expr},
        Lambda{Tuple{Tuple{x, _, _, e}}, QuasiQuote{Set{UnQuote{x}, UnQuote{e}}}}},
    union}}}}

Apply{define_rule, Tuple{Quote{union}, Quote{Choice{
    Act{Seq{arrow, "|", union},
        Lambda{Tuple{Tuple{f, _, g}}, QuasiQuote{Fusion{UnQuote{f}, UnQuote{g}}}}},
    arrow}}}}

Apply{define_rule, Tuple{Quote{params}, Quote{Choice{
    Act{Seq{"(", Delimited{pattern, ","}, ")"}, Lambda{Tuple{Tuple{_, ps, _}}, ps}},
    Act{pattern, Lambda{Tuple{x}, Tuple{x}}}}}}}

Apply{define_rule, Tuple{Quote{arrow}, Quote{Choice{
    Act{Seq{params, "->", arrow},
        Lambda{Tuple{Tuple{ps, _, e}}, Apply{peg_lambda, Tuple{ps, e}}}},
    ternary}}}}

Apply{define_rule, Tuple{Quote{ternary}, Quote{Choice{
    Act{Seq{or_expr, "?", or_expr, ":", ternary},
        Lambda{Tuple{Tuple{c, _, a, _, b}}, QuasiQuote{If{UnQuote{c}, UnQuote{a}, UnQuote{b}}}}},
    or_expr}}}}

Apply{define_rule, Tuple{Quote{or_expr}, Quote{Choice{
    Act{Seq{and_expr, Key{"or"}, or_expr},
        Lambda{Tuple{Tuple{a, _, b}}, QuasiQuote{If{UnQuote{a}, true, UnQuote{b}}}}},
    and_expr}}}}

Apply{define_rule, Tuple{Quote{and_expr}, Quote{Choice{
    Act{Seq{not_expr, Key{"and"}, and_expr},
        Lambda{Tuple{Tuple{a, _, b}}, QuasiQuote{If{UnQuote{a}, UnQuote{b}, false}}}},
    not_expr}}}}

Apply{define_rule, Tuple{Quote{not_expr}, Quote{Choice{
    Act{Seq{Key{"not"}, not_expr},
        Lambda{Tuple{Tuple{_, a}}, QuasiQuote{Apply{not, Tuple{UnQuote{a}}}}}},
    rel_expr}}}}

Apply{define_rule, Tuple{Quote{rel_expr}, Quote{Choice{
    Act{Seq{cons_expr, "==", cons_expr}, Apply{peg_binop, Tuple{Quote{eq}}}},
    Act{Seq{cons_expr, "!=", cons_expr}, Apply{peg_binop, Tuple{Quote{ne}}}},
    Act{Seq{cons_expr, "<=", cons_expr}, Apply{peg_binop, Tuple{Quote{le}}}},
    Act{Seq{cons_expr, ">=", cons_expr}, Apply{peg_binop, Tuple{Quote{ge}}}},
    Act{Seq{cons_expr, "<", cons_expr}, Apply{peg_binop, Tuple{Quote{lt}}}},
    Act{Seq{cons_expr, ">", cons_expr}, Apply{peg_binop, Tuple{Quote{gt}}}},
    cons_expr}}}}

" x :: xs is Cons{x, xs}. It groups to the right. "
Apply{define_rule, Tuple{Quote{cons_expr}, Quote{Choice{
    Act{Seq{add_expr, "::", cons_expr},
        Lambda{Tuple{Tuple{a, _, b}}, QuasiQuote{Cons{UnQuote{a}, UnQuote{b}}}}},
    add_expr}}}}

" a binary - must be on the same line as its left operand "
Apply{define_rule, Tuple{Quote{minus}, Quote{Seq{Same{}, "-", Not{Tight{">"}}}}}}

Apply{define_rule, Tuple{Quote{add_expr}, Quote{Choice{
    Act{Seq{add_expr, "+", mul_expr}, Apply{peg_binop, Tuple{Quote{add}}}},
    Act{Seq{add_expr, minus, mul_expr}, Apply{peg_binop, Tuple{Quote{sub}}}},
    mul_expr}}}}

Apply{define_rule, Tuple{Quote{mul_expr}, Quote{Choice{
    Act{Seq{mul_expr, "*", unary}, Apply{peg_binop, Tuple{Quote{mul}}}},
    Act{Seq{mul_expr, "/", unary}, Apply{peg_binop, Tuple{Quote{div}}}},
    Act{Seq{mul_expr, "%", unary}, Apply{peg_binop, Tuple{Quote{mod}}}},
    unary}}}}

Apply{define_rule, Tuple{Quote{unary}, Quote{Choice{
    postfix,
    Act{Seq{"-", unary},
        Lambda{Tuple{Tuple{_, a}}, QuasiQuote{Apply{sub, Tuple{0, UnQuote{a}}}}}},
    Act{Seq{"'", unary},
        Lambda{Tuple{Tuple{_, a}}, Apply{mexpr, Tuple{Quote{Quote}, Tuple{a}}}}},
    Act{Seq{"`", unary},
        Lambda{Tuple{Tuple{_, a}}, Apply{mexpr, Tuple{Quote{QuasiQuote}, Tuple{a}}}}},
    Act{Seq{"!", unary},
        Lambda{Tuple{Tuple{_, a}}, Apply{mexpr, Tuple{Quote{UnQuote}, Tuple{a}}}}}}}}}

" parameters of functions: x :: xs is a pattern too "
Apply{define_rule, Tuple{Quote{pattern}, Quote{Choice{
    Act{Seq{unary, "::", pattern},
        Lambda{Tuple{Tuple{a, _, b}}, QuasiQuote{Cons{UnQuote{a}, UnQuote{b}}}}},
    unary}}}}

Apply{define_rule, Tuple{Quote{postfix}, Quote{Choice{
    Act{Seq{postfix, Tight{"("}, Delimited{expr, ","}, ")"},
        Lambda{Tuple{Tuple{f, _, args, _}}, QuasiQuote{Apply{UnQuote{f}, UnQuote{args}}}}},
    Act{Seq{postfix, "@", ident},
        Lambda{Tuple{Tuple{x, _, t}}, QuasiQuote{_TypeOf{UnQuote{x}, UnQuote{t}}}}},
    primary}}}}

Apply{define_rule, Tuple{Quote{block}, Quote{
    Act{Seq{"{", Many{Seq{expr, Option{";"}}}, "}"},
        Lambda{Tuple{Tuple{_, es, _}}, Apply{mexpr, Tuple{Quote{Do}, Apply{peg_map_args, Tuple{peg_first, es}}}}}}}}}

" the condition is in parentheses, the body is any expression. "
" else belongs to the nearest if, since the body takes it first. "
Apply{define_rule, Tuple{Quote{if_expr}, Quote{
    Act{Seq{Key{"if"}, "(", expr, ")", expr, Option{Seq{Key{"else"}, expr}}},
        Fusion{
            Lambda{Tuple{Tuple{_, _, c, _, a, Tuple{}}}, QuasiQuote{If{UnQuote{c}, UnQuote{a}, none}}},
            Lambda{Tuple{Tuple{_, _, c, _, a, Tuple{Tuple{_, b}}}}, QuasiQuote{If{UnQuote{c}, UnQuote{a}, UnQuote{b}}}}}}}}}

Apply{define_rule, Tuple{Quote{primary}, Quote{Choice{
    if_expr,
    Act{Seq{Key{"while"}, "(", expr, ")", expr},
        Lambda{Tuple{Tuple{_, _, c, _, b}}, Apply{peg_while, Tuple{c, b}}}},
    Act{Seq{Key{"handle"}, expr, Key{"with"}, union},
        Lambda{Tuple{Tuple{_, b, _, h}}, QuasiQuote{Handle{UnQuote{b}, UnQuote{h}}}}},
    Act{Seq{Key{"perform"}, unary},
        Lambda{Tuple{Tuple{_, v}}, QuasiQuote{Perform{UnQuote{v}}}}},
    block,
    Act{Seq{ident, Tight{"{"}, Delimited{expr, ","}, "}"},
        Lambda{Tuple{Tuple{h, _, args, _}}, Apply{mexpr, Tuple{h, args}}}},
    ident,
    integer,
    string,
    Act{Seq{"(", ")"}, Lambda{Tuple{_}, Quote{Tuple{}}}},
    Act{Seq{"(", Delimited1{expr, ","}, ")"},
        Lambda{Tuple{Tuple{_, es, _}}, If{Apply{eq, Tuple{Apply{arity, Tuple{es}}, 1}}, Apply{peg_first, Tuple{es}}, es}}},
    Act{Seq{"[", Delimited{expr, ","}, "]"},
        Lambda{Tuple{Tuple{_, es, _}}, Apply{peg_to_list, Tuple{es}}}}}}}}

" === Grammar declarations === "
" name ::= alt | alt ...  defines the rule. ... stands for the previous definition. "
" An alternative is a sequence of items and an optional action { ... }. "
" An item is label:element or element, and must be on the same line. "
" The action is a block, and the labels are its variables. "

Apply{define_rule, Tuple{Quote{syntax_decl}, Quote{
    Act{Seq{ident, "::=", g_choice},
        Lambda{Tuple{Tuple{n, _, e}},
            QuasiQuote{Apply{define_rule, Tuple{UnQuote{Apply{mexpr, Tuple{Quote{Quote}, Tuple{n}}}},
                                                UnQuote{Apply{mexpr, Tuple{Quote{Quote}, Tuple{e}}}}}}}}}}}}

Apply{define_rule, Tuple{Quote{g_choice}, Quote{
    Act{Delimited1{g_alt, "|"},
        Lambda{Tuple{es}, If{Apply{eq, Tuple{Apply{arity, Tuple{es}}, 1}}, Apply{peg_first, Tuple{es}},
            Apply{mexpr, Tuple{Quote{Choice}, es}}}}}}}}

Apply{define_rule, Tuple{Quote{g_alt}, Quote{Choice{
    Act{"...", Lambda{Tuple{_}, Quote{Prev{}}}},
    Act{Seq{Many1{g_item}, Option{Seq{Same{}, block}}},
        Lambda{Tuple{Tuple{items, act}}, Do{
            Def{labels, Apply{peg_map_args, Tuple{peg_first, items}}},
            Def{elems, Apply{peg_map_args, Tuple{Lambda{Tuple{t}, Apply{arg, Tuple{t, 1}}}, items}}},
            Def{seq, Apply{mexpr, Tuple{Quote{Seq}, elems}}},
            If{Apply{eq, Tuple{act, Tuple{}}},
                If{Apply{eq, Tuple{Apply{arity, Tuple{elems}}, 1}}, Apply{peg_first, Tuple{elems}}, seq},
                QuasiQuote{Act{UnQuote{seq},
                    Lambda{Tuple{UnQuote{labels}}, UnQuote{Apply{arg, Tuple{Apply{peg_first, Tuple{act}}, 1}}}}}}}}}}}}}}

Apply{define_rule, Tuple{Quote{g_item}, Quote{Choice{
    Act{Seq{Same{}, ident, Tight{":"}, g_suffix},
        Lambda{Tuple{Tuple{_, l, _, e}}, Tuple{l, e}}},
    Act{Seq{Same{}, g_suffix},
        Lambda{Tuple{Tuple{_, e}}, Tuple{Quote{_}, e}}}}}}}

Apply{define_rule, Tuple{Quote{g_suffix}, Quote{Choice{
    Act{Seq{g_primary, Tight{"*"}}, Lambda{Tuple{Tuple{e, _}}, Many{e}}},
    Act{Seq{g_primary, Tight{"+"}}, Lambda{Tuple{Tuple{e, _}}, Many1{e}}},
    Act{Seq{g_primary, Tight{"?"}}, Lambda{Tuple{Tuple{e, _}}, Option{e}}},
    Act{Seq{"&", g_primary}, Lambda{Tuple{Tuple{_, e}}, And{e}}},
    Act{Seq{"!", g_primary}, Lambda{Tuple{Tuple{_, e}}, Not{e}}},
    g_primary}}}}

Apply{define_rule, Tuple{Quote{g_primary}, Quote{Choice{
    string,
    keyword,
    Act{Seq{ident, Not{Choice{"::=", Tight{":"}}}}, peg_first},
    Act{Seq{"(", g_choice, ")"}, Lambda{Tuple{Tuple{_, e, _}}, e}}}}}}

" === Sugar === "

" Rules and functions of the syntax sugar. The rules call the functions peg_* in their actions. "

" the decimal text of an integer "

Def{
    peg_itoa,
    Lambda{
        Tuple{n},
        If{
            Apply{lt, Tuple{n, 0}},
            Apply{strcat, Tuple{"-", Apply{peg_itoa, Tuple{Apply{sub, Tuple{0, n}}}}}},
            If{
                Apply{lt, Tuple{n, 10}},
                Apply{substr, Tuple{"0123456789", n, Apply{add, Tuple{n, 1}}}},
                Apply{
                    strcat,
                    Tuple{
                        Apply{peg_itoa, Tuple{Apply{div, Tuple{n, 10}}}},
                        Apply{peg_itoa, Tuple{Apply{mod, Tuple{n, 10}}}}
                    }
                }
            }
        }
    }}

Def{
    peg_arm_lambda,
    Lambda{
        Tuple{a},
        QuasiQuote{Lambda{Tuple{UnQuote{Apply{arg, Tuple{a, 0}}}}, UnQuote{Apply{arg, Tuple{a, 2}}}}}
    }}

Def{peg_arm_guarded, Lambda{Tuple{a}, Apply{gt, Tuple{Apply{arity, Tuple{Apply{arg, Tuple{a, 1}}}}, 0}}}}

Def{peg_arm_guard, Lambda{Tuple{a}, Apply{arg, Tuple{Apply{arg, Tuple{Apply{arg, Tuple{a, 1}}, 0}}, 1}}}}

Def{
    peg_match,
    Lambda{
        Tuple{s, arms},
        Do{
            Def{n, Apply{arity, Tuple{arms}}},
            Def{guarded, false},
            Def{i, 0},
            While{
                Apply{lt, Tuple{i, n}},
                Do{
                    If{Apply{peg_arm_guarded, Tuple{Apply{arg, Tuple{arms, i}}}}, Set{guarded, true}, none},
                    Set{i, Apply{add, Tuple{i, 1}}}
                }
            },
            If{
                Apply{not, Tuple{guarded}},
                Do{
                    Def{f, Apply{peg_arm_lambda, Tuple{Apply{arg, Tuple{arms, Apply{sub, Tuple{n, 1}}}}}}},
                    Set{i, Apply{sub, Tuple{n, 2}}},
                    While{
                        Apply{ge, Tuple{i, 0}},
                        Do{
                            Set{
                                f,
                                QuasiQuote{
                                    Fusion{
                                        UnQuote{Apply{peg_arm_lambda, Tuple{Apply{arg, Tuple{arms, i}}}}},
                                        UnQuote{f}
                                    }
                                }
                            },
                            Set{i, Apply{sub, Tuple{i, 1}}}
                        }
                    },
                    QuasiQuote{Apply{UnQuote{f}, Tuple{UnQuote{s}}}}
                },
                Do{
                    Def{v, Apply{intern, Tuple{"%v"}}},
                    Def{
                        rname,
                        Lambda{
                            Tuple{i},
                            Apply{intern, Tuple{Apply{strcat, Tuple{"%r", Apply{peg_itoa, Tuple{i}}}}}}
                        }
                    },
                    Def{defs, Tuple{QuasiQuote{Def{UnQuote{Apply{rname, Tuple{n}}}, Lambda{Tuple{}, none}}}}},
                    Set{i, Apply{sub, Tuple{n, 1}}},
                    While{
                        Apply{ge, Tuple{i, 0}},
                        Do{
                            Def{a, Apply{arg, Tuple{arms, i}}},
                            Def{
                                body,
                                If{
                                    Apply{peg_arm_guarded, Tuple{a}},
                                    QuasiQuote{
                                        If{
                                            UnQuote{Apply{peg_arm_guard, Tuple{a}}},
                                            UnQuote{Apply{arg, Tuple{a, 2}}},
                                            Apply{
                                                UnQuote{Apply{rname, Tuple{Apply{add, Tuple{i, 1}}}}},
                                                Tuple{UnQuote{v}}
                                            }
                                        }
                                    },
                                    Apply{arg, Tuple{a, 2}}
                                }
                            },
                            Set{
                                defs,
                                Apply{
                                    push,
                                    Tuple{
                                        defs,
                                        QuasiQuote{
                                            Def{
                                                UnQuote{Apply{rname, Tuple{i}}},
                                                Fusion{
                                                    Lambda{
                                                        Tuple{UnQuote{Apply{arg, Tuple{a, 0}}}},
                                                        UnQuote{body}
                                                    },
                                                    UnQuote{Apply{rname, Tuple{Apply{add, Tuple{i, 1}}}}}
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            Set{i, Apply{sub, Tuple{i, 1}}}
                        }
                    },
                    QuasiQuote{
                        Apply{
                            Lambda{
                                Tuple{UnQuote{v}},
                                UnQuote{
                                    Apply{
                                        mexpr,
                                        Tuple{
                                            Quote{Do},
                                            Apply{
                                                push,
                                                Tuple{
                                                    defs,
                                                    QuasiQuote{
                                                        Apply{
                                                            UnQuote{Apply{rname, Tuple{0}}},
                                                            Tuple{UnQuote{v}}
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            Tuple{UnQuote{s}}
                        }
                    }
                }
            }
        }
    }}

Apply{
    define_rule,
    Tuple{
        Quote{match_arm},
        Quote{
            Act{
                Seq{pattern, Option{Seq{Key{"if"}, ternary}}, "->", expr},
                Lambda{Tuple{Tuple{p, g, _, e}}, Do{Tuple{p, g, e}}}
            }
        }
    }}

Apply{
    define_rule,
    Tuple{Quote{match_item}, Quote{Act{Seq{match_arm, Option{";"}}, Lambda{Tuple{Tuple{a, _}}, Do{a}}}}}}

Apply{
    define_rule,
    Tuple{
        Quote{primary},
        Quote{
            Choice{
                Act{
                    Seq{Key{"match"}, ternary, "{", Many1{match_item}, "}"},
                    Lambda{Tuple{Tuple{_, s, _, arms, _}}, Do{Apply{peg_match, Tuple{s, arms}}}}
                },
                Prev{}
            }
        }
    }}

Def{
    to_text,
    Lambda{
        Tuple{x},
        Apply{
            Fusion{
                Lambda{Tuple{_TypeOf{s, string}}, s},
                Fusion{
                    Lambda{Tuple{_TypeOf{n, int}}, Apply{peg_itoa, Tuple{n}}},
                    Lambda{Tuple{_}, Apply{show, Tuple{x}}}
                }
            },
            Tuple{x}
        }
    }}

Def{
    peg_tok_istr_open,
    Lambda{
        Tuple{p},
        Do{
            Set{p, Apply{peg_skip_ws, Tuple{p}}},
            If{
                Apply{ne, Tuple{Apply{peg_char_at, Tuple{p}}, 34}},
                Apply{peg_fail, Tuple{p}},
                Do{
                    Def{q, Apply{add, Tuple{p, 1}}},
                    Def{found, false},
                    Def{go, true},
                    While{
                        go,
                        Do{
                            Def{c, Apply{peg_char_at, Tuple{q}}},
                            If{
                                If{
                                    Apply{eq, Tuple{c, 34}},
                                    true,
                                    If{Apply{lt, Tuple{c, 0}}, true, Apply{eq, Tuple{c, 10}}}
                                },
                                Set{go, false},
                                If{
                                    Apply{eq, Tuple{c, 92}},
                                    Do{
                                        If{
                                            Apply{
                                                eq,
                                                Tuple{Apply{peg_char_at, Tuple{Apply{add, Tuple{q, 1}}}}, 40}
                                            },
                                            Do{Set{found, true}, Set{go, false}},
                                            Set{q, Apply{add, Tuple{q, 2}}}
                                        }
                                    },
                                    Set{q, Apply{add, Tuple{q, 1}}}
                                }
                            }
                        }
                    },
                    If{found, Do{Set{peg_pv, none}, Apply{add, Tuple{p, 1}}}, Apply{peg_fail, Tuple{p}}}
                }
            }
        }
    }}

Def{
    peg_tok_istr_text,
    Lambda{
        Tuple{p},
        Do{
            Def{q, p},
            Def{start, p},
            Def{acc, ""},
            Def{ok, true},
            Def{go, true},
            Def{c, Apply{peg_char_at, Tuple{q}}},
            While{
                go,
                Do{
                    If{
                        If{
                            Apply{eq, Tuple{c, 34}},
                            true,
                            If{Apply{lt, Tuple{c, 0}}, true, Apply{eq, Tuple{c, 10}}}
                        },
                        Set{go, false},
                        If{
                            Apply{eq, Tuple{c, 92}},
                            Do{
                                If{
                                    Apply{eq, Tuple{Apply{peg_char_at, Tuple{Apply{add, Tuple{q, 1}}}}, 40}},
                                    Set{go, false},
                                    Do{
                                        Def{
                                            e,
                                            Apply{
                                                table_get,
                                                Tuple{
                                                    peg_escapes,
                                                    Apply{peg_char_at, Tuple{Apply{add, Tuple{q, 1}}}},
                                                    none
                                                }
                                            }
                                        },
                                        If{
                                            Apply{eq, Tuple{e, none}},
                                            Do{Set{ok, false}, Set{go, false}},
                                            Do{
                                                Set{
                                                    acc,
                                                    Apply{
                                                        strcat,
                                                        Tuple{
                                                            Apply{
                                                                strcat,
                                                                Tuple{
                                                                    acc,
                                                                    Apply{substr, Tuple{peg_src, start, q}}
                                                                }
                                                            },
                                                            e
                                                        }
                                                    }
                                                },
                                                Set{q, Apply{add, Tuple{q, 2}}},
                                                Set{start, q},
                                                Set{c, Apply{peg_char_at, Tuple{q}}}
                                            }
                                        }
                                    }
                                }
                            },
                            Do{Set{q, Apply{add, Tuple{q, 1}}}, Set{c, Apply{peg_char_at, Tuple{q}}}}
                        }
                    }
                }
            },
            If{
                ok,
                Do{Set{peg_pv, Apply{strcat, Tuple{acc, Apply{substr, Tuple{peg_src, start, q}}}}}, q},
                Apply{peg_fail, Tuple{q}}
            }
        }
    }}

Def{
    peg_tok_istr_hole,
    Lambda{
        Tuple{p},
        If{
            If{
                Apply{eq, Tuple{Apply{peg_char_at, Tuple{p}}, 92}},
                Apply{eq, Tuple{Apply{peg_char_at, Tuple{Apply{add, Tuple{p, 1}}}}, 40}},
                false
            },
            Do{Set{peg_pv, "\\("}, Apply{add, Tuple{p, 2}}},
            Apply{peg_fail, Tuple{p}}
        }
    }}

Def{
    peg_tok_istr_close,
    Lambda{
        Tuple{p},
        If{
            Apply{eq, Tuple{Apply{peg_char_at, Tuple{p}}, 34}},
            Do{Set{peg_pv, "\""}, Apply{add, Tuple{p, 1}}},
            Apply{peg_fail, Tuple{p}}
        }
    }}

Def{
    peg_interp,
    Lambda{
        Tuple{parts, last},
        Do{
            Def{acc, none},
            Def{
                seg,
                Lambda{
                    Tuple{x},
                    Set{
                        acc,
                        If{
                            Apply{eq, Tuple{acc, none}},
                            x,
                            QuasiQuote{Apply{strcat, Tuple{UnQuote{acc}, UnQuote{x}}}}
                        }
                    }
                }
            },
            Def{i, 0},
            While{
                Apply{lt, Tuple{i, Apply{arity, Tuple{parts}}}},
                Do{
                    Def{t, Apply{arg, Tuple{Apply{arg, Tuple{parts, i}}, 0}}},
                    If{Apply{ne, Tuple{t, ""}}, Apply{seg, Tuple{t}}, none},
                    Apply{
                        seg,
                        Tuple{
                            QuasiQuote{
                                Apply{
                                    to_text,
                                    Tuple{UnQuote{Apply{arg, Tuple{Apply{arg, Tuple{parts, i}}, 2}}}}
                                }
                            }
                        }
                    },
                    Set{i, Apply{add, Tuple{i, 1}}}
                }
            },
            If{Apply{ne, Tuple{last, ""}}, Apply{seg, Tuple{last}}, none},
            acc
        }
    }}

Apply{define_rule, Tuple{Quote{istr_open}, peg_tok_istr_open}}

Apply{define_rule, Tuple{Quote{istr_text}, peg_tok_istr_text}}

Apply{define_rule, Tuple{Quote{istr_hole}, peg_tok_istr_hole}}

Apply{define_rule, Tuple{Quote{istr_close}, peg_tok_istr_close}}

Apply{
    define_rule,
    Tuple{
        Quote{interp_str},
        Quote{
            Act{
                Seq{istr_open, Many{Seq{istr_text, istr_hole, expr, ")"}}, istr_text, istr_close},
                Lambda{Tuple{Tuple{_, parts, last, _}}, Do{Apply{peg_interp, Tuple{parts, last}}}}
            }
        }
    }}

Apply{define_rule, Tuple{Quote{primary}, Quote{Choice{interp_str, Prev{}}}}}

Def{record_fields, Apply{table, Tuple{}}}

Def{record_declare, Lambda{Tuple{name, fields}, Apply{table_set, Tuple{record_fields, name, fields}}}}

Def{
    record_get,
    Lambda{
        Tuple{t, name},
        Do{
            Def{fs, Apply{table_get, Tuple{record_fields, Apply{head, Tuple{t}}, none}}},
            Def{n, If{Apply{eq, Tuple{fs, none}}, 0, Apply{arity, Tuple{fs}}}},
            Def{i, 0},
            While{
                If{Apply{lt, Tuple{i, n}}, Apply{ne, Tuple{Apply{arg, Tuple{fs, i}}, name}}, false},
                Set{i, Apply{add, Tuple{i, 1}}}
            },
            If{
                Apply{eq, Tuple{i, n}},
                Do{
                    Apply{put, Tuple{"no field "}},
                    Apply{put, Tuple{Apply{symname, Tuple{name}}}},
                    Apply{put, Tuple{" in "}},
                    Apply{println, Tuple{t}},
                    Apply{exit, Tuple{1}}
                },
                none
            },
            Apply{arg, Tuple{t, i}}
        }
    }}

Apply{define_rule, Tuple{Quote{idents}, Quote{Delimited{ident, ","}}}}

Apply{define_rule, Tuple{Quote{tdot}, Quote{Tight{"."}}}}

Apply{
    define_rule,
    Tuple{
        Quote{record_decl},
        Quote{
            Act{
                Seq{Key{"record"}, ident, "(", idents, ")"},
                Lambda{
                    Tuple{Tuple{_, n, _, fs, _}},
                    Do{QuasiQuote{Apply{record_declare, Tuple{Quote{UnQuote{n}}, Quote{UnQuote{fs}}}}}}
                }
            }
        }
    }}

Apply{define_rule, Tuple{Quote{expr}, Quote{Choice{record_decl, Prev{}}}}}

Apply{
    define_rule,
    Tuple{
        Quote{postfix},
        Quote{
            Choice{
                Act{
                    Seq{postfix, tdot, ident},
                    Lambda{
                        Tuple{Tuple{t, _, f}},
                        Do{QuasiQuote{Apply{record_get, Tuple{UnQuote{t}, Quote{UnQuote{f}}}}}}
                    }
                },
                Prev{}
            }
        }
    }}

Def{peg_ret_handler, QuasiQuote{Lambda{Tuple{Return{v}, k}, v}}}

Def{peg_break_handler, QuasiQuote{Lambda{Tuple{Break{}, k}, none}}}

Def{
    peg_catches,
    Lambda{
        Tuple{h, tag},
        If{
            Apply{peg_is_head, Tuple{h, Quote{Lambda}}},
            If{
                Apply{gt, Tuple{Apply{arity, Tuple{Apply{arg, Tuple{h, 0}}}}, 0}},
                Apply{peg_is_head, Tuple{Apply{arg, Tuple{Apply{arg, Tuple{h, 0}}, 0}}, tag}},
                false
            },
            false
        }
    }}

Def{
    peg_scan,
    Lambda{
        Tuple{e, tag},
        Do{
            If{
                Apply{ne, Tuple{Apply{typeof, Tuple{e}}, Quote{mexpr}}},
                false,
                Do{
                    Def{h, Apply{head, Tuple{e}}},
                    If{
                        If{Apply{eq, Tuple{h, Quote{Quote}}}, true, Apply{eq, Tuple{h, Quote{QuasiQuote}}}},
                        false,
                        If{
                            If{
                                Apply{eq, Tuple{h, Quote{Perform}}},
                                If{
                                    Apply{eq, Tuple{Apply{arity, Tuple{e}}, 1}},
                                    Apply{peg_is_head, Tuple{Apply{arg, Tuple{e, 0}}, tag}},
                                    false
                                },
                                false
                            },
                            true,
                            If{
                                If{
                                    Apply{eq, Tuple{h, Quote{Handle}}},
                                    If{
                                        Apply{eq, Tuple{Apply{arity, Tuple{e}}, 2}},
                                        Apply{peg_catches, Tuple{Apply{arg, Tuple{e, 1}}, tag}},
                                        false
                                    },
                                    false
                                },
                                Apply{peg_scan, Tuple{Apply{arg, Tuple{e, 1}}, tag}},
                                Do{
                                    Def{i, 0},
                                    Def{r, false},
                                    While{
                                        If{
                                            Apply{not, Tuple{r}},
                                            Apply{lt, Tuple{i, Apply{arity, Tuple{e}}}},
                                            false
                                        },
                                        Do{
                                            Set{r, Apply{peg_scan, Tuple{Apply{arg, Tuple{e, i}}, tag}}},
                                            Set{i, Apply{add, Tuple{i, 1}}}
                                        }
                                    },
                                    r
                                }
                            }
                        }
                    }
                }
            }
        }
    }}

Def{
    peg_wrap,
    Lambda{
        Tuple{body, tag, handler},
        If{Apply{peg_scan, Tuple{body, tag}}, QuasiQuote{Handle{UnQuote{body}, UnQuote{handler}}}, body}
    }}

Def{
    peg_lambda,
    Lambda{
        Tuple{ps, body},
        QuasiQuote{Lambda{UnQuote{ps}, UnQuote{Apply{peg_wrap, Tuple{body, Quote{Return}, peg_ret_handler}}}}}
    }}

Def{peg_loop, Lambda{Tuple{loop}, Apply{peg_wrap, Tuple{loop, Quote{Break}, peg_break_handler}}}}

Def{peg_while, Lambda{Tuple{c, b}, Apply{peg_loop, Tuple{QuasiQuote{While{UnQuote{c}, UnQuote{b}}}}}}}

Def{
    peg_for_tree,
    Lambda{
        Tuple{x, xs, b},
        Apply{
            peg_loop,
            Tuple{QuasiQuote{Apply{peg_for, Tuple{UnQuote{xs}, Lambda{Tuple{UnQuote{x}}, UnQuote{b}}}}}}
        }
    }}

Def{
    peg_for,
    Lambda{
        Tuple{xs, f},
        Do{
            If{
                Apply{eq, Tuple{Apply{typeof, Tuple{xs}}, Quote{array}}},
                Do{
                    Def{i, 0},
                    While{
                        Apply{lt, Tuple{i, Apply{array_get, Tuple{xs, 1}}}},
                        Do{
                            Apply{f, Tuple{Apply{array_get, Tuple{Apply{array_get, Tuple{xs, 0}}, i}}}},
                            Set{i, Apply{add, Tuple{i, 1}}}
                        }
                    }
                },
                Do{
                    While{
                        Apply{eq, Tuple{Apply{head, Tuple{xs}}, Quote{Cons}}},
                        Do{Apply{f, Tuple{Apply{arg, Tuple{xs, 0}}}}, Set{xs, Apply{arg, Tuple{xs, 1}}}}
                    }
                }
            },
            none
        }
    }}

Apply{define_rule, Tuple{Quote{same}, Quote{Same{}}}}

Apply{
    define_rule,
    Tuple{
        Quote{return_expr},
        Quote{
            Act{
                Seq{Key{"return"}, Option{Seq{same, expr}}},
                Lambda{
                    Tuple{Tuple{_, v}},
                    Do{
                        If{
                            Apply{eq, Tuple{Apply{arity, Tuple{v}}, 0}},
                            QuasiQuote{Perform{Return{none}}},
                            QuasiQuote{
                                Perform{Return{UnQuote{Apply{arg, Tuple{Apply{arg, Tuple{v, 0}}, 1}}}}}
                            }
                        }
                    }
                }
            }
        }
    }}

Apply{
    define_rule,
    Tuple{
        Quote{break_expr},
        Quote{Act{Seq{Key{"break"}}, Lambda{Tuple{Tuple{_}}, Do{QuasiQuote{Perform{Break{}}}}}}}
    }}

Apply{
    define_rule,
    Tuple{
        Quote{for_expr},
        Quote{
            Act{
                Seq{Key{"for"}, "(", pattern, Key{"in"}, expr, ")", expr},
                Lambda{Tuple{Tuple{_, _, x, _, xs, _, b}}, Do{Apply{peg_for_tree, Tuple{x, xs, b}}}}
            }
        }
    }}

Apply{define_rule, Tuple{Quote{primary}, Quote{Choice{return_expr, break_expr, for_expr, Prev{}}}}}

" === Switch to the new syntax === "
Def{parse_mexpr, parse}
Def{parse, Lambda{Tuple{s}, Apply{peg_parse, Tuple{Quote{toplevel}, s}}}}

