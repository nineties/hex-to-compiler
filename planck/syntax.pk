" Syntax of planck "
" Copyright (C) 2026 nineties "

" The grammar is defined with the packrat parser of planck/peg.pk. The trees are the m-exprs "
" that eval takes, e.g. a + b is Apply{_add, Tuple{a, b}}. M-expressions are a part of the syntax. "
" The file has three parts. The tokens, the functions that the actions call and the grammar of the grammar "
" (name ::= ...) are written in m-exprs. parse is replaced in the middle of the file, by the smallest syntax "
" that an action needs. The rest of the file is read by it, and the syntax of planck is declared with ::=. "

" === Tokens === "

Def{peg_reserved, Apply{table_new, Tuple{}}}
Apply{table_set, Tuple{peg_reserved, "if", true}}
Apply{table_set, Tuple{peg_reserved, "else", true}}
Apply{table_set, Tuple{peg_reserved, "while", true}}
Apply{table_set, Tuple{peg_reserved, "and", true}}
Apply{table_set, Tuple{peg_reserved, "or", true}}
Apply{table_set, Tuple{peg_reserved, "handle", true}}
Apply{table_set, Tuple{peg_reserved, "with", true}}
Apply{table_set, Tuple{peg_reserved, "perform", true}}
Apply{table_set, Tuple{peg_reserved, "match", true}}
Apply{table_set, Tuple{peg_reserved, "record", true}}
Apply{table_set, Tuple{peg_reserved, "for", true}}
Apply{table_set, Tuple{peg_reserved, "in", true}}
Apply{table_set, Tuple{peg_reserved, "return", true}}
Apply{table_set, Tuple{peg_reserved, "break", true}}
Apply{table_set, Tuple{peg_reserved, "continue", true}}
Apply{table_set, Tuple{peg_reserved, "fun", true}}
Apply{table_set, Tuple{peg_reserved, "module", true}}
Apply{table_set, Tuple{peg_reserved, "export", true}}
Apply{table_set, Tuple{peg_reserved, "macro", true}}

" identifier: [A-Za-z_][A-Za-z0-9_]* except the peg_reserved words and the f of f\"...\" "
Def{peg_tok_ident, Lambda{Tuple{p}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, Apply{peg_inc, Tuple{p}}},
    Def{name, ""},
    If{Apply{peg_is_alpha, Tuple{Apply{peg_char_at, Tuple{p}}}}, Do{
        While{Apply{peg_is_alnum, Tuple{Apply{peg_char_at, Tuple{q}}}}, Set{q, Apply{peg_inc, Tuple{q}}}},
        Set{name, Apply{substr, Tuple{peg_src, p, q}}},
        If{If{Apply{table_get, Tuple{peg_reserved, name, false}}, true,
              If{Apply{_eq, Tuple{q, Apply{_add, Tuple{p, 1}}}},
                 If{Apply{_eq, Tuple{Apply{peg_char_at, Tuple{p}}, 102}}, Apply{_eq, Tuple{Apply{peg_char_at, Tuple{q}}, 34}}, false},
                 false}},
            Apply{peg_fail, Tuple{p}},
            Do{Set{peg_pv, Apply{intern, Tuple{name}}}, q}}},
        Apply{peg_fail, Tuple{p}}}}}}

Def{peg_digit_value, Lambda{Tuple{c},
    If{Apply{peg_is_digit, Tuple{c}}, Apply{_sub, Tuple{c, 48}},
    If{If{Apply{_le, Tuple{97, c}}, Apply{_le, Tuple{c, 102}}, false}, Apply{_sub, Tuple{c, 87}},
    If{If{Apply{_le, Tuple{65, c}}, Apply{_le, Tuple{c, 70}}, false}, Apply{_sub, Tuple{c, 55}},
        99}}}}}

" integer: -?[0-9]+, 0x.., 0o.., 0b.. "
Def{peg_tok_int, Lambda{Tuple{p}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, p},
    Def{sign, 1},
    Def{base, 10},
    Def{v, 0},
    Def{d, 0},
    If{If{Apply{_eq, Tuple{Apply{peg_char_at, Tuple{q}}, 45}}, Apply{peg_is_digit, Tuple{Apply{peg_char_at, Tuple{Apply{peg_inc, Tuple{q}}}}}}, false},
        Do{Set{sign, -1}, Set{q, Apply{peg_inc, Tuple{q}}}}, none},
    If{Apply{peg_is_digit, Tuple{Apply{peg_char_at, Tuple{q}}}}, Do{
        If{Apply{_eq, Tuple{Apply{peg_char_at, Tuple{q}}, 48}}, Do{
            Set{d, Apply{peg_char_at, Tuple{Apply{peg_inc, Tuple{q}}}}},
            If{If{Apply{_eq, Tuple{d, 120}}, true, Apply{_eq, Tuple{d, 88}}}, Set{base, 16},
            If{If{Apply{_eq, Tuple{d, 111}}, true, Apply{_eq, Tuple{d, 79}}}, Set{base, 8},
            If{If{Apply{_eq, Tuple{d, 98}}, true, Apply{_eq, Tuple{d, 66}}}, Set{base, 2}, none}}},
            If{Apply{_ne, Tuple{base, 10}}, Set{q, Apply{_add, Tuple{q, 2}}}, none}}, none},
        Set{d, Apply{peg_digit_value, Tuple{Apply{peg_char_at, Tuple{q}}}}},
        While{Apply{_lt, Tuple{d, base}}, Do{
            Set{v, Apply{_add, Tuple{Apply{_mul, Tuple{v, base}}, d}}},
            Set{q, Apply{peg_inc, Tuple{q}}},
            Set{d, Apply{peg_digit_value, Tuple{Apply{peg_char_at, Tuple{q}}}}}}},
        Set{peg_pv, Apply{_mul, Tuple{sign, v}}},
        q},
        Apply{peg_fail, Tuple{p}}}}}}

Def{peg_escapes, Apply{table_new, Tuple{}}}
Apply{table_set, Tuple{peg_escapes, 48, "\0"}}
Apply{table_set, Tuple{peg_escapes, 97, "\a"}}
Apply{table_set, Tuple{peg_escapes, 98, "\b"}}
Apply{table_set, Tuple{peg_escapes, 116, "\t"}}
Apply{table_set, Tuple{peg_escapes, 110, "\n"}}
Apply{table_set, Tuple{peg_escapes, 118, "\v"}}
Apply{table_set, Tuple{peg_escapes, 102, "\f"}}
Apply{table_set, Tuple{peg_escapes, 114, "\r"}}
Apply{table_set, Tuple{peg_escapes, 34, "\""}}
Apply{table_set, Tuple{peg_escapes, 39, "'"}}
Apply{table_set, Tuple{peg_escapes, 92, "\\"}}

" string: \"...\" with the peg_escapes above, in one line "
Def{peg_tok_str, Lambda{Tuple{p}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, Apply{peg_inc, Tuple{p}}},
    Def{start, q},
    Def{acc, ""},
    Def{c, Apply{peg_char_at, Tuple{q}}},
    Def{e, none},
    If{Apply{_ne, Tuple{Apply{peg_char_at, Tuple{p}}, 34}}, Apply{peg_fail, Tuple{p}}, Do{
        While{If{Apply{_ne, Tuple{c, 34}}, If{Apply{_ne, Tuple{c, 10}}, Apply{_ge, Tuple{c, 0}}, false}, false}, Do{
            If{Apply{_eq, Tuple{c, 92}}, Do{
                Set{e, Apply{table_get, Tuple{peg_escapes, Apply{peg_char_at, Tuple{Apply{peg_inc, Tuple{q}}}}, none}}},
                If{Apply{_eq, Tuple{e, none}}, Do{Set{c, -1}, Set{q, Apply{peg_fail, Tuple{q}}}}, Do{
                    Set{acc, Apply{_strcat, Tuple{acc, Apply{substr, Tuple{peg_src, start, q}}}}},
                    Set{acc, Apply{_strcat, Tuple{acc, e}}},
                    Set{q, Apply{_add, Tuple{q, 2}}},
                    Set{start, q}}}},
                Set{q, Apply{peg_inc, Tuple{q}}}},
            If{Apply{_ge, Tuple{c, 0}}, Set{c, Apply{peg_char_at, Tuple{q}}}, none}}},
        If{Apply{_eq, Tuple{c, 34}},
            Do{
                Set{peg_pv, Apply{_strcat, Tuple{acc, Apply{substr, Tuple{peg_src, start, q}}}}},
                Apply{peg_inc, Tuple{q}}},
            Apply{peg_fail, Tuple{q}}}}}}}}

" 'word in a grammar: Key{\"word\"} "
Def{peg_tok_keyword, Lambda{Tuple{p}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, Apply{peg_inc, Tuple{p}}},
    If{If{Apply{_eq, Tuple{Apply{peg_char_at, Tuple{p}}, 39}}, Apply{peg_is_alpha, Tuple{Apply{peg_char_at, Tuple{q}}}}, false}, Do{
        While{Apply{peg_is_alnum, Tuple{Apply{peg_char_at, Tuple{q}}}}, Set{q, Apply{peg_inc, Tuple{q}}}},
        Set{peg_pv, Key{Apply{substr, Tuple{peg_src, Apply{peg_inc, Tuple{p}}, q}}}},
        q},
        Apply{peg_fail, Tuple{p}}}}}}

Apply{_define_rule, Tuple{Quote{ident}, peg_tok_ident}}
Apply{_define_rule, Tuple{Quote{integer}, peg_tok_int}}
Apply{_define_rule, Tuple{Quote{string}, peg_tok_str}}
Apply{_define_rule, Tuple{Quote{keyword}, peg_tok_keyword}}

" === Actions === "

Def{peg_first, Lambda{Tuple{t}, Apply{arg, Tuple{t, 0}}}}

" Tuple{a, b, c} -> Cons{a, Cons{b, Cons{c, Nil{}}}} "
Def{peg_to_list, Lambda{Tuple{t}, Do{
    Def{i, Apply{arity, Tuple{t}}},
    Def{r, Quote{Nil{}}},
    While{Apply{_gt, Tuple{i, 0}}, Do{
        Set{i, Apply{_sub, Tuple{i, 1}}},
        Set{r, QuasiQuote{Cons{UnQuote{Apply{arg, Tuple{t, i}}}, UnQuote{r}}}}}},
    r}}}

" === Functions of the syntax sugar === "

" The functions peg_* and the rules of the syntax sugar. They come before the grammar since the actions of its rules call them. "

" the decimal text of an integer "

Def{peg_itoa, none}
Set{peg_itoa,
    Lambda{
        Tuple{n},
        If{
            Apply{_lt, Tuple{n, 0}},
            Apply{_strcat, Tuple{"-", Apply{peg_itoa, Tuple{Apply{_sub, Tuple{0, n}}}}}},
            If{
                Apply{_lt, Tuple{n, 10}},
                Apply{substr, Tuple{"0123456789", n, Apply{_add, Tuple{n, 1}}}},
                Apply{
                    _strcat,
                    Tuple{
                        Apply{peg_itoa, Tuple{Apply{_div, Tuple{n, 10}}}},
                        Apply{peg_itoa, Tuple{Apply{_mod, Tuple{n, 10}}}}
                    }
                }
            }
        }
    }}

" a function that matches no arguments: what follows p if c -> e when no | follows it "

Def{_nomatch, Lambda{Tuple{_TypeOf{_, nomatch}}, none}}

Def{peg_g, Apply{intern, Tuple{"%g"}}}

Def{peg_ret_handler, QuasiQuote{Lambda{Tuple{Return{v}, k}, v}}}

Def{peg_break_handler, QuasiQuote{Lambda{Tuple{Break{}, k}, none}}}

Def{peg_continue_handler, QuasiQuote{Lambda{Tuple{Continue{}, k}, none}}}

Def{
    peg_catches,
    Lambda{
        Tuple{h, tag},
        If{
            Apply{peg_is_head, Tuple{h, Quote{Lambda}}},
            If{
                Apply{_gt, Tuple{Apply{arity, Tuple{Apply{arg, Tuple{h, 0}}}}, 0}},
                Apply{peg_is_head, Tuple{Apply{arg, Tuple{Apply{arg, Tuple{h, 0}}, 0}}, tag}},
                false
            },
            false
        }
    }}

Def{peg_scan, none}
Set{peg_scan,
    Lambda{
        Tuple{e, tag},
        Do{
            If{
                Apply{_ne, Tuple{Apply{typeof, Tuple{e}}, Quote{mexpr}}},
                false,
                Do{
                    Def{h, Apply{head, Tuple{e}}},
                    If{
                        If{Apply{_eq, Tuple{h, Quote{Quote}}}, true, Apply{_eq, Tuple{h, Quote{QuasiQuote}}}},
                        false,
                        If{
                            If{
                                Apply{_eq, Tuple{h, Quote{Perform}}},
                                If{
                                    Apply{_eq, Tuple{Apply{arity, Tuple{e}}, 1}},
                                    Apply{peg_is_head, Tuple{Apply{arg, Tuple{e, 0}}, tag}},
                                    false
                                },
                                false
                            },
                            true,
                            If{
                                If{
                                    Apply{_eq, Tuple{h, Quote{Handle}}},
                                    If{
                                        Apply{_eq, Tuple{Apply{arity, Tuple{e}}, 2}},
                                        Apply{peg_catches, Tuple{Apply{arg, Tuple{e, 1}}, tag}},
                                        false
                                    },
                                    false
                                },
                                Apply{peg_scan, Tuple{Apply{arg, Tuple{e, 1}}, tag}},
                                Do{
                                    Def{i, 0},
                                    Def{r, false},
                                    While{
                                        If{
                                            Apply{_not, Tuple{r}},
                                            Apply{_lt, Tuple{i, Apply{arity, Tuple{e}}}},
                                            false
                                        },
                                        Do{
                                            Set{r, Apply{peg_scan, Tuple{Apply{arg, Tuple{e, i}}, tag}}},
                                            Set{i, Apply{_add, Tuple{i, 1}}}
                                        }
                                    },
                                    r
                                }
                            }
                        }
                    }
                }
            }
        }
    }}

Def{peg_nret, 0}

Def{peg_nbrk, 0}

Def{peg_ncnt, 0}

Def{peg_parse_plain, peg_parse}

Set{
    peg_parse,
    Lambda{
        Tuple{r, s},
        Do{Set{peg_nret, 0}, Set{peg_nbrk, 0}, Set{peg_ncnt, 0}, Apply{peg_parse_plain, Tuple{r, s}}}
    }}

Def{
    peg_wrap,
    Lambda{
        Tuple{body, tag, handler},
        If{Apply{peg_scan, Tuple{body, tag}}, QuasiQuote{Handle{UnQuote{body}, UnQuote{handler}}}, body}
    }}

Def{
    peg_lambda,
    Lambda{
        Tuple{ps, body},
        QuasiQuote{
            Lambda{
                UnQuote{ps},
                UnQuote{
                    If{
                        Apply{_gt, Tuple{peg_nret, 0}},
                        Apply{peg_wrap, Tuple{body, Quote{Return}, peg_ret_handler}},
                        body
                    }
                }
            }
        }
    }}

" Tuple{%v1, ..., %vn} "

Def{
    peg_vars,
    Lambda{
        Tuple{n},
        Do{
            Def{vs, Tuple{}},
            Def{i, 1},
            While{
                Apply{_le, Tuple{i, n}},
                Do{
                    Set{vs, Apply{push, Tuple{vs, Apply{intern, Tuple{Apply{_strcat, Tuple{"%v", Apply{peg_itoa, Tuple{i}}}}}}}}},
                    Set{i, Apply{_add, Tuple{i, 1}}}
                }
            },
            vs
        }
    }}

" (p, ...) if c -> e. The function takes the arguments as %v1, ... and calls %g with them "
" when the parameters do not match or c is false. %g is _nomatch until peg_fuse puts a function there. "

" the parameters ps end with a rest parameter x... "
Def{
    peg_has_rest,
    Lambda{
        Tuple{ps},
        If{
            Apply{_gt, Tuple{Apply{arity, Tuple{ps}}, 0}},
            Do{
                Def{l, Apply{arg, Tuple{ps, Apply{_sub, Tuple{Apply{arity, Tuple{ps}}, 1}}}}},
                If{
                    Apply{_eq, Tuple{Apply{typeof, Tuple{l}}, Quote{mexpr}}},
                    Apply{_eq, Tuple{Apply{head, Tuple{l}}, Quote{_Rest}}},
                    false
                }
            },
            false
        }
    }}

" A function with a guard calls the functions after it with all of its arguments again, so it has no rest parameter: "
" the tree _Rest{ps} that it gives is an error when it is compiled. "
Def{
    peg_guard,
    Lambda{
        Tuple{ps, c, e},
        If{Apply{peg_has_rest, Tuple{ps}}, QuasiQuote{_Rest{UnQuote{ps}}},
        Do{
            Def{vs, Apply{peg_vars, Tuple{Apply{arity, Tuple{ps}}}}},
            Def{f, Apply{peg_lambda, Tuple{ps, QuasiQuote{If{UnQuote{c}, UnQuote{e}, Apply{UnQuote{peg_g}, UnQuote{vs}}}}}}},
            QuasiQuote{
                Apply{
                    Lambda{
                        Tuple{UnQuote{peg_g}},
                        Fusion{
                            Lambda{UnQuote{vs}, Apply{Fusion{UnQuote{f}, UnQuote{peg_g}}, UnQuote{vs}}},
                            UnQuote{peg_g}
                        }
                    },
                    Tuple{_nomatch}
                }
            }
        }}
    }}

" f | g: g goes in the place of the last _nomatch of the functions with a guard in f "

Def{peg_fuse, none}
Set{peg_fuse,
    Fusion{
        Lambda{
            Tuple{Quote{_nomatch}, g},
            g
        },
        Fusion{
            Lambda{
                Tuple{Apply{Lambda{Tuple{k}, Fusion{Lambda{vs, Apply{Fusion{a, k2}, vs2}}, k3}}, Tuple{r}}, g},
                If{
                    Apply{_eq, Tuple{k, peg_g}},
                    QuasiQuote{
                        Apply{
                            Lambda{Tuple{UnQuote{k}}, Fusion{Lambda{UnQuote{vs}, Apply{Fusion{UnQuote{a}, UnQuote{k2}}, UnQuote{vs2}}}, UnQuote{k3}}},
                            Tuple{UnQuote{Apply{peg_fuse, Tuple{r, g}}}}
                        }
                    },
                    QuasiQuote{
                        Fusion{
                            Apply{
                                Lambda{Tuple{UnQuote{k}}, Fusion{Lambda{UnQuote{vs}, Apply{Fusion{UnQuote{a}, UnQuote{k2}}, UnQuote{vs2}}}, UnQuote{k3}}},
                                Tuple{UnQuote{r}}
                            },
                            UnQuote{g}
                        }
                    }
                }
            },
            Fusion{
                Lambda{
                    Tuple{Fusion{a, b}, g},
                    QuasiQuote{Fusion{UnQuote{a}, UnQuote{Apply{peg_fuse, Tuple{b, g}}}}}
                },
                Lambda{Tuple{f, g}, QuasiQuote{Fusion{UnQuote{f}, UnQuote{g}}}}
            }
        }
    }}

" t[f]: when a function in f has a guard, (_ -> '%skip) goes last with peg_fuse, "
" so that a part that no function applies to gives peg_skip and subst goes into its arguments "

Def{peg_skip, Apply{intern, Tuple{"%skip"}}}

Def{peg_guarded, none}
Set{peg_guarded,
    Fusion{
        Lambda{Tuple{Fusion{_, g}}, Apply{peg_guarded, Tuple{g}}},
        Fusion{
            Lambda{
                Tuple{Apply{Lambda{Tuple{k}, Fusion{Lambda{_, Apply{Fusion{_, _}, _}}, _}}, Tuple{_}}},
                Apply{_eq, Tuple{k, peg_g}}
            },
            Lambda{Tuple{_}, false}
        }
    }}

Def{
    _peg_rewrite,
    Lambda{
        Tuple{e},
        If{
            Apply{peg_guarded, Tuple{e}},
            Apply{peg_fuse, Tuple{e, QuasiQuote{Lambda{Tuple{_}, Quote{UnQuote{peg_skip}}}}}},
            e
        }
    }}

" the body without the handler of return that peg_lambda put around it "

Def{
    peg_unret,
    Lambda{
        Tuple{b},
        If{
            If{
                Apply{peg_is_head, Tuple{b, Quote{Handle}}},
                If{
                    Apply{_eq, Tuple{Apply{arity, Tuple{b}}, 2}},
                    If{
                        Apply{_eq, Tuple{Apply{arg, Tuple{b, 1}}, peg_ret_handler}},
                        Apply{peg_scan, Tuple{Apply{arg, Tuple{b, 0}}, Quote{Return}}},
                        false
                    },
                    false
                },
                false
            },
            Apply{arg, Tuple{b, 0}},
            b
        }
    }}

" the functions joined by | in match, with the handlers of return taken off their bodies, "
" so that a return in an arm belongs to the function around the match "

Def{peg_arms, none}
Set{peg_arms,
    Fusion{
        Lambda{
            Tuple{Fusion{f, g}},
            QuasiQuote{Fusion{UnQuote{Apply{peg_arms, Tuple{f}}}, UnQuote{Apply{peg_arms, Tuple{g}}}}}
        },
        Fusion{
            Lambda{Tuple{Lambda{ps, b}}, QuasiQuote{Lambda{UnQuote{ps}, UnQuote{Apply{peg_unret, Tuple{b}}}}}},
            Fusion{
                Lambda{
                    Tuple{Apply{Lambda{Tuple{k}, Fusion{Lambda{vs, Apply{Fusion{f, k2}, vs2}}, k3}}, Tuple{g}}},
                    If{
                        If{
                            Apply{_eq, Tuple{k, peg_g}},
                            If{Apply{_eq, Tuple{k2, k}}, If{Apply{_eq, Tuple{k3, k}}, Apply{_eq, Tuple{vs2, vs}}, false}, false},
                            false
                        },
                        QuasiQuote{
                            Apply{
                                Lambda{
                                    Tuple{UnQuote{k}},
                                    Fusion{
                                        Lambda{
                                            UnQuote{vs},
                                            Apply{Fusion{UnQuote{Apply{peg_arms, Tuple{f}}}, UnQuote{k}}, UnQuote{vs}}
                                        },
                                        UnQuote{k}
                                    }
                                },
                                Tuple{UnQuote{Apply{peg_arms, Tuple{g}}}}
                            }
                        },
                        QuasiQuote{Apply{Lambda{Tuple{UnQuote{k}}, Fusion{Lambda{UnQuote{vs}, Apply{Fusion{UnQuote{f}, UnQuote{k2}}, UnQuote{vs2}}}, UnQuote{k3}}}, Tuple{UnQuote{g}}}}
                    }
                },
                Lambda{Tuple{f}, f}
            }
        }
    }}

" match s { f } is f applied to s "

Def{
    peg_match,
    Lambda{Tuple{s, f}, QuasiQuote{Apply{UnQuote{Apply{peg_arms, Tuple{f}}}, Tuple{UnQuote{s}}}}}}

" show(x) is defined in lib/pretty.pk (show(x) = ...); f\"{x}\" calls it for a value that is not a string or an integer "

Def{show, none}

Def{
    _to_text,
    Lambda{
        Tuple{x},
        Apply{
            Fusion{
                Lambda{Tuple{_TypeOf{s, string}}, s},
                Fusion{
                    Lambda{Tuple{_TypeOf{n, int}}, Apply{peg_itoa, Tuple{n}}},
                    Lambda{Tuple{_}, Apply{show, Tuple{x}}}
                }
            },
            Tuple{x}
        }
    }}

Def{
    peg_tok_istr_open,
    Lambda{
        Tuple{p},
        Do{
            Set{p, Apply{peg_skip_ws, Tuple{p}}},
            If{
                If{
                    Apply{_eq, Tuple{Apply{peg_char_at, Tuple{p}}, 102}},
                    Apply{_eq, Tuple{Apply{peg_char_at, Tuple{Apply{_add, Tuple{p, 1}}}}, 34}},
                    false
                },
                Do{Set{peg_pv, none}, Apply{_add, Tuple{p, 2}}},
                Apply{peg_fail, Tuple{p}}
            }
        }
    }}

Def{
    peg_tok_istr_text,
    Lambda{
        Tuple{p},
        Do{
            Def{q, p},
            Def{start, p},
            Def{acc, ""},
            Def{ok, true},
            Def{go, true},
            Def{c, Apply{peg_char_at, Tuple{q}}},
            While{
                go,
                Do{
                    If{
                        If{
                            Apply{_eq, Tuple{c, 34}},
                            true,
                            If{Apply{_lt, Tuple{c, 0}}, true, Apply{_eq, Tuple{c, 10}}}
                        },
                        Set{go, false},
                        If{
                            Apply{_eq, Tuple{c, 123}},
                            Do{
                                If{
                                    Apply{_eq, Tuple{Apply{peg_char_at, Tuple{Apply{_add, Tuple{q, 1}}}}, 123}},
                                    Do{
                                        Set{
                                            acc,
                                            Apply{
                                                _strcat,
                                                Tuple{
                                                    Apply{
                                                        _strcat,
                                                        Tuple{acc, Apply{substr, Tuple{peg_src, start, q}}}
                                                    },
                                                    "{"
                                                }
                                            }
                                        },
                                        Set{q, Apply{_add, Tuple{q, 2}}},
                                        Set{start, q},
                                        Set{c, Apply{peg_char_at, Tuple{q}}}
                                    },
                                    Set{go, false}
                                }
                            },
                            If{
                                Apply{_eq, Tuple{c, 125}},
                                Do{
                                    If{
                                        Apply{
                                            _eq,
                                            Tuple{Apply{peg_char_at, Tuple{Apply{_add, Tuple{q, 1}}}}, 125}
                                        },
                                        Do{
                                            Set{
                                                acc,
                                                Apply{
                                                    _strcat,
                                                    Tuple{
                                                        Apply{
                                                            _strcat,
                                                            Tuple{
                                                                acc,
                                                                Apply{substr, Tuple{peg_src, start, q}}
                                                            }
                                                        },
                                                        "}"
                                                    }
                                                }
                                            },
                                            Set{q, Apply{_add, Tuple{q, 2}}},
                                            Set{start, q},
                                            Set{c, Apply{peg_char_at, Tuple{q}}}
                                        },
                                        Do{Set{ok, false}, Set{go, false}}
                                    }
                                },
                                If{
                                    Apply{_eq, Tuple{c, 92}},
                                    Do{
                                        Def{
                                            e,
                                            Apply{
                                                table_get,
                                                Tuple{
                                                    peg_escapes,
                                                    Apply{peg_char_at, Tuple{Apply{_add, Tuple{q, 1}}}},
                                                    none
                                                }
                                            }
                                        },
                                        If{
                                            Apply{_eq, Tuple{e, none}},
                                            Do{Set{ok, false}, Set{go, false}},
                                            Do{
                                                Set{
                                                    acc,
                                                    Apply{
                                                        _strcat,
                                                        Tuple{
                                                            Apply{
                                                                _strcat,
                                                                Tuple{
                                                                    acc,
                                                                    Apply{substr, Tuple{peg_src, start, q}}
                                                                }
                                                            },
                                                            e
                                                        }
                                                    }
                                                },
                                                Set{q, Apply{_add, Tuple{q, 2}}},
                                                Set{start, q},
                                                Set{c, Apply{peg_char_at, Tuple{q}}}
                                            }
                                        }
                                    },
                                    Do{Set{q, Apply{_add, Tuple{q, 1}}}, Set{c, Apply{peg_char_at, Tuple{q}}}}
                                }
                            }
                        }
                    }
                }
            },
            If{
                ok,
                Do{Set{peg_pv, Apply{_strcat, Tuple{acc, Apply{substr, Tuple{peg_src, start, q}}}}}, q},
                Apply{peg_fail, Tuple{q}}
            }
        }
    }}

Def{peg_tok_istr_hole, none}
Set{peg_tok_istr_hole,
    Lambda{
        Tuple{p},
        If{
            Apply{_eq, Tuple{Apply{peg_char_at, Tuple{p}}, 123}},
            Do{Set{peg_pv, "{"}, Apply{_add, Tuple{p, 1}}},
            Apply{peg_fail, Tuple{p}}
        }
    }}

Def{
    peg_tok_istr_close,
    Lambda{
        Tuple{p},
        If{
            Apply{_eq, Tuple{Apply{peg_char_at, Tuple{p}}, 34}},
            Do{Set{peg_pv, "\""}, Apply{_add, Tuple{p, 1}}},
            Apply{peg_fail, Tuple{p}}
        }
    }}

Def{
    peg_interp,
    Lambda{
        Tuple{parts, last},
        Do{
            Def{acc, none},
            Def{
                seg,
                Lambda{
                    Tuple{x},
                    Set{
                        acc,
                        If{
                            Apply{_eq, Tuple{acc, none}},
                            x,
                            QuasiQuote{Apply{_strcat, Tuple{UnQuote{acc}, UnQuote{x}}}}
                        }
                    }
                }
            },
            Def{i, 0},
            While{
                Apply{_lt, Tuple{i, Apply{arity, Tuple{parts}}}},
                Do{
                    Def{t, Apply{arg, Tuple{Apply{arg, Tuple{parts, i}}, 0}}},
                    If{Apply{_ne, Tuple{t, ""}}, Apply{seg, Tuple{t}}, none},
                    Apply{
                        seg,
                        Tuple{
                            QuasiQuote{
                                Apply{
                                    _to_text,
                                    Tuple{UnQuote{Apply{arg, Tuple{Apply{arg, Tuple{parts, i}}, 2}}}}
                                }
                            }
                        }
                    },
                    Set{i, Apply{_add, Tuple{i, 1}}}
                }
            },
            If{Apply{_ne, Tuple{last, ""}}, Apply{seg, Tuple{last}}, none},
            If{Apply{_eq, Tuple{acc, none}}, "", acc}
        }
    }}

Apply{_define_rule, Tuple{Quote{istr_open}, peg_tok_istr_open}}

Apply{_define_rule, Tuple{Quote{istr_text}, peg_tok_istr_text}}

Apply{_define_rule, Tuple{Quote{istr_hole}, peg_tok_istr_hole}}

Apply{_define_rule, Tuple{Quote{istr_close}, peg_tok_istr_close}}

Def{record_fields, Apply{table_new, Tuple{}}}

Def{record_slots, Apply{table_new, Tuple{}}}

Def{
    _record_declare,
    Lambda{
        Tuple{name, fields},
        Do{
            Def{old, Apply{table_get, Tuple{record_fields, name, none}}},
            If{
                Apply{_ne, Tuple{old, none}},
                Do{
                    Def{i, 0},
                    While{
                        Apply{_lt, Tuple{i, Apply{arity, Tuple{old}}}},
                        Do{
                            Apply{
                                table_set,
                                Tuple{record_slots, Tuple{name, Apply{arg, Tuple{old, i}}}, none}
                            },
                            Set{i, Apply{_add, Tuple{i, 1}}}
                        }
                    }
                },
                none
            },
            Apply{table_set, Tuple{record_fields, name, fields}},
            Def{i, 0},
            While{
                Apply{_lt, Tuple{i, Apply{arity, Tuple{fields}}}},
                Do{
                    Apply{table_set, Tuple{record_slots, Tuple{name, Apply{arg, Tuple{fields, i}}}, i}},
                    Set{i, Apply{_add, Tuple{i, 1}}}
                }
            }
        }
    }}

Def{record_index, Lambda{Tuple{name, field}, Apply{table_get, Tuple{record_slots, Tuple{name, field}, none}}}}

" a module value is Module{Table{...}}: the table holds the names and the values of the fields of this value "
Def{
    _module,
    Lambda{
        Tuple{names, vals},
        Do{
            Def{t, Apply{table_new, Tuple{}}},
            While{
                Apply{_eq, Tuple{Apply{head, Tuple{names}}, Quote{Cons}}},
                Do{
                    Apply{table_set, Tuple{t, Apply{arg, Tuple{names, 0}}, Apply{arg, Tuple{vals, 0}}}},
                    Set{names, Apply{arg, Tuple{names, 1}}},
                    Set{vals, Apply{arg, Tuple{vals, 1}}}
                }
            },
            Module{t}
        }
    }}

Def{
    _record_get,
    Fusion{
        Lambda{
            Tuple{Module{Table{a}}, name},
            Do{
                Def{e, Apply{table_find, Tuple{a, name, Apply{hash, Tuple{name}}}}},
                If{
                    Apply{_eq, Tuple{e, none}},
                    Do{
                        Apply{put, Tuple{"no field "}},
                        Apply{put, Tuple{Apply{symname, Tuple{name}}}},
                        Apply{put, Tuple{" in "}},
                        Apply{println, Tuple{Module{}}},
                        Apply{exit, Tuple{1}}
                    },
                    none
                },
                Apply{array_get, Tuple{e, 1}}
            }
        },
        Lambda{
            Tuple{t, name},
            Do{
                Def{i, Apply{table_get, Tuple{record_slots, Tuple{Apply{head, Tuple{t}}, name}, none}}},
                If{
                    Apply{_eq, Tuple{i, none}},
                    Do{
                        Apply{put, Tuple{"no field "}},
                        Apply{put, Tuple{Apply{symname, Tuple{name}}}},
                        Apply{put, Tuple{" in "}},
                        Apply{println, Tuple{t}},
                        Apply{exit, Tuple{1}}
                    },
                    none
                },
                Apply{arg, Tuple{t, i}}
            }
        }}}

Def{peg_module, none}
Def{peg_macro, none}

" _testing is true while the tests in the test blocks of modules run (tools/test.pk) "
Def{_testing, false}

Def{
    peg_record,
    Lambda{Tuple{n, fs}, QuasiQuote{Apply{_record_declare, Tuple{Quote{UnQuote{n}}, Quote{UnQuote{fs}}}}}}}


Def{
    peg_loop,
    Lambda{
        Tuple{loop},
        If{Apply{_gt, Tuple{peg_nbrk, 0}}, Apply{peg_wrap, Tuple{loop, Quote{Break}, peg_break_handler}}, loop}
    }}

Def{
    peg_body,
    Lambda{
        Tuple{b},
        If{Apply{_gt, Tuple{peg_ncnt, 0}}, Apply{peg_wrap, Tuple{b, Quote{Continue}, peg_continue_handler}}, b}
    }}

Def{
    peg_while,
    Lambda{
        Tuple{c, b},
        Apply{peg_loop, Tuple{QuasiQuote{While{UnQuote{c}, UnQuote{Apply{peg_body, Tuple{b}}}}}}}
    }}

Def{
    peg_for_tree,
    Lambda{
        Tuple{x, xs, b},
        Apply{
            peg_loop,
            Tuple{
                QuasiQuote{
                    Apply{
                        peg_for,
                        Tuple{UnQuote{xs}, Lambda{Tuple{UnQuote{x}}, UnQuote{Apply{peg_body, Tuple{b}}}}}
                    }
                }
            }
        }
    }}

Def{
    peg_for,
    Lambda{
        Tuple{xs, f},
        Do{
            If{
                Apply{peg_is_head, Tuple{xs, Quote{Vector}}},
                Do{
                    Def{i, 0},
                    Def{v, Apply{arg, Tuple{xs, 0}}},
                    While{
                        Apply{_lt, Tuple{i, Apply{array_get, Tuple{v, 1}}}},
                        Do{
                            Apply{f, Tuple{Apply{array_get, Tuple{Apply{array_get, Tuple{v, 0}}, i}}}},
                            Set{i, Apply{_add, Tuple{i, 1}}}
                        }
                    }
                },
                Do{
                    While{
                        Apply{_eq, Tuple{Apply{head, Tuple{xs}}, Quote{Cons}}},
                        Do{Apply{f, Tuple{Apply{arg, Tuple{xs, 0}}}}, Set{xs, Apply{arg, Tuple{xs, 1}}}}
                    }
                }
            },
            none
        }
    }}

Def{
    peg_return,
    Lambda{
        Tuple{v},
        Do{
            Set{peg_nret, Apply{_add, Tuple{peg_nret, 1}}},
            If{
                Apply{_eq, Tuple{Apply{arity, Tuple{v}}, 0}},
                QuasiQuote{Perform{Return{none}}},
                QuasiQuote{Perform{Return{UnQuote{Apply{arg, Tuple{Apply{arg, Tuple{v, 0}}, 1}}}}}}
            }
        }
    }}

Def{
    peg_break,
    Lambda{Tuple{}, Do{Set{peg_nbrk, Apply{_add, Tuple{peg_nbrk, 1}}}, QuasiQuote{Perform{Break{}}}}}}

Def{
    peg_continue,
    Lambda{Tuple{}, Do{Set{peg_ncnt, Apply{_add, Tuple{peg_ncnt, 1}}}, QuasiQuote{Perform{Continue{}}}}}}

" the expressions of a block "
Def{
    peg_block,
    Lambda{
        Tuple{es},
        Apply{mexpr, Tuple{Quote{Do}, Apply{peg_map_args, Tuple{peg_first, es}}}}}}

" === a[i], a[i] = v and t[p -> e | ...] === "

Def{
    _index_error,
    Lambda{
        Tuple{a, i},
        Do{
            Apply{put, Tuple{"index out of range: "}},
            Apply{print, Tuple{i}},
            Apply{put, Tuple{" in "}},
            Apply{println, Tuple{a}},
            Apply{exit, Tuple{1}}
        }
    }}

Def{
    _index_check,
    Lambda{
        Tuple{a, i, n},
        If{
            If{Apply{_lt, Tuple{i, 0}}, true, Apply{_ge, Tuple{i, n}}},
            Apply{_index_error, Tuple{a, i}},
            none
        }
    }}

" subst(t, f) replaces the parts of t that f applies to. Each part is tried from the root down: "
" when a pattern of f matches it, it is replaced by the value of f and its parts are not tried; "
" otherwise its arguments are tried, and the head is kept. "
Def{
    subst,
    Lambda{
        Tuple{t, f},
        Do{
            Def{go, none},
            Def{g, Fusion{f, Lambda{Tuple{_}, peg_skip}}},
            Set{
                go,
                Lambda{
                    Tuple{x},
                    Do{
                        Def{y, Apply{g, Tuple{x}}},
                        If{
                            Apply{_ne, Tuple{y, peg_skip}},
                            y,
                            If{
                                Apply{_eq, Tuple{Apply{typeof, Tuple{x}}, Quote{mexpr}}},
                                Do{
                                    Def{r, Apply{mexpr, Tuple{Apply{head, Tuple{x}}, Tuple{}}}},
                                    Def{i, 0},
                                    While{
                                        Apply{_lt, Tuple{i, Apply{arity, Tuple{x}}}},
                                        Do{
                                            Set{
                                                r,
                                                Apply{
                                                    push,
                                                    Tuple{
                                                        r,
                                                        Apply{go, Tuple{Apply{arg, Tuple{x, i}}}}
                                                    }
                                                }
                                            },
                                            Set{i, Apply{_add, Tuple{i, 1}}}
                                        }
                                    },
                                    r
                                },
                                x
                            }
                        }
                    }
                }
            },
            Apply{go, Tuple{t}}
        }
    }}

Def{
    _list_get,
    Lambda{
        Tuple{xs, i},
        Do{
            Def{ys, xs},
            Def{n, i},
            While{
                If{
                    Apply{_gt, Tuple{n, 0}},
                    Apply{_eq, Tuple{Apply{head, Tuple{ys}}, Quote{Cons}}},
                    false
                },
                Do{Set{ys, Apply{arg, Tuple{ys, 1}}}, Set{n, Apply{_sub, Tuple{n, 1}}}}
            },
            If{
                If{
                    Apply{_lt, Tuple{i, 0}},
                    true,
                    Apply{_ne, Tuple{Apply{head, Tuple{ys}}, Quote{Cons}}}
                },
                Apply{_index_error, Tuple{xs, i}},
                none
            },
            Apply{arg, Tuple{ys, 0}}
        }
    }}

" a[i] is _index_get(a, i), a function for each kind of a joined by Fusion. A program adds its own kind in front: "
" _index_get = (Matrix{w, _, d}, (i, j)) -> d[i * w + j] | _index_get "
Def{
    _index_get,
    Fusion{
        Lambda{Tuple{_TypeOf{a, array}, _TypeOf{i, int}}, Apply{array_get, Tuple{a, i}}},
        Fusion{
            Lambda{
                Tuple{_TypeOf{s, string}, _TypeOf{i, int}},
                Do{
                    Apply{_index_check, Tuple{s, i, Apply{strlen, Tuple{s}}}},
                    Apply{substr, Tuple{s, i, Apply{_add, Tuple{i, 1}}}}
                }
            },
            Fusion{
                Lambda{Tuple{Table{t}, k}, Apply{table_get, Tuple{Table{t}, k, none}}},
                Fusion{
                    Lambda{Tuple{x, _TypeOf{f, function}}, Apply{subst, Tuple{x, f}}},
                    Fusion{
                        Lambda{
                            Tuple{Cons{x, xs}, _TypeOf{i, int}},
                            Apply{_list_get, Tuple{Cons{x, xs}, i}}
                        },
                        Fusion{
                            Lambda{
                                Tuple{Nil{}, _TypeOf{i, int}},
                                Apply{_index_error, Tuple{Nil{}, i}}
                            },
                            Fusion{
                                Lambda{
                                    Tuple{_TypeOf{t, mexpr}, _TypeOf{f, symbol}},
                                    Apply{_record_get, Tuple{t, f}}
                                },
                                Fusion{
                                    Lambda{
                                        Tuple{_TypeOf{t, mexpr}, _TypeOf{i, int}},
                                        Do{
                                            Apply{_index_check, Tuple{t, i, Apply{arity, Tuple{t}}}},
                                            Apply{arg, Tuple{t, i}}
                                        }
                                    },
                                    Lambda{
                                        Tuple{a, i},
                                        Do{
                                            Apply{put, Tuple{"no index for "}},
                                            Apply{print, Tuple{a}},
                                            Apply{put, Tuple{" and "}},
                                            Apply{println, Tuple{i}},
                                            Apply{exit, Tuple{1}}
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }}

" a plain array (u8_array, u16_array, i32_array) is indexed like an array "
Set{
    _index_get,
    Fusion{
        Lambda{
            Tuple{_TypeOf{a, plain}, _TypeOf{i, int}},
            Apply{plain_get, Tuple{a, i}}
        },
        _index_get
    }}

" a[i] = v is _index_set(a, i, v) "
Def{
    _index_set_immutable,
    Lambda{
        Tuple{kind, a, i},
        Do{
            Apply{put, Tuple{"cannot assign to an element of "}},
            Apply{put, Tuple{kind}},
            Apply{put, Tuple{", which is immutable: "}},
            Apply{print, Tuple{a}},
            Apply{put, Tuple{" at "}},
            Apply{println, Tuple{i}},
            Apply{exit, Tuple{1}}
        }
    }}

Def{
    _index_set,
    Fusion{
        Lambda{Tuple{_TypeOf{a, array}, _TypeOf{i, int}, v}, Apply{array_set, Tuple{a, i, v}}},
        Fusion{
            Lambda{Tuple{Table{t}, k, v}, Apply{table_set, Tuple{Table{t}, k, v}}},
            Fusion{
                Lambda{
                    Tuple{_TypeOf{s, string}, i, v},
                    Apply{_index_set_immutable, Tuple{"a string", s, i}}
                },
                Fusion{
                    Lambda{
                        Tuple{Cons{x, xs}, i, v},
                        Apply{_index_set_immutable, Tuple{"a list", Cons{x, xs}, i}}
                    },
                    Fusion{
                        Lambda{
                            Tuple{Nil{}, i, v},
                            Apply{_index_set_immutable, Tuple{"a list", Nil{}, i}}
                        },
                        Fusion{
                            Lambda{
                                Tuple{_TypeOf{t, mexpr}, i, v},
                                Apply{
                                    _index_set_immutable,
                                    Tuple{
                                        If{
                                            Apply{_eq, Tuple{Apply{head, Tuple{t}}, Quote{Tuple}}},
                                            "a tuple",
                                            "an M-expression"
                                        },
                                        t,
                                        i
                                    }
                                }
                            },
                            Lambda{
                                Tuple{a, i, v},
                                Do{
                                    Apply{put, Tuple{"no index assignment for "}},
                                    Apply{print, Tuple{a}},
                                    Apply{put, Tuple{" and "}},
                                    Apply{println, Tuple{i}},
                                    Apply{exit, Tuple{1}}
                                }
                            }
                        }
                    }
                }
            }
        }
    }}

Set{
    _index_set,
    Fusion{
        Lambda{
            Tuple{_TypeOf{a, plain}, _TypeOf{i, int}, v},
            Apply{plain_set, Tuple{a, i, v}}
        },
        _index_set
    }}

" === Embedded text of a rule === "
" name{| text |} reads the text by the rule name when the expression is parsed. "
" The rule decides where the text ends, and |} must follow it. "
" The value is the value of the rule as a constant. "

Def{peg_tok_embed, Lambda{Tuple{p}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, p},
    Def{r, none},
    Def{v, none},
    If{Apply{peg_is_alpha, Tuple{Apply{peg_char_at, Tuple{p}}}}, Do{
        While{Apply{peg_is_alnum, Tuple{Apply{peg_char_at, Tuple{q}}}}, Set{q, Apply{peg_inc, Tuple{q}}}},
        If{If{Apply{_eq, Tuple{Apply{peg_char_at, Tuple{q}}, 123}}, Apply{_eq, Tuple{Apply{peg_char_at, Tuple{Apply{peg_inc, Tuple{q}}}}, 124}}, false}, Do{
            Set{r, Apply{intern, Tuple{Apply{substr, Tuple{peg_src, p, q}}}}},
            If{Apply{_eq, Tuple{Apply{table_get, Tuple{peg_ids, r, none}}, none}}, Apply{peg_fail, Tuple{p}}, Do{
                Set{q, Apply{peg_call_rule, Tuple{r, Apply{_add, Tuple{q, 2}}}}},
                If{Apply{_lt, Tuple{q, 0}}, -1, Do{
                    Set{v, peg_pv},
                    Set{q, Apply{peg_lit, Tuple{"|}", Apply{peg_skip_ws, Tuple{q}}}}},
                    If{Apply{_lt, Tuple{q, 0}}, -1, Do{
                        Set{peg_pv, Apply{mexpr, Tuple{Quote{Quote}, Tuple{v}}}},
                        q}}}}}}},
            Apply{peg_fail, Tuple{p}}}},
        Apply{peg_fail, Tuple{p}}}}}}

Apply{_define_rule, Tuple{Quote{embed}, peg_tok_embed}}

" -> or the word if after the blanks at p, which are not consumed "
Def{peg_tok_arrow_next, Lambda{Tuple{p}, Do{
    Def{q, Apply{peg_skip_ws, Tuple{p}}},
    Def{c, Apply{peg_char_at, Tuple{q}}},
    Def{d, Apply{peg_char_at, Tuple{Apply{_add, Tuple{q, 1}}}}},
    Set{peg_pv, none},
    If{If{Apply{_eq, Tuple{c, 45}}, Apply{_eq, Tuple{d, 62}}, false}, p,
    If{If{Apply{_eq, Tuple{c, 105}}, If{Apply{_eq, Tuple{d, 102}}, Apply{_not, Tuple{Apply{peg_is_alnum, Tuple{Apply{peg_char_at, Tuple{Apply{_add, Tuple{q, 2}}}}}}}}, false}, false}, p,
        Apply{peg_fail, Tuple{p}}}}}}}

Apply{_define_rule, Tuple{Quote{arrow_next}, peg_tok_arrow_next}}

" === Grammar of the grammar === "
" A rule is declared with  name ::= alt | alt ...  An alternative is items and an optional action { ... }. "
" This part defines the declarations with m-exprs, in the form that the declarations make themselves, "
" and the expressions that an action is written with. After the switch below, the rest of the file is read "
" by these rules, and the rules of planck are declared with ::=. "

" the functions that the actions of the declarations call "
Def{peg_choice, Lambda{Tuple{es},
    If{Apply{_eq, Tuple{Apply{arity, Tuple{es}}, 1}}, Apply{peg_first, Tuple{es}},
        Apply{mexpr, Tuple{Quote{Choice}, es}}}}}

" (e) is e, and (e, ...) is the tuple of them "
Def{peg_group, Lambda{Tuple{es},
    If{Apply{_eq, Tuple{Apply{arity, Tuple{es}}, 1}}, Apply{peg_first, Tuple{es}}, es}}}

" if (c) a, or if (c) a else b when b is Tuple{Tuple{else, b}} (the value of the option) "
Def{peg_if, Lambda{Tuple{c, a, b},
    If{Apply{_eq, Tuple{b, Tuple{}}},
        QuasiQuote{If{UnQuote{c}, UnQuote{a}, none}},
        QuasiQuote{If{UnQuote{c}, UnQuote{a}, UnQuote{Apply{arg, Tuple{Apply{arg, Tuple{b, 0}}, 1}}}}}}}}

" the items and the action of an alternative: Act{Seq{items...}, Lambda{Tuple{Tuple{labels...}}, action}} "
Def{peg_alt, Lambda{Tuple{items, act}, Do{
    Def{labels, Apply{peg_map_args, Tuple{peg_first, items}}},
    Def{elems, Apply{peg_map_args, Tuple{Lambda{Tuple{t}, Apply{arg, Tuple{t, 1}}}, items}}},
    Def{seq, Apply{mexpr, Tuple{Quote{Seq}, elems}}},
    If{Apply{_eq, Tuple{act, Tuple{}}},
        If{Apply{_eq, Tuple{Apply{arity, Tuple{elems}}, 1}}, Apply{peg_first, Tuple{elems}}, seq},
        QuasiQuote{Act{UnQuote{seq},
            Lambda{Tuple{UnQuote{labels}}, UnQuote{Apply{arg, Tuple{Apply{peg_first, Tuple{act}}, 1}}}}}}}}}}

Apply{_define_rule, Tuple{Quote{same}, Quote{Same{}}}}

Apply{_define_rule, Tuple{Quote{syntax_decl}, Quote{
    Act{Seq{ident, "::=", g_choice},
        Lambda{Tuple{Tuple{n, _, e}},
            Do{QuasiQuote{Apply{_define_rule, Tuple{Quote{UnQuote{n}}, Quote{UnQuote{e}}}}}}}}}}}

Apply{_define_rule, Tuple{Quote{g_choice}, Quote{
    Act{Seq{Delimited1{g_alt, "|"}},
        Lambda{Tuple{Tuple{es}}, Do{Apply{peg_choice, Tuple{es}}}}}}}}

Apply{_define_rule, Tuple{Quote{g_alt}, Quote{Choice{
    Act{Seq{"..."}, Lambda{Tuple{Tuple{_}}, Do{Quote{Prev{}}}}},
    Act{Seq{Many1{g_item}, Option{Seq{same, block}}},
        Lambda{Tuple{Tuple{items, act}}, Do{Apply{peg_alt, Tuple{items, act}}}}}}}}}

Apply{_define_rule, Tuple{Quote{g_item}, Quote{Choice{
    Act{Seq{same, ident, Tight{":"}, g_suffix},
        Lambda{Tuple{Tuple{_, l, _, e}}, Do{Tuple{l, e}}}},
    Act{Seq{same, g_suffix},
        Lambda{Tuple{Tuple{_, e}}, Do{Tuple{Quote{_}, e}}}}}}}}

Apply{_define_rule, Tuple{Quote{g_suffix}, Quote{Choice{
    Act{Seq{g_primary, Tight{"*"}}, Lambda{Tuple{Tuple{e, _}}, Do{QuasiQuote{Many{UnQuote{e}}}}}},
    Act{Seq{g_primary, Tight{"+"}}, Lambda{Tuple{Tuple{e, _}}, Do{QuasiQuote{Many1{UnQuote{e}}}}}},
    Act{Seq{g_primary, Tight{"?"}}, Lambda{Tuple{Tuple{e, _}}, Do{QuasiQuote{Option{UnQuote{e}}}}}},
    Act{Seq{"&", g_primary}, Lambda{Tuple{Tuple{_, e}}, Do{QuasiQuote{And{UnQuote{e}}}}}},
    Act{Seq{"!", g_primary}, Lambda{Tuple{Tuple{_, e}}, Do{QuasiQuote{Not{UnQuote{e}}}}}},
    g_primary}}}}

Apply{_define_rule, Tuple{Quote{g_primary}, Quote{Choice{
    string,
    keyword,
    Act{Seq{Key{"nospace"}, Tight{"("}, string, ")"},
        Lambda{Tuple{Tuple{_, _, s, _}}, Do{QuasiQuote{Tight{UnQuote{s}}}}}},
    Act{Seq{Key{"delimited"}, Tight{"("}, g_choice, ",", g_choice, ")"},
        Lambda{Tuple{Tuple{_, _, e, _, s, _}}, Do{QuasiQuote{Delimited{UnQuote{e}, UnQuote{s}}}}}},
    Act{Seq{Key{"delimited1"}, Tight{"("}, g_choice, ",", g_choice, ")"},
        Lambda{Tuple{Tuple{_, _, e, _, s, _}}, Do{QuasiQuote{Delimited1{UnQuote{e}, UnQuote{s}}}}}},
    Act{Seq{ident, Not{Choice{"::=", Tight{":"}}}}, Lambda{Tuple{Tuple{n, _}}, Do{n}}},
    Act{Seq{"(", g_choice, ")"}, Lambda{Tuple{Tuple{_, e, _}}, Do{e}}}}}}}

" === The expressions of an action === "
" The smallest syntax that the actions below need: M-expressions, calls, `e, 'e and !e, and blocks. "
" Rules of the same names are declared again with ::= after they are read. "

Apply{_define_rule, Tuple{Quote{toplevel}, Quote{
    Act{Seq{expr, Choice{";", Not{same}, And{expr}}}, peg_first}}}}

Apply{_define_rule, Tuple{Quote{expr}, Quote{Choice{syntax_decl, unary}}}}

Apply{_define_rule, Tuple{Quote{unary}, Quote{Choice{
    postfix,
    Act{Seq{"'", unary},
        Lambda{Tuple{Tuple{_, a}}, Apply{mexpr, Tuple{Quote{Quote}, Tuple{a}}}}},
    Act{Seq{"`", unary},
        Lambda{Tuple{Tuple{_, a}}, Apply{mexpr, Tuple{Quote{QuasiQuote}, Tuple{a}}}}},
    Act{Seq{"!", unary},
        Lambda{Tuple{Tuple{_, a}}, Apply{mexpr, Tuple{Quote{UnQuote}, Tuple{a}}}}}}}}}

Apply{_define_rule, Tuple{Quote{postfix}, Quote{Choice{
    Act{Seq{postfix, Tight{"("}, Delimited{expr, ","}, ")"},
        Lambda{Tuple{Tuple{f, _, args, _}}, QuasiQuote{Apply{UnQuote{f}, UnQuote{args}}}}},
    primary}}}}

Apply{_define_rule, Tuple{Quote{primary}, Quote{Choice{
    block,
    Act{Seq{ident, Tight{"{"}, Delimited{expr, ","}, "}"},
        Lambda{Tuple{Tuple{h, _, args, _}}, Apply{mexpr, Tuple{h, args}}}},
    ident,
    integer,
    string}}}}

Apply{_define_rule, Tuple{Quote{block}, Quote{
    Act{Seq{"{", Many{Seq{expr, Option{";"}}}, "}"},
        Lambda{Tuple{Tuple{_, es, _}}, Apply{peg_block, Tuple{es}}}}}}}

" === Switch to the grammar read by the rules above === "
" The rest of the file is read by them. The M-expression reader remains as parse_mexpr. "
Def{parse_mexpr, parse}
Set{parse, Lambda{Tuple{s}, Apply{peg_parse, Tuple{Quote{toplevel}, s}}}}

" === The grammar of the grammar, declared with ::= === "
" The rules above declare themselves again, in the form that they make. "
" A rule declared again replaces the rule that read this text. "

syntax_decl ::= n:ident "::=" e:g_choice { `Apply{_define_rule, Tuple{Quote{!n}, Quote{!e}}} }

g_choice ::= es:delimited1(g_alt, "|") { peg_choice(es) }

g_alt ::= "..." { 'Prev{} }
        | items:g_item+ act:(same block)? { peg_alt(items, act) }

g_item ::= same l:ident nospace(":") e:g_suffix { Tuple{l, e} }
         | same e:g_suffix { Tuple{'_, e} }

g_suffix ::= e:g_primary nospace("*") { `Many{!e} }
           | e:g_primary nospace("+") { `Many1{!e} }
           | e:g_primary nospace("?") { `Option{!e} }
           | "&" e:g_primary { `And{!e} }
           | "!" e:g_primary { `Not{!e} }
           | g_primary

g_primary ::= string
            | keyword
            | 'nospace nospace("(") s:string ")" { `Tight{!s} }
            | 'delimited nospace("(") e:g_choice "," s:g_choice ")" { `Delimited{!e, !s} }
            | 'delimited1 nospace("(") e:g_choice "," s:g_choice ")" { `Delimited1{!e, !s} }
            | n:ident !("::=" | nospace(":")) { n }
            | "(" e:g_choice ")" { e }

" === The rules of planck === "
" From the tightest binding to the loosest, so that each rule refers to rules already declared: "
" the rest of the file is read by the rules declared so far. The actions are written in the expressions "
" that the rules above allow: M-expressions, calls and quasi-quotes. "

" a binary - must be on the same line as its left operand "
minus ::= same "-" !nospace(">")

" the = of an assignment, not == "
assign_op ::= "=" !nospace("=")

" the inside of a[...]: an expression. In t[p -> e | q if c -> g] the functions joined by | "
" end with a function that gives peg_skip (_peg_rewrite) "
index ::= e:expr { _peg_rewrite(e) }

unary ::= postfix
        | "-" a:unary { `_sub(0, !a) }
        | "+" a:unary { a }
        | "'" a:unary { mexpr('Quote, Tuple{a}) }
        | "`" a:unary { mexpr('QuasiQuote, Tuple{a}) }
        | "!" a:unary { mexpr('UnQuote, Tuple{a}) }

postfix ::= f:postfix nospace("(") args:delimited(expr, ",") ")" { `Apply{!f, !args} }
          | x:postfix "@" t:ident { `_TypeOf{!x, !t} }
          | t:postfix nospace(".") f:ident { `Apply{_record_get, Tuple{!t, Quote{!f}}} }
          | a:postfix nospace("[") i:index "]" !assign_op { `Apply{_index_get, Tuple{!a, !i}} }
          | x:ident "..." { `_Rest{!x} }
          | primary

mul_expr ::= a:mul_expr "*" b:unary { `_mul(!a, !b) }
           | a:mul_expr "/" b:unary { `_div(!a, !b) }
           | a:mul_expr "%" b:unary { `_mod(!a, !b) }
           | unary

add_expr ::= a:add_expr "+" b:mul_expr { `_add(!a, !b) }
           | a:add_expr minus b:mul_expr { `_sub(!a, !b) }
           | mul_expr

" x :: xs is Cons{x, xs}. It groups to the right. "
cons_expr ::= a:add_expr "::" b:cons_expr { `Cons{!a, !b} }
            | add_expr

rel_expr ::= a:cons_expr "==" b:cons_expr { `_eq(!a, !b) }
           | a:cons_expr "!=" b:cons_expr { `_ne(!a, !b) }
           | a:cons_expr "<=" b:cons_expr { `_le(!a, !b) }
           | a:cons_expr ">=" b:cons_expr { `_ge(!a, !b) }
           | a:cons_expr "<" b:cons_expr { `_lt(!a, !b) }
           | a:cons_expr ">" b:cons_expr { `_gt(!a, !b) }
           | cons_expr

not_expr ::= 'not a:not_expr { `_not(!a) }
           | rel_expr

and_expr ::= a:not_expr 'and b:and_expr { `If{!a, !b, false} }
           | not_expr

or_expr ::= a:and_expr 'or b:or_expr { `If{!a, true, !b} }
          | and_expr

ternary ::= c:or_expr "?" a:or_expr ":" b:ternary { `If{!c, !a, !b} }
          | or_expr

" === Patterns === "
" A pattern is written as an expression up to or, and matches the tree of that expression: "
" a + b is Apply{'_add, Tuple{a, b}} and f(x) is Apply{'f, Tuple{x}}. "
" The names of operators and functions are symbols, the other identifiers are variables. "
" (f)(p, ...) is Apply{f, Tuple{p, ...}} with the variable f: a call of any function. "
" p @ type is _TypeOf{p, type}, and the arguments of Head{p, ...} are patterns. "

pat_primary ::= f:ident nospace("(") args:delimited(pattern, ",") ")" { `Apply{Quote{!f}, !args} }
              | h:ident nospace("{") args:delimited(pattern, ",") "}" { mexpr(h, args) }
              | "(" f:ident ")" nospace("(") args:delimited(pattern, ",") ")" { `Apply{!f, !args} }
              | ident
              | integer
              | string
              | "(" ")" { 'Tuple{} }
              | "(" ps:delimited1(pattern, ",") ")" { peg_group(ps) }
              | "[" ps:delimited(pattern, ",") "]" { peg_to_list(ps) }

pat_postfix ::= x:pat_postfix "@" t:ident { `_TypeOf{!x, !t} }
              | x:ident "..." { `_Rest{!x} }
              | pat_primary

" 'e is the value of the expression e "
pat_unary ::= pat_postfix
            | "-" a:pat_unary { `Apply{'_sub, Tuple{0, !a}} }
            | "'" a:unary { mexpr('Quote, Tuple{a}) }

pat_mul ::= a:pat_mul "*" b:pat_unary { `Apply{'_mul, Tuple{!a, !b}} }
          | a:pat_mul "/" b:pat_unary { `Apply{'_div, Tuple{!a, !b}} }
          | a:pat_mul "%" b:pat_unary { `Apply{'_mod, Tuple{!a, !b}} }
          | pat_unary

pat_add ::= a:pat_add "+" b:pat_mul { `Apply{'_add, Tuple{!a, !b}} }
          | a:pat_add minus b:pat_mul { `Apply{'_sub, Tuple{!a, !b}} }
          | pat_mul

pat_cons ::= a:pat_add "::" b:pat_cons { `Cons{!a, !b} }
           | pat_add

pat_rel ::= a:pat_cons "==" b:pat_cons { `Apply{'_eq, Tuple{!a, !b}} }
          | a:pat_cons "!=" b:pat_cons { `Apply{'_ne, Tuple{!a, !b}} }
          | a:pat_cons "<=" b:pat_cons { `Apply{'_le, Tuple{!a, !b}} }
          | a:pat_cons ">=" b:pat_cons { `Apply{'_ge, Tuple{!a, !b}} }
          | a:pat_cons "<" b:pat_cons { `Apply{'_lt, Tuple{!a, !b}} }
          | a:pat_cons ">" b:pat_cons { `Apply{'_gt, Tuple{!a, !b}} }
          | pat_cons

pat_not ::= 'not a:pat_not { `Apply{'_not, Tuple{!a}} }
          | pat_rel

pat_and ::= a:pat_not 'and b:pat_and { `If{!a, !b, 'false} }
          | pat_not

pattern ::= a:pat_and 'or b:pattern { `If{!a, 'true, !b} }
          | pat_and

" === Functions, assignments and the other forms === "

" the parameters are read as patterns only when an expression and -> or if follow, "
" since every text of a pattern is also a text of an expression. The rule keeps the result for the position. "
params ::= "(" ps:delimited(pattern, ",") ")" &arrow_next { ps }
         | p:pattern { Tuple{p} }

lambda_ahead ::= &(ternary arrow_next)

" params if c -> e is a function with the guard c (peg_guard) "
arrow ::= lambda_ahead ps:params "->" e:arrow { peg_lambda(ps, e) }
        | lambda_ahead ps:params 'if c:ternary "->" e:arrow { peg_guard(ps, c, e) }
        | ternary

" the left side of x := e and x = e: a name, or !x which is replaced by the name inside a quasi-quote "
target ::= ident
         | "!" x:ident { mexpr('UnQuote, Tuple{x}) }

" a branch of if: an expression without | outside of brackets, "
" so that a | after if (c) a else b goes on with the functions around the if "
branch ::= &(postfix ":=") f:ident nospace("(") ps:delimited(pattern, ",") ")" ":=" e:branch {
               `Do{Declare{!f}, Set{!f, Fusion{!f, !peg_lambda(ps, e)}}}
           }
         | x:target ":=" e:branch { `Def{!x, !e} }
         | &(postfix "=" !nospace("=")) f:ident nospace("(") ps:delimited(pattern, ",") ")" "=" !nospace("=") e:branch {
               `Set{!f, Fusion{!f, !peg_lambda(ps, e)}}
           }
         | x:target "=" !nospace("=") e:branch { `Set{!x, !e} }
         | arrow

" the condition is in parentheses, the branches are branch. "
" else belongs to the nearest if, since the branch takes it first. "
if_expr ::= 'if "(" c:expr ")" a:branch b:('else branch)? { peg_if(c, a, b) }

" a function with a guard passes its arguments on to the functions after its | "
" when the guard is false (peg_fuse) "
union ::= f:arrow "|" g:union { peg_fuse(f, g) }
        | arrow

sugar_primary ::= 'match s:ternary "{" f:union "}" { peg_match(s, f) }
                | 'return v:(same arrow)? { peg_return(v) }
                | 'break { peg_break() }
                | 'continue { peg_continue() }
                | 'for "(" x:pattern 'in xs:expr ")" b:expr { peg_for_tree(x, xs, b) }

block ::= "{" es:(expr ";"?)* "}" { peg_block(es) }

primary ::= if_expr
          | 'while "(" c:expr ")" b:expr { peg_while(c, b) }
          | 'handle b:expr 'with h:union { `Handle{!b, !h} }
          | 'perform v:unary { `Perform{!v} }
          | block
          | embed
          | h:ident nospace("{") args:delimited(expr, ",") "}" { mexpr(h, args) }
          | istr_open parts:(istr_text istr_hole expr "}")* last:istr_text istr_close { peg_interp(parts, last) }
          | ident
          | integer
          | string
          | "(" ")" { 'Tuple{} }
          | "(" es:delimited1(expr, ",") ")" { peg_group(es) }
          | "[" es:delimited(expr, ",") "]" { peg_to_list(es) }
          | sugar_primary

idents ::= delimited(ident, ",")

" module m { ... }: export marks the definitions that stand directly in the body, which are the fields (peg_module) "
module_def ::= &(postfix ":=") f:ident nospace("(") ps:delimited(pattern, ",") ")" ":=" e:expr {
                   `Do{Declare{!f}, Set{!f, Fusion{!f, !peg_lambda(ps, e)}}}
               }
             | x:ident ":=" e:expr { `Def{!x, !e} }
             | 'macro p:pattern ":=" e:expr { peg_macro(p, e) }
             | module_expr

module_stmt ::= 'export d:module_def { `Export{!d} }
              | 'test b:block { `If{_testing, !b, none} }
              | expr

" the statements of a body, the last one first (a repetition holds at most 64 results) "
module_stmts ::= xs:module_stmts s:module_stmt ";"? { Cons{s, xs} }
               | s:module_stmt ";"? { Cons{s, Nil{}} }

module_expr ::= 'module n:ident "{" es:module_stmts "}" { peg_module(n, es) }
              | 'module n:ident "{" "}" { peg_module(n, Nil{}) }

" f(p, ...) := e adds to f when f is already a variable of the place (Declare) "
expr ::= syntax_decl
       | &(postfix ":=") f:ident nospace("(") ps:delimited(pattern, ",") ")" ":=" e:expr {
             `Do{Declare{!f}, Set{!f, Fusion{!f, !peg_lambda(ps, e)}}}
         }
       | x:target ":=" e:expr { `Def{!x, !e} }
       | &(postfix "=" !nospace("=")) f:ident nospace("(") ps:delimited(pattern, ",") ")" "=" !nospace("=") e:expr {
             `Set{!f, Fusion{!f, !peg_lambda(ps, e)}}
         }
       | x:target "=" !nospace("=") e:expr { `Set{!x, !e} }
       | 'fun f:ident !nospace("(") { `Def{!f, none} }
       | 'macro p:pattern ":=" e:expr { peg_macro(p, e) }
       | a:postfix nospace("[") i:expr "]" "=" !nospace("=") v:expr { `Apply{_index_set, Tuple{!a, !i, !v}} }
       | union
       | 'record n:ident "(" fs:idents ")" { peg_record(n, fs) }
       | module_expr

" a top-level expression ends with ; or a newline, or another expression follows "
toplevel ::= e:expr (";" | !same | &expr) { e }

" the name that a definition marked export defines: x for Def{x, e}, f for Do{Declare{f}, ...} "
peg_export_name(d) := if (head(d) == 'Def) arg(d, 0) else arg(arg(d, 0), 0)

" module n { ... }: rev is the list of the statements of the body, the last one first. The module is "
" n := (() -> { statements; _module(names, values) })(). An M-expression holds at most 64 arguments, so "
" the statements are gathered in blocks of 32 (a block does not make a scope). "
peg_module(n, rev) := {
    items := Nil{}
    while (head(rev) == 'Cons) {
        items = Cons{arg(rev, 0), items}
        rev = arg(rev, 1)
    }
    blocks := Tuple{}
    cur := Tuple{}
    names := Nil{}
    while (head(items) == 'Cons) {
        s := arg(items, 0)
        items = arg(items, 1)
        if (typeof(s) == 'mexpr and head(s) == 'Export) {
            d := arg(s, 0)
            if (head(d) != 'Macro) {
                names = Cons{peg_export_name(d), names}
                s = d
            }
        }
        cur = push(cur, s)
        if (arity(cur) == 32) {
            blocks = push(blocks, mexpr('Do, cur))
            cur = Tuple{}
        }
    }
    if (arity(cur) > 0) blocks = push(blocks, mexpr('Do, cur))
    blocks = push(blocks, `Apply{_module, Tuple{Quote{!names}, !names}})
    `Def{!n, Apply{Lambda{Tuple{}, !mexpr('Do, blocks)}, Tuple{}}}
}

" === Macro === "
" macro p := e is the tree Macro{f}, f being the function p -> e. It is not evaluated: the rewriting below "
" takes it out of the tree, adds f in front of the macros that apply from there on (the last arm gives the "
" tree itself), and leaves none in its place. A macro applies to the rest of the body of the innermost "
" function or module around it, and to the parts inside. export macro in a module also adds f to the "
" macros of the place around the module, after the module. Before eval takes an expression, each part of "
" its tree is rewritten by the macros, from the root down: a part is rewritten until it no longer changes, "
" then the parts inside the result are rewritten. A quote is not rewritten, and in a quasi-quote only what "
" is unquoted is rewritten. The patterns of a function and the names that Def and Set define are not rewritten. "
_macro_on := false
_macro := e -> e
" the macros that the module being rewritten exports, the last one first "
_macro_exports := Nil{}
_eval_expanded := eval
" a rewriting that takes more than _macro_limit steps in one eval stops with an error "
_macro_limit := 1000
_macro_steps := 0

" _macro_on is set when a macro is read, so that nothing is rewritten before the first macro "
peg_macro(p, e) := {
    _macro_on = true
    `Macro{!peg_lambda(Tuple{p}, e)}
}
fun expand_macro

" the tree whose arguments from index from on are rewritten at the quasi-quote level lvl "
expand_macro_args(e, lvl, from) := {
    n := arity(e)
    xs := Tuple{}
    i := 0
    while (i < n) {
        a := arg(e, i)
        xs = push(xs, if (i < from) a else expand_macro(a, lvl))
        i = i + 1
    }
    mexpr(head(e), xs)
}

" Macro{f}: the function of f is added to the macros, and none stays "
expand_macro_define(m, exported) := {
    f := _eval_expanded(expand_macro(arg(m, 0), 0))
    _macro = Fusion{f, _macro}
    if (exported) _macro_exports = Cons{f, _macro_exports}
    none
}

" a function or module body is a scope: the macros of its inside end with it, except the exported ones "
expand_macro_scope(e) := {
    saved := _macro
    saved_exports := _macro_exports
    _macro_exports = Nil{}
    r := expand_macro_args(e, 0, 1)
    xs := _macro_exports
    ys := Nil{}
    while (head(xs) == 'Cons) {
        ys = Cons{arg(xs, 0), ys}
        xs = arg(xs, 1)
    }
    _macro = saved
    while (head(ys) == 'Cons) {
        _macro = Fusion{arg(ys, 0), _macro}
        ys = arg(ys, 1)
    }
    _macro_exports = saved_exports
    r
}

expand_macro_sub(e, lvl) := {
    if (typeof(e) != 'mexpr) e
    else {
        h := head(e)
        if (h == 'QuasiQuote) expand_macro_args(e, lvl + 1, 0)
        else if (h == 'UnQuote) { if (lvl == 0) e else expand_macro_args(e, lvl - 1, 0) }
        else if (lvl > 0) expand_macro_args(e, lvl, 0)
        else if (h == 'Quote) e
        else if (h == 'Macro) expand_macro_define(e, false)
        else if (h == 'Export and typeof(arg(e, 0)) == 'mexpr and head(arg(e, 0)) == 'Macro) expand_macro_define(arg(e, 0), true)
        else if (h == 'Lambda) expand_macro_scope(e)
        else if (h == 'Def or h == 'Set or h == 'Declare) expand_macro_args(e, 0, 1)
        else expand_macro_args(e, 0, 0)
    }
}

expand_macro = (e, lvl) -> {
    if (lvl != 0) expand_macro_sub(e, lvl)
    else {
        n := _macro(e)
        while (n != e) {
            _macro_steps = _macro_steps + 1
            if (_macro_steps > _macro_limit) perform Error{none, "macro expansion does not end"}
            e = n
            n = _macro(e)
        }
        expand_macro_sub(e, 0)
    }
}

" eval rewrites the tree by the macros first. Nothing is rewritten until the first macro is read. "
eval = e -> {
    if (_macro_on) {
        saved := _macro_steps
        _macro_steps = 0
        x := expand_macro(e, 0)
        _macro_steps = saved
        _eval_expanded(x)
    } else _eval_expanded(e)
}
