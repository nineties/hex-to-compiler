# Rewrite a syntax tree with t[p -> e | ...]: algebraic simplification.
use("unparse")

# One pass. Each part of the tree is tried from the root down with the arms in order.
# A part that an arm matches is replaced, and the parts inside it wait for the next pass.
step(e) := e[
    a @ int + b @ int -> a + b
  | a + 0 -> a
  | 0 + a -> a
  | a + b if a == b -> `(2 * !a)
  | a @ int - b @ int -> a - b
  | a - 0 -> a
  | a - b if a == b -> 0
  | a @ int * b @ int -> a * b
  | _ * 0 -> 0
  | 0 * _ -> 0
  | a * 1 -> a
  | 1 * a -> a
]

# Repeat until nothing changes, printing each pass.
simplify(e) := {
    n := step(e)
    while (n != e) {
        put("     => "); put(unparse.text(n)); put("\n")
        e = n
        n = step(e)
    }
    e
}

show(e) := {
    put(unparse.text(e)); put("\n")
    simplify(e)
    put("\n")
}

show('(x + 0))
show('(1 * (x + 0)))
show('(2 + 3 * 4))
show('((y - y) * z + w * 1))
show('((a + b) + (a + b)))
show('(0 * x + 1 * (y + 2 * 3)))

# Arms written in place: f(a) becomes h(a, a) and g(a) becomes a.
put(unparse.text('(f(x) + g(y)))); put("\n")
r := ('(f(x) + g(y)))[f(a) -> `h(!a, !a) | g(a) -> a]
put("     => "); put(unparse.text(r)); put("\n")
