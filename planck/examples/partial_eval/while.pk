# a while whose condition is dynamic stays a loop, and the variables that it assigns are registers
# planck0 planck/examples/partial_eval/while.pk <output>
use("vasm/build")
use("partial_eval")

sum_tree := `(sum_to(n) := {
    i := 0
    s := 0
    while (i < n) {
        i = i + 1
        if (i == 7) continue
        if (i > 20) break
        s = s + i
    }
    s
})
eval(sum_tree)
println(f"interpreted sum_to(10): {sum_to(10)}")
println(f"interpreted sum_to(30): {sum_to(30)}")

m := partial_eval.specialize(sum_tree, [Dyn{I32{}}], I32{})
put(partial_eval.vasm_text(m))
vasm_build.build(partial_eval.with_main(m, [10]), argv()[1])
