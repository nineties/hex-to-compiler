"interpreted size(0): 26"
fn size_spec(a0: i32) -> i32 {
    var t1: val
    var t2: val
    var t3: val
    var t4: i64
    var t5: i64
    var t6: i64
    var t7: i32
    t1 = "planck/examples/partial_eval/prog.txt" as val
    t2 = v_read_file(t1)
    t3 = v_strlen(t2)
    t4 = t3 as i64
    t5 = a0 as i64
    t6 = t5 + t4
    t7 = t6 as i32
    return t7
}

fn read_file[r](path: &r [u8]) -> own [u8] {
    var fd: i64
    var acc: own [u8]
    var chunk: own [u8]
    var next: own [u8]
    var n: i64
    var got: i64
    var total: i64
    var i: i64
    var k: i64
    var c: u8
    var more: bool
    fd = open(path)
    if (fd < 0) {
        exit(1)
    }
    acc = alloc(0, 0)
    chunk = alloc(4096, 0)
    n = 0
    more = true
    while (more) {
        region g {
            var m: &mut g [u8]
            m = &mut g chunk
            got = read(fd, m)
        }
        if (got > 0) {
            total = n + got
            next = alloc(total, 0)
            i = 0
            while (i < n) {
                c = acc[i]
                next[i] = c
                i = i + 1
            }
            i = 0
            while (i < got) {
                c = chunk[i]
                k = n + i
                next[k] = c
                i = i + 1
            }
            acc = next
            n = total
        } else {
            more = false
        }
    }
    close(fd)
    return acc
}

fn v_strlen(v: val) -> val {
    var n: i64
    var r: val
    n = arity(v)
    r = n as val
    return r
}

fn v_read_file(path: val) -> val {
    var b: own [u8]
    var p: own [u8]
    var r: val
    p = path as own [u8]
    region g {
        var ps: &g [u8]
        ps = &g p
        b = read_file(ps)
    }
    region h {
        var s: &h [u8]
        s = &h b
        r = s as val
    }
    return r
}
