# put, print and the writing of a file stay in the result, in the order of the program
# planck0 planck/examples/partial_eval/output.pk <output>
use("vasm/build")
use("partial_eval")

say_tree := `(say(x, name) := {
    put("hello ")
    put(name)
    put("\n")
    print([x, "s", 'y])
    put("\n")
    for (e in [x, x + 1]) println(e)
    write_file("tmp-pe-file", "written\n")
    put(read_file("tmp-pe-file"))
    if (x > 100) exit(3)
    x
})
eval(say_tree)
println(f"interpreted say(5): {say(5, "planck")}")

m := partial_eval.specialize(say_tree, [Dyn{I32{}}, "planck"], I32{})
put(partial_eval.vasm_text(m))
vasm_build.build(partial_eval.with_main(m, [5]), argv()[1])
