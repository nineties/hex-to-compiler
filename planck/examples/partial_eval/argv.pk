# argv() stays in the result: the arguments of the result are read when it runs
# planck0 planck/examples/partial_eval/argv.pk <output>, and the result is run as <output> <output>
use("vasm/build")
use("partial_eval")

arglen_tree := `(arglen(x) := x + strlen(argv()[1]) + array_len(argv()))
eval(arglen_tree)
println(f"interpreted arglen(0): {arglen(0)}")

m := partial_eval.specialize(arglen_tree, [Dyn{I32{}}], I32{})
put(partial_eval.vasm_text(m))
vasm_build.build(partial_eval.with_main(m, [0]), argv()[1])
