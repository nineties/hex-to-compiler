# a recursion under a dynamic condition stays a function; k = 3 is static and x is dynamic
# planck0 planck/examples/partial_eval/recur.pk <output>
use("vasm/build")
use("partial_eval")

count_tree := `(count_to(x, k) := if (x == k) x else count_to(x + 1, k))
eval(count_tree)
println(f"interpreted count_to(0, 3): {count_to(0, 3)}")

m := partial_eval.specialize(count_tree, [Dyn{I32{}}, 3], I32{})
put(partial_eval.vasm_text(m))
vasm_build.build(partial_eval.with_main(m, [0]), argv()[1])
