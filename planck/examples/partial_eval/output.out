fn say_spec(a0: i32) -> i32 {
    var t1: val
    var t2: val
    var t3: val
    var t4: val
    var t5: val
    var t6: val
    var t7: val
    var t8: val
    var t9: val
    var t10: val
    var t11: val
    var t12: val
    var t13: val
    var t14: val
    var t15: val
    var t16: i32
    var t17: i64
    var t18: i64
    var t19: val
    var t20: val
    var t21: val
    var t22: val
    var t23: val
    var t24: val
    var t25: bool
    var t26: val
    var t27: val
    t1 = "hello " as val
    t2 = v_put(t1)
    t3 = "planck" as val
    t4 = v_put(t3)
    t5 = "\n" as val
    t6 = v_put(t5)
    t7 = a0 as val
    t8 = "s" as val
    t9 = val Nil()
    t10 = val Cons('y, t9)
    t11 = val Cons(t8, t10)
    t12 = val Cons(t7, t11)
    t13 = v_print(t12)
    t14 = "\n" as val
    t15 = v_put(t14)
    t16 = a0 + 1
    t17 = a0 as i64
    println_int(t17)
    t18 = t16 as i64
    println_int(t18)
    t19 = "tmp-pe-file" as val
    t20 = "written\n" as val
    t21 = v_write_file(t19, t20)
    t22 = "tmp-pe-file" as val
    t23 = v_read_file(t22)
    t24 = v_put(t23)
    t25 = a0 > 100
    if (t25) {
        t26 = 3 as val
        t27 = v_exit(t26)
    }
    return a0
}

fn println_int(v: i64) {
    var buf: own [u8]
    var out: own [u8]
    var i: i64
    var j: i64
    var k: i64
    var n: i64
    var x: i64
    var d: i64
    var c: u8
    var neg: bool
    buf = alloc(24, 0)
    i = 23
    buf[i] = 10
    x = v
    neg = x < 0
    if (neg) {
        x = 0 - x
    }
    if (x == 0) {
        i = i - 1
        buf[i] = 48
    }
    while (x > 0) {
        d = x % 10
        c = d as u8
        c = c + 48
        i = i - 1
        buf[i] = c
        x = x / 10
    }
    if (neg) {
        i = i - 1
        buf[i] = 45
    }
    n = 24 - i
    out = alloc(n, 0)
    j = 0
    while (j < n) {
        k = i + j
        c = buf[k]
        out[j] = c
        j = j + 1
    }
    region r {
        var b: &r [u8]
        b = &r out
        n = write(1, b)
    }
}

fn read_file[r](path: &r [u8]) -> own [u8] {
    var fd: i64
    var acc: own [u8]
    var chunk: own [u8]
    var next: own [u8]
    var n: i64
    var got: i64
    var total: i64
    var i: i64
    var k: i64
    var c: u8
    var more: bool
    fd = open(path)
    if (fd < 0) {
        exit(1)
    }
    acc = alloc(0, 0)
    chunk = alloc(4096, 0)
    n = 0
    more = true
    while (more) {
        region g {
            var m: &mut g [u8]
            m = &mut g chunk
            got = read(fd, m)
        }
        if (got > 0) {
            total = n + got
            next = alloc(total, 0)
            i = 0
            while (i < n) {
                c = acc[i]
                next[i] = c
                i = i + 1
            }
            i = 0
            while (i < got) {
                c = chunk[i]
                k = n + i
                next[k] = c
                i = i + 1
            }
            acc = next
            n = total
        } else {
            more = false
        }
    }
    close(fd)
    return acc
}

fn v_write[r](fd: i64, s: &r [u8]) {
    var n: i64
    n = write(fd, s)
}

fn v_bytes_write(fd: i64, v: val) {
    var b: own [u8]
    b = v as own [u8]
    region g {
        var s: &g [u8]
        s = &g b
        v_write(fd, s)
    }
}

fn v_digits(v: i64) -> val {
    var buf: own [u8]
    var out: own [u8]
    var i: i64
    var j: i64
    var k: i64
    var n: i64
    var x: i64
    var d: i64
    var c: u8
    var neg: bool
    var r: val
    buf = alloc(24, 0)
    i = 24
    x = v
    neg = x < 0
    if (neg) {
        x = 0 - x
    }
    if (x == 0) {
        i = i - 1
        buf[i] = 48
    }
    while (x > 0) {
        d = x % 10
        c = d as u8
        c = c + 48
        i = i - 1
        buf[i] = c
        x = x / 10
    }
    if (neg) {
        i = i - 1
        buf[i] = 45
    }
    n = 24 - i
    out = alloc(n, 0)
    j = 0
    while (j < n) {
        k = i + j
        c = buf[k]
        out[j] = c
        j = j + 1
    }
    region g {
        var s: &g [u8]
        s = &g out
        r = s as val
    }
    return r
}

fn v_print(v: val) -> val {
    var t: val
    var b: bool
    var n: i64
    var i: i64
    var x: val
    t = typeof(v)
    b = t == 'int
    if (b) {
        n = v as i64
        x = v_digits(n)
        v_bytes_write(1, x)
        return 'none
    }
    b = t == 'string
    if (b) {
        v_write(1, "\"")
        v_bytes_write(1, v)
        v_write(1, "\"")
        return 'none
    }
    b = t == 'symbol
    if (b) {
        x = symname(v)
        v_bytes_write(1, x)
        return 'none
    }
    b = t == 'mexpr
    if (b) {
        x = head(v)
        x = symname(x)
        v_bytes_write(1, x)
        v_write(1, "{")
        n = arity(v)
        i = 0
        while (i < n) {
            if (i > 0) {
                v_write(1, ", ")
            }
            x = v[i]
            x = v_print(x)
            i = i + 1
        }
        v_write(1, "}")
        return 'none
    }
    b = t == 'array
    if (b) {
        v_write(1, "<array>")
        return 'none
    }
    v_write(1, "<function>")
    return 'none
}

fn v_put(v: val) -> val {
    v_bytes_write(1, v)
    return 'none
}

fn v_stop[r](msg: &r [u8]) {
    v_write(2, msg)
    v_write(2, "\n")
    exit(1)
}

fn v_exit(v: val) -> val {
    var n: i64
    n = v as i64
    exit(n)
    return 'none
}

fn v_read_file(path: val) -> val {
    var b: own [u8]
    var p: own [u8]
    var r: val
    p = path as own [u8]
    region g {
        var ps: &g [u8]
        ps = &g p
        b = read_file(ps)
    }
    region h {
        var s: &h [u8]
        s = &h b
        r = s as val
    }
    return r
}

fn v_write_file(path: val, x: val) -> val {
    var p: own [u8]
    var b: own [u8]
    var t: val
    var isarr: bool
    var fd: i64
    var n: i64
    var i: i64
    var e: val
    var d: i64
    var c: u8
    var bad: bool
    t = typeof(x)
    isarr = t == 'array
    if (isarr) {
        n = arity(x)
        b = alloc(n, 0)
        i = 0
        while (i < n) {
            e = x[i]
            d = e as i64
            c = d as u8
            b[i] = c
            i = i + 1
        }
    } else {
        b = x as own [u8]
    }
    p = path as own [u8]
    region g {
        var ps: &g [u8]
        ps = &g p
        fd = create(ps)
    }
    bad = fd < 0
    if (bad) {
        v_stop("write_file: the file cannot be written")
    }
    region h {
        var s: &h [u8]
        s = &h b
        n = write(fd, s)
    }
    close(fd)
    return x
}
