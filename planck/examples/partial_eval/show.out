"start"
6
"interpreted show(5): 10"
fn show_spec(a0: i32) -> i32 {
    var t1: i32
    var t2: i64
    var t3: i32
    println_str("start")
    t1 = a0 + 1
    t2 = t1 as i64
    println_int(t2)
    t3 = a0 * 2
    return t3
}

fn println_str[r](s: &r [u8]) {
    var n: i64
    n = write(1, "\"")
    n = write(1, s)
    n = write(1, "\"\n")
}

fn println_int(v: i64) {
    var buf: own [u8]
    var out: own [u8]
    var i: i64
    var j: i64
    var k: i64
    var n: i64
    var x: i64
    var d: i64
    var c: u8
    var neg: bool
    buf = alloc(24, 0)
    i = 23
    buf[i] = 10
    x = v
    neg = x < 0
    if (neg) {
        x = 0 - x
    }
    if (x == 0) {
        i = i - 1
        buf[i] = 48
    }
    while (x > 0) {
        d = x % 10
        c = d as u8
        c = c + 48
        i = i - 1
        buf[i] = c
        x = x / 10
    }
    if (neg) {
        i = i - 1
        buf[i] = 45
    }
    n = 24 - i
    out = alloc(n, 0)
    j = 0
    while (j < n) {
        k = i + j
        c = buf[k]
        out[j] = c
        j = j + 1
    }
    region r {
        var b: &r [u8]
        b = &r out
        n = write(1, b)
    }
}
