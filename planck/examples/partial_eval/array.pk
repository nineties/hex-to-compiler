# the writes to an array stay in the result and happen in the order of the program; the array is made when the result runs
# planck0 planck/examples/partial_eval/array.pk <output>
use("vasm/build")
use("partial_eval")

fill_tree := `(fill(x) := {
    a := i32_array(3)
    a[0] = x
    a[1] = x * 2
    if (x > 4) { a[0] = a[1] + 1 } else { a[1] = 0 }
    a[2] = a[0] + a[1]
    a[2] + a[0]
})
eval(fill_tree)
println(f"interpreted fill(5): {fill(5)}")

m := partial_eval.specialize(fill_tree, [Dyn{I32{}}], I32{})
put(partial_eval.vasm_text(m))
vasm_build.build(partial_eval.with_main(m, [5]), argv()[1])
