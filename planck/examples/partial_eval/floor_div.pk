# // and % round toward minus infinity also in the result of the specialization, where the operands are not known
# planck0 planck/examples/partial_eval/floor_div.pk <output>
use("vasm/build")
use("partial_eval")

div_tree := `(g(a, b) := {
    println(a // b)
    println(a % b)
    println(b // a)
    println(b % a)
    0
})
eval(div_tree)
println(f"interpreted g(-7, 2): {g(-7, 2)}")

m := partial_eval.specialize(div_tree, [Dyn{I32{}}, Dyn{I32{}}], I32{})
put(partial_eval.vasm_text(m))
vasm_build.build(partial_eval.with_main(m, [-7, 2]), argv()[1])
