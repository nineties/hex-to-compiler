# pow specialized for n = 3: x is dynamic
# planck0 planck/examples/partial_eval/pow.pk <output>
use("vasm/build")
use("partial_eval")

pow_tree := `({
    pow(x, 0) := 1
    pow(x, n) := x * pow(x, n - 1)
})
eval(pow_tree)
println(f"interpreted pow(5, 3): {pow(5, 3)}")

m := partial_eval.specialize(pow_tree, [Dyn{I32{}}, 3], I32{})
put(partial_eval.vasm_text(m))
vasm_build.build(partial_eval.with_main(m, [5]), argv()[1])
