# the interpreter of a bytecode specialized for the code of prog.txt: x is dynamic
# planck0 planck/examples/partial_eval/interp.pk <output>
use("vasm/build")
use("partial_eval")
use("list")
use("string")

decode_line(["push", n]) := Push{string.str_to_int(n)}
decode_line(["arg"]) := Arg{}
decode_line(["add"]) := Add{}
decode_line(["mul"]) := Mul{}
decode(text) := map(l -> decode_line(string.split(l, " ")), filter(l -> l != "", string.split(text, "\n")))

interp_tree := `({
    exec(Nil{}, _, st) := list.nth(st, 0)
    exec(Push{n} :: rest, x, st) := exec(rest, x, n :: st)
    exec(Arg{} :: rest, x, st) := exec(rest, x, x :: st)
    exec(Add{} :: rest, x, a :: b :: st) := exec(rest, x, a + b :: st)
    exec(Mul{} :: rest, x, a :: b :: st) := exec(rest, x, a * b :: st)
    run(code, x) := exec(code, x, [])
})
eval(interp_tree)

code := decode(read_file("planck/examples/partial_eval/prog.txt"))
println(f"interpreted run(code, 5): {run(code, 5)}")

m := partial_eval.specialize(interp_tree, [code, Dyn{I32{}}], I32{})
put(partial_eval.vasm_text(m))
vasm_build.build(partial_eval.with_main(m, [5]), argv()[1])
