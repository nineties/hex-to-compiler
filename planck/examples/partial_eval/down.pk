# the static argument n counts down under a dynamic condition: the functions that are made do not depend on how far it goes
# planck0 planck/examples/partial_eval/down.pk <output>
use("vasm/build")
use("partial_eval")

down_tree := `(down(x, n) := if (n == 0) x else if (x == 7) 0 else down(x + 1, n - 1))
eval(down_tree)
println(f"interpreted down(3, 2): {down(3, 2)}")

m := partial_eval.specialize(down_tree, [Dyn{I32{}}, 2], I32{})
put(partial_eval.vasm_text(m))
vasm_build.build(partial_eval.with_main(m, [3]), argv()[1])
