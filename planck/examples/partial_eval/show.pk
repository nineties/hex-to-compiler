# printing stays in the result and happens in the same order as in the interpretation
# planck0 planck/examples/partial_eval/show.pk <output>
use("vasm/build")
use("partial_eval")

show_tree := `(show(x) := {
    println("start")
    println(x + 1)
    x * 2
})
eval(show_tree)
println(f"interpreted show(5): {show(5)}")

m := partial_eval.specialize(show_tree, [Dyn{I32{}}], I32{})
put(partial_eval.vasm_text(m))
vasm_build.build(partial_eval.with_main(m, [5]), argv()[1])
