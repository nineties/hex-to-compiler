# read_file stays in the result: the file is read when the result runs
# planck0 planck/examples/partial_eval/read.pk <output>
use("vasm/build")
use("partial_eval")

size_tree := `(size(x) := x + strlen(read_file("planck/examples/partial_eval/prog.txt")))
eval(size_tree)
println(f"interpreted size(0): {size(0)}")

m := partial_eval.specialize(size_tree, [Dyn{I32{}}], I32{})
put(partial_eval.vasm_text(m))
vasm_build.build(partial_eval.with_main(m, [0]), argv()[1])
