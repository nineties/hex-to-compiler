# strlen of a string that is dynamic: the result calls strlen of vasm
# planck0 planck/examples/partial_eval/strlen.pk <output>
use("vasm/build")
use("partial_eval")

plus_len_tree := `(plus_len(s, x) := x + strlen(s))
eval(plus_len_tree)
println(f"interpreted plus_len(\"hello\", 10): {plus_len("hello", 10)}")

m := partial_eval.specialize(plus_len_tree, [Dyn{Ref{'shr, 'static, Arr{U8{}}}}, Dyn{I32{}}], I32{})
put(partial_eval.vasm_text(m))
vasm_build.build(partial_eval.with_main(m, ["hello", 10]), argv()[1])
