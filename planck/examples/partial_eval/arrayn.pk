# array(n) with a dynamic n: the array is made when the result runs, is shared, and goes to a function that is left
# planck0 planck/examples/partial_eval/arrayn.pk <output>
use("vasm/build")
use("partial_eval")

fill_tree := `({
    set_all(a, i, n, v) := if (i == n) a else {
        a[i] = v + i
        set_all(a, i + 1, n, v)
    }
    total(a, i, n) := if (i == n) 0 else a[i] + total(a, i + 1, n)
    run(n) := {
        a := array(n)
        b := a
        set_all(a, 0, n, 10)
        total(b, 0, n)
    }
})
eval(fill_tree)
println(f"interpreted run(4): {run(4)}")

m := partial_eval.specialize(fill_tree, [Dyn{I32{}}], I32{})
put(partial_eval.vasm_text(m))
vasm_build.build(partial_eval.with_main(m, [4]), argv()[1])
