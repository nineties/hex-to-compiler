# a function that is known only when the result runs is a val, and a function that is made with a dynamic value is a val with this value in it
# planck0 planck/examples/partial_eval/dynfun.pk <output>
use("vasm/build")
use("partial_eval")

apply_tree := `({
    pick(c, y) := if (c > 0) (x -> x + y) else (x -> x * y)
    run(c, y, z) := {
        count := 0
        bump := x -> {
            count = count + 1
            pick(c, y)(x)
        }
        r := bump(bump(z))
        r + count
    }
})
eval(apply_tree)
println(f"interpreted run(1, 2, 3): {run(1, 2, 3)}")
println(f"interpreted run(0, 2, 3): {run(0, 2, 3)}")

m := partial_eval.specialize(apply_tree, [Dyn{I32{}}, Dyn{I32{}}, Dyn{I32{}}], I32{})
put(partial_eval.vasm_text(m))
vasm_build.build(partial_eval.with_main(m, [1, 2, 3]), argv()[1])
