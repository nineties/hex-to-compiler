" Symbolic differentiation "

" Rules are added one by one with Set{f, Fusion{rule, f}}. "
" The rule added later is tried first. "

" --- simplification of a node "
Def{simp, Lambda{Tuple{e}, e}}
Set{simp, Fusion{Lambda{Tuple{Pow{e, 1}}, e}, simp}}
Set{simp, Fusion{Lambda{Tuple{Pow{_, 0}}, 1}, simp}}
Set{simp, Fusion{Lambda{Tuple{Mul{e, 1}}, e}, simp}}
Set{simp, Fusion{Lambda{Tuple{Mul{1, e}}, e}, simp}}
Set{simp, Fusion{Lambda{Tuple{Mul{_, 0}}, 0}, simp}}
Set{simp, Fusion{Lambda{Tuple{Mul{0, _}}, 0}, simp}}
Set{simp, Fusion{Lambda{Tuple{Add{e, 0}}, e}, simp}}
Set{simp, Fusion{Lambda{Tuple{Add{0, e}}, e}, simp}}
Set{simp, Fusion{Lambda{Tuple{Add{_TypeOf{a, int}, _TypeOf{b, int}}}, Apply{add, Tuple{a, b}}}, simp}}
Set{simp, Fusion{Lambda{Tuple{Mul{_TypeOf{a, int}, _TypeOf{b, int}}}, Apply{mul, Tuple{a, b}}}, simp}}

" --- differentiation, simplifying each new node "
Def{d, Lambda{Tuple{_TypeOf{_, int}, x}, 0}}
Set{d, Fusion{Lambda{Tuple{_TypeOf{y, symbol}, x}, If{Apply{eq, Tuple{y, x}}, 1, 0}}, d}}
Set{d, Fusion{Lambda{Tuple{Add{a, b}, x},
    Apply{simp, Tuple{Add{Apply{d, Tuple{a, x}}, Apply{d, Tuple{b, x}}}}}}, d}}
Set{d, Fusion{Lambda{Tuple{Mul{a, b}, x},
    Apply{simp, Tuple{Add{
        Apply{simp, Tuple{Mul{Apply{d, Tuple{a, x}}, b}}},
        Apply{simp, Tuple{Mul{a, Apply{d, Tuple{b, x}}}}}}}}}, d}}
Set{d, Fusion{Lambda{Tuple{Pow{a, _TypeOf{n, int}}, x}, Do{
    Def{p, Apply{simp, Tuple{Pow{a, Apply{sub, Tuple{n, 1}}}}}},
    Apply{simp, Tuple{Mul{Apply{simp, Tuple{Mul{n, p}}}, Apply{d, Tuple{a, x}}}}}}}, d}}

Def{show, Lambda{Tuple{e}, Do{
    Apply{put, Tuple{"d/dx "}},
    Apply{print, Tuple{e}},
    Apply{put, Tuple{" = "}},
    Apply{println, Tuple{Apply{d, Tuple{e, Quote{x}}}}}}}}

Apply{show, Tuple{Quote{x}}}
Apply{show, Tuple{Quote{y}}}
Apply{show, Tuple{Quote{Add{x, 3}}}}
Apply{show, Tuple{Quote{Mul{x, y}}}}
Apply{show, Tuple{Quote{Add{Mul{3, Pow{x, 2}}, Mul{2, x}}}}}
Apply{show, Tuple{Quote{Pow{Add{x, 1}, 3}}}}

" QuasiQuote builds an expression from values "
Def{n, 4}
Apply{show, Tuple{QuasiQuote{Mul{y, Pow{x, UnQuote{n}}}}}}
