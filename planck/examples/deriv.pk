# Symbolic differentiation

# Rules are added one by one with f = rule | f.
# The rule added later is tried first.

# --- simplification of a node
simp := e -> e
simp = Pow{e, 1} -> e | simp
simp = Pow{_, 0} -> 1 | simp
simp = Mul{e, 1} -> e | simp
simp = Mul{1, e} -> e | simp
simp = Mul{_, 0} -> 0 | simp
simp = Mul{0, _} -> 0 | simp
simp = Add{e, 0} -> e | simp
simp = Add{0, e} -> e | simp
simp = Add{a @ int, b @ int} -> a + b | simp
simp = Mul{a @ int, b @ int} -> a * b | simp

# --- differentiation, simplifying each new node
d := (_ @ int, x) -> 0
d = (y @ symbol, x) -> y == x ? 1 : 0 | d
d = (Add{a, b}, x) -> simp(Add{d(a, x), d(b, x)}) | d
d = (Mul{a, b}, x) ->
    simp(Add{simp(Mul{d(a, x), b}), simp(Mul{a, d(b, x)})}) | d
d = (Pow{a, n @ int}, x) -> {
    p := simp(Pow{a, n - 1})
    simp(Mul{simp(Mul{n, p}), d(a, x)})
} | d

show(e) := {
    put("d/dx ")
    print(e)
    put(" = ")
    println(d(e, 'x))
}

show('x)
show('y)
show('Add{x, 3})
show('Mul{x, y})
show('Add{Mul{3, Pow{x, 2}}, Mul{2, x}})
show('Pow{Add{x, 1}, 3})

# QuasiQuote builds an expression from values
n := 4
show(`Mul{y, Pow{x, !n}})
