" Fibonacci numbers by pattern matching and Fusion "

Def{fib, Fusion{Fusion{
    Lambda{Tuple{0}, 0},
    Lambda{Tuple{1}, 1}},
    Lambda{Tuple{n}, Apply{add, Tuple{
        Apply{fib, Tuple{Apply{sub, Tuple{n, 1}}}},
        Apply{fib, Tuple{Apply{sub, Tuple{n, 2}}}}}}}}}

Def{i, 0}
While{Apply{le, Tuple{i, 20}}, Do{
    Apply{put, Tuple{"fib("}},
    Apply{print, Tuple{i}},
    Apply{put, Tuple{") = "}},
    Apply{println, Tuple{Apply{fib, Tuple{i}}}},
    Set{i, Apply{add, Tuple{i, 1}}}}}
