(Point, wrap_point, unwrap_point) := make_type('Point)
point(x, y) := wrap_point(Tuple{x, y})
point_x(p @ Point) := arg(unwrap_point(p), 0)
point_y(p @ Point) := arg(unwrap_point(p), 1)
with_y(p @ Point, y) := point(point_x(p), y)

p := point(1, 2)
q := with_y(p, 5)
print(p)
print(q)
print(point_x(q))
print(point_y(q))
print(type(p) == Point)
print(type(p) == Int)
