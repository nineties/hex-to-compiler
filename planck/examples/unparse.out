input:  1+2*3
tree:   Apply{add, Tuple{1, Apply{mul, Tuple{2, 3}}}}
output: 1 + 2 * 3
same tree: true

input:  ((1 + 2)) * 3
tree:   Apply{mul, Tuple{Apply{add, Tuple{1, 2}}, 3}}
output: (1 + 2) * 3
same tree: true

input:  a - (b - c)
tree:   Apply{sub, Tuple{a, Apply{sub, Tuple{b, c}}}}
output: a - (b - c)
same tree: true

input:  -(x + 1) * f(y, 2)
tree:   Apply{mul, Tuple{Apply{sub, Tuple{0, Apply{add, Tuple{x, 1}}}}, Apply{f, Tuple{y, 2}}}}
output: -(x + 1) * f(y, 2)
same tree: true

input:  x->y->x+y
tree:   Lambda{Tuple{x}, Lambda{Tuple{y}, Apply{add, Tuple{x, y}}}}
output: x -> y -> x + y
same tree: true

input:  not (a and b) or c
tree:   If{Apply{not, Tuple{If{a, b, false}}}, true, c}
output: not (a and b) or c
same tree: true

f(n) := {
    s := 0
    while (n > 0) {
        s = s + n
        n = n - 1
    }
    s
}
true

record Point(x, y)
same tree: true

dist(p) := {
    dx := p.x
    dy := p.y
    f"({dx}, {dy})"
}
same tree: true

find(xs, v) := {
    for (x in xs) {
        if (x == v) return true
    }
    false
}
same tree: true

sign(n) := match n {
    n if n < 0 -> -1
    0 -> 0
    _ -> 1
}
same tree: true

count(n) := {
    i := 0
    while (true) {
        i = i + 1
        if (i > n) break
        if (i % 2 == 0) continue
    }
    i
}
same tree: true

