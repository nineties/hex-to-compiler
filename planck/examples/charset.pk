# Characters in a grammar: [set] is one character of the set, [^set] one character that is not in it,
# and . is any one character. The value of each is the character as a string.

use("string")

# the characters that a repetition gives are joined into a text
join(cs) := {
    r := ""
    i := 0
    while (i < arity(cs)) {
        r = _strcat(r, arg(cs, i))
        i = i + 1
    }
    r
}

word ::= cs:[a-z_]+ { join(cs) }
number ::= cs:[0-9]+ { string.str_to_int(join(cs)) }
quoted ::= "\"" cs:[^"]* "\"" { join(cs) }
pair ::= k:word "=" v:(number | quoted) { Tuple{k, v} }
pairs ::= xs:delimited(pair, ",") { xs }
first ::= c:. { c }

r := peg_parse('pairs, "a=12, name=\"koichi\", b_2=7")
println(arg(r, 0))
println(arg(peg_parse('first, "  xyz"), 0))
println(head(arg(peg_parse('pair, "a=?"), 0)))
println(head(arg(peg_parse('first, "   "), 0)))
