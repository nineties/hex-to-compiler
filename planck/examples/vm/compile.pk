# The compiler of pvm/compile: the m-expressions that parse returns run on planckvm. The image path is the first argument.
use("pvm/compile")
use("bytes")

prog := [
    `(fib(n) := if (n < 2) n else fib(n - 1) + fib(n - 2)),
    `(println(fib(20))),
    `(counter() := {
        n := 0
        () -> {
            n = n + 1
            n
        }
    }),
    `(c := counter()),
    `(c()),
    `(println(c())),
    `(println(c())),
    `(area(Circle{r}) := 3 * r * r),
    `(area(Rect{w, h}) := w * h),
    `(println(area(Rect{3, 4}))),
    `(println(area(Circle{2}))),
    `(println("done"))
]

write_file(array_get(argv(), 1), bytes.to_u8(pvm_compile.image(prog)))
