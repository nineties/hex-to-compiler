use("pvm/compile")
use("bytes")

prog := [
    `(cells := _cells()),
    `(find_cell(name, gen) := {
        i := 0
        r := none
        while (i < array_len(cells)) {
            c := array_get(cells, i)
            if (_cell_field(c, 1) == name and _cell_field(c, 2) == gen) r = c
            i = i + 1
        }
        r
    }),
    `(ins := plain_array('u32, 5)),
    `(plain_set(ins, 0, 260)),
    `(plain_set(ins, 1, 66050)),
    `(plain_set(ins, 2, 16843028)),
    `(plain_set(ins, 3, 2752513)),
    `(plain_set(ins, 4, 22)),
    `(ks := array(2)),
    `(array_set(ks, 0, find_cell('println, 0))),
    `(array_set(ks, 1, "hello from loaded code")),
    `(f := _lambda(_code_new(0, 4, ins, ks, -1, plain_array('u32, 0)))),
    `(println(f())),
    `(c2 := _cell_new('loaded_var, 1)),
    `(_cell_set(c2, 77)),
    `(println(_cell_field(c2, 0))),
    `(println(_cell_field(c2, 1))),
    `(println(_cell_field(c2, 2))),
    `(ins2 := plain_array('u32, 2)),
    `(plain_set(ins2, 0, 4)),
    `(plain_set(ins2, 1, 22)),
    `(ks2 := array(1)),
    `(array_set(ks2, 0, c2)),
    `(println(_lambda(_code_new(0, 2, ins2, ks2, -1, plain_array('u32, 0)))())),
    `(ins3 := plain_array('u32, 3)),
    `(plain_set(ins3, 0, 8060929)),
    `(plain_set(ins3, 1, 5)),
    `(plain_set(ins3, 2, 22)),
    `(_lambda(_code_new(0, 2, ins3, ks2, -1, plain_array('u32, 0)))()),
    `(println(_cell_field(c2, 0))),
    `(println(handle _code_new(0, 4, 5, ks, -1, plain_array('u32, 0)) with (Error{loc, msg}, k) -> msg))
]

write_file(array_get(argv(), 1), bytes.to_u8(pvm_compile.image(prog)))
