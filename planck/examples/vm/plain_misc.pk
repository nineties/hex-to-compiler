# arrays and plain arrays on planckvm: the program is written with the instructions and run by planck/vm; the image path is the first argument
use("pvm/image")

cat(xs) := concat_map(x -> x, xs)

part1 := cat([
    concat_map(x -> x, [[GETGLOBAL{1, 6}, LOADI{2, 3}, CALL{1, 1, 1}, ALEN{3, 1}, GETGLOBAL{30, 0}, MOVE{31, 3}, CALL{30, 30, 1}, AGETI{3, 1, 0}, GETGLOBAL{30, 0}, MOVE{31, 3}, CALL{30, 30, 1}, LOADI{2, 7}, LOADI{3, 1}, ASET{1, 3, 2}, AGETI{4, 1, 1}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}, AGET{4, 1, 3}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}, AGETI{4, 1, 2}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}, LOADK{2, 26}, LOADI{3, 2}, ASET{1, 3, 2}, AGET{4, 1, 3}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}, GETGLOBAL{5, 6}, LOADI{6, 0}, CALL{5, 5, 1}, ALEN{6, 5}, GETGLOBAL{30, 0}, MOVE{31, 6}, CALL{30, 30, 1}, LOADI{3, 0}, ASET{1, 3, 5}, AGETI{6, 1, 0}, EQ{7, 6, 5}], [GETGLOBAL{30, 0}, MOVE{31, 7}, CALL{30, 30, 1}, TYPEOF{7, 5}, GETGLOBAL{30, 0}, MOVE{31, 7}, CALL{30, 30, 1}, HASH{8, 5}, HASH{9, 6}, EQ{7, 8, 9}, GETGLOBAL{30, 0}, MOVE{31, 7}, CALL{30, 30, 1}, GETGLOBAL{6, 6}, LOADI{7, 0}, CALL{6, 6, 1}, EQ{7, 5, 6}, GETGLOBAL{30, 0}, MOVE{31, 7}, CALL{30, 30, 1}, HASH{8, 5}, HASH{9, 6}, EQ{7, 8, 9}, GETGLOBAL{30, 0}, MOVE{31, 7}, CALL{30, 30, 1}, GETGLOBAL{8, 7}, MOVE{9, 1}, LOADI{10, 1}, CALL{8, 8, 2}, GETGLOBAL{30, 0}, MOVE{31, 8}, CALL{30, 30, 1}, GETGLOBAL{8, 8}, MOVE{9, 1}, LOADI{10, 1}, LOADI{11, 99}, CALL{8, 8, 3}, GETGLOBAL{30, 0}, MOVE{31, 8}, CALL{30, 30, 1}, AGETI{8, 1, 1}, GETGLOBAL{30, 0}, MOVE{31, 8}, CALL{30, 30, 1}, GETGLOBAL{8, 9}], [MOVE{9, 1}, CALL{8, 8, 1}, GETGLOBAL{30, 0}, MOVE{31, 8}, CALL{30, 30, 1}]]),
    concat_map(x -> x, [[GETGLOBAL{1, 3}, LOADK{2, 17}, LOADI{3, 4}, CALL{1, 1, 2}, TYPEOF{4, 1}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}, GETGLOBAL{5, 3}, LOADK{6, 17}, LOADI{7, 4}, CALL{5, 5, 2}, EQ{4, 1, 5}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}, EQ{4, 1, 1}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}, HASH{4, 1}, HASH{6, 1}, EQ{4, 4, 6}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}, HASH{6, 5}, HASH{7, 1}, EQ{4, 6, 7}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}, GETGLOBAL{4, 4}, MOVE{5, 1}, CALL{4, 4, 1}, LOADK{5, 17}, EQ{6, 4, 5}, GETGLOBAL{30, 0}, MOVE{31, 6}, CALL{30, 30, 1}, GETGLOBAL{4, 11}, MOVE{5, 1}], [LOADI{6, 2}, LOADI{7, 200}, CALL{4, 4, 3}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}, GETGLOBAL{4, 10}, MOVE{5, 1}, LOADI{6, 2}, CALL{4, 4, 2}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}, LOADI{6, 2}, PLAINGET{4, 1, 6}, LOADI{7, 1}, ADD{4, 4, 7}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}]]),
    concat_map(x -> x, [[GETGLOBAL{1, 3}, LOADK{2, 14}, LOADI{3, 5}, CALL{1, 1, 2}, LOADI{2, 1}, LOADI{3, 0}, SUB{2, 3, 2}, LOADI{3, 0}, PLAINSET{1, 3, 2}, LOADI{2, 1}, LOADI{3, 16384}, MUL{2, 2, 3}, LOADI{3, 16383}, ADD{2, 2, 3}, LOADI{3, 1}, PLAINSET{1, 3, 2}, LOADI{2, 2}, LOADI{3, 16384}, MUL{2, 2, 3}, LOADI{3, 0}, ADD{2, 2, 3}, LOADI{3, 0}, SUB{2, 3, 2}, LOADI{3, 2}, PLAINSET{1, 3, 2}, LOADI{2, 7}, LOADI{3, 3}, PLAINSET{1, 3, 2}, LOADI{2, 1000}, LOADI{3, 4}], [PLAINSET{1, 3, 2}, LOADI{3, 4}, PLAINGET{4, 1, 3}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}, LOADI{3, 3}, PLAINGET{4, 1, 3}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}, LOADI{3, 2}, PLAINGET{4, 1, 3}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}, LOADI{3, 1}, PLAINGET{4, 1, 3}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}, LOADI{3, 0}, PLAINGET{4, 1, 3}, GETGLOBAL{30, 0}, MOVE{31, 4}, CALL{30, 30, 1}]])
])

consts0 := [C{"println"}, C{"stof"}, C{"complex"}, C{"plain_array"}, C{"plain_kind"}, C{"plain_len"}, C{"array"}, C{"array_get"}, C{"array_set"}, C{"array_len"}, C{"plain_get"}, C{"plain_set"}, Y{"bool"}, Y{"i8"}, Y{"i16"}, Y{"i32"}, Y{"i64"}, Y{"u8"}, Y{"u16"}, Y{"u32"}, Y{"u64"}, Y{"f16"}, Y{"f32"}, Y{"f64"}, Y{"c64"}, Y{"c128"}, S{"abc"}]
consts := consts0
main := Code{"main", 0, 40, cat([part1, [LOADNONE{0, 1}, RET{0}]]), consts}

write_file(array_get(argv(), 1), bytes.to_u8(pvm_image.build([main], "main")))
