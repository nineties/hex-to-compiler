# Files, the standard input and the arguments on planckvm: planck/lib/io.pk and the program below are the image. The standard input is io.in.
use("pvm/compile")
use("bytes")

lib := pvm_compile.parse_file("planck/lib/io.pk")

prog := [
    `(line := read_line()),
    `(while (line != none) {
        println(line)
        line = read_line()
    }),
    `(println(read_line())),
    `(println(try_read_file("no-such-file"))),
    `(println(strlen(read_file("planck/examples/vm/io.in")))),
    `(println(plain_len(read_bytes("planck/examples/vm/io.in")))),
    `(println(array_len(argv())))
]

write_file(array_get(argv(), 1), bytes.to_u8(pvm_compile.image(append(lib, prog))))
