# The computer algebra of pvm/cas on planckvm: the rationals of big integers, the derivative of an expression and the series of an expression.
# The image path is the first argument.
use("pvm/compile")
use("pvm/cas")
use("bytes")

body := `({
    show(Q{n, d}) := {
        print(n)
        put("/")
        println(d)
    }
    show_series(s) := {
        i := 0
        while (i < array_len(s)) { show(array_get(s, i)); i = i + 1 }
    }
    println(pow(3, 80))
    println(bit_len(pow(2, 100)))
    println(gcd(pow(2, 40) * 9, pow(2, 30) * 21))
    println(isqrt(pow(10, 40) + 7))
    show(qq(6, 0 - 4))
    show(qadd(Q{1, 3}, Q{1, 6}))
    show(qmul(Q{2, 3}, Q{9, 4}))
    show(qdiv(Q{1, 2}, Q{3, 4}))
    println(d(`(x * x * x), 'x))
    show_series(taylor(`(exp(x)), 'x, 6))
    show_series(taylor(`(1 / (1 - x)), 'x, 4))
    show_series(taylor(`(sin(x)), 'x, 7))
    show_series(taylor(`(atan(x)), 'x, 7))
    println(pi_int(100))
    println(ln2_int(100))
})

write_file(array_get(argv(), 1), bytes.to_u8(pvm_compile.image(cas_program(body))))
