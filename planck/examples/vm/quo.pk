# _quo of planckvm: the quotient of integers cut toward the negative infinity. The program is written with the instructions and run by planck/vm; the image path is the first argument
use("pvm/image")

# println of R[x]
show(x) := [GETGLOBAL{30, 1}, MOVE{31, x}, CALL{30, 30, 1}]

# println of _quo(R[a], R[b])
quo(a, b) := concat_map(x -> x, [[GETGLOBAL{30, 0}, MOVE{31, a}, MOVE{32, b}, CALL{33, 30, 2}], show(33)])

body := concat_map(x -> x, [
    # small integers: 7, 2, -2, -7, 6, 3, -6, 0, 5
    [LOADI{1, 7}, LOADI{2, 2}, LOADI{10, 0}, SUB{3, 10, 2}, SUB{4, 10, 1}, LOADI{5, 6}, LOADI{6, 3}, SUB{7, 10, 5}, LOADI{8, 5}],
    quo(1, 2), quo(4, 2), quo(1, 3), quo(4, 3), quo(5, 6), quo(7, 6), quo(10, 8),
    # big integers: a = (2^29 - 1)^2 and c = 2^29 + 1, and the four signs
    [LOADK{11, 2}, MUL{12, 11, 11}, ADDI{13, 11, 2}, SUB{14, 10, 12}, SUB{15, 10, 13}],
    quo(12, 13), quo(14, 13), quo(12, 15), quo(14, 15),
    [LOADNONE{0, 1}, RET{0}]
])

main := Code{"main", 0, 48, body, [C{"_quo"}, C{"println"}, I{536870911}]}

write_file(array_get(argv(), 1), bytes.to_u8(pvm_image.build([main], "main")))
