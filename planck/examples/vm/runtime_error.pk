# A runtime error is the effect Error{loc, message}: a handler catches it, and its continuation gives a value to the instruction that failed
use("pvm/compile")
use("bytes")

lib := pvm_compile.parse_file("planck/lib/io.pk")

prog := [
    `(z := 0),
    `(try(f) := handle f() with (Error{loc, msg}, k) -> msg),
    `(println(try(() -> 1 / z))),
    `(println(try(() -> 1 % z))),
    `(println(try(() -> 1 + "a"))),
    `(println(try(() -> "a" < 1))),
    `(println(try(() -> z(1)))),
    `(println(try(() -> arg(5, 0)))),
    `(println(try(() -> arg(Foo{1}, 3)))),
    `(println(try(() -> strlen(5)))),
    `(println(try(() -> _strcat(1, "a")))),
    `(println(try(() -> intern(5)))),
    `(println(try(() -> read_file("no-such-file")))),
    `(deep(n) := if (n == 0) 10 / z else 1 + deep(n - 1)),
    `(println(try(() -> deep(5)))),
    `(println(handle (1 / z) + 100 with (Error{loc, msg}, k) -> k(5))),
    `(println(handle 3 / z with (Error{loc, msg}, k) -> loc)),
    `(println(try(() -> 1 + 1))),
    `(println("done"))
]

write_file(array_get(argv(), 1), bytes.to_u8(pvm_compile.image(append(lib, prog))))
