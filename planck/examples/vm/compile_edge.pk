# Edge cases of the compiler of pvm/compile: a type that a pattern reads from an outer variable, and comparisons whose operands are both expressions.
# A compile error that is caught as the effect Error is tested by repl.pk. The image path is the first argument.
use("pvm/compile")
use("bytes")

prog := [
    # _TypeOf{p, T} where T is a global variable, and where T is a parameter of the enclosing function
    `(Pair := Array),
    `(kind(x @ Pair) := "global type"),
    `(kind(_) := "other"),
    `(println(kind(array(2)))),
    `(println(kind(5))),
    `(only(T) := {
        f(x @ T) := "matched"
        f(_) := "not matched"
        f
    }),
    `(f_int := only(Int)),
    `(f_str := only(String)),
    `(println(f_int(1))),
    `(println(f_str(1))),
    `(println(f_str("a"))),
    # > and <= with operands that are both expressions are evaluated from left to right
    `(note(x) := {
        println(x)
        x
    }),
    `(println(note(2) > note(1))),
    `(println(note(3) <= note(3) + 1)),
    `(big(n) := if (n * 2 > n + 1) "greater" else "not greater"),
    `(println(big(5))),
    `(println(big(1))),
    `(println("done"))
]

write_file(array_get(argv(), 1), bytes.to_u8(pvm_compile.image(prog)))
