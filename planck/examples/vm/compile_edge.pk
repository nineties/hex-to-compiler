use("pvm/compile")
use("bytes")

prog := [
    `(Pair := Array),
    `(kind(x @ Pair) := "global type"),
    `(kind(_) := "other"),
    `(println(kind(array(2)))),
    `(println(kind(5))),
    `(only(T) := {
        f(x @ T) := "matched"
        f(_) := "not matched"
        f
    }),
    `(f_int := only(Int)),
    `(f_str := only(String)),
    `(println(f_int(1))),
    `(println(f_str(1))),
    `(println(f_str("a"))),
    `(note(x) := {
        println(x)
        x
    }),
    `(println(note(2) > note(1))),
    `(println(note(3) <= note(3) + 1)),
    `(big(n) := if (n * 2 > n + 1) "greater" else "not greater"),
    `(println(big(5))),
    `(println(big(1))),
    `(println("done"))
]

write_file(array_get(argv(), 1), bytes.to_u8(pvm_compile.image(prog)))
