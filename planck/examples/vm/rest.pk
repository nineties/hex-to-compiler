# A rest parameter x... takes the arguments from its place on as a Tuple, on planckvm too. The image path is the first argument.
use("pvm/compile")
use("bytes")

prog := [
    `(sum(xs) := {
        s := 0
        i := 0
        while (i < arity(xs)) {
            s = s + arg(xs, i)
            i = i + 1
        }
        s
    }),
    `(total(xs...) := sum(xs)),
    `(println(total())),
    `(println(total(1, 2, 3))),
    `(scale(k, xs...) := k * sum(xs)),
    `(println(scale(10, 1, 2, 3))),
    `(println(scale(10))),
    `(count := (first, others...) -> 1 + arity(others)),
    `(println(count(7, 8, 9))),
    `(describe(a) := "one"),
    `(describe(a, b) := "two"),
    `(describe(a, b, c...) := "three or more"),
    `(println(describe(1))),
    `(println(describe(1, 2))),
    `(println(describe(1, 2, 3, 4))),
    `(println(describe(1, 2, 3))),
    # an arm that has the rest and does not match gives the arguments to the next arm as they were called
    `(pick(0, rest...) := arity(rest)),
    `(pick(a, b, c) := "three"),
    `(println(pick(0))),
    `(println(pick(0, 5, 6))),
    `(println(pick(1, 5, 6))),
    # the tuple keeps the arguments as values, in a closure too
    `(keep(x, ys...) := () -> ys),
    `(println(keep(1, 2, 3)())),
    # a call in a tail position
    `(loop(n, acc...) := if (n == 0) arity(acc) else loop(n - 1, n)),
    `(println(loop(3)))
]

write_file(array_get(argv(), 1), bytes.to_u8(pvm_compile.image(prog)))
