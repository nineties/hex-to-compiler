# bit_not and bit_shr on planckvm: the program is written with the instructions and run by planck/vm; the image path is the first argument
use("pvm/image")

# println of R[x]
show(x) := [GETGLOBAL{30, 0}, MOVE{31, x}, CALL{30, 30, 1}]
# R[3] := bit_not(v), and bit_shr(a, b)
not_of(v) := concat_map(x -> x, [[GETGLOBAL{3, 1}, LOADI{4, v}, CALL{3, 3, 1}], show(3)])
shr_of(a, b) := concat_map(x -> x, [[GETGLOBAL{3, 2}, LOADI{4, a}, LOADI{5, b}, CALL{3, 3, 2}], show(3)])

# R[1] := 2^100, and the bit_not and bit_shr of it
big := [GETGLOBAL{1, 3}, LOADI{2, 1}, LOADI{3, 100}, CALL{1, 1, 2}]
big_not := concat_map(x -> x, [[GETGLOBAL{6, 1}, MOVE{7, 1}, CALL{6, 6, 1}], show(6), [GETGLOBAL{7, 1}, MOVE{8, 6}, CALL{7, 7, 1}], show(7)])
big_shr := concat_map(x -> x, [[GETGLOBAL{6, 2}, MOVE{7, 1}, LOADI{8, 98}, CALL{6, 6, 2}], show(6)])

body := concat_map(x -> x, [
    not_of(5), not_of(0),
    shr_of(1000, 3), shr_of(5, 0), shr_of(0, 7),
    big, big_not, big_shr,
    [LOADNONE{0, 1}, RET{0}]
])

main := Code{"main", 0, 40, body, [C{"println"}, C{"bit_not"}, C{"bit_shr"}, C{"bit_shl"}]}

write_file(array_get(argv(), 1), bytes.to_u8(pvm_image.build([main], "main")))
