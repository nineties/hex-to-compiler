# fib(20) on planckvm: the program is written with the instructions and run by planck/vm; the image path is the first argument
use("pvm/image")

fib := Code{"fib", 1, 5, [
    TLTI{0, 2, 0},
    JMP{'recur},
    RET{0},
    Label{'recur},
    GETGLOBAL{1, 0},
    LOADI{3, 1},
    SUB{2, 0, 3},
    CALL{1, 1, 1},
    GETGLOBAL{2, 0},
    LOADI{4, 2},
    SUB{3, 0, 4},
    CALL{2, 2, 1},
    ADD{1, 1, 2},
    RET{1}
], [C{"fib"}]}

main := Code{"main", 0, 2, [
    CLOSURE{0, 0},
    SETGLOBAL{0, 1},
    GETGLOBAL{0, 1},
    LOADI{1, 20},
    CALL{0, 0, 1},
    RET{0}
], [K{"fib"}, C{"fib"}]}

write_file(array_get(argv(), 1), bytes.to_u8(pvm_image.build([fib, main], "main")))
