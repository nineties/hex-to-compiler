# the edge of the immediate integers of planckvm (63 bits) and the big integers beyond: the program is written with the instructions and run by planck/vm; the image path is the first argument
use("pvm/image")

# println of R[x]
show(x) := [GETGLOBAL{20, 0}, MOVE{21, x}, CALL{20, 20, 1}]
cat(xs) := concat_map(x -> x, xs)

main := Code{"main", 0, 24, cat([
    # R4 = 2^62 is the first integer that is not an immediate; R5 = 2^62 - 1 is the last
    [LOADK{0, 1}, ADDI{1, 0, 1}, MUL{2, 1, 1}, LOADI{3, 8}, MUL{3, 2, 3}, ADD{4, 3, 3}, ADDI{5, 4, -1}], show(5), show(4),
    [ADDI{6, 5, 1}, EQ{7, 6, 4}], show(7),
    # the same on the negative side
    [LOADI{8, 0}, SUB{9, 8, 4}], show(9),
    [ADDI{10, 9, -1}], show(10),
    [ADDI{11, 10, 1}, EQ{12, 11, 9}], show(12),
    # the product of two immediates that is beyond 64 bits, and the product that is exactly 2^62
    [MUL{13, 5, 5}], show(13),
    [LOADI{14, -1}, MUL{15, 9, 14}], show(15),
    [SUB{16, 5, 9}], show(16),
    # the order of an immediate and a big integer
    [LT{17, 5, 4}], show(17),
    [LT{18, 4, 5}], show(18),
    # the division and the remainder
    [DIV{19, 4, 2}], show(19),
    [MOD{22, 5, 2}], show(22),
    [LOADNONE{0, 1}, RET{0}]
]), [C{"println"}, I{536870911}]}

write_file(array_get(argv(), 1), bytes.to_u8(pvm_image.build([main], "main")))
