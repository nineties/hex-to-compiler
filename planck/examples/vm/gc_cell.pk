# A big integer in a global variable of a program of pvm/compile survives the collections: the variable is a cell, and the collector copies the value of the cell
use("pvm/compile")
use("bytes")

body := `({
    pw(b, n) := {
        r := 1
        k := 0
        while (k < n) { r = r * b; k = k + 1 }
        r
    }
    big := pw(2, 100)
    i := 0
    a := []
    while (i < 1000000) { a = [i, i]; i = i + 1 }
    print(big % 1000003)
    put("\n")
    print(big == pw(2, 100))
    put("\n")
})

stmts(body) := {
    out := []
    i := arity(body) - 1
    while (i >= 0) { out = arg(body, i) :: out; i = i - 1 }
    out
}

write_file(array_get(argv(), 1), bytes.to_u8(pvm_compile.image(stmts(body))))
