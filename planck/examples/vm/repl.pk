# The read-eval-print loop on planckvm: the files of planck (the reader, the syntax and the libraries) and the compiler are compiled into one image,
# which reads the standard input (repl.in) line by line and evaluates each line in the running image
use("pvm/compile")
use("bytes")

# the expressions of a file, with the use of libraries and the load of planck0 left out, as the image has them already
is_use(Apply{f, Tuple{_}}) := f == 'use
is_use(_) := false
is_load(Def{n, _}) := n == 'load
is_load(_) := false
skip(Def{n, Quote{_}}) := n == 'true or n == 'false or n == 'none
skip(_) := false
file_exprs(path) := list.filter(e -> not (is_use(e) or skip(e) or is_load(e)), pvm_compile.parse_file(path))

# a macro at the top level is also added at run time
reg(e) := if (type(e) == Expr and head(e) == 'Macro)
    `Do{Set{_macro_on, true}, Set{_macro, Fusion{!expand_macro(arg(e, 0), 0), _macro}}}
else expand_macro(e, 0)

libs := ["base", "list", "table", "vector", "bytes", "string", "pvm/image", "pvm/compile", "pvm/link", "repl"]
boot := file_exprs("planck/lib/pvm/boot.pk")
planck_files := list.concat_map(file_exprs, ["planck/init.pk", "planck/lib/io.pk", "planck/peg.pk", "planck/syntax.pk"])
lib_files := list.concat_map(file_exprs, list.map(n -> f"planck/lib/{n}.pk", libs))
start := [`(_eval_expanded = pvm_link.eval_expanded), `(_real_eval = eval), `(repl.run())]

write_file(array_get(argv(), 1), bytes.to_u8(pvm_compile.image(list.map(reg, list.concat([boot, planck_files, lib_files, start])))))
