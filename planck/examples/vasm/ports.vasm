# ports: open, read and close read the file planck/examples/vasm/ports.txt (18 bytes) into an array that holds exactly them, write puts them out,
# and a second read at the end of the file gives 0. argc is 1 (only the name of the program) and argv(0) is that name, which is not empty.
# The status is 18 + 0 + 1 + 100 = 119
fun main() -> i64 {
    var fd: i64
    var buf: own [u8]
    var got: i64
    var rest: i64
    var name: &static [u8]
    var n: i64
    var k: i64
    fd = open("planck/examples/vasm/ports.txt")
    if (fd < 0) { return 1 }
    buf = allocate(18, 0)
    region r {
        var m: &mutable r [u8]
        m = &mutable r buf
        got = read(fd, m)
    }
    region q {
        var m: &mutable q [u8]
        m = &mutable q buf
        rest = read(fd, m)
    }
    close(fd)
    region s {
        var v: &s [u8]
        v = &s buf
        write(1, v)
    }
    n = got + rest
    k = argc()
    n = n + k
    name = argv(0)
    k = len(name)
    if (k > 0) { n = n + 100 }
    return n
}
