# if with else, bool values, and signed and unsigned comparisons: 0 - 1 as u32 is above 5 and -1 as i32 is not;
# the count is 1 (f) + 10 (f != g) + 1 + 2 + 3 (classify) = 17
fun classify(x: i32) -> i32 {
    var r: i32
    if (x < 0) {
        r = 1
    } else {
        if (x == 0) { r = 2 } else { r = 3 }
    }
    return r
}

fun main() -> i32 {
    var a: u32
    var b: i32
    var f: bool
    var g: bool
    var n: i32
    var c: i32
    a = 0
    a = a - 1
    b = -1
    n = 0
    f = a > 5
    g = b > 5
    if (f) { n = n + 1 }
    if (g) { n = n + 100 }
    if (f != g) { n = n + 10 }
    c = classify(-5)
    n = n + c
    c = classify(0)
    n = n + c
    c = classify(9)
    n = n + c
    return n
}
