# ten values are live at once, more than the registers there are, so some of them are kept on the stack; the sums in both orders are 55 each
fn main() -> i32 {
    var a: i32
    var b: i32
    var c: i32
    var d: i32
    var e: i32
    var f: i32
    var g: i32
    var h: i32
    var i: i32
    var j: i32
    var t: i32
    var u: i32
    a = 1
    b = 2
    c = 3
    d = 4
    e = 5
    f = 6
    g = 7
    h = 8
    i = 9
    j = 10
    t = a + b
    t = t + c
    t = t + d
    t = t + e
    t = t + f
    t = t + g
    t = t + h
    t = t + i
    t = t + j
    u = j + i
    u = u + h
    u = u + g
    u = u + f
    u = u + e
    u = u + d
    u = u + c
    u = u + b
    u = u + a
    t = t + u
    return t
}
