# exit ends the program with a status at once: the line is written to the file 1 and to the file 2 (the error output), the count of the bytes written is checked, and exit(n + 30) ends with 33; the code after it does not run
fun put3[r](s: &r [u8]) -> i64 {
    var a: i64
    var b: i64
    a = write(1, s)
    b = write(2, s)
    a = a + b
    return a
}

fun main() -> i64 {
    var a: own [u8]
    var n: i64
    a = allocate(3, 111)
    a[2] = 10
    region r {
        var b: &r [u8]
        b = &r a
        n = put3(b)
    }
    free(a)
    n = n - 3
    n = n + 30
    exit(n)
    return 1
}
