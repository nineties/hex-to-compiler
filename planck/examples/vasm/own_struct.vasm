# a struct that owns an array is moved to a function, which reads it and drops what is left: 10 elements of 7 add up to 70
struct Buf { data: own [u8], size: i64 }

fun make(n: i64) -> Buf {
    var d: own [u8]
    var b: Buf
    d = allocate(n, 7)
    b = Buf{data: d, size: n}
    return b
}

fun sum(b: Buf) -> i64 {
    var d: own [u8]
    var n: i64
    var i: i64
    var s: i64
    var c: u8
    var w: i64
    d = b.data
    n = b.size
    s = 0
    i = 0
    while (i < n) {
        c = d[i]
        w = c as i64
        s = s + w
        i = i + 1
    }
    return s
}

fun main() -> i64 {
    var b: Buf
    var t: i64
    b = make(10)
    t = sum(b)
    return t
}
