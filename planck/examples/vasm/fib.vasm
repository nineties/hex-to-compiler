# the 20th Fibonacci number, 6765, is 109 modulo 256
fn fib(n: i64) -> i64 {
    var a: i64
    var b: i64
    var t: i64
    if (n < 2) { return n }
    t = n - 1
    a = fib(t)
    t = n - 2
    b = fib(t)
    t = a + b
    return t
}

fn main() -> i64 {
    var r: i64
    r = fib(20)
    return r
}
