# a function adds 1 to the content of a box through a mutable borrow, twice: 41 becomes 43
fun bump[r](p: &mutable r i64) {
    var v: i64
    v = *p
    v = v + 1
    *p = v
}

fun main() -> i64 {
    var p: own i64
    var v: i64
    p = box(41)
    region r {
        var m: &mutable r i64
        m = &mutable r p
        bump(m)
        bump(m)
    }
    v = *p
    free(p)
    return v
}
