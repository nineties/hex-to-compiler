# a function adds 1 to the content of a box through a mutable borrow, twice: 41 becomes 43
fn bump[r](p: &mut r i64) {
    var v: i64
    v = *p
    v = v + 1
    *p = v
}

fn main() -> i64 {
    var p: own i64
    var v: i64
    p = box(41)
    region r {
        var m: &mut r i64
        m = &mut r p
        bump(m)
        bump(m)
    }
    v = *p
    free(p)
    return v
}
