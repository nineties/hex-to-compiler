# a box made in each round is dropped at the end of the block; the blocks are reused, so this runs in a small heap; the count is 3000, which is 184 modulo 256
fun main() -> i64 {
    var i: i64
    var n: i64
    i = 0
    n = 0
    while (i < 3000) {
        var p: own [i64]
        var v: i64
        p = allocate(100, 1)
        v = p[5]
        n = n + v
        i = i + 1
    }
    return n
}
