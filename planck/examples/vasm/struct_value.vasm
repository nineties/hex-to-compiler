# structs as values, as arguments and results, and in a box: (1, 2) + (10, 20) = (11, 22); the field x of the box is set to 100; 100 + 22 is 122
struct Pt { x: i32, y: i32 }

fun add(p: Pt, q: Pt) -> Pt {
    var ax: i32
    var bx: i32
    var ay: i32
    var by: i32
    var r: Pt
    ax = p.x
    bx = q.x
    ay = p.y
    by = q.y
    ax = ax + bx
    ay = ay + by
    r = Pt{x: ax, y: ay}
    return r
}

fun main() -> i32 {
    var p: Pt
    var q: Pt
    var r: Pt
    var s: own Pt
    var t: Pt
    var v: i32
    var w: i32
    p = Pt{x: 1, y: 2}
    q = Pt{x: 10, y: 20}
    r = add(p, q)
    s = box(r)
    t = *s
    s.x = 100
    v = s.x
    w = t.y
    free(s)
    v = v + w
    return v
}
