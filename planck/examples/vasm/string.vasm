# string literals: a literal is a borrow of region static (&static [u8]) that lasts to the end of the program; it is put in a register, returned, passed to a function with a region parameter, read by an index and measured by len, and "" has no bytes; "tab\there\n" is 9 bytes, "yes\n" 4 and "hello" 5, and the first byte is t (116), so the status is 5 + 4 + 9 + 0 + 100 = 118
fn pick(c: bool) -> &static [u8] {
    if (c) { return "yes\n" }
    return "no\n"
}

fn size[r](s: &r [u8]) -> i64 {
    var n: i64
    n = len(s)
    return n
}

fn main() -> i64 {
    var s: &static [u8]
    var t: &static [u8]
    var u: &static [u8]
    var e: &static [u8]
    var n: i64
    var k: i64
    var c: u8
    s = "tab\there\n"
    t = pick(true)
    u = pick(false)
    e = ""
    write(1, s)
    write(1, t)
    write(1, u)
    write(1, e)
    n = size("hello")
    k = size(t)
    n = n + k
    k = size(s)
    n = n + k
    k = len(e)
    n = n + k
    c = s[0]
    if (c == 116) { n = n + 100 }
    return n
}
