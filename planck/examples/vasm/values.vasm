# a list, a function value that keeps a value, and an array of val; the status is the sum
fn add(c: val, x: val) -> val {
    var a: i64
    var b: i64
    var r: val
    a = c as i64
    b = x as i64
    a = a + b
    r = a as val
    return r
}

fn sum(l: val) -> i64 {
    var t: bool
    var h: val
    var rest: val
    var n: i64
    var s: i64
    t = is(l, 'Nil, 0)
    if (t) { return 0 }
    h = l[0]
    rest = l[1]
    n = h as i64
    s = sum(rest)
    s = s + n
    return s
}

fn main() -> i32 {
    var l: val
    var a: val
    var f: val
    var t: val
    var s: i64
    var r: i32
    var same: bool
    l = val Nil()
    a = 7 as val
    l = val Cons(a, l)
    a = 35 as val
    l = val Cons(a, l)
    s = sum(l)
    a = 40 as val
    f = fn add(a)
    a = s as val
    a = f(a)
    t = array(2, 'none)
    t[1] = a
    a = t[1]
    same = a == a
    if (same) { s = a as i64 } else { s = 0 }
    r = s as i32
    return r
}
