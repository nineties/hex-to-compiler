# a list, a function value that keeps a value, and an array of value; the status is the sum
fun add(c: value, x: value) -> value {
    var a: i64
    var b: i64
    var r: value
    a = c as i64
    b = x as i64
    a = a + b
    r = a as value
    return r
}

fun sum(l: value) -> i64 {
    var t: bool
    var h: value
    var rest: value
    var n: i64
    var s: i64
    t = is(l, 'Nil, 0)
    if (t) { return 0 }
    h = l[0]
    rest = l[1]
    n = h as i64
    s = sum(rest)
    s = s + n
    return s
}

fun main() -> i32 {
    var l: value
    var a: value
    var f: value
    var t: value
    var s: i64
    var r: i32
    var same: bool
    l = value Nil()
    a = 7 as value
    l = value Cons(a, l)
    a = 35 as value
    l = value Cons(a, l)
    s = sum(l)
    a = 40 as value
    f = fun add(a)
    a = s as value
    a = f(a)
    t = array(2, 'none)
    t[1] = a
    a = t[1]
    same = a == a
    if (same) { s = a as i64 } else { s = 0 }
    r = s as i32
    return r
}
