# u8 wraps around: 250 + 10 is 4; i8 -100 - 100 is 56; the sum 4 + 56 + 3 is 63
fun wrap_u8() -> u8 {
    var x: u8
    x = 250
    x = x + 10
    return x
}

fun wrap_i8() -> i8 {
    var x: i8
    x = -100
    x = x - 100
    return x
}

fun main() -> i32 {
    var a: u8
    var b: i8
    var s: i32
    var t: i32
    a = wrap_u8()
    b = wrap_i8()
    s = a as i32
    t = b as i32
    s = s + t
    s = s + 3
    return s
}
