# shifts of 64-bit values by a constant and by a register: (1 << 40) >> 38 is 4; -256 >> 4 is -16; 4 + -16 + 252 is 240
fun main() -> i64 {
    var x: u64
    var y: u64
    var n: u64
    var k: u64
    var z: i64
    var w: i64
    var s: i64
    x = 1
    n = 40
    x = x << n
    k = 38
    y = x >> k
    z = -256
    w = z >> 4
    s = y as i64
    s = s + w
    s = s + 252
    return s
}
