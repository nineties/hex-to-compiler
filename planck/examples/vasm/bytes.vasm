# u8 and u16 elements and fields: a u8 array of 5 filled with 200, a u16 value 60000 made by shifts; (200 + 200) as u8 is 144, and 15000 << 2 as u16 is 60000, whose high byte is 234 (60000 = 234 * 256 + 96); the answer is 144 + 96 = 240
struct Pair { lo: u8, hi: u16 }

fun main() -> u32 {
    var a: own [u8]
    var x: u8
    var y: u8
    var p: Pair
    var w: u16
    var q: own Pair
    var z: u16
    var r: u32
    var m: u32
    a = allocate(5, 200)
    x = a[1]
    y = a[4]
    x = x + y
    w = 15000
    w = w << 2
    p = Pair{lo: x, hi: w}
    q = box(p)
    z = q.hi
    z = z & 255
    free(q)
    free(a)
    r = x as u32
    m = z as u32
    r = r + m
    return r
}
