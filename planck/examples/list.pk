" Lists made of Cons{head, tail} and Nil{} "

" An m-expr whose head is not a builtin form is a constructor: "
" Cons{1, Nil{}} evaluates its arguments and builds the m-expr. "

Def{range, none}
Set{range, Lambda{Tuple{a, b},
    If{Apply{_ge, Tuple{a, b}},
        Nil{},
        Cons{a, Apply{range, Tuple{Apply{_add, Tuple{a, 1}}, b}}}}}}

Def{map, none}
Set{map, Fusion{
    Lambda{Tuple{f, Nil{}}, Nil{}},
    Lambda{Tuple{f, Cons{x, xs}}, Cons{Apply{f, Tuple{x}}, Apply{map, Tuple{f, xs}}}}}}

Def{filter, none}
Set{filter, Fusion{
    Lambda{Tuple{p, Nil{}}, Nil{}},
    Lambda{Tuple{p, Cons{x, xs}},
        If{Apply{p, Tuple{x}},
            Cons{x, Apply{filter, Tuple{p, xs}}},
            Apply{filter, Tuple{p, xs}}}}}}

Def{foldl, none}
Set{foldl, Fusion{
    Lambda{Tuple{f, acc, Nil{}}, acc},
    Lambda{Tuple{f, acc, Cons{x, xs}}, Apply{foldl, Tuple{f, Apply{f, Tuple{acc, x}}, xs}}}}}

Def{append, none}
Set{append, Fusion{
    Lambda{Tuple{Nil{}, ys}, ys},
    Lambda{Tuple{Cons{x, xs}, ys}, Cons{x, Apply{append, Tuple{xs, ys}}}}}}

Def{reverse, Lambda{Tuple{xs},
    Apply{foldl, Tuple{Lambda{Tuple{acc, x}, Cons{x, acc}}, Nil{}, xs}}}}

Def{length, Lambda{Tuple{xs},
    Apply{foldl, Tuple{Lambda{Tuple{n, _}, Apply{_add, Tuple{n, 1}}}, 0, xs}}}}

Def{sum, Lambda{Tuple{xs}, Apply{foldl, Tuple{_add, 0, xs}}}}

Def{qsort, none}
Set{qsort, Fusion{
    Lambda{Tuple{Nil{}}, Nil{}},
    Lambda{Tuple{Cons{p, xs}}, Apply{append, Tuple{
        Apply{qsort, Tuple{Apply{filter, Tuple{Lambda{Tuple{x}, Apply{_lt, Tuple{x, p}}}, xs}}}},
        Cons{p, Apply{qsort, Tuple{Apply{filter, Tuple{Lambda{Tuple{x}, Apply{_ge, Tuple{x, p}}}, xs}}}}}}}}}}

" print a list as [x, y, ...] "
Def{print_elems, none}
Set{print_elems, Fusion{Fusion{
    Lambda{Tuple{Nil{}}, none},
    Lambda{Tuple{Cons{x, Nil{}}}, Apply{print, Tuple{x}}}},
    Lambda{Tuple{Cons{x, xs}}, Do{
        Apply{print, Tuple{x}},
        Apply{put, Tuple{", "}},
        Apply{print_elems, Tuple{xs}}}}}}
Def{show, Lambda{Tuple{label, xs}, Do{
    Apply{put, Tuple{label}},
    Apply{put, Tuple{"["}},
    Apply{print_elems, Tuple{xs}},
    Apply{put, Tuple{"]\n"}}}}}

Def{xs, Apply{range, Tuple{1, 11}}}
Apply{show, Tuple{"xs      = ", xs}}
Apply{show, Tuple{"squares = ", Apply{map, Tuple{Lambda{Tuple{x}, Apply{_mul, Tuple{x, x}}}, xs}}}}
Apply{show, Tuple{"evens   = ", Apply{filter, Tuple{Lambda{Tuple{x}, Apply{_eq, Tuple{Apply{_mod, Tuple{x, 2}}, 0}}}, xs}}}}
Apply{show, Tuple{"reverse = ", Apply{reverse, Tuple{xs}}}}
Apply{put, Tuple{"length  = "}} Apply{println, Tuple{Apply{length, Tuple{xs}}}}
Apply{put, Tuple{"sum     = "}} Apply{println, Tuple{Apply{sum, Tuple{xs}}}}

Def{ys, Cons{31, Cons{4, Cons{15, Cons{9, Cons{26, Cons{5, Cons{3, Cons{5, Nil{}}}}}}}}}}
Apply{show, Tuple{"ys      = ", ys}}
Apply{show, Tuple{"sorted  = ", Apply{qsort, Tuple{ys}}}}
Apply{println, Tuple{Apply{range, Tuple{1, 4}}}}
