# Lists made of Cons{head, tail} and Nil{}, written x :: xs and []

# An m-expr whose head is not a builtin form is a constructor:
# Cons{1, Nil{}} evaluates its arguments and builds the m-expr.

range(a, b) := if (a >= b) [] else a :: range(a + 1, b)

fun map
map = (f, Nil{}) -> []
    | (f, x :: xs) -> f(x) :: map(f, xs)

fun filter
filter = (p, Nil{}) -> []
       | (p, x :: xs) -> if (p(x)) x :: filter(p, xs) else filter(p, xs)

fun foldl
foldl = (f, acc, Nil{}) -> acc
      | (f, acc, x :: xs) -> foldl(f, f(acc, x), xs)

fun append
append = (Nil{}, ys) -> ys
       | (x :: xs, ys) -> x :: append(xs, ys)

reverse(xs) := foldl((acc, x) -> x :: acc, [], xs)

length(xs) := foldl((n, _) -> n + 1, 0, xs)

sum(xs) := foldl(_add, 0, xs)

fun qsort
qsort = (Nil{}) -> []
      | (p :: xs) -> append(qsort(filter(x -> x < p, xs)), p :: qsort(filter(x -> x >= p, xs)))

# print a list as [x, y, ...]
fun print_elems
print_elems = (Nil{}) -> none
            | (x :: Nil{}) -> print(x)
            | (x :: xs) -> {
    print(x)
    put(", ")
    print_elems(xs)
}
show(label, xs) := {
    put(label)
    put("[")
    print_elems(xs)
    put("]\n")
}

xs := range(1, 11)
show("xs      = ", xs)
show("squares = ", map(x -> x * x, xs))
show("evens   = ", filter(x -> x % 2 == 0, xs))
show("reverse = ", reverse(xs))
put("length  = "); println(length(xs))
put("sum     = "); println(sum(xs))

ys := [31, 4, 15, 9, 26, 5, 3, 5]
show("ys      = ", ys)
show("sorted  = ", qsort(ys))
println(range(1, 4))
