" State by an effect, without mutable variables "

" run_state{f, init} runs f with the state init and returns Tuple{result, state}. "
" The handler returns a function which takes the current state. "
Def{run_state, Lambda{Tuple{f, init},
    Apply{
        Handle{
            Do{Def{r, Apply{f, Tuple{}}}, Lambda{Tuple{s}, Tuple{r, s}}},
            Fusion{
                Lambda{Tuple{Get{}, k}, Lambda{Tuple{s}, Apply{Apply{k, Tuple{s}}, Tuple{s}}}},
                Lambda{Tuple{Put{v}, k}, Lambda{Tuple{s}, Apply{Apply{k, Tuple{none}}, Tuple{v}}}}}},
        Tuple{init}}}}

Def{get, Lambda{Tuple{}, Perform{Get{}}}}
Def{put_state, Lambda{Tuple{v}, Perform{Put{v}}}}

" a counter "
Def{tick, Lambda{Tuple{}, Do{
    Def{n, Apply{get, Tuple{}}},
    Apply{put_state, Tuple{Apply{add, Tuple{n, 1}}}},
    n}}}

Apply{println, Tuple{Apply{run_state, Tuple{Lambda{Tuple{}, Do{
    Apply{tick, Tuple{}},
    Apply{tick, Tuple{}},
    Apply{tick, Tuple{}},
    Apply{mul, Tuple{Apply{get, Tuple{}}, 10}}}}, 0}}}}

" number the nodes of a tree from left to right "
Def{label, Fusion{
    Lambda{Tuple{Leaf{}}, Leaf{}},
    Lambda{Tuple{Node{l, v, r}}, Do{
        Def{l2, Apply{label, Tuple{l}}},
        Def{i, Apply{tick, Tuple{}}},
        Node{l2, Tuple{i, v}, Apply{label, Tuple{r}}}}}}}

Def{tree, Node{Node{Leaf{}, "a", Leaf{}}, "b", Node{Node{Leaf{}, "c", Leaf{}}, "d", Leaf{}}}}
Apply{println, Tuple{Apply{run_state, Tuple{Lambda{Tuple{}, Apply{label, Tuple{tree}}}, 100}}}}
