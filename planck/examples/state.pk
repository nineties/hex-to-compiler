# State by an effect, without mutable variables

# run_state(f, init) runs f with the state init and returns (result, state).
# The handler returns a function which takes the current state.
run_state(f, init) := {
    g := handle {
        r := f()
        s -> (r, s)
    } with (Get{}, k) -> (s -> k(s)(s))
         | (Put{v}, k) -> (s -> k(none)(v))
    g(init)
}

get() := perform Get{}
put_state(v) := perform Put{v}

# a counter
tick() := {
    n := get()
    put_state(n + 1)
    n
}

println(run_state(() -> {
    tick()
    tick()
    tick()
    get() * 10
}, 0))

# number the nodes of a tree from left to right
fun label
label = (Leaf{}) -> Leaf{}
      | (Node{l, v, r}) -> {
    l2 := label(l)
    i := tick()
    Node{l2, (i, v), label(r)}
}

tree := Node{Node{Leaf{}, "a", Leaf{}}, "b", Node{Node{Leaf{}, "c", Leaf{}}, "d", Leaf{}}}
println(run_state(() -> label(tree), 100))
