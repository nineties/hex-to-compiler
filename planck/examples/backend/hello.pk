# hello: an executable made from instructions of ir.pk without vasm: it writes a line and ends with status 0
# Copyright (C) 2026 nineties
#
# planck0 planck/examples/backend/hello.pk <output> [<target>]
# The target is a name of backend/target.pk of the word 8; the default target is used without it.

use("backend/target")
use("table")
use("bytes")

t := target.get(if (array_len(argv()) > 2) intern(argv()[2]) else target.default)

msg := "Hello, world!\n"

start := ir.fn("_start")
fd := ir.vreg(start, 64)
p := ir.vreg(start, 64)
n := ir.vreg(start, 64)
r := ir.vreg(start, 64)
st := ir.vreg(start, 64)
z := ir.vreg(start, 64)
ir.emit(start, I{'li, [D{fd}, K{1}]})
ir.emit(start, I{'la, [D{p}, S{"msg", 0}]})
ir.emit(start, I{'li, [D{n}, K{strlen(msg)}]})
ir.emit(start, I{'os, [N{'write}, Us{[fd, p, n]}, D{r}]})
ir.emit(start, I{'li, [D{st}, K{0}]})
ir.emit(start, I{'os, [N{'exit}, Us{[st]}, D{z}]})
ir.emit(start, I{'trap, []})

text := bytes.new()
bytes.string(text, msg)
object := target.compile(t, "hello", [target.lower(t, start, table.new())], [IRData{"msg", ".rodata", 1, text, false}])
write_file(argv()[1], bytes.to_u8(target.executable(t, [object])))
chmod(argv()[1], 493)
