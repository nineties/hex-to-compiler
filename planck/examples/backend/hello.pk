# hello: an executable made from instructions of ir.pk without vasm: it writes a line and ends with status 0
# Copyright (C) 2026 nineties
#
# planck0 planck/examples/backend/hello.pk <output>

use("backend/x64")
use("backend/link")
use("backend/elf")

msg := "Hello, world!\n"

start := ir.fn("_start")
fd := ir.vreg(start, 64)
p := ir.vreg(start, 64)
n := ir.vreg(start, 64)
r := ir.vreg(start, 64)
st := ir.vreg(start, 64)
z := ir.vreg(start, 64)
ir.emit(start, I{'li, [D{fd}, K{1}]})
ir.emit(start, I{'la, [D{p}, S{"msg", 0}]})
ir.emit(start, I{'li, [D{n}, K{strlen(msg)}]})
ir.emit(start, I{'os, [N{'write}, Us{[fd, p, n]}, D{r}]})
ir.emit(start, I{'li, [D{st}, K{0}]})
ir.emit(start, I{'os, [N{'exit}, Us{[st]}, D{z}]})
ir.emit(start, I{'trap, []})

text := bytes.new()
bytes.string(text, msg)
object := x64.compile("hello", [start], [IRData{"msg", ".rodata", 1, text, false}])
image := linker.link([object], "_start", 4194304, elf.header_size(2))
elf.write(argv()[1], 'x86_64, arg(image, 0), arg(image, 1))
