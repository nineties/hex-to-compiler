# hello: an executable made from instructions of ir.pk without vasm: it writes a line and ends with status 0
# Copyright (C) 2026 nineties
#
# planck0 planck/examples/backend/hello.pk <output>

use("backend/x64")
use("backend/link")
use("backend/elf")

msg := "Hello, world!\n"

start := ir_fn("_start")
fd := ir_vreg(start, 64)
p := ir_vreg(start, 64)
n := ir_vreg(start, 64)
r := ir_vreg(start, 64)
st := ir_vreg(start, 64)
z := ir_vreg(start, 64)
ir_emit(start, I{'li, [D{fd}, K{1}]})
ir_emit(start, I{'la, [D{p}, S{"msg", 0}]})
ir_emit(start, I{'li, [D{n}, K{strlen(msg)}]})
ir_emit(start, I{'os, [N{'write}, Us{[fd, p, n]}, D{r}]})
ir_emit(start, I{'li, [D{st}, K{0}]})
ir_emit(start, I{'os, [N{'exit}, Us{[st]}, D{z}]})
ir_emit(start, I{'trap, []})

text := bytes.new()
bytes.str(text, msg)
obj := x64_compile("hello", [start], [IRData{"msg", ".rodata", 1, text, false}])
img := link([obj], "_start", 4194304, elf64_hdr_size(2))
elf64_write(argv()[1], 'x86_64, arg(img, 0), arg(img, 1))
