# a..b is the value Range{a, b}: the integers from a to b, including b

use("list")

r := 1..4
println(r)
println(arg(r, 0) + arg(r, 1))

# for goes through the integers of a range
total := 0
for (i in 1..10) total = total + i
println(total)

# the ends are expressions; a..b binds looser than + and -
n := 3
for (i in n - 1..n + 1) { put("i = "); println(i) }

# a range with the end below the start is empty
for (i in 5..4) println("never")

# a list of the integers of a range
nums := []
for (i in 0..5) nums = i :: nums
println(reverse(nums))
