# with makes a copy of a data of a record type in which some fields are replaced

record Point(x, y) = point
record Circle(center, radius) = circle

p := point(1, 2)
q := p with { y = 5 }
println(p)
println(q)

# several fields, in one with or in a chain
println(p with { x = 10, y = 20 })
println(p with { x = 7 } with { y = 8 })

# the value of a field can use the original record
c := circle(p, 3)
d := c with { center = c.center with { x = c.radius } }
println(d)
println(c)
