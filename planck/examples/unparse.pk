# Print syntax trees back as text. The printer is made from the grammar that parses them:
# parse, print and parse again give the same tree.
use("unparse")

tree(s) := arg(peg_parse('toplevel, s), 0)
say(s) := { put(s); put("\n") }

trip(s) := {
    t := tree(s)
    out := unparse(t)
    say(strcat("input:  ", s))
    put("tree:   "); println(t)
    say(strcat("output: ", out))
    put("same tree: "); println(tree(out) == t)
    say("")
}

trip("1+2*3")
trip("((1 + 2)) * 3")
trip("a - (b - c)")
trip("-(x + 1) * f(y, 2)")
trip("x->y->x+y")
trip("not (a and b) or c")

# a block is one expression to a line, indented
out := unparse(tree("f(n) := { s := 0; while (n > 0) { s = s + n; n = n - 1 }; s }"))
say(out)
println(tree(out) == tree("f(n) := { s := 0; while (n > 0) { s = s + n; n = n - 1 }; s }"))
say("")

# a tree that was not made by the parser
say(unparse('Apply{mul, Tuple{Apply{add, Tuple{1, 2}}, 3}}))
say("")

# a grammar written with ::= is run backwards too
arith ::= a:arith "+" b:term { `Apply{add, Tuple{!a, !b}} } | a:arith "-" b:term { `Apply{sub, Tuple{!a, !b}} } | term
term ::= a:term "*" b:factor { `Apply{mul, Tuple{!a, !b}} } | factor
factor ::= n:integer { n } | x:ident { x } | "(" e:arith ")" { e }
t := arg(peg_parse('arith, "1+(2+3)*x"), 0)
println(t)
say(unparse_as('arith, t))
say(unparse_as('arith, 'Apply{mul, Tuple{Apply{sub, Tuple{a, 1}}, Apply{add, Tuple{b, 2}}}}))
