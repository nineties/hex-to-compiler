# Patterns with or, and a guard on a definition

# p or q matches a value that p or q matches
size(0 or 1) := "small"
size(_) := "big"

# the alternatives can be anywhere in a pattern
kind(F{1 or 2, x}) := "F with a small first"
kind(_) := "other"

# f(x) if c := e is used when x matches and c is true; the next definitions of f are tried otherwise
sign(x) if x > 0 := "positive"
sign(0) := "zero"
sign(_) := "negative"

# a name written twice matches two values that are ==
same(a, a) := "same"
same(_, _) := "differ"

# an or binds variables when every alternative binds the same ones
origin((x, 0) or (0, x)) := x
origin(_) := "none"

for (n in [0, 1, 2]) println(size(n))
println(kind(F{2, 0}))
println(kind(F{3, 0}))
for (n in [5, 0, -5]) println(sign(n))
println(same([1], [1]))
println(same([1], [2]))
for (v in [(3, 0), (0, 4), (1, 2)]) println(origin(v))
