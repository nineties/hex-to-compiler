# mulhi(a, b) is the upper 64 bits of the product of two unsigned 64-bit integers; the status is the number of wrong results
fn check(got: u64, want: u64) -> i64 {
    if got != want { return 1 }
    0
}

fn main() -> i64 {
    var bad: i64
    bad = 0
    bad += check(mulhi(0, 12345), 0)
    bad += check(mulhi(1, 18446744073709551615), 0)
    bad += check(mulhi(9223372036854775808, 2), 1)
    bad += check(mulhi(4294967296, 4294967296), 1)
    bad += check(mulhi(4294967295, 4294967295), 0)
    bad += check(mulhi(18446744073709551615, 1), 0)
    bad += check(mulhi(18446744073709551615, 2), 1)
    bad += check(mulhi(18446744073709551615, 18446744073709551615), 18446744073709551614)
    bad += check(mulhi(1311768467463790320, 1070935975390360080), 76155447138870049)
    bad += check(mulhi(18364758544493064720, 18364758544493064720), 18283137395406428876)
    bad += check(mulhi(9223372036854775809, 9223372036854775809), 4611686018427387905)
    bad += check(mulhi(18446744069414584320, 8589934591), 8589934589)
    bad
}
