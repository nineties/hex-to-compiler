# f64 and f32: each result is compared with the bits that C's double and float give; the status is the number of results that differ (0)
fn check(x: f64, want: u64, s: &static [u8]) -> i64 {
    if f64_bits(x) == want { return 0 }
    write(1, s)
    write(1, "\n")
    1
}

fn checks(x: f32, want: u32, s: &static [u8]) -> i64 {
    if f32_bits(x) == want { return 0 }
    write(1, s)
    write(1, "\n")
    1
}

fn checki(x: i64, want: i64, s: &static [u8]) -> i64 {
    if x == want { return 0 }
    write(1, s)
    write(1, "\n")
    1
}

fn main() -> i64 {
    var bad: i64
    bad = 0
    let a = 0.1
    let b = 0.2
    let big: u64 = 18446744073709551615
    let half: u64 = 9223372036854775808
    bad += check(a + b, 4599075939470750516, "a + b")
    bad += check(a * b, 4581421828931458172, "a * b")
    bad += check(1.0 / 3.0, 4599676419421066581, "1.0 / 3.0")
    bad += check(a - b, 13815242216921733530, "a - b")
    bad += check(-a, 13815242216921733530, "-a")
    bad += check(f64_sqrt(2.0), 4609047870845172685, "f64_sqrt(2.0)")
    bad += check(1.0e-3, 4562254508917369340, "1.0e-3")
    bad += check(123456789.125, 4728057454355546112, "123456789.125")
    bad += check(7 as f64 / 2.0, 4615063718147915776, "7 as f64 / 2.0")
    bad += check(-5 as f64, 13840687554816376832, "-5 as f64")
    bad += check(big as f64, 4895412794951729152, "big as f64")
    bad += check(0.0 * -1.0, 9223372036854775808, "0.0 * -1.0")
    bad += checki(2.9 as i64, 2, "2.9 as i64")
    bad += checki(-2.9 as i64, -2, "-2.9 as i64")
    bad += checki(3000000000.5 as i64, 3000000000, "3000000000.5 as i64")
    bad += checki(half as f64 as u64 as i64, -9223372036854775808, "half as f64 as u64 as i64")
    bad += checki(300.7 as u8 as i64, 44, "300.7 as u8 as i64")
    let c: f32 = 0.1
    let d: f32 = 3.0
    bad += checks(c * d, 1050253722, "c * d")
    bad += checks(c / d, 1023969417, "c / d")
    bad += checks(f32_sqrt(2.0), 1068827891, "f32_sqrt(2.0)")
    bad += checks(a as f32, 1036831949, "a as f32")
    bad += check(c as f64, 4591870180174331904, "c as f64")
    let nan = 0.0 / 0.0
    var s: i64
    s = 0
    if a < b { s += 1 }
    if a <= a { s += 2 }
    if b > a { s += 4 }
    if nan == nan { s += 8 }
    if nan != nan { s += 16 }
    if nan < a { s += 32 }
    if a >= b { s += 64 }
    bad += checki(s, 23, "comparisons")
    bad += check(f64_from_bits(4607182418800017408), 4607182418800017408, "from_bits")
    bad
}
