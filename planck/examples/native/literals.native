# integer literals beyond -32768 to 32767 take the type that the context gives; the status is 0
fun main() -> i64 {
    let a: i64 = 0x123456789
    let b: i64 = 4886718345
    let c: i32 = -2147483648
    let d: u32 = 4294967295
    let e: i32 = 100000
    var bad: i64
    bad = 0
    if a != b { bad += 1 }
    if c + 1 != -2147483647 { bad += 2 }
    if (d as i64) != 4294967295 { bad += 4 }
    if e != 100000 { bad += 8 }
    if e * 2 != 200000 { bad += 16 }
    bad
}
