# a heap is an array of words: word 0 is the next free index, a cell is two words (a value and the index of the next cell, 0 for none).
# A list of 1 to 6 is built in the heap, added up and reversed; the status is 21 + 1 = 22
fun cell[r](m: &mutable r [i64], v: i64, next: i64) -> i64 {
    let at = m[0]
    m[at] = v
    m[at + 1] = next
    m[0] += 2
    at
}

fun sum[r](m: &mutable r [i64], head: i64) -> i64 {
    var s: i64
    s = 0
    var p: i64
    p = head
    while p != 0 {
        s += m[p]
        p = m[p + 1]
    }
    s
}

fun reverse[r](m: &mutable r [i64], head: i64) -> i64 {
    var out: i64
    out = 0
    var p: i64
    p = head
    while p != 0 {
        let next = m[p + 1]
        m[p + 1] = out
        out = p
        p = next
    }
    out
}

fun main() -> i64 {
    var heap: own [i64]
    heap = allocate(0x80000, 0 as i64)
    var s: i64
    var first: i64
    region r {
        var m: &mutable r [i64]
        m = &mutable r heap
        m[0] = 1
        var head: i64
        head = 0
        for i in 1 as i64..7 {
            head = cell(m, i, head)
        }
        s = sum(m, head)
        head = reverse(m, head)
        first = m[head]
    }
    free(heap)
    s + first
}
