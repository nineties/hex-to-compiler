# the squares of 0 to 7 are put in an array and added with for and +=; the status is 140
fun sq(x: i64) -> i64 {
    x * x
}

fun main() -> i64 {
    let n: i64 = 8
    let a = allocate(8, 0 as i64)
    for i in 0 as i64..n {
        a[i] = sq(i)
    }
    var s: i64
    s = 0
    for i in 0 as i64..n {
        s += a[i]
    }
    free(a)
    s
}
