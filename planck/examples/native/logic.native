# and / or compute the right operand only when the left does not decide; the output shows which calls run; the status is 14
fun say(s: &static [u8], r: bool) -> bool {
    write(1, s)
    r
}

fun main() -> i64 {
    let a = say("a", false) and say("b", true)
    let b = say("c", true) or say("d", true)
    let c = say("e", true) and say("f", true)
    let d = say("g", false) or say("h", false)
    var s: i64
    s = 0
    if a { s += 1 }
    if b { s += 2 }
    if c { s += 4 }
    if not d { s += 8 }
    write(1, "\n")
    s
}
