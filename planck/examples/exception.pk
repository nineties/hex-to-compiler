# Exceptions by an effect

safe_div(a, b) := if (b == 0) perform Raise{"division by zero"} else a / b

# try(f) returns Ok{value} or Error{message}.
# The handler does not resume the continuation.
try(f) := handle Ok{f()} with (Raise{msg}, k) -> Error{msg}

println(try(() -> safe_div(10, 2)))
println(try(() -> safe_div(10, 0)))

# The computation after the error is skipped.
println(try(() -> {
    put("before\n")
    safe_div(1, 0)
    put("after\n")
}))

# A handler can also recover by resuming with a default value.
with_default(v, f) := handle f() with (Raise{_}, k) -> k(v)
println(with_default(0, () -> safe_div(10, 0) + safe_div(10, 5)))

# Effects not handled by the inner handler go to the outer one.
println(try(() ->
    handle (perform Ask{}) + safe_div(1, 0) with (Ask{}, k) -> k(1)))
