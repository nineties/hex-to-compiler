use("unparse")

tree(s) := arg(peg_parse('toplevel, s), 0)
say(s) := { print(s) }

trip(s) := {
    t := tree(s)
    out := unparse.text(t)
    say(_strcat("input:  ", s))
    print(f"tree:   {t}")
    say(_strcat("output: ", out))
    print(f"same tree: {tree(out) == t}")
    say("")
}

trip("1.5")
trip("-0.25")
trip("1.5e-3")
trip("2.0E10")
trip("x * 1.5 + f(2.5)")

half() := 0.5
say("half is defined")
