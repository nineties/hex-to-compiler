# A floating-point number is written with a point: 1.5, -0.25 and 1.5e-3 (the exponent is e or E).
# The syntax reads it to a call of _float with the text of the number, and the printer writes the text back.
use("unparse")

tree(s) := arg(peg_parse('toplevel, s), 0)
say(s) := { put(s); put("\n") }

trip(s) := {
    t := tree(s)
    out := unparse.text(t)
    say(_strcat("input:  ", s))
    put("tree:   "); println(t)
    say(_strcat("output: ", out))
    put("same tree: "); println(tree(out) == t)
    say("")
}

trip("1.5")
trip("-0.25")
trip("1.5e-3")
trip("2.0E10")
trip("x * 1.5 + f(2.5)")

# the number is made when the expression is run, so a function that has one can be defined
half() := 0.5
say("half is defined")
