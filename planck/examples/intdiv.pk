# The operator // is the integer division, and / % go along with it

println(7 // 2)
println(8 // 2)
println(-8 // 2)
println(-7 // -2)
println(-7 // 2)
println(7 // -2)
println((-7 // 2 * 2 + -7 % 2, -7 % 2, 7 % -2))
println(0 // 5)
println(1 + 7 // 2 * 2)
println(100 // 7 // 2)

fun digits
digits(0) := 0
digits(n) := 1 + digits(n // 10)
println(digits(12345))

q := 17 // 5
println((q, 17 - q * 5, 17 % 5))
