# x += e is x = x + e. The same goes for -=, *=, /= and %=.

x := 10
x += 5
println(x)
x -= 3
println(x)
x *= 2
println(x)
x /= 4
println(x)
x %= 4
println(x)

# the element of an array
a := array(3)
a[0] = 1
a[1] = 2
a[2] = 3
a[1] *= 10
a[2] += a[1]
println(Tuple{a[0], a[1], a[2]})

# the index is evaluated once
n := 0
next() := {
    n += 1
    n - 1
}
a[next()] += 100
println(Tuple{a[0], a[1], n})

# in a loop
sum := 0
i := 1
while (i <= 10) {
    sum += i
    i += 1
}
println(sum)
