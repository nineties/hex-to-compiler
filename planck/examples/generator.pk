# Generators by an effect

# walk a binary tree and Yield each value
fun walk
walk = (Leaf{}) -> none
     | (Node{l, v, r}) -> {
    walk(l)
    perform Yield{v}
    walk(r)
}

leaf(v) := Node{Leaf{}, v, Leaf{}}
t1 := Node{Node{leaf(1), 2, leaf(3)}, 4, leaf(5)}
t2 := Node{leaf(1), 2, Node{leaf(3), 4, leaf(5)}}
t3 := Node{leaf(1), 2, Node{leaf(3), 4, leaf(6)}}

# print each value
handle walk(t1) with (Yield{v}, k) -> {
    put("yield ")
    println(v)
    k(none)
}

# collect values into a list
to_list(t) := handle { walk(t); [] } with (Yield{v}, k) -> v :: k(none)
println(to_list(t1))

# take the first n values and stop walking
take(n, t) := {
    count := 0
    handle { walk(t); [] } with (Yield{v}, k) ->
        if (count < n) {
            count = count + 1
            v :: k(none)
        } else []
}
println(take(2, t1))

# an iterator: Next{value, continuation} or Done{}
iter(t) := handle { walk(t); Done{} } with (Yield{v}, k) -> Next{v, k}

# same fringe problem: compare two trees value by value
fun same_iter
same_iter = (Done{}, Done{}) -> true
          | (Next{a, k1}, Next{b, k2}) -> a == b ? same_iter(k1(none), k2(none)) : false
          | (_, _) -> false
same_fringe(a, b) := same_iter(iter(a), iter(b))

put("same_fringe(t1, t2) = ")
println(same_fringe(t1, t2))
put("same_fringe(t1, t3) = ")
println(same_fringe(t1, t3))
