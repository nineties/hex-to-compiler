# A command that reads its options with getopt. Run as: planck0 planck/examples/greet.pk -s -n 2 Ann Bob
# Without arguments it reads the fixed ones below, so that the output is always the same.
use("list")
use("table")
use("getopt")
use("string")
use("pretty")

say(s) := { put(s); put("\n") }

spec := [Opt{"n", "times", true}, Opt{"s", "shout", false}, Opt{"h", "help", false}]

greet(opts, name) := {
    text := _strcat(_strcat("Hello, ", name), if (table.has(opts, "shout")) "!!" else ".")
    i := 0
    while (i < string.str_to_int(table.get(opts, "times", "1"))) {
        say(text)
        i = i + 1
    }
}

main(args) := {
    r := getopt.parse(spec, args, 1)
    if (head(r) == 'Parsed) {
        opts := arg(r, 0)
        names := arg(r, 1)
        if (table.has(opts, "help")) say("usage: greet [-s] [-n times] name ...")
        else {
            i := 0
            while (i < array_len(names)) {
                greet(opts, array_get(names, i))
                i = i + 1
            }
        }
    } else {
        say(_strcat("error: ", pretty.show(r)))
        exit(2)
    }
}

main(if (array_len(argv()) > 1) argv() else list.list_to_array(["greet.pk", "-sn", "2", "Ann", "--", "-Bob"]))
