# Simplify and differentiate expressions. A pattern is written as the expression it matches:
# a + 0 matches the tree of x + 0, and a @ int matches an integer.
use("unparse")

# one step at the root
step(e) := match e {
    a @ int + b @ int -> a + b
    a @ int * b @ int -> a * b
    a @ int * (b @ int * c) -> `(!(a * b) * !c)
    a + 0 -> a
    0 + a -> a
    a - 0 -> a
    a - b if a == b -> 0
    a + b if a == b -> `(2 * !a)
    a * 1 -> a
    1 * a -> a
    _ * 0 -> 0
    0 * _ -> 0
    pow(a, 1) -> a
    pow(_, 0) -> 1
    _ -> e
}

# the arguments first, then the root until nothing changes.
# Apply{f, Tuple{a, b}} is a call of any function f with two arguments.
simp(e) := {
    s := match e {
        Apply{f, Tuple{a, b}} -> `Apply{!f, Tuple{!simp(a), !simp(b)}}
        _ -> e
    }
    t := step(s)
    if (t == s) s else simp(t)
}

d(e, x) := match e {
    _ @ int -> 0
    y @ symbol -> if (y == x) 1 else 0
    a + b -> `(!d(a, x) + !d(b, x))
    a - b -> `(!d(a, x) - !d(b, x))
    a * b -> `(!d(a, x) * !b + !a * !d(b, x))
    pow(a, n @ int) -> `(!n * pow(!a, !(n - 1)) * !d(a, x))
}

show(e) := {
    put(unparse(e)); put("  =>  "); put(unparse(simp(e))); put("\n")
}

show_d(e) := {
    put("d/dx ("); put(unparse(e)); put(")  =  "); put(unparse(simp(d(e, 'x)))); put("\n")
}

show('(x + 0))
show('(1 * (x + 0)))
show('(2 + 3 * 4))
show('((y - y) * z + w * 1))
show('((a + b) + (a + b)))
show('(2 * (3 * x)))

show_d('x)
show_d('y)
show_d('(x + 3))
show_d('(x * y))
show_d('(3 * pow(x, 2) + 2 * x))
show_d('pow(x + 1, 3))
show_d('(y * pow(x, 4)))
