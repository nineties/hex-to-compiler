# Simplify and differentiate expressions. A pattern is written as the expression it matches:
# a + 0 matches the tree of x + 0, and a @ Int matches an integer.
use("unparse")

# one step at the root
step(a @ Int + b @ Int) := a + b
step(a @ Int * b @ Int) := a * b
step(a @ Int * (b @ Int * c)) := `(!(a * b) * !c)
step(a + 0) := a
step(0 + a) := a
step(a - 0) := a
step(a - b) if a == b := 0
step(a + b) if a == b := `(2 * !a)
step(a * 1) := a
step(1 * a) := a
step(_ * 0) := 0
step(0 * _) := 0
step(pow(a, 1)) := a
step(pow(_, 0)) := 1
step(e) := e

# the arguments first, then the root until nothing changes.
# (f)(a, b) is a call of any function f with two arguments: f is a variable.
simp(e) := {
    s := match e {
        (f)(a, b) ->`(!f)(!simp(a), !simp(b))
      | _ -> e
    }
    t := step(s)
    if (t == s) s else simp(t)
}

d(_ @ Int, x) := 0
d(y @ Symbol, x) := if (y == x) 1 else 0
d(a + b, x) := `(!d(a, x) + !d(b, x))
d(a - b, x) := `(!d(a, x) - !d(b, x))
d(a * b, x) := `(!d(a, x) * !b + !a * !d(b, x))
d(pow(a, n @ Int), x) := `(!n * pow(!a, !(n - 1)) * !d(a, x))

show(e) := {
    put(unparse.text(e)); put("  =>  "); put(unparse.text(simp(e))); put("\n")
}

show_d(e) := {
    put("d/dx ("); put(unparse.text(e)); put(")  =  "); put(unparse.text(simp(d(e, 'x)))); put("\n")
}

show('(x + 0))
show('(1 * (x + 0)))
show('(2 + 3 * 4))
show('((y - y) * z + w * 1))
show('((a + b) + (a + b)))
show('(2 * (3 * x)))

show_d('x)
show_d('y)
show_d('(x + 3))
show_d('(x * y))
show_d('(3 * pow(x, 2) + 2 * x))
show_d('pow(x + 1, 3))
show_d('(y * pow(x, 4)))
