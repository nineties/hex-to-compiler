# handle and perform: return from a branch of a dynamic condition, a handler with its continuation, and a static handler
# planck0 planck/examples/pe/effects.pk <output>
use("vasm/build")
use("pe")

eff_tree := `({
    first_big(l, k) := {
        for (x in l) if (x > k) return x
        0 - 1
    }
    ask_twice(y) := handle { perform Ask{}; perform Ask{} + y } with (Ask{}, k) -> k(10) + 1
    tail_ask(c, y) := handle { if (c > 0) y + perform Ask{} else y } with (Ask{}, k) -> k(5)
    run(c, y, l) := first_big(l, y) * 100 + ask_twice(y) * 10 + tail_ask(c, y)
})
eval(eff_tree)
println(f"interpreted run(1, 2, [1, 3, 5]): {run(1, 2, [1, 3, 5])}")

m := specialize(eff_tree, [Dyn{I32{}}, Dyn{I32{}}, Dyn{Val{}}], I32{})
put(pe_vasm_text(m))
vasm_build(pe_with_main(m, [1, 2, [1, 3, 5]]), argv()[1])
