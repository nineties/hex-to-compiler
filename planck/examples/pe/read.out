"interpreted size(0): 26"
fn size_spec(a0: i32) -> i32 {
    var t1: own [u8]
    var t3: i32
    var t4: i32
    region pe_r {
        var t2: &pe_r [u8]
        t1 = read_file("planck/examples/pe/prog.txt")
        t2 = &pe_r t1
        t3 = strlen(t2)
        t4 = a0 + t3
        return t4
    }
}

fn strlen[r](s: &r [u8]) -> i32 {
    var n: i64
    var m: i32
    n = len(s)
    m = n as i32
    return m
}

fn read_file[r](path: &r [u8]) -> own [u8] {
    var fd: i64
    var acc: own [u8]
    var chunk: own [u8]
    var next: own [u8]
    var n: i64
    var got: i64
    var total: i64
    var i: i64
    var k: i64
    var c: u8
    var more: bool
    fd = open(path)
    if (fd < 0) {
        exit(1)
    }
    acc = alloc(0, 0)
    chunk = alloc(4096, 0)
    n = 0
    more = true
    while (more) {
        region g {
            var m: &mut g [u8]
            m = &mut g chunk
            got = read(fd, m)
        }
        if (got > 0) {
            total = n + got
            next = alloc(total, 0)
            i = 0
            while (i < n) {
                c = acc[i]
                next[i] = c
                i = i + 1
            }
            i = 0
            while (i < got) {
                c = chunk[i]
                k = n + i
                next[k] = c
                i = i + 1
            }
            acc = next
            n = total
        } else {
            more = false
        }
    }
    close(fd)
    return acc
}
