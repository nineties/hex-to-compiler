fn v_write[r](fd: i64, s: &r [u8]) {
    var n: i64
    n = write(fd, s)
}

fn v_bytes_write(fd: i64, v: val) {
    var b: own [u8]
    b = v as own [u8]
    region g {
        var s: &g [u8]
        s = &g b
        v_write(fd, s)
    }
}

fn v_digits(v: i64) -> val {
    var buf: own [u8]
    var out: own [u8]
    var i: i64
    var j: i64
    var k: i64
    var n: i64
    var x: i64
    var d: i64
    var c: u8
    var neg: bool
    var r: val
    buf = alloc(24, 0)
    i = 24
    x = v
    neg = x < 0
    if (neg) {
        x = 0 - x
    }
    if (x == 0) {
        i = i - 1
        buf[i] = 48
    }
    while (x > 0) {
        d = x % 10
        c = d as u8
        c = c + 48
        i = i - 1
        buf[i] = c
        x = x / 10
    }
    if (neg) {
        i = i - 1
        buf[i] = 45
    }
    n = 24 - i
    out = alloc(n, 0)
    j = 0
    while (j < n) {
        k = i + j
        c = buf[k]
        out[j] = c
        j = j + 1
    }
    region g {
        var s: &g [u8]
        s = &g out
        r = s as val
    }
    return r
}

fn v_print(v: val) -> val {
    var t: val
    var b: bool
    var n: i64
    var i: i64
    var x: val
    t = typeof(v)
    b = t == 'int
    if (b) {
        n = v as i64
        x = v_digits(n)
        v_bytes_write(1, x)
        return 'none
    }
    b = t == 'string
    if (b) {
        v_write(1, "\"")
        v_bytes_write(1, v)
        v_write(1, "\"")
        return 'none
    }
    b = t == 'symbol
    if (b) {
        x = symname(v)
        v_bytes_write(1, x)
        return 'none
    }
    b = t == 'mexpr
    if (b) {
        x = head(v)
        x = symname(x)
        v_bytes_write(1, x)
        v_write(1, "{")
        n = arity(v)
        i = 0
        while (i < n) {
            if (i > 0) {
                v_write(1, ", ")
            }
            x = v[i]
            x = v_print(x)
            i = i + 1
        }
        v_write(1, "}")
        return 'none
    }
    b = t == 'array
    if (b) {
        v_write(1, "<array>")
        return 'none
    }
    v_write(1, "<function>")
    return 'none
}

fn v_println(v: val) -> val {
    var x: val
    x = v_print(v)
    v_write(1, "\n")
    return 'none
}

fn v_stop[r](msg: &r [u8]) {
    v_write(2, msg)
    v_write(2, "\n")
    exit(1)
}

fn v_substr(v: val, iv: val, jv: val) -> val {
    var b: own [u8]
    var out: own [u8]
    var i: i64
    var j: i64
    var n: i64
    var k: i64
    var at: i64
    var c: u8
    var r: val
    i = iv as i64
    j = jv as i64
    b = v as own [u8]
    n = j - i
    out = alloc(n, 0)
    k = 0
    while (k < n) {
        at = i + k
        c = b[at]
        out[k] = c
        k = k + 1
    }
    region g {
        var s: &g [u8]
        s = &g out
        r = s as val
    }
    return r
}

fn v_array(nv: val) -> val {
    var n: i64
    var r: val
    n = nv as i64
    r = array(n, 'none)
    return r
}

fn v_index_get(a: val, iv: val) -> val {
    var t: val
    var b: bool
    var i: i64
    var r: val
    var j: val
    t = typeof(a)
    b = t == 'string
    if (b) {
        i = iv as i64
        i = i + 1
        r = i as val
        j = v_substr(a, iv, r)
        return j
    }
    i = iv as i64
    b = is(a, 'Cons, 2)
    if (b) {
        r = a
        while (i > 0) {
            r = r[1]
            i = i - 1
        }
        r = r[0]
        return r
    }
    r = a[i]
    return r
}

fn v_index_set(a: val, iv: val, x: val) -> val {
    var i: i64
    i = iv as i64
    a[i] = x
    return x
}
