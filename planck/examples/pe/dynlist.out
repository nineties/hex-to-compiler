"interpreted twist([1, 2, 3], 4): 20"
fn twist_spec(a0: val) -> i32 {
    var t1: bool
    var t2: bool
    var t3: val
    var t4: val
    var t5: i64
    var t6: i64
    var t7: val
    var t8: val
    var t9: val
    var t10: val
    var t11: val
    var t12: i64
    var t13: i64
    var t14: i32
    t1 = is(a0, 'Nil, 0)
    if (t1) {
        t11 = 4 as val
        t10 = t11
    } else {
        t2 = is(a0, 'Cons, 2)
        if (t2) {
            t3 = a0[0]
            t4 = a0[1]
            t5 = t3 as i64
            t6 = 4 + t5
            t7 = twist_spec_1(t4, t6)
            t8 = t7
        } else {
            v_stop("no pattern of the function matches")
            t9 = 'none
            t8 = t9
        }
        t10 = t8
    }
    t12 = t10 as i64
    t13 = t12 * 2
    t14 = t13 as i32
    return t14
}

fn twist_spec_1(a0: val, a1: i64) -> val {
    var t1: bool
    var t2: bool
    var t3: val
    var t4: val
    var t5: i64
    var t6: i64
    var t7: val
    var t8: val
    var t9: val
    var t10: val
    var t11: val
    t1 = is(a0, 'Nil, 0)
    if (t1) {
        t11 = a1 as val
        t10 = t11
    } else {
        t2 = is(a0, 'Cons, 2)
        if (t2) {
            t3 = a0[0]
            t4 = a0[1]
            t5 = t3 as i64
            t6 = a1 + t5
            t7 = twist_spec_1(t4, t6)
            t8 = t7
        } else {
            v_stop("no pattern of the function matches")
            t9 = 'none
            t8 = t9
        }
        t10 = t8
    }
    return t10
}

fn v_write[r](fd: i64, s: &r [u8]) {
    var n: i64
    n = write(fd, s)
}

fn v_stop[r](msg: &r [u8]) {
    v_write(2, msg)
    v_write(2, "\n")
    exit(1)
}
