# read_file stays in the result: the file is read when the result runs
# planck0 planck/examples/pe/read.pk <output>
use("vasm/build")
use("pe")

size_tree := `(size(x) := x + strlen(read_file("planck/examples/pe/prog.txt")))
eval(size_tree)
println(f"interpreted size(0): {size(0)}")

m := pe.specialize(size_tree, [Dyn{I32{}}], I32{})
put(pe.vasm_text(m))
vasm_build(pe.with_main(m, [0]), argv()[1])
