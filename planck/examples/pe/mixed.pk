# values that were errors of the partial evaluator: a static list that changes, an assignment under a dynamic condition, a write to an array from before, a function of the library
# planck0 planck/examples/pe/mixed.pk <output>
use("vasm/build")
use("pe")

table_of := {
    z := array(2)
    z[0] = 5
    z
}

mix_tree := `({
    collect(x, ys) := if (x == 0) ys else collect(x - 1, x :: ys)
    bump(b, x) := {
        b[1] = x
        b[0] + b[1]
    }
    run(b, x) := {
        y := 1
        if (x > 2) y = 2 else y = "three"
        l := collect(x, [])
        n := length(map(e -> e + 1, l))
        println(l)
        println(y)
        n + bump(b, x)
    }
})
eval(mix_tree)
println(f"interpreted run(table_of, 3): {run(table_of, 3)}")

m := pe.specialize(mix_tree, [table_of, Dyn{I32{}}], I32{})
put(pe.vasm_text(m))
vasm_build.build(pe.with_main(m, [3]), argv()[1])
