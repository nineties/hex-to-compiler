# run of interp_prog.pk specialized for the code of prog.txt: x is dynamic
# planck0 planck/examples/pe/interp.pk <output>
use("pe")
use("vasm/build")

load("planck/examples/pe/interp_prog.pk")
code := decode(read_file("planck/examples/pe/prog.txt"))
println(f"interpreted run(code, 5): {run(code, 5)}")

defs := pe_load("planck/examples/pe/interp_prog.pk")
m := specialize(defs, 'run, [code, Dyn{U64{}}], U64{})
put(pe_vasm_text(m))
write_file(_strcat(argv()[1], ".vasm"), pe_vasm_text(m))
vasm_build(pe_with_main(m, [5]), argv()[1])
