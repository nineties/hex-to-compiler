# twice specialized for the function x -> x + 1: x is dynamic
# planck0 planck/examples/pe/twice.pk <output>
use("vasm/build")
use("pe")

twice_tree := `(twice(f, x) := f(f(x)))
eval(twice_tree)
println(f"interpreted twice(x -> x + 1, 5): {twice(x -> x + 1, 5)}")

m := specialize(twice_tree, [`(x -> x + 1), Dyn{I32{}}], I32{})
put(pe_vasm_text(m))
vasm_build.build(pe_with_main(m, [5]), argv()[1])
