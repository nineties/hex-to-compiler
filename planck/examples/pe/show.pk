# printing stays in the result and happens in the same order as in the interpretation
# planck0 planck/examples/pe/show.pk <output>
use("vasm/build")
use("pe")

show_tree := `(show(x) := {
    println("start")
    println(x + 1)
    x * 2
})
eval(show_tree)
println(f"interpreted show(5): {show(5)}")

m := pe.specialize(show_tree, [Dyn{I32{}}], I32{})
put(pe.vasm_text(m))
vasm_build.build(pe.with_main(m, [5]), argv()[1])
