# the static argument n changes at each call under a dynamic condition: it is a parameter of the function that is made, and the functions do not grow
# planck0 planck/examples/pe/grow.pk <output>
use("vasm/build")
use("pe")

grow_tree := `(grow(x, n) := if (x == 0) n else grow(x - 1, n + 1))
eval(grow_tree)
println(f"interpreted grow(4, 0): {grow(4, 0)}")

m := pe.specialize(grow_tree, [Dyn{I32{}}, 0], I32{})
put(pe.vasm_text(m))
vasm_build.build(pe.with_main(m, [4]), argv()[1])
