# a list that is known only when the result runs is a val; the patterns are tests on it
# planck0 planck/examples/pe/dynlist.pk <output>
use("vasm/build")
use("pe")

sum_tree := `({
    add_all(Nil{}, acc) := acc
    add_all(x :: xs, acc) := add_all(xs, acc + x)
    twist(l, k) := add_all(k :: l, 0) * 2
})
eval(sum_tree)
println(f"interpreted twist([1, 2, 3], 4): {twist([1, 2, 3], 4)}")

m := specialize(sum_tree, [Dyn{Val{}}, 4], I32{})
put(pe_vasm_text(m))
vasm_build(pe_with_main(m, [[1, 2, 3]]), argv()[1])
