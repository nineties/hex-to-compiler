# pow of pow_prog.pk specialized for n = 3: x is dynamic
# planck0 planck/examples/pe/pow.pk <output>
use("pe")
use("vasm/build")

load("planck/examples/pe/pow_prog.pk")
println(f"interpreted pow(5, 3): {pow(5, 3)}")

defs := pe_load("planck/examples/pe/pow_prog.pk")
m := specialize(defs, 'pow, [Dyn{U64{}}, 3], U64{})
put(pe_vasm_text(m))
write_file(_strcat(argv()[1], ".vasm"), pe_vasm_text(m))
vasm_build(pe_with_main(m, [5]), argv()[1])
