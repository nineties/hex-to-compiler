# pow specialized for n = 3: x is dynamic
# planck0 planck/examples/pe/pow.pk <output>
use("vasm/build")
use("pe")

pow_tree := `({
    pow(x, 0) := 1
    pow(x, n) := x * pow(x, n - 1)
})
eval(pow_tree)
println(f"interpreted pow(5, 3): {pow(5, 3)}")

m := pe.specialize(pow_tree, [Dyn{I32{}}, 3], I32{})
put(pe.vasm_text(m))
vasm_build(pe.with_main(m, [5]), argv()[1])
