# hello: an executable made from instructions of ir.pk without vasm: it writes a line and ends with status 0
# Copyright (C) 2026 nineties
#
# planck0 planck/backend/hello.pk <output>

load("planck/mx.pk")
use("x86")
use("link")
use("elf")

msg := "Hello, world!\n"

start := ir_fn("_start")
fd := ir_vreg(start, 32)
p := ir_vreg(start, 32)
n := ir_vreg(start, 32)
r := ir_vreg(start, 32)
st := ir_vreg(start, 32)
z := ir_vreg(start, 32)
ir_emit(start, I{'li, [D{fd}, K{1}]})
ir_emit(start, I{'la, [D{p}, S{"msg", 0}]})
ir_emit(start, I{'li, [D{n}, K{strlen(msg)}]})
ir_emit(start, I{'sys, [K{4}, Us{[fd, p, n]}, D{r}]})
ir_emit(start, I{'li, [D{st}, K{0}]})
ir_emit(start, I{'sys, [K{1}, Us{[st]}, D{z}]})
ir_emit(start, I{'trap, []})

text := bb_new()
bb_str(text, msg)
obj := x86_compile("hello", [start], [IRData{"msg", ".rodata", 1, text, false}])
img := link([obj], "_start", 134512640)
elf32_write(argv()[1], 'x86, arg(img, 0), arg(img, 1))
