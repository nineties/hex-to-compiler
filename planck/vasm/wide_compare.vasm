# comparisons of 64-bit values that differ in the high word: the result counts the true ones, which is 6
fn main() -> i32 {
    var a: i64
    var b: i64
    var c: u64
    var d: u64
    var n: i32
    a = 1
    a = a << 33
    b = 0 - a
    c = 1
    c = c << 33
    d = 5
    n = 0
    if (a > b) { n = n + 1 }
    if (b < a) { n = n + 1 }
    if (a != b) { n = n + 1 }
    if (c > d) { n = n + 1 }
    if (d <= c) { n = n + 1 }
    if (c == c) { n = n + 1 }
    if (b > a) { n = n + 100 }
    if (c < d) { n = n + 100 }
    return n
}
