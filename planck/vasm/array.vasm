# fill an array with 0 to 9, add the elements (45) and the length (10)
fn main() -> i64 {
    var a: own [i64]
    var i: i64
    var n: i64
    var s: i64
    var v: i64
    a = alloc(10, 0)
    i = 0
    while (i < 10) {
        a[i] = i
        i = i + 1
    }
    s = 0
    i = 0
    while (i < 10) {
        v = a[i]
        s = s + v
        i = i + 1
    }
    region r {
        var b: &r [i64]
        b = &r a
        n = len(b)
    }
    free(a)
    s = s + n
    return s
}
