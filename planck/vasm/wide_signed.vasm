# -10000000000 / 1000 is -10000000 (128 modulo 256) and -10000000000 % 7 is -4 (252 modulo 256); the first is returned if the second is -4
fn main() -> i64 {
    var a: i64
    var m: i64
    var q: i64
    var r: i64
    a = 25000
    a = a << 2
    m = a * a
    m = 0 - m
    q = m / 1000
    r = m % 7
    if (r == -4) { return q }
    return 1
}
