# hello world: the bytes of a line are put in an array, which write gives to the file 1 (the output); the status is 0
fn main() -> i64 {
    var a: own [u8]
    var n: i64
    a = alloc(14, 0)
    a[0] = 72
    a[1] = 101
    a[2] = 108
    a[3] = 108
    a[4] = 111
    a[5] = 44
    a[6] = 32
    a[7] = 119
    a[8] = 111
    a[9] = 114
    a[10] = 108
    a[11] = 100
    a[12] = 33
    a[13] = 10
    region r {
        var b: &r [u8]
        b = &r a
        n = write(1, b)
    }
    free(a)
    return 0
}
