" Packrat parser for planck "
" Copyright (C) 2026 nineties "

" A grammar is data. A parsing expression is one of "
"   \"text\"          the text, after blanks and comments "
"   Tight{\"text\"}   the text, without skipping blanks "
"   Key{\"word\"}     the word, not followed by a letter, a digit or _ "
"   name            the rule name (a symbol) "
"   f               a function: f(p) returns the new position or -1, and sets peg_pv "
"   Seq{e, ...}     sequence. The value is Tuple{v, ...} "
"   Choice{e, ...}  ordered choice "
"   Many{e}, Many1{e}, Option{e}  the values are Tuple{v, ...}, Option gives Tuple{} or Tuple{v} "
"   And{e}, Not{e}  lookahead "
"   Delimited{e, sep}, Delimited1{e, sep}  e separated by sep. The value is Tuple{v, ...} "
"   Same{}          succeeds when the next token is on the same line "
"   Act{e, f}       applies f to the value of e. f is an expression evaluated by define_rule "
"   Prev{}          the previous definition of the rule (only as an alternative of define_rule) "
"   Fail{}          never matches "

" Results of rules are memoized for each position. "
" Direct left recursion (sum ::= sum \"+\" term | term) is handled by growing the seed. "

Def{peg_rules, Apply{table, Tuple{}}}
Def{peg_ids, Apply{table, Tuple{}}}
Def{peg_nrules, 0}

" state of the current parse "
Def{peg_src, ""}
Def{peg_srclen, 0}
Def{peg_memo, none}
Def{peg_memo_w, 0}
Def{peg_far, 0}
Def{peg_pv, none}

" === Helpers === "
Def{peg_inc, Lambda{Tuple{n}, Apply{add, Tuple{n, 1}}}}

Def{peg_is_head, Lambda{Tuple{e, h},
    If{Apply{eq, Tuple{Apply{typeof, Tuple{e}}, Quote{mexpr}}},
        Apply{eq, Tuple{Apply{head, Tuple{e}}, h}},
        false}}}

" peg_map_args(f, Head{a, ...}) = Head{f(a), ...} "
Def{peg_map_args, Lambda{Tuple{f, m}, Do{
    Def{r, Apply{mexpr, Tuple{Apply{head, Tuple{m}}, Tuple{}}}},
    Def{i, 0},
    Def{n, Apply{arity, Tuple{m}}},
    While{Apply{lt, Tuple{i, n}}, Do{
        Set{r, Apply{push, Tuple{r, Apply{f, Tuple{Apply{arg, Tuple{m, i}}}}}}},
        Set{i, Apply{peg_inc, Tuple{i}}}}},
    r}}}

Def{peg_fail, Lambda{Tuple{p}, Do{
    If{Apply{gt, Tuple{p, peg_far}}, Set{peg_far, p}, none},
    -1}}}

Def{peg_char_at, Lambda{Tuple{p}, Apply{ord, Tuple{peg_src, p}}}}

Def{peg_is_blank, Lambda{Tuple{c},
    If{Apply{eq, Tuple{c, 32}}, true,
    If{Apply{eq, Tuple{c, 10}}, true,
    If{Apply{eq, Tuple{c, 9}}, true,
        Apply{eq, Tuple{c, 13}}}}}}}

Def{peg_is_digit, Lambda{Tuple{c}, If{Apply{le, Tuple{48, c}}, Apply{le, Tuple{c, 57}}, false}}}
Def{peg_is_alpha, Lambda{Tuple{c},
    If{If{Apply{le, Tuple{65, c}}, Apply{le, Tuple{c, 90}}, false}, true,
    If{If{Apply{le, Tuple{97, c}}, Apply{le, Tuple{c, 122}}, false}, true,
        Apply{eq, Tuple{c, 95}}}}}}
Def{peg_is_alnum, Lambda{Tuple{c}, If{Apply{peg_is_alpha, Tuple{c}}, true, Apply{peg_is_digit, Tuple{c}}}}}

" skip blanks, newlines and # comments "
Def{peg_skip_ws, Lambda{Tuple{p}, Do{
    Def{go, true},
    Def{c, 0},
    While{go, Do{
        Set{c, Apply{peg_char_at, Tuple{p}}},
        If{Apply{peg_is_blank, Tuple{c}}, Set{p, Apply{peg_inc, Tuple{p}}},
        If{Apply{eq, Tuple{c, 35}},
            While{If{Apply{ge, Tuple{c, 0}}, Apply{ne, Tuple{c, 10}}, false}, Do{
                Set{p, Apply{peg_inc, Tuple{p}}},
                Set{c, Apply{peg_char_at, Tuple{p}}}}},
            Set{go, false}}}}},
    p}}}

" true when the next token after p is on the same line "
Def{peg_same_line, Lambda{Tuple{p}, Do{
    Def{c, Apply{peg_char_at, Tuple{p}}},
    While{If{Apply{eq, Tuple{c, 32}}, true, Apply{eq, Tuple{c, 9}}}, Do{
        Set{p, Apply{peg_inc, Tuple{p}}},
        Set{c, Apply{peg_char_at, Tuple{p}}}}},
    If{Apply{eq, Tuple{c, 10}}, false,
    If{Apply{eq, Tuple{c, 13}}, false,
    If{Apply{eq, Tuple{c, 35}}, false,
        Apply{ge, Tuple{c, 0}}}}}}}}

" match the text s at p "
Def{peg_lit, Lambda{Tuple{s, p}, Do{
    Def{n, Apply{strlen, Tuple{s}}},
    Def{i, 0},
    While{If{Apply{lt, Tuple{i, n}},
            Apply{eq, Tuple{Apply{ord, Tuple{s, i}}, Apply{peg_char_at, Tuple{Apply{add, Tuple{p, i}}}}}},
            false},
        Set{i, Apply{peg_inc, Tuple{i}}}},
    If{Apply{eq, Tuple{i, n}},
        Do{Set{peg_pv, s}, Apply{add, Tuple{p, n}}},
        Apply{peg_fail, Tuple{p}}}}}}

" === Interpreter of parsing expressions === "
" peg_px(e, p) returns the new position or -1, and sets peg_pv to the value "

Def{peg_px_seq, Lambda{Tuple{e, p}, Do{
    Def{n, Apply{arity, Tuple{e}}},
    Def{i, 0},
    Def{vs, Tuple{}},
    While{If{Apply{lt, Tuple{i, n}}, Apply{ge, Tuple{p, 0}}, false}, Do{
        Set{p, Apply{peg_px, Tuple{Apply{arg, Tuple{e, i}}, p}}},
        If{Apply{ge, Tuple{p, 0}}, Set{vs, Apply{push, Tuple{vs, peg_pv}}}, none},
        Set{i, Apply{peg_inc, Tuple{i}}}}},
    If{Apply{ge, Tuple{p, 0}}, Set{peg_pv, vs}, none},
    p}}}

Def{peg_px_choice, Lambda{Tuple{e, p}, Do{
    Def{n, Apply{arity, Tuple{e}}},
    Def{i, 0},
    Def{q, -1},
    While{If{Apply{lt, Tuple{i, n}}, Apply{lt, Tuple{q, 0}}, false}, Do{
        Set{q, Apply{peg_px, Tuple{Apply{arg, Tuple{e, i}}, p}}},
        Set{i, Apply{peg_inc, Tuple{i}}}}},
    q}}}

" the values of e repeated while it consumes input "
Def{peg_px_many, Lambda{Tuple{e, p}, Do{
    Def{vs, Tuple{}},
    Def{q, Apply{peg_px, Tuple{e, p}}},
    While{Apply{gt, Tuple{q, p}}, Do{
        Set{vs, Apply{push, Tuple{vs, peg_pv}}},
        Set{p, q},
        Set{q, Apply{peg_px, Tuple{e, p}}}}},
    Set{peg_pv, vs},
    p}}}

Def{peg_px_delimited, Lambda{Tuple{e, sep, p}, Do{
    Def{q, Apply{peg_px, Tuple{e, p}}},
    Def{vs, Tuple{}},
    Def{r, 0},
    If{Apply{lt, Tuple{q, 0}}, Do{Set{peg_pv, Tuple{}}, p}, Do{
        Set{vs, Tuple{peg_pv}},
        Set{r, Apply{peg_px, Tuple{sep, q}}},
        If{Apply{ge, Tuple{r, 0}}, Set{r, Apply{peg_px, Tuple{e, r}}}, none},
        While{Apply{ge, Tuple{r, 0}}, Do{
            Set{vs, Apply{push, Tuple{vs, peg_pv}}},
            Set{q, r},
            Set{r, Apply{peg_px, Tuple{sep, q}}},
            If{Apply{ge, Tuple{r, 0}}, Set{r, Apply{peg_px, Tuple{e, r}}}, none}}},
        Set{peg_pv, vs},
        q}}}}}

Def{peg_px_key, Lambda{Tuple{s, p}, Do{
    Def{q, Apply{peg_lit, Tuple{s, Apply{peg_skip_ws, Tuple{p}}}}},
    If{Apply{lt, Tuple{q, 0}}, -1,
    If{Apply{peg_is_alnum, Tuple{Apply{peg_char_at, Tuple{q}}}}, Apply{peg_fail, Tuple{p}},
        q}}}}}

" parsing expressions which are m-exprs: head -> function(e, p) "
Def{peg_handlers, Apply{table, Tuple{}}}
Apply{table_set, Tuple{peg_handlers, Quote{Seq}, Lambda{Tuple{e, p}, Apply{peg_px_seq, Tuple{e, p}}}}}
Apply{table_set, Tuple{peg_handlers, Quote{Choice}, Lambda{Tuple{e, p}, Apply{peg_px_choice, Tuple{e, p}}}}}
Apply{table_set, Tuple{peg_handlers, Quote{Tight}, Lambda{Tuple{e, p}, Apply{peg_lit, Tuple{Apply{arg, Tuple{e, 0}}, p}}}}}
Apply{table_set, Tuple{peg_handlers, Quote{Key}, Lambda{Tuple{e, p}, Apply{peg_px_key, Tuple{Apply{arg, Tuple{e, 0}}, p}}}}}
Apply{table_set, Tuple{peg_handlers, Quote{Act}, Lambda{Tuple{e, p}, Do{
        Def{q, Apply{peg_px, Tuple{Apply{arg, Tuple{e, 0}}, p}}},
        If{Apply{ge, Tuple{q, 0}}, Set{peg_pv, Apply{Apply{arg, Tuple{e, 1}}, Tuple{peg_pv}}}, none},
        q}}}}
Apply{table_set, Tuple{peg_handlers, Quote{Many}, Lambda{Tuple{e, p}, Apply{peg_px_many, Tuple{Apply{arg, Tuple{e, 0}}, p}}}}}
Apply{table_set, Tuple{peg_handlers, Quote{Many1}, Lambda{Tuple{e, p}, Do{
        Def{q, Apply{peg_px_many, Tuple{Apply{arg, Tuple{e, 0}}, p}}},
        If{Apply{eq, Tuple{Apply{arity, Tuple{peg_pv}}, 0}}, Apply{peg_fail, Tuple{p}}, q}}}}}
Apply{table_set, Tuple{peg_handlers, Quote{Option}, Lambda{Tuple{e, p}, Do{
        Def{q, Apply{peg_px, Tuple{Apply{arg, Tuple{e, 0}}, p}}},
        If{Apply{lt, Tuple{q, 0}},
            Do{Set{peg_pv, Tuple{}}, p},
            Do{Set{peg_pv, Tuple{peg_pv}}, q}}}}}}
Apply{table_set, Tuple{peg_handlers, Quote{And}, Lambda{Tuple{e, p}, Do{
        Def{q, Apply{peg_px, Tuple{Apply{arg, Tuple{e, 0}}, p}}},
        Set{peg_pv, none},
        If{Apply{lt, Tuple{q, 0}}, -1, p}}}}}
Apply{table_set, Tuple{peg_handlers, Quote{Not}, Lambda{Tuple{e, p}, Do{
        Def{saved, peg_far},
        Def{q, Apply{peg_px, Tuple{Apply{arg, Tuple{e, 0}}, p}}},
        Set{peg_far, saved},
        Set{peg_pv, none},
        If{Apply{lt, Tuple{q, 0}}, p, Apply{peg_fail, Tuple{p}}}}}}}
Apply{table_set, Tuple{peg_handlers, Quote{Delimited}, Lambda{Tuple{e, p}, Apply{peg_px_delimited, Tuple{Apply{arg, Tuple{e, 0}}, Apply{arg, Tuple{e, 1}}, p}}}}}
Apply{table_set, Tuple{peg_handlers, Quote{Delimited1}, Lambda{Tuple{e, p}, Do{
        Def{q, Apply{peg_px_delimited, Tuple{Apply{arg, Tuple{e, 0}}, Apply{arg, Tuple{e, 1}}, p}}},
        If{Apply{eq, Tuple{Apply{arity, Tuple{peg_pv}}, 0}}, Apply{peg_fail, Tuple{p}}, q}}}}}
Apply{table_set, Tuple{peg_handlers, Quote{Same}, Lambda{Tuple{e, p}, Do{
        Set{peg_pv, none},
        If{Apply{peg_same_line, Tuple{p}}, p, Apply{peg_fail, Tuple{p}}}}}}}
Apply{table_set, Tuple{peg_handlers, Quote{Fail}, Lambda{Tuple{e, p}, Apply{peg_fail, Tuple{p}}}}}

Def{peg_px, Lambda{Tuple{e, p}, Do{
    Def{t, Apply{typeof, Tuple{e}}},
    If{Apply{eq, Tuple{t, Quote{string}}}, Apply{peg_lit, Tuple{e, Apply{peg_skip_ws, Tuple{p}}}},
    If{Apply{eq, Tuple{t, Quote{symbol}}}, Apply{peg_call_rule, Tuple{e, p}},
    If{Apply{eq, Tuple{t, Quote{function}}}, Apply{e, Tuple{p}},
        Apply{Apply{table_get, Tuple{peg_handlers, Apply{head, Tuple{e}}, none}}, Tuple{e, p}}}}}}}}

" === Rules and memoization === "
" The memo of position p is the array peg_memo[p] (made when first used), which holds "
" three slots for each rule id: end position, value and left-recursion flag. "
" The end position is none before the rule runs, -1 for failure and -2 while the rule is running. "
" On left recursion (the rule is called again at the same position while it runs), "
" the inner call fails, which is the seed. Then the rule is run again "
" while it consumes more than the last result. "

Def{peg_row, Lambda{Tuple{p}, Do{
    Def{row, Apply{array_get, Tuple{peg_memo, p}}},
    If{Apply{eq, Tuple{row, none}}, Do{
        Set{row, Apply{array, Tuple{peg_memo_w}}},
        Apply{array_set, Tuple{peg_memo, p, row}}}, none},
    row}}}

Def{peg_call_rule, Lambda{Tuple{r, p}, Do{
    Def{id, Apply{table_get, Tuple{peg_ids, r, none}}},
    If{Apply{eq, Tuple{id, none}}, Do{
        Apply{put, Tuple{"undefined rule: "}},
        Apply{println, Tuple{r}},
        Apply{exit, Tuple{1}}}, none},
    Def{row, Apply{peg_row, Tuple{p}}},
    Def{b, Apply{mul, Tuple{id, 3}}},
    Def{m, Apply{array_get, Tuple{row, b}}},
    If{Apply{eq, Tuple{m, none}}, Apply{peg_run_rule, Tuple{r, p, row, b}},
    If{Apply{eq, Tuple{m, -2}}, Do{
        Apply{array_set, Tuple{row, b, -1}},
        Apply{array_set, Tuple{row, Apply{add, Tuple{b, 2}}, true}},
        -1},
    Do{
        Set{peg_pv, Apply{array_get, Tuple{row, Apply{add, Tuple{b, 1}}}}},
        m}}}}}}

Def{peg_run_rule, Lambda{Tuple{r, p, row, b}, Do{
    Def{body, Apply{table_get, Tuple{peg_rules, r, none}}},
    Def{b1, Apply{add, Tuple{b, 1}}},
    Apply{array_set, Tuple{row, b, -2}},
    Def{q, Apply{peg_px, Tuple{body, p}}},
    Apply{array_set, Tuple{row, b, q}},
    Apply{array_set, Tuple{row, b1, peg_pv}},
    If{Apply{eq, Tuple{Apply{array_get, Tuple{row, Apply{add, Tuple{b, 2}}}}, true}}, Do{
        Def{go, Apply{ge, Tuple{q, 0}}},
        While{go, Do{
            Set{q, Apply{peg_px, Tuple{body, p}}},
            If{Apply{gt, Tuple{q, Apply{array_get, Tuple{row, b}}}},
                Do{
                    Apply{array_set, Tuple{row, b, q}},
                    Apply{array_set, Tuple{row, b1, peg_pv}}},
                Set{go, false}}}},
        Set{peg_pv, Apply{array_get, Tuple{row, b1}}},
        Apply{array_get, Tuple{row, b}}},
    q}}}}

" evaluate the actions of a parsing expression "
Def{peg_prepare, Lambda{Tuple{e},
    If{Apply{peg_is_head, Tuple{e, Quote{Act}}},
        Act{Apply{peg_prepare, Tuple{Apply{arg, Tuple{e, 0}}}}, Apply{eval, Tuple{Apply{arg, Tuple{e, 1}}}}},
    If{Apply{eq, Tuple{Apply{typeof, Tuple{e}}, Quote{mexpr}}},
        Apply{peg_map_args, Tuple{peg_prepare, e}},
        e}}}}

" replace Prev{} among the alternatives with the previous definition "
Def{peg_subst_prev, Lambda{Tuple{e, old},
    If{Apply{peg_is_head, Tuple{e, Quote{Prev}}}, old,
    If{Apply{peg_is_head, Tuple{e, Quote{Choice}}},
        Apply{peg_map_args, Tuple{Lambda{Tuple{a}, If{Apply{peg_is_head, Tuple{a, Quote{Prev}}}, old, a}}, e}},
        e}}}}

" define_rule(name, e) defines or replaces the rule "
Def{define_rule, Lambda{Tuple{name, e}, Do{
    If{Apply{eq, Tuple{Apply{table_get, Tuple{peg_ids, name, none}}, none}}, Do{
        Apply{table_set, Tuple{peg_ids, name, peg_nrules}},
        Set{peg_nrules, Apply{peg_inc, Tuple{peg_nrules}}}}, none},
    Def{old, Apply{table_get, Tuple{peg_rules, name, Fail{}}}},
    Apply{table_set, Tuple{peg_rules, name, Apply{peg_subst_prev, Tuple{Apply{peg_prepare, Tuple{e}}, old}}}},
    name}}}

" the text from p up to the end of the line, for error messages "
Def{peg_line_at, Lambda{Tuple{p}, Do{
    Def{q, p},
    While{If{Apply{ge, Tuple{Apply{peg_char_at, Tuple{q}}, 0}}, Apply{ne, Tuple{Apply{peg_char_at, Tuple{q}}, 10}}, false},
        Set{q, Apply{peg_inc, Tuple{q}}}},
    Apply{substr, Tuple{peg_src, p, q}}}}}

" peg_parse(rule, s) parses a prefix of s by the rule. "
" It returns Tuple{value, rest}, Tuple{Eof{}, \"\"} or Tuple{SyntaxError{...}, \"\"}. "
Def{peg_parse, Lambda{Tuple{r, s}, Do{
    Set{peg_src, s},
    Set{peg_srclen, Apply{strlen, Tuple{s}}},
    Set{peg_memo, Apply{array, Tuple{Apply{peg_inc, Tuple{Apply{strlen, Tuple{s}}}}}}},
    Set{peg_memo_w, Apply{mul, Tuple{peg_nrules, 3}}},
    Set{peg_far, 0},
    Def{p, Apply{peg_skip_ws, Tuple{0}}},
    If{Apply{ge, Tuple{p, peg_srclen}}, Tuple{Eof{}, ""}, Do{
        Def{q, Apply{peg_call_rule, Tuple{r, p}}},
        If{Apply{lt, Tuple{q, 0}},
            Tuple{Apply{mexpr, Tuple{Quote{SyntaxError},
                If{Apply{ge, Tuple{peg_far, peg_srclen}},
                    Tuple{"unexpected end of input"},
                    Tuple{"unexpected input", Apply{peg_line_at, Tuple{peg_far}}}}}}, ""},
            Tuple{peg_pv, Apply{substr, Tuple{s, Apply{peg_skip_ws, Tuple{q}}, peg_srclen}}}}}}}}}
