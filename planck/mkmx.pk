# mkmx: writes the expressions of a library as M-expressions, one on each line, for planck/mx.pk
# Copyright (C) 2026 nineties
#
# planck0 planck/mkmx.pk planck/lib/<name>.pk > planck/lib/<name>.mx
# The libraries the file uses must have their .mx files already.

load("planck/mx.pk")

path := argv()[1]
src := read_file(path)
prev := _set_file(path)
go := true
while (go) {
    r := parse(src)
    e := arg(r, 0)
    if (e == Eof{}) go = false else {
        println(mx_enc(e))
        eval(e)
        src = arg(r, 1)
    }
}
