# vasmc: compiles a vasm source file to an executable file (32-bit x86, Linux)
# Copyright (C) 2026 nineties
#
# planck0 planck/vasmc.pk <source> <output>

use("vasm_build")

args := argv()
if (array_len(args) != 3) {
    put("usage: planck0 planck/vasmc.pk <source> <output>\n")
    exit(2)
}
src_path := args[1]
out_path := args[2]
text := read_file(src_path)
parsed := peg_parse('vasm, text)
m := arg(parsed, 0)
if (head(m) == 'SyntaxError) {
    put(f"{src_path}: syntax error: {arg(m, 0)}\n")
    exit(1)
}
if (arg(parsed, 1) != "") {
    put(f"{src_path}: syntax error: unexpected input\n")
    exit(1)
}
errs := vasm_errors(src_path, m)
if (errs != []) {
    each((VasmErr{_, loc, msg}) -> put(f"{show_loc(loc)}: {msg}\n"), errs)
    exit(1)
}
vasm_build(m, out_path)
