# vasmc: compiles vasm source files (.vasm) and psys source files (.psys) to executable files (Linux)
# Copyright (C) 2026 nineties
#
# planck0 planck/vasmc.pk <source> <output> [<target>]
#     compiles one source file to an executable file.
# planck0 planck/vasmc.pk unit <source> <output> <target> [<import> ...]
#     compiles one source file to a unit file, which has no function main. The functions and the structs of the unit files
#     <import> can be used in the source.
# planck0 planck/vasmc.pk link <output> <target> <unit> ...
#     joins unit files into an executable file. Exactly one of them has the function main.
#
# The target is the name of a machine of backend/target.pk (x86_64); without it the default target is used.
# A unit file is made for the word of its target and can be joined only for a target of the same word.

use("vasm/build")
use("psys/expand")

usage() := {
    put("usage: planck0 planck/vasmc.pk <source> <output> [<target>]\n")
    put("       planck0 planck/vasmc.pk unit <source> <output> <target> [<import> ...]\n")
    put("       planck0 planck/vasmc.pk link <output> <target> <unit> ...\n")
    exit(2)
}

# the module of the source file src_path, which may use the interfaces imports: the vasm module that psys expands to, checked
load(src_path, imports) := {
    text := read_file(src_path)
    n := strlen(src_path)
    is_psys := n > 5 and substr(src_path, n - 5, n) == ".psys"
    parsed := peg_parse(if (is_psys) 'psys else 'vasm, text)
    m := arg(parsed, 0)
    if (head(m) == 'SyntaxError) {
        put(f"{src_path}: syntax error: {arg(m, 0)}\n")
        exit(1)
    }
    if (arg(parsed, 1) != "") {
        put(f"{src_path}: syntax error: unexpected input\n")
        exit(1)
    }
    if (is_psys) {
        expanded := psys_expand_all_with(m, imports)
        perrs := psys_errors(src_path, arg(expanded, 1))
        if (perrs != []) {
            each((VasmErr{_, loc, msg}) -> put(f"{show_loc(loc)}: {msg}\n"), perrs)
            exit(1)
        }
        m = arg(expanded, 0)
    }
    errs := vasm_errors_with(src_path, m, imports)
    if (errs != []) {
        each((VasmErr{_, loc, msg}) -> put(f"{show_loc(loc)}: {msg}\n"), errs)
        exit(1)
    }
    m
}

# the arguments from the index i, as a list
args_from(args, i) := {
    out := []
    k := array_len(args) - 1
    while (k >= i) {
        out = args[k] :: out
        k = k - 1
    }
    out
}

args := argv()
nargs := array_len(args)
if (nargs >= 2 and args[1] == "unit") {
    if (nargs < 5) usage()
    src_path := args[2]
    target := intern(args[4])
    imports := concat_map(p -> vasm_unit_ifaces(vasm_unit_read(p)), args_from(args, 5))
    m := load(src_path, imports)
    vasm_unit_write(args[3], vasm_unit(src_path, m, imports, target_word(target_get(target))))
} else if (nargs >= 2 and args[1] == "link") {
    if (nargs < 5) usage()
    units := map(vasm_unit_read, args_from(args, 4))
    vasm_build_units_for(intern(args[3]), units, args[2])
} else {
    if (nargs != 3 and nargs != 4) usage()
    target := if (nargs == 4) intern(args[3]) else target_default
    vasm_build_for(target, load(args[1], []), args[2])
}
