# vasmc: compiles a vasm source file (.vasm) or a psys source file (.psys) to an executable file (Linux)
# Copyright (C) 2026 nineties
#
# planck0 planck/vasmc.pk <source> <output> [<target>]
#
# The target is the name of a machine of backend/target.pk (x86 or x86_64); without it the default target is used.

use("vasm/build")
use("psys/expand")

args := argv()
if (array_len(args) != 3 and array_len(args) != 4) {
    put("usage: planck0 planck/vasmc.pk <source> <output> [<target>]\n")
    exit(2)
}
src_path := args[1]
out_path := args[2]
target := if (array_len(args) == 4) intern(args[3]) else target_default
text := read_file(src_path)
n := strlen(src_path)
is_psys := n > 5 and substr(src_path, n - 5, n) == ".psys"
parsed := peg_parse(if (is_psys) 'psys else 'vasm, text)
m := arg(parsed, 0)
if (head(m) == 'SyntaxError) {
    put(f"{src_path}: syntax error: {arg(m, 0)}\n")
    exit(1)
}
if (arg(parsed, 1) != "") {
    put(f"{src_path}: syntax error: unexpected input\n")
    exit(1)
}
if (is_psys) {
    expanded := psys_expand_all(m)
    perrs := psys_errors(src_path, arg(expanded, 1))
    if (perrs != []) {
        each((VasmErr{_, loc, msg}) -> put(f"{show_loc(loc)}: {msg}\n"), perrs)
        exit(1)
    }
    m = arg(expanded, 0)
}
errs := vasm_errors(src_path, m)
if (errs != []) {
    each((VasmErr{_, loc, msg}) -> put(f"{show_loc(loc)}: {msg}\n"), errs)
    exit(1)
}
vasm_build_for(target, m, out_path)
