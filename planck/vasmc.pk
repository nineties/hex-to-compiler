# vasmc: compiles a vasm source file (.vasm) or a native source file (.native) to an executable file (Linux)
# Copyright (C) 2026 nineties
#
# planck0 planck/vasmc.pk <source> <output> [<target>]
#
# The target is the name of a machine of backend/target.pk (x86_64); without it the default target is used.

use("vasm/build")
use("native/expand")

args := argv()
if (array_len(args) != 3 and array_len(args) != 4) {
    put("usage: planck0 planck/vasmc.pk <source> <output> [<target>]\n")
    exit(2)
}
src_path := args[1]
out_path := args[2]
machine := if (array_len(args) == 4) intern(args[3]) else target.default
text := read_file(src_path)
n := strlen(src_path)
is_native := n > 7 and substr(src_path, n - 7, n) == ".native"
parsed := peg_parse(if (is_native) 'native else 'vasm, text)
m := arg(parsed, 0)
if (head(m) == 'SyntaxError) {
    put(f"{src_path}: syntax error: {arg(m, 0)}\n")
    exit(1)
}
if (arg(parsed, 1) != "") {
    put(f"{src_path}: syntax error: unexpected input\n")
    exit(1)
}
if (is_native) {
    expanded := native_expand.expand_all(m)
    perrs := native_expand.errors(src_path, arg(expanded, 1))
    if (perrs != []) {
        each((VasmErr{_, loc, msg}) -> put(f"{error.show_loc(loc)}: {msg}\n"), perrs)
        exit(1)
    }
    m = arg(expanded, 0)
}
errs := vasm_check.errors(src_path, m)
if (errs != []) {
    each((VasmErr{_, loc, msg}) -> put(f"{error.show_loc(loc)}: {msg}\n"), errs)
    exit(1)
}
vasm_build.build_for(machine, m, out_path)
