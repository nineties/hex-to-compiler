# the results of fm against the results of the libm of a machine, as the bits of the arguments and the results: the status is the number of results that are more than 1 ulp apart
import fm

fun chk(r: f64, want: u64, s: &static [u8]) -> i64 {
    let b = f64_bits(r)
    if b == want { return 0 }
    if r != r and f64_from_bits(want) != f64_from_bits(want) { return 0 }
    var d: i64
    d = b as i64 - want as i64
    if d < 0 { d = 0 - d }
    if d <= 1 {
        write(1, "1ulp ")
        write(1, s)
        write(1, "\n")
        return 0
    }
    write(1, "BAD ")
    write(1, s)
    write(1, "\n")
    1
}

