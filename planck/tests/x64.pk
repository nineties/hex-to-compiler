# tests for backend/x64enc.pk: the bytes of the instructions of x86-64 (the tests of the encoding of single instructions and of the selection
# of instructions are the test blocks of backend/x64enc.pk and backend/x64.pk)
# Copyright (C) 2026 nineties

passed := 0
failed := 0

check(actual, expected) := if (actual == expected) {
    passed = passed + 1
} else {
    failed = failed + 1
    put("Test failed: expected "); print(expected)
    put(" but got "); println(actual)
}

use("backend/x64")

# a jump back to a label is relative to the end of the jump
o := obj.new("j")
e := x86enc.new(o, ".text")
x64enc.emit_code(e, [I{'label, [L{0}]}, I{'jcc, [Cc{'eq}, L{0}]}])
check(vector.to_list(obj.buf(obj.sec(o, ".text", 'code, 16))), [15, 132, 250, 255, 255, 255])

put("Tests passed "); print(passed); put("/"); println(passed + failed)
if (failed > 0) exit(1)
