# Copyright (C) 2026 nineties

passed := 0
failed := 0

check(actual, expected) := if (actual == expected) {
    passed = passed + 1
} else {
    failed = failed + 1
    print(f"Test failed: expected {expected} but got {actual}")
}

use("backend/x64")

o := object.new("j")
e := x86enc.new(o, ".text")
x64enc.emit_code(e, [I{'label, [L{0}]}, I{'jcc, [Cc{'eq}, L{0}]}])
check(vector.to_list(object.buf(object.section(o, ".text", 'code, 16))), [15, 132, 250, 255, 255, 255])

print(f"Tests passed {passed}/{passed + failed}")
if (failed > 0) exit(1)
