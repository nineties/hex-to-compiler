# === a literal is from -32768 to 32767, and a larger value is made with << and | ===
check(map(s -> vasm_literal_value(s), ["32767", "-32768", "0x7FFF", "0b101", "0o17", "32768", "-32769", "2147483647"]),
    [32767, -32768, 32767, 5, 15, Big{"32768"}, Big{"-32769"}, Big{"2147483647"}])
ok(vasm{|
    fun magic() -> u32 {
        var m: u32
        m = 0x7F45
        m = m << 16
        m = m | 0x4C46
        return m
    }
    fun edges() {
        var a: i16
        var b: i64
        var c: u64
        var d: u16
        a = -32768
        a = 32767
        b = -32768
        c = 0x7FFF
        c = c << 48
        d = 255
        d = d << 8
        d = d | 255
    }
    # 0xCBF29CE484222325 and 0xFFFFFFFF are made from bytes with << and |
    fun hash_seed() -> u64 {
        var h: u64
        h = 0xCB
        h = h << 8
        h = h | 0xF2
        h = h << 8
        h = h | 0x9C
        h = h << 8
        h = h | 0xE4
        h = h << 8
        h = h | 0x84
        h = h << 8
        h = h | 0x22
        h = h << 8
        h = h | 0x23
        h = h << 8
        h = h | 0x25
        return h
    }
    fun mask32() -> u64 {
        var m: u64
        m = 0xFF
        m = m << 8
        m = m | 0xFF
        m = m << 8
        m = m | 0xFF
        m = m << 8
        m = m | 0xFF
        return m
    }
|})
ng(vasm{|
    fun mask_in_one_literal() -> u64 {
        var m: u64
        m = 0xFFFFFFFF   # NG
        return m
    }
