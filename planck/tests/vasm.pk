# the message with the position of the literal
big_at := error.line_col(this_src, string.index_of_string(this_src, "65536 }", string.index_of_string(this_src, "fun shown_big(", 0)))
check(map((VasmError{_, loc, msg}) -> f"{error.show_loc(loc)}: {msg}", vasm_check.errors(this_file, vasm{|
    fun shown_big() { var c: u32; c = 65536 }
|})), [f"planck/tests/vasm.pk:{arg(big_at, 0)}:{arg(big_at, 1)}: 65536 is out of the range of a literal, -32768 to 32767; make it with << and |"])

# === string literals ===

# syntax: a literal is an operand with the bytes of the string; &static T is a type
sbody := arg(arg(vasm{| fun g() { x = "a\tb"; f("c", 1) } |}, 0)[0], 5)
check(map(head, append([arg(arg(sbody[0], 2), 0)], arg(sbody[1], 2))), ['String, 'String, 'Imm])
check(arg(arg(arg(sbody[0], 2), 0), 1), "a\tb")
check(map((Param{_, x, t}) -> Tuple{x, t}, arg(arg(vasm{| fun g(s: &static [u8]) {} |}, 0)[0], 3)), [Tuple{'s, Ref{'shr, 'static, Array{U8{}}}}])
check(vasm_check.show_type(Ref{'shr, 'static, Array{U8{}}}), "&static [u8]")

# a literal is a shared borrow of an array of u8 that lasts to the end of the program
ok(vasm{|
    fun literals() -> i64 {
        var n: i64
        n = write(1, "hello\n")
        n = len("abc")
        return n
    }
|})
# kept in a register of type &static, returned, and given where a borrow of any region is taken
ok(vasm{|
    fun name() -> &static [u8] {
        return "name"
    }
    fun size[r](s: &r [u8]) -> i64 {
        var n: i64
        n = len(s)
        return n
    }
    fun use_literals() -> i64 {
        var s: &static [u8]
        var n: i64
        var c: u8
        s = name()
        n = size("x")
        n = size(s)
        c = s[0]
        region q {
            var t: &q [u8]
            t = "inside"
            n = size(t)
            n = size("y")
        }
        return n
    }
|})
ng(vasm{|
    fun not_a_number() -> i64 {
        var n: i64
        n = "text"      # NG
        return n
    }
|}, 'type)
ng(vasm{|
    fun not_mutable() {
        var s: &static [u8]
        s = "abc"
        s[0] = 65       # NG
    }
|}, 'borrowed)
ng(vasm{|
    fun not_owned() {
        var a: own [u8]
        a = "abc"       # NG
    }
|}, 'type)
ng(vasm{|
    fun no_free() {
        free("abc")     # NG
    }
|}, 'type)
ng(vasm{|
    fun no_own_of_borrow() {
        var p: own &static [u8]     # NG
    }
|}, 'type)
# a borrow of a region that ends is not a borrow of static
ng(vasm{|
    fun short_lived() -> &static [u8] {
        var a: own [u8]
        var s: &static [u8]
        a = allocate(3, 65)
        region r {
            var b: &r [u8]
            b = &r a
            s = b       # NG
        }
        free(a)
        return s
    }
|}, 'escape)

# === value ===
ok(vasm{|
    fun id(c: value, x: value) -> value {
        return x
    }
    fun use_all(a: value, n: i64) -> i64 {
        var b: value
        var c: value
        var t: bool
        var m: i64
        var s: own [u8]
        b = a
        c = a
        c = value Pair(a, b)
        c = fun id(a)
        c = c(b)
        t = a == b
        t = is(a, 'Pair, 2)
        c = n as value
        m = c as i64
        c = "text" as value
        s = c as own [u8]
        c = true as value
        t = c as bool
        c = array(n, 'none)
        c[0] = a
        b = c[0]
        c = typeof(a)
        c = head(a)
        m = arity(a)
        return m
    }
|})
ng(vasm{|
    fun f(a: value) -> i64 {
        var n: i64
        n = a            # NG
        return n
    }
|}, 'type)
ng(vasm{|
    fun f(n: i64) -> value {
        var a: value
        a = n            # NG
        return a
    }
|}, 'type)
ng(vasm{|
    fun f(n: i64) -> value {
        var a: value
        a = value Pair(n)  # NG
        return a
    }
|}, 'type)
ng(vasm{|
    fun g(n: i64) -> value {
        return 'none
    }
    fun f(a: value) -> value {
        var b: value
        b = fun g()       # NG
        return b
    }
|}, 'type)
ng(vasm{|
    fun g(a: value) -> value {
        return a
    }
    fun f(a: value) -> value {
        var b: value
        b = fun g(a, a)   # NG
        return b
    }
|}, 'type)
ng(vasm{|
    fun f(a: value) -> value {
        var b: value
        var n: i64
        n = 1
        b = a(n)         # NG
        return b
    }
|}, 'type)
ng(vasm{|
    fun f(a: value) -> value {
        var b: value
        return b         # NG
    }
|}, 'uninit)
ng(vasm{|
    fun f(a: value) -> value {
        var b: own [value]
        b = allocate(1, a)  # NG
        return a
    }
|}, 'owner)
ng(vasm{|
    fun f(a: value) -> i64 {
        var b: &static [u8]
        b = a as &static [u8]   # NG
        return 0
    }
|}, 'type)
# the same literal is stored once
use("vasm/ir")
lowered := vasm_ir.lower(vasm{|
    fun twice() {
        write(1, "same")
        write(1, "other")
        write(1, "same")
    }
|}, 8)
check(vasm_ir.strings(), ["same", "other"])
check(map((IRData{n, section, _, b, _}) -> Tuple{n, section, vector.to_list(b)}, map(vasm_ir.string_data, vasm_ir.strings())),
    [Tuple{"__str:same", ".rodata", [4, 0, 0, 0, 0, 0, 0, 0, 115, 97, 109, 101]},
     Tuple{"__str:other", ".rodata", [5, 0, 0, 0, 0, 0, 0, 0, 111, 116, 104, 101, 114]}])

put("Tests passed "); print(passed); put("/"); println(passed + failed)
if (failed > 0) exit(1)
