        var n: i32
        n = argc()      # NG
    }
|}, 'type)
ng(vasm{|
    fun bad_close(c: bool) {
        close(c)    # NG
    }
|}, 'type)
# the name of the file is a borrow of an array of u8, not an integer or an owner
