# what is written over is released
ok(vasm{|
    fun over_elem[r](a: &mutable r [own i64]) {
        var x: own i64
        x = box(1)
        a[0] = x
    }
    struct Pair { left: own i64, right: own i64 }
    fun over_field[r](p: &mutable r Pair) {
        var x: own i64
        x = box(1)
        p.left = x
    }
    fun over_box(p: own own i64) {
        var q: own i64
        q = box(1)
        *p = q
        free(p)
    }
    fun over_reg(s: Pair) -> Pair {
        var x: own i64
        x = box(1)
        s.left = x
        return s
    }
    fun over_reg_twice(s: Pair) -> Pair {
        var x: own i64
        var y: own i64
        x = box(1)
        y = box(2)
        s.left = x
        s.left = y
        return s
    }
|})
# the value that was written over is not used again
