# === own in own, in arrays and in structs ===

# syntax: swap takes a place *p, p[i] or p.f
swap_body := arg(arg(vasm{| fun g() { x = swap(*p, y); x = swap(a[i], y); x = swap(s.f, y) } |}, 0)[0], 5)
check(map(s -> map(head, arg(arg(s, 2), 2)), swap_body), [['Load, 'Reg], ['Index, 'Reg], ['Get, 'Reg]])
check(vasm_check.show_type(Own{Own{Array{Own{U8{}}}}}), "own own [own u8]")

# own in own: x = *p moves the contents out, and p is freed or given contents again
ok(vasm{|
    fun nested_box() -> i64 {
        var p: own own i64
        var q: own i64
        var v: i64
        q = box(1)
        p = box(q)
        q = *p
        v = *q
        *p = q
        q = *p
        free(p)
        free(q)
        return v
    }
|})

# a struct with own: made with the own values, moved as a whole, and taken apart by its fields
ok(vasm{|
    struct Buf { data: own [u8], size: i64 }
    fun make(n: i64) -> Buf {
        var a: own [u8]
        var b: Buf
        a = allocate(n, 0)
        b = Buf{data: a, size: n}
        return b
    }
    fun drop(b: Buf) -> i64 {
        var a: own [u8]
        var n: i64
        a = b.data
        n = b.size
        free(a)
        return n
    }
    fun refill(b: Buf) -> Buf {
        var a: own [u8]
        var c: own [u8]
        a = b.data
        c = allocate(4, 1)
        b.data = c
        free(a)
        return b
    }
    fun use_buf() -> i64 {
        var b: Buf
        var c: Buf
        var n: i64
        b = make(16)
        c = b
        c = refill(c)
        n = drop(c)
        return n
    }
|})

# swap takes own values out of arrays, structs and borrows, and puts others in
ok(vasm{|
    struct Pair { left: own i64, right: own i64 }
    fun swaps[r](a: &mutable r [own i64], m: &mutable r own i64, p: &mutable r Pair) {
        var x: own i64
        var y: own i64
        var n: i64
        x = box(1)
        x = swap(a[0], x)
        x = swap(*m, x)
        x = swap(p.left, x)
        y = swap(p.right, x)
        n = len(a)
        free(y)
    }
    fun pair_box() {
        var b: own Pair
        var s: Pair
        var l: own i64
        var r: own i64
        var n: i64
        l = box(1)
        r = box(2)
        s = Pair{left: l, right: r}
        b = box(s)
        l = box(3)
        l = swap(b.left, l)
        free(l)
        region q {
            var m: &mutable q Pair
            m = &mutable q b
            l = box(4)
            l = swap(m.right, l)
            free(l)
        }
        s = *b
        free(b)
        l = s.left
        r = s.right
        free(l)
        free(r)
    }
    fun plain_swap(a: own [i64]) -> i64 {
        var v: i64
        v = swap(a[0], 7)
        free(a)
        return v
    }
|})

