# a field that owns is moved out of a struct value with x = s.f
ok(vasm{|
    struct Pair { left: own i64, right: own i64 }
    struct Buf { data: own [u8], size: i64 }
    fun take_all(s: Pair) {
        var l: own i64
        var r: own i64
        l = s.left
        r = s.right
        free(l)
        free(r)         # s owns nothing now and is dropped
    }
    fun take_and_put_back(b: Buf) -> Buf {
        var a: own [u8]
        var n: i64
        a = b.data
        n = b.size      # a field that does not own is read while another is moved out
        b.data = a      # put back, so b is whole again
        return b
    }
    fun take_in_both(c: bool, s: Pair) {
        var l: own i64
        var r: own i64
        l = s.left
        r = s.right
        if (c) { free(l); free(r) } else { free(r); free(l) }
    }
|})
ng(vasm{|
    struct Pair { left: own i64, right: own i64 }
    fun whole_after_all(s: Pair) -> Pair {
        var l: own i64
        var r: own i64
        l = s.left
        r = s.right
        free(l)
        free(r)
        return s        # NG
    }
|}, 'moved)
ng(vasm{|
    struct Pair { left: own i64, right: own i64 }
