# the names of the services belong to the language
ng(vasm{|
    fun write(a: i64) {  # NG
    }
|}, 'type)

# === ports to the arguments and the files: argc, argv, open, read and close ===
ok(vasm{|
    fun ports[r](name: &r [u8]) -> i64 {
        var n: i64
        var fd: i64
        var a: own [u8]
        var s: &static [u8]
        n = argc()
        s = argv(0)
        fd = open(name)
        a = allocate(16, 0)
        region q {
            var m: &mutable q [u8]
            m = &mutable q a
            n = read(fd, m)
        }
        close(fd)
        fd = open("data")
        return n
    }
|})
