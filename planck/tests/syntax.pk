# tests for the syntax (planck/syntax.pk) and the packrat parser (planck/peg.pk)
# Copyright (C) 2026 nineties

passed := 0
failed := 0

check(actual, expected) := if (actual == expected) {
    passed = passed + 1
} else {
    failed = failed + 1
    put("Test failed: expected "); print(expected)
    put(" but got "); println(actual)
}

# the tree of the first expression in s
tree(s) := arg(peg_parse('toplevel, s), 0)
# the rest of s after the first expression
rest(s) := arg(peg_parse('toplevel, s), 1)

# === Atoms ===
check(tree("x"), 'x)
check(tree("42"), 42)
check(tree("-3"), -3)
check(tree("0x1f"), 31)
check(tree("0b101"), 5)
check(tree("0o17"), 15)
check(tree("010"), 10)
check(tree("1.5"), 'Apply{_float, Tuple{"1.5"}})
check(tree("0.25"), 'Apply{_float, Tuple{"0.25"}})
check(tree("-1.5"), 'Apply{_float, Tuple{"-1.5"}})
check(tree("1.5e-3"), 'Apply{_float, Tuple{"1.5e-3"}})
check(tree("1.5E3"), 'Apply{_float, Tuple{"1.5E3"}})
check(tree("2.0e10"), 'Apply{_float, Tuple{"2.0e10"}})
check(tree("1.5 + 2"), 'Apply{_add, Tuple{Apply{_float, Tuple{"1.5"}}, 2}})
check(tree("f(1.5, x)"), 'Apply{f, Tuple{Apply{_float, Tuple{"1.5"}}, x}})
check(rest("1.5 x"), "x")
# a float needs digits on both sides of the point and after e
check(head(tree("1.5e x")), 'SyntaxError)
check(head(tree("1. 5")), 'SyntaxError)
check(tree("1073741823"), 1073741823)
check(tree("-1073741824"), -1073741824)
check(tree("0x3fffffff"), 1073741823)
check(tree("-0"), 0)
check(tree("1073741824"), 'Apply{_bigint, Tuple{"1073741824"}})
check(tree("-1073741825"), 'Apply{_bigint, Tuple{"-1073741825"}})
check(tree("123456789012345678901234567890"), 'Apply{_bigint, Tuple{"123456789012345678901234567890"}})
check(tree("0xCBF29CE484222325"), 'Apply{_bigint, Tuple{"0xCBF29CE484222325"}})
check(tree("0b1000000000000000000000000000000"), 'Apply{_bigint, Tuple{"0b1000000000000000000000000000000"}})
check(tree("2 * 123456789012345678901234567890"), 'Apply{_mul, Tuple{2, Apply{_bigint, Tuple{"123456789012345678901234567890"}}}})
check(rest("123456789012345678901234567890 x"), "x")
check(tree("\"a\\tb\\n\""), "a\tb\n")
check(strlen(tree("\"a\\0b\"")), 3)
check(ord(tree("\"a\\0b\""), 1), 0)
check(tree("\"\\0\""), substr("a\0b", 1, 2))
check(tree("f\"a\\0b\""), tree("\"a\\0b\""))
check(tree("\"\\\"q\\\"\""), "\"q\"")
check(tree("F{1, x}"), 'F{1, x})
check(tree("()"), 'Tuple{})
check(tree("(1)"), 1)
check(tree("(1, x)"), 'Tuple{1, x})
check(tree("[1, 2]"), 'Cons{1, Cons{2, Nil{}}})
check(tree("[]"), 'Nil{})

# === Operators ===
check(tree("1 + 2 * 3"), 'Apply{_add, Tuple{1, Apply{_mul, Tuple{2, 3}}}})
check(tree("(1 + 2) * 3"), 'Apply{_mul, Tuple{Apply{_add, Tuple{1, 2}}, 3}})
check(tree("1 - 2 - 3"), 'Apply{_sub, Tuple{Apply{_sub, Tuple{1, 2}}, 3}})
check(tree("8 / 4 % 3"), 'Apply{_mod, Tuple{Apply{_div, Tuple{8, 4}}, 3}})
check(tree("8 // 4 % 3"), 'Apply{_mod, Tuple{Apply{_quo, Tuple{8, 4}}, 3}})
check(tree("8 / 4 // 2"), 'Apply{_quo, Tuple{Apply{_div, Tuple{8, 4}}, 2}})
check(tree("1 + 7 // 2"), 'Apply{_add, Tuple{1, Apply{_quo, Tuple{7, 2}}}})
check(tree("a + 1 < b"), 'Apply{_lt, Tuple{Apply{_add, Tuple{a, 1}}, b}})
check(tree("a <= b"), 'Apply{_le, Tuple{a, b}})
check(tree("a >= b"), 'Apply{_ge, Tuple{a, b}})
check(tree("a > b"), 'Apply{_gt, Tuple{a, b}})
check(tree("a == b"), 'Apply{_eq, Tuple{a, b}})
check(tree("a != b"), 'Apply{_ne, Tuple{a, b}})
check(tree("not a == b"), 'Apply{_not, Tuple{Apply{_eq, Tuple{a, b}}}})
check(tree("a and b or c"), 'If{If{a, b, false}, true, c})
check(tree("a or b and c"), 'If{a, true, If{b, c, false}})
check(tree("-x"), 'Apply{_sub, Tuple{0, x}})
check(tree("+3"), 3)
check(tree("+x"), 'x)
check(tree("+-x"), 'Apply{_sub, Tuple{0, x}})
check(tree("-+x"), 'Apply{_sub, Tuple{0, x}})
check(tree("a + +b"), 'Apply{_add, Tuple{a, b}})
check(tree("a - +b"), 'Apply{_sub, Tuple{a, b}})
check(tree("+f(x)"), 'Apply{f, Tuple{x}})
check(tree("a - -1"), 'Apply{_sub, Tuple{a, -1}})

# === Calls, functions and definitions ===
check(tree("f(x, 1)"), 'Apply{f, Tuple{x, 1}})
check(tree("f()(x)"), 'Apply{Apply{f, Tuple{}}, Tuple{x}})
check(tree("x -> x + 1"), 'Lambda{Tuple{x}, Apply{_add, Tuple{x, 1}}})
check(tree("(x, y) -> x"), 'Lambda{Tuple{x, y}, x})
check(tree("() -> 1"), 'Lambda{Tuple{}, 1})
check(tree("x -> y -> x"), 'Lambda{Tuple{x}, Lambda{Tuple{y}, x}})
check(tree("(0) -> 1 | (n) -> n"), 'Fusion{Lambda{Tuple{0}, 1}, Lambda{Tuple{n}, n}})
check(tree("(F{a}, 'none) -> a"), 'Lambda{Tuple{F{a}, Quote{none}}, a})
check(tree("(x @ int) -> x"), 'Lambda{Tuple{_TypeOf{x, int}}, x})
check(tree("x := 1"), 'Def{x, 1})
check(tree("f(x) := x"), 'Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{x}, x}}}})
check(tree("x = y"), 'Set{x, y})

# === Quotation ===
check(tree("'a"), 'Quote{a})
check(tree("'(a + 1)"), 'Quote{Apply{_add, Tuple{a, 1}}})
check(tree("`F{!x}"), 'QuasiQuote{F{UnQuote{x}}})
check(tree("`{ !i := 1; !i = !i + 1 }"), 'QuasiQuote{Do{Def{UnQuote{i}, 1}, Set{UnQuote{i}, Apply{_add, Tuple{UnQuote{i}, 1}}}}})
check(tree("`(if (c) !i = 1 else !i := 2)"), 'QuasiQuote{If{c, Set{UnQuote{i}, 1}, Def{UnQuote{i}, 2}}})

# === Blocks and control ===
check(tree("{ a; b }"), 'Do{a, b})
check(tree("{\n a\n b\n}"), 'Do{a, b})
check(tree("{}"), 'Do{})
check(tree("if (a) { b }"), 'If{a, Do{b}, none})
check(tree("if (a) { b } else { c }"), 'If{a, Do{b}, Do{c}})
check(tree("if (a) { b }\nelse if (c) { d }"), 'If{a, Do{b}, If{c, Do{d}, none}})
check(tree("while (a) { b }"), 'While{a, Do{b}})
check(tree("handle { a } with (E{}, k) -> k(1)"), 'Handle{Do{a}, Lambda{Tuple{E{}, k}, Apply{k, Tuple{1}}}})
check(tree("if (a) b"), 'If{a, b, none})
check(tree("if (a) b else c"), 'If{a, b, c})
check(tree("if (a) x = 1 else x = 2"), 'If{a, Set{x, 1}, Set{x, 2}})
check(tree("if (a) b else if (c) d else e"), 'If{a, b, If{c, d, e}})
check(tree("if (a) if (b) c else d"), 'If{a, If{b, c, d}, none})
check(tree("if (a) if (b) c else d else e"), 'If{a, If{b, c, d}, e})
check(tree("if (a) { if (b) c } else d"), 'If{a, Do{If{b, c, none}}, d})
check(tree("if (a)\n  b\nelse\n  c"), 'If{a, b, c})
check(tree("if (a) b else c + 1"), 'If{a, b, Apply{_add, Tuple{c, 1}}})
check(tree("while (a) b"), 'While{a, b})
check(tree("while (a) if (b) c else d"), 'While{a, If{b, c, d}})
check(tree("{ if (a) b; c }"), 'Do{If{a, b, none}, c})
check(tree("{ if (a) b\n c }"), 'Do{If{a, b, none}, c})
check(tree("{ while (a) b\n c }"), 'Do{While{a, b}, c})
check(tree("y = if (a) 1 else 2"), 'Set{y, If{a, 1, 2}})
check(head(tree("if a { b }")), 'SyntaxError)
check(head(tree("while a { b }")), 'SyntaxError)
check(tree("perform E{x}"), 'Perform{E{x}})

# === Cons ===
check(tree("x :: xs"), 'Cons{x, xs})
check(tree("1 :: 2 :: []"), 'Cons{1, Cons{2, Nil{}}})
check(tree("a + 1 :: b * 2"), 'Cons{Apply{_add, Tuple{a, 1}}, Apply{_mul, Tuple{b, 2}}})
check(tree("a :: b == c :: d"), 'Apply{_eq, Tuple{Cons{a, b}, Cons{c, d}}})
check(tree("a :: b - 1"), 'Cons{a, Apply{_sub, Tuple{b, 1}}})
check(tree("(a :: b) :: c"), 'Cons{Cons{a, b}, c})

# a..b is Range{a, b}. It binds looser than + - and tighter than the comparisons and ::
check(tree("0..3"), 'Range{0, 3})
check(tree("a .. b"), 'Range{a, b})
check(tree("a + 1..b * 2"), 'Range{Apply{_add, Tuple{a, 1}}, Apply{_mul, Tuple{b, 2}}})
check(tree("a..b == c..d"), 'Apply{_eq, Tuple{Range{a, b}, Range{c, d}}})
check(tree("x :: 1..2"), 'Cons{x, Range{1, 2}})
check(tree("f(0..n, 1)"), 'Apply{f, Tuple{Range{0, n}, 1}})
check(tree("for (i in 0..3) f(i)"), 'Apply{peg_for, Tuple{Range{0, 3}, Lambda{Tuple{i}, Apply{f, Tuple{i}}}}})
check(tree("s[1..2]"), 'Apply{_index_get, Tuple{s, Range{1, 2}}})
check(tree("f(a :: b, c)"), 'Apply{f, Tuple{Cons{a, b}, c}})
check(tree("[a :: b]"), 'Cons{Cons{a, b}, Nil{}})
check(tree("(x :: xs) -> x"), 'Lambda{Tuple{Cons{x, xs}}, x})
check(tree("x :: xs -> x"), 'Lambda{Tuple{Cons{x, xs}}, x})
check(tree("(x :: y :: r, n) -> x"), 'Lambda{Tuple{Cons{x, Cons{y, r}}, n}, x})
check(tree("(x :: Nil{}) -> x | (x :: xs) -> xs"), 'Fusion{Lambda{Tuple{Cons{x, Nil{}}}, x}, Lambda{Tuple{Cons{x, xs}}, xs}})
check(tree("f(x :: xs) := x"), 'Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{Cons{x, xs}}, x}}}})
check(tree("xs ::= ident"), 'Apply{_define_rule, Tuple{Quote{xs}, Quote{ident}}})

# === Lines and comments ===
check(tree("a\n-1"), 'a)
check(rest("a\n-1"), "-1")
check(tree("a -\n1"), 'Apply{_sub, Tuple{a, 1}})
check(tree("a # comment\n+ 1"), 'Apply{_add, Tuple{a, 1}})
check(tree("f\n(x)"), 'f)
check(rest("x := 1; y"), "y")
check(tree(" \n# only a comment\n"), 'Eof{})
check(head(tree("1 +")), 'SyntaxError)
check(rest("1 2"), "2")
check(head(tree("x := (1")), 'SyntaxError)
check(head(tree("x := )")), 'SyntaxError)
check(head(tree(")")), 'SyntaxError)
check(head(tree("\"abc")), 'SyntaxError)

# === Evaluation of the new syntax ===
fun fib
fib(0) = 0
fib(1) = 1
fib(n) = fib(n - 1) + fib(n - 2)
check(fib(15), 610)
check({ a := 2; b := 3; a * b }, 6)
check(if (1 < 2) { "y" } else { "n" }, "y")
check(if (1 > 2) { "y" }, none)
n := 0
i := 0
while (i < 5) { i = i + 1; n = n + i }
check(n, 15)
fun last
last = (x :: Nil{}) -> x | (x :: xs) -> last(xs)
check(last(1 :: 2 :: 3 :: []), 3)
check(1 :: 2 :: [], [1, 2])
fun sum
sum = (Nil{}) -> 0 | (x :: xs) -> x + sum(xs)
check(sum(1 :: 2 :: 3 :: []), 6)
count := 0
if (count == 0) count = 10 else count = 20
check(count, 10)
if (count == 0) count = 1 else if (count == 10) count = 2 else count = 3
check(count, 2)
# dangling else binds to the nearest if
dangle(a, b) := if (a) if (b) "ab" else "a-nb"
check(dangle(true, true), "ab")
check(dangle(true, false), "a-nb")
check(dangle(false, true), none)
check(dangle(false, false), none)
dangle2(a, b) := if (a) { if (b) "ab" } else "na"
check(dangle2(false, true), "na")
check(dangle2(true, false), none)
k := 0
total := 0
while (k < 4) { k = k + 1; total = total + k }
check(total, 10)
while (k > 0) if (k % 2 == 0) k = k - 1 else k = k - 1
check(k, 0)
check(handle { 1 + perform Ask{} } with (Ask{}, k) -> k(41), 42)
check((x -> y -> x - y)(10)(3), 7)
check(not 1 == 2, true)
check(1 == 1 and 2 == 3, false)
check(false or 3 > 2, true)
add3(a, b, c) := a + b + c
check(add3(1, 2, 3), 6)
fun len
len = (Nil{}) -> 0 | (Cons{_, xs}) -> 1 + len(xs)
check(len([1, 2, 3]), 3)
x := 5
check(`F{!x, x}, 'F{5, x})
w := 'name
check(`{ !w := 1; !w = 2 }, 'Do{Def{name, 1}, Set{name, 2}})
check(Apply{_add, Tuple{1, 2}}, 3)

# === match ===
check(tree("match x { A{a} -> a\n| B{} -> 0 }"), 'Apply{Fusion{Lambda{Tuple{A{a}}, a}, Lambda{Tuple{B{}}, 0}}, Tuple{x}})
check(tree("match x { 1 -> 2 }"), 'Apply{Lambda{Tuple{1}, 2}, Tuple{x}})
check(tree("match f(x) + 1 { y -> y | _ -> 0 }"), 'Apply{Fusion{Lambda{Tuple{y}, y}, Lambda{Tuple{_}, 0}}, Tuple{Apply{_add, Tuple{Apply{f, Tuple{x}}, 1}}}})
check(tree("match l {\n  x :: xs -> x\n| Nil{} -> 0\n}"), 'Apply{Fusion{Lambda{Tuple{Cons{x, xs}}, x}, Lambda{Tuple{Nil{}}, 0}}, Tuple{l}})
check(tree("match x {\n  -1 -> 1\n| ((a, b)) -> a\n}"), 'Apply{Fusion{Lambda{Tuple{-1}, 1}, Lambda{Tuple{Tuple{a, b}}, a}}, Tuple{x}})
check(head(tree("match x { }")), 'SyntaxError)
check(head(tree("match x A{} -> 1")), 'SyntaxError)
check(head(tree("match x { a b }")), 'SyntaxError)

shape(n) := match n {
    n if n < 0 -> "neg"
  | 0 -> "zero"
  | n if n < 10 and n % 2 == 1 -> "small odd"
  | n if n < 10 -> "small even"
  | _ -> "big"
}
check(shape(-5), "neg")
check(shape(0), "zero")
check(shape(7), "small odd")
check(shape(8), "small even")
check(shape(70), "big")
# a guard that is false goes on to the arms after it, with the same value
check(match 5 { n if n > 10 -> "a" | n if n > 3 -> "b" | _ -> "c" }, "b")
check(match 5 { 5 if false -> "a" | 5 -> "b" }, "b")
fun tree_eval
tree_eval = (e) -> match e {
    Num{n} -> n
  | Neg{e} -> 0 - tree_eval(e)
  | Add{a, b} -> tree_eval(a) + tree_eval(b)
  | Mul{a, b} -> tree_eval(a) * tree_eval(b)
}
check(tree_eval(Add{Num{2}, Mul{Num{3}, Neg{Num{4}}}}), -10)
check(match [1, 2] { x :: xs -> x | Nil{} -> 0 }, 1)
check(match 'a { 'a -> 1 | 'b -> 2 }, 1)
k := 3
check(match k { 3 -> match k + 1 { n if n > 3 -> "inner" | _ -> "no" } | _ -> "outer" }, "inner")
# matching nested guards: each match has its own variables
nest(a, b) := match a { x if x > 0 -> match b { y if y > 0 -> x + y | _ -> x } | _ -> 0 }
check(nest(1, 2), 3)
check(nest(1, -2), 1)
check(nest(-1, 2), 0)
# the scrutinee is evaluated once
calls := 0
once() := { calls = calls + 1; 5 }
check(match once() { n if n > 9 -> 1 | n if n > 4 -> 2 | _ -> 3 }, 2)
check(calls, 1)
# an arm may change variables of the outside
acc := 0
match 4 { n if n > 3 -> { acc = acc + n } | _ -> { acc = 100 } }
check(acc, 4)
# the inside of match is a function joined by |, applied to the value
check(tree("match x { 1 -> a | 2 -> b | _ -> c }"), 'Apply{Fusion{Lambda{Tuple{1}, a}, Fusion{Lambda{Tuple{2}, b}, Lambda{Tuple{_}, c}}}, Tuple{x}})
check(tree("match x { f }"), 'Apply{f, Tuple{x}})
inc := (x) -> x + 1
check(match 4 { inc }, 5)
check(match 4 { inc | _ -> 0 }, 5)
check(head(tree("match x { 1 -> a; 2 -> b }")), 'SyntaxError)
# a | at the start of a line goes on with the arms, and a comment may come between them
check(tree("match x {\n    1 -> a   # one\n  | 2 -> b\n}"), tree("match x { 1 -> a | 2 -> b }"))
check(tree("match x {\n    1 -> a\n    | 2 -> b\n}"), tree("match x { 1 -> a | 2 -> b }"))
# a branch of if, and the value of return, end before |
check(tree("match x { 0 -> if (c) 1 else 2 | n -> n }"), 'Apply{Fusion{Lambda{Tuple{0}, If{c, 1, 2}}, Lambda{Tuple{n}, n}}, Tuple{x}})
check(tree("match x { 0 -> if (c) 1 | n -> n }"), 'Apply{Fusion{Lambda{Tuple{0}, If{c, 1, none}}, Lambda{Tuple{n}, n}}, Tuple{x}})
check(tree("if (c) x = 1 else y := 2"), 'If{c, Set{x, 1}, Def{y, 2}})
check(tree("if (c) (f | g) else h"), 'If{c, Fusion{f, g}, h})
lev(n) := match n {
    0 -> if (n == 0) "zero" else "?"
  | n if n < 0 -> if (n < -9) "low" else "neg"
  | _ -> "pos"
}
check(lev(0), "zero")
check(lev(-3), "neg")
check(lev(-30), "low")
check(lev(4), "pos")
first_pos(xs) := {
    for (x in xs) match x { n if n > 0 -> return n | _ -> none }
    0
}
check(first_pos([-1, 0, 7, 8]), 7)
check(first_pos([-1]), 0)
# a match in an arm, which is not the last one
kind(a, b) := match a {
    0 -> match b {
        0 -> "both"
      | _ -> "a"
    }
  | x if x > 0 -> match b { 0 -> "b" | _ -> "none" }
  | _ -> "neg"
}
check(kind(0, 0), "both")
check(kind(0, 1), "a")
check(kind(1, 0), "b")
check(kind(1, 1), "none")
check(kind(-1, 0), "neg")
# an arm takes one parameter, so a tuple pattern is in parentheses
check(match (1, 2) { ((a, b)) -> a + b | _ -> 0 }, 3)
check(match (1, 2) { (a, b) -> a + b | _ -> 0 }, 0)
# patterns written as expressions with guards
check(match '(x * x) { a * b if a == b -> a | _ -> 0 }, 'x)
check(match '(x * y) { a * b if a == b -> a | a * b -> b | _ -> 0 }, 'y)
check(match '(1 + 2) { a @ int + b @ int if a < b -> b - a | _ -> 0 }, 1)
# a guard in a function outside of match: the functions after its | are tried when it is false
sgn := n if n > 0 -> 1 | n if n < 0 -> -1 | _ -> 0
check(sgn(5), 1)
check(sgn(-3), -1)
check(sgn(0), 0)
bigger := (a, b) if a > b -> a | (a, b) -> b
check(bigger(3, 1), 3)
check(bigger(1, 3), 3)
# the arguments of another number go to the functions after the guard
ar := (a, b) if a > 0 -> "two" | (a) -> "one"
check(ar(1, 1), "two")
check(ar(1), "one")
pos := n if n > 0 -> n
check(pos(2), 2)
# also in parentheses, and when the functions after it are joined in parentheses
pg := (n if n > 0 -> "pos") | (_ -> "other")
check(pg(-1), "other")
pg2 := (n if n > 0 -> "pos" | n if n < -5 -> "low") | _ -> "other"
check(pg2(-1), "other")
check(pg2(-9), "low")
check(tree("(n if c -> 1) | g"), tree("n if c -> 1 | g"))
pg3 := (0 -> "zero" | n if n > 0 -> "pos") | _ -> "other"
check(pg3(0), "zero")
check(pg3(-1), "other")
# a guard sees the variables of the parameters, and the body sees the variables outside
lim := 10
under := n if n < lim -> n + lim | n -> n
check(under(3), 13)
check(under(30), 30)

# === String interpolation ===
check(tree("f\"a{x}b\""), 'Apply{_strcat, Tuple{Apply{_strcat, Tuple{"a", Apply{_to_text, Tuple{x}}}}, "b"}})
check(tree("f\"{x}\""), 'Apply{_to_text, Tuple{x}})
check(tree("f\"{x}{y}\""), 'Apply{_strcat, Tuple{Apply{_to_text, Tuple{x}}, Apply{_to_text, Tuple{y}}}})
check(tree("f\"{1 + 2}\""), 'Apply{_to_text, Tuple{Apply{_add, Tuple{1, 2}}}})
check(tree("f\"a{f(\"q\")}\""), 'Apply{_strcat, Tuple{"a", Apply{_to_text, Tuple{Apply{f, Tuple{"q"}}}}}})
check(tree("f\"{ x }\""), 'Apply{_to_text, Tuple{x}})
check(tree("f\"a\\tb\""), "a\tb")
check(tree("f\"\""), "")
check(tree("f\"abc\""), "abc")
check(tree("f\"{{x}}\""), "{x}")
check(tree("f\"{{{x}}}\""), 'Apply{_strcat, Tuple{Apply{_strcat, Tuple{"{", Apply{_to_text, Tuple{x}}}}, "}"}})
check(tree("f\"\\\"{x}\""), 'Apply{_strcat, Tuple{"\"", Apply{_to_text, Tuple{x}}}})
check(tree("\"{x}\""), "{x}")
check(tree("\"a { b } {{\""), "a { b } {{")
check(head(tree("\"\\(x)\"")), 'SyntaxError)
check(head(tree("f\"a{x\"")), 'SyntaxError)
check(head(tree("f\"a{\"")), 'SyntaxError)
check(head(tree("f\"a{x}")), 'SyntaxError)
check(head(tree("f\"a}b\"")), 'SyntaxError)
check(head(tree("f\"a{}b\"")), 'SyntaxError)
check(rest("f\"{x}\" y"), "y")
check(tree("f(x)"), 'Apply{f, Tuple{x}})
check(tree("f"), 'f)
check(tree("f + 1"), 'Apply{_add, Tuple{f, 1}})
check(tree("f \"s\""), 'f)
check(rest("f \"s\""), "\"s\"")
check(tree("fx"), 'fx)
check(tree("foo\"s\""), 'foo)
check(rest("foo\"s\""), "\"s\"")

n := 7
word := "w"
check(f"n={n}", "n=7")
check(f"{n}", "7")
check(f"{n}:{n + 1}:{word}", "7:8:w")
check(f"[{word}] {word}{word}", "[w] ww")
check(f"neg {0 - 5}!", "neg -5!")
check(f"zero {0}", "zero 0")
check(f"tab\there {n}\n", "tab\there 7\n")
check(f"{{n}} is {n}", "{n} is 7")
check(f"{{{n}}}", "{7}")
check(f"}}{{", "}{")
check(f"", "")
check(f"plain", "plain")
check("{n} {{", "{n} {{")
check("a}b", "a}b")
wrap(s) := f"<{s}>"
check(f"a{wrap("x")}b", "a<x>b")
check(f"nest {wrap(f"in {n}")}", "nest <in 7>")
check(f"{wrap(wrap("x"))}", "<<x>>")
check(f"{if (n > 3) "big" else "small"}", "big")
f := x -> x + 1
check(f(2), 3)
check(f(n) + 1, 9)
check(f"{f(n)}", "8")
use("pretty")
check(f"list {[1, 2]}", "list [1, 2]")
check(f"sym {'a} tree {F{1, "s"}}", "sym a tree F{1, \"s\"}")

# === Records ===
check(tree("record Tok(kind, value, pos)"), 'Apply{_record_declare, Tuple{Quote{Tok}, Quote{Tuple{kind, value, pos}}}})
check(tree("record R()"), 'Apply{_record_declare, Tuple{Quote{R}, Quote{Tuple{}}}})
check(tree("t.kind"), 'Apply{_record_get, Tuple{t, Quote{kind}}})
check(tree("t.a.b"), 'Apply{_record_get, Tuple{Apply{_record_get, Tuple{t, Quote{a}}}, Quote{b}}})
check(tree("f(x).y"), 'Apply{_record_get, Tuple{Apply{f, Tuple{x}}, Quote{y}}})
check(tree("t.f(1)"), 'Apply{Apply{_record_get, Tuple{t, Quote{f}}}, Tuple{1}})
check(tree("a.b + c.d * 2"), 'Apply{_add, Tuple{Apply{_record_get, Tuple{a, Quote{b}}}, Apply{_mul, Tuple{Apply{_record_get, Tuple{c, Quote{d}}}, 2}}}})
check(tree("a.b == 'x"), 'Apply{_eq, Tuple{Apply{_record_get, Tuple{a, Quote{b}}}, Quote{x}}})
check(tree("x := t.v"), 'Def{x, Apply{_record_get, Tuple{t, Quote{v}}}})
check(tree("F{a.b}"), 'F{Apply{_record_get, Tuple{a, Quote{b}}}})
check(head(tree("t.")), 'SyntaxError)
check(head(tree("t.1")), 'SyntaxError)
check(head(tree("record Tok")), 'SyntaxError)
check(head(tree("record Tok(1)")), 'SyntaxError)

record Tok(kind, value, pos)
record Node(op, left, right)
record Rev(c, b, a)
record Fwd(a, b, c)
tk := Tok{'id, "abc", 3}
check(tk.kind, 'id)
check(tk.value, "abc")
check(tk.pos + 1, 4)
nd := Node{"+", Node{"*", 1, 2}, 3}
check(nd.op, "+")
check(nd.left.op, "*")
check(nd.left.right, 2)
check(nd.right, 3)
# the field is found by the head of the value
check(Rev{1, 2, 3}.a, 3)
check(Fwd{1, 2, 3}.a, 1)
getv(t) := t.value
check(getv(tk), "abc")
check(getv(Tok{'num, 7, 0}), 7)
check((match tk { Tok{k, v, p} -> k }), 'id)
record Tok(value, kind)
check(Tok{1, 2}.kind, 2)
check(record_index('Tok, 'kind), 1)
check(record_index('Tok, 'value), 0)
# the old names of a redeclared head are gone
check(record_index('Tok, 'pos), none)
check(record_index('Nope, 'kind), none)
# the same name under another head is another field
check(record_index('Node, 'op), 0)
check(record_index('Rev, 'a), 2)
check(record_index('Fwd, 'a), 0)
record Tok(kind, value, pos)
check(tk.kind, 'id)
check(_record_get(Tok{1, 2, 3}, 'pos), 3)
check(record_index('Tok, 'pos), 2)
record Tok(pos)
check(record_index('Tok, 'kind), none)
check(record_index('Tok, 'value), none)
check(_record_get(Tok{9}, 'pos), 9)
record Tok(kind, value, pos)
check(_record_get(Tok{1, 2, 3}, 'kind), 1)
record R0()
check(record_index('R0, 'x), none)

# === for, return and break ===
rh := 'Lambda{Tuple{Return{v}, k}, v}
bh := 'Lambda{Tuple{Break{}, k}, none}
check(tree("for (x in xs) f(x)"), 'Apply{peg_for, Tuple{xs, Lambda{Tuple{x}, Apply{f, Tuple{x}}}}})
check(tree("for (Tuple{a, b} in ps) a"), 'Apply{peg_for, Tuple{ps, Lambda{Tuple{Tuple{a, b}}, a}}})
check(tree("for (x in f(y)) { z }"), 'Apply{peg_for, Tuple{Apply{f, Tuple{y}}, Lambda{Tuple{x}, Do{z}}}})
check(tree("return 1"), 'Perform{Return{1}})
check(tree("return a + 1"), 'Perform{Return{Apply{_add, Tuple{a, 1}}}})
check(tree("return"), 'Perform{Return{none}})
check(tree("{ return\n 1 }"), 'Do{Perform{Return{none}}, 1})
check(tree("{ return }"), 'Do{Perform{Return{none}}})
check(tree("if (a) return 1 else 2"), 'If{a, Perform{Return{1}}, 2})
check(tree("break"), 'Perform{Break{}})
check(tree("f(x) := { return x }"), `Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{x}, Handle{Do{Perform{Return{x}}}, !rh}}}}})
check(tree("f(x) := x"), 'Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{x}, x}}}})
check(tree("x -> return x"), `Lambda{Tuple{x}, Handle{Perform{Return{x}}, !rh}})
check(tree("while (a) { break }"), `Handle{While{a, Do{Perform{Break{}}}}, !bh})
check(tree("while (a) b"), 'While{a, b})
check(tree("for (x in xs) break"), `Handle{Apply{peg_for, Tuple{xs, Lambda{Tuple{x}, Perform{Break{}}}}}, !bh})
# a loop or a function handles only its own return and break
check(tree("while (a) { while (b) break }"), `While{a, Do{Handle{While{b, Perform{Break{}}}, !bh}}})
check(tree("f() := { g() := return 1; 2 }"), `Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{}, Do{Do{Declare{g}, Set{g, Fusion{g, Lambda{Tuple{}, Handle{Perform{Return{1}}, !rh}}}}}, 2}}}}})
check(tree("f() := for (x in xs) return x"), `Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{}, Handle{Apply{peg_for, Tuple{xs, Lambda{Tuple{x}, Perform{Return{x}}}}}, !rh}}}}})
check(tree("f() := match x { 1 -> return 2 | _ -> 3 }"), `Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{}, Handle{Apply{Fusion{Lambda{Tuple{1}, Perform{Return{2}}}, Lambda{Tuple{_}, 3}}, Tuple{x}}, !rh}}}}})
check(tree("f() := '(return 1)"), 'Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{}, Quote{Perform{Return{1}}}}}}})
ch := 'Lambda{Tuple{Continue{}, k}, none}
check(tree("continue"), 'Perform{Continue{}})
check(tree("while (a) { continue }"), `While{a, Handle{Do{Perform{Continue{}}}, !ch}})
check(tree("for (x in xs) continue"), `Apply{peg_for, Tuple{xs, Lambda{Tuple{x}, Handle{Perform{Continue{}}, !ch}}}})
check(tree("while (a) { if (b) continue else break }"), `Handle{While{a, Handle{Do{If{b, Perform{Continue{}}, Perform{Break{}}}}, !ch}}, !bh})
check(tree("while (a) { for (x in xs) continue }"), `While{a, Do{Apply{peg_for, Tuple{xs, Lambda{Tuple{x}, Handle{Perform{Continue{}}, !ch}}}}}})
check(tree("while (a) b"), 'While{a, b})
check(head(tree("for x in xs f(x)")), 'SyntaxError)
check(head(tree("for (x in xs)")), 'SyntaxError)
check(head(tree("for (x xs) x")), 'SyntaxError)

use("list")
use("vector")
use("table")
total := 0
for (x in [1, 2, 3]) total = total + x
check(total, 6)
for (x in []) total = 100
check(total, 6)
vv := vector.new()
vector.push(vv, 10)
vector.push(vv, 20)
for (x in vv) total = total + x
check(total, 36)
for (Tuple{a, b} in [Tuple{1, 2}, Tuple{3, 4}]) total = total + a * b
check(total, 50)
check((for (x in [1]) x), none)
# for knows no type: it walks the iterator that _iter(xs) makes. The types of the core are the arms of _iter.
collect(xs) := {
    r := []
    for (x in xs) r = x :: r
    reverse(r)
}
check(collect(1..4), [1, 2, 3, 4])
check(collect(4..1), [])
check(collect([5, 6]), [5, 6])
check(collect([]), [])
check(collect([none, false, 0]), [none, false, 0])
check(collect([() -> 1])[0](), 1)
av := array(3)
av[0] = 7
av[2] = 9
check(collect(av), [7, none, 9])
check(collect(array(0)), [])
pv := u8_array(3)
pv[1] = 200
check(collect(pv), [0, 200, 0])
check(collect(u16_array(0)), [])
tv := table.new()
tv["a"] = 1
tv["b"] = 2
tv["c"] = 3
check(list.sum(map(kv -> kv[1], collect(tv))), 6)
check(length(collect(tv)), 3)
check(member("b", map(kv -> kv[0], collect(tv))), true)
check(length(collect(table.new())), 0)
bv := vector.new()
vector.push(bv, 1)
vector.push(bv, 2)
check(collect(bv), [1, 2])
check(collect(vector.new()), [])
# an element pushed in the loop is visited
grow := vector.new()
vector.push(grow, 1)
for (x in grow) if (x < 4) vector.push(grow, x + 1)
check(vector.to_list(grow), [1, 2, 3, 4])
# a type of the program is added by _iter in front, and it works with break, continue and return
record Countdown(n)
_iter = (Countdown{n}) -> {
    i := n
    (end) -> if (i > 0) {
        i -= 1
        i + 1
    } else end
} | _iter
check(collect(Countdown{3}), [3, 2, 1])
check(collect(Countdown{0}), [])
cd_sum := 0
for (x in Countdown{5}) {
    if (x == 4) continue
    if (x == 2) break
    cd_sum += x
}
check(cd_sum, 8)
cd_first(xs, k) := {
    for (x in xs) if (x < k) return x
    none
}
check(cd_first(Countdown{9}, 3), 2)
# a source that never ends, which only break stops
record Nat()
_iter = (Nat{}) -> {
    i := 0
    (end) -> {
        i += 1
        i - 1
    }
} | _iter
nat_sum := 0
for (x in Nat{}) {
    if (x > 10) break
    nat_sum += x
}
check(nat_sum, 55)
# the loops over the same value do not share their places, and a loop in a loop is fine
pairs := []
for (x in Countdown{2}) for (y in Countdown{2}) pairs = Tuple{x, y} :: pairs
check(length(pairs), 4)
find_first(p, xs) := {
    for (x in xs) {
        if (p(x)) return x
    }
    none
}
check(find_first(x -> x > 2, [1, 2, 3, 4]), 3)
check(find_first(x -> x > 9, [1, 2]), none)
n := 0
while (true) {
    n = n + 1
    if (n == 5) break
}
check(n, 5)
s := 0
for (x in range(1, 100)) {
    if (x > 4) break
    s = s + x
}
check(s, 10)
# break leaves only the inner loop
pairs := 0
for (i in range(0, 3)) {
    for (j in range(0, 3)) {
        if (j == 1) break
        pairs = pairs + 1
    }
}
check(pairs, 3)
# continue goes on to the next round of while and for
odd := 0
i := 0
while (i < 10) {
    i = i + 1
    if (i % 2 == 0) continue
    odd = odd + i
}
check(odd, 25)
evens := Nil{}
for (x in range(0, 8)) {
    if (x % 2 == 1) continue
    evens = Cons{x, evens}
}
check(evens, [6, 4, 2, 0])
tsum := 0
for (Tuple{a, b} in [Tuple{1, 2}, Tuple{0, 5}, Tuple{3, 4}]) {
    if (a == 0) continue
    tsum = tsum + a * b
}
check(tsum, 14)
# continue goes on in the inner loop only
cnt := 0
for (i in range(0, 3)) {
    for (j in range(0, 4)) {
        if (j == 1) continue
        cnt = cnt + 1
    }
    cnt = cnt + 100
}
check(cnt, 3 * 100 + 3 * 3)
# the code after the inner loop runs even when the inner loop continues in its last round
cnt = 0
i = 0
while (i < 3) {
    i = i + 1
    j := 0
    while (j < 3) {
        j = j + 1
        continue
        cnt = cnt + 1000
    }
    cnt = cnt + 1
}
check(cnt, 3)
# continue and break in one loop
k := 0
log := 0
while (true) {
    k = k + 1
    if (k > 8) break
    if (k % 3 != 0) continue
    log = log + k
}
check(log, 9)
# continue under match and in a function that has a return
skip_neg(xs) := {
    r := Nil{}
    for (x in xs) {
        match x { n if n < 0 -> continue | _ -> none }
        if (x == 99) return r
        r = Cons{x, r}
    }
    r
}
check(skip_neg([1, -2, 3, 99, 4]), [3, 1])
check(skip_neg([-1, 5]), [5])
# a continue in a function called from the body belongs to that function's own loop
f_in() := { t := 0; for (x in [1, 2, 3]) { if (x == 2) continue; t = t + x }; t }
w := 0
for (x in [1, 2]) { if (x == 1) continue; w = w + f_in() }
check(w, 4)
# return leaves the function, from inside loops
first_pair(xs) := {
    for (a in xs) {
        for (b in xs) {
            if (a < b) return Tuple{a, b}
        }
    }
    none
}
check(first_pair([3, 1, 2]), Tuple{1, 3})
check(first_pair([1]), none)
count_to(m) := {
    i := 0
    while (true) {
        i = i + 1
        if (i >= m) return i * 10
    }
}
check(count_to(4), 40)
bare() := { return; 1 }
check(bare(), none)
outer() := {
    inner() := return 1
    inner() + 10
}
check(outer(), 11)
by_match(x) := match x { 0 -> return "zero" | _ -> "other" }
check(by_match(0), "zero")
check(by_match(1), "other")
check(map(x -> { if (x > 1) return x * 2; x }, [1, 2, 3]), [1, 4, 6])
ask() := {
    r := perform Ask{}
    if (r > 0) return r * 2
    0
}
check(handle ask() with (Ask{}, k) -> k(21), 42)
check(handle ask() with (Ask{}, k) -> k(-1), 0)
# recursion keeps one Return handler for each call
fact(m) := { if (m <= 1) return 1; m * fact(m - 1) }
check(fact(10), 3628800)
# a loop variable is a pattern variable of the body only
x := 7
for (x in [1, 2]) total = total + x
check(x, 7)

# === the right-hand side of := sees the previous variable ===
check(tree("x := x + 1"), 'Def{x, Apply{_add, Tuple{x, 1}}})
check(tree("x := (n) -> x(n)"), 'Def{x, Lambda{Tuple{n}, Apply{x, Tuple{n}}}})
prev_a := 1
prev_a := prev_a + 1
check(prev_a, 2)
prev_f(n) := n + 1
prev_f := (n) -> prev_f(n) * 10
check(prev_f(1), 20)
prev_c(n) := if (n == 0) 0 else 1 + prev_c(n - 1)
check(prev_c(3), 3)
check({ pb := 1; pb := pb + 1; pb }, 2)
check({ pf(n) := n + 1; pf := (n) -> pf(n) * 10; pf(1) }, 20)
check({ pc(n) := if (n == 0) 0 else 1 + pc(n - 1); pc(3) }, 3)

# === function definitions in a block ===
check(tree("{ f(x) := x }"), 'Do{Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{x}, x}}}}})
check(tree("{ a := 1; f() := { a }; f() }"), 'Do{Def{a, 1}, Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{}, Do{a}}}}}, Apply{f, Tuple{}}})
check(tree("{ f(x :: xs) := x }"), 'Do{Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{Cons{x, xs}}, x}}}}})
check(tree("{ f() := { return 1 } }"), `Do{Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{}, Handle{Do{Perform{Return{1}}}, !rh}}}}}})
check(tree("{ f(x) := 1; f(x) := 2 }"), 'Do{Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{x}, 1}}}}, Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{x}, 2}}}}})
check(tree("{ g := x -> x; y := 1 }"), 'Do{Def{g, Lambda{Tuple{x}, x}}, Def{y, 1}})
check(tree("{ a; b }"), 'Do{a, b})

# === fun and f(p, ...) = e ===
check(tree("fun f"), 'Def{f, none})
check(tree("{ fun f; f(x) = x }"), 'Do{Def{f, none}, Set{f, Fusion{f, Lambda{Tuple{x}, x}}}})
check(tree("f(x, y) = x + y"), 'Set{f, Fusion{f, Lambda{Tuple{x, y}, Apply{_add, Tuple{x, y}}}}})
check(tree("f(x :: xs) = x"), 'Set{f, Fusion{f, Lambda{Tuple{Cons{x, xs}}, x}}})
check(tree("f() = { return 1 }"), `Set{f, Fusion{f, Lambda{Tuple{}, Handle{Do{Perform{Return{1}}}, !rh}}}})
check(tree("f = (x) -> x"), 'Set{f, Lambda{Tuple{x}, x}})
check(tree("f(x) == 1"), 'Apply{_eq, Tuple{Apply{f, Tuple{x}}, 1}})
check(tree("if (c) f(x) = 1 else f(x) = 2"), 'If{c, Set{f, Fusion{f, Lambda{Tuple{x}, 1}}}, Set{f, Fusion{f, Lambda{Tuple{x}, 2}}}})
check(head(tree("fun")), 'SyntaxError)
check(head(tree("fun f(x)")), 'SyntaxError)
check(head(tree("fun 1")), 'SyntaxError)
check(head(tree("fun = 1")), 'SyntaxError)
fun fun_ev
fun fun_od
fun_ev(n) = if (n == 0) true else fun_od(n - 1)
fun_od(n) = if (n == 0) false else fun_ev(n - 1)
check(Tuple{fun_ev(10), fun_od(10), fun_ev(7)}, Tuple{true, false, false})
fun_blk(n) := {
    fun ev
    od(n) := if (n == 0) false else ev(n - 1)
    ev(n) = if (n == 0) true else od(n - 1)
    ev(n)
}
check(fun_blk(10), true)
check(fun_blk(7), false)

check({
    fun odd
    even(n) := if (n == 0) true else odd(n - 1)
    odd(n) = if (n == 0) false else even(n - 1)
    Tuple{even(10), odd(10), even(7)}
}, Tuple{true, false, false})
# f(p, ...) = e adds a function after the functions of f, which are tried in the order they are written
fun fun_fact
fun_fact(0) = 1
fun_fact(n) = n * fun_fact(n - 1)
check(Tuple{fun_fact(0), fun_fact(5)}, Tuple{1, 120})
fun fun_order
fun_order(n) = 1
fun_order(0) = 2
check(fun_order(0), 1)
# the first one after fun f is the function itself, and the next one makes a Fusion
fun fun_first
fun_first(x) = x + 1
fun_first_g := fun_first
fun_first(0) = 5
check(Tuple{fun_first(0), fun_first_g(0), fun_first_g == fun_first}, Tuple{1, 1, false})
# functions of different numbers of parameters
fun fun_ar
fun_ar(x) = 1
fun_ar(x, y) = 2
fun_ar() = 0
check(Tuple{fun_ar(), fun_ar(7), fun_ar(7, 8)}, Tuple{0, 1, 2})
# f(p, ...) := e makes a new f, and f(p, ...) = e adds to it
fib3(0) := 0
fib3(1) = 1
fib3(n) = fib3(n - 1) + fib3(n - 2)
check(Tuple{fib3(0), fib3(1), fib3(20)}, Tuple{0, 1, 6765})
fun_def(0) := 10
fun_def(n) = n
check(Tuple{fun_def(0), fun_def(3)}, Tuple{10, 3})

# in a block
check({
    fun fb
    fb(Nil{}) = 0
    fb(x :: xs) = x + fb(xs)
    fb([1, 2, 3])
}, 6)
# a function with a guard given by f: the next function is tried when the arguments do not match
fun fun_gd
fun_gd = (n) if n > 0 -> 1
fun_gd(n) = 0
check(fun_gd(5), 1)
counter() := {
    c := 0
    inc() := {
        c = c + 1
        c
    }
    inc()
    inc()
}
check(counter(), 2)
# a function of a block sees the variables defined before it, and the functions of the block call each other
fact_sum(n) := {
    base := 1
    fact(m) := if (m <= 1) base else m * fact(m - 1)
    sum_to(m) := if (m == 0) 0 else fact(m) + sum_to(m - 1)
    sum_to(n)
}
check(fact_sum(4), 33)
find_in(xs, y) := {
    go(l) := {
        for (x in l) {
            if (x == y) return true
        }
        false
    }
    go(xs)
}
check(find_in([1, 2, 3], 2), true)
check(find_in([1, 2, 3], 5), false)
# a recursive descent parser: sum := num ("+" num)* with parentheses
parse_sum(toks) := {
    pos := 0
    fun sum
    peek() := if (pos < length(toks)) list.nth(toks, pos) else "eof"
    atom() := {
        t := peek()
        pos = pos + 1
        if (t == "(") {
            v := sum()
            pos = pos + 1
            v
        } else t
    }
    sum() = {
        v := atom()
        while (peek() == "+") {
            pos = pos + 1
            v = v + atom()
        }
        v
    }
    sum()
}
check(parse_sum([1, "+", "(", 2, "+", 3, ")", "+", 4]), 10)

# === binding ===
# a function sees the variables where it is defined, not those of its caller
bind_x := "global"
bind_g() := bind_x
bind_h() := { bind_x := "local"; bind_g() }
check(bind_h(), "global")
bind_mk() := { y := 1; () -> y }
bind_k := bind_mk()
bind_use() := { y := 2; bind_k() }
check(bind_use(), 1)
bind_add(n) := m -> n + m
bind_call(f) := { n := 100; f(1) }
check(bind_call(bind_add(10)), 11)
# the top-level functions that call each other are declared with fun
fun bind_od
bind_ev(n) := if (n == 0) true else bind_od(n - 1)
bind_od(n) = if (n == 0) false else bind_ev(n - 1)
check(bind_ev(10), true)
# a definition written later is not seen by the functions before it
bind_b(n) := "global b"
bind_ab() := {
    a(n) := bind_b(n)
    bind_b(n) := "local b"
    Tuple{a(1), bind_b(1)}
}
check(bind_ab(), Tuple{"global b", "local b"})
check(bind_b(1), "global b")
# the same name defined again with x := e is a new variable: the function made before keeps the old one
bind_f(x) := 1
bind_fg() := bind_f(0)
bind_f := (x) -> 2
check(Tuple{bind_fg(), bind_f(0)}, Tuple{1, 2})
# an assignment is seen by the function made before
bind_h2(x) := 1
bind_h2g() := bind_h2(0)
bind_h2 = (x) -> 2
check(bind_h2g(), 2)
fun bind_h3
bind_h3g() := bind_h3(0)
bind_h3(x) = 2
check(bind_h3g(), 2)
bind_h3(x) = 3
check(bind_h3g(), 2)
# a variable that is not a function is defined where it is written
bind_v := "outer"
bind_seq() := { a := bind_v; bind_v := "inner"; Tuple{a, bind_v} }
check(bind_seq(), Tuple{"outer", "inner"})
# the variables are shared locations: a function sees later assignments
bind_late(n) := {
    x := n
    g() := x
    x = x + 1
    g()
}
check(bind_late(2), 3)

# === Names that end in ? or ! ===
empty?(xs) := arity(xs) == 0
set!(x) := x + 1
ok? := true
check(empty?(Tuple{}), true)
check(empty?(Tuple{1}), false)
check(set!(4), 5)
check(ok?, true)
check(if (ok?) 1 else 2, 1)
check(match 3 { x! -> x! }, 3)
check(match 'a { done? -> done? }, 'a)
check('empty?, 'empty?)
a := 1
b := 2
check(a!=b, true)
check(a != b, true)
check(a!=1, false)
check(if (a!=b) 1 else 2, 1)
check(f"{ok?}", "true")
# in a grammar, a ? after a rule name is still an optional item
qn_num ::= integer
qn_opt ::= x:qn_num? "." { x }
check(arg(peg_parse('qn_opt, "7 ."), 0), 'Tuple{7})
check(arg(peg_parse('qn_opt, "."), 0), 'Tuple{})

# === Packrat parser: grammar declarations ===
num ::= integer
check(arg(peg_parse('num, "12 rest"), 0), 12)
check(arg(peg_parse('num, "12 rest"), 1), "rest")

# direct left recursion is left associative
diff ::= a:diff "-" b:num { a - b } | num
check(arg(peg_parse('diff, "10 - 3 - 2"), 0), 5)

# repetition, option, lookahead and keywords
nums ::= "[" xs:num* "]" { xs }
check(arg(peg_parse('nums, "[1 2 3]"), 0), 'Tuple{1, 2, 3})
check(arg(peg_parse('nums, "[]"), 0), 'Tuple{})
some ::= xs:num+ { xs }
check(arg(peg_parse('some, "1 2"), 0), 'Tuple{1, 2})
check(head(arg(peg_parse('some, "x"), 0)), 'SyntaxError)
opt ::= a:num b:("," num)? { Tuple{a, b} }
check(arg(peg_parse('opt, "1, 2"), 0), 'Tuple{1, Tuple{Tuple{",", 2}}})
check(arg(peg_parse('opt, "1"), 0), 'Tuple{1, Tuple{}})
notx ::= !"x" a:ident { a }
check(arg(peg_parse('notx, "y"), 0), 'y)
check(head(arg(peg_parse('notx, "x"), 0)), 'SyntaxError)
andx ::= &"x" a:ident { a }
check(arg(peg_parse('andx, "x"), 0), 'x)
kw ::= 'go a:num { a }
check(arg(peg_parse('kw, "go 1"), 0), 1)
check(head(arg(peg_parse('kw, "gopher 1"), 0)), 'SyntaxError)
pair ::= a:num "," b:num { Tuple{a, b} }
       | a:num { Tuple{a} }
check(arg(peg_parse('pair, "1, 2"), 0), 'Tuple{1, 2})
check(arg(peg_parse('pair, "1"), 0), 'Tuple{1})

# nospace(s) is s with no blanks before it, delimited(e, sep) and delimited1(e, sep) are lists
call ::= f:ident nospace("(") xs:delimited(num, ",") ")" { Tuple{f, xs} }
check(arg(peg_parse('call, "f(1, 2)"), 0), 'Tuple{f, Tuple{1, 2}})
check(arg(peg_parse('call, "f()"), 0), 'Tuple{f, Tuple{}})
check(head(arg(peg_parse('call, "f (1)"), 0)), 'SyntaxError)
list1 ::= xs:delimited1(num, ("," | ";")) { xs }
check(arg(peg_parse('list1, "1, 2; 3"), 0), 'Tuple{1, 2, 3})
check(head(arg(peg_parse('list1, "x"), 0)), 'SyntaxError)
# same is satisfied by a token on the same line
twin ::= a:num same b:num { Tuple{a, b} }
check(arg(peg_parse('twin, "1 2"), 0), 'Tuple{1, 2})
check(head(arg(peg_parse('twin, "1\n2"), 0)), 'SyntaxError)
# a name that only starts with nospace or delimited is a rule name
nospace_num ::= num
delimited_num ::= x:nospace_num { x }
check(arg(peg_parse('delimited_num, "5"), 0), 5)

# ... is the previous definition
color ::= 'red { 1 }
color ::= 'blue { 2 } | ...
check(arg(peg_parse('color, "red"), 0), 1)
check(arg(peg_parse('color, "blue"), 0), 2)

# === Any character and character classes ===
# . is one character and [set] one character of the set. Blanks before them are skipped, and the value is the character
cc_two ::= a:. b:. { Tuple{a, b} }
check(arg(peg_parse('cc_two, "xy"), 0), 'Tuple{"x", "y"})
check(arg(peg_parse('cc_two, "  x\n y rest"), 0), 'Tuple{"x", "y"})
check(arg(peg_parse('cc_two, "xy rest"), 1), "rest")
check(head(arg(peg_parse('cc_two, "x"), 0)), 'SyntaxError)
check(head(arg(peg_parse('cc_two, "x   "), 0)), 'SyntaxError)
cc_dots ::= a:. "..." { a }
check(arg(peg_parse('cc_dots, "x ..."), 0), "x")
cc_digits ::= ds:[0-9]+ { ds }
check(arg(peg_parse('cc_digits, "123 rest"), 0), 'Tuple{"1", "2", "3"})
check(arg(peg_parse('cc_digits, "123 rest"), 1), "rest")
check(arg(peg_parse('cc_digits, "1 2"), 0), 'Tuple{"1", "2"})
check(head(arg(peg_parse('cc_digits, "x1"), 0)), 'SyntaxError)
# a class is a set of characters and ranges of letters or digits
cc_hex ::= ds:[A-Fa-f0-9_]* { ds }
check(arg(peg_parse('cc_hex, "Fa_9g"), 0), 'Tuple{"F", "a", "_", "9"})
# [^set] is one character that is not in the set
cc_str ::= "\"" cs:[^"]* "\"" { cs }
check(arg(peg_parse('cc_str, "\"ab\""), 0), 'Tuple{"a", "b"})
check(arg(peg_parse('cc_str, "\"\""), 0), 'Tuple{})
cc_not ::= a:[^a-c\n] { a }
check(arg(peg_parse('cc_not, "d"), 0), "d")
check(head(arg(peg_parse('cc_not, "b"), 0)), 'SyntaxError)
# blanks before a character are skipped, so a blank is never the character
check(arg(peg_parse('cc_not, "\n"), 0), 'Eof{})
# escapes: \a \0 \] \- \\ and a blank. Blanks at both ends of the set are not in it
cc_esc ::= a:[\]\-\\]+ { a }
check(arg(peg_parse('cc_esc, "]-\\x"), 0), 'Tuple{"]", "-", "\\"})
cc_bell ::= a:[\a\0] { a }
check(arg(peg_parse('cc_bell, "\a"), 0), "\a")
check(head(arg(peg_parse('cc_bell, "x"), 0)), 'SyntaxError)
cc_sp ::= a:nospace("<") b:[\ x]+ { b }
check(arg(peg_parse('cc_sp, "<x x"), 0), 'Tuple{"x", "x"})
# a letter, a digit or _ before - makes a range. Other characters are themselves
cc_sym ::= a:[+-*]+ { a }
check(arg(peg_parse('cc_sym, "+-*/"), 0), 'Tuple{"+", "-", "*"})
# a class in a sequence with other items and in a choice
cc_id ::= a:[a-z] bs:[a-z0-9]* { Tuple{a, bs} } | "@" { 0 }
check(arg(peg_parse('cc_id, "x12"), 0), 'Tuple{"x", Tuple{"1", "2"}})
check(arg(peg_parse('cc_id, "@"), 0), 0)
# invalid sets are syntax errors
check(head(tree("cc_bad ::= [c-a]")), 'SyntaxError)
check(head(tree("cc_bad ::= [a-]")), 'SyntaxError)
check(head(tree("cc_bad ::= []")), 'SyntaxError)
check(head(tree("cc_bad ::= [ ]")), 'SyntaxError)
check(head(tree("cc_bad ::= [abc")), 'SyntaxError)

# === Text of a rule: name{| text |} ===
# the rule reads the text when the expression is parsed, and the value is a constant
check(num{| 12 |}, 12)
check(diff{| 10 - 3 - 2 |}, 5)
check(diff{|10-3|}, 7)
check(nums{| [1 2 3] |}, 'Tuple{1, 2, 3})
check(color{| blue |}, 2)
check(tree("num{| 12 |}"), 'Quote{12})
check(tree("diff{| 10 - 3 - 2 |}"), 'Quote{5})
check(tree("nums{| [] |}"), 'Quote{Tuple{}})
check(rest("num{| 1 |} x"), "x")
# blanks, newlines and comments inside are skipped by the rule
check(diff{|
    10   # ten
    - 3
|}, 7)
# the text is read only by the rule: | before the end is text of the rule
bars ::= xs:("|" integer)* { xs }
check(bars{| |1 |2 |}, 'Tuple{Tuple{"|", 1}, Tuple{"|", 2}})
# the rule decides the end, so |} inside a string or braces of the rule is text
strs ::= xs:string* { xs }
check(strs{| "a |} b" "c" |}, 'Tuple{"a |} b", "c"})
braces ::= "{" xs:num* "}" { xs }
check(braces{| {1 2} |}, 'Tuple{1, 2})
# an ident followed by { is still an m-expression, and { | is a block
check(tree("F{x}"), 'F{x})
check(tree("num {1}"), 'num)
# errors: the position is in the text of the rule
check(tree("num{| x |}"), 'SyntaxError{"unexpected input", "x |}"})
check(tree("diff{| 10 - 3 2 |}"), 'SyntaxError{"unexpected input", "2 |}"})
check(tree("diff{| 10 -\n 3 4 |}"), 'SyntaxError{"unexpected input", "4 |}"})
check(tree("num{| 1"), 'SyntaxError{"unexpected end of input"})
check(tree("num{| 1 |"), 'SyntaxError{"unexpected input", "|"})
check(head(tree("nosuch{| 1 |}")), 'SyntaxError)

# a tree built by the rule may contain Quote and UnQuote of planck; it is the value as it is
check(expr{| f(`!a) |}, 'Apply{f, Tuple{QuasiQuote{UnQuote{a}}}})
check(expr{| 'a |}, 'Quote{a})

# === Patterns written as expressions ===
check(tree("a@int + b@int -> a + b"), 'Lambda{Tuple{Apply{Quote{_add}, Tuple{_TypeOf{a, int}, _TypeOf{b, int}}}}, Apply{_add, Tuple{a, b}}})
check(tree("a * b + c -> a"), 'Lambda{Tuple{Apply{Quote{_add}, Tuple{Apply{Quote{_mul}, Tuple{a, b}}, c}}}, a})
check(tree("(a + b) * c -> a"), 'Lambda{Tuple{Apply{Quote{_mul}, Tuple{Apply{Quote{_add}, Tuple{a, b}}, c}}}, a})
check(tree("a - b - c -> a"), 'Lambda{Tuple{Apply{Quote{_sub}, Tuple{Apply{Quote{_sub}, Tuple{a, b}}, c}}}, a})
check(tree("a / b % c -> a"), 'Lambda{Tuple{Apply{Quote{_mod}, Tuple{Apply{Quote{_div}, Tuple{a, b}}, c}}}, a})
check(tree("-a -> a"), 'Lambda{Tuple{Apply{Quote{_sub}, Tuple{0, a}}}, a})
check(tree("-1 -> a"), 'Lambda{Tuple{-1}, a})
check(tree("f(x, 1) -> x"), 'Lambda{Tuple{Apply{Quote{f}, Tuple{x, 1}}}, x})
check(tree("f() -> 0"), 'Lambda{Tuple{Apply{Quote{f}, Tuple{}}}, 0})
check(tree("[a, b + 1] -> a"), 'Lambda{Tuple{Cons{a, Cons{Apply{Quote{_add}, Tuple{b, 1}}, Nil{}}}}, a})
check(tree("a + 1 :: b -> a"), 'Lambda{Tuple{Cons{Apply{Quote{_add}, Tuple{a, 1}}, b}}, a})
check(tree("a == b -> a"), 'Lambda{Tuple{Apply{Quote{_eq}, Tuple{a, b}}}, a})
check(tree("a < b + 1 -> a"), 'Lambda{Tuple{Apply{Quote{_lt}, Tuple{a, Apply{Quote{_add}, Tuple{b, 1}}}}}, a})
check(tree("(not a, b and c, If{d, 'true, e}) -> a"),
      'Lambda{Tuple{Apply{Quote{_not}, Tuple{a}}, If{b, c, Quote{false}}, If{d, Quote{true}, e}}, a})
check(tree("'(x + 1) -> 0"), 'Lambda{Tuple{Quote{Apply{_add, Tuple{x, 1}}}}, 0})
check(tree("F{a + 1, g(b)} -> a"), 'Lambda{Tuple{F{Apply{Quote{_add}, Tuple{a, 1}}, Apply{Quote{g}, Tuple{b}}}}, a})
check(tree("(a + b, c) -> a"), 'Lambda{Tuple{Apply{Quote{_add}, Tuple{a, b}}, c}, a})
check(tree("((a, b)) -> a"), 'Lambda{Tuple{Tuple{a, b}}, a})
check(tree("f(a + b) := a"), 'Do{Declare{f}, Set{f, Fusion{f, Lambda{Tuple{Apply{Quote{_add}, Tuple{a, b}}}, a}}}})
check(tree("match e { a + 0 -> a | _ -> e }"), 'Apply{Fusion{Lambda{Tuple{Apply{Quote{_add}, Tuple{a, 0}}}, a}, Lambda{Tuple{_}, e}}, Tuple{e}})
# M-expressions are patterns as before: a variable in the place of the function binds it
check(tree("Apply{f, Tuple{x}} -> f"), 'Lambda{Tuple{Apply{f, Tuple{x}}}, f})
check(tree("Apply{'_add, Tuple{a @ int, b}} -> a"), 'Lambda{Tuple{Apply{Quote{_add}, Tuple{_TypeOf{a, int}, b}}}, a})
# a pattern ends before -> and the guard
check(tree("x - 1 -> x"), 'Lambda{Tuple{Apply{Quote{_sub}, Tuple{x, 1}}}, x})
check(tree("x->x - 1"), 'Lambda{Tuple{x}, Apply{_sub, Tuple{x, 1}}})

# matching
simp(e) := match e {
    a@int + b@int -> a + b
  | a + 0 -> a
  | 0 + a -> a
  | x * y if x == y -> `sq(!x)
  | f(x) -> x
  | _ -> e
}
check(simp('(1 + 2)), 3)
check(simp('(x + 0)), 'x)
check(simp('(0 + y)), 'y)
check(simp('(z * z)), 'sq(z))
check(simp('(z * w)), 'Apply{_mul, Tuple{z, w}})
check(simp('(x + 1)), 'Apply{_add, Tuple{x, 1}})
check(simp('f(5)), 5)
check(simp('g(5)), 'Apply{g, Tuple{5}})
check(match '((1 + 2) * 3) { (a + b) * c -> Tuple{a, b, c} | _ -> 0 }, Tuple{1, 2, 3})
check(match '(1 + 2 * 3) { (a + b) * c -> 1 | a + b * c -> 2 | _ -> 0 }, 2)
check(match '(-x) { -a -> a | _ -> 0 }, 'x)
check(match '(not p) { not a -> a | _ -> 0 }, 'p)
check(match '(p and q) { If{a, 'true, b} -> 1 | a and b -> b | _ -> 0 }, 'q)
check(match '(a < b) { x > y -> 1 | x < y -> 2 | _ -> 0 }, 2)
check(match '(a :: b) { x :: y -> y | _ -> 0 }, 'b)
check(match '[1, 2] { [x] -> 1 | [x, y] -> y | _ -> 0 }, 2)
check(match [1, 2] { [x, y] -> x + y | _ -> 0 }, 3)
check(match '(x + 1) { a@int + b@int -> 0 | _ -> 1 }, 1)
check(match 'F{1 + x} { F{a + b @ symbol} -> b | _ -> 0 }, 'x)
check(match '(f(1)) { Apply{g, Tuple{x}} -> g | _ -> 0 }, 'f)
check(match 'f(1, 2) { f(a) -> 1 | f(a, b) -> b | _ -> 0 }, 2)
swap(a + b) := `(!b + !a)
check(swap('(1 + x)), 'Apply{_add, Tuple{x, 1}})
check(((a - b) -> a)('(5 - 3)), 5)
pacc := 0
for (a * b in ['(1 * 2), '(3 * 4)]) pacc = pacc + a * b
check(pacc, 14)

# extend the syntax of planck
primary ::= 'unless c:expr a:block 'else b:block { `If{!c, !b, !a} } | ...
check(unless 1 > 2 { "a" } else { "b" }, "a")
check(tree("unless c { a } else { b }"), 'If{c, Do{b}, Do{a}})

# === a[i], a[i] = v and t[p -> e | ...] ===
check(tree("a[i]"), 'Apply{_index_get, Tuple{a, i}})
check(tree("a[i][j]"), 'Apply{_index_get, Tuple{Apply{_index_get, Tuple{a, i}}, j}})
check(tree("f(x)[i].g"), 'Apply{_record_get, Tuple{Apply{_index_get, Tuple{Apply{f, Tuple{x}}, i}}, Quote{g}}})
check(tree("a[i](x)"), 'Apply{Apply{_index_get, Tuple{a, i}}, Tuple{x}})
check(tree("-a[i]"), 'Apply{_sub, Tuple{0, Apply{_index_get, Tuple{a, i}}}})
check(tree("a[i] = v"), 'Apply{_index_set, Tuple{a, i, v}})
check(tree("a[i][j] = v"), 'Apply{_index_set, Tuple{Apply{_index_get, Tuple{a, i}}, j, v}})
check(tree("a[i] = b[j] = v"), 'Apply{_index_set, Tuple{a, i, Apply{_index_set, Tuple{b, j, v}}}})
check(tree("a[i] == v"), 'Apply{_eq, Tuple{Apply{_index_get, Tuple{a, i}}, v}})
check(tree("t[x -> 1 | y -> 2]"), 'Apply{_index_get, Tuple{t, Fusion{Lambda{Tuple{x}, 1}, Lambda{Tuple{y}, 2}}}})
# [ right after the expression, without a space, is an index. Otherwise it is a list.
check(tree("a\n[1, 2]"), 'a)
check(rest("a\n[1, 2]"), "[1, 2]")
check(tree("a [1]"), 'a)
check(rest("a [1]"), "[1]")
check(tree("{ a\n[1] }"), 'Do{a, Cons{1, Nil{}}})
check(head(tree("f(a [1])")), 'SyntaxError)

# arrays
ia := array(3)
ia[0] = 5
check(ia[0], 5)
check(ia[1] = 7, 7)
ia[2] = ia[0] + ia[1]
check(ia[2], 12)
check(array_get(ia, 2), 12)
ib := array(2)
ib[1] = array(2)
ib[1][0] = "x"
check(ib[1][0], "x")
# tables: a missing key is none
it := table.new()
it["a"] = 1
it['b] = 2
it["a"] = it["a"] + 10
check(it["a"], 11)
check(it['b], 2)
check(it["z"], none)
check(table.get(it, "a", 0), 11)
fk := x -> x
it[fk] = 3
check(it[fk], 3)
# strings: the byte
check("abc"[0], "a")
check("abc"[2], "c")
# lists: the element
check([10, 20, 30][0], 10)
check([10, 20, 30][2], 30)
# M-expressions: the argument, and the field of a record by its name
check(F{1, 2}[1], 2)
check(('(f(x, y)))[1][0], 'x)
record IP(x, y)
check(IP{1, 2}['y], 2)
check(IP{1, 2}[0], 1)
# a kind of value of the program: _index_get and _index_set are extended in front
_index_get = (Matrix{w, _, d}, (i, j)) -> d[i * w + j] | _index_get
_index_set = (Matrix{w, _, d}, (i, j), v) -> { d[i * w + j] = v } | _index_set
im := Matrix{3, 2, array(6)}
im[(1, 2)] = 8
check(im[(1, 2)], 8)
check(array_get(arg(im, 2), 5), 8)
check(im[0], 3)
check([1, 2][1], 2)
# a variable named index or index_set does not hide a[i] and a[i] = v
index_var_test() := {
    index := 2
    index_set := 7
    xs := [10, 20, 30]
    check(xs[index], 30)
    ys := array(3)
    ys[index] = index_set
    check(ys[index], 7)
    check(ys[index_set - 6], none)
}
index_var_test()
index := 1
check([5, 6][index], 6)
# variables with the names a library function has do not hide what the sugar calls
shadow_test() := {
    add := 1
    sub := 1
    mul := 1
    div := 1
    mod := 1
    lt := 1
    le := 1
    gt := 1
    ge := 1
    eq := 1
    ne := 1
    not := 1
    strcat := 1
    to_text := 1
    record_get := 1
    define_rule := 1
    index_get := 1
    check(2 + 3 * 4 - 6 / 3 + 7 % 4, 15)
    check(-add, -1)
    check(1 < 2 and 1 <= 1 and 2 > 1 and 2 >= 2 and 1 == 1 and 1 != 2, true)
    check(not (1 == 2), true)
    check(f"a{add}b{sub + 1}", "a1b2")
    check(IP{3, 4}.x, 3)
    check([7, 8][index_get], 8)
}
shadow_test()

# rewriting: the arms are tried in order, from the root down
rt1 := 'F{G{1}, H{2}}
check(rt1[G{a} -> 'first | G{1} -> 'second], 'F{first, H{2}})
check(rt1[G{1} -> 'second | G{a} -> 'first], 'F{second, H{2}})
# a replaced part is not rewritten again
check(('F{G{G{1}}})[G{a} -> K{a}], 'F{K{G{1}}})
# a part that no arm matches: its arguments are rewritten, the head is kept
check(('F{1, G{2}, K{G{3}, G}})[G{a} -> a], 'F{1, 2, K{3, G}})
check(('G{1})[G{a} -> a], 1)
check(('F{1})[G{a} -> a], 'F{1})
check([1, 2, 3][x @ int -> x * 10], [10, 20, 30])
check(('(x * 1 + y))[Apply{_mul, Tuple{a, 1}} -> a], '(x + y))
# patterns written as expressions in the arms
check(('(x * 1 + y))[a * 1 -> a], '(x + y))
check(('(1 + 2 * (3 + 4)))[a @ int + b @ int -> a + b], '(1 + 2 * 7))
check(('(a + a + b))[a + b if a == b -> `(2 * !a)], '(2 * a + b))
check(('(f(1) + g(2)))[f(x) -> x | g(x) -> x * 10], '(1 + 20))
check(('(x + 0 * y))[a + 0 -> a | 0 * a -> 0], '(x + 0))
check(tree("t[a @ int + b @ int -> a + b | -x -> x]"), 'Apply{_index_get, Tuple{t, Fusion{Lambda{Tuple{Apply{Quote{_add}, Tuple{_TypeOf{a, int}, _TypeOf{b, int}}}}, Apply{_add, Tuple{a, b}}}, Lambda{Tuple{Apply{Quote{_sub}, Tuple{0, x}}}, x}}}})
# guards: when the guard is false the next arm is tried, and then the arguments
rt2 := 'F{P{1, 1}, P{1, 2}}
check(rt2[P{a, b} if a == b -> a], 'F{1, P{1, 2}})
check(rt2[P{a, b} if a == b -> 'same | P{a, b} -> 'diff], 'F{same, diff})
check(('P{P{3, 3}, 2})[P{a, b} if a == b -> a], 'P{3, 2})
check(rt2[P{1, 2} -> 'x | P{a, b} if a == b -> a], 'F{1, x})
check(('F{G{1}, P{2, 2}})[P{a, b} if a == b -> a | G{a} if a > 5 -> a], 'F{G{1}, 2})
check(('(a + a + b))[Apply{_add, Tuple{a, b}} if a == b -> `(2 * !a)], '(2 * a + b))
# any function
rf := G{a} -> a
check(('F{G{1}})[rf], 'F{1})
# the function of a call as a variable
check(('(g(1, 2)))[(f)(a, b) -> a + b], 3)
check(('(g(1, 2)))[(f)(a, b) -> f], 'g)
check(('(k(7)))[(f)(a) -> a], 7)
check(('(k(7, 8)))[(f)(a) -> a | (f)(a, b) -> b], 8)

# === Rest parameters ===
check(tree("f(a, rest...)"), 'Apply{f, Tuple{a, _Rest{rest}}})
check(tree("(a, rest...) -> a"), 'Lambda{Tuple{a, _Rest{rest}}, a})
check(tree("(rest...) -> rest"), 'Lambda{Tuple{_Rest{rest}}, rest})
check(tree("F{a, rest...} -> a"), 'Lambda{Tuple{F{a, _Rest{rest}}}, a})
check(tree("f(a, rest...) -> a"), 'Lambda{Tuple{Apply{Quote{f}, Tuple{a, _Rest{rest}}}}, a})
check(tree("_..."), '_Rest{_})
drop_first(t) := {
    r := Tuple{}
    i := 1
    while (i < arity(t)) {
        r = push(r, arg(t, i))
        i = i + 1
    }
    r
}
rest_sum(t) := if (arity(t) == 0) 0 else arg(t, 0) + rest_sum(drop_first(t))
rest_total(xs...) := rest_sum(xs)
check(rest_total(), 0)
check(rest_total(1, 2, 3), 6)
rest_scale(k, xs...) := k * rest_sum(xs)
check(rest_scale(10, 1, 2, 3), 60)
check(((a, r...) -> arity(r))(1), 0)
check(((a, r...) -> arity(r))(1, 2, 3), 2)
check(((a, r...) -> r)(1, 2, 3), 'Tuple{2, 3})
check(((_...) -> 1)(5, 6), 1)
rest_kind(a) := "one"
rest_kind(a, b) := "two"
rest_kind(a, b, c...) := "many"
check(rest_kind(1), "one")
check(rest_kind(1, 2), "two")
check(rest_kind(1, 2, 3), "many")
check(rest_kind(1, 2, 3, 4), "many")
check(match 'F{1, 2, 3} { F{a, r...} -> r }, 'Tuple{2, 3})
check(match 'F{1} { F{a, r...} -> r }, 'Tuple{})
check(match 'F{1, 2} { F{a, b, r...} -> r | F{a, r...} -> a }, 'Tuple{})
check(match 'G{1, 2} { F{a, r...} -> 0 | _ -> 1 }, 1)
check(match 'F{} { F{a, r...} -> 0 | _ -> 1 }, 1)
check(match 'F{1, 2, 3} { F{a, r1...} -> r1 }, 'Tuple{2, 3})
check(match ('f(1, 2, 3)) { (g)(a, r...) -> r }, 'Tuple{2, 3})
check(match ('f(1, 2, 3)) { f(a, r...) -> r }, 'Tuple{2, 3})
check(match 'F{1, G{2, 3, 4}} { F{a, G{b, r...}} -> r }, 'Tuple{3, 4})
check(match 'F{1, 2, 3} { F{a, _...} -> a }, 1)

# === with ===
check(tree("p with { x = 1 }"), 'Apply{_record_with, Tuple{p, Quote{x}, 1}})
check(tree("p with { x = 1, y = a + 2 }"), 'Apply{_record_with, Tuple{Apply{_record_with, Tuple{p, Quote{x}, 1}}, Quote{y}, Apply{_add, Tuple{a, 2}}}})
check(tree("p with { x = 1 } with { y = 2 }"), 'Apply{_record_with, Tuple{Apply{_record_with, Tuple{p, Quote{x}, 1}}, Quote{y}, 2}})
check(tree("f(a).b with { x = 1 }"), 'Apply{_record_with, Tuple{Apply{_record_get, Tuple{Apply{f, Tuple{a}}, Quote{b}}}, Quote{x}, 1}})
check(tree("r := p with { x = 1 }"), 'Def{r, Apply{_record_with, Tuple{p, Quote{x}, 1}}})
check(tree("handle p with (E{}, k) -> 1"), 'Handle{p, Lambda{Tuple{E{}, k}, 1}})

# === Destructuring ===
# a block of the definitions of a temporary variable and of each name
check(head(tree("(a, b) := e")), 'Do)
check(arity(tree("(a, b) := e")), 3)
check(arity(tree("(a, b, c) = e")), 4)
check(head(arg(tree("(a, b) := e"), 1)), 'Def)
check(head(arg(tree("(a, b) = e"), 1)), 'Set)
check(arg(arg(tree("(a, b) := e"), 1), 0), 'a)
check(tree("(a, b)"), 'Tuple{a, b})
check(tree("(a, b) == c"), 'Apply{_eq, Tuple{Tuple{a, b}, c}})
check(tree("(a, b) -> a"), 'Lambda{Tuple{a, b}, a})

# === Compound assignment ===
check(tree("x += 1"), 'Set{x, Apply{_add, Tuple{x, 1}}})
check(tree("x -= 1"), 'Set{x, Apply{_sub, Tuple{x, 1}}})
check(tree("x *= y + 1"), 'Set{x, Apply{_mul, Tuple{x, Apply{_add, Tuple{y, 1}}}}})
check(tree("x /= 2"), 'Set{x, Apply{_div, Tuple{x, 2}}})
check(tree("x %= 2"), 'Set{x, Apply{_mod, Tuple{x, 2}}})
check(tree("x += y -= 1"), 'Set{x, Apply{_add, Tuple{x, Set{y, Apply{_sub, Tuple{y, 1}}}}}})
check(head(tree("a[i] += 1")), 'Do)
check(arity(tree("a[i] += 1")), 3)
check(arg(arg(tree("a[i] += 1"), 2), 0), '_index_set)
check(tree("x == 1"), 'Apply{_eq, Tuple{x, 1}})
check(tree("a[i] = 1"), 'Apply{_index_set, Tuple{a, i, 1}})
check(tree("if (c) x += 1"), 'If{c, Set{x, Apply{_add, Tuple{x, 1}}}, none})

# or in a pattern: the alternatives match the same value, and the arms after it are tried when none does
size(0 or 1) := "small"
size(_) := "big"
check(size(0), "small")
check(size(1), "small")
check(size(2), "big")
check(match 3 { 1 or 2 or 3 -> "low" | _ -> "high" }, "low")
check(match 7 { 1 or 2 or 3 -> "low" | _ -> "high" }, "high")
check(match 'b { 'a or 'b -> 1 | _ -> 2 }, 1)
check(match F{2, 9} { F{1 or 2, x} -> x | _ -> 0 }, 9)
check(match F{3, 9} { F{1 or 2, x} -> x | _ -> 0 }, 0)
check(match (2, 5) { ((1 or 2, 5 or 6)) -> "in" | _ -> "out" }, "in")
check(match (2, 7) { ((1 or 2, 5 or 6)) -> "in" | _ -> "out" }, "out")
check(match G{2} { G{(1 or 2) or 3} -> 1 | _ -> 0 }, 1)
check(match G{H{4}} { G{H{3 or 4} or J{}} -> 1 | _ -> 0 }, 1)
check(match G{J{}} { G{H{3 or 4} or J{}} -> 1 | _ -> 0 }, 1)
orlam := (1 or 2, x) -> x
check(orlam(2, 8), 8)
# an or and a guard together
og(0 or 1, y) if y > 0 := "yes"
og(_, _) := "no"
check(og(1, 5), "yes")
check(og(1, -5), "no")
check(og(2, 5), "no")
# an or expression is If{a, 'true, b}
check(match '(p or q) { If{a, 'true, b} -> b | _ -> 0 }, 'q)
check(match 5 { 'true or 'false -> 1 | 1 or 2 -> 2 | none or 5 -> 3 | _ -> 4 }, 3)
check(match 6 { none or true -> 1 | _ -> 2 }, 2)

# a name written twice matches two values that are ==
same(a, a) := "same"
same(_, _) := "differ"
check(same(1, 1), "same")
check(same(1, 2), "differ")
check(same([1], [1]), "same")
check(same([1], [2]), "differ")
check(same("a", "a"), "same")
check(match (3, 3, 4) { ((a, a, b)) -> b | _ -> 0 }, 4)
check(match (3, 4, 3) { ((a, a, b)) -> b | _ -> 0 }, 0)
check(match F{[1, 2], [1, 2]} { F{a, a} -> a | _ -> 0 }, [1, 2])
check(match F{1, 2, 1} { F{a, b, a} -> b | _ -> 0 }, 2)
check(match F{1, 2, 3} { F{a, b, a} -> b | _ -> 0 }, 0)
check(match (5, 5, 5) { ((a, a, a)) -> a | _ -> 0 }, 5)
check(match (5, 5, 6) { ((a, a, a)) -> a | _ -> 0 }, 0)
sg(a, a) if a > 0 := "pos"
sg(_, _) := "no"
check(sg(2, 2), "pos")
check(sg(-2, -2), "no")
check(sg(2, 3), "no")
sl := (a, a) -> a
check(sl(7, 7), 7)
# a name written twice and an or together
sor(a, 1 or 2, a) := a
sor(_, _, _) := "no"
check(sor(5, 2, 5), 5)
check(sor(5, 3, 5), "no")
check(sor(5, 2, 6), "no")

# an or whose alternatives all bind the same variables binds them
ov((x, 0) or (0, x)) := x
ov(_) := "no"
check(ov((3, 0)), 3)
check(ov((0, 4)), 4)
check(ov((1, 2)), "no")
check(match (0, 9) { ((x, 0) or (0, x)) -> x | _ -> 0 }, 9)
check(match F{1} { F{x} or G{x} -> x | _ -> 0 }, 1)
check(match G{2} { F{x} or G{x} -> x | _ -> 0 }, 2)
check(match H{2} { F{x} or G{x} -> x | _ -> 0 }, 0)
check(match (1, (2, 0)) { ((a, (x, 0) or (0, x))) -> Tuple{a, x} | _ -> 0 }, Tuple{1, 2})
check(match (1, (0, 5)) { ((a, (x, 0) or (0, x))) -> Tuple{a, x} | _ -> 0 }, Tuple{1, 5})
check(match F{G{1}, K{2}} { F{G{x} or H{x}, J{y} or K{y}} -> x + y | _ -> 0 }, 3)
check(match F{K{7}} { F{G{x} or H{x} or K{x}} -> x | _ -> 0 }, 7)
check(match (4, 0) { (((x, 0) or (0, x)) or (1, x)) -> x | _ -> 0 }, 4)
check(match (1, 8) { (((x, 0) or (0, x)) or (1, x)) -> x | _ -> 0 }, 8)
ovg((x, 0) or (0, x)) if x > 2 := "big"
ovg(_) := "small"
check(ovg((3, 0)), "big")
check(ovg((0, 1)), "small")
check(ovg((0, 5)), "big")
ovl := ((x, 0) or (0, x)) -> x + 1
check(ovl((0, 5)), 6)

# a guard on a definition: when it is false the definitions of the same name that follow are tried
sign(x) if x > 0 := "pos"
sign(0) := "zero"
sign(_) := "neg"
check(sign(4), "pos")
check(sign(0), "zero")
check(sign(-4), "neg")
dg1(x) if x > 1 := "a"
dg1(x) if x > 0 := "b"
dg1(_) := "c"
dg2(x) := x + 1
check(dg1(5), "a")
check(dg1(1), "b")
check(dg1(0), "c")
check(dg2(1), 2)
# a definition of a function in a block
blk := {
    h(x) if x > 0 := "p"
    h(_) := "n"
    Tuple{h(-3), h(3)}
}
check(blk, Tuple{"n", "p"})

put("Tests passed "); print(passed); put("/"); println(passed + failed)
if (failed > 0) exit(1)
