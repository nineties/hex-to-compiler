# Tests of planck/lib/pe.pk
# Copyright (C) 2026 nineties

use("pe")
use("vasm/check")

load("planck/examples/pe/interp_prog.pk")

failed := 0
check(name, got, want) := {
    if (got != want) {
        failed = failed + 1
        println(f"{name}: FAIL")
        println(f"  got:  {got}")
        println(f"  want: {want}")
    } else println(f"{name}: ok")
}

pow_text(n) := pe_vasm_text(specialize(pe_load("planck/examples/pe/pow_prog.pk"), 'pow, [Dyn{U64{}}, n], U64{}))

check("pow, n = 0", pow_text(0), "fn pow_spec(a0: u64) -> u64 {\n    return 1\n}\n")
check("pow, n = 1", pow_text(1), "fn pow_spec(a0: u64) -> u64 {\n    var t1: u64\n    t1 = a0 * 1\n    return t1\n}\n")
check("pow, n = 3", pow_text(3), "fn pow_spec(a0: u64) -> u64 {\n    var t1: u64\n    var t2: u64\n    var t3: u64\n    t1 = a0 * 1\n    t2 = a0 * t1\n    t3 = a0 * t2\n    return t3\n}\n")

pow_m := specialize(pe_load("planck/examples/pe/pow_prog.pk"), 'pow, [Dyn{U64{}}, 3], U64{})
check("pow module is well-typed", vasm_check(pe_with_main(pow_m, [5])), [])

# all arguments static: only the value is left
check("pow, both static", pe_vasm_text(specialize(pe_load("planck/examples/pe/pow_prog.pk"), 'pow, [2, 10], U64{})), "fn pow_spec() -> u64 {\n    return 1024\n}\n")

code := decode(read_file("planck/examples/pe/prog.txt"))
run_m := specialize(pe_load("planck/examples/pe/interp_prog.pk"), 'run, [code, Dyn{U64{}}], U64{})
check("interpreter, x * 3 + 1", pe_vasm_text(run_m), "fn run_spec(a1: u64) -> u64 {\n    var t1: u64\n    var t2: u64\n    t1 = 3 * a1\n    t2 = 1 + t1\n    return t2\n}\n")
check("interpreter module is well-typed", vasm_check(pe_with_main(run_m, [5])), [])

if (failed > 0) {
    println(f"{failed} failed")
    exit(1)
}
println("all passed")
