# tests for the stages of the code generator: bitset, bytes, ir, cfg, sched, regalloc, os, the emitter, obj, link and elf
# Copyright (C) 2026 nineties

passed := 0
failed := 0

check(actual, expected) := if (actual == expected) {
    passed = passed + 1
} else {
    failed = failed + 1
    put("Test failed: expected "); print(expected)
    put(" but got "); println(actual)
}

use("backend/x64")
use("backend/link")
use("backend/elf")

# === bitset ===
s := bits_new(100)
each(i -> bits_add(s, i), [3, 31, 64, 99])
check(bits_to_list(s), [3, 31, 64, 99])
check(bits_has(s, 31), true)
check(bits_has(s, 32), false)
bits_del(s, 31)
check(bits_to_list(s), [3, 64, 99])
t := bits_new(100)
bits_add(t, 5)
bits_add(t, 64)
check(bits_union(s, t), true)
check(bits_union(s, t), false)
check(bits_to_list(s), [3, 5, 64, 99])
bits_minus(s, t)
check(bits_to_list(s), [3, 99])
check(bits_count(s), 2)
check(bits_equal(s, bits_copy(s)), true)
check(bits_equal(s, t), false)

# === bytes ===
b := bb_new()
bb_u32(b, -2)
bb_u16(b, 258)
bb_str(b, "AB")
check(vec_to_list(b), [254, 255, 255, 255, 2, 1, 65, 66])
bb_set_u32(b, 0, 16909060)
check(take(vec_to_list(b), 4), [4, 3, 2, 1])
bb_align(b, 16)
check(bb_len(b), 16)
check(bb_to_u8(b)[7], 66)

# === ir ===
i1 := I{'add, [D{40}, U{41}, K{1}]}
check(ir_defs(i1), [40])
check(ir_uses(i1), [41])
i2 := I{'mov, [D{40}, M{U{41}, 4}]}
check(ir_uses(i2), [41])
i3 := I{'call, [S{"f", 0}, Us{[40, 41]}, Ds{[42]}]}
check(ir_uses(i3), [40, 41])
check(ir_defs(i3), [42])
i4 := I{'add, [DU{40}, U{41}, ID{8}]}
check(ir_defs(i4), [40, 8])
check(ir_uses(i4), [40, 41])
check(ir_explicit(i4), [DU{40}, U{41}])
check(ir_map_regs(r -> r + 1, i2), I{'mov, [D{41}, M{U{42}, 4}]})
check(ir_show(i1), "  add d40, u41, 1")

# === cfg: blocks and live registers ===
code := [
    I{'mov, [D{40}, K{0}]},
    I{'label, [L{0}]},
    I{'add, [DU{40}, K{1}, ID{8}]},
    I{'jcc, [Cc{'lt}, L{0}, IU{8}]},
    I{'mov, [D{0}, U{40}]},
    I{'ret, [IU{0}]}]
bs := cfg_blocks(code)
check(array_len(bs), 3)
check(arg(array_get(bs, 0), 1), [1])
check(arg(array_get(bs, 1), 1), [1, 2])
check(arg(array_get(bs, 2), 1), [])
lv := cfg_live(bs, 64)
check(bits_to_list(array_get(arg(lv, 0), 1)), [40])
check(bits_to_list(array_get(arg(lv, 1), 0)), [40])
check(cfg_flatten(bs), code)

# === sched: the loads start first so that the additions do not wait ===
ld1 := I{'mov, [W{'w64}, D{40}, M{U{33}, 0}]}
ad1 := I{'add, [W{'w64}, DU{40}, K{1}, x64_flags_def]}
ld2 := I{'mov, [W{'w64}, D{41}, M{U{34}, 0}]}
ad2 := I{'add, [W{'w64}, DU{41}, K{1}, x64_flags_def]}
check(sched_code([ld1, ad1, ld2, ad2], x64_sched_model), [ld1, ld2, ad1, ad2])
# a store stays between the loads that it separates
st1 := I{'mov, [W{'w64}, M{U{35}, 0}, U{40}]}
ld3 := I{'mov, [W{'w64}, D{42}, M{U{36}, 0}]}
check(sched_code([ld1, st1, ld3], x64_sched_model), [ld1, st1, ld3])
# the label and the terminator stay at the ends of a block
blk := [I{'label, [L{3}]}, ld1, ad1, ld2, ad2, I{'ret, [IU{0}]}]
check(sched_code(blk, x64_sched_model),[I{'label, [L{3}]}, ld1, ld2, ad1, ad2, I{'ret, [IU{0}]}])

# === regalloc ===
# a straight line code is run to see that the allocation keeps the result: values on the stack are in mem
run(code) := {
    regs := table()
    mem := table()
    val := o -> match o {
        K{n} -> n
      | U{r} -> table_get(regs, r, 0)
      | MF{k, n, d} -> table_get(mem, Tuple{k, n, d}, 0)
    }
    each(i -> match i {
        I{'mov, [D{d}, s]} -> table_set(regs, d, val(s))
      | I{'mov, [MF{k, n, d}, s]} -> table_set(mem, Tuple{k, n, d}, val(s))
      | I{'mov, [W{_}, D{d}, s]} -> table_set(regs, d, val(s))
      | I{'mov, [W{_}, MF{k, n, d}, s]} -> table_set(mem, Tuple{k, n, d}, val(s))
      | I{'add, [DU{d}, s, _]} -> table_set(regs, d, table_get(regs, d, 0) + val(s))
      | I{'ret, _} -> none
    }, code)
    table_get(regs, 0, 0)
}

f := ir_fn("t")
vs := map(i -> ir_vreg(f, 64), range(0, 16))
acc := ir_vreg(f, 64)
each((Tuple{v, n}) -> ir_emit(f, I{'mov, [D{v}, K{n}]}), zip(vs, range(1, 17)))
ir_emit(f, I{'mov, [D{acc}, K{0}]})
each(v -> ir_emit(f, I{'add, [DU{acc}, U{v}, x64_flags_def]}), vs)
ir_emit(f, I{'mov, [D{0}, U{acc}]})
ir_emit(f, I{'ret, [IU{0}]})
ra_code := ra_allocate(f, x64_ra)
check(any(i -> any(r -> ir_is_vreg(r), append(ir_uses(i), ir_defs(i))), ra_code), false)
check(run(ra_code), 136)
# seventeen values do not fit in fourteen registers, so some are kept in stack slots
check(any(i -> any(o -> head(o) == 'MF, ir_explicit(i)), ra_code), true)
check(length(vec_to_list(table_get(ir_meta(f), 'slots, none))) > 0, true)

# === os: the services of the system become system calls ===
os_out := []
os_emit := i -> { os_out = i :: os_out }
os_select_x64(os_emit, 'write, [40, 41, 42], 43)
check(map(ir_show, reverse(os_out)), ["  mov d0, 1", "  mov d7, u40", "  mov d6, u41", "  mov d2, u42", "  syscall iu0, id0, id1, id11, iu7, iu6, iu2", "  mov d43, u0"])
os_out = []
os_select_x64(os_emit, 'exit, [40], 41)
check(map(ir_show, reverse(os_out)), ["  mov d0, 60", "  mov d7, u40", "  syscall iu0, id0, id1, id11, iu7", "  mov d41, u0"])
os_out = []
os_select_x64(os_emit, 'grow, [40], 41)
check(map(ir_op, reverse(os_out)), ['mov, 'mov, 'syscall, 'mov])
os_out = []
os_select_x64(os_emit, 'abort, [], none)
check(map(ir_show, reverse(os_out)), ["  mov d0, 231", "  mov d7, 134", "  syscall iu0, iu7, id0, id1, id11", "  ud2 "])
check(ir_show(I{'os, [N{'write}, Us{[1, 2, 3]}, D{4}]}), "  os write, u[1 2 3], d4")

# === the emitter: relocations, link and elf ===
o1 := obj_new("c")
em1 := em_new(o1, ".text")
em_u8(em1, 232)
em_sym(em1, 'Pc32, "f", 0)
em_u8(em1, 184)
em_sym(em1, 'Abs32, "g", 8)
check(obj_relocs(o1), [Rel{".text", 1, 'Pc32, "f", -4}, Rel{".text", 6, 'Abs32, "g", 8}])
oa := obj_new("a")
ea := em_new(oa, ".text")
obj_define(oa, "f", ".text", em_pos(ea), true)
em_u8(ea, 195)
ob := obj_new("b")
eb := em_new(ob, ".text")
obj_define(ob, "_start", ".text", em_pos(eb), true)
em_u8(eb, 232)
em_sym(eb, 'Pc32, "f", 0)
em_u8(eb, 184)
em_sym(eb, 'Abs32, "v", 0)
db := obj_sec(ob, ".data", 'data, 4)
obj_define(ob, "v", ".data", bb_len(obj_buf(db)), true)
bb_u32(obj_buf(db), 77)
img := link([oa, ob], "_start", 4194304, elf64_hdr_size(2))
check(arg(img, 0), 4194304 + 176 + 16)
segs := arg(img, 1)
check(length(segs), 2)
text := arg(segs[0], 2)
# f is at 176, _start at 176 + 16: the call goes back by 16 + 5
check(map(i -> bb_get(text, i), range(192, 197)), [232, 235, 255, 255, 255])
# the data segment starts one page after its place in the file
vaddr := arg(segs[1], 0)
check(vaddr, 4194304 + arg(segs[1], 1) + 4096)
check(bb_get(arg(segs[1], 2), 0), 77)
check(map(i -> bb_get(text, i), range(198, 202)), [vaddr % 256, bit_and(bit_sar(vaddr, 8), 255), bit_and(bit_sar(vaddr, 16), 255), bit_and(bit_sar(vaddr, 24), 255)])
check(table_get(arg(img, 2), "v", 0), vaddr)
file := elf64_image('x86_64, arg(img, 0), segs)
check(map(i -> bb_get(file, i), range(0, 8)), [127, 69, 76, 70, 2, 1, 1, 0])
check(map(i -> bb_get(file, i), range(16, 20)), [2, 0, 62, 0])
check(bb_get(file, arg(segs[1], 1)), 77)

put("Tests passed "); print(passed); put("/"); println(passed + failed)
if (failed > 0) exit(1)
