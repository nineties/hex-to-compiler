# tests for the stages of the code generator: bitset, bytes, ir, cfg, os, the emitter, object, link and elf
# Copyright (C) 2026 nineties

passed := 0
failed := 0

check(actual, expected) := if (actual == expected) {
    passed = passed + 1
} else {
    failed = failed + 1
    put("Test failed: expected "); print(expected)
    put(" but got "); println(actual)
}

use("backend/x64")
use("backend/link")
use("backend/elf")
use("list")
use("table")

# === bitset ===
s := bitset.new(100)
each(i -> bitset.add(s, i), [3, 31, 64, 99])
check(bitset.to_list(s), [3, 31, 64, 99])
check(bitset.has(s, 31), true)
check(bitset.has(s, 32), false)
bitset.del(s, 31)
check(bitset.to_list(s), [3, 64, 99])
t := bitset.new(100)
bitset.add(t, 5)
bitset.add(t, 64)
check(bitset.union(s, t), true)
check(bitset.union(s, t), false)
check(bitset.to_list(s), [3, 5, 64, 99])
bitset.minus(s, t)
check(bitset.to_list(s), [3, 99])
check(bitset.count(s), 2)
check(bitset.equal(s, bitset.copy(s)), true)
check(bitset.equal(s, t), false)

# === bytes ===
b := bytes.new()
bytes.u32(b, -2)
bytes.u16(b, 258)
bytes.string(b, "AB")
check(vector.to_list(b), [254, 255, 255, 255, 2, 1, 65, 66])
bytes.set_u32(b, 0, 16909060)
check(list.take(vector.to_list(b), 4), [4, 3, 2, 1])
bytes.align(b, 16)
check(bytes.len(b), 16)
check(bytes.to_u8(b)[7], 66)

# === ir ===
i1 := I{'add, [D{40}, U{41}, K{1}]}
check(ir.defs(i1), [40])
check(ir.uses(i1), [41])
i2 := I{'mov, [D{40}, M{U{41}, 4}]}
check(ir.uses(i2), [41])
i3 := I{'call, [S{"f", 0}, Us{[40, 41]}, Ds{[42]}]}
check(ir.uses(i3), [40, 41])
check(ir.defs(i3), [42])
i4 := I{'add, [DU{40}, U{41}, ID{8}]}
check(ir.defs(i4), [40, 8])
check(ir.uses(i4), [40, 41])
check(ir.explicit(i4), [DU{40}, U{41}])
check(ir.map_regs(r -> r + 1, i2), I{'mov, [D{41}, M{U{42}, 4}]})
check(ir.show(i1), "  add d40, u41, 1")

# === cfg: blocks and live registers ===
code := [
    I{'mov, [D{40}, K{0}]},
    I{'label, [L{0}]},
    I{'add, [DU{40}, K{1}, ID{8}]},
    I{'jcc, [Cc{'lt}, L{0}, IU{8}]},
    I{'mov, [D{0}, U{40}]},
    I{'ret, [IU{0}]}]
bs := cfg.blocks(code)
check(array_len(bs), 3)
check(arg(array_get(bs, 0), 1), [1])
check(arg(array_get(bs, 1), 1), [1, 2])
check(arg(array_get(bs, 2), 1), [])
lv := cfg.live(bs, 64)
check(bitset.to_list(array_get(arg(lv, 0), 1)), [40])
check(bitset.to_list(array_get(arg(lv, 1), 0)), [40])

# === os: the services of the system become system calls ===
os_out := []
os_emit := i -> { os_out = i :: os_out }
os.select_x64(os_emit, 'write, [40, 41, 42], 43)
check(map(ir.show, reverse(os_out)), ["  mov d0, 1", "  mov d7, u40", "  mov d6, u41", "  mov d2, u42", "  syscall iu0, id0, id1, id11, iu7, iu6, iu2", "  mov d43, u0"])
os_out = []
os.select_x64(os_emit, 'exit, [40], 41)
check(map(ir.show, reverse(os_out)), ["  mov d0, 60", "  mov d7, u40", "  syscall iu0, id0, id1, id11, iu7", "  mov d41, u0"])
os_out = []
os.select_x64(os_emit, 'grow, [40], 41)
check(map(ir.op, reverse(os_out)), ['mov, 'mov, 'syscall, 'mov])
os_out = []
os.select_x64(os_emit, 'abort, [], none)
check(map(ir.show, reverse(os_out)), ["  mov d0, 231", "  mov d7, 134", "  syscall iu0, iu7, id0, id1, id11", "  ud2 "])
check(ir.show(I{'os, [N{'write}, Us{[1, 2, 3]}, D{4}]}), "  os write, u[1 2 3], d4")

# === the emitter: relocations, link and elf ===
o1 := object.new("c")
em1 := x86enc.new(o1, ".text")
x86enc.u8(em1, 232)
x86enc.symbol(em1, 'Pc32, "f", 0)
x86enc.u8(em1, 184)
x86enc.symbol(em1, 'Abs32, "g", 8)
check(object.relocs(o1), [Rel{".text", 1, 'Pc32, "f", -4}, Rel{".text", 6, 'Abs32, "g", 8}])
oa := object.new("a")
ea := x86enc.new(oa, ".text")
object.define(oa, "f", ".text", x86enc.pos(ea), true)
x86enc.u8(ea, 195)
ob := object.new("b")
eb := x86enc.new(ob, ".text")
object.define(ob, "_start", ".text", x86enc.pos(eb), true)
x86enc.u8(eb, 232)
x86enc.symbol(eb, 'Pc32, "f", 0)
x86enc.u8(eb, 184)
x86enc.symbol(eb, 'Abs32, "v", 0)
db := object.section(ob, ".data", 'data, 4)
object.define(ob, "v", ".data", bytes.len(object.buf(db)), true)
bytes.u32(object.buf(db), 77)
image := linker.link([oa, ob], "_start", 4194304, elf.header_size(2))
check(arg(image, 0), 4194304 + 176 + 16)
segs := arg(image, 1)
check(length(segs), 2)
text := arg(segs[0], 2)
# f is at 176, _start at 176 + 16: the call goes back by 16 + 5
check(map(i -> bytes.get(text, i), range(192, 197)), [232, 235, 255, 255, 255])
# the data segment starts one page after its place in the file
vaddr := arg(segs[1], 0)
check(vaddr, 4194304 + arg(segs[1], 1) + 4096)
check(bytes.get(arg(segs[1], 2), 0), 77)
check(map(i -> bytes.get(text, i), range(198, 202)), [vaddr % 256, bit_and(bit_sar(vaddr, 8), 255), bit_and(bit_sar(vaddr, 16), 255), bit_and(bit_sar(vaddr, 24), 255)])
check(table.get(arg(image, 2), "v", 0), vaddr)
file := elf.image('x86_64, arg(image, 0), segs)
check(map(i -> bytes.get(file, i), range(0, 8)), [127, 69, 76, 70, 2, 1, 1, 0])
check(map(i -> bytes.get(file, i), range(16, 20)), [2, 0, 62, 0])
check(bytes.get(file, arg(segs[1], 1)), 77)

put("Tests passed "); print(passed); put("/"); println(passed + failed)
if (failed > 0) exit(1)
