# tests for the libraries in planck/lib
# Copyright (C) 2026 nineties

passed := 0
failed := 0

check(actual, expected) := if (actual == expected) {
    passed = passed + 1
} else {
    failed = failed + 1
    put("Test failed: expected "); print(expected)
    put(" but got "); println(actual)
}

use("base")
use("list")
use("vector")
use("string")
use("table")
use("symbol")
use("error")
use("pretty")
use("u64")
use("getopt")

# use loads a file once
check(table_get(used_libs, "list", false), true)

# === list ===
xs := [3, 1, 2]
check(length(xs), 3)
check(length([]), 0)
check(reverse(xs), [2, 1, 3])
check(reverse([]), [])
check(append(xs, [9, 8]), [3, 1, 2, 9, 8])
check(append([], xs), xs)
check(concat([[1], [], [2, 3]]), [1, 2, 3])
check(map(x -> x * x, xs), [9, 1, 4])
check(filter(x -> x > 1, xs), [3, 2])
check(foldl((a, x) -> a - x, 10, xs), 4)
check(foldr((x, a) -> x - a, 0, xs), 4)
check(foldr((x, a) -> x :: a, [], xs), xs)
check(concat_map(x -> [x, x], [1, 2]), [1, 1, 2, 2])
check(sum(xs), 6)
check(nth(xs, 0), 3)
check(nth(xs, 2), 2)
check(last(xs), 2)
check(take(xs, 2), [3, 1])
check(take(xs, 9), xs)
check(take(xs, 0), [])
check(drop(xs, 1), [1, 2])
check(drop(xs, 9), [])
check(find(x -> x < 3, xs), 1)
check(find(x -> x > 9, xs), none)
check(any(x -> x == 2, xs), true)
check(any(x -> x == 7, xs), false)
check(any(x -> true, []), false)
check(all(x -> x > 0, xs), true)
check(all(x -> x > 1, xs), false)
check(all(x -> false, []), true)
check(member(2, xs), true)
check(member(5, xs), false)
check(member("a", ["b", "a"]), true)
check(index_of(2, xs), 2)
check(index_of(5, xs), -1)
check(zip([1, 2, 3], ["a", "b"]), [Tuple{1, "a"}, Tuple{2, "b"}])
check(zip([], [1]), [])
check(range(2, 6), [2, 3, 4, 5])
check(range(3, 3), [])
check(range(5, 3), [])
check(sort((a, b) -> a < b, xs), [1, 2, 3])
check(sort((a, b) -> a > b, xs), [3, 2, 1])
check(sort((a, b) -> a < b, []), [])
check(sort((a, b) -> a < b, [5, 5, 1, 5]), [1, 5, 5, 5])
check(sort((a, b) -> a < b, range(0, 300)), range(0, 300))
check(sort((a, b) -> a < b, reverse(range(0, 300))), range(0, 300))
# stable: the pairs with the same first element keep their order
check(sort((a, b) -> arg(a, 0) < arg(b, 0), [Tuple{2, "a"}, Tuple{1, "b"}, Tuple{2, "c"}, Tuple{1, "d"}]),
      [Tuple{1, "b"}, Tuple{1, "d"}, Tuple{2, "a"}, Tuple{2, "c"}])
check(sort(str_less, ["pear", "apple", "fig"]), ["apple", "fig", "pear"])
# map calls f in order
order := []
map(x -> { order = x :: order; x }, [1, 2, 3])
check(order, [3, 2, 1])
total := 0
each(x -> { total = total + x }, [1, 2, 3])
check(total, 6)
# long lists
big := range(0, 5000)
check(length(big), 5000)
check(sum(map(x -> 1, big)), 5000)
check(last(big), 4999)

# === vector ===
v := vec_new()
check(vec_len(v), 0)
check(vec_to_list(v), [])
i := 0
while (i < 100) {
    vec_push(v, i * 2)
    i = i + 1
}
check(vec_len(v), 100)
check(vec_get(v, 0), 0)
check(vec_get(v, 99), 198)
check(vec_set(v, 5, "x"), "x")
check(vec_get(v, 5), "x")
check(vec_pop(v), 198)
check(vec_len(v), 99)
check(vec_to_list(vec_from_list([1, 2, 3])), [1, 2, 3])
check(vec_len(vec_from_list([])), 0)
w := vec_new()
vec_push(w, "a")
vec_push(w, "b")
check(vec_pop(w), "b")
check(vec_pop(w), "a")
check(vec_len(w), 0)
# v[i] and v[i] = x
u := vec_from_list([1, 2, 3])
u[1] = 20
check(u[1], 20)
check(vec_get(u, 1), 20)
check(u[0] + u[2], 4)
us := 0
for (x in u) us = us + x
check(us, 24)

# === character classes ===
check(is_digit(ord("5", 0)), true)
check(is_digit(ord("a", 0)), false)
check(is_alpha(ord("Z", 0)), true)
check(is_alpha(ord("_", 0)), false)
check(is_alnum(ord("7", 0)), true)
check(is_alnum(ord("-", 0)), false)
check(is_space(ord(" ", 0)), true)
check(is_space(10), true)
check(is_space(ord("x", 0)), false)
check(is_upper(ord("a", 0)), false)
check(is_lower(ord("a", 0)), true)
check(is_ident_start(ord("_", 0)), true)
check(is_ident_start(ord("1", 0)), false)
check(is_ident_char(ord("1", 0)), true)

# === string ===
check(strlen(ascii_printable), 95)
check(chr(65), "A")
check(chr(126), "~")
check(chr(32), " ")
check(chr(34), "\"")
check(chr(92), "\\")
check(chr(10), "\n")
check(chr(9), "\t")
check(map(c -> ord(chr(c), 0), range(32, 127)), range(32, 127))
check(char_at("abc", 1), "b")
check(char_at("abc", 3), "")
check(char_at("abc", -1), "")
check(starts_with("hello", "he"), true)
check(starts_with("hello", "lo"), false)
check(starts_with("he", "hello"), false)
check(starts_with("hello", ""), true)
check(ends_with("hello", "lo"), true)
check(ends_with("hello", "he"), false)
check(ends_with("lo", "hello"), false)
check(index_of_str("hello", "l", 0), 2)
check(index_of_str("hello", "l", 3), 3)
check(index_of_str("hello", "z", 0), -1)
check(index_of_str("hello", "hello", 0), 0)
check(str_repeat("ab", 3), "ababab")
check(str_repeat("ab", 0), "")
check(str_cmp("a", "b"), -1)
check(str_cmp("b", "a"), 1)
check(str_cmp("ab", "ab"), 0)
check(str_cmp("ab", "abc"), -1)
check(str_cmp("abc", "ab"), 1)
check(str_cmp("", ""), 0)
check(str_less("a", "b"), true)
check(trim("  a b \n"), "a b")
check(trim("   "), "")
check(trim("x"), "x")
check(int_to_str(0), "0")
check(int_to_str(7), "7")
check(int_to_str(1234567), "1234567")
check(int_to_str(-45), "-45")
check(str_to_int("0"), 0)
check(str_to_int("1234567"), 1234567)
check(str_to_int("-45"), -45)
check(str_to_int(""), none)
check(str_to_int("-"), none)
check(str_to_int("12a"), none)
check(str_to_int(int_to_str(98765)), 98765)
check(split("a,b,,c", ","), ["a", "b", "", "c"])
check(split("abc", ","), ["abc"])
check(split("", ","), [""])
check(split("a--b--", "--"), ["a", "b", ""])
check(join(", ", ["a", "b", "c"]), "a, b, c")
check(join(",", []), "")
check(join(",", ["x"]), "x")
check(join("", split("a b c", " ")), "abc")
check(symname('foo), "foo")
check(intern(symname('Bar)), 'Bar)

# === string buffer ===
b := strbuf_new()
check(strbuf_str(b), "")
strbuf_add(b, "ab")
check(strbuf_str(b), "ab")
strbuf_add(b, "")
strbuf_add(b, "cd")
strbuf_add(b, "e")
check(strbuf_str(b), "abcde")
n := 0
while (n < 1000) {
    strbuf_add(b, int_to_str(n % 10))
    n = n + 1
}
check(strlen(strbuf_str(b)), 1005)
check(substr(strbuf_str(b), 0, 12), "abcde0123456")

# === table and set ===
t := table()
check(table_len(t), 0)
check(table_keys(t), [])
table_set(t, "a", 1)
table_set(t, 'b, 2)
table_set(t, 3, 3)
table_set(t, "a", 10)
check(table_len(t), 3)
check(table_has(t, "a"), true)
check(table_has(t, 'b), true)
check(table_has(t, "z"), false)
check(table_has(t, 4), false)
check(sort((a, b) -> a < b, table_values(t)), [2, 3, 10])
check(sort(str_less, map(k -> if (typeof(k) == 'string) k else if (typeof(k) == 'symbol) symname(k) else int_to_str(k), table_keys(t))), ["3", "a", "b"])
check(length(table_items(t)), 3)
check(member(Tuple{"a", 10}, table_items(t)), true)
i = 0
while (i < 500) {
    table_set(t, i + 1000, i)
    i = i + 1
}
check(table_len(t), 503)
check(sum(filter(x -> x < 500, table_values(t))), 124750 + 2 + 3 + 10)
s := set_from_list([3, 1, 3, 2, 1])
check(set_len(s), 3)
check(set_has(s, 2), true)
check(set_has(s, 5), false)
set_add(s, 5)
check(set_has(s, 5), true)
check(sort((a, b) -> a < b, set_to_list(s)), [1, 2, 3, 5])
check(set_len(set_new()), 0)

# === gensym ===
gensym_reset()
check(gensym("t"), 't1)
check(gensym("t"), 't2)
check(gensym("L"), 'L3)
gensym_reset()
check(gensym("t"), 't1)

# === errors with positions ===
src := "let x = 1\nlet yy = 22\n\nz"
check(line_col(src, 0), Tuple{1, 1})
check(line_col(src, 4), Tuple{1, 5})
check(line_col(src, 9), Tuple{1, 10})
check(line_col(src, 10), Tuple{2, 1})
check(line_col(src, 14), Tuple{2, 5})
check(line_col(src, 22), Tuple{3, 1})
check(line_col(src, 23), Tuple{4, 1})
check(line_col(src, 99), Tuple{4, 2})
check(line_col("", 0), Tuple{1, 1})
check(line_text(src, 1), "let x = 1")
check(line_text(src, 2), "let yy = 22")
check(line_text(src, 3), "")
check(line_text(src, 4), "z")
l := loc_at("a.txt", src, 14)
check(l, Loc{"a.txt", 2, 5})
check(show_loc(l), "a.txt:2:5")
check(catch_error(() -> 1 + 2), Ok{3})
check(catch_error(() -> { error_at(l, "bad"); 5 }), Err{Loc{"a.txt", 2, 5}, "bad"})
check(show_error(src, l, "unexpected yy"), "a.txt:2:5: unexpected yy\n  let yy = 22\n      ^")
# an error inside a nested call is caught by the nearest catch_error
inner(x) := if (x == 0) error_at(l, "zero") else x
check(catch_error(() -> inner(1) + inner(0)), Err{Loc{"a.txt", 2, 5}, "zero"})

# === pretty ===
check(show(12), "12")
check(show(-3), "-3")
check(show("a\"b\\c\nd"), "\"a\\\"b\\\\c\\nd\"")
check(show('foo), "foo")
check(show([1, 2, 3]), "[1, 2, 3]")
check(show([]), "[]")
check(show(Add{1, Mul{'x, "s"}}), "Add{1, Mul{x, \"s\"}}")
check(show(Tuple{}), "Tuple{}")
check(show(Cons{1, 2}), "Cons{1, 2}")
check(show([[1], [Tuple{2, 3}]]), "[[1], [Tuple{2, 3}]]")
check(show(x -> x), "<function>")
check(show(array(1)), "<array>")
check(pretty(Add{1, 2}, 80), "Add{1, 2}")
check(pretty(Add{Num{1}, Mul{Num{2}, Num{3}}}, 12), "Add{\n  Num{1},\n  Mul{\n    Num{2},\n    Num{3}\n  }\n}")
check(pretty([10, 20, 30], 4), "[\n  10,\n  20,\n  30\n]")
check(pretty(12345, 2), "12345")

# === u64 ===
check(u64_to_hex(u64(0)), "0x0000000000000000")
check(u64_to_hex(u64(255)), "0x00000000000000ff")
check(u64_to_hex(u64(-1)), "0xffffffffffffffff")
check(u64_to_hex(u64(-2)), "0xfffffffffffffffe")
check(u64_to_hex(u64_hex("0x0123456789abcdef")), "0x0123456789abcdef")
check(u64_to_hex(u64_hex("DEAD_beef")), "0x00000000deadbeef")
check(u64_to_hex(u64_limbs(1, 2, 3, 4)), "0x0001000200030004")
check(u64_to_int(u64(-5)), -5)
check(u64_to_int(u64(123456789)), 123456789)
check(u64_to_int(u64(-1073741824)), -1073741824)
check(u64_to_int(u64(1073741823)), 1073741823)
check(u64_to_hex(u64_add(u64_hex("0xffffffffffffffff"), u64(1))), "0x0000000000000000")
check(u64_to_hex(u64_add(u64_hex("0x00000000ffffffff"), u64(1))), "0x0000000100000000")
check(u64_to_hex(u64_add(u64_hex("0x8000000000000000"), u64_hex("0x8000000000000001"))), "0x0000000000000001")
check(u64_to_hex(u64_add(u64_hex("0x0fffffffffffffff"), u64_hex("0x0fffffffffffffff"))), "0x1ffffffffffffffe")
check(u64_to_hex(u64_sub(u64(0), u64(1))), "0xffffffffffffffff")
check(u64_to_hex(u64_sub(u64_hex("0x0000000100000000"), u64(1))), "0x00000000ffffffff")
check(u64_to_hex(u64_sub(u64_hex("0x1122334455667788"), u64_hex("0x1122334455667788"))), "0x0000000000000000")
check(u64_to_hex(u64_neg(u64(1))), "0xffffffffffffffff")
check(u64_to_hex(u64_and(u64_hex("0xff00ff00ff00ff00"), u64_hex("0x0ff00ff00ff00ff0"))), "0x0f000f000f000f00")
check(u64_to_hex(u64_or(u64_hex("0xff00ff00ff00ff00"), u64_hex("0x0ff00ff00ff00ff0"))), "0xfff0fff0fff0fff0")
check(u64_to_hex(u64_xor(u64_hex("0xff00ff00ff00ff00"), u64_hex("0x0ff00ff00ff00ff0"))), "0xf0f0f0f0f0f0f0f0")
check(u64_to_hex(u64_not(u64_hex("0x00ff00ff00ff00ff"))), "0xff00ff00ff00ff00")
check(u64_to_hex(u64_shl(u64(1), 0)), "0x0000000000000001")
check(u64_to_hex(u64_shl(u64(1), 63)), "0x8000000000000000")
check(u64_to_hex(u64_shl(u64(1), 16)), "0x0000000000010000")
check(u64_to_hex(u64_shl(u64_hex("0x0123456789abcdef"), 4)), "0x123456789abcdef0")
check(u64_to_hex(u64_shl(u64_hex("0x0123456789abcdef"), 36)), "0x9abcdef000000000")
check(u64_to_hex(u64_shl(u64_hex("0x0123456789abcdef"), 32)), "0x89abcdef00000000")
check(u64_to_hex(u64_shr(u64_hex("0x8123456789abcdef"), 4)), "0x08123456789abcde")
check(u64_to_hex(u64_shr(u64_hex("0x8123456789abcdef"), 36)), "0x0000000008123456")
check(u64_to_hex(u64_shr(u64_hex("0x8123456789abcdef"), 63)), "0x0000000000000001")
check(u64_to_hex(u64_shr(u64_hex("0x8123456789abcdef"), 0)), "0x8123456789abcdef")
check(u64_to_hex(u64_sar(u64_hex("0x8123456789abcdef"), 4)), "0xf8123456789abcde")
check(u64_to_hex(u64_sar(u64_hex("0x8123456789abcdef"), 60)), "0xfffffffffffffff8")
check(u64_to_hex(u64_sar(u64_hex("0x7123456789abcdef"), 60)), "0x0000000000000007")
check(u64_to_hex(u64_sar(u64(-1), 63)), "0xffffffffffffffff")
check(u64_eq(u64_hex("0x10"), u64(16)), true)
check(u64_eq(u64_hex("0x10"), u64(17)), false)
check(u64_ucmp(u64(1), u64(2)), -1)
check(u64_ucmp(u64(2), u64(2)), 0)
check(u64_ucmp(u64(-1), u64(2)), 1)
check(u64_scmp(u64(-1), u64(2)), -1)
check(u64_scmp(u64_hex("0x0000000100000000"), u64_hex("0x00000000ffffffff")), 1)
check(u64_ult(u64(1), u64(-1)), true)
check(u64_slt(u64(1), u64(-1)), false)
buf := u8_array(10)
u64_write_le(buf, 1, u64_hex("0x0102030405060708"))
check(map(i -> buf[i], range(0, 10)), [0, 8, 7, 6, 5, 4, 3, 2, 1, 0])
u64_write_be(buf, 0, u64_hex("0x0102030405060708"))
check(map(i -> buf[i], range(0, 10)), [1, 2, 3, 4, 5, 6, 7, 8, 1, 0])
check(u64_to_hex(u64_read_le(u64_bytes_le(u64_hex("0xfedcba9876543210")), 0)), "0xfedcba9876543210")
check(map(i -> u64_bytes_le(u64_hex("0xfedcba9876543210"))[i], range(0, 8)), [16, 50, 84, 118, 152, 186, 220, 254])

check(array_len(list_to_array([])), 0)
check(list_to_array([5, 6])[1], 6)
check(array_len(list_to_array([5, 6, 7])), 3)

# === getopt ===
spec := [Opt{"a", "", false}, Opt{"b", "bold", false}, Opt{"c", "", false}, Opt{"o", "output", true}, Opt{"", "level", true}]
parsed(args) := getopt(spec, list_to_array(args), 0)
optval(r, k) := table_get(arg(r, 0), k, none)
rest_of(r) := map(i -> array_get(arg(r, 1), i), range(0, array_len(arg(r, 1))))
r := parsed(["-a"])
check(optval(r, "a"), true)
check(optval(r, "c"), none)
check(rest_of(r), [])
r = parsed(["-abc"])
check([optval(r, "a"), optval(r, "bold"), optval(r, "c")], [true, true, true])
r = parsed(["-o", "out.txt"])
check(optval(r, "output"), "out.txt")
r = parsed(["-oout.txt"])
check(optval(r, "output"), "out.txt")
r = parsed(["-abo", "x"])
check([optval(r, "a"), optval(r, "bold"), optval(r, "output")], [true, true, "x"])
r = parsed(["-aoval"])
check([optval(r, "a"), optval(r, "output")], [true, "val"])
r = parsed(["--bold"])
check(optval(r, "bold"), true)
r = parsed(["--output", "f"])
check(optval(r, "output"), "f")
r = parsed(["--output=f=g"])
check(optval(r, "output"), "f=g")
r = parsed(["--level", "-3"])
check(optval(r, "level"), "-3")
r = parsed(["-o", "-a"])
check([optval(r, "output"), optval(r, "a")], ["-a", none])
r = parsed(["--output="])
check(optval(r, "output"), "")
r = parsed(["-o", "1", "-o", "2"])
check(optval(r, "output"), "2")
r = parsed(["x", "-a", "y", "--bold", "z"])
check(rest_of(r), ["x", "y", "z"])
check([optval(r, "a"), optval(r, "bold")], [true, true])
r = parsed(["-a", "--", "-b", "--bold", "--"])
check(rest_of(r), ["-b", "--bold", "--"])
check([optval(r, "a"), optval(r, "bold")], [true, none])
r = parsed(["-", "x"])
check(rest_of(r), ["-", "x"])
r = parsed([])
check([rest_of(r), table_len(arg(r, 0))], [[], 0])
check(arg(getopt(spec, list_to_array(["prog", "-a", "f"]), 1), 1)[0], "f")
check(parsed(["-z"]), Unknown{"-z"})
check(parsed(["-az"]), Unknown{"-z"})
check(parsed(["--nope"]), Unknown{"--nope"})
check(parsed(["--nope=1"]), Unknown{"--nope"})
check(parsed(["-o"]), Missing{"-o"})
check(parsed(["-ao"]), Missing{"-o"})
check(parsed(["--output"]), Missing{"--output"})
check(parsed(["--bold=1"]), NoValue{"--bold"})
check(parsed(["--=1"]), Unknown{"--"})

put("Tests passed "); print(passed); put("/"); println(passed + failed)
if (failed > 0) exit(1)
