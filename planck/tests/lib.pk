# tests for the libraries in planck/lib
# Copyright (C) 2026 nineties

passed := 0
failed := 0

check(actual, expected) := if (actual == expected) {
    passed = passed + 1
} else {
    failed = failed + 1
    put("Test failed: expected "); print(expected)
    put(" but got "); println(actual)
}

use("base")
use("list")
use("vector")
use("string")
use("table")
use("symbol")
use("error")
use("pretty")
use("getopt")

# use loads a file once
check(table.get(used_libs, "list", false), true)

# === list ===
xs := [3, 1, 2]
check(length(xs), 3)
check(length([]), 0)
check(reverse(xs), [2, 1, 3])
check(reverse([]), [])
check(append(xs, [9, 8]), [3, 1, 2, 9, 8])
check(append([], xs), xs)
check(list.concat([[1], [], [2, 3]]), [1, 2, 3])
check(map(x -> x * x, xs), [9, 1, 4])
check(filter(x -> x > 1, xs), [3, 2])
check(foldl((a, x) -> a - x, 10, xs), 4)
check(list.foldr((x, a) -> x - a, 0, xs), 4)
check(list.foldr((x, a) -> x :: a, [], xs), xs)
check(concat_map(x -> [x, x], [1, 2]), [1, 1, 2, 2])
check(list.sum(xs), 6)
check(list.nth(xs, 0), 3)
check(list.nth(xs, 2), 2)
check(list.last(xs), 2)
check(list.take(xs, 2), [3, 1])
check(list.take(xs, 9), xs)
check(list.take(xs, 0), [])
check(list.drop(xs, 1), [1, 2])
check(list.drop(xs, 9), [])
check(find(x -> x < 3, xs), 1)
check(find(x -> x > 9, xs), none)
check(list.any(x -> x == 2, xs), true)
check(list.any(x -> x == 7, xs), false)
check(list.any(x -> true, []), false)
check(list.all(x -> x > 0, xs), true)
check(list.all(x -> x > 1, xs), false)
check(list.all(x -> false, []), true)
check(member(2, xs), true)
check(member(5, xs), false)
check(member("a", ["b", "a"]), true)
check(list.index_of(2, xs), 2)
check(list.index_of(5, xs), -1)
check(list.zip([1, 2, 3], ["a", "b"]), [Tuple{1, "a"}, Tuple{2, "b"}])
check(list.zip([], [1]), [])
check(range(2, 6), [2, 3, 4, 5])
check(range(3, 3), [])
check(range(5, 3), [])
check(list.sort((a, b) -> a < b, xs), [1, 2, 3])
check(list.sort((a, b) -> a > b, xs), [3, 2, 1])
check(list.sort((a, b) -> a < b, []), [])
check(list.sort((a, b) -> a < b, [5, 5, 1, 5]), [1, 5, 5, 5])
check(list.sort((a, b) -> a < b, range(0, 300)), range(0, 300))
check(list.sort((a, b) -> a < b, reverse(range(0, 300))), range(0, 300))
# stable: the pairs with the same first element keep their order
check(list.sort((a, b) -> arg(a, 0) < arg(b, 0), [Tuple{2, "a"}, Tuple{1, "b"}, Tuple{2, "c"}, Tuple{1, "d"}]),
      [Tuple{1, "b"}, Tuple{1, "d"}, Tuple{2, "a"}, Tuple{2, "c"}])
check(list.sort(string.str_less, ["pear", "apple", "fig"]), ["apple", "fig", "pear"])
# map calls f in order
order := []
map(x -> { order = x :: order; x }, [1, 2, 3])
check(order, [3, 2, 1])
total := 0
each(x -> { total = total + x }, [1, 2, 3])
check(total, 6)
# long lists
big := range(0, 5000)
check(length(big), 5000)
check(list.sum(map(x -> 1, big)), 5000)
check(list.last(big), 4999)

# === vector ===
v := vector.new()
check(vector.len(v), 0)
check(vector.to_list(v), [])
i := 0
while (i < 100) {
    vector.push(v, i * 2)
    i = i + 1
}
check(vector.len(v), 100)
check(vector.get(v, 0), 0)
check(vector.get(v, 99), 198)
check(vector.set(v, 5, "x"), "x")
check(vector.get(v, 5), "x")
check(vector.pop(v), 198)
check(vector.len(v), 99)
check(vector.to_list(vector.from_list([1, 2, 3])), [1, 2, 3])
check(vector.len(vector.from_list([])), 0)
w := vector.new()
vector.push(w, "a")
vector.push(w, "b")
check(vector.pop(w), "b")
check(vector.pop(w), "a")
check(vector.len(w), 0)
# v[i] and v[i] = x
u := vector.from_list([1, 2, 3])
u[1] = 20
check(u[1], 20)
check(vector.get(u, 1), 20)
check(u[0] + u[2], 4)
us := 0
for (x in u) us = us + x
check(us, 24)

# === character classes ===
check(string.is_digit(ord("5", 0)), true)
check(string.is_digit(ord("a", 0)), false)
check(string.is_alpha(ord("Z", 0)), true)
check(string.is_alpha(ord("_", 0)), false)
check(string.is_alnum(ord("7", 0)), true)
check(string.is_alnum(ord("-", 0)), false)
check(string.is_space(ord(" ", 0)), true)
check(string.is_space(10), true)
check(string.is_space(ord("x", 0)), false)
check(string.is_upper(ord("a", 0)), false)
check(string.is_lower(ord("a", 0)), true)
check(string.is_ident_start(ord("_", 0)), true)
check(string.is_ident_start(ord("1", 0)), false)
check(string.is_ident_char(ord("1", 0)), true)

# === string ===
check(strlen(string.ascii_printable), 95)
check(string.chr(65), "A")
check(string.chr(126), "~")
check(string.chr(32), " ")
check(string.chr(34), "\"")
check(string.chr(92), "\\")
check(string.chr(10), "\n")
check(string.chr(9), "\t")
check(map(c -> ord(string.chr(c), 0), range(32, 127)), range(32, 127))
check(string.char_at("abc", 1), "b")
check(string.char_at("abc", 3), "")
check(string.char_at("abc", -1), "")
check(string.starts_with("hello", "he"), true)
check(string.starts_with("hello", "lo"), false)
check(string.starts_with("he", "hello"), false)
check(string.starts_with("hello", ""), true)
check(string.ends_with("hello", "lo"), true)
check(string.ends_with("hello", "he"), false)
check(string.ends_with("lo", "hello"), false)
check(string.index_of_str("hello", "l", 0), 2)
check(string.index_of_str("hello", "l", 3), 3)
check(string.index_of_str("hello", "z", 0), -1)
check(string.index_of_str("hello", "hello", 0), 0)
check(string.str_repeat("ab", 3), "ababab")
check(string.str_repeat("ab", 0), "")
check(string.str_cmp("a", "b"), -1)
check(string.str_cmp("b", "a"), 1)
check(string.str_cmp("ab", "ab"), 0)
check(string.str_cmp("ab", "abc"), -1)
check(string.str_cmp("abc", "ab"), 1)
check(string.str_cmp("", ""), 0)
check(string.str_less("a", "b"), true)
check(string.trim("  a b \n"), "a b")
check(string.trim("   "), "")
check(string.trim("x"), "x")
check(string.int_to_str(0), "0")
check(string.int_to_str(7), "7")
check(string.int_to_str(1234567), "1234567")
check(string.int_to_str(-45), "-45")
check(string.str_to_int("0"), 0)
check(string.str_to_int("1234567"), 1234567)
check(string.str_to_int("-45"), -45)
check(string.str_to_int(""), none)
check(string.str_to_int("-"), none)
check(string.str_to_int("12a"), none)
check(string.str_to_int(string.int_to_str(98765)), 98765)
check(string.split("a,b,,c", ","), ["a", "b", "", "c"])
check(string.split("abc", ","), ["abc"])
check(string.split("", ","), [""])
check(string.split("a--b--", "--"), ["a", "b", ""])
check(join(", ", ["a", "b", "c"]), "a, b, c")
check(join(",", []), "")
check(join(",", ["x"]), "x")
check(join("", string.split("a b c", " ")), "abc")
check(symname('foo), "foo")
check(intern(symname('Bar)), 'Bar)

# === string buffer ===
b := strbuf.new()
check(strbuf.str(b), "")
strbuf.add(b, "ab")
check(strbuf.str(b), "ab")
strbuf.add(b, "")
strbuf.add(b, "cd")
strbuf.add(b, "e")
check(strbuf.str(b), "abcde")
n := 0
while (n < 1000) {
    strbuf.add(b, string.int_to_str(n % 10))
    n = n + 1
}
check(strlen(strbuf.str(b)), 1005)
check(substr(strbuf.str(b), 0, 12), "abcde0123456")

# === table and set ===
t := table.new()
check(table.len(t), 0)
check(table.keys(t), [])
table.set(t, "a", 1)
table.set(t, 'b, 2)
table.set(t, 3, 3)
table.set(t, "a", 10)
check(table.len(t), 3)
check(table.has(t, "a"), true)
check(table.has(t, 'b), true)
check(table.has(t, "z"), false)
check(table.has(t, 4), false)
check(list.sort((a, b) -> a < b, table.values(t)), [2, 3, 10])
check(list.sort(string.str_less, map(k -> if (typeof(k) == 'string) k else if (typeof(k) == 'symbol) symname(k) else string.int_to_str(k), table.keys(t))), ["3", "a", "b"])
check(length(table.items(t)), 3)
check(member(Tuple{"a", 10}, table.items(t)), true)
i = 0
while (i < 500) {
    table.set(t, i + 1000, i)
    i = i + 1
}
check(table.len(t), 503)
check(list.sum(filter(x -> x < 500, table.values(t))), 124750 + 2 + 3 + 10)
s := set.from_list([3, 1, 3, 2, 1])
check(set.len(s), 3)
check(set.has(s, 2), true)
check(set.has(s, 5), false)
set.add(s, 5)
check(set.has(s, 5), true)
check(list.sort((a, b) -> a < b, set.to_list(s)), [1, 2, 3, 5])
check(set.len(set.new()), 0)

# === gensym ===
symbol.reset()
check(symbol.gensym("t"), 't1)
check(symbol.gensym("t"), 't2)
check(symbol.gensym("L"), 'L3)
symbol.reset()
check(symbol.gensym("t"), 't1)

# === errors with positions ===
src := "let x = 1\nlet yy = 22\n\nz"
check(error.line_col(src, 0), Tuple{1, 1})
check(error.line_col(src, 4), Tuple{1, 5})
check(error.line_col(src, 9), Tuple{1, 10})
check(error.line_col(src, 10), Tuple{2, 1})
check(error.line_col(src, 14), Tuple{2, 5})
check(error.line_col(src, 22), Tuple{3, 1})
check(error.line_col(src, 23), Tuple{4, 1})
check(error.line_col(src, 99), Tuple{4, 2})
check(error.line_col("", 0), Tuple{1, 1})
check(error.line_text(src, 1), "let x = 1")
check(error.line_text(src, 2), "let yy = 22")
check(error.line_text(src, 3), "")
check(error.line_text(src, 4), "z")
l := error.loc_at("a.txt", src, 14)
check(l, Loc{"a.txt", 2, 5})
check(error.show_loc(l), "a.txt:2:5")
check(error.catch(() -> 1 + 2), Ok{3})
check(error.catch(() -> { error.at(l, "bad"); 5 }), Err{Loc{"a.txt", 2, 5}, "bad"})
check(error.show(src, l, "unexpected yy"), "a.txt:2:5: unexpected yy\n  let yy = 22\n      ^")
# an error inside a nested call is caught by the nearest error.catch
inner(x) := if (x == 0) error.at(l, "zero") else x
check(error.catch(() -> inner(1) + inner(0)), Err{Loc{"a.txt", 2, 5}, "zero"})

# === pretty ===
check(pretty.show(12), "12")
check(pretty.show(-3), "-3")
check(pretty.show("a\"b\\c\nd"), "\"a\\\"b\\\\c\\nd\"")
check(pretty.show('foo), "foo")
check(pretty.show([1, 2, 3]), "[1, 2, 3]")
check(pretty.show([]), "[]")
check(pretty.show(Add{1, Mul{'x, "s"}}), "Add{1, Mul{x, \"s\"}}")
check(pretty.show(Tuple{}), "Tuple{}")
check(pretty.show(Cons{1, 2}), "Cons{1, 2}")
check(pretty.show([[1], [Tuple{2, 3}]]), "[[1], [Tuple{2, 3}]]")
check(pretty.show(x -> x), "<function>")
check(pretty.show(array(1)), "<array>")
check(pretty.text(Add{1, 2}, 80), "Add{1, 2}")
check(pretty.text(Add{Num{1}, Mul{Num{2}, Num{3}}}, 12), "Add{\n  Num{1},\n  Mul{\n    Num{2},\n    Num{3}\n  }\n}")
check(pretty.text([10, 20, 30], 4), "[\n  10,\n  20,\n  30\n]")
check(pretty.text(12345, 2), "12345")

check(array_len(list.list_to_array([])), 0)
check(list.list_to_array([5, 6])[1], 6)
check(array_len(list.list_to_array([5, 6, 7])), 3)

# === getopt ===
spec := [Opt{"a", "", false}, Opt{"b", "bold", false}, Opt{"c", "", false}, Opt{"o", "output", true}, Opt{"", "level", true}]
parsed(args) := getopt.parse(spec, list.list_to_array(args), 0)
optval(r, k) := table.get(arg(r, 0), k, none)
rest_of(r) := map(i -> array_get(arg(r, 1), i), range(0, array_len(arg(r, 1))))
r := parsed(["-a"])
check(optval(r, "a"), true)
check(optval(r, "c"), none)
check(rest_of(r), [])
r = parsed(["-abc"])
check([optval(r, "a"), optval(r, "bold"), optval(r, "c")], [true, true, true])
r = parsed(["-o", "out.txt"])
check(optval(r, "output"), "out.txt")
r = parsed(["-oout.txt"])
check(optval(r, "output"), "out.txt")
r = parsed(["-abo", "x"])
check([optval(r, "a"), optval(r, "bold"), optval(r, "output")], [true, true, "x"])
r = parsed(["-aoval"])
check([optval(r, "a"), optval(r, "output")], [true, "val"])
r = parsed(["--bold"])
check(optval(r, "bold"), true)
r = parsed(["--output", "f"])
check(optval(r, "output"), "f")
r = parsed(["--output=f=g"])
check(optval(r, "output"), "f=g")
r = parsed(["--level", "-3"])
check(optval(r, "level"), "-3")
r = parsed(["-o", "-a"])
check([optval(r, "output"), optval(r, "a")], ["-a", none])
r = parsed(["--output="])
check(optval(r, "output"), "")
r = parsed(["-o", "1", "-o", "2"])
check(optval(r, "output"), "2")
r = parsed(["x", "-a", "y", "--bold", "z"])
check(rest_of(r), ["x", "y", "z"])
check([optval(r, "a"), optval(r, "bold")], [true, true])
r = parsed(["-a", "--", "-b", "--bold", "--"])
check(rest_of(r), ["-b", "--bold", "--"])
check([optval(r, "a"), optval(r, "bold")], [true, none])
r = parsed(["-", "x"])
check(rest_of(r), ["-", "x"])
r = parsed([])
check([rest_of(r), table.len(arg(r, 0))], [[], 0])
check(arg(getopt.parse(spec, list.list_to_array(["prog", "-a", "f"]), 1), 1)[0], "f")
check(parsed(["-z"]), Unknown{"-z"})
check(parsed(["-az"]), Unknown{"-z"})
check(parsed(["--nope"]), Unknown{"--nope"})
check(parsed(["--nope=1"]), Unknown{"--nope"})
check(parsed(["-o"]), Missing{"-o"})
check(parsed(["-ao"]), Missing{"-o"})
check(parsed(["--output"]), Missing{"--output"})
check(parsed(["--bold=1"]), NoValue{"--bold"})
check(parsed(["--=1"]), Unknown{"--"})

put("Tests passed "); print(passed); put("/"); println(passed + failed)
if (failed > 0) exit(1)
