# tests for backend/target.pk: the bytes of the executables that vasm/build.pk makes for the targets x86 and x86_64
# Copyright (C) 2026 nineties

passed := 0
failed := 0

check(actual, expected) := if (actual == expected) {
    passed = passed + 1
} else {
    failed = failed + 1
    put("Test failed: expected "); print(expected)
    put(" but got "); println(actual)
}

use("vasm/build")

t32 := target_get('x86)

# the checksum of n bytes: FNV-1a with 32 bits
fnv(get, n) := {
    h := 2166136261
    i := 0
    while (i < n) {
        h = bit_and(bit_xor(h, get(i)) * 16777619, 4294967295)
        i = i + 1
    }
    h
}

# the executable of the vasm example name: Tuple{length, checksum}
example_sum(name) := {
    path := f"planck/examples/vasm/{name}.vasm"
    m := arg(peg_parse('vasm, read_file(path)), 0)
    check(vasm_errors(path, m), [])
    b := vasm_executable_for(t32, m)
    Tuple{bb_len(b), fnv(i -> bb_get(b, i), bb_len(b))}
}

check(example_sum("hello"), Tuple{720, -376238484})
check(example_sum("fib"), Tuple{864, -701926009})
check(example_sum("control"), Tuple{864, -280551860})
check(example_sum("array"), Tuple{1392, 371115762})
check(example_sum("own_struct"), Tuple{1440, 888902627})

# the default target is x86_64
check(target_default, 'x86_64)
check(target_word(t32), 4)

# the file of the x86-64 target is a 64-bit ELF file of the machine 62, loaded at 0x400000
t64 := target_get('x86_64)
check(target_word(t64), 8)
path64 := "planck/examples/vasm/hello.vasm"
file64 := vasm_executable_for(t64, arg(peg_parse('vasm, read_file(path64)), 0))
check(map(i -> bb_get(file64, i), range(0, 8)), [127, 69, 76, 70, 2, 1, 1, 0])
check(map(i -> bb_get(file64, i), range(16, 20)), [2, 0, 62, 0])
check(map(i -> bb_get(file64, i), range(32, 36)), [64, 0, 0, 0])
check(map(i -> bb_get(file64, i), range(52, 58)), [64, 0, 56, 0, 2, 0])
# the first segment is loaded at 0x400000
check(map(i -> bb_get(file64, i), range(64 + 16, 64 + 20)), [0, 0, 64, 0])

# the file made without a target is the file of the default target
path_hello := "planck/examples/vasm/hello.vasm"
m_hello := arg(peg_parse('vasm, read_file(path_hello)), 0)
check(vec_to_list(vasm_executable(m_hello)) == vec_to_list(file64), true)
check(vec_to_list(vasm_executable(m_hello)) == vec_to_list(vasm_executable_for(t32, m_hello)), false)


put("Tests passed "); print(passed); put("/"); println(passed + failed)
if (failed > 0) exit(1)
