big_unit := vasm_unit.unit("big", big, [], 8)
check(vasm_unit.text(vasm_unit.parse(vasm_unit.text(big_unit))) == vasm_unit.text(big_unit), true)

print(f"Tests passed {passed}/{passed + failed}")
if (failed > 0) exit(1)
