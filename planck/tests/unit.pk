# Copyright (C) 2026 nineties

passed := 0
failed := 0

check(actual, expected) := if (actual == expected) {
    passed = passed + 1
} else {
    failed = failed + 1
    print(f"Test failed: expected {expected} but got {actual}")
}

use("vasm/build")
use("list")

lib := vasm{|
    struct Buf { data: own [u8], size: i64 }

    fun make(n: i64) -> Buf {
        var d: own [u8]
        var b: Buf
        d = allocate(n, 7)
        b = Buf{data: d, size: n}
        return b
    }

    fun sum(b: Buf) -> i64 {
        var d: own [u8]
        var n: i64
        var i: i64
        var s: i64
        var c: u8
        var w: i64
        d = b.data
        n = b.size
        s = 0
        i = 0
        while (i < n) {
            c = d[i]
            w = c as i64
            s = s + w
            i = i + 1
        }
        return s
    }

    fun greet() {
        write(1, "shared\n")
        write(1, "from the library\n")
    }
|}

app := vasm{|
    fun main() -> i64 {
        var b: Buf
        var t: i64
        greet()
        write(1, "shared\n")
        b = make(10)
        t = sum(b)
        return t
    }
|}

whole := Module{append(arg(lib, 0), arg(app, 0))}

word := target.word(target.get(target.default))
lib_unit := vasm_unit.unit("lib", lib, [], word)
app_unit := vasm_unit.unit("app", app, vasm_unit.iface(lib), word)
check(vasm_unit.word(lib_unit), 8)

text_before := vasm_unit.text(lib_unit)
whole_bytes := vasm_build.executable(whole)
split_bytes := vasm_build.units_executable([lib_unit, app_unit])
check(bytes.len(split_bytes) > 0, true)
check(vector.to_list(split_bytes) == vector.to_list(whole_bytes), true)

check(vasm_unit.text(lib_unit) == text_before, true)

saved := vasm_unit.parse(vasm_unit.text(lib_unit))
check(vasm_unit.text(saved) == vasm_unit.text(lib_unit), true)
check(vector.to_list(vasm_build.units_executable([saved, vasm_unit.parse(vasm_unit.text(app_unit))])) == vector.to_list(whole_bytes), true)

check(vasm_unit.name(lib_unit), "lib")
check(vasm_unit.ifaces(app_unit), vasm_unit.iface(app))

t64 := target.get('linux_x86_64)
check(vector.to_list(vasm_build.units_executable_for(t64, [lib_unit, app_unit])) == vector.to_list(vasm_build.executable_for(t64, whole)), true)


