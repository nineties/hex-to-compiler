# tests for import a::b as m (x, y), (*) and hiding
# Copyright (C) 2026 nineties

passed := 0
failed := 0

check(actual, expected) := if (actual == expected) {
    passed = passed + 1
} else {
    failed = failed + 1
    put("Test failed: expected "); print(expected)
    put(" but got "); println(actual)
}

# import m loads the file; the fields are read with m.f
import bitset
b := bitset.new(40)
bitset.add(b, 3)
check(bitset.has(b, 3), true)
check(bitset.has(b, 4), false)

# as renames the module
import bitset as bs
check(bs.has(b, 3), true)

# (x, y) defines x and y as the fields of the module
import bitset as bs2 (has, count)
check(has(b, 3), true)
check(count(b), 1)
check(bs2.count(b), 1)

# the names are local in a function
f(s) := {
    import bitset (to_list)
    to_list(s)
}
check(f(b), [3])

# a path of names is the path of the file under planck/lib
import backend::cfg as c
check(head(c), 'Module)

# hiding defines all the fields but the listed ones
import bitset hiding (new, add, del, copy, union, minus, equal, each, to_list)
check(Tuple{has(b, 3), count(b)}, Tuple{true, 1})

# the import ends at the end of the line: the next line is an expression of its own
import bitset
(1 + 2)
check(1, 1)

# (*) defines all the fields
import bitset (*)
b2 := new(40)
add(b2, 5)
check(to_list(b2), [5])

put("Tests passed "); print(passed); put("/"); println(passed + failed)
if (failed > 0) exit(1)
