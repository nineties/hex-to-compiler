# tests for the syntax (planck/syntax.pk) and the packrat parser (planck/peg.pk)
# Copyright (C) 2026 nineties

passed := 0
failed := 0

check(actual, expected) := if (actual == expected) {
    passed = passed + 1
} else {
    failed = failed + 1
    put("Test failed: expected "); print(expected)
    put(" but got "); println(actual)
}

# the tree of the first expression in s
tree(s) := arg(peg_parse('toplevel, s), 0)
# the rest of s after the first expression
rest(s) := arg(peg_parse('toplevel, s), 1)

# === Atoms ===
check(tree("x"), 'x)
check(tree("42"), 42)
check(tree("-3"), -3)
check(tree("0x1f"), 31)
check(tree("0b101"), 5)
check(tree("0o17"), 15)
check(tree("010"), 10)
check(tree("\"a\\tb\\n\""), "a\tb\n")
check(tree("\"\\\"q\\\"\""), "\"q\"")
check(tree("F{1, x}"), 'F{1, x})
check(tree("()"), 'Tuple{})
check(tree("(1)"), 1)
check(tree("(1, x)"), 'Tuple{1, x})
check(tree("[1, 2]"), 'Cons{1, Cons{2, Nil{}}})
check(tree("[]"), 'Nil{})

# === Operators ===
check(tree("1 + 2 * 3"), 'Apply{add, Tuple{1, Apply{mul, Tuple{2, 3}}}})
check(tree("(1 + 2) * 3"), 'Apply{mul, Tuple{Apply{add, Tuple{1, 2}}, 3}})
check(tree("1 - 2 - 3"), 'Apply{sub, Tuple{Apply{sub, Tuple{1, 2}}, 3}})
check(tree("8 / 4 % 3"), 'Apply{mod, Tuple{Apply{div, Tuple{8, 4}}, 3}})
check(tree("a + 1 < b"), 'Apply{lt, Tuple{Apply{add, Tuple{a, 1}}, b}})
check(tree("a <= b"), 'Apply{le, Tuple{a, b}})
check(tree("a >= b"), 'Apply{ge, Tuple{a, b}})
check(tree("a > b"), 'Apply{gt, Tuple{a, b}})
check(tree("a == b"), 'Apply{eq, Tuple{a, b}})
check(tree("a != b"), 'Apply{ne, Tuple{a, b}})
check(tree("not a == b"), 'Apply{not, Tuple{Apply{eq, Tuple{a, b}}}})
check(tree("a and b or c"), 'If{If{a, b, false}, true, c})
check(tree("a or b and c"), 'If{a, true, If{b, c, false}})
check(tree("c ? a : b"), 'If{c, a, b})
check(tree("-x"), 'Apply{sub, Tuple{0, x}})
check(tree("a - -1"), 'Apply{sub, Tuple{a, -1}})

# === Calls, functions and definitions ===
check(tree("f(x, 1)"), 'Apply{f, Tuple{x, 1}})
check(tree("f()(x)"), 'Apply{Apply{f, Tuple{}}, Tuple{x}})
check(tree("x -> x + 1"), 'Lambda{Tuple{x}, Apply{add, Tuple{x, 1}}})
check(tree("(x, y) -> x"), 'Lambda{Tuple{x, y}, x})
check(tree("() -> 1"), 'Lambda{Tuple{}, 1})
check(tree("x -> y -> x"), 'Lambda{Tuple{x}, Lambda{Tuple{y}, x}})
check(tree("(0) -> 1 | (n) -> n"), 'Fusion{Lambda{Tuple{0}, 1}, Lambda{Tuple{n}, n}})
check(tree("(F{a}, 'none) -> a"), 'Lambda{Tuple{F{a}, Quote{none}}, a})
check(tree("(x @ int) -> x"), 'Lambda{Tuple{_TypeOf{x, int}}, x})
check(tree("x := 1"), 'Def{x, 1})
check(tree("f(x) := x"), 'Def{f, Lambda{Tuple{x}, x}})
check(tree("x = y"), 'Set{x, y})

# === Quotation ===
check(tree("'a"), 'Quote{a})
check(tree("'(a + 1)"), 'Quote{Apply{add, Tuple{a, 1}}})
check(tree("`F{!x}"), 'QuasiQuote{F{UnQuote{x}}})

# === Blocks and control ===
check(tree("{ a; b }"), 'Do{a, b})
check(tree("{\n a\n b\n}"), 'Do{a, b})
check(tree("{}"), 'Do{})
check(tree("if (a) { b }"), 'If{a, Do{b}, none})
check(tree("if (a) { b } else { c }"), 'If{a, Do{b}, Do{c}})
check(tree("if (a) { b }\nelse if (c) { d }"), 'If{a, Do{b}, If{c, Do{d}, none}})
check(tree("while (a) { b }"), 'While{a, Do{b}})
check(tree("handle { a } with (E{}, k) -> k(1)"), 'Handle{Do{a}, Lambda{Tuple{E{}, k}, Apply{k, Tuple{1}}}})
check(tree("if (a) b"), 'If{a, b, none})
check(tree("if (a) b else c"), 'If{a, b, c})
check(tree("if (a) x = 1 else x = 2"), 'If{a, Set{x, 1}, Set{x, 2}})
check(tree("if (a) b else if (c) d else e"), 'If{a, b, If{c, d, e}})
check(tree("if (a) if (b) c else d"), 'If{a, If{b, c, d}, none})
check(tree("if (a) if (b) c else d else e"), 'If{a, If{b, c, d}, e})
check(tree("if (a) { if (b) c } else d"), 'If{a, Do{If{b, c, none}}, d})
check(tree("if (a)\n  b\nelse\n  c"), 'If{a, b, c})
check(tree("if (a) b else c + 1"), 'If{a, b, Apply{add, Tuple{c, 1}}})
check(tree("while (a) b"), 'While{a, b})
check(tree("while (a) if (b) c else d"), 'While{a, If{b, c, d}})
check(tree("{ if (a) b; c }"), 'Do{If{a, b, none}, c})
check(tree("{ if (a) b\n c }"), 'Do{If{a, b, none}, c})
check(tree("{ while (a) b\n c }"), 'Do{While{a, b}, c})
check(tree("y = if (a) 1 else 2"), 'Set{y, If{a, 1, 2}})
check(head(tree("if a { b }")), 'SyntaxError)
check(head(tree("while a { b }")), 'SyntaxError)
check(tree("perform E{x}"), 'Perform{E{x}})

# === Cons ===
check(tree("x :: xs"), 'Cons{x, xs})
check(tree("1 :: 2 :: []"), 'Cons{1, Cons{2, Nil{}}})
check(tree("a + 1 :: b * 2"), 'Cons{Apply{add, Tuple{a, 1}}, Apply{mul, Tuple{b, 2}}})
check(tree("a :: b == c :: d"), 'Apply{eq, Tuple{Cons{a, b}, Cons{c, d}}})
check(tree("a :: b - 1"), 'Cons{a, Apply{sub, Tuple{b, 1}}})
check(tree("(a :: b) :: c"), 'Cons{Cons{a, b}, c})
check(tree("f(a :: b, c)"), 'Apply{f, Tuple{Cons{a, b}, c}})
check(tree("[a :: b]"), 'Cons{Cons{a, b}, Nil{}})
check(tree("c ? a :: b : d"), 'If{c, Cons{a, b}, d})
check(tree("(x :: xs) -> x"), 'Lambda{Tuple{Cons{x, xs}}, x})
check(tree("x :: xs -> x"), 'Lambda{Tuple{Cons{x, xs}}, x})
check(tree("(x :: y :: r, n) -> x"), 'Lambda{Tuple{Cons{x, Cons{y, r}}, n}, x})
check(tree("(x :: Nil{}) -> x | (x :: xs) -> xs"), 'Fusion{Lambda{Tuple{Cons{x, Nil{}}}, x}, Lambda{Tuple{Cons{x, xs}}, xs}})
check(tree("f(x :: xs) := x"), 'Def{f, Lambda{Tuple{Cons{x, xs}}, x}})
check(tree("xs ::= ident"), 'Apply{define_rule, Tuple{Quote{xs}, Quote{ident}}})

# === Lines and comments ===
check(tree("a\n-1"), 'a)
check(rest("a\n-1"), "-1")
check(tree("a -\n1"), 'Apply{sub, Tuple{a, 1}})
check(tree("a # comment\n+ 1"), 'Apply{add, Tuple{a, 1}})
check(tree("f\n(x)"), 'f)
check(rest("x := 1; y"), "y")
check(tree(" \n# only a comment\n"), 'Eof{})
check(head(tree("1 +")), 'SyntaxError)
check(rest("1 2"), "2")
check(head(tree("x := (1")), 'SyntaxError)
check(head(tree("x := )")), 'SyntaxError)
check(head(tree(")")), 'SyntaxError)
check(head(tree("\"abc")), 'SyntaxError)

# === Evaluation of the new syntax ===
fib := (0) -> 0 | (1) -> 1 | (n) -> fib(n - 1) + fib(n - 2)
check(fib(15), 610)
check({ a := 2; b := 3; a * b }, 6)
check(if (1 < 2) { "y" } else { "n" }, "y")
check(if (1 > 2) { "y" }, none)
n := 0
i := 0
while (i < 5) { i = i + 1; n = n + i }
check(n, 15)
last := (x :: Nil{}) -> x | (x :: xs) -> last(xs)
check(last(1 :: 2 :: 3 :: []), 3)
check(1 :: 2 :: [], [1, 2])
sum := (Nil{}) -> 0 | (x :: xs) -> x + sum(xs)
check(sum(1 :: 2 :: 3 :: []), 6)
count := 0
if (count == 0) count = 10 else count = 20
check(count, 10)
if (count == 0) count = 1 else if (count == 10) count = 2 else count = 3
check(count, 2)
# dangling else binds to the nearest if
dangle(a, b) := if (a) if (b) "ab" else "a-nb"
check(dangle(true, true), "ab")
check(dangle(true, false), "a-nb")
check(dangle(false, true), none)
check(dangle(false, false), none)
dangle2(a, b) := if (a) { if (b) "ab" } else "na"
check(dangle2(false, true), "na")
check(dangle2(true, false), none)
k := 0
total := 0
while (k < 4) { k = k + 1; total = total + k }
check(total, 10)
while (k > 0) if (k % 2 == 0) k = k - 1 else k = k - 1
check(k, 0)
check(handle { 1 + perform Ask{} } with (Ask{}, k) -> k(41), 42)
check((x -> y -> x - y)(10)(3), 7)
check(not 1 == 2, true)
check(1 == 1 and 2 == 3, false)
check(false or 3 > 2, true)
add3(a, b, c) := a + b + c
check(add3(1, 2, 3), 6)
len := (Nil{}) -> 0 | (Cons{_, xs}) -> 1 + len(xs)
check(len([1, 2, 3]), 3)
x := 5
check(`F{!x, x}, 'F{5, x})
check(Apply{add, Tuple{1, 2}}, 3)

# === match ===
check(tree("match x { A{a} -> a\n B{} -> 0 }"), 'Apply{Fusion{Lambda{Tuple{A{a}}, a}, Lambda{Tuple{B{}}, 0}}, Tuple{x}})
check(tree("match x { 1 -> 2 }"), 'Apply{Lambda{Tuple{1}, 2}, Tuple{x}})
check(tree("match f(x) + 1 { y -> y; _ -> 0 }"), 'Apply{Fusion{Lambda{Tuple{y}, y}, Lambda{Tuple{_}, 0}}, Tuple{Apply{add, Tuple{Apply{f, Tuple{x}}, 1}}}})
check(tree("match l {\n  x :: xs -> x\n  Nil{} -> 0\n}"), 'Apply{Fusion{Lambda{Tuple{Cons{x, xs}}, x}, Lambda{Tuple{Nil{}}, 0}}, Tuple{l}})
check(tree("match x {\n  -1 -> 1\n  (a, b) -> a\n}"), 'Apply{Fusion{Lambda{Tuple{-1}, 1}, Lambda{Tuple{Tuple{a, b}}, a}}, Tuple{x}})
check(head(tree("match x { }")), 'SyntaxError)
check(head(tree("match x A{} -> 1")), 'SyntaxError)
check(head(tree("match x { a b }")), 'SyntaxError)

shape(n) := match n {
    n if n < 0 -> "neg"
    0 -> "zero"
    n if n < 10 and n % 2 == 1 -> "small odd"
    n if n < 10 -> "small even"
    _ -> "big"
}
check(shape(-5), "neg")
check(shape(0), "zero")
check(shape(7), "small odd")
check(shape(8), "small even")
check(shape(70), "big")
# a guard that is false goes on to the arms after it, with the same value
check(match 5 { n if n > 10 -> "a"; n if n > 3 -> "b"; _ -> "c" }, "b")
check(match 5 { 5 if false -> "a"; 5 -> "b" }, "b")
tree_eval := (e) -> match e {
    Num{n} -> n
    Neg{e} -> 0 - tree_eval(e)
    Add{a, b} -> tree_eval(a) + tree_eval(b)
    Mul{a, b} -> tree_eval(a) * tree_eval(b)
}
check(tree_eval(Add{Num{2}, Mul{Num{3}, Neg{Num{4}}}}), -10)
check(match [1, 2] { x :: xs -> x; Nil{} -> 0 }, 1)
check(match 'a { 'a -> 1; 'b -> 2 }, 1)
k := 3
check(match k { 3 -> match k + 1 { n if n > 3 -> "inner"; _ -> "no" }; _ -> "outer" }, "inner")
# matching nested guards: each match has its own variables
nest(a, b) := match a { x if x > 0 -> match b { y if y > 0 -> x + y; _ -> x }; _ -> 0 }
check(nest(1, 2), 3)
check(nest(1, -2), 1)
check(nest(-1, 2), 0)
# the scrutinee is evaluated once
calls := 0
once() := { calls = calls + 1; 5 }
check(match once() { n if n > 9 -> 1; n if n > 4 -> 2; _ -> 3 }, 2)
check(calls, 1)
# an arm may change variables of the outside
acc := 0
match 4 { n if n > 3 -> acc = acc + n; _ -> acc = 100 }
check(acc, 4)

# === String interpolation ===
check(tree("\"a\\(x)b\""), 'Apply{strcat, Tuple{Apply{strcat, Tuple{"a", Apply{to_text, Tuple{x}}}}, "b"}})
check(tree("\"\\(x)\""), 'Apply{to_text, Tuple{x}})
check(tree("\"\\(x)\\(y)\""), 'Apply{strcat, Tuple{Apply{to_text, Tuple{x}}, Apply{to_text, Tuple{y}}}})
check(tree("\"\\(1 + 2)\""), 'Apply{to_text, Tuple{Apply{add, Tuple{1, 2}}}})
check(tree("\"a\\(f(\"q\"))\""), 'Apply{strcat, Tuple{"a", Apply{to_text, Tuple{Apply{f, Tuple{"q"}}}}}})
check(tree("\"\\\\(x)\""), "\\(x)")
check(tree("\"a\\tb\""), "a\tb")
check(tree("\"\\\"\\(x)\""), 'Apply{strcat, Tuple{"\"", Apply{to_text, Tuple{x}}}})
check(head(tree("\"a\\(x\"")), 'SyntaxError)
check(head(tree("\"a\\(\"")), 'SyntaxError)
check(head(tree("\"a\\(x)")), 'SyntaxError)
check(rest("\"\\(x)\" y"), "y")

n := 7
word := "w"
check("n=\(n)", "n=7")
check("\(n)", "7")
check("\(n):\(n + 1):\(word)", "7:8:w")
check("[\(word)] \(word)\(word)", "[w] ww")
check("neg \(0 - 5)!", "neg -5!")
check("zero \(0)", "zero 0")
check("tab\there \(n)\n", "tab\there 7\n")
check("\\(n) is not \(n)", "\\(n) is not 7")
wrap(s) := "<\(s)>"
check("a\(wrap("x"))b", "a<x>b")
check("nest \(wrap("in \(n)"))", "nest <in 7>")
check("\(if (n > 3) "big" else "small")", "big")
use("pretty")
check("list \([1, 2])", "list [1, 2]")
check("sym \('a) tree \(F{1, "s"})", "sym a tree F{1, \"s\"}")

# === Records ===
check(tree("record Tok(kind, value, pos)"), 'Apply{record_declare, Tuple{Quote{Tok}, Quote{Tuple{kind, value, pos}}}})
check(tree("record R()"), 'Apply{record_declare, Tuple{Quote{R}, Quote{Tuple{}}}})
check(tree("t.kind"), 'Apply{record_get, Tuple{t, Quote{kind}}})
check(tree("t.a.b"), 'Apply{record_get, Tuple{Apply{record_get, Tuple{t, Quote{a}}}, Quote{b}}})
check(tree("f(x).y"), 'Apply{record_get, Tuple{Apply{f, Tuple{x}}, Quote{y}}})
check(tree("t.f(1)"), 'Apply{Apply{record_get, Tuple{t, Quote{f}}}, Tuple{1}})
check(tree("a.b + c.d * 2"), 'Apply{add, Tuple{Apply{record_get, Tuple{a, Quote{b}}}, Apply{mul, Tuple{Apply{record_get, Tuple{c, Quote{d}}}, 2}}}})
check(tree("a.b == 'x"), 'Apply{eq, Tuple{Apply{record_get, Tuple{a, Quote{b}}}, Quote{x}}})
check(tree("x := t.v"), 'Def{x, Apply{record_get, Tuple{t, Quote{v}}}})
check(tree("F{a.b}"), 'F{Apply{record_get, Tuple{a, Quote{b}}}})
check(head(tree("t.")), 'SyntaxError)
check(head(tree("t.1")), 'SyntaxError)
check(head(tree("record Tok")), 'SyntaxError)
check(head(tree("record Tok(1)")), 'SyntaxError)

record Tok(kind, value, pos)
record Node(op, left, right)
record Rev(c, b, a)
record Fwd(a, b, c)
tk := Tok{'id, "abc", 3}
check(tk.kind, 'id)
check(tk.value, "abc")
check(tk.pos + 1, 4)
nd := Node{"+", Node{"*", 1, 2}, 3}
check(nd.op, "+")
check(nd.left.op, "*")
check(nd.left.right, 2)
check(nd.right, 3)
# the field is found by the head of the value
check(Rev{1, 2, 3}.a, 3)
check(Fwd{1, 2, 3}.a, 1)
getv(t) := t.value
check(getv(tk), "abc")
check(getv(Tok{'num, 7, 0}), 7)
check((match tk { Tok{k, v, p} -> k }), 'id)
record Tok(value, kind)
check(Tok{1, 2}.kind, 2)
record Tok(kind, value, pos)
check(tk.kind, 'id)
check(record_get(Tok{1, 2, 3}, 'pos), 3)

# === for, return and break ===
rh := 'Lambda{Tuple{Return{v}, k}, v}
bh := 'Lambda{Tuple{Break{}, k}, none}
check(tree("for (x in xs) f(x)"), 'Apply{peg_for, Tuple{xs, Lambda{Tuple{x}, Apply{f, Tuple{x}}}}})
check(tree("for (Tuple{a, b} in ps) a"), 'Apply{peg_for, Tuple{ps, Lambda{Tuple{Tuple{a, b}}, a}}})
check(tree("for (x in f(y)) { z }"), 'Apply{peg_for, Tuple{Apply{f, Tuple{y}}, Lambda{Tuple{x}, Do{z}}}})
check(tree("return 1"), 'Perform{Return{1}})
check(tree("return a + 1"), 'Perform{Return{Apply{add, Tuple{a, 1}}}})
check(tree("return"), 'Perform{Return{none}})
check(tree("{ return\n 1 }"), 'Do{Perform{Return{none}}, 1})
check(tree("{ return }"), 'Do{Perform{Return{none}}})
check(tree("if (a) return 1 else 2"), 'If{a, Perform{Return{1}}, 2})
check(tree("break"), 'Perform{Break{}})
check(tree("f(x) := { return x }"), `Def{f, Lambda{Tuple{x}, Handle{Do{Perform{Return{x}}}, !rh}}})
check(tree("f(x) := x"), 'Def{f, Lambda{Tuple{x}, x}})
check(tree("x -> return x"), `Lambda{Tuple{x}, Handle{Perform{Return{x}}, !rh}})
check(tree("while (a) { break }"), `Handle{While{a, Do{Perform{Break{}}}}, !bh})
check(tree("while (a) b"), 'While{a, b})
check(tree("for (x in xs) break"), `Handle{Apply{peg_for, Tuple{xs, Lambda{Tuple{x}, Perform{Break{}}}}}, !bh})
# a loop or a function handles only its own return and break
check(tree("while (a) { while (b) break }"), `While{a, Do{Handle{While{b, Perform{Break{}}}, !bh}}})
check(tree("f() := { g() := return 1; 2 }"), `Def{f, Lambda{Tuple{}, Do{Def{g, Lambda{Tuple{}, Handle{Perform{Return{1}}, !rh}}}, 2}}})
check(tree("f() := for (x in xs) return x"), `Def{f, Lambda{Tuple{}, Handle{Apply{peg_for, Tuple{xs, Lambda{Tuple{x}, Perform{Return{x}}}}}, !rh}}})
check(tree("f() := match x { 1 -> return 2; _ -> 3 }"), `Def{f, Lambda{Tuple{}, Handle{Apply{Fusion{Lambda{Tuple{1}, Perform{Return{2}}}, Lambda{Tuple{_}, 3}}, Tuple{x}}, !rh}}})
check(tree("f() := '(return 1)"), 'Def{f, Lambda{Tuple{}, Quote{Perform{Return{1}}}}})
check(head(tree("for x in xs f(x)")), 'SyntaxError)
check(head(tree("for (x in xs)")), 'SyntaxError)
check(head(tree("for (x xs) x")), 'SyntaxError)

use("list")
use("vector")
total := 0
for (x in [1, 2, 3]) total = total + x
check(total, 6)
for (x in []) total = 100
check(total, 6)
vv := vec_new()
vec_push(vv, 10)
vec_push(vv, 20)
for (x in vv) total = total + x
check(total, 36)
for (Tuple{a, b} in [Tuple{1, 2}, Tuple{3, 4}]) total = total + a * b
check(total, 50)
check((for (x in [1]) x), none)
find_first(p, xs) := {
    for (x in xs) {
        if (p(x)) return x
    }
    none
}
check(find_first(x -> x > 2, [1, 2, 3, 4]), 3)
check(find_first(x -> x > 9, [1, 2]), none)
n := 0
while (true) {
    n = n + 1
    if (n == 5) break
}
check(n, 5)
s := 0
for (x in range(1, 100)) {
    if (x > 4) break
    s = s + x
}
check(s, 10)
# break leaves only the inner loop
pairs := 0
for (i in range(0, 3)) {
    for (j in range(0, 3)) {
        if (j == 1) break
        pairs = pairs + 1
    }
}
check(pairs, 3)
# return leaves the function, from inside loops
first_pair(xs) := {
    for (a in xs) {
        for (b in xs) {
            if (a < b) return Tuple{a, b}
        }
    }
    none
}
check(first_pair([3, 1, 2]), Tuple{1, 3})
check(first_pair([1]), none)
count_to(m) := {
    i := 0
    while (true) {
        i = i + 1
        if (i >= m) return i * 10
    }
}
check(count_to(4), 40)
bare() := { return; 1 }
check(bare(), none)
outer() := {
    inner() := return 1
    inner() + 10
}
check(outer(), 11)
by_match(x) := match x { 0 -> return "zero"; _ -> "other" }
check(by_match(0), "zero")
check(by_match(1), "other")
check(map(x -> { if (x > 1) return x * 2; x }, [1, 2, 3]), [1, 4, 6])
ask() := {
    r := perform Ask{}
    if (r > 0) return r * 2
    0
}
check(handle ask() with (Ask{}, k) -> k(21), 42)
check(handle ask() with (Ask{}, k) -> k(-1), 0)
# recursion keeps one Return handler for each call
fact(m) := { if (m <= 1) return 1; m * fact(m - 1) }
check(fact(10), 3628800)
# a loop variable is a pattern variable of the body only
x := 7
for (x in [1, 2]) total = total + x
check(x, 7)

# === fun ===
check(tree("{ fun f(x) x }"), 'Do{Def{f, none}, Set{f, Lambda{Tuple{x}, x}}})
check(tree("{ a := 1; fun f() { a }; f() }"), 'Do{Def{f, none}, Def{a, 1}, Set{f, Lambda{Tuple{}, Do{a}}}, Apply{f, Tuple{}}})
check(tree("{ fun f(x, y) x + y\n fun g() f(1, 2)\n g() }"), 'Do{Def{f, none}, Def{g, none}, Set{f, Lambda{Tuple{x, y}, Apply{add, Tuple{x, y}}}}, Set{g, Lambda{Tuple{}, Apply{f, Tuple{1, 2}}}}, Apply{g, Tuple{}}})
check(tree("{ fun f(x :: xs) x }"), 'Do{Def{f, none}, Set{f, Lambda{Tuple{Cons{x, xs}}, x}}})
check(tree("{ fun f() { return 1 } }"), `Do{Def{f, none}, Set{f, Lambda{Tuple{}, Handle{Do{Perform{Return{1}}}, !rh}}}})
check(tree("{ a; b }"), 'Do{a, b})
check(head(tree("fun f(x) x")), 'SyntaxError)
check(head(tree("{ fun f x }")), 'SyntaxError)
check(head(tree("{ fun (x) x }")), 'SyntaxError)

check({
    fun even(n) n == 0 ? true : odd(n - 1)
    fun odd(n) n == 0 ? false : even(n - 1)
    Tuple{even(10), odd(10), even(7)}
}, Tuple{true, false, false})
counter() := {
    c := 0
    fun inc() {
        c = c + 1
        c
    }
    inc()
    inc()
}
check(counter(), 2)
# a fun sees the variables declared before it, and funs call each other
fact_sum(n) := {
    base := 1
    fun fact(m) m <= 1 ? base : m * fact(m - 1)
    fun sum_to(m) m == 0 ? 0 : fact(m) + sum_to(m - 1)
    sum_to(n)
}
check(fact_sum(4), 33)
find_in(xs, y) := {
    fun go(l) {
        for (x in l) {
            if (x == y) return true
        }
        false
    }
    go(xs)
}
check(find_in([1, 2, 3], 2), true)
check(find_in([1, 2, 3], 5), false)
# a recursive descent parser: sum := num ("+" num)* with parentheses
parse_sum(toks) := {
    pos := 0
    fun peek() pos < length(toks) ? nth(toks, pos) : "eof"
    fun atom() {
        t := peek()
        pos = pos + 1
        if (t == "(") {
            v := sum()
            pos = pos + 1
            v
        } else t
    }
    fun sum() {
        v := atom()
        while (peek() == "+") {
            pos = pos + 1
            v = v + atom()
        }
        v
    }
    sum()
}
check(parse_sum([1, "+", "(", 2, "+", 3, ")", "+", 4]), 10)

# === Packrat parser: grammar declarations ===
num ::= integer
check(arg(peg_parse('num, "12 rest"), 0), 12)
check(arg(peg_parse('num, "12 rest"), 1), "rest")

# direct left recursion is left associative
diff ::= a:diff "-" b:num { a - b } | num
check(arg(peg_parse('diff, "10 - 3 - 2"), 0), 5)

# repetition, option, lookahead and keywords
nums ::= "[" xs:num* "]" { xs }
check(arg(peg_parse('nums, "[1 2 3]"), 0), 'Tuple{1, 2, 3})
check(arg(peg_parse('nums, "[]"), 0), 'Tuple{})
some ::= xs:num+ { xs }
check(arg(peg_parse('some, "1 2"), 0), 'Tuple{1, 2})
check(head(arg(peg_parse('some, "x"), 0)), 'SyntaxError)
opt ::= a:num b:("," num)? { Tuple{a, b} }
check(arg(peg_parse('opt, "1, 2"), 0), 'Tuple{1, Tuple{Tuple{",", 2}}})
check(arg(peg_parse('opt, "1"), 0), 'Tuple{1, Tuple{}})
notx ::= !"x" a:ident { a }
check(arg(peg_parse('notx, "y"), 0), 'y)
check(head(arg(peg_parse('notx, "x"), 0)), 'SyntaxError)
andx ::= &"x" a:ident { a }
check(arg(peg_parse('andx, "x"), 0), 'x)
kw ::= 'go a:num { a }
check(arg(peg_parse('kw, "go 1"), 0), 1)
check(head(arg(peg_parse('kw, "gopher 1"), 0)), 'SyntaxError)
pair ::= a:num "," b:num { Tuple{a, b} }
       | a:num { Tuple{a} }
check(arg(peg_parse('pair, "1, 2"), 0), 'Tuple{1, 2})
check(arg(peg_parse('pair, "1"), 0), 'Tuple{1})

# ... is the previous definition
color ::= 'red { 1 }
color ::= 'blue { 2 } | ...
check(arg(peg_parse('color, "red"), 0), 1)
check(arg(peg_parse('color, "blue"), 0), 2)

# extend the syntax of planck
primary ::= 'unless c:expr a:block 'else b:block { `If{!c, !b, !a} } | ...
check(unless 1 > 2 { "a" } else { "b" }, "a")
check(tree("unless c { a } else { b }"), 'If{c, Do{b}, Do{a}})

put("Tests passed "); print(passed); put("/"); println(passed + failed)
if (failed > 0) exit(1)
