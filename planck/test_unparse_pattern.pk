# tests for planck/lib/unparse.pk: patterns
# Copyright (C) 2026 nineties

use("unparse")

passed := 0
failed := 0
trips := 0

check(actual, expected) := if (actual == expected) {
    passed = passed + 1
} else {
    failed = failed + 1
    put("Test failed: expected "); print(expected)
    put(" but got "); println(actual)
}

tree(s) := arg(peg_parse('toplevel, s), 0)

# round trip: the text of a tree parses to the tree, and printing again gives the same text
trip(t) := {
    out := unparse(t)
    t2 := tree(out)
    trips = trips + 1
    check(t2, t)
    check(unparse(t2), out)
}
rt(s) := trip(tree(s))

# === Patterns written as expressions ===
check(unparse(tree("a@int + b@int -> a + b")), "a @ int + b @ int -> a + b")
check(unparse(tree("(a + b) * c -> a")), "(a + b) * c -> a")
check(unparse(tree("((a, b)) -> a")), "Tuple{a, b} -> a")
check(unparse(tree("Apply{'_add, Tuple{a, b}} -> a")), "a + b -> a")
check(unparse(tree("Apply{f, Tuple{x}} -> f")), "Apply{f, Tuple{x}} -> f")
check(unparse(tree("f(x) := match x { a + 0 -> a | x * y if x == y -> x | _ -> 0 }")),
      "f(x) := match x {\n    a + 0 -> a\n  | x * y if x == y -> x\n  | _ -> 0\n}")
rt("a@int + b@int -> a + b")
rt("a * b + c -> a")
rt("(a + b) * c -> a")
rt("a - (b - c) -> a")
rt("-a -> a")
rt("-1 -> a")
rt("f(x, 1) -> x")
rt("f() -> 0")
rt("[a, b + 1] -> a")
rt("a + 1 :: b -> a")
rt("(a :: b) + 1 -> a")
rt("a < b + 1 -> a")
rt("(not a, a and b, a or b) -> a")
rt("(a or b) and c -> a")
rt("'(x + 1) -> 0")
rt("F{a + 1, g(b)} -> a")
rt("(a + b, c) -> a")
rt("f(a + b) := a")
rt("Apply{f, Tuple{x}} -> f")
rt("match e { a + 0 -> a | x * y if x == y -> x | _ -> e }")
rt("for (a * b in xs) f(a)")

# === match and guards ===
check(unparse(tree("match x { 0 -> if (c) 1 else 2 | n -> n }")), "match x {\n    0 -> if (c) 1 else 2\n  | n -> n\n}")
check(unparse(tree("match x { ((a, b)) -> a | (a, b) -> b }")), "match x {\n    Tuple{a, b} -> a\n  | (a, b) -> b\n}")
check(unparse(tree("match x { 0 -> match y { 1 -> a | _ -> b } | _ -> c }")),
      "match x {\n    0 -> match y {\n        1 -> a\n      | _ -> b\n    }\n  | _ -> c\n}")
check(unparse(tree("f := n if n > 0 -> 1 | n if n < 0 -> -1 | _ -> 0")), "f := n if n > 0 -> 1 | n if n < 0 -> -1 | _ -> 0")
check(unparse(tree("f := (a, b) if a > b -> a | (a, b) -> b")), "f := (a, b) if a > b -> a | (a, b) -> b")
check(unparse(tree("match x { 0 -> return 1 | _ -> 2 }")), "match x {\n    0 -> return 1\n  | _ -> 2\n}")
rt("match x { 0 -> if (c) 1 else 2 | n -> n }")
rt("match x { 0 -> if (c) 1 | n if n > 0 -> if (d) 2 else 3 | _ -> 4 }")
rt("match x {\n    1 -> a\n  | 2 -> b\n}")
rt("match x { f }")
rt("match x { n if n > 0 -> 1 }")
check(unparse(tree("match x { n if n > 0 -> 1 }")), "match x {\n    n if n > 0 -> 1\n}")
rt("match x { inc | _ -> 0 }")
rt("match x { ((a, b)) -> a | _ -> 0 }")
rt("f(x) := match x { 0 -> return 1 | n if n > 0 -> return 2 | _ -> 3 }")
rt("f(x) := { for (y in x) match y { n if n > 0 -> return n | _ -> none }; 0 }")
rt("f := n if n > 0 -> 1 | _ -> 0")
rt("f := n if n > 0 -> return 1 | _ -> 0")
rt("f := n if n > 0 -> 1")
rt("(n if n > 0 -> 1) | (_ -> 0)")
rt("f := (x) -> if (x) 1 else 2 | (y) -> 3")
rt("if (c) (f | g) else h")
rt("match '(x * y) { a * b if a == b -> a | a @ int + b -> b | _ -> 0 }")
# t[...] with a guard after a function without one
rt("t[P{1, 2} -> 'x | P{a, b} if a == b -> a]")
check(unparse(tree("t[P{1, 2} -> 'x | P{a, b} if a == b -> a]")), "t[P{1, 2} -> 'x | P{a, b} if a == b -> a]")

put("Tests passed "); print(passed); put("/"); println(passed + failed)
put("Round trips "); println(trips)
if (failed > 0) exit(1)
