Defun{check, Lambda{Tuple{a, b}, If{Apply{equal, Tuple{a, b}}, Do{}, Do{Apply{os_put, Tuple{"undef: mismatch\n"}}, Apply{os_exit, Tuple{1}}}}}}

Defun{f, Lambda{Tuple{0}, 1}}
Defun{f, Lambda{Tuple{1}, 2}}
Apply{check, Tuple{Apply{f, Tuple{1}}, 2}}
Undef{f}
Defun{f, Lambda{Tuple{x}, 3}}
Apply{check, Tuple{Apply{f, Tuple{0}}, 3}}
Apply{check, Tuple{Apply{f, Tuple{1}}, 3}}

Def{g, 5}
Def{h, Lambda{Tuple{}, g}}
Undef{g}
Apply{check, Tuple{Apply{h, Tuple{}}, 5}}
Def{g, 6}
Apply{check, Tuple{g, 6}}
Apply{check, Tuple{Apply{h, Tuple{}}, 5}}

Def{e, Apply{env_new, Tuple{}}}
Apply{eval, Tuple{Quote{Def{k, 1}}, e}}
Apply{eval, Tuple{Quote{Undef{k}}, e}}
Apply{eval, Tuple{Quote{Def{k, 2}}, e}}
Apply{check, Tuple{Apply{eval, Tuple{Quote{k}, e}}, 2}}
Apply{eval, Tuple{Quote{Undef{g}}, Apply{env_global, Tuple{}}}}
Apply{eval, Tuple{Quote{Def{g, 7}}, Apply{env_global, Tuple{}}}}
Apply{check, Tuple{g, 7}}

Def{old_add, int_add}
Undef{int_add}
Def{int_add, Lambda{Tuple{a, b}, 42}}
Apply{check, Tuple{Apply{int_add, Tuple{1, 2}}, 42}}
Undef{int_add}
Def{int_add, old_add}
Apply{check, Tuple{Apply{int_add, Tuple{1, 2}}, 3}}
Apply{os_put, Tuple{"undef: ok\n"}}
