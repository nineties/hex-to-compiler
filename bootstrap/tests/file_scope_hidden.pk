Defun{check, Lambda{Tuple{a, b}, If{Apply{equal, Tuple{a, b}}, Do{}, Do{Apply{os_put, Tuple{"file_scope_hidden: mismatch\n"}}, Apply{os_exit, Tuple{1}}}}}}

Def{r, Apply{mexpr_arg, Tuple{Apply{os_run, Tuple{"./planck0", Tuple{"bootstrap/tests/file_scope_hidden_case.pk"}, "", ""}}, 0}}}
Apply{check, Tuple{Apply{array_get, Tuple{r, 0}}, 1}}
Apply{check, Tuple{Apply{array_get, Tuple{r, 2}}, "undefined variable: hidden\n"}}
Apply{os_put, Tuple{"file_scope_hidden: ok\n"}}
