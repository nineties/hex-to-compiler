Defun{check, Lambda{Tuple{a, b}, If{Apply{equal, Tuple{a, b}}, Do{}, Do{Apply{os_put, Tuple{"nul_free: mismatch\n"}}, Apply{os_exit, Tuple{1}}}}}}

Def{base, "/tmp/planck0_nul_free.txt"}
Def{p, Apply{str_cat, Tuple{base, "XYZ"}}}
Def{sub, Apply{str_sub, Tuple{p, 0, Apply{str_len, Tuple{base}}}}}
Apply{check, Tuple{Apply{os_write_file, Tuple{sub, "hi"}}, Ok{Do{}}}}
Apply{check, Tuple{Apply{os_read_file, Tuple{sub}}, Ok{"hi"}}}
Apply{check, Tuple{Apply{os_read_file, Tuple{base}}, Ok{"hi"}}}
Apply{check, Tuple{Apply{os_chmod, Tuple{sub, 0o600}}, Ok{Do{}}}}

Def{r1, Apply{parse, Tuple{Apply{str_sub, Tuple{"abc123", 0, 3}}}}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{r1, 0}}, Quote{abc}}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{r1, 1}}, ""}}
Def{r2, Apply{parse, Tuple{Apply{str_sub, Tuple{"12345", 0, 2}}}}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{r2, 0}}, 12}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{r2, 1}}, ""}}
Def{r3, Apply{parse, Tuple{Apply{str_sub, Tuple{"\"abc\"", 0, 4}}}}}
Apply{check, Tuple{Apply{mexpr_head, Tuple{Apply{mexpr_arg, Tuple{r3, 0}}}}, Quote{SyntaxError}}}
Def{r4, Apply{parse, Tuple{Apply{str_sub, Tuple{"Foo{1}Bar{2}", 0, 11}}}}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{r4, 0}}, Quote{Foo{1}}}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{r4, 1}}, "Bar{2"}}
Apply{check, Tuple{Apply{mexpr_head, Tuple{Apply{mexpr_arg, Tuple{Apply{parse, Tuple{Apply{mexpr_arg, Tuple{r4, 1}}}}, 0}}}}, Quote{SyntaxError}}}

Apply{check, Tuple{Apply{str_to_int, Tuple{Apply{str_sub, Tuple{"0x1", 0, 1}}}}, 0}}
Apply{check, Tuple{Apply{str_to_int, Tuple{Apply{str_sub, Tuple{"123", 1, 2}}}}, 2}}
Apply{check, Tuple{Apply{sym_intern, Tuple{Apply{str_sub, Tuple{"abcdef", 0, 3}}}}, Quote{abc}}}
Apply{check, Tuple{Apply{sym_intern, Tuple{Apply{str_sub, Tuple{"abcdef", 3, 6}}}}, Quote{def}}}
Apply{check, Tuple{Apply{str_cat, Tuple{Apply{str_sub, Tuple{"abcdef", 1, 3}}, Apply{str_chr, Tuple{100}}}}, "bcd"}}
Apply{check, Tuple{Apply{str_sub, Tuple{"abc", 3, 3}}, ""}}
Apply{os_put, Tuple{"nul_free: ok\n"}}
