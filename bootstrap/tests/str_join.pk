Defun{check, Lambda{Tuple{a, b}, If{Apply{equal, Tuple{a, b}}, Do{}, Do{Apply{os_put, Tuple{"str_join: mismatch\n"}}, Apply{os_exit, Tuple{1}}}}}}

Def{a, Apply{array_new, Tuple{3}}}
Apply{array_set, Tuple{a, 0, "ab"}}
Apply{array_set, Tuple{a, 1, ""}}
Apply{array_set, Tuple{a, 2, Apply{str_sub, Tuple{"xcdz", 1, 3}}}}
Apply{check, Tuple{Apply{str_join, Tuple{a}}, "abcd"}}
Apply{check, Tuple{Apply{str_join, Tuple{Apply{array_new, Tuple{0}}}}, ""}}
Apply{check, Tuple{Apply{str_join, Tuple{Tuple{"ab", "", "cd"}}}, "abcd"}}
Apply{check, Tuple{Apply{str_join, Tuple{Tuple{}}}, ""}}
Apply{check, Tuple{Apply{str_find, Tuple{"abcabc", "bc", 0}}, 1}}
Apply{check, Tuple{Apply{str_find, Tuple{"abcabc", "bc", 2}}, 4}}
Apply{check, Tuple{Apply{str_find, Tuple{"abcabc", "bd", 0}}, -1}}
Apply{check, Tuple{Apply{str_find, Tuple{"abc", "", 2}}, 2}}
Apply{check, Tuple{Apply{str_find, Tuple{"abc", "c", 3}}, -1}}
Apply{check, Tuple{Apply{str_find, Tuple{Apply{str_sub, Tuple{"xabcx", 1, 4}}, "c", 0}}, 2}}
Apply{check, Tuple{Apply{str_cmp, Tuple{"abc", "abd"}}, -1}}
Apply{check, Tuple{Apply{str_cmp, Tuple{"abc", "abc"}}, 0}}
Apply{check, Tuple{Apply{str_cmp, Tuple{"b", "abc"}}, 1}}
Apply{check, Tuple{Apply{str_cmp, Tuple{"ab", "abc"}}, -1}}
Apply{check, Tuple{Apply{str_cmp, Tuple{"abc", "ab"}}, 1}}
Apply{check, Tuple{Apply{str_cmp, Tuple{"", ""}}, 0}}
Def{ma, Apply{mexpr_args, Tuple{Quote{Foo{1, "x", 3}}}}}
Apply{check, Tuple{Apply{array_len, Tuple{ma}}, 3}}
Apply{check, Tuple{Apply{array_get, Tuple{ma, 1}}, "x"}}
Apply{check, Tuple{Apply{mexpr_new, Tuple{Quote{Foo}, ma}}, Quote{Foo{1, "x", 3}}}}
Apply{check, Tuple{Apply{array_len, Tuple{Apply{mexpr_args, Tuple{Quote{Foo{}}}}}}, 0}}
Def{big, Apply{array_new, Tuple{300}}}
Apply{array_set, Tuple{big, 299, "last"}}
Def{bm, Apply{mexpr_new, Tuple{Quote{Foo}, big}}}
Apply{check, Tuple{Apply{mexpr_arity, Tuple{bm}}, 300}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{bm, 299}}, "last"}}
Apply{check, Tuple{Apply{array_len, Tuple{Apply{mexpr_args, Tuple{bm}}}}, 300}}
Def{c1, "1,"}
Def{c2, Apply{str_cat, Tuple{c1, c1}}}
Def{c3, Apply{str_cat, Tuple{c2, c2}}}
Def{c4, Apply{str_cat, Tuple{c3, c3}}}
Def{c5, Apply{str_cat, Tuple{c4, c4}}}
Def{c6, Apply{str_cat, Tuple{c5, c5}}}
Def{c7, Apply{str_cat, Tuple{c6, c6}}}
Def{c8, Apply{str_cat, Tuple{c7, c7}}}
Def{pm, Apply{mexpr_arg, Tuple{Apply{parse, Tuple{Apply{str_cat, Tuple{"Foo{", Apply{str_cat, Tuple{c8, "1}"}}}}}}, 0}}}
Apply{check, Tuple{Apply{mexpr_arity, Tuple{pm}}, 129}}
Apply{os_put, Tuple{"str_join: ok\n"}}
