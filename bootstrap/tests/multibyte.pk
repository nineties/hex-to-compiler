Defun{check, Lambda{Tuple{a, b}, If{Apply{equal, Tuple{a, b}}, Do{}, Do{Apply{os_put, Tuple{"multibyte: mismatch\n"}}, Apply{os_exit, Tuple{1}}}}}}

Def{lit, "/tmp/planck0_mb_lit.pk"}
Def{rd, "/tmp/planck0_mb_read.pk"}
Def{msg, ": not implemented for a string with multibyte characters\n"}
Def{bytes, Apply{packedarray_new_u8, Tuple{4}}}
Apply{packedarray_set, Tuple{bytes, 0, 34}}
Apply{packedarray_set, Tuple{bytes, 1, 195}}
Apply{packedarray_set, Tuple{bytes, 2, 169}}
Apply{packedarray_set, Tuple{bytes, 3, 34}}
Apply{check, Tuple{Apply{os_write_bytes, Tuple{lit, bytes}}, Ok{Do{}}}}
Apply{check, Tuple{Apply{os_write_file, Tuple{rd, "Apply{os_read_file, Tuple{\"/tmp/planck0_mb_lit.pk\"}}\n"}}, Ok{Do{}}}}

Defun{run_child, Lambda{Tuple{path}, Do{
    Def{args, Apply{array_new, Tuple{1}}},
    Apply{array_set, Tuple{args, 0, path}},
    Apply{mexpr_arg, Tuple{Apply{os_run, Tuple{"./planck0", args, "", ""}}, 0}}
}}}

Def{v1, Apply{run_child, Tuple{lit}}}
Apply{check, Tuple{Apply{array_get, Tuple{v1, 0}}, 1}}
Apply{check, Tuple{Apply{array_get, Tuple{v1, 2}}, Apply{str_cat, Tuple{lit, msg}}}}
Def{v2, Apply{run_child, Tuple{rd}}}
Apply{check, Tuple{Apply{array_get, Tuple{v2, 0}}, 1}}
Apply{check, Tuple{Apply{array_get, Tuple{v2, 2}}, Apply{str_cat, Tuple{"os_read_file", msg}}}}
Apply{check, Tuple{Apply{str_len, Tuple{"abc"}}, 3}}
Apply{os_put, Tuple{"multibyte: ok\n"}}
