Defun{check, Lambda{Tuple{a, b}, If{Apply{equal, Tuple{a, b}}, Do{}, Do{Apply{os_put, Tuple{"gc_scope: mismatch\n"}}, Apply{os_exit, Tuple{1}}}}}}

Def{s, Apply{scope_new, Tuple{}}}
Apply{scope_eval, Tuple{s, Quote{Def{arr, Apply{array_new, Tuple{3}}}}}}
Apply{scope_eval, Tuple{s, Quote{Apply{array_set, Tuple{arr, 1, "kept"}}}}}
Apply{scope_eval, Tuple{s, Quote{Defun{shown, Lambda{Tuple{0}, "zero"}}}}}
Apply{scope_eval, Tuple{s, Quote{Defun{shown, Lambda{Tuple{n}, Apply{array_get, Tuple{arr, 1}}}}}}}
Apply{scope_eval, Tuple{s, Quote{Defun{hidden, Lambda{Tuple{n}, "private"}}}}}
Apply{scope_export, Tuple{s, Quote{shown}}}
Def{before, Apply{gc_count, Tuple{}}}
Def{junk, 0}
While{Apply{int_lt, Tuple{Apply{gc_count, Tuple{}}, Apply{int_add, Tuple{before, 3}}}}, Set{junk, Apply{array_new, Tuple{20000}}}}
Apply{os_put, Tuple{"gc_scope: gc runs after: "}}
Apply{os_put, Tuple{Apply{int_to_str, Tuple{Apply{int_sub, Tuple{Apply{gc_count, Tuple{}}, before}}, 10}}}}
Apply{os_put, Tuple{"\n"}}
Apply{check, Tuple{Apply{scope_eval, Tuple{s, Quote{Apply{shown, Tuple{0}}}}}, "zero"}}
Apply{check, Tuple{Apply{scope_eval, Tuple{s, Quote{Apply{shown, Tuple{1}}}}}, "kept"}}
Apply{check, Tuple{Apply{shown, Tuple{1}}, "kept"}}
Apply{check, Tuple{Apply{scope_eval, Tuple{s, Quote{Apply{hidden, Tuple{1}}}}}, "private"}}
Apply{check, Tuple{Apply{scope_eval, Tuple{s, Quote{Apply{eval, Tuple{Quote{Apply{hidden, Tuple{1}}}}}}}}, "private"}}
Apply{check, Tuple{Apply{scope_eval, Tuple{s, Quote{Apply{eval, Tuple{Quote{Apply{array_get, Tuple{arr, 1}}}}}}}}, "kept"}}
Apply{scope_eval, Tuple{s, Quote{Defun{later, Lambda{Tuple{n}, Apply{eval, Tuple{Quote{Apply{hidden, Tuple{1}}}}}}}}}}
Apply{check, Tuple{Apply{scope_eval, Tuple{s, Quote{Apply{later, Tuple{0}}}}}, "private"}}
Apply{os_put, Tuple{"gc_scope: ok\n"}}
