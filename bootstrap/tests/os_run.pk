DefFun{check, Lambda{Tuple{a, b}, If{Apply{equal, Tuple{a, b}}, Do{}, Do{Apply{os_put, Tuple{"os_run: mismatch\n"}}, Apply{os_exit, Tuple{1}}}}}}

Def{args, Apply{array_new, Tuple{2}}}
Apply{array_set, Tuple{args, 0, "a"}}
Apply{array_set, Tuple{args, 1, "b"}}
Def{v1, Apply{mexpr_arg, Tuple{Apply{os_run, Tuple{"/bin/echo", args, "", ""}}, 0}}}
Def{v2, Apply{mexpr_arg, Tuple{Apply{os_run, Tuple{"/bin/echo", Tuple{"a", "b"}, "", ""}}, 0}}}
Apply{check, Tuple{Apply{array_get, Tuple{v1, 1}}, "a b\n"}}
Apply{check, Tuple{Apply{array_get, Tuple{v2, 0}}, 0}}
Apply{check, Tuple{Apply{array_get, Tuple{v2, 1}}, "a b\n"}}
Apply{os_put, Tuple{"os_run: ok\n"}}
