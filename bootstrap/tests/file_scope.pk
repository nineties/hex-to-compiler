Defun{check, Lambda{Tuple{a, b}, If{Apply{equal, Tuple{a, b}}, Do{}, Do{Apply{os_put, Tuple{"file_scope: mismatch\n"}}, Apply{os_exit, Tuple{1}}}}}}

Def{s1, Apply{scope_new, Tuple{}}}
Def{s2, Apply{scope_new, Tuple{}}}
Apply{scope_eval, Tuple{s1, Quote{Defun{f, Lambda{Tuple{0}, 100}}}}}
Apply{scope_eval, Tuple{s1, Quote{Def{helper, 1}}}}
Apply{scope_eval, Tuple{s1, Quote{Defun{f, Lambda{Tuple{n}, Apply{int_add, Tuple{n, helper}}}}}}}
Apply{scope_eval, Tuple{s2, Quote{Defun{f, Lambda{Tuple{n}, 7}}}}}
Apply{check, Tuple{Apply{scope_eval, Tuple{s1, Quote{Apply{f, Tuple{0}}}}}, 100}}
Apply{check, Tuple{Apply{scope_eval, Tuple{s1, Quote{Apply{f, Tuple{5}}}}}, 6}}
Apply{check, Tuple{Apply{scope_eval, Tuple{s2, Quote{Apply{f, Tuple{0}}}}}, 7}}
Apply{scope_export, Tuple{s1, Quote{f}}}
Apply{check, Tuple{Apply{f, Tuple{5}}, 6}}
Apply{check, Tuple{Apply{scope_eval, Tuple{s2, Quote{Apply{f, Tuple{5}}}}}, 7}}
Apply{os_put, Tuple{"file_scope: ok\n"}}
