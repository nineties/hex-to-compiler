DefFun{check, Lambda{Tuple{a, b}, If{Apply{equal, Tuple{a, b}}, Do{}, Do{Apply{os_put, Tuple{"parse_rest: mismatch\n"}}, Apply{os_exit, Tuple{1}}}}}}

Def{r1, Apply{parse, Tuple{"Foo{1}   Bar{2}"}}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{r1, 0}}, Quote{Foo{1}}}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{r1, 1}}, "Bar{2}"}}
Def{r2, Apply{parse, Tuple{Apply{mexpr_arg, Tuple{r1, 1}}}}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{r2, 0}}, Quote{Bar{2}}}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{r2, 1}}, ""}}
Apply{check, Tuple{Apply{str_ord, Tuple{Apply{mexpr_arg, Tuple{r1, 1}}, 0}}, 66}}

Def{u1, Apply{parse, Tuple{"Foo{\"é\"} Bar{2}"}}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{u1, 1}}, "Bar{2}"}}
Apply{check, Tuple{Apply{str_ord, Tuple{Apply{mexpr_arg, Tuple{u1, 1}}, 0}}, 66}}

Def{u2, Apply{parse, Tuple{"Bar{2} Foo{\"é\"}"}}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{u2, 1}}, "Foo{\"é\"}"}}
Def{u3, Apply{parse, Tuple{Apply{mexpr_arg, Tuple{u2, 1}}}}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{u3, 0}}, Quote{Foo{"é"}}}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{u3, 1}}, ""}}

Def{e, Apply{parse, Tuple{"  "}}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{e, 0}}, Quote{Eof{}}}}
Apply{check, Tuple{Apply{mexpr_arg, Tuple{e, 1}}, ""}}
Apply{os_put, Tuple{"parse_rest: ok\n"}}
