# Copyright (C) 2026 nineties

escape_of(10) := "\\n"
escape_of(9) := "\\t"
escape_of(13) := "\\r"
escape_of(34) := "\\\""
escape_of(92) := "\\\\"
escape_of(c) := if (c < 32) "\\?" else none

string_text(s) := {
    n := strlen(s)
    out := "\""
    start := 0
    i := 0
    while (i < n) {
        escape := escape_of(ord(s, i))
        if (escape != none) {
            out = str_cat(str_cat(out, substr(s, start, i)), escape)
            start = i + 1
        }
        i = i + 1
    }
    str_cat(str_cat(out, substr(s, start, n)), "\"")
}

tree_text(e) := {
    t := type(e)
    if (t == Int) f"{e}"
    else if (t == String) string_text(e)
    else if (t == Symbol) symname(e)
    else if (t == Expr) {
        out := str_cat(tree_text(head(e)), "{")
        n := arity(e)
        i := 0
        while (i < n) {
            if (i > 0) out = str_cat(out, ", ")
            out = str_cat(out, tree_text(arg(e, i)))
            i = i + 1
        }
        str_cat(out, "}")
    } else "?"
}

line_of(name, e) := {
    t := tree_text(e)
    r := parse_mexpr(t)
    if (arg(r, 0) != e or arg(r, 1) != "") {
        print(f"preprocess: {name}: cannot be written as an M-expression: {substr(t, 0, 200)}")
        exit(1)
    }
    str_cat(t, "\n")
}

pairs(a :: b :: rest) := str_cat(a, b) :: pairs(rest)
pairs(xs) := xs

join(x :: Nil{}) := x
join(xs) := join(pairs(xs))

write_preprocessed(name, path, state, text) := {
    prev := os_set_file(path)
    lines := [line_of(name, Preprocessed{state, text})]
    n := 0
    s := text
    go := true
    while (go) {
        r := parse(s)
        e := arg(r, 0)
        if (e == Eof{}) go = false
        else if (type(e) == Expr and head(e) == 'SyntaxError) {
            print(f"{path}: syntax error: {arg(e, 0)}")
            exit(1)
        } else {
            lines = line_of(name, e) :: lines
            n = n + 1
            eval(e)
            s = arg(r, 1)
        }
    }
    os_set_file(prev)
    lines = line_of(name, PreprocessEnd{n}) :: lines
    write_file(f"planck/lib/{name}.pkm", join(reverse_onto(lines, [])))
    none
}

args := argv()
if (array_len(args) < 2) {
    print("usage: planck0 tools/preprocess.pk <library> ...")
    exit(2)
}
preprocess_hook = write_preprocessed
for (name in ["list", "string", "pretty"]) write_preprocessed(name, f"planck/lib/{name}.pk", grammar_state(), read_file(f"planck/lib/{name}.pk"))
i := 1
while (i < array_len(args)) {
    use(array_get(args, i))
    i = i + 1
}
