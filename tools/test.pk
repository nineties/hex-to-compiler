# Runs the tests in the test blocks of the libraries.
# usage: planck0 tools/test.pk <library> ...
# Each library is loaded as use("<library>") does, with the libraries it uses, while _testing is true.
# A test block stops the program with status 1 when a check fails.
# Copyright (C) 2026 nineties

args := argv()
if (array_len(args) < 2) {
    put("usage: planck0 tools/test.pk <library> ...\n")
    exit(2)
}
_testing = true
i := 1
while (i < array_len(args)) {
    use(array_get(args, i))
    put("tested "); println(array_get(args, i))
    i = i + 1
}
