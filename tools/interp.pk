# Run a Planck program with the evaluator written in Planck (planck/lib/interp.pk).
# Copyright (C) 2026 nineties
#
#   planck0 tools/interp.pk program.pk args ...
#   planck0 tools/interp.pk --full-syntax program.pk args ...
#
# With --full-syntax the evaluator loads planck/peg.pk and planck/syntax.pk itself and the program is read with that syntax.
# Without it the program is read with the syntax of the language that runs the evaluator.

use("interp")

args := argv()
full := array_len(args) > 1 and args[1] == "--full-syntax"
first := if (full) 2 else 1
rest := array(array_len(args) - first)
i := first
while (i < array_len(args)) {
    rest[i - first] = args[i]
    i = i + 1
}
interp_run(rest, not full)
