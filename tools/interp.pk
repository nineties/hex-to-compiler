# Run a Planck program with the evaluator written in Planck (planck/lib/interp.pk).
# Copyright (C) 2026 nineties
#
#   planck0 tools/interp.pk program.pk args ...
#
# The evaluator loads planck/peg.pk and planck/syntax.pk itself and the program is read with that syntax.

use("interp")

args := argv()
rest := array(array_len(args) - 1)
i := 1
while (i < array_len(args)) {
    rest[i - 1] = args[i]
    i = i + 1
}
interp_run(rest)
